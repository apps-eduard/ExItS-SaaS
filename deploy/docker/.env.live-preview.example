# ExItS LIVE PREVIEW env — PLACEHOLDERS ONLY (P14-WP02 gap fix).
# Copy to deploy/docker/.env.live-preview and fill from local secret storage.
# Never commit real passwords. Personal live preview only — NOT Production.
# Apps use ASPNETCORE_ENVIRONMENT=Development (local HTTP Admin→API). Not packaging Staging.
#
# Packaging stack (.env / compose.yaml) uses different ports and must stay untouched:
#   packaging: 8081 / 8082 / 15433 / 15434

LIVE_PREVIEW_IMAGE_TAG=live-preview

LIVE_PREVIEW_PLATFORM_DB_USER=exits_lp_platform
LIVE_PREVIEW_PLATFORM_DB_PASSWORD=REPLACE_LIVE_PREVIEW_PLATFORM_DB_PASSWORD
LIVE_PREVIEW_POS_DB_USER=exits_lp_pos
LIVE_PREVIEW_POS_DB_PASSWORD=REPLACE_LIVE_PREVIEW_POS_DB_PASSWORD

# Host ports — deliberately different from packaging baseline
LIVE_PREVIEW_ADMIN_HOST_PORT=8090
LIVE_PREVIEW_PLATFORM_API_HOST_PORT=8091
LIVE_PREVIEW_POS_API_HOST_PORT=8092
LIVE_PREVIEW_PLATFORM_DB_HOST_PORT=15533
LIVE_PREVIEW_POS_DB_HOST_PORT=15534

LIVE_PREVIEW_ALLOWED_HOSTS=localhost;127.0.0.1
LIVE_PREVIEW_ADMIN_ORIGIN=http://localhost:8090

# Admin container → Platform API on the Docker network (not the host port)
LIVE_PREVIEW_PLATFORM_API_INTERNAL_URL=http://platform-api:8080

# ExItS LOCAL VALIDATION env — PLACEHOLDERS ONLY (P14-WP02A).
# Copy to deploy/docker/.env.local-validation and fill from local secret storage.
# Never commit real passwords. Personal live preview only — NOT Production.
#
# Recommended daily workflow: Docker DBs only + local Platform/POS/Admin
#   (see README.local-validation.md and Start-LocalValidation.ps1).
# Optional: --profile apps for containerized APIs/Admin.
#
# Packaging stack (.env / compose.yaml) uses different ports and must stay untouched:
#   packaging: 8081 / 8082 / 15433 / 15434
#
# Isolated MAUI + Blazor legacy stack (ports 8190–8194, Mailpit 8125) uses
#   .env.maui-local-validation.example — see README.maui-local-validation.md.

LOCAL_VALIDATION_IMAGE_TAG=local-validation

LOCAL_VALIDATION_PLATFORM_DB_USER=exits_lp_platform
LOCAL_VALIDATION_PLATFORM_DB_PASSWORD=REPLACE_LOCAL_VALIDATION_PLATFORM_DB_PASSWORD
LOCAL_VALIDATION_POS_DB_USER=exits_lp_pos
LOCAL_VALIDATION_POS_DB_PASSWORD=REPLACE_LOCAL_VALIDATION_POS_DB_PASSWORD

# Shared password for all local-validation test identities (local only; min 12 chars)
LOCAL_VALIDATION_SHARED_PASSWORD=REPLACE_LOCAL_VALIDATION_SHARED_PASSWORD

# Host ports — deliberately different from packaging baseline
LOCAL_VALIDATION_ADMIN_HOST_PORT=8090
LOCAL_VALIDATION_PLATFORM_API_HOST_PORT=8091
LOCAL_VALIDATION_POS_API_HOST_PORT=8092
LOCAL_VALIDATION_ORG_WEB_HOST_PORT=8093
LOCAL_VALIDATION_PERSONAL_WEB_HOST_PORT=8094
LOCAL_VALIDATION_REACT_POS_HOST_PORT=5177
# React Platform Admin (Docker nginx / Vite) — owns /admin/activate-account and /admin/reset-password for Mailpit links
LOCAL_VALIDATION_ADMIN_WEB_REACT_HOST_PORT=8095
# Alias kept for host Vite / PlatformApiOnly scripts that still read REACT_ADMIN_*
LOCAL_VALIDATION_REACT_ADMIN_HOST_PORT=8095
LOCAL_VALIDATION_PLATFORM_DB_HOST_PORT=15533
LOCAL_VALIDATION_POS_DB_HOST_PORT=15534

LOCAL_VALIDATION_MAILPIT_UI_HOST_PORT=8025
LOCAL_VALIDATION_MAILPIT_SMTP_HOST_PORT=1025

LOCAL_VALIDATION_ALLOWED_HOSTS=localhost;127.0.0.1;10.0.2.2;platform-api;admin-web;admin-web-react;pos-api;org-web;personal-web;react-pos
LOCAL_VALIDATION_ADMIN_ORIGIN=http://localhost:8090
LOCAL_VALIDATION_ORG_WEB_ORIGIN=http://localhost:8093
LOCAL_VALIDATION_PERSONAL_WEB_ORIGIN=http://localhost:8094
LOCAL_VALIDATION_REACT_POS_ORIGIN=http://127.0.0.1:5177
LOCAL_VALIDATION_REACT_POS_ORIGIN_LOCALHOST=http://localhost:5177
LOCAL_VALIDATION_REACT_POS_ORIGIN_EMULATOR=http://10.0.2.2:5177
# Public base URL for PlatformEmail activation/reset links (React Admin)
LOCAL_VALIDATION_ADMIN_WEB_REACT_ORIGIN=http://localhost:8095
LOCAL_VALIDATION_REACT_ADMIN_ORIGIN=http://127.0.0.1:8095
LOCAL_VALIDATION_PLATFORM_API_PUBLIC_URL=http://localhost:8091
# Local Validation React talks same-origin /api (nginx proxy). Do not bake a Tailscale IP.
LOCAL_VALIDATION_PLATFORM_API_SAME_ORIGIN=true
LOCAL_VALIDATION_PLATFORM_API_PROXY_TARGET=http://platform-api:8080
# Optional Tailscale/LAN host (no scheme/port). Plain Start reuses this for AllowedHosts/CORS.
# LOCAL_VALIDATION_PUBLIC_HOST=100.120.79.81
# Optional override for activation links (takes precedence over LOCAL_VALIDATION_REACT_ADMIN_ORIGIN):
# EXITS_ADMIN_PUBLIC_BASE_URL=http://127.0.0.1:8095

# Used only when app containers run (--profile apps) on the Docker network
LOCAL_VALIDATION_PLATFORM_API_INTERNAL_URL=http://platform-api:8080
LOCAL_VALIDATION_POS_API_INTERNAL_URL=http://pos-api:8080

# React POS nginx upstreams (full Docker apps profile uses compose DNS).
# For Docker React POS against host-run APIs, use:
#   REACT_POS_PLATFORM_API_UPSTREAM=http://host.docker.internal:8091
#   REACT_POS_POS_API_UPSTREAM=http://host.docker.internal:8092
#   REACT_POS_PLATFORM_API_PROXY_HOST=127.0.0.1:8091
#   REACT_POS_POS_API_PROXY_HOST=127.0.0.1:8092
#   docker compose -f compose.local-validation.yaml --env-file .env.local-validation --profile react-pos up -d --build react-pos
REACT_POS_PLATFORM_API_UPSTREAM=http://platform-api:8080
REACT_POS_POS_API_UPSTREAM=http://pos-api:8080
REACT_POS_PLATFORM_API_PROXY_HOST=platform-api:8080
REACT_POS_POS_API_PROXY_HOST=pos-api:8080

# React Admin 8095 Test User tools. Non-secret. Compose admin-web-react sets this true.
# Real production images must omit or set false. Never put passwords in /config.js.
# LOCAL_VALIDATION_TOOLS_ENABLED=true

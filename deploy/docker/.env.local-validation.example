# ExItS LOCAL VALIDATION env — PLACEHOLDERS ONLY (P14-WP02A).
# Copy to deploy/docker/.env.local-validation and fill from local secret storage.
# Never commit real passwords. Personal live preview only — NOT Production.
#
# Recommended daily workflow: Docker DBs only + local Platform/POS/Admin
#   (see README.local-validation.md and Start-LocalValidation.ps1).
# Optional: --profile apps for containerized APIs/Admin.
#
# Packaging stack (.env / compose.yaml) uses different ports and must stay untouched:
#   packaging: 8081 / 8082 / 15433 / 15434

LOCAL_VALIDATION_IMAGE_TAG=local-validation

LOCAL_VALIDATION_PLATFORM_DB_USER=exits_lp_platform
LOCAL_VALIDATION_PLATFORM_DB_PASSWORD=REPLACE_LOCAL_VALIDATION_PLATFORM_DB_PASSWORD
LOCAL_VALIDATION_POS_DB_USER=exits_lp_pos
LOCAL_VALIDATION_POS_DB_PASSWORD=REPLACE_LOCAL_VALIDATION_POS_DB_PASSWORD

# Shared password for all local-validation test identities (local only; min 12 chars)
LOCAL_VALIDATION_SHARED_PASSWORD=REPLACE_LOCAL_VALIDATION_SHARED_PASSWORD

# Host ports — deliberately different from packaging baseline
LOCAL_VALIDATION_ADMIN_HOST_PORT=8090
LOCAL_VALIDATION_PLATFORM_API_HOST_PORT=8091
LOCAL_VALIDATION_POS_API_HOST_PORT=8092
LOCAL_VALIDATION_ORG_WEB_HOST_PORT=8093
LOCAL_VALIDATION_PERSONAL_WEB_HOST_PORT=8094
LOCAL_VALIDATION_PLATFORM_DB_HOST_PORT=15533
LOCAL_VALIDATION_POS_DB_HOST_PORT=15534

LOCAL_VALIDATION_MAILPIT_UI_HOST_PORT=8025
LOCAL_VALIDATION_MAILPIT_SMTP_HOST_PORT=1025

LOCAL_VALIDATION_ALLOWED_HOSTS=localhost;127.0.0.1;platform-api;admin-web;pos-api;org-web;personal-web
LOCAL_VALIDATION_ADMIN_ORIGIN=http://localhost:8090
LOCAL_VALIDATION_ORG_WEB_ORIGIN=http://localhost:8093
LOCAL_VALIDATION_PERSONAL_WEB_ORIGIN=http://localhost:8094
LOCAL_VALIDATION_PLATFORM_API_PUBLIC_URL=http://localhost:8091
# Optional Tailscale/LAN host (no scheme/port). Plain Start reuses this for AllowedHosts/CORS.
# LOCAL_VALIDATION_PUBLIC_HOST=100.120.79.81

# Used only when app containers run (--profile apps) on the Docker network
LOCAL_VALIDATION_PLATFORM_API_INTERNAL_URL=http://platform-api:8080
LOCAL_VALIDATION_POS_API_INTERNAL_URL=http://pos-api:8080

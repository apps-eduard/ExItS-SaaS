# ExItS LEGACY MAUI / BLAZOR Local Validation env — PLACEHOLDERS ONLY (LEGACY-MAUI-ISO-01).
# Copy to deploy/docker/.env.maui-local-validation and fill from local secret storage.
# Never commit real passwords. Isolated from React Local Validation (.env.local-validation).
#
# React stack (DO NOT CHANGE / DO NOT REUSE):
#   ports 8090–8095, DB 15533/15534, project exits-local-validation
#
# MAUI stack:
#   Admin 8190 · Platform API 8191 · POS API 8192 · Org 8193 · Personal 8194
#   Platform DB 16533 · POS DB 16534 · Mailpit UI 8125 · SMTP 1125

MAUI_LOCAL_VALIDATION_IMAGE_TAG=maui-local-validation

MAUI_LOCAL_VALIDATION_PLATFORM_DB_USER=exits_maui_platform
MAUI_LOCAL_VALIDATION_PLATFORM_DB_PASSWORD=REPLACE_MAUI_LOCAL_VALIDATION_PLATFORM_DB_PASSWORD
MAUI_LOCAL_VALIDATION_POS_DB_USER=exits_maui_pos
MAUI_LOCAL_VALIDATION_POS_DB_PASSWORD=REPLACE_MAUI_LOCAL_VALIDATION_POS_DB_PASSWORD

# Shared password for seeded Local Validation identities (local only; min 12 chars)
MAUI_LOCAL_VALIDATION_SHARED_PASSWORD=REPLACE_MAUI_LOCAL_VALIDATION_SHARED_PASSWORD

MAUI_LOCAL_VALIDATION_ADMIN_HOST_PORT=8190
MAUI_LOCAL_VALIDATION_PLATFORM_API_HOST_PORT=8191
MAUI_LOCAL_VALIDATION_POS_API_HOST_PORT=8192
MAUI_LOCAL_VALIDATION_ORG_WEB_HOST_PORT=8193
MAUI_LOCAL_VALIDATION_PERSONAL_WEB_HOST_PORT=8194
MAUI_LOCAL_VALIDATION_PLATFORM_DB_HOST_PORT=16533
MAUI_LOCAL_VALIDATION_POS_DB_HOST_PORT=16534
MAUI_LOCAL_VALIDATION_MAILPIT_UI_HOST_PORT=8125
MAUI_LOCAL_VALIDATION_MAILPIT_SMTP_HOST_PORT=1125

MAUI_LOCAL_VALIDATION_ALLOWED_HOSTS=localhost;127.0.0.1;10.0.2.2;maui-platform-api;maui-admin-web;maui-pos-api;maui-org-web;maui-personal-web
MAUI_LOCAL_VALIDATION_ADMIN_ORIGIN=http://localhost:8190
MAUI_LOCAL_VALIDATION_ORG_WEB_ORIGIN=http://localhost:8193
MAUI_LOCAL_VALIDATION_PERSONAL_WEB_ORIGIN=http://localhost:8194

# Optional Tailscale/LAN host (no scheme/port). Prefer launcher: -PublicHost 100.x.x.x
# When set (or passed to Start-MauiLegacyLocalValidation.ps1), AllowedHosts and Blazor
# navigation origins include that host. DB ports stay host-local (16533/16534).
# MAUI_LOCAL_VALIDATION_PUBLIC_HOST=
# Docker-network URLs for Blazor server-side HttpClient (not host ports)
MAUI_LOCAL_VALIDATION_PLATFORM_API_INTERNAL_URL=http://maui-platform-api:8080
MAUI_LOCAL_VALIDATION_POS_API_INTERNAL_URL=http://maui-pos-api:8080

MAUI_LOCAL_VALIDATION_SEED_SCOPE=PlatformAdministratorsOnly
# MAUI_LOCAL_VALIDATION_PURGE_TRANSACTIONAL=false

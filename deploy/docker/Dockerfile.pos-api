# ExItS PinoyBusinessPOS API — versioned .NET 10 runtime. Secrets via environment only.
# Phase: P9-WP05-pilot-and-deployment
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props global.json ./
COPY src/ ./src/
RUN dotnet restore src/Products/PinoyBusinessPOS/ExItS.PinoyBusinessPOS.Api/ExItS.PinoyBusinessPOS.Api.csproj
RUN dotnet publish src/Products/PinoyBusinessPOS/ExItS.PinoyBusinessPOS.Api/ExItS.PinoyBusinessPOS.Api.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
RUN groupadd --system exits && useradd --system --gid exits --create-home exits \
    && apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
USER exits
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
ENV DOTNET_EnableDiagnostics=0
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["dotnet", "ExItS.PinoyBusinessPOS.Api.dll"]

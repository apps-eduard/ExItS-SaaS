# ExItS packaging baseline env — PLACEHOLDERS ONLY (P14-WP02).
# Copy to deploy/docker/.env and fill from environment-owned secret storage.
# Never commit real passwords, tokens, or connection strings.
#
# This file supports local docker compose packaging tests only.
# It does NOT authorize Production cutover (TLS-PROD, R-109, R-129, etc. remain open).

# Image tag applied to built API images
EXITS_IMAGE_TAG=local

# Database credentials (local packaging — use strong unique values; not the Development password marker)
PLATFORM_DB_USER=exits_platform_app
PLATFORM_DB_PASSWORD=REPLACE_PLATFORM_DB_PASSWORD
POS_DB_USER=exits_pos_app
POS_DB_PASSWORD=REPLACE_POS_DB_PASSWORD

# Host ports (avoid colliding with local Postgres)
PLATFORM_DB_HOST_PORT=15433
POS_DB_HOST_PORT=15434
PLATFORM_API_HOST_PORT=8081
POS_API_HOST_PORT=8082

# AllowedHosts for Staging packaging run (no wildcards)
PACKAGING_ALLOWED_HOSTS=localhost;127.0.0.1

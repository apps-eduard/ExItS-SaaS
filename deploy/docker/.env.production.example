# ExItS production Compose env — PLACEHOLDERS ONLY (P14-WP03).
# Copy to deploy/docker/.env.production and fill from environment-owned secret storage.
# Never commit real passwords, tokens, certificates, or connection strings.
#
# This template supports the production topology Compose file. It does NOT authorize
# claiming Production-ready status (TLS-PROD device/operator validation, MAUI-HTTPS,
# R-109, R-129, auth email, MFA, backup/ops evidence remain open).

EXITS_IMAGE_TAG=local
ASPNETCORE_ENVIRONMENT=Production

PLATFORM_DB_USER=exits_platform_app
PLATFORM_DB_PASSWORD=REPLACE_PLATFORM_DB_PASSWORD
POS_DB_USER=exits_pos_app
POS_DB_PASSWORD=REPLACE_POS_DB_PASSWORD

# Public entry (reverse proxy only)
PRODUCTION_HTTP_PORT=80
PRODUCTION_HTTPS_PORT=443

# Absolute host path to directory containing fullchain.pem and privkey.pem (operator-owned)
PRODUCTION_TLS_CERT_DIR=/etc/exits/certs

# Explicit hosts/origins — no wildcards
PRODUCTION_ALLOWED_HOSTS=example.com;www.example.com;admin.example.com;api.example.com
PRODUCTION_ADMIN_ORIGIN=https://admin.example.com
PRODUCTION_PLATFORM_API_PUBLIC_URL=https://api.example.com/platform

# Docker bridge / overlay CIDR trusted for ForwardedHeaders (tighten per host)
PRODUCTION_TRUSTED_PROXY_NETWORK=172.16.0.0/12

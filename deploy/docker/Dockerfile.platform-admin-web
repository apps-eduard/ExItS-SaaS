# ExItS Platform Admin Web (React) — production static build + nginx.
# Runtime injects PLATFORM_API_PUBLIC_URL into /config.js (no machine-specific bake).
FROM node:22-alpine AS build
WORKDIR /src
COPY src/Platform/ExItS.Platform.Admin.Web/package.json src/Platform/ExItS.Platform.Admin.Web/package-lock.json ./
RUN npm ci
COPY src/Platform/ExItS.Platform.Admin.Web/ ./
ENV VITE_PLATFORM_API_BASE_URL=""
RUN npm run build

FROM nginx:1.27-alpine AS final
RUN sed -i 's|pid /run/nginx.pid;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && sed -i 's|pid        /run/nginx.pid;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf || true
COPY deploy/docker/platform-admin-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/platform-admin-web/40-exits-runtime-config.sh /docker-entrypoint.d/40-exits-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-exits-runtime-config.sh
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1

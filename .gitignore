# ExITS SaaS — root repository ignore rules

# Secrets and local environment
**/.env
**/.env.*
!**/.env.example
!.env.example
!**/.env.live-preview.example
!.env.live-preview.example
!**/.env.production.example
!.env.production.example

# .NET / build outputs
**/bin/
**/obj/
**/TestResults/
**/artifacts/
**/coverage/
**/CoverageResults/
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE / editor
**/.vs/
**/.idea/
**/.vscode/
*.DotSettings.user

# Local databases and certificates
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.pfx
*.p12
*.key
*.pem
!**/certs/*.example.pem

# Database backup artifacts (never commit dumps or encrypted production backups)
*.dump
*.dump.enc
**/ops/backup/local/
**/ops/backup/*.manifest.json

# OS / misc
Thumbs.db
Desktop.ini
.DS_Store
*.log

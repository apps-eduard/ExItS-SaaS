# Production configuration template — PLACEHOLDERS ONLY. Production remains BLOCKED while
# R-091, R-109, R-129, and Production TLS validation remain open.
# Never commit real secrets. Requires EXITS_DEPLOY_CONFIRM=DEPLOY_PRODUCTION_CONFIRMED.
# Phase: P9-WP05-pilot-and-deployment

EXITS_ENVIRONMENT=Production
EXITS_DEPLOY_CONFIRM=DEPLOY_PRODUCTION_CONFIRMED
EXITS_GIT_COMMIT=REPLACE_WITH_FULL_GIT_SHA

# Connection strings from secret store (env injection) — not files in repo
# EXITS_PLATFORM_DATABASE=Host=...;Database=exits_platform;Username=...;Password=...
# EXITS_POS_DATABASE=Host=...;Database=exits_pos;Username=...;Password=...

AllowedHosts=api.example.com;admin.example.com
Cors__AllowedOrigins__0=https://admin.example.com
Security__EnforceHttps=true

# Reject known Development password marker exits_platform_dev_only
# Reject AllowedHosts=*
# Do not enable Development/Testing identity headers

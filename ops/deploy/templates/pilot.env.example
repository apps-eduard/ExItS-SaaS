# ExItS pilot / staging environment template — PLACEHOLDERS ONLY.
# Copy to a local untracked file (e.g. deploy/docker/.env) and fill from environment-owned secret storage.
# Never commit real passwords, tokens, certificates, or connection strings.
# Phase: P9-WP05-pilot-and-deployment

# Environment classification (do not set Development defaults for pilot)
EXITS_ENVIRONMENT=StagingPilot

# Explicit confirmation required by deployment automation for StagingPilot actions
EXITS_DEPLOY_CONFIRM=DEPLOY_PILOT_CONFIRMED

# Git commit being deployed (must match clean tree)
EXITS_GIT_COMMIT=REPLACE_WITH_FULL_GIT_SHA

# Database credentials (least-privilege app roles — not superuser in Production)
PLATFORM_DB_USER=REPLACE_PLATFORM_DB_USER
PLATFORM_DB_PASSWORD=REPLACE_PLATFORM_DB_PASSWORD
POS_DB_USER=REPLACE_POS_DB_USER
POS_DB_PASSWORD=REPLACE_POS_DB_PASSWORD

# Host / CORS (no wildcards for AllowedHosts)
PILOT_ALLOWED_HOSTS=pilot.example.internal
PILOT_ADMIN_ORIGIN=https://pilot.example.internal

# Published ports (host)
PILOT_HTTP_PORT=8088
PILOT_HTTPS_PORT=8443

# Host directory containing fullchain.pem + privkey.pem (pilot/staging certs — not Production claim)
PILOT_TLS_CERT_DIR=/path/to/pilot/certs

# Optional: backup output root for pre-deploy backups
EXITS_BACKUP_ROOT=/path/to/protected/backup/root

# MAUI pilot API base (HTTPS only for pilot/staging)
EXITS_MAUI_POS_API_BASE_URL=https://pilot.example.internal/pos/

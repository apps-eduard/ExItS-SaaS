# Example environment template — copy to a secure host path; never commit real values.
EXITS_PLATFORM_DATABASE=Host=127.0.0.1;Port=5432;Database=ExItS_Platform;Username=postgres;Password=
EXITS_POS_DATABASE=Host=127.0.0.1;Port=5432;Database=ExItS_PinoyBusinessPOS;Username=postgres;Password=
EXITS_BACKUP_OUTPUT_DIR=C:\secure\exits-backups
EXITS_BACKUP_ENV_CLASS=Development
EXITS_BACKUP_KEY_FILE=C:\secure\keys\exits-backup.key
# Optional tool overrides:
# EXITS_PG_DUMP_PATH=
# EXITS_PG_RESTORE_PATH=

{
  "ConnectionStrings": {
    "PlatformDatabase": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "EnforceHttps": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "PlatformAuthentication": {
    "Password": {
      "MinimumLength": 12,
      "MaximumLength": 128,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "Bootstrap": {
      "Enabled": false,
      "SharedSecret": "",
      "Username": "",
      "DisplayName": "",
      "Email": "",
      "Password": ""
    },
    "Session": {
      "CookieName": ".ExItS.Platform.Auth",
      "SessionTokenHeaderName": "X-ExItS-Session-Token",
      "IdleTimeoutMinutes": 30,
      "AbsoluteLifetimeHours": 12,
      "SlidingRenewal": true
    },
    "AccessToken": {
      "LifetimeHours": 8,
      "MaxLifetimeHours": 24
    },
    "Mfa": {
      "EnrollmentEnabled": false,
      "EnforcementEnabled": false
    },
    "External": {
      "TestingEndpointEnabled": false,
      "Google": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      },
      "Facebook": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      }
    },
    "Lifecycle": {
      "PasswordResetTokenLifetimeMinutes": 60,
      "EmailVerificationTokenLifetimeHours": 24,
      "ExposeDebugTokens": false
    }
  },
  "PlatformEmail": {
    "SmtpHost": "",
    "SmtpPort": 1025,
    "UseSsl": false,
    "FromAddress": "noreply@exits.local",
    "FromDisplayName": "ExItS",
    "AdminPublicBaseUrl": "",
    "PinoyLoanManagerPublicBaseUrl": "",
    "PinoyBusinessPosPublicBaseUrl": "",
    "AllowHttpLoopbackPublicUrls": false
  },
  "PersonalRewardClaims": {
    "AdRewardPoints": 10,
    "NullProviderClaimsEnabled": false
  },
  "PersonalAds": {
    "ProviderMode": "None",
    "SurfaceEnabled": true
  }
}

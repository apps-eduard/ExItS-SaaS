{
  "ConnectionStrings": {
    "PlatformDatabase": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "EnforceHttps": false
  },
  "PlatformAuthentication": {
    "Password": {
      "MinimumLength": 12,
      "MaximumLength": 128,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "Bootstrap": {
      "Enabled": false,
      "SharedSecret": "",
      "Username": "",
      "DisplayName": "",
      "Email": "",
      "Password": ""
    },
    "Session": {
      "CookieName": ".ExItS.Platform.Auth",
      "SessionTokenHeaderName": "X-ExItS-Session-Token",
      "IdleTimeoutMinutes": 30,
      "AbsoluteLifetimeHours": 12,
      "SlidingRenewal": true
    },
    "Lifecycle": {
      "PasswordResetTokenLifetimeMinutes": 60,
      "EmailVerificationTokenLifetimeHours": 24,
      "ExposeDebugTokens": false
    }
  }
}

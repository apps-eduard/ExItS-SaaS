@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject IOptions<ExItSWebHostOptions> Hosts

<PageTitle>Sign in — Personal</PageTitle>
<div class="exits-login-shell">
    <Card Class="exits-login-card">
        <TitleTemplate>ExItS Personal</TitleTemplate>
        <Body>
            <Paragraph>Canonical ExItS sign-in is used for Personal Web.</Paragraph>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <Alert Type="@AlertType.Error" Message="@Error" ShowIcon="true" />
            }
            <a class="ant-btn ant-btn-primary ant-btn-block" href="@SignInUrl">Sign in</a>
        </Body>
    </Card>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private string SignInUrl => Hosts.Value.CanonicalLoginUrl(WebApps.Personal, "/home");
}

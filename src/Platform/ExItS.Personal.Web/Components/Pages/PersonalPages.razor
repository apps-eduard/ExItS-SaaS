@page "/utang/lent"
@page "/utang/borrowed"
@page "/utang/invitations"
@page "/notifications"
@page "/profile"
@page "/settings"
@attribute [Authorize]
@inject PersonalApiClient Api
@inject NavigationManager Nav
@inject IMessageService Message

<PageTitle>@_title</PageTitle>
<ExitsPageHeader Title="@_title" Subtitle="Personal account data from existing Platform Personal APIs." />

@if (_loading)
{
    <Spin />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" />
}
else if (_mode is "lent" or "borrowed")
{
    <Table TItem="PersonalDebtRelationshipSummaryDto" DataSource="_relationships" Size="@TableSize.Small" Bordered>
        <PropertyColumn Property="c => c.Perspective" Title="Perspective" />
        <PropertyColumn Property="c => c.CurrentBalance" Title="Balance" />
        <PropertyColumn Property="c => c.CurrencyCode" Title="Currency" />
        <PropertyColumn Property="c => c.Status" Title="Status" />
    </Table>
}
else if (_mode == "invitations")
{
    <div style="max-width:560px;width:100%;">
        <h3 style="margin:0 0 8px;font-size:16px;">Received</h3>
        @if (_received.Count == 0)
        {
            <Empty Description="@("No pending invitations")" Style="margin-bottom:24px;" />
        }
        else
        {
            @foreach (var inv in _received)
            {
                <div style="border:1px solid var(--ant-color-border);border-radius:8px;padding:12px;margin-bottom:8px;">
                    <div style="font-weight:600;">Personal Utang invitation</div>
                    <div style="font-size:13px;color:var(--ant-color-text-secondary);">
                        @(inv.InviteTargetEmailMasked ?? "Pending") · @inv.Status
                    </div>
                    <div style="font-size:13px;color:var(--ant-color-text-secondary);margin-bottom:8px;">
                        Sent @inv.CreatedAtUtc.ToLocalTime().ToString("MMM d")
                    </div>
                    @if (string.Equals(inv.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <Space Wrap>
                            <Button Danger Loading="_inviteBusyId == inv.Id" OnClick="() => DeclineAsync(inv.Id)">Decline</Button>
                            <Button Type="@ButtonType.Primary" Loading="_inviteBusyId == inv.Id" OnClick="() => AcceptAsync(inv.Id)">Accept</Button>
                        </Space>
                    }
                </div>
            }
        }

        <h3 style="margin:16px 0 8px;font-size:16px;">Sent</h3>
        @if (_sent.Count == 0)
        {
            <Empty Description="@("No sent invitations")" />
        }
        else
        {
            @foreach (var inv in _sent)
            {
                <div style="border:1px solid var(--ant-color-border);border-radius:8px;padding:12px;margin-bottom:8px;">
                    <div style="font-weight:600;">@(inv.InviteTargetEmailMasked ?? "Contact")</div>
                    <div style="font-size:13px;color:var(--ant-color-text-secondary);margin-bottom:8px;">
                        @inv.Status · @inv.CreatedAtUtc.ToLocalTime().ToString("MMM d")
                    </div>
                    @if (string.Equals(inv.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <Space Wrap>
                            <Button Danger Loading="_inviteBusyId == inv.Id" OnClick="() => RevokeAsync(inv.Id)">Cancel request</Button>
                            <Button Loading="_inviteBusyId == inv.Id" OnClick="() => ResendAsync(inv.Id)">Send again</Button>
                        </Space>
                    }
                </div>
            }
        }
    </div>
}
else if (_mode == "notifications")
{
    @if (_notifications.Count == 0)
    {
        <Empty Description="@("No notifications")" />
    }
    else
    {
        <div style="max-width:560px;width:100%;display:flex;flex-direction:column;gap:8px;">
            @foreach (var n in _notifications)
            {
                <button type="button"
                        style="text-align:left;padding:12px;border:1px solid var(--ant-color-border);border-radius:8px;background:var(--ant-color-bg-container);cursor:pointer;"
                        @onclick="() => OpenNotification(n)">
                    <div style="font-weight:600;">@n.Title</div>
                    <div style="font-size:13px;color:var(--ant-color-text-secondary);">@n.Preview</div>
                    <div style="font-size:12px;color:var(--ant-color-text-tertiary);margin-top:4px;">
                        @(n.IsRead ? "Read" : "Unread") · @n.CreatedAtUtc.ToLocalTime().ToString("MMM d")
                    </div>
                </button>
            }
        </div>
    }
}
else if (_mode == "profile" && _profile is not null)
{
    @if (!string.IsNullOrWhiteSpace(_profileEditError))
    {
        <Alert Type="@AlertType.Error" Message="@_profileEditError" ShowIcon="true" Style="margin-bottom:16px;" />
    }

    @if (_editingProfile)
    {
        <div style="max-width:480px;width:100%;">
            <div style="margin-bottom:16px;">
                <div style="font-weight:600;margin-bottom:4px;">Name</div>
                <Input @bind-Value="_editDisplayName"
                       Disabled="_profileSaving"
                       Placeholder="Display name"
                       MaxLength="100"
                       OnPressEnter="SaveProfileAsync" />
            </div>
            <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1" Style="margin-bottom:16px;">
                <DescriptionsItem Title="Username">@_profile.Username</DescriptionsItem>
                <DescriptionsItem Title="Email">@_profile.Email</DescriptionsItem>
                <DescriptionsItem Title="Account class">@_profile.AccountClass</DescriptionsItem>
            </Descriptions>
            <Space Wrap>
                <Button Disabled="_profileSaving" OnClick="CancelEditProfile">Cancel</Button>
                <Button Type="@ButtonType.Primary" Loading="_profileSaving" Disabled="_profileSaving" OnClick="SaveProfileAsync">
                    Save changes
                </Button>
            </Space>
        </div>
    }
    else
    {
        <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1" Style="margin-bottom:16px;">
            <DescriptionsItem Title="Name">@_profile.DisplayName</DescriptionsItem>
            <DescriptionsItem Title="Username">@_profile.Username</DescriptionsItem>
            <DescriptionsItem Title="Email">@_profile.Email</DescriptionsItem>
            <DescriptionsItem Title="Account class">@_profile.AccountClass</DescriptionsItem>
        </Descriptions>
        <Button Type="@ButtonType.Primary" OnClick="BeginEditProfile">Edit profile</Button>
    }
}
else if (_mode == "settings" && _settings is not null)
{
    <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1">
        <DescriptionsItem Title="Email notifications">@_settings.EmailNotificationsEnabled</DescriptionsItem>
        <DescriptionsItem Title="Push notifications">@_settings.PushNotificationsEnabled</DescriptionsItem>
        <DescriptionsItem Title="In-app notifications">@_settings.InAppNotificationsEnabled</DescriptionsItem>
        <DescriptionsItem Title="Reminders">@_settings.ReminderNotificationsEnabled</DescriptionsItem>
    </Descriptions>
}

@code {
    private bool _loading = true;
    private string _mode = "lent";
    private string _title = "I Lent";
    private string? _error;
    private IReadOnlyList<PersonalDebtRelationshipSummaryDto> _relationships = [];
    private IReadOnlyList<PersonalUtangInvitationDto> _invitations = [];
    private IReadOnlyList<PersonalUtangInvitationDto> _received = [];
    private IReadOnlyList<PersonalUtangInvitationDto> _sent = [];
    private IReadOnlyList<PersonalInAppNotificationDto> _notifications = [];
    private PersonalProfileDto? _profile;
    private PersonalAccountSettingsDto? _settings;
    private bool _editingProfile;
    private bool _profileSaving;
    private string _editDisplayName = "";
    private string? _profileEditError;
    private Guid? _inviteBusyId;

    protected override async Task OnInitializedAsync()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        (_mode, _title) = path switch
        {
            "/utang/borrowed" => ("borrowed", "I Borrowed"),
            "/utang/invitations" => ("invitations", "Invitations"),
            "/notifications" => ("notifications", "Notifications"),
            "/profile" => ("profile", "Profile"),
            "/settings" => ("settings", "Settings"),
            _ => ("lent", "I Lent")
        };

        try
        {
            switch (_mode)
            {
                case "lent": _relationships = await Api.GetLentAsync() ?? []; break;
                case "borrowed": _relationships = await Api.GetBorrowedAsync() ?? []; break;
                case "invitations":
                    await LoadInvitationsAsync();
                    break;
                case "notifications": _notifications = await Api.GetNotificationsAsync() ?? []; break;
                case "profile": _profile = await Api.GetProfileAsync(); break;
                case "settings": _settings = await Api.GetSettingsAsync(); break;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadInvitationsAsync()
    {
        _profile ??= await Api.GetProfileAsync();
        _invitations = await Api.GetInvitationsAsync() ?? [];
        var me = _profile?.UserIdentityId;
        _sent = _invitations
            .Where(i => me is Guid id && i.InvitedByUserIdentityId == id)
            .ToList();
        _received = _invitations
            .Where(i => me is null || i.InvitedByUserIdentityId != me)
            .ToList();
    }

    private async Task AcceptAsync(Guid invitationId)
    {
        _inviteBusyId = invitationId;
        try
        {
            var (ok, _, error) = await Api.AcceptInvitationByIdAsync(invitationId);
            if (!ok)
            {
                await Message.ErrorAsync(error ?? "Could not accept invitation.");
                return;
            }

            await Message.SuccessAsync("Invitation accepted.");
            await LoadInvitationsAsync();
        }
        finally
        {
            _inviteBusyId = null;
        }
    }

    private async Task DeclineAsync(Guid invitationId)
    {
        _inviteBusyId = invitationId;
        try
        {
            var (ok, _, error) = await Api.DeclineInvitationByIdAsync(invitationId);
            if (!ok)
            {
                await Message.ErrorAsync(error ?? "Could not decline invitation.");
                return;
            }

            await Message.SuccessAsync("Invitation declined.");
            await LoadInvitationsAsync();
        }
        finally
        {
            _inviteBusyId = null;
        }
    }

    private async Task ResendAsync(Guid invitationId)
    {
        _inviteBusyId = invitationId;
        try
        {
            var (ok, _, error) = await Api.ResendInvitationAsync(invitationId);
            if (!ok)
            {
                await Message.ErrorAsync(error ?? "Could not resend.");
                return;
            }

            await Message.SuccessAsync("Invitation resent.");
            await LoadInvitationsAsync();
        }
        finally
        {
            _inviteBusyId = null;
        }
    }

    private async Task RevokeAsync(Guid invitationId)
    {
        _inviteBusyId = invitationId;
        try
        {
            var (ok, _, error) = await Api.RevokeInvitationAsync(invitationId);
            if (!ok)
            {
                await Message.ErrorAsync(error ?? "Could not cancel.");
                return;
            }

            await Message.SuccessAsync("Request cancelled.");
            await LoadInvitationsAsync();
        }
        finally
        {
            _inviteBusyId = null;
        }
    }

    private void OpenNotification(PersonalInAppNotificationDto notification)
    {
        // Notifications alert; Invitations remains the decision surface. Dismissal does not clear pending invites.
        _ = notification;
        Nav.NavigateTo("/utang/invitations");
    }

    private void BeginEditProfile()
    {
        if (_profile is null || _profileSaving)
        {
            return;
        }

        _editDisplayName = _profile.DisplayName;
        _profileEditError = null;
        _editingProfile = true;
    }

    private void CancelEditProfile()
    {
        if (_profileSaving)
        {
            return;
        }

        _editDisplayName = _profile?.DisplayName ?? "";
        _profileEditError = null;
        _editingProfile = false;
    }

    private async Task SaveProfileAsync()
    {
        if (_profile is null || _profileSaving)
        {
            return;
        }

        _profileSaving = true;
        _profileEditError = null;
        try
        {
            var (ok, data, error) = await Api.UpdateProfileAsync(_editDisplayName);
            if (!ok || data is null)
            {
                _profileEditError = error ?? "Could not save profile.";
                return;
            }

            _profile = data;
            _editDisplayName = data.DisplayName;
            _editingProfile = false;
            await Message.SuccessAsync("Profile updated.");
        }
        catch (Exception ex)
        {
            _profileEditError = ex.Message;
        }
        finally
        {
            _profileSaving = false;
        }
    }
}

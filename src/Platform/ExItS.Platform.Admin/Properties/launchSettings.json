{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5289",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7289;http://localhost:5289",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "LivePreview": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:8090",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Staging",
        "LivePreview__Enabled": "true",
        "AllowedHosts": "localhost;127.0.0.1",
        "PlatformApi__BaseUrl": "http://localhost:8091",
        "PlatformApi__TimeoutSeconds": "30"
      }
    }
  }
}

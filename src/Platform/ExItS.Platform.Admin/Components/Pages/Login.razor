@page "/admin/login"
@layout EmptyLayout
@using AntDesign
@using ExItS.Platform.Admin.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@attribute [AllowAnonymous]
@inject PlatformBrowserSessionService SessionService
@inject NavigationManager Nav
@inject IStringLocalizer<AdminResources> L
@inject IOptions<LivePreviewAdminOptions> LivePreviewOptions

<PageTitle>@L["Brand_Name"] — Login</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-login-brand">
                <span class="exits-brand-mark">EA</span>
                <span>@L["Brand_Name"]</span>
            </div>
        </TitleTemplate>
        <Body>
            <Paragraph Type="@TextElementType.Secondary">Sign in with your Platform User credentials.</Paragraph>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Style="margin-bottom: 1rem;" />
            }

            @* Native named inputs: SSR form POST must set cookies outside Interactive Server. *@
            <form method="post" action="/admin/login/credentials" class="exits-login-form">
                <AntiforgeryToken />
                <div class="ant-form-item">
                    <label class="ant-form-item-label" for="login-user">Username or email</label>
                    <input id="login-user" name="UsernameOrEmail" class="exits-native-input" autocomplete="username" />
                </div>
                <div class="ant-form-item">
                    <label class="ant-form-item-label" for="login-password">Password</label>
                    <input id="login-password" name="Password" type="password" class="exits-native-input" autocomplete="current-password" />
                </div>
                <button type="submit" class="ant-btn ant-btn-primary ant-btn-sm ant-btn-block">Sign in</button>
                <div style="margin-top:.75rem;">
                    <a href="/admin/forgot-password">Forgot password</a>
                </div>
            </form>

            @if (_livePreviewEnabled)
            {
                <Divider>Live Preview Test User</Divider>
                <form method="post" action="/admin/login/live-preview" class="exits-login-form">
                    <AntiforgeryToken />
                    <div class="ant-form-item">
                        <label class="ant-form-item-label" for="live-preview-user">Select a test identity</label>
                        <select id="live-preview-user" name="IdentityKey" class="exits-native-select" required>
                            <option value="">Select a test identity</option>
                            @foreach (var identity in _identities)
                            {
                                <option value="@identity.Key">@identity.DisplayName</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="ant-btn ant-btn-primary ant-btn-sm ant-btn-block" disabled="@(_identities.Count == 0)">
                        Sign in as test user
                    </button>
                    <Paragraph Type="@TextElementType.Secondary" Style="margin-top:.5rem; font-size:12px;">
                        Creates a real Platform session. Membership, product access, and POS-local roles remain enforced.
                    </Paragraph>
                </form>
            }

            <Divider>Or continue with</Divider>
            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                <a class="ant-btn ant-btn-default ant-btn-sm ant-btn-block" href="@GoogleChallengeUrl">Continue with Google</a>
                <a class="ant-btn ant-btn-default ant-btn-sm ant-btn-block" href="@FacebookChallengeUrl">Continue with Facebook</a>
            </Space>
            <Paragraph Type="@TextElementType.Secondary" Style="margin-top:.5rem; font-size:12px;">
                Social sign-in creates or links a Platform User only. It does not grant administrator, membership, or product access.
            </Paragraph>
        </Body>
    </Card>
</div>

@code {
    private string? _error;
    private bool _livePreviewEnabled;
    private IReadOnlyList<LivePreviewIdentityOptionDto> _identities = [];

    [Inject] private IOptions<PlatformApiOptions> PlatformApi { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorQuery { get; set; }

    private string GoogleChallengeUrl => BuildChallengeUrl("google");
    private string FacebookChallengeUrl => BuildChallengeUrl("facebook");

    protected override async Task OnInitializedAsync()
    {
        _error = string.IsNullOrWhiteSpace(ErrorQuery) ? null : ErrorQuery;
        _livePreviewEnabled = LivePreviewOptions.Value.Enabled;
        if (_livePreviewEnabled)
        {
            _identities = await SessionService.ListLivePreviewIdentitiesAsync();
        }
    }

    private string BuildChallengeUrl(string provider)
    {
        var baseUrl = PlatformApi.Value.BaseUrl.TrimEnd('/');
        var returnUrl = Uri.EscapeDataString(Nav.ToAbsoluteUri("/admin/external-login-callback").ToString());
        return $"{baseUrl}/api/v1/platform/auth/external/{provider}/challenge?returnUrl={returnUrl}";
    }
}

@page "/admin/login"
@layout EmptyLayout
@using AntDesign
@using ExItS.Platform.Admin.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Brand_Name"] — Login</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-login-brand">
                <span class="exits-brand-mark">EA</span>
                <span>@L["Brand_Name"]</span>
            </div>
        </TitleTemplate>
        <Body>
            <Paragraph Type="@TextElementType.Secondary">@L["Login_CredentialsHint"]</Paragraph>

            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <Alert Type="@AlertType.Success" Message="@_notice" ShowIcon="true" Closable="true" OnClose="() => _notice = null" Style="margin-bottom: 1rem;" />
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Closable="true" OnClose="() => _error = null" Style="margin-bottom: 1rem;" />
            }

            <LocalValidationIdentityPicker />

            @* Native form POST — Interactive Server cannot set auth cookies from a Blazor event.
               Leave email/password unbound so test-user JS fill is not wiped on re-render. *@
            <form method="post" action="/admin/login/credentials" class="exits-login-form">
                <input type="hidden" name="ReturnApp" value="@ReturnApp" />
                <input type="hidden" name="ReturnPath" value="@ReturnPath" />
                <div class="ant-form-item">
                    <label class="ant-form-item-label" for="login-email">@L["Login_Email"]</label>
                    <input id="login-email"
                           name="Email"
                           type="text"
                           class="ant-input"
                           autocomplete="username"
                           required
                           placeholder="@L["Login_Email"]" />
                </div>
                <div class="ant-form-item">
                    <label class="ant-form-item-label" for="login-password">@L["Login_Password"]</label>
                    <input id="login-password"
                           name="Password"
                           type="password"
                           class="ant-input"
                           autocomplete="current-password"
                           required
                           placeholder="@L["Login_Password"]" />
                </div>
                <button type="submit" class="ant-btn ant-btn-primary ant-btn-block ant-btn-sm">
                    @L["Login_SignIn"]
                </button>
                <div class="exits-login-links">
                    <a href="/admin/register">@L["Login_Register"]</a>
                    <a href="/admin/forgot-password">@L["Login_ForgotPassword"]</a>
                </div>
            </form>

            <Divider>@L["Login_OrContinueWith"]</Divider>
            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                <Button Block Size="@ButtonSize.Small" OnClick="() => Nav.NavigateTo(GoogleChallengeUrl, forceLoad: true)">
                    @L["Login_ContinueGoogle"]
                </Button>
                <Button Block Size="@ButtonSize.Small" OnClick="() => Nav.NavigateTo(FacebookChallengeUrl, forceLoad: true)">
                    @L["Login_ContinueFacebook"]
                </Button>
            </Space>
            <Paragraph Type="@TextElementType.Secondary" Style="margin-top:.5rem; font-size:12px;">
                @L["Login_SocialDisclaimer"]
            </Paragraph>
        </Body>
    </Card>
</div>

@code {
    private string? _error;
    private string? _notice;

    [Inject] private IOptions<PlatformApiOptions> PlatformApi { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorQuery { get; set; }

    [SupplyParameterFromQuery(Name = "notice")]
    public string? NoticeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "returnApp")]
    public string? ReturnApp { get; set; }

    [SupplyParameterFromQuery(Name = "returnPath")]
    public string? ReturnPath { get; set; }

    private string GoogleChallengeUrl => BuildChallengeUrl("google");
    private string FacebookChallengeUrl => BuildChallengeUrl("facebook");

    protected override void OnInitialized()
    {
        _error = string.IsNullOrWhiteSpace(ErrorQuery) ? null : ErrorQuery;
        if (string.Equals(NoticeQuery, "session-expired", StringComparison.OrdinalIgnoreCase))
        {
            _error = L["Login_SessionExpired"];
            _notice = null;
        }
        else
        {
            _notice = string.IsNullOrWhiteSpace(NoticeQuery) ? null : NoticeQuery;
        }
    }

    private string BuildChallengeUrl(string provider)
    {
        var baseUrl = PlatformApi.Value.BaseUrl.TrimEnd('/');
        var returnUrl = Uri.EscapeDataString(Nav.ToAbsoluteUri("/admin/external-login-callback").ToString());
        return $"{baseUrl}/api/v1/platform/auth/external/{provider}/challenge?returnUrl={returnUrl}";
    }
}

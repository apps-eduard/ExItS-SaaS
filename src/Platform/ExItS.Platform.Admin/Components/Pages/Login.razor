@page "/admin/login"
@layout EmptyLayout
@rendermode InteractiveServer
@using ExItS.Platform.Admin.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@attribute [AllowAnonymous]
@inject PlatformBrowserSessionService SessionService
@inject NavigationManager Nav
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Brand_Name"] — Login</PageTitle>

<div class="login-shell">
    <div class="login-panel page-frame page-frame--form">
        <h1 class="brand-text">@L["Brand_Name"]</h1>
        <p class="muted">Sign in with your Platform User credentials.</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="form-validation-summary" role="alert">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="OnSubmitAsync" FormName="admin-login">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label class="form-field-label" for="login-user">
                    <span class="form-field-label-text">Username or email</span>
                </label>
                <InputText id="login-user" class="form-control" @bind-Value="_model.UsernameOrEmail" autocomplete="username" />
            </div>
            <div class="form-field">
                <label class="form-field-label" for="login-password">
                    <span class="form-field-label-text">Password</span>
                </label>
                <InputText id="login-password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="current-password" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary" disabled="@_busy">@(_busy ? "Signing in…" : "Sign in")</button>
            </div>
            <p class="muted"><a href="/admin/forgot-password">Forgot password</a></p>
        </EditForm>

        <div class="form-actions" style="margin-top: 1.5rem; flex-direction: column; align-items: stretch; gap: 0.5rem;">
            <p class="muted" style="margin: 0;">Or continue with</p>
            <a class="secondary" href="@GoogleChallengeUrl">Continue with Google</a>
            <a class="secondary" href="@FacebookChallengeUrl">Continue with Facebook</a>
            <p class="muted" style="margin: 0; font-size: 0.85rem;">
                Social sign-in creates or links a Platform User only. It does not grant administrator, membership, or product access.
            </p>
        </div>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    [Inject] private IOptions<PlatformApiOptions> PlatformApi { get; set; } = default!;

    private string GoogleChallengeUrl => BuildChallengeUrl("google");
    private string FacebookChallengeUrl => BuildChallengeUrl("facebook");

    private string BuildChallengeUrl(string provider)
    {
        var baseUrl = PlatformApi.Value.BaseUrl.TrimEnd('/');
        var returnUrl = Uri.EscapeDataString(Nav.ToAbsoluteUri("/admin/external-login-callback").ToString());
        return $"{baseUrl}/api/v1/platform/auth/external/{provider}/challenge?returnUrl={returnUrl}";
    }

    private async Task OnSubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var (ok, error) = await SessionService.LoginAsync(_model.UsernameOrEmail, _model.Password);
            if (!ok)
            {
                _error = error ?? "Invalid username/email or password.";
                return;
            }

            Nav.NavigateTo("/admin", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginModel
    {
        public string UsernameOrEmail { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}

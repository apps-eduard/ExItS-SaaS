@page "/admin/organizations/{OrganizationId:guid}/members"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject ToastService Toasts
@inject IStringLocalizer<AdminResources> L

<AdminPageHeader Title="@L["OrgMembers_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Organizations"]} / {L["Common_Members"]}")" Description="@L["OrgMembers_Description"]" />
<div class="warning" role="note">@L["OrgMembers_Warning"]</div>

@if (_org is null) { <LoadingState Message="@L["OrgMembers_Loading"]" /> }
else if (!_org.IsSuccess) { <ErrorState Title="@(_org.Error?.Title ?? L["Common_Error"])" Detail="@_org.Error?.Detail" Unavailable="@(_org.Status == ApiCallStatus.Unavailable)" /> }
else
{
    <p><a href="/admin/organizations/@OrganizationId">← @_org.Data!.DisplayName @L["Common_CommercialSummary"]</a> · <a href="/admin/organizations/@OrganizationId/product-access">@L["Common_ProductAccess"]</a></p>
    <FormValidationSummary Title="@L["Common_ActionFailed"]" Message="@_formError" IsConflict="_formConflict" />

    <FormSection Title="@L["OrgMembers_AddSection"]">
        <div class="form-grid">
            <FormField Label="@L["OrgMembers_UserId"]" FieldId="org-add-user" Required="true" Error="@_fieldUserId" Help="GUID">
                <AdminInput @bind-Value="_addUserId" Placeholder="GUID" Disabled="_busy" />
            </FormField>
            <FormField Label="@L["OrgMembers_OrgRole"]" FieldId="org-add-role" Required="true">
                <AdminSelect @bind-Value="_addRole" Disabled="_busy">
                    <option>OrganizationMember</option>
                    <option>OrganizationAdministrator</option>
                    <option>OrganizationOwner</option>
                </AdminSelect>
            </FormField>
        </div>
        <FormActions PrimaryText="@L["OrgMembers_AddMember"]" Busy="_busy" OnPrimary="AddMemberAsync" />
    </FormSection>

    <div class="filters">
        <label>@L["Common_Status"]
            <select @bind="_status">
                <option value="">@L["Common_All"]</option>
                <option value="Active">@L["Status_Active"]</option>
                <option value="Suspended">@L["Status_Suspended"]</option>
                <option value="Removed">@L["Status_Removed"]</option>
            </select>
        </label>
        <button type="button" @onclick="ApplyMemberFiltersAsync">@L["Common_Apply"]</button>
    </div>

    @if (_members is null) { <LoadingState Message="@L["OrgMembers_LoadingMembers"]" /> }
    else if (!_members.IsSuccess) { <ErrorState Title="@L["OrgMembers_Unavailable"]" Detail="@_members.Error?.Detail" /> }
    else if (_members.Data!.Items.Count == 0) { <EmptyState Message="@L["OrgMembers_Empty"]" /> }
    else
    {
        <AdminDataTable TItem="OrganizationMembershipDto"
                        Items="_members.Data.Items"
                        Columns="_memberColumns"
                        Caption="@L["OrgMembers_Title"]"
                        ItemKey="m => m.Id"
                        CellTemplate="MemberCell"
                        RowActions="MemberActions" />
        <AdminPagination Page="_members.Data.Page"
                         PageSize="_members.Data.PageSize"
                         TotalCount="_members.Data.TotalCount"
                         PageChanged="OnMembersPageAsync" />
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true"
                   Title="@_confirm.Title"
                   Message="@_confirm.Message"
                   Kind="@_confirm.Kind"
                   OnConfirm="RunConfirmAsync"
                   OnCancel="ClearConfirm"
                   Busy="_busy" />
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    private ApiCallResult<OrganizationDto>? _org;
    private ApiCallResult<PagedResult<OrganizationMembershipDto>>? _members;
    private string _status = "";
    private string _addUserId = "";
    private string _addRole = "OrganizationMember";
    private string? _formError;
    private bool _formConflict;
    private string? _fieldUserId;
    private bool _busy;
    private ConfirmState? _confirm;
    private int _page = 1;
    private List<AdminColumnDefinition> _memberColumns = new();

    protected override void OnInitialized()
    {
        _memberColumns =
        [
            new("user", L["Common_User"], Primary: true),
            new("role", L["Common_Role"]),
            new("status", L["Common_Status"]),
            new("updated", L["Common_UpdatedUtc"])
        ];
    }

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _org = await Api.GetOrganizationAsync(OrganizationId);
        _members = await Api.GetOrganizationMembersAsync(
            OrganizationId,
            page: _page,
            status: string.IsNullOrWhiteSpace(_status) ? null : _status);
    }

    private async Task OnMembersPageAsync(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ApplyMemberFiltersAsync()
    {
        _page = 1;
        await ReloadAsync();
    }

    private RenderFragment<(OrganizationMembershipDto Item, AdminColumnDefinition Column)> MemberCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "user":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/users/{ctx.Item.UserId}");
                b.AddContent(2, ctx.Item.UserId);
                b.CloseElement();
                break;
            case "role":
                b.OpenElement(0, "select");
                b.AddAttribute(1, "value", ctx.Item.Role);
                b.AddAttribute(2, "disabled", _busy || ctx.Item.Status == "Removed");
                b.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => ChangeRoleAsync(ctx.Item.Id, e.Value?.ToString())));
                foreach (var role in new[] { "OrganizationOwner", "OrganizationAdministrator", "OrganizationMember" })
                {
                    b.OpenElement(4, "option");
                    b.AddAttribute(5, "value", role);
                    if (role == ctx.Item.Role)
                    {
                        b.AddAttribute(6, "selected", true);
                    }

                    b.AddContent(7, role);
                    b.CloseElement();
                }

                b.CloseElement();
                break;
            case "status":
                b.OpenComponent<StatusBadge>(0);
                b.AddAttribute(1, nameof(StatusBadge.Value), ctx.Item.Status);
                b.CloseComponent();
                break;
            case "updated":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.UpdatedAtUtc);
                b.CloseComponent();
                break;
        }
    };

    private RenderFragment<OrganizationMembershipDto> MemberActions => m => __builder =>
    {
        if (m.Status == "Active")
        {
            __builder.OpenElement(0, "button");
            __builder.AddAttribute(1, "type", "button");
            __builder.AddAttribute(2, "class", "secondary");
            __builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => Ask(L["OrgMembers_SuspendMembership"], L["OrgMembers_SuspendConfirmMessage"], () => SuspendAsync(m.Id), AdminDialogKind.Destructive)));
            __builder.AddContent(4, L["Common_Suspend"]);
            __builder.CloseElement();
            __builder.OpenElement(5, "button");
            __builder.AddAttribute(6, "type", "button");
            __builder.AddAttribute(7, "class", "danger");
            __builder.AddAttribute(8, "onclick", EventCallback.Factory.Create(this, () => Ask(L["OrgMembers_RevokeMembership"], L["OrgMembers_RevokeConfirmMessage"], () => RevokeAsync(m.Id), AdminDialogKind.Destructive)));
            __builder.AddContent(9, L["Common_Revoke"]);
            __builder.CloseElement();
        }
        else if (m.Status == "Suspended")
        {
            __builder.OpenElement(0, "button");
            __builder.AddAttribute(1, "type", "button");
            __builder.AddAttribute(2, "class", "secondary");
            __builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => ReactivateAsync(m.Id)));
            __builder.AddContent(4, L["OrgMembers_ReactivateMembership"]);
            __builder.CloseElement();
            __builder.OpenElement(5, "button");
            __builder.AddAttribute(6, "type", "button");
            __builder.AddAttribute(7, "class", "danger");
            __builder.AddAttribute(8, "onclick", EventCallback.Factory.Create(this, () => Ask(L["OrgMembers_RevokeMembership"], L["OrgMembers_RevokeSuspendedConfirmMessage"], () => RevokeAsync(m.Id), AdminDialogKind.Destructive)));
            __builder.AddContent(9, L["Common_Revoke"]);
            __builder.CloseElement();
        }
    };

    private async Task AddMemberAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        _fieldUserId = null;
        if (!Guid.TryParse(_addUserId, out var userId))
        {
            _fieldUserId = L["OrgMembers_UserIdInvalid"];
            _busy = false;
            return;
        }

        var result = await Api.AddOrganizationMemberAsync(OrganizationId, new AddMemberRequest(userId, _addRole));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["OrgMembers_ToastAdded"], ToastKind.Success);
        _addUserId = "";
        await ReloadAsync();
    }

    private async Task ChangeRoleAsync(Guid membershipId, string? role)
    {
        if (string.IsNullOrWhiteSpace(role) || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.ChangeMembershipRoleAsync(membershipId, new ChangeRoleRequest(role, "dev-admin"));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["OrgMembers_ToastRoleUpdated"], ToastKind.Success);
        await ReloadAsync();
    }

    private void Ask(string title, string message, Func<Task> action, AdminDialogKind kind) =>
        _confirm = new ConfirmState(title, message, action, kind);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private async Task SuspendAsync(Guid id)
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.SuspendMembershipAsync(id, new MembershipLifecycleRequest("Suspended from Admin", "dev-admin"));
        _busy = false;
        _confirm = null;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["OrgMembers_ToastSuspended"], ToastKind.Success);
        await ReloadAsync();
    }

    private async Task ReactivateAsync(Guid id)
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.ReactivateMembershipAsync(id, new MembershipLifecycleRequest(null, "dev-admin"));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["OrgMembers_ToastReactivated"], ToastKind.Success);
        await ReloadAsync();
    }

    private async Task RevokeAsync(Guid id)
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.RevokeMembershipAsync(id, new MembershipLifecycleRequest("Revoked from Admin", "dev-admin"));
        _busy = false;
        _confirm = null;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["OrgMembers_ToastRevoked"], ToastKind.Success);
        await ReloadAsync();
    }

    private Task ClearConfirm()
    {
        _confirm = null;
        return Task.CompletedTask;
    }

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action, AdminDialogKind Kind);
}

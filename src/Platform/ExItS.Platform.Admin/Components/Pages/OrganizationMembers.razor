@page "/admin/organizations/{OrganizationId:guid}/members"
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject AdminShellContext Shell
@inject NavigationManager Nav
@inject PlatformPermissionState Permissions
@inject OrganizationDeepLinkGuard DeepLinkGuard

@if (!Permissions.Loaded || !Shell.Loaded)
{
    <div style="padding:2rem;text-align:center;"><Spin /></div>
}
else if (Shell.IsOrganizationShell && !DeepLinkGuard.CanOpenOrganization(OrganizationId))
{
    <Result Status="@ResultStatus.Warning"
            Title="Organization context required"
            SubTitle="This organization is not the active organization context.">
        <Extra>
            <Button Type="@ButtonType.Primary" OnClick="@(() => Nav.NavigateTo(DeepLinkGuard.DeniedRedirectUrl(OrganizationId)))">
                Back
            </Button>
        </Extra>
    </Result>
}
else if (!CanAccessMembers)
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ManageMemberships" />
}
else
{
<PageHeader Class="exits-page-header" Title="@L["OrgMembers_Title"]" SubTitle="@L["OrgMembers_Description"]">
    <PageHeaderBreadcrumb>
        <Breadcrumb>
            <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
            @if (Shell.IsPlatformShell)
            {
                <BreadcrumbItem Href="/admin/organization-users">@L["Nav_OrganizationMemberships"]</BreadcrumbItem>
            }
            else
            {
                <BreadcrumbItem>@L["Nav_People"]</BreadcrumbItem>
            }
            <BreadcrumbItem Href="@($"/admin/organizations/{OrganizationId}")">@(_org?.Data?.DisplayName ?? L["Nav_Organizations"])</BreadcrumbItem>
            <BreadcrumbItem>@L["OrgMembers_Title"]</BreadcrumbItem>
        </Breadcrumb>
    </PageHeaderBreadcrumb>
</PageHeader>

<Alert Type="@AlertType.Warning" ShowIcon="true" Message="@L["OrgMembers_Warning"]" Style="margin-bottom:12px;" />
<FormValidationSummary Title="@L["Common_ActionFailed"]" Message="@_formError" IsConflict="_formConflict" />

@if (_org is null)
{
    <div style="padding:2rem;text-align:center;"><Spin Tip="@L["OrgMembers_Loading"]" /></div>
}
else if (!_org.IsSuccess)
{
    <Result Status="@ResultStatus.Error" Title="@(_org.Error?.Title ?? L["Common_Error"])" SubTitle="@_org.Error?.Detail" />
}
else
{
    <Space Style="margin-bottom:12px; width:100%;" Wrap>
        <Select TItemValue="string" TItem="string" @bind-Value="_status" Size="@InputSize.Small" Style="width:140px;" AllowClear Placeholder="@L["Common_Status"]">
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Active")" Label="@L["Status_Active"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Suspended")" Label="@L["Status_Suspended"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Removed")" Label="@L["Status_Deactivated"]" />
            </SelectOptions>
        </Select>
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ApplyMemberFiltersAsync">@L["Common_Apply"]</Button>
        <Button Size="@ButtonSize.Small" OnClick="@(() => Nav.NavigateTo($"/admin/organizations/{OrganizationId}/invitations"))">
            @L["OrgMembers_TabInvitations"]
        </Button>
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="() => _showAdd = !_showAdd">
            @(_showAdd ? L["Common_Cancel"] : L["OrgMembers_AddMember"])
        </Button>
    </Space>

    @if (_showAdd)
    {
        <Card Size="@CardSize.Small" Title="@L["OrgMembers_AddSection"]" Style="margin-bottom:12px;">
            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                <div>
                    <label class="ant-form-item-label">@L["OrgMembers_UserId"]</label>
                    <Input @bind-Value="_addUserId" Size="@InputSize.Small" Disabled="_busy" Placeholder="GUID" />
                    @if (_fieldUserId is not null) { <span class="exits-field-error">@_fieldUserId</span> }
                </div>
                <div>
                    <label class="ant-form-item-label">@L["OrgMembers_OrgRole"]</label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_addRole" Size="@InputSize.Small" Style="width:100%;" Disabled="_busy">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("OrganizationMember")" Label="@L["OrgMembers_Role_Staff"]" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("OrganizationOwner")" Label="@L["OrgMembers_Role_Owner"]" />
                        </SelectOptions>
                    </Select>
                    @if (_fieldAddRole is not null) { <span class="exits-field-error">@_fieldAddRole</span> }
                </div>
                <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="AddMemberAsync">@L["OrgMembers_AddMember"]</Button>
            </Space>
        </Card>
    }

    @if (_members is { IsSuccess: false })
    {
        <Result Status="@ResultStatus.Error" Title="@L["OrgMembers_Unavailable"]" SubTitle="@_members.Error?.Detail" />
    }
    else
    {
        <Table TItem="OrganizationMembershipDto"
               DataSource="@(_members?.Data?.Items ?? Array.Empty<OrganizationMembershipDto>())"
               Total="@(_members?.Data?.TotalCount ?? 0)"
               @bind-PageIndex="_page"
               PageSize="@(_members?.Data?.PageSize ?? 20)"
               Loading="@(_members is null)"
               Size="@TableSize.Small"
               Bordered
               RemoteDataSource
               OnPageIndexChange="OnMembersPageAsync"
               ScrollX="1200">
            <PropertyColumn Property="c => c.DisplayName" Title="@L["Common_User"]">
                @if (Shell.IsPlatformShell)
                {
                    <a href="/admin/users/@context.UserId">@(context.DisplayName ?? context.Username ?? context.UserId.ToString("D"))</a>
                }
                else
                {
                    @(context.DisplayName ?? context.Username ?? context.UserId.ToString("D"))
                }
            </PropertyColumn>
            <PropertyColumn Property="c => c.Email" Title="@L["Common_Email"]" Ellipsis />
            <PropertyColumn Property="c => c.EmployeeCode" Title="@L["Users_EmployeeCode"]">
                @(string.IsNullOrWhiteSpace(context.EmployeeCode) ? "—" : context.EmployeeCode)
            </PropertyColumn>
            <PropertyColumn Property="c => c.Role" Title="@L["OrgMembers_OrgRole"]">
                <Space Size="@SpaceSize.Small">
                    <Tag Color="@(context.Role == "OrganizationOwner" ? "gold" : "default")"
                         Style="@(context.Role == "OrganizationOwner" ? "font-weight:600;" : null)">
                        @(context.RoleDisplay ?? FormatOrgRole(context.Role))
                    </Tag>
                    @if (CanAccessMembers && context.Status == "Active")
                    {
                        <Tooltip Title="@("Change role")">
                            <Button Icon="edit"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Disabled="_busy"
                                    AriaLabel="Change role"
                                    OnClick="() => OpenRoleChange(context)" />
                        </Tooltip>
                    }
                </Space>
            </PropertyColumn>
            <ActionColumn Title="Product role">
                @if (context.ProductRoles is { Count: > 0 })
                {
                    <Space Size="@SpaceSize.Small" Wrap>
                        @foreach (var productRole in context.ProductRoles)
                        {
                            <Tag>@productRole</Tag>
                        }
                    </Space>
                }
                else
                {
                    <span>—</span>
                }
            </ActionColumn>
            <PropertyColumn Property="c => c.Branch" Title="Branch">
                @(string.IsNullOrWhiteSpace(context.Branch) ? "—" : context.Branch)
            </PropertyColumn>
            <PropertyColumn Property="c => c.AccountStatus" Title="Account status">
                @(FormatAccountStatus(context.AccountStatus))
            </PropertyColumn>
            <PropertyColumn Property="c => c.Status" Title="Membership status">
                <Tag Color="@(context.Status == "Active" ? "success" : context.Status == "Suspended" ? "error" : "default")">
                    @FormatMembershipStatusLabel(context.Status)
                </Tag>
            </PropertyColumn>
            <PropertyColumn Property="c => c.UpdatedAtUtc" Title="@L["Common_UpdatedUtc"]" Format="u" />
            <ActionColumn Title="@L["Common_Actions"]" Width="220">
                <Space Size="@SpaceSize.Small" Wrap>
                    @if (Shell.IsPlatformShell)
                    {
                        <Tooltip Title="@L["Common_ViewDetails"].Value">
                            <Button Icon="eye"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    AriaLabel="@L["Common_ViewDetails"].Value"
                                    OnClick="@(() => Nav.NavigateTo($"/admin/users/{context.UserId}"))" />
                        </Tooltip>
                    }
                    @if (context.Status == "Active")
                    {
                        <Tooltip Title="@L["OrgMembers_SuspendMembership"].Value">
                            <Button Icon="pause"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Danger
                                    Disabled="_busy"
                                    AriaLabel="@L["OrgMembers_SuspendMembership"].Value"
                                    OnClick="() => OpenMembershipLifecycle(context, MembershipLifecycleAction.Suspend)" />
                        </Tooltip>
                        <Tooltip Title="@L["OrgMembers_DeactivateMembership"].Value">
                            <Button Icon="stop"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Danger
                                    Disabled="_busy"
                                    AriaLabel="@L["OrgMembers_DeactivateMembership"].Value"
                                    OnClick="() => OpenMembershipLifecycle(context, MembershipLifecycleAction.Deactivate)" />
                        </Tooltip>
                    }
                    else if (context.Status == "Suspended")
                    {
                        <Tooltip Title="@L["OrgMembers_ReactivateMembership"].Value">
                            <Button Icon="play-circle"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Disabled="_busy"
                                    AriaLabel="@L["OrgMembers_ReactivateMembership"].Value"
                                    OnClick="() => OpenMembershipLifecycle(context, MembershipLifecycleAction.Reactivate)" />
                        </Tooltip>
                        <Tooltip Title="@L["OrgMembers_DeactivateMembership"].Value">
                            <Button Icon="stop"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Danger
                                    Disabled="_busy"
                                    AriaLabel="@L["OrgMembers_DeactivateMembership"].Value"
                                    OnClick="() => OpenMembershipLifecycle(context, MembershipLifecycleAction.Deactivate)" />
                        </Tooltip>
                    }
                    else if (context.Status == "Removed")
                    {
                        <Tooltip Title="@L["OrgMembers_ReactivateMembership"].Value">
                            <Button Icon="play-circle"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Disabled="_busy"
                                    AriaLabel="@L["OrgMembers_ReactivateMembership"].Value"
                                    OnClick="() => OpenMembershipLifecycle(context, MembershipLifecycleAction.Reactivate)" />
                        </Tooltip>
                        <Tooltip Title="@L["OrgMembers_MoveToSuspended"].Value">
                            <Button Icon="pause"
                                    Size="@ButtonSize.Small"
                                    Type="@ButtonType.Text"
                                    Danger
                                    Disabled="_busy"
                                    AriaLabel="@L["OrgMembers_MoveToSuspended"].Value"
                                    OnClick="() => OpenMembershipLifecycle(context, MembershipLifecycleAction.MoveToSuspended)" />
                        </Tooltip>
                    }
                </Space>
            </ActionColumn>
        </Table>
    }
}

<Modal Title="Change role"
       Visible="_roleChangeVisible"
       ConfirmLoading="_busy"
       OnOk="SubmitRoleChangeAsync"
       OnCancel="CloseRoleChange"
       OkText="@L["Common_Confirm"].Value"
       CancelText="@L["Common_Cancel"].Value">
    @if (_roleChangeTarget is not null)
    {
        <p style="margin-bottom:12px;">
            @(_roleChangeTarget.DisplayName ?? _roleChangeTarget.Username ?? _roleChangeTarget.UserId.ToString("D"))
        </p>
        <Select TItemValue="string" TItem="string" @bind-Value="_roleChangeNewRole" Size="@InputSize.Small" Style="width:100%;" Disabled="_busy">
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("OrganizationOwner")" Label="@L["OrgMembers_Role_Owner"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("OrganizationMember")" Label="@L["OrgMembers_Role_Staff"]" />
                @if (_roleChangeTarget.Role == "OrganizationAdministrator")
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@("OrganizationAdministrator")" Label="@L["OrgMembers_Role_Administrator"]" />
                }
            </SelectOptions>
        </Select>
    }
</Modal>

<Modal Title="@_membershipLifecycleTitle"
       Visible="_membershipLifecycleVisible"
       ConfirmLoading="_busy"
       OnOk="SubmitMembershipLifecycleAsync"
       OnCancel="CloseMembershipLifecycle"
       OkText="@L["Common_Confirm"].Value"
       CancelText="@L["Common_Cancel"].Value">
    <Alert Type="@AlertType.Warning" ShowIcon="true" Message="@_membershipLifecycleHint" Style="margin-bottom:12px;" />
    <Descriptions Size="@DescriptionsSize.Small" Column="1" Bordered Style="margin-bottom:12px;">
        <DescriptionsItem Title="@L["Common_User"]">@(_membershipLifecycleTarget?.DisplayName ?? _membershipLifecycleTarget?.Username ?? "—")</DescriptionsItem>
        <DescriptionsItem Title="@L["Common_Email"]">@(_membershipLifecycleTarget?.Email ?? "—")</DescriptionsItem>
        <DescriptionsItem Title="@L["Common_Status"]">@FormatMembershipStatusLabel(_membershipLifecycleTarget?.Status)</DescriptionsItem>
        <DescriptionsItem Title="@L["OrgMembers_TargetStatus"]">@_membershipLifecycleTargetStatus</DescriptionsItem>
        <DescriptionsItem Title="@L["OrgMembers_OrgRole"]">@(_membershipLifecycleTarget?.RoleDisplay ?? FormatOrgRole(_membershipLifecycleTarget?.Role))</DescriptionsItem>
    </Descriptions>
    @if (_membershipLifecycleRequiresReason)
    {
        <div style="margin-bottom:12px;">
            <label class="ant-form-item-label">@L["Users_LifecycleReason"]</label>
            <TextArea @bind-Value="_membershipLifecycleReason" Rows="3" Disabled="_busy" />
            @if (_fieldMembershipReason is not null) { <span class="exits-field-error">@_fieldMembershipReason</span> }
        </div>
    }
</Modal>
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }

    private ApiCallResult<OrganizationDto>? _org;
    private ApiCallResult<PagedResult<OrganizationMembershipDto>>? _members;
    private string _status = "";
    private string _addUserId = "";
    private string _addRole = "OrganizationMember";
    private bool _showAdd;
    private string? _formError;
    private bool _formConflict;
    private string? _fieldUserId;
    private string? _fieldAddRole;
    private bool _busy;
    private int _page = 1;
    private Guid? _loadedOrganizationId;

    private bool _roleChangeVisible;
    private OrganizationMembershipDto? _roleChangeTarget;
    private string _roleChangeNewRole = "OrganizationMember";

    private enum MembershipLifecycleAction
    {
        Suspend,
        Reactivate,
        Deactivate,
        MoveToSuspended
    }

    private bool _membershipLifecycleVisible;
    private MembershipLifecycleAction _membershipLifecycleAction;
    private OrganizationMembershipDto? _membershipLifecycleTarget;
    private string _membershipLifecycleTitle = "";
    private string _membershipLifecycleHint = "";
    private string _membershipLifecycleTargetStatus = "";
    private string _membershipLifecycleReason = "";
    private bool _membershipLifecycleRequiresReason;
    private string? _fieldMembershipReason;

    private bool IsOrgAdminMembership =>
        string.Equals(Shell.MembershipRole, "OrganizationOwner", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Shell.MembershipRole, "OrganizationAdministrator", StringComparison.OrdinalIgnoreCase);

    private bool CanAccessMembers =>
        Permissions.HasPermission(PlatformPermissionCodes.ManageMemberships)
        || (Shell.IsOrganizationShell
            && Shell.SelectedOrganizationId == OrganizationId
            && IsOrgAdminMembership);

    private static string FormatOrgRole(string? role) => role switch
    {
        "OrganizationOwner" => "Owner",
        "OrganizationMember" => "Staff",
        "OrganizationAdministrator" => "Administrator",
        _ => role ?? "—"
    };

    private string FormatMembershipStatusLabel(string? status) => status switch
    {
        "Removed" => L["Status_Deactivated"].Value,
        "Active" => L["Status_Active"].Value,
        "Suspended" => L["Status_Suspended"].Value,
        _ => status ?? "—"
    };

    private static string FormatAccountStatus(string? status) => status switch
    {
        "PendingVerification" => "Pending Verification",
        "Active" => "Active",
        "Suspended" => "Suspended",
        "Deactivated" => "Deactivated",
        _ => string.IsNullOrWhiteSpace(status) ? "—" : status
    };

    protected override async Task OnParametersSetAsync()
    {
        // Load shell first so Organization sessions mark permissions via EnsureLoadedForNonPlatformAsync
        // (empty set). Calling Permissions.EnsureLoadedAsync first can race and show a false deny.
        await Shell.EnsureLoadedAsync();
        if (!Permissions.Loaded)
        {
            await Permissions.EnsureLoadedAsync();
        }

        if (!CanAccessMembers)
        {
            return;
        }

        if (_loadedOrganizationId != OrganizationId)
        {
            _page = 1;
            _members = null;
            _org = null;
            _loadedOrganizationId = OrganizationId;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _org = await Api.GetOrganizationAsync(OrganizationId);
        await ReloadMembersAsync();
    }

    private async Task ReloadMembersAsync() =>
        _members = await Api.GetOrganizationMembersAsync(
            OrganizationId,
            page: _page,
            status: string.IsNullOrWhiteSpace(_status) ? null : _status);

    private async Task ApplyMemberFiltersAsync()
    {
        _page = 1;
        await ReloadMembersAsync();
    }

    private async Task OnMembersPageAsync(PaginationEventArgs args)
    {
        _page = args.Page;
        await ReloadMembersAsync();
    }

    private async Task AddMemberAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        _formError = null;
        _formConflict = false;
        _fieldUserId = null;
        _fieldAddRole = null;
        if (!Guid.TryParse(_addUserId, out var userId))
        {
            _fieldUserId = L["OrgMembers_UserIdInvalid"];
            _busy = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_addRole))
        {
            _fieldAddRole = L["OrgMembers_OrgRoleRequired"];
            _busy = false;
            return;
        }

        var result = await Api.AddOrganizationMemberAsync(OrganizationId, new AddMemberRequest(userId, _addRole));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        await Message.SuccessAsync(L["OrgMembers_ToastAdded"].Value);
        _addUserId = "";
        _showAdd = false;
        await ReloadMembersAsync();
    }

    private void OpenRoleChange(OrganizationMembershipDto membership)
    {
        _roleChangeTarget = membership;
        _roleChangeNewRole = membership.Role;
        _roleChangeVisible = true;
    }

    private void CloseRoleChange()
    {
        _roleChangeVisible = false;
        _roleChangeTarget = null;
    }

    private async Task SubmitRoleChangeAsync()
    {
        if (_roleChangeTarget is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        await ChangeRoleCoreAsync(_roleChangeTarget.Id, _roleChangeNewRole);
        if (_formError is null)
        {
            CloseRoleChange();
        }
    }

    private async Task ChangeRoleCoreAsync(Guid membershipId, string role)
    {
        _formError = null;
        var result = await Api.ChangeMembershipRoleAsync(membershipId, new ChangeRoleRequest(role, null));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            await ReloadMembersAsync();
            return;
        }

        await Message.SuccessAsync(L["OrgMembers_ToastRoleUpdated"].Value);
        await ReloadMembersAsync();
    }

    private void OpenMembershipLifecycle(OrganizationMembershipDto membership, MembershipLifecycleAction action)
    {
        _membershipLifecycleTarget = membership;
        _membershipLifecycleAction = action;
        _membershipLifecycleReason = "";
        _fieldMembershipReason = null;
        (_membershipLifecycleTitle, _membershipLifecycleHint, _membershipLifecycleTargetStatus, _membershipLifecycleRequiresReason) = action switch
        {
            MembershipLifecycleAction.Suspend => (
                L["OrgMembers_SuspendMembership"].Value,
                L["OrgMembers_SuspendConfirmMessage"].Value,
                L["Status_Suspended"].Value,
                true),
            MembershipLifecycleAction.Reactivate => (
                L["OrgMembers_ReactivateMembership"].Value,
                L["OrgMembers_ReactivateConfirmMessage"].Value,
                L["Status_Active"].Value,
                false),
            MembershipLifecycleAction.Deactivate => (
                L["OrgMembers_DeactivateMembership"].Value,
                L["OrgMembers_DeactivateConfirmMessage"].Value,
                L["Status_Deactivated"].Value,
                true),
            MembershipLifecycleAction.MoveToSuspended => (
                L["OrgMembers_MoveToSuspended"].Value,
                L["OrgMembers_MoveToSuspendedConfirmMessage"].Value,
                L["Status_Suspended"].Value,
                true),
            _ => ("", "", "", false)
        };
        _membershipLifecycleVisible = true;
    }

    private void CloseMembershipLifecycle()
    {
        _membershipLifecycleVisible = false;
        _membershipLifecycleTarget = null;
        _membershipLifecycleReason = "";
        _fieldMembershipReason = null;
    }

    private async Task SubmitMembershipLifecycleAsync()
    {
        if (_membershipLifecycleTarget is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _fieldMembershipReason = null;
        _formError = null;
        if (_membershipLifecycleRequiresReason && string.IsNullOrWhiteSpace(_membershipLifecycleReason))
        {
            _fieldMembershipReason = L["Users_LifecycleReasonRequired"];
            _busy = false;
            return;
        }

        var id = _membershipLifecycleTarget.Id;
        var reason = string.IsNullOrWhiteSpace(_membershipLifecycleReason)
            ? null
            : _membershipLifecycleReason.Trim();
        var result = _membershipLifecycleAction switch
        {
            MembershipLifecycleAction.Suspend or MembershipLifecycleAction.MoveToSuspended =>
                await Api.SuspendMembershipAsync(id, new MembershipLifecycleRequest(reason ?? "Suspended from Admin", null)),
            MembershipLifecycleAction.Reactivate =>
                await Api.ReactivateMembershipAsync(id, new MembershipLifecycleRequest(reason, null)),
            MembershipLifecycleAction.Deactivate =>
                await Api.RevokeMembershipAsync(id, new MembershipLifecycleRequest(reason ?? "Membership deactivated from Admin", null)),
            _ => throw new InvalidOperationException("Unknown membership lifecycle action.")
        };
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        var toast = _membershipLifecycleAction switch
        {
            MembershipLifecycleAction.Suspend or MembershipLifecycleAction.MoveToSuspended => L["OrgMembers_ToastSuspended"].Value,
            MembershipLifecycleAction.Deactivate => L["OrgMembers_ToastDeactivated"].Value,
            _ => L["OrgMembers_ToastReactivated"].Value
        };
        CloseMembershipLifecycle();
        await Message.SuccessAsync(toast);
        await ReloadMembersAsync();
    }

}

@page "/admin/products"
@page "/admin/products/{Id:guid}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

<PageFrame>
@if (Id is null)
{
    <PageHeader Title="@L["Products_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Products"]}")" Description="@L["Products_Description"]" />
    @if (_list is null)
    {
        <LoadingState Message="@L["Products_Loading"]" />
    }
    else if (!_list.IsSuccess)
    {
        <ErrorState Title="@(_list.Error?.Title ?? L["Common_Error"])" Detail="@_list.Error?.Detail" CorrelationId="@_list.Error?.CorrelationId" Unavailable="@(_list.Status == ApiCallStatus.Unavailable)" />
    }
    else if (_list.Data!.Items.Count == 0)
    {
        <EmptyState Message="@L["Products_Empty"]" />
    }
    else
    {
        <table class="data-table responsive-table">
            <caption class="sr-only">@L["Products_Title"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Common_Code"]</th>
                    <th scope="col">@L["Common_DisplayName"]</th>
                    <th scope="col">@L["Common_Status"]</th>
                    <th scope="col">@L["Common_UpdatedUtc"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _list.Data.Items)
                {
                    <tr>
                        <td data-label="@L["Common_Code"]"><a href="/admin/products/@item.Id">@item.Code</a></td>
                        <td data-label="@L["Common_DisplayName"]">@item.DisplayName</td>
                        <td data-label="@L["Common_Status"]"><StatusBadge Value="@item.Status" /></td>
                        <td data-label="@L["Common_UpdatedUtc"]"><UtcTimestamp Value="@item.UpdatedAtUtc" /></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted">@string.Format(L["Common_ShowingCount"], _list.Data.Items.Count, _list.Data.TotalCount)</p>
    }
}
else
{
    <PageHeader Title="@L["Products_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Products"]} / {L["Common_Detail"]}")" Description="@L["Products_DetailDescription"]" />
    @if (_overview is null)
    {
        <LoadingState Message="@L["Products_DetailLoading"]" />
    }
    else if (!_overview.IsSuccess)
    {
        <ErrorState Title="@(_overview.Error?.Title ?? L["Common_Error"])" Detail="@_overview.Error?.Detail" CorrelationId="@_overview.Error?.CorrelationId" Unavailable="@(_overview.Status == ApiCallStatus.Unavailable)" />
    }
    else
    {
        var o = _overview.Data!;
        <dl>
            <dt>@L["Common_Code"]</dt><dd>@o.Product.Code</dd>
            <dt>@L["Common_DisplayName"]</dt><dd>@o.Product.DisplayName</dd>
            <dt>@L["Common_Status"]</dt><dd><StatusBadge Value="@o.Product.Status" /></dd>
            <dt>@L["Common_CreatedUtc"]</dt><dd><UtcTimestamp Value="@o.Product.CreatedAtUtc" /></dd>
            <dt>@L["Common_UpdatedUtc"]</dt><dd><UtcTimestamp Value="@o.Product.UpdatedAtUtc" /></dd>
            <dt>@L["Products_FeatureCount"]</dt><dd>@o.Features.Count</dd>
            <dt>@L["Products_PlanCount"]</dt><dd>@o.Plans.Count</dd>
        </dl>

        <h2>@L["Products_FeatureDefinitions"]</h2>
        @if (o.Features.Count == 0) { <EmptyState Message="@L["Products_FeatureDefinitionsEmpty"]" /> }
        else
        {
            <table>
                <thead><tr><th>@L["Common_Code"]</th><th>@L["Common_Name"]</th><th>@L["Common_Type"]</th><th>@L["Common_Status"]</th></tr></thead>
                <tbody>
                @foreach (var f in o.Features)
                {
                    <tr><td>@f.FeatureCode</td><td>@f.DisplayName</td><td>@f.ValueType</td><td><StatusBadge Value="@f.Status" /></td></tr>
                }
                </tbody>
            </table>
        }

        <h2>@L["Products_Plans"]</h2>
        @if (o.Plans.Count == 0) { <EmptyState Message="@L["Products_PlansEmpty"]" /> }
        else
        {
            <table>
                <thead><tr><th>@L["Common_Code"]</th><th>@L["Common_Name"]</th><th>@L["Common_Status"]</th></tr></thead>
                <tbody>
                @foreach (var p in o.Plans)
                {
                    <tr><td>@p.Code</td><td>@p.DisplayName</td><td><StatusBadge Value="@p.Status" /></td></tr>
                }
                </tbody>
            </table>
        }

        <h2>@L["Products_PublishedPlanVersions"]</h2>
        @if (o.PublishedPlanVersions.Count == 0) { <EmptyState Message="@L["Products_PublishedPlanVersionsEmpty"]" /> }
        else
        {
            <table>
                <thead><tr><th>@L["Common_Plan"]</th><th>@L["Common_Version"]</th><th>@L["Products_Column_Billing"]</th><th>@L["Products_Column_TrialEligible"]</th><th>@L["Common_Grants"]</th></tr></thead>
                <tbody>
                @foreach (var v in o.PublishedPlanVersions)
                {
                    <tr>
                        <td>@v.PlanId</td>
                        <td>@v.VersionNumber</td>
                        <td>@v.BillingPeriod</td>
                        <td>@v.TrialEligible</td>
                        <td>@v.Grants.Count</td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h2>@L["Products_TrialDefinitions"]</h2>
        @if (o.Trials.Count == 0) { <EmptyState Message="@L["Products_TrialDefinitionsEmpty"]" /> }
        else
        {
            <table>
                <thead><tr><th>@L["Common_Name"]</th><th>@L["Common_Duration"]</th><th>@L["Common_Status"]</th><th>@L["Common_Grants"]</th></tr></thead>
                <tbody>
                @foreach (var t in o.Trials)
                {
                    <tr>
                        <td>@t.DisplayName</td>
                        <td>@t.DurationIso</td>
                        <td><StatusBadge Value="@t.Status" /></td>
                        <td>@t.FeatureGrants.Count</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
}
</PageFrame>

@code {
    [Parameter] public Guid? Id { get; set; }

    private ApiCallResult<PagedResult<ProductDto>>? _list;
    private ApiCallResult<ProductOverviewDto>? _overview;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null)
        {
            _list = await Api.GetProductsAsync();
            return;
        }

        var product = await Api.GetProductAsync(Id.Value);
        if (!product.IsSuccess || product.Data is null)
        {
            _overview = ApiCallResult<ProductOverviewDto>.NotFound(product.Error ?? new PlatformApiException(System.Net.HttpStatusCode.NotFound, "Not found", "Product was not found."));
            return;
        }

        _overview = await Api.GetProductOverviewAsync(product.Data.Code);
    }
}

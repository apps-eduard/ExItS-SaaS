@page "/admin/products"
@page "/admin/products/{Id:guid}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

@if (Id is null)
{
    <ReportPageShell>
        <ReportHeader Title="@L["Products_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Products"]}")" Description="@L["Products_Description"]" />
        <ReportSection Title="@L["Products_Title"]">
            <ReportDataPanel IsLoading="@(_list is null)"
                            HasError="@(_list is { IsSuccess: false })"
                            IsEmpty="@(_list is { IsSuccess: true, Data.Items.Count: 0 })"
                            LoadingMessage="@L["Products_Loading"]"
                            EmptyMessage="@L["Products_Empty"]"
                            ErrorTitle="@(_list?.Error?.Title ?? L["Common_Error"])"
                            ErrorDetail="@_list?.Error?.Detail"
                            ErrorCorrelationId="@_list?.Error?.CorrelationId"
                            ErrorUnavailable="@(_list?.Status == ApiCallStatus.Unavailable)">
                <ReportTable TItem="ProductDto"
                             Items="_list!.Data!.Items"
                             Columns="_productColumns"
                             Caption="@L["Products_Title"]"
                             ItemKey="p => p.Id"
                             CellTemplate="ProductCell" />
                <AdminPagination Page="_list!.Data!.Page"
                                 PageSize="_list.Data.PageSize"
                                 TotalCount="_list.Data.TotalCount"
                                 PageChanged="OnProductPageAsync" />
            </ReportDataPanel>
        </ReportSection>
    </ReportPageShell>
}
else
{
    <AdminPageHeader Title="@L["Products_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Products"]} / {L["Common_Detail"]}")" Description="@L["Products_DetailDescription"]" />
    <AdminDataPanel IsLoading="@(_overview is null)"
                    HasError="@(_overview is { IsSuccess: false })"
                    LoadingMessage="@L["Products_DetailLoading"]"
                    ErrorTitle="@(_overview?.Error?.Title ?? L["Common_Error"])"
                    ErrorDetail="@_overview?.Error?.Detail"
                    ErrorCorrelationId="@_overview?.Error?.CorrelationId"
                    ErrorUnavailable="@(_overview?.Status == ApiCallStatus.Unavailable)">
        @{
            var o = _overview!.Data!;
        }
        <KeyValueList>
            <dt>@L["Common_Code"]</dt><dd>@o.Product.Code</dd>
            <dt>@L["Common_DisplayName"]</dt><dd>@o.Product.DisplayName</dd>
            <dt>@L["Common_Status"]</dt><dd><StatusBadge Value="@o.Product.Status" /></dd>
            <dt>@L["Common_CreatedUtc"]</dt><dd><UtcTimestamp Value="@o.Product.CreatedAtUtc" /></dd>
            <dt>@L["Common_UpdatedUtc"]</dt><dd><UtcTimestamp Value="@o.Product.UpdatedAtUtc" /></dd>
            <dt>@L["Products_FeatureCount"]</dt><dd><QuantityDisplay Value="@o.Features.Count" Decimals="0" /></dd>
            <dt>@L["Products_PlanCount"]</dt><dd><QuantityDisplay Value="@o.Plans.Count" Decimals="0" /></dd>
        </KeyValueList>

        <DetailSection Title="@L["Products_FeatureDefinitions"]">
            @if (o.Features.Count == 0) { <EmptyState Message="@L["Products_FeatureDefinitionsEmpty"]" /> }
            else
            {
                <AdminDataTable TItem="FeatureDefinitionDto"
                                Items="o.Features"
                                Columns="_featureColumns"
                                Caption="@L["Products_FeatureDefinitions"]"
                                ItemKey="f => f.FeatureCode"
                                CellTemplate="FeatureCell" />
            }
        </DetailSection>

        <DetailSection Title="@L["Products_Plans"]">
            @if (o.Plans.Count == 0) { <EmptyState Message="@L["Products_PlansEmpty"]" /> }
            else
            {
                <AdminDataTable TItem="PlanDto"
                                Items="o.Plans"
                                Columns="_planColumns"
                                Caption="@L["Products_Plans"]"
                                ItemKey="p => p.Id"
                                CellTemplate="PlanCell" />
            }
        </DetailSection>

        <DetailSection Title="@L["Products_PublishedPlanVersions"]">
            @if (o.PublishedPlanVersions.Count == 0) { <EmptyState Message="@L["Products_PublishedPlanVersionsEmpty"]" /> }
            else
            {
                <AdminDataTable TItem="PlanVersionDto"
                                Items="o.PublishedPlanVersions"
                                Columns="_versionColumns"
                                Caption="@L["Products_PublishedPlanVersions"]"
                                ItemKey="v => v.Id"
                                CellTemplate="VersionCell" />
            }
        </DetailSection>

        <DetailSection Title="@L["Products_TrialDefinitions"]">
            @if (o.Trials.Count == 0) { <EmptyState Message="@L["Products_TrialDefinitionsEmpty"]" /> }
            else
            {
                <AdminDataTable TItem="TrialDefinitionDto"
                                Items="o.Trials"
                                Columns="_trialColumns"
                                Caption="@L["Products_TrialDefinitions"]"
                                ItemKey="t => t.Id"
                                CellTemplate="TrialCell" />
            }
        </DetailSection>
    </AdminDataPanel>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private ApiCallResult<PagedResult<ProductDto>>? _list;
    private ApiCallResult<ProductOverviewDto>? _overview;
    private int _page = 1;

    private List<AdminColumnDefinition> _productColumns = new();
    private List<AdminColumnDefinition> _featureColumns = new();
    private List<AdminColumnDefinition> _planColumns = new();
    private List<AdminColumnDefinition> _versionColumns = new();
    private List<AdminColumnDefinition> _trialColumns = new();

    protected override void OnInitialized()
    {
        _productColumns =
        [
            new("code", L["Common_Code"], Primary: true),
            new("name", L["Common_DisplayName"]),
            new("status", L["Common_Status"]),
            new("updated", L["Common_UpdatedUtc"])
        ];
        _featureColumns =
        [
            new("code", L["Common_Code"], Primary: true),
            new("name", L["Common_Name"]),
            new("type", L["Common_Type"]),
            new("status", L["Common_Status"])
        ];
        _planColumns =
        [
            new("code", L["Common_Code"], Primary: true),
            new("name", L["Common_Name"]),
            new("status", L["Common_Status"])
        ];
        _versionColumns =
        [
            new("plan", L["Common_Plan"], Primary: true),
            new("version", L["Common_Version"]),
            new("billing", L["Products_Column_Billing"]),
            new("trial", L["Products_Column_TrialEligible"]),
            new("grants", L["Common_Grants"], Numeric: true)
        ];
        _trialColumns =
        [
            new("name", L["Common_Name"], Primary: true),
            new("duration", L["Common_Duration"]),
            new("status", L["Common_Status"]),
            new("grants", L["Common_Grants"], Numeric: true)
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null)
        {
            await LoadProductsAsync();
            return;
        }

        var product = await Api.GetProductAsync(Id.Value);
        if (!product.IsSuccess || product.Data is null)
        {
            _overview = ApiCallResult<ProductOverviewDto>.NotFound(product.Error ?? new PlatformApiException(System.Net.HttpStatusCode.NotFound, "Not found", "Product was not found."));
            return;
        }

        _overview = await Api.GetProductOverviewAsync(product.Data.Code);
    }

    private async Task LoadProductsAsync() =>
        _list = await Api.GetProductsAsync(page: _page);

    private async Task OnProductPageAsync(int page)
    {
        _page = page;
        await LoadProductsAsync();
    }

    private RenderFragment<(ProductDto Item, AdminColumnDefinition Column)> ProductCell => ctx => __builder =>
    {
        switch (ctx.Column.Key)
        {
            case "code":
                __builder.OpenElement(0, "a");
                __builder.AddAttribute(1, "href", $"/admin/products/{ctx.Item.Id}");
                __builder.AddContent(2, ctx.Item.Code);
                __builder.CloseElement();
                break;
            case "name":
                __builder.AddContent(0, ctx.Item.DisplayName);
                break;
            case "status":
                __builder.OpenComponent<StatusBadge>(0);
                __builder.AddAttribute(1, nameof(StatusBadge.Value), ctx.Item.Status);
                __builder.CloseComponent();
                break;
            case "updated":
                __builder.OpenComponent<UtcTimestamp>(0);
                __builder.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.UpdatedAtUtc);
                __builder.CloseComponent();
                break;
        }
    };

    private RenderFragment<(FeatureDefinitionDto Item, AdminColumnDefinition Column)> FeatureCell => ctx => __builder =>
    {
        switch (ctx.Column.Key)
        {
            case "code":
                __builder.AddContent(0, ctx.Item.FeatureCode);
                break;
            case "name":
                __builder.AddContent(0, ctx.Item.DisplayName);
                break;
            case "type":
                __builder.AddContent(0, ctx.Item.ValueType);
                break;
            case "status":
                __builder.OpenComponent<StatusBadge>(0);
                __builder.AddAttribute(1, nameof(StatusBadge.Value), ctx.Item.Status);
                __builder.CloseComponent();
                break;
        }
    };

    private RenderFragment<(PlanDto Item, AdminColumnDefinition Column)> PlanCell => ctx => __builder =>
    {
        switch (ctx.Column.Key)
        {
            case "code":
                __builder.AddContent(0, ctx.Item.Code);
                break;
            case "name":
                __builder.AddContent(0, ctx.Item.DisplayName);
                break;
            case "status":
                __builder.OpenComponent<StatusBadge>(0);
                __builder.AddAttribute(1, nameof(StatusBadge.Value), ctx.Item.Status);
                __builder.CloseComponent();
                break;
        }
    };

    private RenderFragment<(PlanVersionDto Item, AdminColumnDefinition Column)> VersionCell => ctx => __builder =>
    {
        switch (ctx.Column.Key)
        {
            case "plan":
                __builder.AddContent(0, ctx.Item.PlanId);
                break;
            case "version":
                __builder.AddContent(0, ctx.Item.VersionNumber);
                break;
            case "billing":
                __builder.AddContent(0, ctx.Item.BillingPeriod);
                break;
            case "trial":
                __builder.AddContent(0, ctx.Item.TrialEligible);
                break;
            case "grants":
                __builder.OpenComponent<QuantityDisplay>(0);
                __builder.AddAttribute(1, nameof(QuantityDisplay.Value), (decimal?)ctx.Item.Grants.Count);
                __builder.AddAttribute(2, nameof(QuantityDisplay.Decimals), 0);
                __builder.CloseComponent();
                break;
        }
    };

    private RenderFragment<(TrialDefinitionDto Item, AdminColumnDefinition Column)> TrialCell => ctx => __builder =>
    {
        switch (ctx.Column.Key)
        {
            case "name":
                __builder.AddContent(0, ctx.Item.DisplayName);
                break;
            case "duration":
                __builder.AddContent(0, ctx.Item.DurationIso);
                break;
            case "status":
                __builder.OpenComponent<StatusBadge>(0);
                __builder.AddAttribute(1, nameof(StatusBadge.Value), ctx.Item.Status);
                __builder.CloseComponent();
                break;
            case "grants":
                __builder.OpenComponent<QuantityDisplay>(0);
                __builder.AddAttribute(1, nameof(QuantityDisplay.Value), (decimal?)ctx.Item.FeatureGrants.Count);
                __builder.AddAttribute(2, nameof(QuantityDisplay.Decimals), 0);
                __builder.CloseComponent();
                break;
        }
    };
}

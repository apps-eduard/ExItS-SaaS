@using AntDesign
@using ExItS.Platform.Admin.Services
@inject LocalValidationSignInService LocalValidationSignIn
@inject NavigationManager Nav
@inject IStringLocalizer<AdminResources> L

@if (_show)
{
    <div class="ant-form-item exits-lv-identity" style="margin-bottom: 1rem;">
        <label class="ant-form-item-label" for="login-test-user">@L["Login_TestUserSelect"]</label>

        @if (_loading)
        {
            <Paragraph Type="@TextElementType.Secondary" Style="margin:0;">@L["Common_Loading"]</Paragraph>
        }
        else if (_identities.Count > 0)
        {
            <select id="login-test-user"
                    class="exits-lv-identity__select"
                    autocomplete="off"
                    aria-describedby="login-test-user-hint"
                    onchange="window.exitsFillTestUserLogin && window.exitsFillTestUserLogin(this.value)">
                <option value="">@L["Login_TestUserSelect"]</option>
                @foreach (var identity in _identities)
                {
                    <option value="@LoginId(identity)" title="@identity.DisplayName">@FormatLabel(identity)</option>
                }
            </select>
            <Paragraph id="login-test-user-hint" Type="@TextElementType.Secondary" Style="margin:.35rem 0 0; font-size:12px;">
                @L["Login_TestUserHint"]
            </Paragraph>
        }

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.35rem;gap:8px;">
            @if (!string.IsNullOrWhiteSpace(_loadNote))
            {
                <Paragraph Type="@TextElementType.Secondary" Style="margin:0; font-size:12px;">@_loadNote</Paragraph>
            }
            else if (_identities.Count > 0)
            {
                <Paragraph Type="@TextElementType.Secondary" Style="margin:0; font-size:12px;">
                    Canonical baseline: Olivia Mendoza, Rafael Torres. Other entries are accounts currently in this Local Validation database (@_identities.Count).
                </Paragraph>
            }
            else
            {
                <span></span>
            }
            <a class="ant-btn ant-btn-link ant-btn-sm" href="@Nav.Uri">Refresh</a>
        </div>
    </div>
}

@code {
    private bool _show;
    private bool _loading;
    private string? _loadNote;
    private IReadOnlyList<LocalValidationIdentityOption> _identities = [];

    protected override async Task OnInitializedAsync()
    {
        _show = LocalValidationSignIn.IsAvailable;
        if (!_show)
        {
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadNote = null;
        try
        {
            _identities = await LocalValidationSignIn.ListIdentitiesAsync();
            if (_identities.Count == 0)
            {
                _loadNote = L["Login_LocalValidationUnavailable"];
            }
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Login id only (email or org staff username). Never password. Used as native select values
    /// so Docker/Tailscale login can fill the field without an Interactive Server circuit.
    /// </summary>
    private static string LoginId(LocalValidationIdentityOption identity)
    {
        var loginId = !string.IsNullOrWhiteSpace(identity.Email)
            ? identity.Email
            : identity.Username;
        return loginId ?? string.Empty;
    }

    private static string FormatLabel(LocalValidationIdentityOption identity)
    {
        var raw = string.IsNullOrWhiteSpace(identity.DisplayName)
            ? identity.Username
            : identity.DisplayName;
        var dash = raw.IndexOf(" — ", StringComparison.Ordinal);
        var name = dash > 0 ? raw[..dash] : raw;
        if (!string.IsNullOrWhiteSpace(identity.ScopeLabel)
            && name.IndexOf(identity.ScopeLabel, StringComparison.OrdinalIgnoreCase) < 0)
        {
            return $"{name} — {identity.ScopeLabel}";
        }

        return name;
    }
}

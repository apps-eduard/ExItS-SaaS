@using AntDesign
@using ExItS.Platform.Admin.Services
@inject LocalValidationSignInService LocalValidationSignIn
@inject IStringLocalizer<AdminResources> L

@if (_show)
{
    <div class="ant-form-item exits-lv-identity" style="margin-bottom: 1rem;">
        <label class="ant-form-item-label">@L["Login_TestUserSelect"]</label>

        @if (_loading)
        {
            <Paragraph Type="@TextElementType.Secondary" Style="margin:0;">@L["Common_Loading"]</Paragraph>
        }
        else if (_identities.Count > 0)
        {
            <div class="exits-lv-identity__list" role="list">
                @foreach (var identity in _identities)
                {
                    <button type="button"
                            role="listitem"
                            class="ant-btn ant-btn-default ant-btn-block ant-btn-sm exits-lv-identity__item"
                            @onclick="() => OnTestUserSelectedAsync(identity)">
                        @FormatLabel(identity)
                    </button>
                }
            </div>
            <Paragraph Type="@TextElementType.Secondary" Style="margin:.35rem 0 0; font-size:12px;">
                @L["Login_TestUserHint"]
            </Paragraph>
        }

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.35rem;gap:8px;">
            @if (!string.IsNullOrWhiteSpace(_loadNote))
            {
                <Paragraph Type="@TextElementType.Secondary" Style="margin:0; font-size:12px;">@_loadNote</Paragraph>
            }
            else if (_identities.Count > 0)
            {
                <Paragraph Type="@TextElementType.Secondary" Style="margin:0; font-size:12px;">
                    Canonical baseline: Olivia Mendoza, Rafael Torres. Other entries are accounts currently in this Local Validation database (@_identities.Count).
                </Paragraph>
            }
            else
            {
                <span></span>
            }
            <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Disabled="_loading" OnClick="ReloadAsync">
                Refresh
            </Button>
        </div>
    </div>
}

@code {
    private bool _show;
    private bool _loading;
    private string? _loadNote;
    private IReadOnlyList<LocalValidationIdentityOption> _identities = [];

    /// <summary>
    /// Fills the login username field only. Parent owns form state (JS fill was unreliable under Interactive Server).
    /// </summary>
    [Parameter]
    public EventCallback<string> OnIdentitySelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _show = LocalValidationSignIn.IsAvailable;
        if (!_show)
        {
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadNote = null;
        try
        {
            _identities = await LocalValidationSignIn.ListIdentitiesAsync();
            if (_identities.Count == 0)
            {
                _loadNote = L["Login_LocalValidationUnavailable"];
            }
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatLabel(LocalValidationIdentityOption identity)
    {
        var name = string.IsNullOrWhiteSpace(identity.DisplayName)
            ? identity.Username
            : identity.DisplayName;
        if (!string.IsNullOrWhiteSpace(identity.ScopeLabel))
        {
            return $"{name} — {identity.ScopeLabel}";
        }

        return name;
    }

    private async Task OnTestUserSelectedAsync(LocalValidationIdentityOption identity)
    {
        // Email carries loginDisplay from API (real email or org staff <local>@ORG######).
        var loginId = !string.IsNullOrWhiteSpace(identity.Email)
            ? identity.Email
            : identity.Username;
        if (OnIdentitySelected.HasDelegate)
        {
            await OnIdentitySelected.InvokeAsync(loginId ?? string.Empty);
        }
    }
}

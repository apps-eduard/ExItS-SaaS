@page "/admin/audit"
@page "/admin/audit/{AuditId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject PlatformPermissionState Permissions
@inject IStringLocalizer<AdminResources> L

@if (!Permissions.Loaded)
{
    <LoadingState />
}
else if (!Permissions.HasPermission(PlatformPermissionCodes.ViewAuditRecords))
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ViewAuditRecords" />
}
else if (AuditId is null)
{
    <ReportPageShell>
        <ReportHeader Title="@L["Audit_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Audit"]}")" Description="@L["Audit_Description"]" />

        <ResponsiveReportLayout>
            <Filters>
                <ReportFilterBar Busy="_listBusy" OnApply="LoadAsync" OnReset="ClearFiltersAsync">
                    <FormField Label="@L["Audit_FilterDateFrom"]" FieldId="audit-from">
                        <AdminInput @bind-Value="_fromText" Placeholder="yyyy-MM-ddTHH:mm:ssZ" Disabled="_listBusy" />
                    </FormField>
                    <FormField Label="@L["Audit_FilterDateTo"]" FieldId="audit-to">
                        <AdminInput @bind-Value="_toText" Placeholder="yyyy-MM-ddTHH:mm:ssZ" Disabled="_listBusy" />
                    </FormField>
                    <FormField Label="@L["Audit_FilterActor"]" FieldId="audit-actor">
                        <AdminInput @bind-Value="_actor" Placeholder="dev-admin" Disabled="_listBusy" />
                    </FormField>
                    <FormField Label="@L["Audit_FilterAction"]" FieldId="audit-action">
                        <AdminInput @bind-Value="_action" Placeholder="platform.subscription.activated" Disabled="_listBusy" />
                    </FormField>
                    <FormField Label="@L["Audit_FilterOrganization"]" FieldId="audit-org">
                        <AdminInput @bind-Value="_organizationId" Placeholder="GUID" Disabled="_listBusy" />
                    </FormField>
                    <FormField Label="@L["Audit_FilterProduct"]" FieldId="audit-product">
                        <AdminInput @bind-Value="_productCode" Disabled="_listBusy" />
                    </FormField>
                    <FormField Label="@L["Audit_FilterOutcome"]" FieldId="audit-outcome">
                        <AdminSelect @bind-Value="_outcome" Disabled="_listBusy">
                            <option value="">@L["Common_All"]</option>
                            <option value="Succeeded">@L["Audit_OutcomeSucceeded"]</option>
                            <option value="Denied">@L["Audit_OutcomeDenied"]</option>
                            <option value="Failed">@L["Audit_OutcomeFailed"]</option>
                        </AdminSelect>
                    </FormField>
                </ReportFilterBar>
            </Filters>
            <ChildContent>
                <ReportSection Title="@L["Audit_Title"]">
                    <ReportDataPanel IsLoading="@(_list is null || _listBusy)"
                                    HasError="@(_list is { IsSuccess: false })"
                                    IsEmpty="@(_list is { IsSuccess: true, Data.Items.Count: 0 })"
                                    LoadingMessage="@L["Audit_Title"]"
                                    EmptyMessage="@L["Audit_Empty"]"
                                    ErrorTitle="@(_list?.Error?.Title ?? L["Common_Error"])"
                                    ErrorDetail="@AuditErrorDetail"
                                    ErrorCorrelationId="@_list?.Error?.CorrelationId"
                                    ErrorUnavailable="@(_list?.Status == ApiCallStatus.Unavailable)">
                        <ReportTable TItem="AuditRecordDto"
                                     Items="_list!.Data!.Items"
                                     Columns="_auditColumns"
                                     Caption="@L["Audit_Title"]"
                                     ItemKey="a => a.Id"
                                     CellTemplate="AuditCell" />
                        <ReportTotalsRow Label="@L["Report_PaymentsTotals"]" Value="@($"{_list.Data.Items.Count}")" />
                    </ReportDataPanel>
                </ReportSection>
            </ChildContent>
        </ResponsiveReportLayout>
    </ReportPageShell>
}
else
{
    <AdminPageHeader Title="@L["Audit_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Audit"]} / {L["Common_ViewDetails"]}")" Description="@L["Audit_DetailDescription"]" />

    @if (_detail is null)
    {
        <LoadingState />
    }
    else if (!_detail.IsSuccess)
    {
        <ErrorState Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" />
        <p class="muted">@L["Audit_NotReady"]</p>
    }
    else
    {
        var r = _detail.Data!;
        <dl>
            <dt>@L["Audit_ColumnOccurred"]</dt><dd><LocalTimestamp Value="@r.OccurredAtUtc" /></dd>
            <dt>@L["Audit_FilterActor"]</dt><dd>@r.ActorIdentifier (@r.ActorType)</dd>
            <dt>@L["Audit_ColumnAction"]</dt><dd>@r.ActionCode</dd>
            <dt>@L["Audit_ColumnTarget"]</dt><dd>@r.TargetType — @r.TargetId</dd>
            <dt>@L["Common_Organization"]</dt>
            <dd>
                @if (r.OrganizationId is Guid oid)
                {
                    <a href="/admin/organizations/@oid">@L["Common_Organization"]</a>
                }
                else
                {
                    <text>—</text>
                }
            </dd>
            <dt>@L["Audit_FilterProduct"]</dt><dd>@(r.ProductCode ?? "—")</dd>
            <dt>@L["Audit_ColumnOutcome"]</dt><dd><AdminStatusTag Value="@r.Outcome" /></dd>
            <dt>@L["Common_Reason"]</dt><dd>@(r.Reason ?? "—")</dd>
            <dt>@L["Common_Summary"]</dt><dd>@(r.Summary ?? "—")</dd>
            <dt>@L["Common_CorrelationId"]</dt><dd>@(r.CorrelationId ?? "—")</dd>
            <dt>Record ID</dt><dd>@r.Id</dd>
        </dl>

        <AuditTimeline Records="@(new[] { r })" ShowLink="false" />
    }
}

@code {
    [Parameter] public Guid? AuditId { get; set; }

    private ApiCallResult<PagedResult<AuditRecordDto>>? _list;
    private ApiCallResult<AuditRecordDto>? _detail;
    private bool _listBusy;
    private List<AdminColumnDefinition> _auditColumns = new();

    private string _fromText = "";
    private string _toText = "";
    private string _actor = "";
    private string _action = "";
    private string _organizationId = "";
    private string _productCode = "";
    private string _outcome = "";

    protected override void OnInitialized()
    {
        _auditColumns =
        [
            new("occurred", L["Audit_ColumnOccurred"], Primary: true),
            new("actor", L["Audit_ColumnActor"]),
            new("action", L["Audit_ColumnAction"]),
            new("target", L["Audit_ColumnTarget"]),
            new("outcome", L["Audit_ColumnOutcome"])
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        await Permissions.EnsureLoadedAsync();
        if (!Permissions.HasPermission(PlatformPermissionCodes.ViewAuditRecords))
        {
            return;
        }

        if (AuditId is null)
        {
            await LoadAsync();
        }
        else
        {
            _detail = await Api.GetAuditRecordAsync(AuditId.Value);
        }
    }

    private async Task LoadAsync()
    {
        _listBusy = true;
        try
        {
            var query = new AuditQuery(
                OccurredFromUtc: DateTimeOffset.TryParse(_fromText, out var from) ? from.ToUniversalTime() : null,
                OccurredToUtc: DateTimeOffset.TryParse(_toText, out var to) ? to.ToUniversalTime() : null,
                ActorIdentifier: string.IsNullOrWhiteSpace(_actor) ? null : _actor,
                ActionCode: string.IsNullOrWhiteSpace(_action) ? null : _action,
                OrganizationId: Guid.TryParse(_organizationId, out var orgId) ? orgId : null,
                ProductCode: string.IsNullOrWhiteSpace(_productCode) ? null : _productCode,
                Outcome: string.IsNullOrWhiteSpace(_outcome) ? null : _outcome);
            _list = await Api.GetAuditRecordsAsync(query);
        }
        finally
        {
            _listBusy = false;
        }
    }

    private async Task ClearFiltersAsync()
    {
        _fromText = _toText = _actor = _action = _organizationId = _productCode = _outcome = "";
        await LoadAsync();
    }

    private string AuditErrorDetail =>
        string.IsNullOrWhiteSpace(_list?.Error?.Detail)
            ? L["Audit_NotReady"]
            : $"{_list.Error.Detail} {L["Audit_NotReady"]}";

    private RenderFragment<(AuditRecordDto Item, AdminColumnDefinition Column)> AuditCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "occurred":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/audit/{ctx.Item.Id}");
                b.OpenComponent<LocalTimestamp>(2);
                b.AddAttribute(3, nameof(LocalTimestamp.Value), ctx.Item.OccurredAtUtc);
                b.CloseComponent();
                b.CloseElement();
                break;
            case "actor":
                b.AddContent(0, ctx.Item.ActorIdentifier);
                break;
            case "action":
                b.AddContent(0, ctx.Item.ActionCode);
                break;
            case "target":
                b.AddContent(0, $"{ctx.Item.TargetType} {ctx.Item.TargetId}");
                break;
            case "outcome":
                b.OpenComponent<AdminStatusTag>(0);
                b.AddAttribute(1, nameof(AdminStatusTag.Value), ctx.Item.Outcome);
                b.CloseComponent();
                break;
        }
    };
}

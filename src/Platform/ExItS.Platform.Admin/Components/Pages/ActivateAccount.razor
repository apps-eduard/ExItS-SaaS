@page "/admin/activate-account"
@layout EmptyLayout
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Brand_Name"] — Activate</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-login-brand">
                <span class="exits-brand-mark">EA</span>
                <span>@L["Activate_Title"]</span>
            </div>
        </TitleTemplate>
        <Body>
            <Paragraph Type="@TextElementType.Secondary">@L["Activate_Hint"]</Paragraph>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <Alert Type="@AlertType.Error" Message="@Error" ShowIcon="true" Style="margin-bottom: 1rem;" />
            }

            @* Native form POST — Interactive Server OnClick is not available without a circuit (Mailpit links). *@
            <form method="post" action="/admin/activate-account/complete" class="exits-login-form">
                <input type="hidden" name="Token" value="@Token" />
                <div class="ant-form-item">
                    <label class="ant-form-item-label" for="act-password">@L["Login_Password"]</label>
                    <input id="act-password"
                           name="Password"
                           type="password"
                           class="ant-input"
                           autocomplete="new-password"
                           required />
                </div>
                <div class="ant-form-item">
                    <label class="ant-form-item-label" for="act-confirm">@L["Activate_ConfirmPassword"]</label>
                    <input id="act-confirm"
                           name="ConfirmPassword"
                           type="password"
                           class="ant-input"
                           autocomplete="new-password"
                           required />
                </div>
                <button type="submit"
                        class="ant-btn ant-btn-primary ant-btn-block ant-btn-sm"
                        disabled="@string.IsNullOrWhiteSpace(Token)">
                    @L["Activate_Submit"]
                </button>
                <div class="exits-login-links">
                    <a href="/admin/login">@L["Login_SignIn"]</a>
                </div>
            </form>
        </Body>
    </Card>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}

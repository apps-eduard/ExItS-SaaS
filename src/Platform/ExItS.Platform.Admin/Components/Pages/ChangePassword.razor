@page "/admin/account/change-password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IPlatformApiClient Api
@inject NavigationManager Nav
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Brand_Name"] — Change password</PageTitle>

<div class="login-shell">
    <div class="login-panel page-frame page-frame--form">
        <h1>Change password</h1>
        <p class="muted">Requires an active signed-in session. All sessions are revoked after a successful change.</p>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="form-validation-summary" role="alert">@_error</div> }
        @if (_done)
        {
            <p>Password changed. Sign in again.</p>
            <p><a href="/admin/login">Sign in</a></p>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="OnSubmitAsync" FormName="change-password">
                <div class="form-field">
                    <label class="form-field-label" for="cur">Current password</label>
                    <InputText id="cur" type="password" class="form-control" @bind-Value="_model.CurrentPassword" autocomplete="current-password" />
                </div>
                <div class="form-field">
                    <label class="form-field-label" for="nw">New password</label>
                    <InputText id="nw" type="password" class="form-control" @bind-Value="_model.NewPassword" autocomplete="new-password" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-primary" disabled="@_busy">@(_busy ? "Saving…" : "Change password")</button>
                    <a href="/admin">Cancel</a>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private readonly Model _model = new();
    private string? _error;
    private bool _busy;
    private bool _done;

    private async Task OnSubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.ChangePasswordAsync(new ChangePasswordRequest(_model.CurrentPassword, _model.NewPassword));
            if (!result.IsSuccess)
            {
                _error = result.Error?.Detail ?? "Password change failed.";
                return;
            }

            _done = true;
        }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
    }
}

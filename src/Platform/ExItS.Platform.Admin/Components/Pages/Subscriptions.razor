@page "/admin/subscriptions"
@page "/admin/subscriptions/{Id:guid}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject NavigationManager Nav
@inject IStringLocalizer<AdminResources> L

@if (Id is null)
{
    <ReportPageShell>
        <ReportHeader Title="@L["Subscriptions_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Subscriptions"]}")" Description="@L["Subscriptions_Description"]" />
        <div class="warning" role="note">@L["Subscriptions_Warning"]</div>

        <section class="panel" aria-label="@L["Subscriptions_AriaStartTrial"]">
            <h2>@L["Subscriptions_StartTrial"]</h2>
            <p class="muted">@L["Subscriptions_StartTrialHint"]</p>
            @if (!string.IsNullOrWhiteSpace(_formError) && _showStartTrial) { <ErrorState Title="@L["Subscriptions_StartTrialFailed"]" Detail="@_formError" /> }
            <div class="form-grid">
                <label>@L["Common_Organization"] ID <input @bind="_trialOrgId" placeholder="GUID" /></label>
                <label>@L["OrgProductAccess_ProductCode"] <input @bind="_trialProductCode" placeholder="e.g. pinoy-business-pos" /></label>
                <label>@L["Common_Plan"] ID <input @bind="_trialPlanId" placeholder="GUID" /></label>
                <label>Plan version ID <input @bind="_trialPlanVersionId" placeholder="GUID" /></label>
                <label>Trial definition ID <input @bind="_trialDefinitionId" placeholder="GUID" /></label>
            </div>
            <div class="actions">
                <button type="button" class="secondary" @onclick="LoadTrialCatalogAsync" disabled="@_busy">@L["Subscriptions_LoadCatalog"]</button>
                <button type="button" @onclick="StartTrialAsync" disabled="@_busy">@L["Subscriptions_StartTrialButton"]</button>
            </div>
            @if (_overview is { IsSuccess: true })
            {
                <p class="muted">Active trials: @_overview.Data!.Trials.Count(t => t.Status == "Active") · Published plan versions: @_overview.Data.PublishedPlanVersions.Count</p>
                @if (_overview.Data.Trials.Any(t => t.Status == "Active"))
                {
                    <ul class="muted">
                        @foreach (var t in _overview.Data.Trials.Where(t => t.Status == "Active"))
                        {
                            <li>@t.DisplayName — @_overview.Data.Product.Code — duration @FormatDuration(t.DurationTicks) (id @t.Id)</li>
                        }
                    </ul>
                }
            }
            @if (!string.IsNullOrWhiteSpace(_toast) && Id is null) { <p class="toast" role="status">@_toast</p> }
        </section>

        <ResponsiveReportLayout>
            <Filters>
                <ReportFilterBar Busy="_listBusy" OnApply="ApplyFiltersAsync" OnReset="ClearFiltersAsync">
                    <FormField Label="@L["Common_Status"]" FieldId="sub-filter-status">
                        <AdminSelect @bind-Value="_status" Disabled="_listBusy">
                            <option value="Active">Active</option>
                            <option value="Trialing">Trialing</option>
                            <option value="GracePeriod">GracePeriod</option>
                            <option value="PastDue">PastDue</option>
                            <option value="Suspended">Suspended</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Expired">Expired</option>
                        </AdminSelect>
                    </FormField>
                    <FormField Label="@L["OrgProductAccess_ProductCode"]" FieldId="sub-filter-product">
                        <AdminInput @bind-Value="_productCode" Placeholder="optional" Disabled="_listBusy" />
                    </FormField>
                </ReportFilterBar>
            </Filters>
            <ChildContent>
                <ReportSection Title="@L["Subscriptions_Title"]">
                    <ReportDataPanel IsLoading="@(_list is null || _listBusy)"
                                    HasError="@(_list is { IsSuccess: false })"
                                    IsEmpty="@(_list is { IsSuccess: true, Data.Items.Count: 0 })"
                                    LoadingMessage="@L["Subscriptions_Loading"]"
                                    EmptyMessage="@L["Subscriptions_Empty"]"
                                    ErrorTitle="@(_list?.Error?.Title ?? L["Common_Error"])"
                                    ErrorDetail="@_list?.Error?.Detail"
                                    ErrorCorrelationId="@_list?.Error?.CorrelationId"
                                    ErrorUnavailable="@(_list?.Status == ApiCallStatus.Unavailable)">
                        <ReportTable TItem="SubscriptionDto"
                                     Items="_list!.Data!.Items"
                                     Columns="_subscriptionColumns"
                                     Caption="@L["Subscriptions_Title"]"
                                     ItemKey="s => s.Id"
                                     CellTemplate="SubscriptionCell" />
                        <ReportTotalsRow Label="@L["Report_PaymentsTotals"]"
                                         Value="@($"{_list.Data.Items.Count}")" />
                        <AdminPagination Page="_list.Data.Page"
                                         PageSize="_list.Data.PageSize"
                                         TotalCount="_list.Data.TotalCount"
                                         PageChanged="OnSubscriptionPageAsync"
                                         Disabled="_listBusy" />
                    </ReportDataPanel>
                </ReportSection>
            </ChildContent>
        </ResponsiveReportLayout>
    </ReportPageShell>
}
else
{
    <AdminPageHeader Title="@L["Subscriptions_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Subscriptions"]} / {L["Common_Detail"]}")" Description="@L["Subscriptions_DetailDescription"]" />
    <div class="warning" role="note">@L["Subscriptions_DetailWarning"]</div>

    @if (_detail is null) { <LoadingState Message="@L["Subscriptions_DetailLoading"]" /> }
    else if (!_detail.IsSuccess) { <ErrorState Title="@(_detail.Error?.Title ?? L["Common_Error"])" Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" /> }
    else
    {
        var s = _detail.Data!;
        @if (!string.IsNullOrWhiteSpace(_toast)) { <p class="toast" role="status">@_toast</p> }
        @if (!string.IsNullOrWhiteSpace(_formError)) { <ErrorState Title="@L["Common_ActionFailed"]" Detail="@_formError" /> }

        <dl>
            <dt>@L["Common_Status"]</dt><dd><StatusBadge Value="@s.Status" /></dd>
            <dt>@L["Common_Organization"]</dt><dd><a href="/admin/organizations/@s.OrganizationId">@s.OrganizationId</a></dd>
            <dt>@L["Common_Product"]</dt><dd>@s.ProductCode</dd>
            <dt>@L["Common_Plan"] id</dt><dd>@s.PlanId</dd>
            <dt>Plan version id</dt><dd>@s.PlanVersionId</dd>
            <dt>Trial definition</dt><dd>@(s.TrialDefinitionId?.ToString() ?? "—")</dd>
            <dt>Trial start (UTC)</dt><dd><UtcTimestamp Value="@s.TrialStartUtc" /></dd>
            <dt>@L["Subscriptions_Column_TrialEndUtc"]</dt><dd><UtcTimestamp Value="@s.TrialEndUtc" /></dd>
            <dt>Trial remaining</dt><dd>@TrialRemaining(s)</dd>
            <dt>Paid period start (UTC)</dt><dd><UtcTimestamp Value="@s.PaidPeriodStartUtc" /></dd>
            <dt>Paid period end (UTC)</dt><dd><UtcTimestamp Value="@s.PaidPeriodEndUtc" /></dd>
            <dt>Grace period end (UTC)</dt><dd><UtcTimestamp Value="@s.GracePeriodEndUtc" /></dd>
            <dt>Past due at (UTC)</dt><dd><UtcTimestamp Value="@s.PastDueAtUtc" /></dd>
            <dt>Suspended at (UTC)</dt><dd><UtcTimestamp Value="@s.SuspendedAtUtc" /></dd>
            <dt>Cancelled at (UTC)</dt><dd><UtcTimestamp Value="@s.CancelledAtUtc" /></dd>
            <dt>Expired at (UTC)</dt><dd><UtcTimestamp Value="@s.ExpiredAtUtc" /></dd>
            <dt>@L["Common_Version"]</dt><dd>@s.Version</dd>
            <dt>@L["Common_Related"]</dt>
            <dd>
                <a href="/admin/payments?organizationId=@s.OrganizationId">@L["Common_Payments"]</a>
                ·
                <a href="/admin/entitlements/history/@s.OrganizationId/@s.ProductCode">@L["Common_History"]</a>
                ·
                <a href="/admin/organizations/@s.OrganizationId/product-access">@L["Common_ProductAccess"]</a>
            </dd>
        </dl>

        <section class="panel" aria-label="@L["Subscriptions_LifecycleActions"]">
            <h2>@L["Subscriptions_LifecycleActions"]</h2>
            <p class="muted">@L["Subscriptions_LifecycleHint"]</p>
            <div class="form-grid">
                <label>Period start (UTC) <input @bind="_periodStartText" placeholder="yyyy-MM-ddTHH:mm:ssZ" /></label>
                <label>Period end (UTC) <input @bind="_periodEndText" placeholder="yyyy-MM-ddTHH:mm:ssZ" /></label>
                <label>Grace period end (UTC) <input @bind="_graceEndText" placeholder="yyyy-MM-ddTHH:mm:ssZ" /></label>
            </div>
            <div class="actions">
                @if (s.Status is "Trialing")
                {
                    <button type="button" @onclick="ActivateAsync" disabled="@_busy">Activate with paid period</button>
                    <button type="button" class="danger" @onclick='() => Ask("Expire trial", "Expire this trial subscription? This is terminal.", ExpireAsync)' disabled="@_busy">Expire trial</button>
                    <button type="button" class="danger" @onclick='() => Ask("Cancel subscription", "Cancel this subscription? Cancelled is terminal.", CancelAsync)' disabled="@_busy">Cancel</button>
                }
                @if (s.Status is "Active")
                {
                    <button type="button" class="secondary" @onclick="EnterGraceAsync" disabled="@_busy">Enter grace period</button>
                    <button type="button" class="secondary" @onclick='() => Ask("Suspend subscription", "Suspend this subscription? Effective commercial access will fail closed while suspended.", SuspendAsync)' disabled="@_busy">Suspend subscription</button>
                    <button type="button" class="danger" @onclick='() => Ask("Cancel subscription", "Cancel this subscription? Cancelled is terminal.", CancelAsync)' disabled="@_busy">Cancel</button>
                }
                @if (s.Status is "GracePeriod")
                {
                    <button type="button" class="secondary" @onclick="MarkPastDueAsync" disabled="@_busy">Mark past due</button>
                    <button type="button" class="secondary" @onclick='() => Ask("Suspend subscription", "Suspend this subscription?", SuspendAsync)' disabled="@_busy">Suspend subscription</button>
                    <button type="button" class="danger" @onclick='() => Ask("Cancel subscription", "Cancel this subscription? Cancelled is terminal.", CancelAsync)' disabled="@_busy">Cancel</button>
                }
                @if (s.Status is "PastDue")
                {
                    <button type="button" class="secondary" @onclick='() => Ask("Suspend subscription", "Suspend this past-due subscription?", SuspendAsync)' disabled="@_busy">Suspend subscription</button>
                    <button type="button" class="danger" @onclick='() => Ask("Cancel subscription", "Cancel this subscription? Cancelled is terminal.", CancelAsync)' disabled="@_busy">Cancel</button>
                }
                @if (s.Status is "Suspended")
                {
                    <button type="button" @onclick="ReactivateAsync" disabled="@_busy">Reactivate with new paid period</button>
                    <button type="button" class="danger" @onclick='() => Ask("Cancel subscription", "Cancel this subscription? Cancelled is terminal.", CancelAsync)' disabled="@_busy">Cancel</button>
                }
                @if (s.Status is "Cancelled" or "Expired")
                {
                    <p class="muted">Terminal state — no further lifecycle actions are available.</p>
                }
            </div>
        </section>
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true" Title="@_confirm.Title" Message="@_confirm.Message" OnConfirm="RunConfirmAsync" OnCancel="ClearConfirm" Busy="_busy" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private string _status = "Active";
    private string? _productCode;
    private ApiCallResult<PagedResult<SubscriptionDto>>? _list;
    private ApiCallResult<SubscriptionDto>? _detail;
    private ApiCallResult<ProductOverviewDto>? _overview;
    private bool _showStartTrial = true;
    private string _trialOrgId = "";
    private string _trialProductCode = "";
    private string _trialPlanId = "";
    private string _trialPlanVersionId = "";
    private string _trialDefinitionId = "";
    private string _periodStartText = "";
    private string _periodEndText = "";
    private string _graceEndText = "";
    private string? _toast;
    private string? _formError;
    private bool _busy;
    private bool _listBusy;
    private ConfirmState? _confirm;
    private int _page = 1;
    private List<AdminColumnDefinition> _subscriptionColumns = new();

    protected override void OnInitialized()
    {
        _subscriptionColumns =
        [
            new("product", L["Common_Product"], Primary: true),
            new("status", L["Common_Status"]),
            new("org", L["Common_Organization"]),
            new("trialEnd", L["Subscriptions_Column_TrialEndUtc"]),
            new("updated", L["Common_UpdatedUtc"])
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        _toast = null;
        _formError = null;
        PrefillPeriods();
        if (Id is null)
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("status", out var statusValues))
            {
                var status = statusValues.FirstOrDefault();
                if (!string.IsNullOrWhiteSpace(status))
                {
                    _status = status!;
                }
            }

            await LoadListAsync();
        }
        else
        {
            _detail = await Api.GetSubscriptionAsync(Id.Value);
        }
    }

    private void PrefillPeriods()
    {
        var now = DateTimeOffset.UtcNow;
        if (string.IsNullOrWhiteSpace(_periodStartText)) _periodStartText = now.ToString("yyyy-MM-ddTHH:mm:ssZ");
        if (string.IsNullOrWhiteSpace(_periodEndText)) _periodEndText = now.AddDays(30).ToString("yyyy-MM-ddTHH:mm:ssZ");
        if (string.IsNullOrWhiteSpace(_graceEndText)) _graceEndText = now.AddDays(37).ToString("yyyy-MM-ddTHH:mm:ssZ");
    }

    private async Task LoadListAsync()
    {
        _listBusy = true;
        try
        {
            _list = await Api.GetSubscriptionsAsync(
                string.IsNullOrWhiteSpace(_status) ? "Active" : _status,
                string.IsNullOrWhiteSpace(_productCode) ? null : _productCode,
                page: _page);
        }
        finally
        {
            _listBusy = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadListAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _status = "Active";
        _productCode = null;
        _page = 1;
        await LoadListAsync();
    }

    private async Task OnSubscriptionPageAsync(int page)
    {
        _page = page;
        await LoadListAsync();
    }

    private RenderFragment<(SubscriptionDto Item, AdminColumnDefinition Column)> SubscriptionCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "product":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/subscriptions/{ctx.Item.Id}");
                b.AddContent(2, ctx.Item.ProductCode);
                b.CloseElement();
                break;
            case "status":
                b.OpenComponent<ReportStatusBadge>(0);
                b.AddAttribute(1, nameof(ReportStatusBadge.Value), ctx.Item.Status);
                b.CloseComponent();
                break;
            case "org":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/organizations/{ctx.Item.OrganizationId}");
                b.AddContent(2, ctx.Item.OrganizationId);
                b.CloseElement();
                break;
            case "trialEnd":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.TrialEndUtc);
                b.CloseComponent();
                break;
            case "updated":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.UpdatedAtUtc);
                b.CloseComponent();
                break;
        }
    };

    private async Task LoadTrialCatalogAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_trialProductCode)) { _formError = "Product code is required to load catalog."; return; }
        _busy = true;
        _overview = await Api.GetProductOverviewAsync(_trialProductCode.Trim());
        _busy = false;
        if (!_overview.IsSuccess) { _formError = _overview.Error?.Detail ?? _overview.Error?.Title; return; }
        var plan = _overview.Data!.Plans.FirstOrDefault(p => p.Status == "Active");
        var version = _overview.Data.PublishedPlanVersions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
        var trial = _overview.Data.Trials.FirstOrDefault(t => t.Status == "Active");
        if (plan is not null) _trialPlanId = plan.Id.ToString();
        if (version is not null) _trialPlanVersionId = version.Id.ToString();
        if (trial is not null) _trialDefinitionId = trial.Id.ToString();
        _toast = "Catalog loaded. Review plan, version, and trial IDs before starting.";
    }

    private async Task StartTrialAsync()
    {
        _formError = null; _toast = null; _showStartTrial = true;
        if (!Guid.TryParse(_trialOrgId, out var orgId)
            || !Guid.TryParse(_trialPlanId, out var planId)
            || !Guid.TryParse(_trialPlanVersionId, out var versionId)
            || !Guid.TryParse(_trialDefinitionId, out var trialId))
        {
            _formError = "Organization, plan, plan version, and trial definition IDs must be valid GUIDs.";
            return;
        }

        _busy = true;
        var result = await Api.StartTrialAsync(orgId, new StartTrialRequest(planId, versionId, trialId));
        _busy = false;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Trial started.";
        Nav.NavigateTo($"/admin/subscriptions/{result.Data!.Id}");
    }

    private void Ask(string title, string message, Func<Task> action) => _confirm = new ConfirmState(title, message, action);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private Task ClearConfirm() { _confirm = null; return Task.CompletedTask; }

    private bool TryParsePeriod(out DateTimeOffset start, out DateTimeOffset end)
    {
        start = default; end = default;
        return DateTimeOffset.TryParse(_periodStartText, out start) && DateTimeOffset.TryParse(_periodEndText, out end);
    }

    private async Task ActivateAsync()
    {
        if (Id is null) return;
        _formError = null;
        if (!TryParsePeriod(out var start, out var end)) { _formError = "Paid period start/end must be valid UTC timestamps."; return; }
        _busy = true;
        var result = await Api.ActivateSubscriptionAsync(Id.Value, new ActivateSubscriptionRequest(start.ToUniversalTime(), end.ToUniversalTime()));
        _busy = false;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Subscription activated.";
        _detail = ApiCallResult<SubscriptionDto>.Success(result.Data!);
    }

    private async Task EnterGraceAsync()
    {
        if (Id is null) return;
        _formError = null;
        if (!DateTimeOffset.TryParse(_graceEndText, out var graceEnd)) { _formError = "Grace period end must be a valid UTC timestamp."; return; }
        _busy = true;
        var result = await Api.EnterGracePeriodAsync(Id.Value, new GracePeriodRequest(graceEnd.ToUniversalTime()));
        _busy = false;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Entered grace period.";
        _detail = ApiCallResult<SubscriptionDto>.Success(result.Data!);
    }

    private async Task MarkPastDueAsync()
    {
        if (Id is null) return;
        _busy = true; _formError = null;
        var result = await Api.MarkPastDueAsync(Id.Value);
        _busy = false;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Marked past due.";
        _detail = ApiCallResult<SubscriptionDto>.Success(result.Data!);
    }

    private async Task SuspendAsync()
    {
        if (Id is null) return;
        _busy = true; _formError = null;
        var result = await Api.SuspendSubscriptionAsync(Id.Value);
        _busy = false; await ClearConfirm();
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Subscription suspended.";
        _detail = ApiCallResult<SubscriptionDto>.Success(result.Data!);
    }

    private async Task ReactivateAsync()
    {
        if (Id is null) return;
        _formError = null;
        if (!TryParsePeriod(out var start, out var end)) { _formError = "Reactivation requires a valid new paid period."; return; }
        _busy = true;
        var result = await Api.ReactivateSubscriptionAsync(Id.Value, new ReactivateSubscriptionRequest(start.ToUniversalTime(), end.ToUniversalTime()));
        _busy = false;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Subscription reactivated.";
        _detail = ApiCallResult<SubscriptionDto>.Success(result.Data!);
    }

    private async Task CancelAsync()
    {
        if (Id is null) return;
        _busy = true; _formError = null;
        var result = await Api.CancelSubscriptionAsync(Id.Value);
        _busy = false; await ClearConfirm();
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Subscription cancelled.";
        _detail = ApiCallResult<SubscriptionDto>.Success(result.Data!);
    }

    private async Task ExpireAsync()
    {
        if (Id is null) return;
        _busy = true; _formError = null;
        var result = await Api.ExpireSubscriptionAsync(Id.Value);
        _busy = false; await ClearConfirm();
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Subscription expired.";
        _detail = ApiCallResult<SubscriptionDto>.Success(result.Data!);
    }

    private static string FormatDuration(long ticks) => TimeSpan.FromTicks(ticks).TotalDays is var days
        ? $"{days:0.##} days"
        : TimeSpan.FromTicks(ticks).ToString();

    private static string TrialRemaining(SubscriptionDto s)
    {
        if (s.TrialEndUtc is null || s.Status != "Trialing") return "—";
        var remaining = s.TrialEndUtc.Value - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero) return "Ended (display only — not lifecycle authority)";
        return $"{remaining.TotalDays:0.#} days remaining (display only — not lifecycle authority)";
    }

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action);
}

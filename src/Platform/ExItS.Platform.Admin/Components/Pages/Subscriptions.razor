@page "/admin/subscriptions"
@page "/admin/subscriptions/{Id:guid}"
@using AntDesign
@using AntDesign.TableModels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject PlatformPermissionState Permissions

@if (Id is null)
{
    <PageHeader Class="exits-page-header" Title="@L["Subscriptions_Title"]" SubTitle="@L["Subscriptions_Description"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_Subscriptions"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            @if (CanManage)
            {
                <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ToggleCreate">
                    @(_showCreate ? "Hide create" : L["Common_Create"])
                </Button>
            }
        </PageHeaderExtra>
    </PageHeader>

    <Alert Type="@AlertType.Warning" Message="@L["Subscriptions_Warning"]" ShowIcon="true" Style="margin-bottom:12px;" />

    <Space Style="margin-bottom:12px; width:100%;" Wrap>
        <Input @bind-Value="_search" Size="@InputSize.Small" Placeholder="Search organization or plan" Style="width:220px;" OnPressEnter="ApplyFiltersAsync" />
        <Select TItemValue="string" TItem="string" @bind-Value="_status" Size="@InputSize.Small" Placeholder="@L["Common_Status"]" Style="width:140px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Trialing")" Label="Trialing" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Active")" Label="@L["Status_Active"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("GracePeriod")" Label="GracePeriod" />
                <SelectOption TItemValue="string" TItem="string" Value="@("PastDue")" Label="PastDue" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Suspended")" Label="@L["Status_Suspended"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Cancelled")" Label="@L["Status_Cancelled"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Expired")" Label="@L["Status_Expired"]" />
            </SelectOptions>
        </Select>
        <Select TItemValue="string" TItem="string" @bind-Value="_productCode" Size="@InputSize.Small" Placeholder="@L["Common_Product"]" Style="width:200px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                @foreach (var product in _productOptions)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@product.Code" Label="@(string.IsNullOrWhiteSpace(product.DisplayName) ? product.Code : product.DisplayName)" />
                }
            </SelectOptions>
        </Select>
        <Select TItemValue="string" TItem="string" @bind-Value="_planIdText" Size="@InputSize.Small" Placeholder="@L["Common_Plan"]" Style="width:160px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                @foreach (var plan in _planOptions)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@plan.Id.ToString("D")" Label="@plan.DisplayName" />
                }
            </SelectOptions>
        </Select>
        <Select TItemValue="string" TItem="string" @bind-Value="_isTrialFilter" Size="@InputSize.Small" Placeholder="Trial" Style="width:120px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("true")" Label="Trialing only" />
                <SelectOption TItemValue="string" TItem="string" Value="@("false")" Label="Paid" />
            </SelectOptions>
        </Select>
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ApplyFiltersAsync">@L["Common_Apply"]</Button>
        <Button Size="@ButtonSize.Small" OnClick="ClearFiltersAsync">@L["Common_Reset"]</Button>
    </Space>

    @if (_showCreate && CanManage)
    {
        <Card Size="@CardSize.Small" Title="@L["Subscriptions_StartTrial"]" Style="margin-bottom:12px;">
            <FormValidationSummary Title="@L["Subscriptions_StartTrialFailed"]" Message="@_formError" IsConflict="_formConflict" />
            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                <div>
                    <label class="ant-form-item-label">Organization</label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_createOrgId" Style="width:100%;" Disabled="_busy" Placeholder="Select organization" AllowClear>
                        <SelectOptions>
                            @foreach (var org in _organizationOptions)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@org.Id.ToString("D")" Label="@org.DisplayName" />
                            }
                        </SelectOptions>
                    </Select>
                </div>
                <div>
                    <label class="ant-form-item-label">Product</label>
                    <Select TItemValue="string" TItem="string" Value="@_createProductCode" ValueChanged="OnCreateProductChangedAsync" Style="width:100%;" Disabled="_busy" Placeholder="Select product" AllowClear>
                        <SelectOptions>
                            @foreach (var product in _productOptions)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@product.Code" Label="@(string.IsNullOrWhiteSpace(product.DisplayName) ? product.Code : product.DisplayName)" />
                            }
                        </SelectOptions>
                    </Select>
                </div>
                <div>
                    <label class="ant-form-item-label">Plan</label>
                    <Select TItemValue="string" TItem="string" Value="@_createPlanId" ValueChanged="OnCreatePlanChangedAsync" Style="width:100%;" Disabled="_busy" Placeholder="Select plan" AllowClear>
                        <SelectOptions>
                            @foreach (var plan in CreatePlanChoices)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@plan.Id.ToString("D")" Label="@plan.DisplayName" />
                            }
                        </SelectOptions>
                    </Select>
                </div>
                <Alert Type="@AlertType.Info"
                       ShowIcon="true"
                       Message="Trial start only"
                       Description="Paid activation requires a confirmed payment on Payments (or commercial PayNow). Direct paid create is disabled."
                       Style="margin-bottom:8px;" />
                <Space>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="CreateSubscriptionAsync">@L["Common_Create"]</Button>
                    <Button Size="@ButtonSize.Small" OnClick="HideCreate" Disabled="_busy">@L["Common_Cancel"]</Button>
                </Space>
            </Space>
        </Card>
    }

    @if (_list is { IsSuccess: false })
    {
        <Result Status="@ResultStatus.Error" Title="@(_list.Error?.Title ?? L["Common_Error"])" SubTitle="@_list.Error?.Detail" />
    }
    else if (_list is { IsSuccess: true, Data.Items.Count: 0 })
    {
        <Empty Description="@L["Subscriptions_Empty"].Value" />
    }
    else
    {
        <Table TItem="SubscriptionDto"
               Class="exits-table-fit"
               DataSource="@(_list?.Data?.Items ?? Array.Empty<SubscriptionDto>())"
               Total="@(_list?.Data?.TotalCount ?? 0)"
               @bind-PageIndex="_page"
               PageSize="@(_list?.Data?.PageSize ?? 20)"
               Loading="@(_list is null)"
               Size="@TableSize.Small"
               Bordered
               ScrollX="2200"
               RemoteDataSource
               OnChange="OnSubscriptionsTableChangeAsync">
            <PropertyColumn Property="c => c.OrganizationDisplayName" Title="@L["Common_Organization"]" Sortable>
                <a href="/admin/organizations/@context.OrganizationId">@(string.IsNullOrWhiteSpace(context.OrganizationDisplayName) ? "Organization" : context.OrganizationDisplayName)</a>
            </PropertyColumn>
            <PropertyColumn Property="c => c.ProductDisplayName" Title="@L["Common_Product"]" Sortable Width="140">
                <a href="/admin/subscriptions/@context.Id">@(string.IsNullOrWhiteSpace(context.ProductDisplayName) ? "Product" : context.ProductDisplayName)</a>
            </PropertyColumn>
            <PropertyColumn Property="c => c.PlanDisplayName" Title="@L["Common_Plan"]" Sortable Width="120">
                @(string.IsNullOrWhiteSpace(context.PlanDisplayName) ? "—" : context.PlanDisplayName)
            </PropertyColumn>
            <PropertyColumn Property="c => c.AgreedPrice" Title="Agreed price" Sortable Width="120">
                <AdminMoneyDisplay Amount="@context.AgreedPrice" CurrencyCode="@context.CurrencyCode" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.BillingCycle" Title="Billing" Sortable Width="100">
                @(context.BillingCycle ?? "—")
            </PropertyColumn>
            <PropertyColumn Property="c => c.CurrencyCode" Title="Currency" Width="90">
                @(context.CurrencyCode ?? "—")
            </PropertyColumn>
            <PropertyColumn Property="c => c.Status" Title="Subscription Status" Sortable Width="110">
                <AdminStatusTag Value="@context.Status" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.CurrentPeriodEndUtc" Title="Period end" Sortable Width="180">
                <LocalTimestamp Value="@(context.CurrentPeriodEndUtc ?? context.PaidPeriodEndUtc)" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.PendingPlanDisplayName" Title="Pending plan" Width="140">
                @(string.IsNullOrWhiteSpace(context.PendingPlanDisplayName) ? "—" : context.PendingPlanDisplayName)
            </PropertyColumn>
            <PropertyColumn Property="c => c.TrialStartUtc" Title="Trial Start" Width="180">
                <LocalTimestamp Value="@context.TrialStartUtc" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.TrialEndUtc" Title="Trial End" Sortable Width="180">
                <LocalTimestamp Value="@context.TrialEndUtc" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.PaidPeriodEndUtc" Title="Paid Through" Sortable Width="180">
                <LocalTimestamp Value="@context.PaidPeriodEndUtc" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.RenewalDateUtc" Title="Renewal Date" Sortable Width="180">
                <LocalTimestamp Value="@context.RenewalDateUtc" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.UpdatedAtUtc" Title="@L["Common_UpdatedUtc"]" Sortable Width="180">
                <LocalTimestamp Value="@context.UpdatedAtUtc" />
            </PropertyColumn>
            <ActionColumn Title="@L["Common_Actions"]" Width="80">
                <Tooltip Title="@L["Common_Open"].Value">
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Icon="eye" AriaLabel="@L["Common_Open"].Value"
                            OnClick="@(() => Nav.NavigateTo($"/admin/subscriptions/{context.Id}"))" />
                </Tooltip>
            </ActionColumn>
        </Table>
    }
}
else
{
    <PageHeader Class="exits-page-header" Title="@(_detail?.Data?.OrganizationDisplayName ?? L["Subscriptions_DetailTitle"])" SubTitle="@(_detail?.Data is { } d ? $"{(string.IsNullOrWhiteSpace(d.ProductDisplayName) ? "Product" : d.ProductDisplayName)} · {(string.IsNullOrWhiteSpace(d.PlanDisplayName) ? "Plan" : d.PlanDisplayName)}" : L["Subscriptions_DetailDescription"])">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem Href="/admin/subscriptions">@L["Nav_Subscriptions"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Common_Detail"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            @if (_detail?.IsSuccess == true && CanManage)
            {
                var s = _detail.Data!;
                <Space Wrap>
                    @if (s.Status == "Trialing")
                    {
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="ActivateAsync">Activate</Button>
                        <Popconfirm Title="Expire this trial?" OnConfirm="ExpireAsync">
                            <Button Size="@ButtonSize.Small" Danger Loading="_busy">Expire</Button>
                        </Popconfirm>
                        <Popconfirm Title="Cancel this subscription?" OnConfirm="CancelAsync">
                            <Button Size="@ButtonSize.Small" Danger Loading="_busy">Cancel</Button>
                        </Popconfirm>
                    }
                    @if (s.Status == "Active")
                    {
                        <Button Size="@ButtonSize.Small" Loading="_busy" OnClick="EnterGraceAsync">Grace period</Button>
                        <Popconfirm Title="Suspend this subscription?" OnConfirm="SuspendAsync">
                            <Button Size="@ButtonSize.Small" Loading="_busy">Suspend</Button>
                        </Popconfirm>
                        <Popconfirm Title="Cancel this subscription?" OnConfirm="CancelAsync">
                            <Button Size="@ButtonSize.Small" Danger Loading="_busy">Cancel</Button>
                        </Popconfirm>
                    }
                    @if (s.Status is "GracePeriod" or "PastDue")
                    {
                        @if (s.Status == "GracePeriod")
                        {
                            <Button Size="@ButtonSize.Small" Loading="_busy" OnClick="MarkPastDueAsync">Mark past due</Button>
                        }
                        <Popconfirm Title="Suspend this subscription?" OnConfirm="SuspendAsync">
                            <Button Size="@ButtonSize.Small" Loading="_busy">Suspend</Button>
                        </Popconfirm>
                        <Popconfirm Title="Cancel this subscription?" OnConfirm="CancelAsync">
                            <Button Size="@ButtonSize.Small" Danger Loading="_busy">Cancel</Button>
                        </Popconfirm>
                    }
                    @if (s.Status == "Suspended")
                    {
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="ReactivateAsync">Reactivate</Button>
                        <Popconfirm Title="Cancel this subscription?" OnConfirm="CancelAsync">
                            <Button Size="@ButtonSize.Small" Danger Loading="_busy">Cancel</Button>
                        </Popconfirm>
                    }
                </Space>
            }
        </PageHeaderExtra>
    </PageHeader>

    <Alert Type="@AlertType.Warning" Message="@L["Subscriptions_DetailWarning"]" ShowIcon="true" Style="margin-bottom:12px;" />

    @if (_detail is null)
    {
        <div style="padding:2rem;text-align:center;"><Spin Tip="@L["Subscriptions_DetailLoading"]" /></div>
    }
    else if (!_detail.IsSuccess)
    {
        <Result Status="@ResultStatus.Error" Title="@(_detail.Error?.Title ?? L["Common_Error"])" SubTitle="@_detail.Error?.Detail" />
    }
    else
    {
        var s = _detail.Data!;
        <FormValidationSummary Title="@L["Common_ActionFailed"]" Message="@_formError" IsConflict="_formConflict" />
        <p>
            <a href="/admin/payments?organizationId=@s.OrganizationId">@L["Common_Payments"]</a>
            ·
            <a href="/admin/entitlements/history/@s.OrganizationId/@s.ProductCode">@L["Common_History"]</a>
            ·
            <a href="/admin/organizations/@s.OrganizationId/product-access">@L["Common_ProductAccess"]</a>
            ·
            <a href="/admin/organizations/@s.OrganizationId">@L["Common_Organization"]</a>
        </p>

        <Descriptions Bordered Size="@DescriptionsSize.Small" Column="2" Style="margin-bottom:12px;">
            <DescriptionsItem Title="@L["Common_Status"]"><AdminStatusTag Value="@s.Status" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Version"]">@s.Version</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Organization"]">
                <a href="/admin/organizations/@s.OrganizationId">@(string.IsNullOrWhiteSpace(s.OrganizationDisplayName) ? "Organization" : s.OrganizationDisplayName)</a>
            </DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Product"]">@(string.IsNullOrWhiteSpace(s.ProductDisplayName) ? "Product" : s.ProductDisplayName)</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Plan"]">@(string.IsNullOrWhiteSpace(s.PlanDisplayName) ? "—" : s.PlanDisplayName)</DescriptionsItem>
            <DescriptionsItem Title="Agreed price"><AdminMoneyDisplay Amount="@s.AgreedPrice" CurrencyCode="@s.CurrencyCode" /></DescriptionsItem>
            <DescriptionsItem Title="Billing cycle">@(s.BillingCycle ?? "—")</DescriptionsItem>
            <DescriptionsItem Title="Currency">@(s.CurrencyCode ?? "—")</DescriptionsItem>
            <DescriptionsItem Title="Current period start"><UtcTimestamp Value="@(s.CurrentPeriodStartUtc ?? s.PaidPeriodStartUtc)" /></DescriptionsItem>
            <DescriptionsItem Title="Current period end"><UtcTimestamp Value="@(s.CurrentPeriodEndUtc ?? s.PaidPeriodEndUtc)" /></DescriptionsItem>
            <DescriptionsItem Title="Pending plan">@(string.IsNullOrWhiteSpace(s.PendingPlanDisplayName) ? "—" : $"{s.PendingPlanDisplayName} ({s.PendingPlanKey})")</DescriptionsItem>
            <DescriptionsItem Title="Pending effective"><UtcTimestamp Value="@s.PendingPlanEffectiveAtUtc" /></DescriptionsItem>
            <DescriptionsItem Title="Trial start"><UtcTimestamp Value="@s.TrialStartUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Subscriptions_Column_TrialEndUtc"]"><UtcTimestamp Value="@s.TrialEndUtc" /></DescriptionsItem>
            <DescriptionsItem Title="Paid through"><UtcTimestamp Value="@s.PaidPeriodEndUtc" /></DescriptionsItem>
            <DescriptionsItem Title="Renewal date"><UtcTimestamp Value="@s.RenewalDateUtc" /></DescriptionsItem>
            <DescriptionsItem Title="Grace end"><UtcTimestamp Value="@s.GracePeriodEndUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Common_UpdatedUtc"]"><UtcTimestamp Value="@s.UpdatedAtUtc" /></DescriptionsItem>
        </Descriptions>

        <Card Size="@CardSize.Small" Title="Advanced technical IDs" Style="margin-bottom:12px;">
            <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1">
                <DescriptionsItem Title="Record ID">@s.Id</DescriptionsItem>
                <DescriptionsItem Title="Organization ID">@s.OrganizationId</DescriptionsItem>
                <DescriptionsItem Title="Product key">@s.ProductCode</DescriptionsItem>
                <DescriptionsItem Title="Plan ID">@s.PlanId</DescriptionsItem>
                <DescriptionsItem Title="Plan key">@(s.PlanKey ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="Plan version ID">@s.PlanVersionId</DescriptionsItem>
                <DescriptionsItem Title="Trial definition ID">@(s.TrialDefinitionId?.ToString() ?? "—")</DescriptionsItem>
            </Descriptions>
        </Card>

        @if (CanManage && s.Status is not ("Cancelled" or "Expired"))
        {
            <Card Size="@CardSize.Small" Title="@L["Subscriptions_LifecycleActions"]">
                <Space>
                    <Input @bind-Value="_periodStartText" Size="@InputSize.Small" Placeholder="Period start UTC" Style="width:220px;" Disabled="_busy" />
                    <Input @bind-Value="_periodEndText" Size="@InputSize.Small" Placeholder="Period end UTC" Style="width:220px;" Disabled="_busy" />
                    <Input @bind-Value="_graceEndText" Size="@InputSize.Small" Placeholder="Grace end UTC" Style="width:220px;" Disabled="_busy" />
                </Space>
            </Card>
        }

        <Tabs Style="margin-top:12px;">
            <TabPane Key="related" Tab="@L["Common_Related"]">
                @if (_payments is { IsSuccess: true })
                {
                    <Table TItem="PaymentDto" DataSource="@_payments.Data!.Items" Size="@TableSize.Small" Bordered HidePagination="true" ScrollX="720">
                        <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Width="120">
                            <AdminStatusTag Value="@context.Status" />
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.Amount" Title="Amount" Width="120">
                            <AdminMoneyDisplay Amount="@context.Amount" CurrencyCode="@context.CurrencyCode" />
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.CurrencyCode" Title="Currency" Width="90" />
                        <PropertyColumn Property="c => c.Method" Title="Method" Width="110" />
                        <ActionColumn Title="@L["Common_Open"]" Width="90">
                            <a href="/admin/payments/@context.Id">@L["Common_Open"]</a>
                        </ActionColumn>
                    </Table>
                }
                @if (_entitlement?.IsSuccess == true)
                {
                    <p style="margin-top:12px;">
                        Latest entitlement:
                        <a href="/admin/entitlements/@_entitlement.Data!.Id">@_entitlement.Data.PlanCode v@_entitlement.Data.PlanVersionNumber</a>
                    </p>
                }
            </TabPane>
        </Tabs>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private ApiCallResult<PagedResult<SubscriptionDto>>? _list;
    private ApiCallResult<SubscriptionDto>? _detail;
    private ApiCallResult<PagedResult<PaymentDto>>? _payments;
    private ApiCallResult<EntitlementSnapshotDto>? _entitlement;

    private int _page = 1;
    private string? _sortBy;
    private bool _sortDesc = true;
    private string _search = "";
    private string _status = "";
    private string _productCode = "";
    private string _planIdText = "";
    private string _isTrialFilter = "";
    private List<ProductDto> _productOptions = [];
    private List<PlanDto> _planOptions = [];
    private List<OrganizationDto> _organizationOptions = [];
    private bool _showCreate;
    private bool _busy;
    private string? _formError;
    private bool _formConflict;

    private string _createOrgId = "";
    private string _createProductCode = "";
    private string _createPlanId = "";
    private string _createPlanVersionId = "";
    private string _createTrialDefinitionId = "";
    private string _periodStartText = "";
    private string _periodEndText = "";
    private string _graceEndText = "";

    private bool CanManage => Permissions.HasPermission(PlatformPermissionCodes.ManageSubscriptions);
    private int? ExpectedVersion => _detail?.Data?.Version;

    private IEnumerable<PlanDto> CreatePlanChoices =>
        _planOptions
            .Where(p => string.IsNullOrWhiteSpace(_createProductCode)
                        || string.Equals(p.ProductCode, _createProductCode, StringComparison.OrdinalIgnoreCase))
            .Where(p => p.Status == "Active")
            .OrderBy(p => p.SortOrder)
            .ThenBy(p => p.DisplayName, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        _formError = null;
        _formConflict = false;
        if (Id is null)
        {
            await LoadListAsync();
        }
        else
        {
            await LoadDetailAsync();
        }
    }

    private void ToggleCreate() => _showCreate = !_showCreate;
    private void HideCreate() => _showCreate = false;

    private bool? ParseIsTrial() => _isTrialFilter switch
    {
        "true" => true,
        "false" => false,
        _ => null
    };

    private Guid? ParsePlanFilter() =>
        Guid.TryParse(_planIdText.Trim(), out var id) ? id : null;

    private async Task LoadListAsync()
    {
        if (_productOptions.Count == 0 || _planOptions.Count == 0)
        {
            await LoadFilterCatalogAsync();
        }

        _list = await Api.GetSubscriptionsAsync(
            status: string.IsNullOrWhiteSpace(_status) ? null : _status,
            productCode: string.IsNullOrWhiteSpace(_productCode) ? null : _productCode.Trim(),
            organizationId: null,
            search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            isTrial: ParseIsTrial(),
            planId: string.IsNullOrWhiteSpace(_planIdText) ? null : ParsePlanFilter(),
            sortBy: _sortBy ?? "UpdatedAtUtc",
            sortDesc: _sortBy is null ? true : _sortDesc,
            page: _page);
    }

    private async Task OnSubscriptionsTableChangeAsync(QueryModel<SubscriptionDto> queryModel)
    {
        await AdminTableSort.ApplyChangeAsync(
            queryModel,
            MapSortField,
            () => _sortBy,
            v => _sortBy = v,
            () => _sortDesc,
            v => _sortDesc = v,
            () => _page,
            v => _page = v,
            LoadListAsync);
    }

    private static string? MapSortField(string? fieldName) => fieldName switch
    {
        "OrganizationDisplayName" => "OrganizationName",
        "ProductDisplayName" => "ProductDisplayName",
        "PlanDisplayName" => "PlanDisplayName",
        "Status" => "Status",
        "TrialEndUtc" => "TrialEndUtc",
        "PaidPeriodEndUtc" => "PaidPeriodEndUtc",
        "RenewalDateUtc" => "PaidPeriodEndUtc",
        "UpdatedAtUtc" => "UpdatedAtUtc",
        _ => null
    };

    private async Task LoadFilterCatalogAsync()
    {
        var products = await Api.GetProductsAsync(page: 1, pageSize: 100);
        if (products is { IsSuccess: true, Data: not null })
        {
            _productOptions = products.Data.Items.ToList();
        }

        var plans = await Api.GetPlansAsync(page: 1, pageSize: 100);
        if (plans is { IsSuccess: true, Data: not null })
        {
            _planOptions = plans.Data.Items
                .OrderBy(p => p.SortOrder)
                .ThenBy(p => p.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        var orgs = await Api.GetOrganizationsAsync(page: 1, pageSize: 100, status: "Active");
        if (orgs is { IsSuccess: true, Data: not null })
        {
            _organizationOptions = orgs.Data.Items
                .OrderBy(o => o.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private async Task OnCreateProductChangedAsync(string value)
    {
        _createProductCode = value ?? "";
        _createPlanId = "";
        _createPlanVersionId = "";
        _createTrialDefinitionId = "";
        await Task.CompletedTask;
    }

    private async Task OnCreatePlanChangedAsync(string value)
    {
        _createPlanId = value ?? "";
        _createPlanVersionId = "";
        _createTrialDefinitionId = "";
        if (string.IsNullOrWhiteSpace(_createPlanId) || string.IsNullOrWhiteSpace(_createProductCode))
        {
            return;
        }

        await ResolveCatalogIdsAsync();
    }

    private async Task ResolveCatalogIdsAsync()
    {
        if (string.IsNullOrWhiteSpace(_createProductCode) || !Guid.TryParse(_createPlanId, out var planId))
        {
            return;
        }

        var overview = await Api.GetProductOverviewAsync(_createProductCode.Trim());
        if (!overview.IsSuccess || overview.Data is null)
        {
            return;
        }

        var versions = await Api.GetPlanVersionsAsync(_createProductCode.Trim(), planId);
        var published = versions.IsSuccess
            ? versions.Data?
                .Where(v => v.Status == "Published")
                .OrderByDescending(v => v.VersionNumber)
                .FirstOrDefault()
            : null;
        if (published is not null)
        {
            _createPlanVersionId = published.Id.ToString("D");
        }

        var trial = overview.Data.Trials.FirstOrDefault(t =>
            t.Status == "Active" && (t.PlanId is null || t.PlanId == planId));
        trial ??= overview.Data.Trials.FirstOrDefault(t => t.Status == "Active");
        _createTrialDefinitionId = trial?.Id.ToString("D") ?? "";
    }

    private async Task CreateSubscriptionAsync() => await StartTrialAsync();

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadListAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _search = "";
        _status = "";
        _productCode = "";
        _planIdText = "";
        _isTrialFilter = "";
        _sortBy = null;
        _sortDesc = true;
        _page = 1;
        await LoadListAsync();
    }

    private async Task LoadDetailAsync()
    {
        if (Id is null) return;
        _detail = await Api.GetSubscriptionAsync(Id.Value);
        if (_detail.IsSuccess && _detail.Data is not null)
        {
            var s = _detail.Data;
            var now = DateTimeOffset.UtcNow;
            _periodStartText = (s.PaidPeriodStartUtc ?? now).ToString("yyyy-MM-ddTHH:mm:ssZ");
            _periodEndText = (s.PaidPeriodEndUtc ?? now.AddDays(30)).ToString("yyyy-MM-ddTHH:mm:ssZ");
            _graceEndText = (s.GracePeriodEndUtc ?? now.AddDays(7)).ToString("yyyy-MM-ddTHH:mm:ssZ");
            _payments = await Api.GetPaymentsAsync(organizationId: s.OrganizationId, pageSize: 10);
            _entitlement = await Api.GetLatestEntitlementAsync(s.OrganizationId, s.ProductCode);
        }
    }

    private async Task LoadCatalogAsync()
    {
        await ResolveCatalogIdsAsync();
        if (string.IsNullOrWhiteSpace(_createPlanVersionId))
        {
            await Message.ErrorAsync("Could not resolve a published plan version for the selected plan.");
            return;
        }

        await Message.SuccessAsync("Catalog resolved for selected plan.");
    }

    private async Task StartTrialAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        _formError = null;
        _formConflict = false;
        if (string.IsNullOrWhiteSpace(_createPlanVersionId) || string.IsNullOrWhiteSpace(_createTrialDefinitionId))
        {
            await ResolveCatalogIdsAsync();
        }

        if (!Guid.TryParse(_createOrgId, out var orgId)
            || !Guid.TryParse(_createPlanId, out var planId)
            || !Guid.TryParse(_createPlanVersionId, out var versionId)
            || !Guid.TryParse(_createTrialDefinitionId, out var trialId))
        {
            _busy = false;
            _formError = "Select an organization, product, and plan that supports trials (published version + trial definition required).";
            return;
        }

        var result = await Api.StartTrialAsync(orgId, new StartTrialRequest(planId, versionId, trialId));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            await Message.ErrorAsync(_formError ?? L["Common_Error"].Value);
            return;
        }

        await Message.SuccessAsync("Trial started.");
        Nav.NavigateTo($"/admin/subscriptions/{result.Data!.Id}");
    }

    private bool TryParsePeriod(out DateTimeOffset start, out DateTimeOffset end)
    {
        start = default;
        end = default;
        return DateTimeOffset.TryParse(_periodStartText, out start) && DateTimeOffset.TryParse(_periodEndText, out end);
    }

    private async Task ActivateAsync()
    {
        _formError =
            "Paid activation requires a successful linked payment. Open Payments, confirm a payment, then use Confirm & Activate — or complete commercial PayNow / convert-trial.";
        await Message.ErrorAsync(_formError);
    }

    private async Task EnterGraceAsync()
    {
        if (Id is null || ExpectedVersion is not int version || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        if (!DateTimeOffset.TryParse(_graceEndText, out var graceEnd))
        {
            _busy = false;
            _formError = "Grace period end must be a valid UTC timestamp.";
            return;
        }

        var result = await Api.EnterGracePeriodAsync(Id.Value, new GracePeriodRequest(graceEnd.ToUniversalTime(), version));
        await FinishLifecycleAsync(result, "Entered grace period.");
    }

    private async Task MarkPastDueAsync()
    {
        if (Id is null || ExpectedVersion is not int version || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        var result = await Api.MarkPastDueAsync(Id.Value, version);
        await FinishLifecycleAsync(result, "Marked past due.");
    }

    private async Task SuspendAsync()
    {
        if (Id is null || ExpectedVersion is not int version || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        var result = await Api.SuspendSubscriptionAsync(Id.Value, version);
        await FinishLifecycleAsync(result, "Subscription suspended.");
    }

    private async Task ReactivateAsync()
    {
        if (Id is null || ExpectedVersion is not int version || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        if (!TryParsePeriod(out var start, out var end))
        {
            _busy = false;
            _formError = "Reactivation requires a valid paid period.";
            return;
        }

        var result = await Api.ReactivateSubscriptionAsync(
            Id.Value,
            new ReactivateSubscriptionRequest(start.ToUniversalTime(), end.ToUniversalTime(), version));
        await FinishLifecycleAsync(result, "Subscription reactivated.");
    }

    private async Task CancelAsync()
    {
        if (Id is null || ExpectedVersion is not int version || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        var result = await Api.CancelSubscriptionAsync(Id.Value, version);
        await FinishLifecycleAsync(result, "Subscription cancelled.");
    }

    private async Task ExpireAsync()
    {
        if (Id is null || ExpectedVersion is not int version || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        var result = await Api.ExpireSubscriptionAsync(Id.Value, version);
        await FinishLifecycleAsync(result, "Subscription expired.");
    }

    private async Task FinishLifecycleAsync(ApiCallResult<SubscriptionDto> result, string success)
    {
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            await Message.ErrorAsync(_formError ?? L["Common_Error"].Value);
            return;
        }

        await Message.SuccessAsync(success);
        await LoadDetailAsync();
    }
}

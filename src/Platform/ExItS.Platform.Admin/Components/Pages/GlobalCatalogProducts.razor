@page "/admin/global-catalog/products"
@page "/admin/global-catalog/products/{Id:guid}"
@using AntDesign
@using AntDesign.TableModels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@implements IDisposable
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject PlatformPermissionState Permissions
@using ExItS.Platform.Admin.Services

@if (!Permissions.Loaded)
{
    <Spin />
}
else if (!CanView)
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ViewGlobalCatalog" />
}
else if (Id is null)
{
    <PageHeader Class="exits-page-header" Title="@L["GlobalProducts_Title"]" SubTitle="@L["GlobalProducts_Description"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_ProductCatalog"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_GlobalProducts"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            @if (CanManage)
            {
                <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ToggleCreate">
                    @(_showCreate ? L["GlobalProducts_HideCreate"] : L["GlobalProducts_Create"])
                </Button>
            }
        </PageHeaderExtra>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_errorAlert))
    {
        <Alert Type="@AlertType.Error" Message="@_errorAlert" ShowIcon="true" Closable="true" OnClose="ClearErrorAlert" Style="margin-bottom:12px;" />
    }

    <Space Style="margin-bottom:12px; width:100%;" Wrap>
        <Input @bind-Value="_search" Size="@InputSize.Small" Placeholder="@L["GlobalProducts_SearchPlaceholder"]" Style="width:220px;" OnPressEnter="ApplyFiltersAsync" />
        <Input @bind-Value="_barcode" Size="@InputSize.Small" Placeholder="@L["GlobalProducts_BarcodeFilter"]" Style="width:160px;" OnPressEnter="ApplyFiltersAsync" />
        <Select TItemValue="string" TItem="string" @bind-Value="_status" Size="@InputSize.Small" Placeholder="@L["Common_Status"]" Style="width:140px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Draft")" Label="@L["Status_Draft"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Active")" Label="@L["Status_Active"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Archived")" Label="@L["Status_Archived"]" />
            </SelectOptions>
        </Select>
        <Select TItemValue="string" TItem="string" @bind-Value="_categoryId" Size="@InputSize.Small" Placeholder="@L["GlobalProducts_Category"]" Style="width:200px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                @foreach (var c in _categoryOptions)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@c.Id.ToString("D")" Label="@c.Name" />
                }
            </SelectOptions>
        </Select>
        <Select TItemValue="string" TItem="string" @bind-Value="_businessTypeCode" Size="@InputSize.Small" Placeholder="@L["GlobalCatalog_BusinessType"]" Style="width:180px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                @foreach (var bt in _activeBusinessTypes)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@bt.Code" Label="@($"{bt.Name} ({bt.Code})")" />
                }
            </SelectOptions>
        </Select>
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ApplyFiltersAsync">@L["Common_Apply"]</Button>
        <Button Size="@ButtonSize.Small" OnClick="ClearFiltersAsync">@L["Common_Reset"]</Button>
    </Space>

    @if (_showCreate && CanManage)
    {
        <Card Size="@CardSize.Small" Title="@L["GlobalProducts_CreateSection"]" Style="margin-bottom:12px;">
            <FormValidationSummary Title="@L["GlobalProducts_CreateFailed"]" Message="@_formError" IsConflict="_formConflict" />
            <Space Direction="SpaceDirection.Vertical" Style="width:100%; max-width:640px;">
                <div>
                    <label class="ant-form-item-label" for="gc-prod-name">@L["Common_Name"] *</label>
                    <Input Id="gc-prod-name" @bind-Value="_newName" Size="@InputSize.Small" Disabled="_busy" />
                    @if (!string.IsNullOrEmpty(_newNameError))
                    {
                        <div class="ant-form-item-explain ant-form-item-explain-error">@_newNameError</div>
                    }
                </div>
                <div>
                    <label class="ant-form-item-label" for="gc-prod-desc">@L["GlobalProducts_FieldDescription"]</label>
                    <TextArea Id="gc-prod-desc" @bind-Value="_newDescription" Rows="2" Disabled="_busy" />
                </div>
                <Space Wrap>
                    <div>
                        <label class="ant-form-item-label" for="gc-prod-sku">@L["GlobalProducts_Sku"] *</label>
                        <Input Id="gc-prod-sku" @bind-Value="_newSku" Size="@InputSize.Small" Disabled="_busy" Style="width:160px;" />
                        @if (!string.IsNullOrEmpty(_newSkuError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_newSkuError</div>
                        }
                    </div>
                    <div>
                        <label class="ant-form-item-label" for="gc-prod-barcode">@L["GlobalProducts_Barcode"]</label>
                        <Input Id="gc-prod-barcode" @bind-Value="_newBarcode" Size="@InputSize.Small" Disabled="_busy" Style="width:180px;" Placeholder="@L["GlobalProducts_BarcodeHint"]" />
                        @if (!string.IsNullOrEmpty(_newBarcodeError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_newBarcodeError</div>
                        }
                    </div>
                    <div>
                        <label class="ant-form-item-label" for="gc-prod-brand">@L["GlobalProducts_Brand"] *</label>
                        <Input Id="gc-prod-brand" @bind-Value="_newBrand" Size="@InputSize.Small" Disabled="_busy" Style="width:180px;" />
                        @if (!string.IsNullOrEmpty(_newBrandError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_newBrandError</div>
                        }
                    </div>
                </Space>
                <div>
                    <label class="ant-form-item-label">@L["GlobalProducts_Category"] *</label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_newCategoryId" Size="@InputSize.Small" Style="width:100%;" Disabled="_busy">
                        <SelectOptions>
                            @foreach (var c in _categoryOptions)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@c.Id.ToString("D")" Label="@c.Name" />
                            }
                        </SelectOptions>
                    </Select>
                    @if (!string.IsNullOrEmpty(_newCategoryError))
                    {
                        <div class="ant-form-item-explain ant-form-item-explain-error">@_newCategoryError</div>
                    }
                </div>
                <div>
                    <label class="ant-form-item-label">@L["GlobalProducts_Unit"] *</label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_newUnit" Size="@InputSize.Small" Style="width:200px;" Disabled="_busy">
                        <SelectOptions>
                            @foreach (var u in UnitOptions)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@u" Label="@u" />
                            }
                        </SelectOptions>
                    </Select>
                    @if (!string.IsNullOrEmpty(_newUnitError))
                    {
                        <div class="ant-form-item-explain ant-form-item-explain-error">@_newUnitError</div>
                    }
                </div>
                <div>
                    <label class="ant-form-item-label">@L["GlobalProducts_SellingMode"] *</label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_newSellingMode" Size="@InputSize.Small" Style="width:200px;" Disabled="_busy">
                        <SelectOptions>
                            @foreach (var mode in SellingModeOptions)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@mode" Label="@mode" />
                            }
                        </SelectOptions>
                    </Select>
                </div>
                <Space Wrap>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalProducts_CostPrice"] *</label>
                        <AntDesign.InputNumber TValue="decimal?" @bind-Value="_newCost" Min="0" Disabled="_busy" Style="width:140px;" />
                        @if (!string.IsNullOrEmpty(_newCostError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_newCostError</div>
                        }
                    </div>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalProducts_SellingPrice"] *</label>
                        <AntDesign.InputNumber TValue="decimal?" @bind-Value="_newPrice" Min="0" Disabled="_busy" Style="width:140px;" />
                        @if (!string.IsNullOrEmpty(_newPriceError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_newPriceError</div>
                        }
                    </div>
                </Space>
                <div>
                    <label class="ant-form-item-label" for="gc-prod-image">@L["GlobalProducts_ImageReference"]</label>
                    <Input Id="gc-prod-image" @bind-Value="_newImage" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <div>
                    <label class="ant-form-item-label" for="gc-prod-tags">@L["GlobalProducts_SearchTags"]</label>
                    <Input Id="gc-prod-tags" @bind-Value="_newTags" Size="@InputSize.Small" Disabled="_busy" Placeholder="@L["GlobalProducts_TagsHint"]" />
                </div>
                <div>
                    <label class="ant-form-item-label">@L["GlobalCatalog_BusinessTypes"]</label>
                    <CheckboxGroup @bind-Value="_newBusinessTypeIds" Options="@_businessTypeCheckboxOptions" Disabled="_busy" />
                </div>
                <Space>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="CreateAsync">@L["Common_Create"]</Button>
                    <Button Size="@ButtonSize.Small" OnClick="HideCreate" Disabled="_busy">@L["Common_Cancel"]</Button>
                </Space>
            </Space>
        </Card>
    }

    @if (_list is { IsSuccess: false })
    {
        <Result Status="@ResultStatus.Error" Title="@(_list.Error?.Title ?? L["Common_Error"])" SubTitle="@_list.Error?.Detail" />
    }
    else if (_list is { IsSuccess: true, Data.Items.Count: 0 })
    {
        <Empty Description="@L["GlobalProducts_Empty"].Value" />
    }
    else
    {
        <Table TItem="GlobalProductDto"
               Class="exits-table-fit"
               DataSource="@(_list?.Data?.Items ?? Array.Empty<GlobalProductDto>())"
               Total="@(_list?.Data?.TotalCount ?? 0)"
               @bind-PageIndex="_page"
               PageSize="@(_list?.Data?.PageSize ?? 20)"
               Loading="@(_list is null)"
               Size="@TableSize.Small"
               Bordered
               Resizable
               ScrollX="2000"
               RemoteDataSource
               OnChange="OnProductsTableChangeAsync">
            <PropertyColumn Property="c => c.Name" Title="@L["Common_Name"]" Sortable>
                <a href="/admin/global-catalog/products/@context.Id">@context.Name</a>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Sku" Title="@L["GlobalProducts_Sku"]" Sortable Width="120" />
            <PropertyColumn Property="c => c.Barcode" Title="@L["GlobalProducts_Barcode"]" Sortable Width="140" />
            <PropertyColumn Property="c => c.Brand" Title="@L["GlobalProducts_Brand"]" Sortable Width="140" />
            <PropertyColumn Property="c => c.GlobalCategoryId" Title="@L["GlobalProducts_Category"]" Sortable Width="160">
                @CategoryName(context.GlobalCategoryId)
            </PropertyColumn>
            <PropertyColumn Property="c => c.CostPrice" Title="@L["GlobalProducts_CostPrice"]" Sortable Width="120">
                @AdminCurrency.FormatPhp(context.CostPrice)
            </PropertyColumn>
            <PropertyColumn Property="c => c.SellingPrice" Title="@L["GlobalProducts_SellingPrice"]" Sortable Width="120">
                @AdminCurrency.FormatPhp(context.SellingPrice)
            </PropertyColumn>
            <PropertyColumn Property="c => c.Unit" Title="@L["GlobalProducts_Unit"]" Sortable Width="100" />
            <PropertyColumn Property="c => c.SellingMode" Title="@L["GlobalProducts_SellingMode"]" Sortable Width="120" />
            <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Sortable Width="110">
                <AdminStatusTag Value="@context.Status" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.BusinessTypes" Title="@L["GlobalCatalog_BusinessTypes"]" Width="200">
                @if (context.BusinessTypes.Count == 0)
                {
                    <span>—</span>
                }
                else
                {
                    @foreach (var typeCode in context.BusinessTypes)
                    {
                        <Tag Style="margin-bottom:2px;">@typeCode</Tag>
                    }
                }
            </PropertyColumn>
            <PropertyColumn Property="c => c.UpdatedAtUtc" Title="@L["Common_UpdatedUtc"]" Sortable Width="180">
                <LocalTimestamp Value="@context.UpdatedAtUtc" />
            </PropertyColumn>
            <ActionColumn Title="@L["Common_Open"]" Width="80">
                <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/global-catalog/products/{context.Id}")">@L["Common_Open"]</a>
            </ActionColumn>
        </Table>
    }
}
else
{
    <PageHeader Class="exits-page-header" Title="@(_product?.Data?.Name ?? L["GlobalProducts_DetailTitle"])" SubTitle="@L["GlobalProducts_DetailDescription"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem Href="/admin/global-catalog/products">@L["Nav_GlobalProducts"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Common_Detail"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            @if (_product?.IsSuccess == true && CanManage)
            {
                var p = _product.Data!;
                <Space>
                    @if (p.Status == "Draft" || p.Status == "Archived")
                    {
                        <Popconfirm Title="@L["GlobalProducts_ConfirmActivate"]" OnConfirm="ActivateProductAsync" OkText="@L["Common_Confirm"]" CancelText="@L["Common_Cancel"]">
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy">@L["GlobalProducts_Activate"]</Button>
                        </Popconfirm>
                    }
                    @if (p.Status is "Draft" or "Active")
                    {
                        <Popconfirm Title="@L["GlobalProducts_ConfirmArchive"]" OnConfirm="ArchiveProductAsync" OkText="@L["Common_Confirm"]" CancelText="@L["Common_Cancel"]">
                            <Button Size="@ButtonSize.Small" Danger Loading="_busy">@L["GlobalProducts_Archive"]</Button>
                        </Popconfirm>
                    }
                </Space>
            }
        </PageHeaderExtra>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_successAlert))
    {
        <Alert Type="@AlertType.Success" Message="@_successAlert" ShowIcon="true" Closable="true" OnClose="ClearSuccessAlert" Style="margin-bottom:12px;" />
    }
    @if (!string.IsNullOrEmpty(_errorAlert))
    {
        <Alert Type="@AlertType.Error" Message="@_errorAlert" ShowIcon="true" Closable="true" OnClose="ClearErrorAlert" Style="margin-bottom:12px;" />
    }

    @if (_product is null)
    {
        <div style="padding:2rem;text-align:center;"><Spin Tip="@L["GlobalProducts_DetailLoading"]" /></div>
    }
    else if (!_product.IsSuccess)
    {
        <Result Status="@ResultStatus.Error" Title="@(_product.Error?.Title ?? L["Common_Error"])" SubTitle="@_product.Error?.Detail" />
    }
    else
    {
        var p = _product.Data!;
        <Descriptions Bordered Size="@DescriptionsSize.Small" Column="2" Style="margin-bottom:12px;">
            <DescriptionsItem Title="@L["Common_Status"]"><AdminStatusTag Value="@p.Status" /></DescriptionsItem>
            <DescriptionsItem Title="@L["GlobalProducts_Category"]">@CategoryName(p.GlobalCategoryId)</DescriptionsItem>
            <DescriptionsItem Title="@L["GlobalProducts_Brand"]">@p.Brand</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_CreatedUtc"]"><UtcTimestamp Value="@p.CreatedAtUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Common_UpdatedUtc"]"><UtcTimestamp Value="@p.UpdatedAtUtc" /></DescriptionsItem>
        </Descriptions>

        @if (CanManage && p.Status != "Archived")
        {
            <Card Size="@CardSize.Small" Title="@L["GlobalProducts_EditSection"]">
                <FormValidationSummary Title="@L["GlobalProducts_SaveFailed"]" Message="@_formError" IsConflict="_formConflict" />
                <Space Direction="SpaceDirection.Vertical" Style="width:100%; max-width:640px;">
                    <div>
                        <label class="ant-form-item-label" for="gc-prod-edit-name">@L["Common_Name"] *</label>
                        <Input Id="gc-prod-edit-name" @bind-Value="_editName" Size="@InputSize.Small" Disabled="_busy" />
                        @if (!string.IsNullOrEmpty(_editNameError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_editNameError</div>
                        }
                    </div>
                    <div>
                        <label class="ant-form-item-label" for="gc-prod-edit-desc">@L["GlobalProducts_FieldDescription"]</label>
                        <TextArea Id="gc-prod-edit-desc" @bind-Value="_editDescription" Rows="2" Disabled="_busy" />
                    </div>
                    <Space Wrap>
                        <div>
                            <label class="ant-form-item-label" for="gc-prod-edit-sku">@L["GlobalProducts_Sku"] *</label>
                            <Input Id="gc-prod-edit-sku" @bind-Value="_editSku" Size="@InputSize.Small" Disabled="_busy" Style="width:160px;" />
                            @if (!string.IsNullOrEmpty(_editSkuError))
                            {
                                <div class="ant-form-item-explain ant-form-item-explain-error">@_editSkuError</div>
                            }
                        </div>
                        <div>
                            <label class="ant-form-item-label" for="gc-prod-edit-barcode">@L["GlobalProducts_Barcode"]</label>
                            <Input Id="gc-prod-edit-barcode" @bind-Value="_editBarcode" Size="@InputSize.Small" Disabled="_busy" Style="width:180px;" Placeholder="@L["GlobalProducts_BarcodeHint"]" />
                            @if (!string.IsNullOrEmpty(_editBarcodeError))
                            {
                                <div class="ant-form-item-explain ant-form-item-explain-error">@_editBarcodeError</div>
                            }
                        </div>
                        <div>
                            <label class="ant-form-item-label" for="gc-prod-edit-brand">@L["GlobalProducts_Brand"] *</label>
                            <Input Id="gc-prod-edit-brand" @bind-Value="_editBrand" Size="@InputSize.Small" Disabled="_busy" Style="width:180px;" />
                            @if (!string.IsNullOrEmpty(_editBrandError))
                            {
                                <div class="ant-form-item-explain ant-form-item-explain-error">@_editBrandError</div>
                            }
                        </div>
                    </Space>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalProducts_Category"] *</label>
                        <Select TItemValue="string" TItem="string" @bind-Value="_editCategoryId" Size="@InputSize.Small" Style="width:100%;" Disabled="_busy">
                            <SelectOptions>
                                @foreach (var c in _categoryOptions)
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@c.Id.ToString("D")" Label="@c.Name" />
                                }
                            </SelectOptions>
                        </Select>
                        @if (!string.IsNullOrEmpty(_editCategoryError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_editCategoryError</div>
                        }
                    </div>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalProducts_Unit"] *</label>
                        <Select TItemValue="string" TItem="string" @bind-Value="_editUnit" Size="@InputSize.Small" Style="width:200px;" Disabled="_busy">
                            <SelectOptions>
                                @foreach (var u in UnitOptions)
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@u" Label="@u" />
                                }
                            </SelectOptions>
                        </Select>
                        @if (!string.IsNullOrEmpty(_editUnitError))
                        {
                            <div class="ant-form-item-explain ant-form-item-explain-error">@_editUnitError</div>
                        }
                    </div>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalProducts_SellingMode"] *</label>
                        <Select TItemValue="string" TItem="string" @bind-Value="_editSellingMode" Size="@InputSize.Small" Style="width:200px;" Disabled="_busy">
                            <SelectOptions>
                                @foreach (var mode in SellingModeOptions)
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@mode" Label="@mode" />
                                }
                            </SelectOptions>
                        </Select>
                    </div>
                    <Space Wrap>
                        <div>
                            <label class="ant-form-item-label">@L["GlobalProducts_CostPrice"] *</label>
                            <AntDesign.InputNumber TValue="decimal?" @bind-Value="_editCost" Min="0" Disabled="_busy" Style="width:140px;" />
                            @if (!string.IsNullOrEmpty(_editCostError))
                            {
                                <div class="ant-form-item-explain ant-form-item-explain-error">@_editCostError</div>
                            }
                        </div>
                        <div>
                            <label class="ant-form-item-label">@L["GlobalProducts_SellingPrice"] *</label>
                            <AntDesign.InputNumber TValue="decimal?" @bind-Value="_editPrice" Min="0" Disabled="_busy" Style="width:140px;" />
                            @if (!string.IsNullOrEmpty(_editPriceError))
                            {
                                <div class="ant-form-item-explain ant-form-item-explain-error">@_editPriceError</div>
                            }
                        </div>
                    </Space>
                    <div>
                        <label class="ant-form-item-label" for="gc-prod-edit-image">@L["GlobalProducts_ImageReference"]</label>
                        <Input Id="gc-prod-edit-image" @bind-Value="_editImage" Size="@InputSize.Small" Disabled="_busy" />
                    </div>
                    <div>
                        <label class="ant-form-item-label" for="gc-prod-edit-tags">@L["GlobalProducts_SearchTags"]</label>
                        <Input Id="gc-prod-edit-tags" @bind-Value="_editTags" Size="@InputSize.Small" Disabled="_busy" Placeholder="@L["GlobalProducts_TagsHint"]" />
                    </div>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalCatalog_BusinessTypes"]</label>
                        <CheckboxGroup @bind-Value="_editBusinessTypeIds" Options="@_businessTypeCheckboxOptions" Disabled="_busy" />
                    </div>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="SaveAsync">@L["Common_Save"]</Button>
                </Space>
            </Card>
        }
        else
        {
            <Descriptions Size="@DescriptionsSize.Small" Column="2">
                <DescriptionsItem Title="@L["Common_Name"]">@p.Name</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_Unit"]">@p.Unit</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_SellingMode"]">@p.SellingMode</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_Sku"]">@p.Sku</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_Barcode"]">@p.Barcode</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_Brand"]">@p.Brand</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_CostPrice"]">@AdminCurrency.FormatPhp(p.CostPrice)</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_SellingPrice"]">@AdminCurrency.FormatPhp(p.SellingPrice)</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_FieldDescription"]">@(p.Description ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_ImageReference"]">@(p.ImageReference ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalProducts_SearchTags"]">@(p.SearchTags.Count == 0 ? "—" : string.Join(", ", p.SearchTags))</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalCatalog_BusinessTypes"]">
                    @(p.BusinessTypes.Count == 0 ? "—" : string.Join(", ", p.BusinessTypes))
                </DescriptionsItem>
            </Descriptions>
        }
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery] public string? Alert { get; set; }

    private static readonly string[] UnitOptions =
    [
        "Piece", "Pack", "Box", "Bottle", "Can", "Sachet", "Kilogram", "Gram", "Liter", "Milliliter"
    ];

    private static readonly string[] SellingModeOptions = ["PerItem", "ByWeight"];

    private CheckboxOption<string>[] _businessTypeCheckboxOptions = [];
    private List<BusinessTypeDto> _activeBusinessTypes = [];

    private ApiCallResult<PagedResult<GlobalProductDto>>? _list;
    private ApiCallResult<GlobalProductDto>? _product;
    private List<GlobalCategoryDto> _categoryOptions = [];
    private int _page = 1;
    private string? _sortBy;
    private bool _sortDesc;
    private string _search = "";
    private string _barcode = "";
    private string _status = "";
    private string _categoryId = "";
    private string _businessTypeCode = "";
    private bool _showCreate;
    private string _newName = "";
    private string _newDescription = "";
    private string _newSku = "";
    private string _newBarcode = "";
    private string _newBrand = "";
    private string _newCategoryId = "";
    private string _newUnit = "Piece";
    private string _newSellingMode = "PerItem";
    private decimal? _newPrice;
    private decimal? _newCost;
    private string _newImage = "";
    private string _newTags = "";
    private string[] _newBusinessTypeIds = [];
    private string _editName = "";
    private string _editDescription = "";
    private string _editSku = "";
    private string _editBarcode = "";
    private string _editBrand = "";
    private string _editCategoryId = "";
    private string _editUnit = "Piece";
    private string _editSellingMode = "PerItem";
    private decimal? _editPrice;
    private decimal? _editCost;
    private string _editImage = "";
    private string _editTags = "";
    private string[] _editBusinessTypeIds = [];
    private DateTimeOffset? _expectedUpdatedAt;
    private string? _formError;
    private bool _formConflict;
    private bool _busy;
    private string? _successAlert;
    private string? _errorAlert;
    private CancellationTokenSource? _successAlertCts;
    private bool _disposed;
    private string? _newNameError;
    private string? _newSkuError;
    private string? _newBarcodeError;
    private string? _newBrandError;
    private string? _newCategoryError;
    private string? _newUnitError;
    private string? _newPriceError;
    private string? _newCostError;
    private string? _editNameError;
    private string? _editSkuError;
    private string? _editBarcodeError;
    private string? _editBrandError;
    private string? _editCategoryError;
    private string? _editUnitError;
    private string? _editPriceError;
    private string? _editCostError;
    private readonly AdminPageLoadGate _loadGate = new();

    private bool CanView => Permissions.HasPermission(PlatformPermissionCodes.ViewGlobalCatalog);
    private bool CanManage => Permissions.HasPermission(PlatformPermissionCodes.ManageGlobalProducts);

    protected override async Task OnParametersSetAsync()
    {
        _formError = null;
        _formConflict = false;
        if (!CanView)
        {
            return;
        }

        await EnsureCategoriesAsync();
        await EnsureBusinessTypesAsync();

        if (Id is null)
        {
            if (!_loadGate.ShouldLoad("list"))
            {
                return;
            }

            await LoadListAsync();
        }
        else if (_loadGate.ShouldLoad(Id))
        {
            await LoadDetailAsync();
            if (string.Equals(Alert, "created", StringComparison.OrdinalIgnoreCase))
            {
                ShowSuccessAlert(L["GlobalProducts_Created"].Value);
            }
        }
    }

    private async Task EnsureCategoriesAsync()
    {
        if (_categoryOptions.Count > 0)
        {
            return;
        }

        var result = await Api.GetGlobalCategoriesAsync(page: 1, pageSize: 200, status: "Active");
        if (result is { IsSuccess: true, Data: not null })
        {
            _categoryOptions = result.Data.Items.OrderBy(c => c.SortOrder).ThenBy(c => c.Name).ToList();
        }
    }

    private async Task EnsureBusinessTypesAsync()
    {
        if (_activeBusinessTypes.Count > 0)
        {
            return;
        }

        var types = await Api.GetBusinessTypesAsync(page: 1, pageSize: 200, status: "Active", sortBy: "SortOrder");
        if (types is { IsSuccess: true, Data: not null })
        {
            _activeBusinessTypes = types.Data.Items.ToList();
            _businessTypeCheckboxOptions = _activeBusinessTypes
                .Select(bt => new CheckboxOption<string>
                {
                    Label = $"{bt.Name} ({bt.Code})",
                    Value = bt.Id.ToString("D")
                })
                .ToArray();
        }
    }

    private async Task LoadListAsync()
    {
        Guid? categoryId = Guid.TryParse(_categoryId, out var cid) ? cid : null;
        _list = await Api.GetGlobalProductsAsync(
            page: _page,
            pageSize: 20,
            status: string.IsNullOrWhiteSpace(_status) ? null : _status,
            categoryId: categoryId,
            businessTypeCode: string.IsNullOrWhiteSpace(_businessTypeCode) ? null : _businessTypeCode,
            search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            barcode: string.IsNullOrWhiteSpace(_barcode) ? null : _barcode.Trim(),
            sortBy: _sortBy,
            sortDesc: _sortBy is null ? null : _sortDesc);
    }

    private async Task OnProductsTableChangeAsync(QueryModel<GlobalProductDto> queryModel)
    {
        await AdminTableSort.ApplyChangeAsync(
            queryModel,
            MapSortField,
            () => _sortBy,
            v => _sortBy = v,
            () => _sortDesc,
            v => _sortDesc = v,
            () => _page,
            v => _page = v,
            LoadListAsync);
    }

    private static string? MapSortField(string? fieldName) => fieldName switch
    {
        "Name" => "Name",
        "Sku" => "Sku",
        "Barcode" => "Barcode",
        "Brand" => "Brand",
        "GlobalCategoryId" => "Category",
        "Unit" => "Unit",
        "Status" => "Status",
        "UpdatedAtUtc" => "UpdatedAtUtc",
        "CostPrice" => "CostPrice",
        "SellingPrice" => "SellingPrice",
        _ => null
    };

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadListAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _search = "";
        _barcode = "";
        _status = "";
        _categoryId = "";
        _businessTypeCode = "";
        _sortBy = null;
        _sortDesc = false;
        _page = 1;
        await LoadListAsync();
    }

    private async Task LoadDetailAsync()
    {
        if (Id is null) return;
        _product = await Api.GetGlobalProductAsync(Id.Value);
        if (_product is { IsSuccess: true, Data: not null })
        {
            BindEdit(_product.Data);
        }
    }

    private void BindEdit(GlobalProductDto p)
    {
        _editName = p.Name;
        _editDescription = p.Description ?? "";
        _editSku = p.Sku;
        _editBarcode = p.Barcode ?? "";
        _editBrand = p.Brand;
        _editCategoryId = p.GlobalCategoryId?.ToString("D") ?? "";
        _editUnit = p.Unit;
        _editSellingMode = string.IsNullOrWhiteSpace(p.SellingMode) ? "PerItem" : p.SellingMode;
        _editPrice = p.SellingPrice;
        _editCost = p.CostPrice;
        _editImage = p.ImageReference ?? "";
        _editTags = string.Join(", ", p.SearchTags);
        _editBusinessTypeIds = p.BusinessTypeIds.Select(id => id.ToString("D")).ToArray();
        _expectedUpdatedAt = p.UpdatedAtUtc;
    }

    private string CategoryName(Guid? categoryId)
    {
        if (categoryId is null) return L["GlobalProducts_Uncategorized"];
        return _categoryOptions.FirstOrDefault(c => c.Id == categoryId)?.Name
            ?? categoryId.Value.ToString("D")[..8];
    }

    private static IReadOnlyList<string>? ParseTags(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        return raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(t => t.Length > 0)
            .ToList();
    }

    private static IReadOnlyList<Guid>? ParseBusinessTypeIds(string[] values) =>
        values.Length == 0
            ? null
            : values.Where(v => Guid.TryParse(v, out _)).Select(Guid.Parse).ToList();

    private void ToggleCreate() => _showCreate = !_showCreate;

    private void HideCreate()
    {
        _showCreate = false;
        _formError = null;
        _formConflict = false;
        ClearCreateFieldErrors();
    }

    private void ClearCreateFieldErrors()
    {
        _newNameError = null;
        _newSkuError = null;
        _newBarcodeError = null;
        _newBrandError = null;
        _newCategoryError = null;
        _newUnitError = null;
        _newPriceError = null;
        _newCostError = null;
    }

    private void ClearEditFieldErrors()
    {
        _editNameError = null;
        _editSkuError = null;
        _editBarcodeError = null;
        _editBrandError = null;
        _editCategoryError = null;
        _editUnitError = null;
        _editPriceError = null;
        _editCostError = null;
    }

    private bool ValidateCreateForm()
    {
        ClearCreateFieldErrors();
        var ok = true;
        if (string.IsNullOrWhiteSpace(_newName))
        {
            _newNameError = L["GlobalProducts_RequiredName"];
            ok = false;
        }

        if (string.IsNullOrWhiteSpace(_newSku))
        {
            _newSkuError = L["GlobalProducts_RequiredSku"];
            ok = false;
        }

        if (!string.IsNullOrWhiteSpace(_newBarcode) && !LooksLikeOptionalGs1Barcode(_newBarcode))
        {
            _newBarcodeError = L["GlobalProducts_InvalidBarcode"];
            ok = false;
        }

        if (string.IsNullOrWhiteSpace(_newBrand))
        {
            _newBrandError = L["GlobalProducts_RequiredBrand"];
            ok = false;
        }

        if (!Guid.TryParse(_newCategoryId, out var categoryId) || categoryId == Guid.Empty)
        {
            _newCategoryError = L["GlobalProducts_RequiredCategory"];
            ok = false;
        }

        if (string.IsNullOrWhiteSpace(_newUnit))
        {
            _newUnitError = L["GlobalProducts_RequiredUnit"];
            ok = false;
        }

        if (!ValidatePrices(_newCost, _newPrice, v => _newCostError = v, v => _newPriceError = v))
        {
            ok = false;
        }

        return ok;
    }

    private bool ValidateEditForm()
    {
        ClearEditFieldErrors();
        var ok = true;
        if (string.IsNullOrWhiteSpace(_editName))
        {
            _editNameError = L["GlobalProducts_RequiredName"];
            ok = false;
        }

        if (string.IsNullOrWhiteSpace(_editSku))
        {
            _editSkuError = L["GlobalProducts_RequiredSku"];
            ok = false;
        }

        if (!string.IsNullOrWhiteSpace(_editBarcode) && !LooksLikeOptionalGs1Barcode(_editBarcode))
        {
            _editBarcodeError = L["GlobalProducts_InvalidBarcode"];
            ok = false;
        }

        if (string.IsNullOrWhiteSpace(_editBrand))
        {
            _editBrandError = L["GlobalProducts_RequiredBrand"];
            ok = false;
        }

        if (!Guid.TryParse(_editCategoryId, out var categoryId) || categoryId == Guid.Empty)
        {
            _editCategoryError = L["GlobalProducts_RequiredCategory"];
            ok = false;
        }

        if (string.IsNullOrWhiteSpace(_editUnit))
        {
            _editUnitError = L["GlobalProducts_RequiredUnit"];
            ok = false;
        }

        if (!ValidatePrices(_editCost, _editPrice, v => _editCostError = v, v => _editPriceError = v))
        {
            ok = false;
        }

        return ok;
    }

    private bool ValidatePrices(
        decimal? cost,
        decimal? selling,
        Action<string?> setCostError,
        Action<string?> setPriceError)
    {
        setCostError(null);
        setPriceError(null);
        var ok = true;
        if (cost is null)
        {
            setCostError(L["GlobalProducts_RequiredCostPrice"]);
            ok = false;
        }
        else if (cost < 0m)
        {
            setCostError(L["GlobalProducts_InvalidCostPrice"]);
            ok = false;
        }

        if (selling is null)
        {
            setPriceError(L["GlobalProducts_RequiredSellingPrice"]);
            ok = false;
        }
        else if (selling < 0m)
        {
            setPriceError(L["GlobalProducts_InvalidSellingPrice"]);
            ok = false;
        }

        if (ok && cost is not null && selling is not null && selling < cost)
        {
            setPriceError(L["GlobalProducts_SellingBelowCost"]);
            ok = false;
        }

        return ok;
    }

    private async Task CreateAsync()
    {
        if (!CanManage || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        _formError = null;
        _formConflict = false;
        _errorAlert = null;
        try
        {
            if (!ValidateCreateForm())
            {
                return;
            }

            var categoryId = Guid.Parse(_newCategoryId);
            var result = await Api.CreateGlobalProductAsync(new CreateGlobalProductRequest(
                _newName.Trim(),
                _newUnit,
                _newSku.Trim(),
                string.IsNullOrWhiteSpace(_newBarcode) ? null : _newBarcode.Trim(),
                _newBrand.Trim(),
                categoryId,
                string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim(),
                _newCost,
                _newPrice,
                string.IsNullOrWhiteSpace(_newImage) ? null : _newImage.Trim(),
                ParseTags(_newTags),
                BusinessTypeIds: ParseBusinessTypeIds(_newBusinessTypeIds),
                SellingMode: _newSellingMode));
            if (!result.IsSuccess)
            {
                _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
                _formError = AdminFormErrorMapper.MapPageError(result);
                return;
            }

            Nav.NavigateTo($"/admin/global-catalog/products/{result.Data!.Id}?alert=created");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (Id is null || !CanManage || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        _formError = null;
        _formConflict = false;
        _errorAlert = null;
        try
        {
            if (!ValidateEditForm())
            {
                return;
            }

            var categoryId = Guid.Parse(_editCategoryId);
            var result = await Api.UpdateGlobalProductAsync(Id.Value, new UpdateGlobalProductRequest(
                _editName.Trim(),
                _editUnit,
                _editSku.Trim(),
                string.IsNullOrWhiteSpace(_editBarcode) ? null : _editBarcode.Trim(),
                _editBrand.Trim(),
                categoryId,
                string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription.Trim(),
                _editCost,
                _editPrice,
                string.IsNullOrWhiteSpace(_editImage) ? null : _editImage.Trim(),
                ParseTags(_editTags),
                BusinessTypeIds: ParseBusinessTypeIds(_editBusinessTypeIds) ?? Array.Empty<Guid>(),
                ExpectedUpdatedAtUtc: _expectedUpdatedAt,
                SellingMode: _editSellingMode));
            if (!result.IsSuccess)
            {
                _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
                _formError = AdminFormErrorMapper.MapPageError(result);
                return;
            }

            _product = result;
            BindEdit(result.Data!);
            ShowSuccessAlert(L["GlobalProducts_Saved"].Value);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ActivateProductAsync() => SetStatusAsync("Active");
    private Task ArchiveProductAsync() => SetStatusAsync("Archived");

    private async Task SetStatusAsync(string status)
    {
        if (Id is null || _product?.Data is null || !CanManage || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        _errorAlert = null;
        try
        {
            var result = await Api.SetGlobalProductStatusAsync(
                Id.Value,
                new SetGlobalProductStatusRequest(status, _product.Data.UpdatedAtUtc));
            if (!result.IsSuccess)
            {
                _errorAlert = AdminFormErrorMapper.MapPageError(result) ?? L["Common_Error"].Value;
                return;
            }

            _product = result;
            BindEdit(result.Data!);
            ShowSuccessAlert(L["GlobalProducts_StatusChanged"].Value);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowSuccessAlert(string message)
    {
        _successAlertCts?.Cancel();
        _successAlertCts?.Dispose();
        _successAlertCts = new CancellationTokenSource();
        _successAlert = message;
        _errorAlert = null;
        _ = AutoDismissSuccessAlertAsync(_successAlertCts.Token);
    }

    private async Task AutoDismissSuccessAlertAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(4500, ct);
            if (ct.IsCancellationRequested || _disposed)
            {
                return;
            }

            _successAlert = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ClearSuccessAlert()
    {
        _successAlertCts?.Cancel();
        _successAlert = null;
    }

    private void ClearErrorAlert() => _errorAlert = null;

    /// <summary>
    /// Client-side shape check only (digits, length 8–14). Blank is allowed; GS1 check digit is enforced by the API.
    /// </summary>
    private static bool LooksLikeOptionalGs1Barcode(string barcode)
    {
        var trimmed = barcode.Trim();
        return trimmed.Length is >= 8 and <= 14 && trimmed.All(char.IsAsciiDigit);
    }

    public void Dispose()
    {
        _disposed = true;
        _successAlertCts?.Cancel();
        _successAlertCts?.Dispose();
    }
}

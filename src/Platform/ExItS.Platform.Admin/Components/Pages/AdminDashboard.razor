@page "/admin"
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject AdminShellContext Shell
@inject IJSRuntime Js

@if (!_shellReady)
{
    <div style="padding:2rem; text-align:center;"><Spin /></div>
}
else if (Shell.IsPersonalShell || Shell.IsOrganizationShell)
{
    <div style="padding:2rem; text-align:center;"><Spin Tip="Opening workspace…" /></div>
}
else if (Shell.IsPlatformShell)
{
    <PageHeader Class="exits-page-header" Title="@L["Dashboard_Title"]" SubTitle="@L["Dashboard_Description"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_Dashboard"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
    </PageHeader>

    @if (_result is null)
    {
        <div style="padding:2rem; text-align:center;"><Spin Tip="@L["Dashboard_Loading"]" /></div>
    }
    else if (!_result.IsSuccess)
    {
        <Result Status="@ResultStatus.Error"
                Title="@(_result.Error?.Title ?? L["Common_Unavailable"])"
                SubTitle="@(_result.Error?.Detail ?? "")" />
        <div style="text-align:center;margin-top:1rem;">
            <Button Type="@ButtonType.Primary" OnClick="ReloadAsync" Loading="_loading">@L["Common_Retry"]</Button>
        </div>
    }
    else
    {
        var data = _result.Data!;

        <Title Level="5">@L["Dashboard_Section_Primary"]</Title>
        <Paragraph Type="@TextElementType.Secondary">@L["Dashboard_Section_PrimaryDetail"]</Paragraph>
        <Row Gutter="(12,12)" Style="margin-bottom:1rem;">
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_ActiveProducts"]">@StatInt(data.ActiveProductCount, "activeProducts")</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_Organizations"]">@StatInt(data.OrganizationCount, "organizations")</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_ActiveSubscriptions"]">@StatInt(data.ActiveSubscriptionCount, "activeSubscriptions")</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_PendingManualPayments"]">@StatInt(data.PendingManualPaymentCount, "pendingManualPayments")</AdminSummaryCard>
            </AntDesign.Col>
        </Row>

        <Title Level="5">@L["Dashboard_Section_Lifecycle"]</Title>
        <Paragraph Type="@TextElementType.Secondary">@L["Dashboard_Section_LifecycleDetail"]</Paragraph>
        <Row Gutter="(12,12)" Style="margin-bottom:1rem;">
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_TrialingSubscriptions"]">@StatInt(data.TrialingSubscriptionCount, "trialingSubscriptions")</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_GracePastDueSuspended"]">@GraceCombo(data)</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_PublishedPlanVersions"]">@StatInt(data.PublishedPlanVersionCount, "publishedPlanVersions")</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="6">
                <AdminSummaryCard Label="@L["Dashboard_Card_LatestEntitlementSnapshots"]">@StatInt(data.LatestEntitlementSnapshotCount, "latestEntitlementSnapshots")</AdminSummaryCard>
            </AntDesign.Col>
        </Row>

        <Title Level="5">@L["Dashboard_Section_Operations"]</Title>
        <Space Wrap>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/subscriptions")'>@L["Nav_Subscriptions"]</Button>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/payments")'>@L["Nav_Payments"]</Button>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/products")'>@L["Nav_Products"]</Button>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/organizations")'>@L["Nav_Organizations"]</Button>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/users")'>@L["Nav_Users"]</Button>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/audit")'>@L["Nav_Audit"]</Button>
        </Space>

        @if (data.PartialFailures.Count > 0)
        {
            <Alert Type="@AlertType.Warning"
                   ShowIcon="true"
                   Style="margin-top:1rem;"
                   Message="@L["Dashboard_PartialUnavailable"]"
                   Description="@string.Join("; ", data.PartialFailures)" />
        }
    }
}
else
{
    <PageHeader Class="exits-page-header" Title="@L["Dashboard_Title"]" SubTitle="@L["Common_Unavailable"]" />
    <Result Status="@ResultStatus.Info" Title="@L["Common_Unavailable"]" SubTitle="@Shell.RoleLabel" />
}

@code {
    private ApiCallResult<PortfolioSummaryDto>? _result;
    private HashSet<string> _failed = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading;
    private bool _started;
    private bool _shellReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
        {
            return;
        }

        _started = true;
        await Shell.EnsureLoadedAsync();
        _shellReady = true;

        if (Shell.IsPlatformShell)
        {
            await LoadWithRetryAsync();
            StateHasChanged();
            return;
        }

        if (Shell.IsPersonalShell)
        {
            await Js.InvokeVoidAsync("location.assign", Nav.ToAbsoluteUri("/admin/handoff/personal").AbsoluteUri);
            return;
        }

        if (Shell.IsOrganizationShell)
        {
            await Js.InvokeVoidAsync("location.assign", Nav.ToAbsoluteUri("/admin/handoff/organization").AbsoluteUri);
            return;
        }

        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        await LoadWithRetryAsync();
    }

    private async Task LoadWithRetryAsync()
    {
        _loading = true;
        try
        {
            ApiCallResult<PortfolioSummaryDto>? last = null;
            for (var attempt = 0; attempt < 4; attempt++)
            {
                if (attempt > 0)
                {
                    await Task.Delay(350 * attempt);
                }

                last = await Api.GetPortfolioSummaryAsync();
                if (last.IsSuccess)
                {
                    break;
                }

                var status = last.Error?.StatusCode;
                if (status is not (System.Net.HttpStatusCode.TooManyRequests
                    or System.Net.HttpStatusCode.Unauthorized
                    or System.Net.HttpStatusCode.Forbidden
                    or System.Net.HttpStatusCode.InternalServerError))
                {
                    break;
                }
            }

            _result = last;
            if (_result?.IsSuccess == true && _result.Data is not null)
            {
                _failed = _result.Data.PartialFailures
                    .Select(f => f.Split(':', 2)[0].Trim())
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private int StatInt(int value, string sectionKey) =>
        _failed.Contains(sectionKey) ? 0 : value;

    private string GraceCombo(PortfolioSummaryDto data)
    {
        if (_failed.Contains("gracePeriodSubscriptions")
            || _failed.Contains("pastDueSubscriptions")
            || _failed.Contains("suspendedSubscriptions"))
        {
            return "—";
        }

        return $"{data.GracePeriodSubscriptionCount} / {data.PastDueSubscriptionCount} / {data.SuspendedSubscriptionCount}";
    }
}

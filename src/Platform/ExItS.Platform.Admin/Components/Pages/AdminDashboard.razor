@page "/admin"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

<ReportPageShell>
    <ReportHeader Title="@L["Dashboard_Title"]"
                  Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Dashboard"]}")"
                  Description="@L["Dashboard_Description"]" />

    <ResponsiveReportLayout>
        <Kpis>
            @if (_result is null)
            {
                <ReportLoadingState Message="@L["Dashboard_Loading"]" />
            }
            else if (!_result.IsSuccess)
            {
                <ReportErrorState Title="@(_result.Error?.Title ?? L["Common_Unavailable"])"
                                  Detail="@_result.Error?.Detail"
                                  CorrelationId="@_result.Error?.CorrelationId"
                                  Unavailable="@(_result.Status == ApiCallStatus.Unavailable)" />
            }
            else
            {
                var data = _result.Data!;
                <ReportKpiGrid AriaLabel="@L["Dashboard_AriaPortfolioCounts"]">
                    <ReportKpiCard Title="@L["Dashboard_Card_ActiveProducts"]" Value="@Format(data.ActiveProductCount, "activeProducts")" />
                    <ReportKpiCard Title="@L["Dashboard_Card_PublishedPlanVersions"]" Value="@Format(data.PublishedPlanVersionCount, "publishedPlanVersions")" />
                    <ReportKpiCard Title="@L["Dashboard_Card_Organizations"]" Value="@Format(data.OrganizationCount, "organizations")" />
                    <ReportKpiCard Title="@L["Dashboard_Card_TrialingSubscriptions"]" Value="@Format(data.TrialingSubscriptionCount, "trialingSubscriptions")" />
                    <ReportKpiCard Title="@L["Dashboard_Card_ActiveSubscriptions"]" Value="@Format(data.ActiveSubscriptionCount, "activeSubscriptions")" />
                    <ReportKpiCard Title="@L["Dashboard_Card_GracePastDueSuspended"]" Value="@GraceCombo(data)" />
                    <ReportKpiCard Title="@L["Dashboard_Card_PendingManualPayments"]" Value="@Format(data.PendingManualPaymentCount, "pendingManualPayments")" />
                    <ReportKpiCard Title="@L["Dashboard_Card_LatestEntitlementSnapshots"]" Value="@Format(data.LatestEntitlementSnapshotCount, "latestEntitlementSnapshots")" />
                </ReportKpiGrid>

                @if (data.PartialFailures.Count > 0)
                {
                    <ReportSection Title="@L["Dashboard_PartialUnavailable"]" Description="@L["Dashboard_PartialUnavailableDetail"]">
                        <ul>
                            @foreach (var failure in data.PartialFailures)
                            {
                                <li>@failure</li>
                            }
                        </ul>
                    </ReportSection>
                }
            }
        </Kpis>
    </ResponsiveReportLayout>
</ReportPageShell>

@code {
    private ApiCallResult<PortfolioSummaryDto>? _result;
    private HashSet<string> _failed = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _result = await Api.GetPortfolioSummaryAsync();
        if (_result.IsSuccess && _result.Data is not null)
        {
            _failed = _result.Data.PartialFailures
                .Select(f => f.Split(':', 2)[0].Trim())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
    }

    private string Format(int value, string sectionKey) =>
        _failed.Contains(sectionKey) ? "—" : value.ToString();

    private string GraceCombo(PortfolioSummaryDto data)
    {
        if (_failed.Contains("gracePeriodSubscriptions")
            || _failed.Contains("pastDueSubscriptions")
            || _failed.Contains("suspendedSubscriptions"))
        {
            return "—";
        }

        return $"{data.GracePeriodSubscriptionCount} / {data.PastDueSubscriptionCount} / {data.SuspendedSubscriptionCount}";
    }
}

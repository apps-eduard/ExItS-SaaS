@page "/admin"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

<PageFrame Width="PageFrame.ContentWidth.Wide">
    <PageHeader Title="@L["Dashboard_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Dashboard"]}")" Description="@L["Dashboard_Description"]" />

    @if (_result is null)
    {
        <LoadingState Message="@L["Dashboard_Loading"]" />
    }
    else if (!_result.IsSuccess)
    {
        <ErrorState Title="@(_result.Error?.Title ?? L["Common_Unavailable"])" Detail="@_result.Error?.Detail" CorrelationId="@_result.Error?.CorrelationId" Unavailable="@(_result.Status == ApiCallStatus.Unavailable)" />
    }
    else
    {
        var data = _result.Data!;
        <div class="summary-grid" aria-label="@L["Dashboard_AriaPortfolioCounts"]">
            <SummaryCard Label="@L["Dashboard_Card_ActiveProducts"]" Value="@Format(data.ActiveProductCount, "activeProducts")" />
            <SummaryCard Label="@L["Dashboard_Card_PublishedPlanVersions"]" Value="@Format(data.PublishedPlanVersionCount, "publishedPlanVersions")" />
            <SummaryCard Label="@L["Dashboard_Card_Organizations"]" Value="@Format(data.OrganizationCount, "organizations")" />
            <SummaryCard Label="@L["Dashboard_Card_TrialingSubscriptions"]" Value="@Format(data.TrialingSubscriptionCount, "trialingSubscriptions")" />
            <SummaryCard Label="@L["Dashboard_Card_ActiveSubscriptions"]" Value="@Format(data.ActiveSubscriptionCount, "activeSubscriptions")" />
            <SummaryCard Label="@L["Dashboard_Card_GracePastDueSuspended"]" Value="@GraceCombo(data)" />
            <SummaryCard Label="@L["Dashboard_Card_PendingManualPayments"]" Value="@Format(data.PendingManualPaymentCount, "pendingManualPayments")" />
            <SummaryCard Label="@L["Dashboard_Card_LatestEntitlementSnapshots"]" Value="@Format(data.LatestEntitlementSnapshotCount, "latestEntitlementSnapshots")" />
        </div>

        @if (data.PartialFailures.Count > 0)
        {
            <section class="warning" role="status">
                <strong>@L["Dashboard_PartialUnavailable"]</strong> @L["Dashboard_PartialUnavailableDetail"]
                <ul>
                    @foreach (var failure in data.PartialFailures)
                    {
                        <li>@failure</li>
                    }
                </ul>
            </section>
        }
    }
</PageFrame>

@code {
    private ApiCallResult<PortfolioSummaryDto>? _result;
    private HashSet<string> _failed = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _result = await Api.GetPortfolioSummaryAsync();
        if (_result.IsSuccess && _result.Data is not null)
        {
            _failed = _result.Data.PartialFailures
                .Select(f => f.Split(':', 2)[0].Trim())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
    }

    private string Format(int value, string sectionKey) =>
        _failed.Contains(sectionKey) ? "—" : value.ToString();

    private string GraceCombo(PortfolioSummaryDto data)
    {
        if (_failed.Contains("gracePeriodSubscriptions")
            || _failed.Contains("pastDueSubscriptions")
            || _failed.Contains("suspendedSubscriptions"))
        {
            return "—";
        }

        return $"{data.GracePeriodSubscriptionCount} / {data.PastDueSubscriptionCount} / {data.SuspendedSubscriptionCount}";
    }
}

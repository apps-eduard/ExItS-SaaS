@page "/admin"
@rendermode InteractiveServer
@inject IPlatformApiClient Api

<PageHeader Title="Portfolio dashboard" Breadcrumb="Platform Admin / Dashboard" Description="Read-only commercial summary composed from Platform APIs. Failed sections are listed — counts are not invented when a section fails." />

@if (_result is null)
{
    <LoadingState Message="Loading portfolio summary…" />
}
else if (!_result.IsSuccess)
{
    <ErrorState Title="@(_result.Error?.Title ?? "Unavailable")" Detail="@_result.Error?.Detail" CorrelationId="@_result.Error?.CorrelationId" Unavailable="@(_result.Status == ApiCallStatus.Unavailable)" />
}
else
{
    var data = _result.Data!;
    <div class="summary-grid" aria-label="Portfolio counts">
        <SummaryCard Label="Active products" Value="@Format(data.ActiveProductCount, "activeProducts")" />
        <SummaryCard Label="Published plan versions" Value="@Format(data.PublishedPlanVersionCount, "publishedPlanVersions")" />
        <SummaryCard Label="Organizations" Value="@Format(data.OrganizationCount, "organizations")" />
        <SummaryCard Label="Trialing subscriptions" Value="@Format(data.TrialingSubscriptionCount, "trialingSubscriptions")" />
        <SummaryCard Label="Active subscriptions" Value="@Format(data.ActiveSubscriptionCount, "activeSubscriptions")" />
        <SummaryCard Label="Grace / Past due / Suspended" Value="@GraceCombo(data)" />
        <SummaryCard Label="Pending manual payments" Value="@Format(data.PendingManualPaymentCount, "pendingManualPayments")" />
        <SummaryCard Label="Latest entitlement snapshots" Value="@Format(data.LatestEntitlementSnapshotCount, "latestEntitlementSnapshots")" />
    </div>

    @if (data.PartialFailures.Count > 0)
    {
        <section class="warning" role="status">
            <strong>Partial data unavailable.</strong> Failed sections are not shown as zero.
            <ul>
                @foreach (var failure in data.PartialFailures)
                {
                    <li>@failure</li>
                }
            </ul>
        </section>
    }
}

@code {
    private ApiCallResult<PortfolioSummaryDto>? _result;
    private HashSet<string> _failed = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _result = await Api.GetPortfolioSummaryAsync();
        if (_result.IsSuccess && _result.Data is not null)
        {
            _failed = _result.Data.PartialFailures
                .Select(f => f.Split(':', 2)[0].Trim())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
    }

    private string Format(int value, string sectionKey) =>
        _failed.Contains(sectionKey) ? "—" : value.ToString();

    private string GraceCombo(PortfolioSummaryDto data)
    {
        if (_failed.Contains("gracePeriodSubscriptions")
            || _failed.Contains("pastDueSubscriptions")
            || _failed.Contains("suspendedSubscriptions"))
        {
            return "—";
        }

        return $"{data.GracePeriodSubscriptionCount} / {data.PastDueSubscriptionCount} / {data.SuspendedSubscriptionCount}";
    }
}

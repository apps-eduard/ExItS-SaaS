@page "/admin/personal/start-business"
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject AdminShellContext Shell

@if (!_ready)
{
    <div style="padding:2rem;text-align:center;"><Spin /></div>
}
else if (!Shell.IsPersonalShell)
{
    <Result Status="@ResultStatus.Warning" Title="@L["Personal_ShellRequired"]">
        <Extra>
            <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/admin")'>@L["Nav_Dashboard"]</Button>
        </Extra>
    </Result>
}
else
{
    <PageHeader Class="exits-page-header" Title="Start a Business" SubTitle="Create an organization and choose a commercial plan. Your personal account stays separate.">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem Href="/admin">@L["Nav_Home"]</BreadcrumbItem>
                <BreadcrumbItem>Start a Business</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
    </PageHeader>

    @if (_completed)
    {
        <Result Status="@ResultStatus.Success" Title="Business created" SubTitle="Select your organization profile to continue operating in Organization scope.">
            <Extra>
                <Space>
                    <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/admin/account-profiles")'>Choose organization profile</Button>
                    <Button OnClick='() => Nav.NavigateTo("/admin")'>@L["Nav_Dashboard"]</Button>
                </Space>
            </Extra>
        </Result>
    }
    else
    {
        <FormValidationSummary Title="Start business failed" Message="@_formError" IsConflict="_formConflict" />
        <Card Size="@CardSize.Small" Style="max-width:960px;margin-bottom:16px;">
            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                <div>
                    <label class="ant-form-item-label">Organization name</label>
                    <Input @bind-Value="_displayName" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <div>
                    <label class="ant-form-item-label">Slug</label>
                    <Input @bind-Value="_slug" Size="@InputSize.Small" Disabled="_busy" Placeholder="my-store" />
                </div>
                <div>
                    <label class="ant-form-item-label">Billing cycle</label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_billingCycle" Style="width:160px;" Disabled="_busy">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("Monthly")" Label="Monthly" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("Annual")" Label="Annual" />
                        </SelectOptions>
                    </Select>
                </div>
            </Space>
        </Card>

        @if (_plansLoading)
        {
            <LoadingState Message="@("Loading plans...")" />
        }
        else if (!string.IsNullOrWhiteSpace(_plansError))
        {
            <ErrorState Title="@L["Common_Error"].Value" Detail="@_plansError" />
            <Button Type="@ButtonType.Primary" OnClick="LoadPlansAsync" Style="margin-top:12px;">Retry</Button>
        }
        else if (_plans.Count is 0)
        {
            <Empty Description="@("No plans are currently available for this product.")" />
        }
        else
        {
            <Row Gutter="16">
                @foreach (var plan in _plans.OrderBy(p => p.SortOrder))
                {
                    var planKey = plan.PlanKey ?? plan.Code;
                    var isBusiness = string.Equals(planKey, "business", StringComparison.OrdinalIgnoreCase);
                    var isHighlighted = isBusiness && _highlightBusiness;
                    var price = _billingCycle == "Annual" ? plan.AnnualPrice : plan.MonthlyPrice;
                    var cycleLabel = _billingCycle == "Annual" ? "year" : "month";
                    <AntDesign.Col Xs="24" Sm="24" Md="8">
                        <Card Size="@CardSize.Small"
                              Title="@plan.DisplayName"
                              Style="@((isBusiness || isHighlighted) ? "border:2px solid #1890ff;" : null)">
                            @if (isBusiness)
                            {
                                <Tag Color="@("blue")" Style="margin-bottom:8px;">Recommended</Tag>
                            }
                            <p style="font-size:1.25rem;font-weight:600;margin:0 0 8px;">
                                @($"{price:0} {plan.CurrencyCode}")<span style="font-size:0.875rem;font-weight:400;"> / {cycleLabel}</span>
                            </p>
                            @if (plan.TrialAllowed && plan.DefaultTrialDays > 0)
                            {
                                <p style="color:#52c41a;margin-bottom:12px;">@($"{plan.DefaultTrialDays}-day free trial · No card required")</p>
                            }
                            else if (!plan.TrialAllowed)
                            {
                                <p style="color:#8c8c8c;margin-bottom:12px;">No free trial</p>
                            }
                            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                                @if (plan.TrialAllowed && plan.DefaultTrialDays > 0)
                                {
                                    <Button Type="@ButtonType.Primary" Block Loading="_busy" OnClick="@(() => SubmitAsync(planKey, startAsTrial: true))">
                                        Start Free Trial
                                    </Button>
                                }
                                <Button Type="@(plan.TrialAllowed ? ButtonType.Default : ButtonType.Primary)" Block Loading="_busy" OnClick="@(() => SubmitAsync(planKey, startAsTrial: false, payNow: true))">
                                    Subscribe Now
                                </Button>
                                @if (!plan.TrialAllowed && !isBusiness)
                                {
                                    <Button Type="@ButtonType.Link" Block Disabled="_busy" OnClick="@(() => SelectBusinessPlan())">
                                        Try Business Free First
                                    </Button>
                                }
                            </Space>
                        </Card>
                    </AntDesign.Col>
                }
            </Row>
        }
    }
}

@code {
    private bool _ready;
    private bool _busy;
    private bool _completed;
    private bool _plansLoading = true;
    private string? _formError;
    private string? _plansError;
    private bool _formConflict;
    private string _displayName = "";
    private string _slug = "";
    private string _billingCycle = "Monthly";
    private bool _highlightBusiness;
    private List<PlanDto> _plans = [];

    protected override async Task OnInitializedAsync()
    {
        await Shell.EnsureLoadedAsync();
        _ready = true;
        if (!Shell.IsPersonalShell)
        {
            return;
        }

        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        _plansLoading = true;
        _plansError = null;
        try
        {
            var plans = await Api.GetCommercialPlansAsync(productCode: "pinoy-business-pos");
            if (!plans.IsSuccess)
            {
                _plansError = plans.Error?.Detail ?? plans.Error?.Title ?? "Failed to load plans.";
                _plans = [];
                return;
            }

            _plans = plans.Data?.OrderBy(p => p.SortOrder).ToList() ?? [];
        }
        finally
        {
            _plansLoading = false;
        }
    }

    private void SelectBusinessPlan()
    {
        _highlightBusiness = true;
        Message.Info("Business is the recommended free-trial option. Choose Start Free Trial on the Business card.");
    }

    private async Task SubmitAsync(string planKey, bool startAsTrial, bool payNow = false)
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;

        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _busy = false;
            _formError = "Organization name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_slug))
        {
            _busy = false;
            _formError = "Organization slug is required.";
            return;
        }

        if (_billingCycle is not ("Monthly" or "Annual"))
        {
            _busy = false;
            _formError = "Billing cycle must be Monthly or Annual.";
            return;
        }

        var result = await Api.StartBusinessAsync(new StartBusinessRequest(
            _displayName.Trim(),
            _slug.Trim().ToLowerInvariant(),
            ProductCode: "pinoy-business-pos",
            PlanKey: planKey,
            BillingCycle: _billingCycle,
            StartAsTrial: startAsTrial,
            PayNow: payNow));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        _completed = true;
        await Message.SuccessAsync("Organization created. Choose your organization profile to continue.");
    }
}

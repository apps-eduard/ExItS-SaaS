@page "/admin/personal/start-business"
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AdminShellContext Shell
@inject LocalValidationSignInService LocalValidation
@inject IHostEnvironment HostEnvironment

@if (!_ready)
{
    <div style="padding:2rem;text-align:center;"><Spin /></div>
}
else if (!Shell.IsPersonalShell && !_completed)
{
    <Result Status="@ResultStatus.Warning" Title="@L["Personal_ShellRequired"]">
        <Extra>
            <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/admin")'>@L["Nav_Dashboard"]</Button>
        </Extra>
    </Result>
}
else if (_completed)
{
    <Result Status="@ResultStatus.Success" Title="Business created" SubTitle="@_successDetail">
        <Extra>
            <Space>
                <Button Type="@ButtonType.Primary" OnClick="SignInAgainAsync">
                    Sign in again
                </Button>
            </Space>
        </Extra>
    </Result>
}
else
{
    <AdminPageHeader Title="Start a Business"
                     Breadcrumb="@($"{L["Brand_Name"]} · {L["Nav_Home"]} · Start a Business")"
                     Description="Choose a plan and create an organization. Your personal account stays available as a separate profile — sign in again afterward and choose Organization." />

    <FormValidationSummary Title="Start business failed" Message="@_formError" IsConflict="_formConflict" />
    @if (!string.IsNullOrWhiteSpace(_validationBanner))
    {
        <Alert Type="@AlertType.Warning"
               ShowIcon="true"
               Closable="false"
               Style="margin-bottom:16px;"
               Message="@_validationBanner" />
    }

    @if (_busy)
    {
        <Card Size="@CardSize.Small" Style="margin-bottom:16px;">
            <div style="display:flex;align-items:center;gap:16px;">
                <Spin Size="SpinSize.Large" />
                <div>
                    <div style="font-weight:600;">@_progressTitle</div>
                    <div style="color:var(--ant-color-text-secondary,#8c8c8c);">@_progressDetail</div>
                </div>
            </div>
        </Card>
    }

    <Row Gutter="(16, 16)" Style="margin-bottom:24px;">
        <AntDesign.Col Xs="24" Md="12">
            <Card Class="admin-elevated-card" Size="@CardSize.Small" Title="Organization details" Id="start-business-org-fields">
                <div style="margin-bottom:12px;">
                    <label class="ant-form-item-label"><span class="ant-form-item-required">Organization name</span></label>
                    <Input @bind-Value="_displayName"
                           @bind-Value:after="OnDisplayNameChanged"
                           Size="@InputSize.Small"
                           Disabled="_busy"
                           Placeholder="My Store" />
                    @if (!string.IsNullOrWhiteSpace(_nameError))
                    {
                        <div style="color:#ff4d4f;font-size:12px;margin-top:4px;">@_nameError</div>
                    }
                </div>
                <div style="margin-bottom:12px;">
                    <label class="ant-form-item-label"><span class="ant-form-item-required">Slug</span></label>
                    <Input @bind-Value="_slug"
                           @bind-Value:after="OnSlugChanged"
                           Size="@InputSize.Small"
                           Disabled="_busy"
                           Placeholder="my-store" />
                    @if (!string.IsNullOrWhiteSpace(_slugError))
                    {
                        <div style="color:#ff4d4f;font-size:12px;margin-top:4px;">@_slugError</div>
                    }
                </div>
                <div>
                    <label class="ant-form-item-label"><span class="ant-form-item-required">Billing cycle</span></label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_billingCycle" Style="width:100%;" Disabled="_busy">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("Monthly")" Label="Monthly" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("Annual")" Label="Annual" />
                        </SelectOptions>
                    </Select>
                </div>
            </Card>
        </AntDesign.Col>
        <AntDesign.Col Xs="24" Md="12">
            <Card Class="admin-elevated-card" Size="@CardSize.Small" Title="What happens next">
                <Alert Type="@AlertType.Info" ShowIcon="true"
                       Message="Pick a plan below. We create your organization, start the trial or paid subscription, then switch you into Organization Administration." />
                <ul style="margin:12px 0 0;padding-left:1.25rem;">
                    <li>Starter and Business include a 14-day free trial (no card).</li>
                    <li>Subscribe Now uses the Local Validation test payment provider here.</li>
                    <li>You become Organization Owner. POS product roles are assigned separately later.</li>
                    <li>Personal utang and profile stay separate.</li>
                </ul>
            </Card>
        </AntDesign.Col>
    </Row>

    <FormSection Title="Available Plans">
        @if (_plansLoading)
        {
            <LoadingState Message="@("Loading plans...")" />
        }
        else if (!string.IsNullOrWhiteSpace(_plansError))
        {
            <ErrorState Title="@L["Common_Error"].Value" Detail="@_plansError" />
            <Button Type="@ButtonType.Primary" OnClick="LoadPlansAsync" Style="margin-top:12px;">Retry</Button>
        }
        else if (_plans.Count is 0)
        {
            <Empty Description="@("No plans are currently available for this product.")" />
        }
        else
        {
            <Row Gutter="(16, 16)">
                @foreach (var plan in _plans.OrderBy(p => p.SortOrder))
                {
                    var planKey = plan.PlanKey ?? plan.Code;
                    var isStarter = string.Equals(planKey, "starter", StringComparison.OrdinalIgnoreCase);
                    <AntDesign.Col Xs="24" Sm="24" Md="8">
                        <Card Class="admin-elevated-card"
                              Size="@CardSize.Small"
                              Title="@plan.DisplayName"
                              Style="@CardStyle(isStarter)"
                              BodyStyle="display:flex;flex-direction:column;min-height:280px;">
                            @if (isStarter)
                            {
                                <Tag Color="@("blue")" Style="margin-bottom:8px;align-self:flex-start;">Starter</Tag>
                            }
                            <div style="margin-bottom:8px;">
                                <div style="font-size:1.25rem;font-weight:600;"><AdminMoneyDisplay Amount="@plan.MonthlyPrice" CurrencyCode="@plan.CurrencyCode" /><span style="font-size:0.875rem;font-weight:400;"> / month</span></div>
                                <div style="color:var(--ant-color-text-secondary,#8c8c8c);"><AdminMoneyDisplay Amount="@plan.AnnualPrice" CurrencyCode="@plan.CurrencyCode" /> / year</div>
                            </div>
                            @if (plan.TrialAllowed && plan.DefaultTrialDays > 0)
                            {
                                <p style="color:#52c41a;margin-bottom:8px;">@($"{plan.DefaultTrialDays}-day free trial · No card required")</p>
                            }
                            else
                            {
                                <p style="color:#8c8c8c;margin-bottom:8px;">No free trial · Subscribe to start</p>
                            }
                            <ul style="margin:0 0 16px;padding-left:1.1rem;flex:1;">
                                @foreach (var line in FeatureSummary(plan))
                                {
                                    <li>@line</li>
                                }
                            </ul>
                            <Space Direction="SpaceDirection.Vertical" Style="width:100%;margin-top:auto;">
                                @if (plan.TrialAllowed && plan.DefaultTrialDays > 0)
                                {
                                    <Button Type="@ButtonType.Primary" Block Loading="_busy" Disabled="_busy"
                                            OnClick="@(async () => await SubmitAsync(planKey, startAsTrial: true))">
                                        Start Free Trial
                                    </Button>
                                }
                                <Button Type="@(plan.TrialAllowed ? ButtonType.Default : ButtonType.Primary)" Block Loading="_busy" Disabled="_busy"
                                        OnClick="@(async () => await SubmitAsync(planKey, startAsTrial: false, payNow: true))">
                                    Subscribe Now
                                </Button>
                            </Space>
                        </Card>
                    </AntDesign.Col>
                }
            </Row>
        }
    </FormSection>
}

@code {
    private bool _ready;
    private bool _busy;
    private bool _completed;
    private bool _plansLoading = true;
    private string? _formError;
    private string? _validationBanner;
    private string? _plansError;
    private string? _nameError;
    private string? _slugError;
    private bool _formConflict;
    private string _displayName = "";
    private string _slug = "";
    private string _billingCycle = "Monthly";
    private bool _slugTouched;
    private string _progressTitle = "Working…";
    private string _progressDetail = "Please wait.";
    private List<PlanDto> _plans = [];
    private Guid? _createdOrganizationId;
    private string _successDetail = "Select your organization profile to continue.";

    protected override async Task OnInitializedAsync()
    {
        await Shell.EnsureLoadedAsync();
        _ready = true;
        if (!Shell.IsPersonalShell)
        {
            return;
        }

        await LoadPlansAsync();
    }

    private static string CardStyle(bool highlight) =>
        highlight
            ? "border:2px solid #1890ff;height:100%;"
            : "height:100%;";

    private static IEnumerable<string> FeatureSummary(PlanDto plan)
    {
        yield return $"{plan.MaxBranches} branch{(plan.MaxBranches == 1 ? "" : "es")}";
        yield return $"{plan.MaxActiveStaff} active staff";
        if (plan.CustomerCreditEnabled) yield return "Customer credit (utang)";
        if (plan.AdvancedReportsEnabled) yield return "Advanced reports";
        if (plan.ExportEnabled) yield return "Export";
        if (!string.IsNullOrWhiteSpace(plan.Description)) yield return plan.Description!;
    }

    private async Task LoadPlansAsync()
    {
        _plansLoading = true;
        _plansError = null;
        try
        {
            var plans = await Api.GetCommercialPlansAsync(productCode: "pinoy-business-pos");
            if (!plans.IsSuccess)
            {
                _plansError = plans.Error?.Detail ?? plans.Error?.Title ?? "Failed to load plans.";
                _plans = [];
                await Message.ErrorAsync(_plansError);
                return;
            }

            _plans = plans.Data?.OrderBy(p => p.SortOrder).ToList() ?? [];
        }
        catch (Exception ex)
        {
            _plansError = "Could not load plans. Please retry.";
            _plans = [];
            await Message.ErrorAsync(_plansError);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _plansLoading = false;
        }
    }

    private void OnDisplayNameChanged()
    {
        if (_slugTouched || string.IsNullOrWhiteSpace(_displayName))
        {
            return;
        }

        _slug = SuggestSlug(_displayName);
    }

    private void OnSlugChanged() => _slugTouched = !string.IsNullOrWhiteSpace(_slug);

    private static string SuggestSlug(string displayName)
    {
        var chars = displayName.Trim().ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) ? c : '-')
            .ToArray();
        var slug = new string(chars);
        while (slug.Contains("--", StringComparison.Ordinal))
        {
            slug = slug.Replace("--", "-", StringComparison.Ordinal);
        }

        return slug.Trim('-');
    }

    private bool ValidateForm()
    {
        _nameError = null;
        _slugError = null;
        _formError = null;
        _validationBanner = null;
        _formConflict = false;
        var ok = true;

        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _nameError = "Organization name is required.";
            ok = false;
        }
        else if (!_slugTouched && string.IsNullOrWhiteSpace(_slug))
        {
            _slug = SuggestSlug(_displayName);
        }

        if (string.IsNullOrWhiteSpace(_slug))
        {
            _slugError = "Organization slug is required.";
            ok = false;
        }
        else
        {
            _slugTouched = true;
        }

        if (_billingCycle is not ("Monthly" or "Annual"))
        {
            _formError = "Billing cycle must be Monthly or Annual.";
            ok = false;
        }

        if (!ok)
        {
            _validationBanner = "Fill Organization name and Slug above, then try Start Free Trial or Subscribe again.";
            _formError ??= _validationBanner;
        }

        return ok;
    }

    private async Task SignInAgainAsync()
    {
        // Full HTTP logout so cookies clear; login again and pick Organization profile.
        await Task.Yield();
        await Task.Delay(1);
        var notice = Uri.EscapeDataString(
            "Business ready. Sign in and choose your Organization profile to continue.");
        await Js.InvokeVoidAsync(
            "location.assign",
            Nav.ToAbsoluteUri($"/admin/logout?notice={notice}").AbsoluteUri);
    }

    private async Task SetProgressAsync(string title, string detail)
    {
        _progressTitle = title;
        _progressDetail = detail;
        await InvokeAsync(StateHasChanged);
    }

    private bool AllowSubscribeUxDelay =>
        !HostEnvironment.IsProduction()
        && (LocalValidation.IsAvailable
            || HostEnvironment.IsDevelopment()
            || HostEnvironment.IsEnvironment("Testing"));

    private async Task SubmitAsync(string planKey, bool startAsTrial, bool payNow = false)
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            await Message.WarningAsync("Please wait — a request is already in progress.");
            return;
        }

        try
        {
            if (!ValidateForm())
            {
                await InvokeAsync(StateHasChanged);
                await Message.WarningAsync(_validationBanner ?? _nameError ?? _slugError ?? _formError ?? "Complete the required organization fields first.");
                return;
            }

            if (string.IsNullOrWhiteSpace(planKey))
            {
                _formError = "Select a valid plan.";
                await Message.ErrorAsync(_formError);
                return;
            }

            if (startAsTrial)
            {
                await SetProgressAsync("Creating your business…", "Provisioning organization and Owner membership.");
            }
            else
            {
                await SetProgressAsync("Processing test payment…", "Charging via Local Validation payment provider.");
                if (AllowSubscribeUxDelay)
                {
                    await Task.Delay(2500);
                }
            }

            if (startAsTrial)
            {
                await SetProgressAsync("Activating your trial…", "Creating the trial subscription and entitlements.");
            }
            else
            {
                await SetProgressAsync("Activating your subscription…", "Confirming payment and activating the plan.");
            }

            var result = await Api.StartBusinessAsync(new StartBusinessRequest(
                _displayName.Trim(),
                _slug.Trim().ToLowerInvariant(),
                ProductCode: "pinoy-business-pos",
                PlanKey: planKey,
                BillingCycle: _billingCycle,
                StartAsTrial: startAsTrial,
                PayNow: payNow,
                AssignPosOwnerRole: false));

            if (!result.IsSuccess)
            {
                _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
                _formError = AdminFormErrorMapper.MapPageError(result) ?? "Start business failed.";
                _validationBanner = _formError;
                await InvokeAsync(StateHasChanged);
                await Message.ErrorAsync(_formError);
                return;
            }

            await SetProgressAsync("Finishing…", "Subscription succeeded. Preparing sign-in instructions.");

            var data = result.Data!;
            _createdOrganizationId = data.OrganizationId;
            // Prefer a clean re-login into the Organization profile over mid-circuit cookie SignIn.
            // Personal and Organization remain separate account profiles on the same Platform user.
            _completed = true;
            _successDetail = startAsTrial
                ? "Trial started. Your Organization profile is ready. Sign in again and choose Organization (Personal stays available separately)."
                : "Payment succeeded. Your Organization profile is ready. Sign in again and choose Organization (Personal stays available separately).";
            await InvokeAsync(StateHasChanged);
            await Message.SuccessAsync(startAsTrial
                ? "Business created with free trial. Sign in again to open Organization Administration."
                : "Business created and subscribed. Sign in again to open Organization Administration.");
        }
        catch (Exception ex)
        {
            if (_completed || _createdOrganizationId is not null)
            {
                // Business already created; avoid masking success with a post-navigation circuit error.
                Console.Error.WriteLine(ex);
                return;
            }

            _formError = HostEnvironment.IsDevelopment() || HostEnvironment.IsEnvironment("Testing")
                ? $"An unexpected error occurred while starting the business: {ex.Message}"
                : "An unexpected error occurred while starting the business. Please retry.";
            _validationBanner = _formError;
            await Message.ErrorAsync(_formError);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _busy = false;
            if (!_completed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }
}

@page "/admin/personal/start-business"
@using ExItS.Web.UI
@using Microsoft.Extensions.Options
@layout EmptyLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject IOptions<ExItSWebHostOptions> Hosts

<div style="padding:2rem;text-align:center;"><Spin Tip="Opening Start a Business…" /></div>

@code {
    protected override void OnInitialized()
    {
        Nav.NavigateTo(Hosts.Value.GetOrigin(WebApps.Personal).TrimEnd('/') + "/start-business", forceLoad: true);
    }
}

@page "/admin/personal/utang/people"
@page "/admin/personal/utang/lent"
@page "/admin/personal/utang/borrowed"
@page "/admin/personal/utang/invitations"
@page "/admin/personal/notifications"
@page "/admin/personal/profile"
@page "/admin/personal/settings"
@using ExItS.Web.UI
@using Microsoft.Extensions.Options
@layout EmptyLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject IOptions<ExItSWebHostOptions> Hosts

<div style="padding:2rem;text-align:center;"><Spin Tip="Opening Personal Web…" /></div>

@code {
    protected override void OnInitialized()
    {
        var personalPath = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var mapped = personalPath switch
        {
            "/admin/personal/utang/people" => "/utang/people",
            "/admin/personal/utang/lent" => "/utang/lent",
            "/admin/personal/utang/borrowed" => "/utang/borrowed",
            "/admin/personal/utang/invitations" => "/utang/invitations",
            "/admin/personal/notifications" => "/notifications",
            "/admin/personal/profile" => "/profile",
            "/admin/personal/settings" => "/settings",
            _ => "/home"
        };
        Nav.NavigateTo(Hosts.Value.GetOrigin(WebApps.Personal).TrimEnd('/') + mapped, forceLoad: true);
    }
}

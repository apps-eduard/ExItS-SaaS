@page "/admin/accept-organization-invitation"
@layout EmptyLayout
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@attribute [AllowAnonymous]
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject IMessageService Message

<PageTitle>@L["Brand_Name"] — Accept invitation</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-login-brand">
                <span class="exits-brand-mark">EA</span>
                <span>Accept organization invitation</span>
            </div>
        </TitleTemplate>
        <Body>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Style="margin-bottom: 1rem;" />
            }

            @if (_done)
            {
                <Alert Type="@AlertType.Success" Message="Your staff account is ready" ShowIcon="true" Style="margin-bottom: 1rem;" />
                <Paragraph>Organization: <strong>@_organizationName</strong></Paragraph>
                <Paragraph>Contact email: <strong>@_contactEmail</strong></Paragraph>
                <Paragraph>Staff login: <strong>@_staffLogin</strong></Paragraph>
                <Button Type="@ButtonType.Primary" Block Size="@ButtonSize.Small" OnClick="@(() => Nav.NavigateTo("/admin/login"))">
                    Continue to sign in
                </Button>
            }
            else
            {
                <Paragraph Type="@TextElementType.Secondary">
                    Create your organization staff password to accept the invitation. You will sign in with a staff login name shown after acceptance.
                </Paragraph>
                <Form Model="_model" OnFinish="AcceptAsync" Layout="@FormLayout.Vertical">
                    <FormItem Label="Password">
                        <InputPassword @bind-Value="_model.Password" Size="@InputSize.Small" Placeholder="Choose a password" />
                    </FormItem>
                    <FormItem>
                        <Button Type="@ButtonType.Primary"
                                HtmlType="submit"
                                Block
                                Size="@ButtonSize.Small"
                                Loading="_busy"
                                Disabled="_busy || string.IsNullOrWhiteSpace(_token)">
                            Accept invitation
                        </Button>
                    </FormItem>
                </Form>
            }
        </Body>
    </Card>
</div>

@code {
    private readonly AcceptFormModel _model = new();
    private string _token = "";
    private string? _error;
    private bool _busy;
    private bool _done;
    private string? _staffLogin;
    private string? _contactEmail;
    private string? _organizationName;

    private sealed class AcceptFormModel
    {
        public string Password { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var tokenValues))
        {
            _token = tokenValues.ToString();
        }
    }

    private async Task AcceptAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_token) || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        var result = await Api.AcceptOrganizationInvitationAsync(_token, _model.Password);
        _busy = false;
        if (!result.IsSuccess)
        {
            _error = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        _staffLogin = result.Data?.StaffLogin;
        _contactEmail = result.Data?.ContactEmail;
        _organizationName = result.Data?.OrganizationDisplayName;
        _done = true;
        await Message.SuccessAsync("Your staff account is ready.");
    }
}

@page "/admin/organizations/{OrganizationId:guid}/catalog"
@using AntDesign
@using AntDesign.TableModels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L
@inject PlatformPermissionState Permissions
@inject NavigationManager Nav
@inject AdminShellContext Shell

@if (!Permissions.Loaded)
{
    <Spin />
}
else if (Shell.IsOrganizationShell)
{
    <div style="padding:2rem;text-align:center;"><Spin Tip="Opening Organization Web…" /></div>
}
else if (!CanAccess)
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ManageOrganizations" />
}
else
{
    <PageHeader Class="exits-page-header" Title="@(_catalog?.Data?.OrganizationDisplayName ?? L["OrgCatalog_Title"])" SubTitle="@L["OrgCatalog_Description"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem Href="/admin/organizations">@L["Nav_Organizations"]</BreadcrumbItem>
                <BreadcrumbItem Href="@($"/admin/organizations/{OrganizationId}")">@(_catalog?.Data?.OrganizationDisplayName ?? L["Common_Detail"])</BreadcrumbItem>
                <BreadcrumbItem>@L["OrgCatalog_Title"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
    </PageHeader>

    <p>
        <a href="/admin/organizations/@OrganizationId">← @L["OrgCatalog_BackToOrganization"]</a>
    </p>

    <Space Style="margin-bottom:12px; width:100%;" Wrap>
        <Input @bind-Value="_search" Size="@InputSize.Small" Placeholder="@L["OrgCatalog_SearchPlaceholder"]" Style="width:220px;" OnPressEnter="ApplyFiltersAsync" />
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ApplyFiltersAsync">@L["Common_Apply"]</Button>
        <Button Size="@ButtonSize.Small" OnClick="ClearFiltersAsync">@L["Common_Reset"]</Button>
    </Space>

    @if (_catalog is null)
    {
        <div style="padding:2rem;text-align:center;"><Spin Tip="@L["OrgCatalog_Loading"]" /></div>
    }
    else if (!_catalog.IsSuccess)
    {
        <Result Status="@ResultStatus.Error" Title="@(_catalog.Error?.Title ?? L["Common_Error"])" SubTitle="@_catalog.Error?.Detail" />
    }
    else
    {
        var c = _catalog.Data!;
        <Descriptions Bordered Size="@DescriptionsSize.Small" Column="2" Style="margin-bottom:12px;">
            <DescriptionsItem Title="@L["Common_DisplayName"]">@c.OrganizationDisplayName</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Status"]"><AdminStatusTag Value="@c.OrganizationStatus" /></DescriptionsItem>
            <DescriptionsItem Title="@L["OrgCatalog_BusinessType"]">@(c.BusinessType ?? L["OrgCatalog_BusinessTypeUnknown"])</DescriptionsItem>
            <DescriptionsItem Title="@L["OrgCatalog_ProductCount"]">@c.ProductCount</DescriptionsItem>
        </Descriptions>

        <Title Level="5">@L["OrgCatalog_SourceBreakdown"]</Title>
        <Space Wrap Style="margin-bottom:16px;">
            @foreach (var entry in c.SourceBreakdown.OrderBy(x => x.Key))
            {
                <Tag>@entry.Key: @entry.Value</Tag>
            }
        </Space>

        <Table TItem="OrganizationCatalogProductDto"
               DataSource="@(c.Products ?? Array.Empty<OrganizationCatalogProductDto>())"
               Total="c.TotalCount"
               @bind-PageIndex="_page"
               @bind-PageSize="_pageSize"
               OnChange="OnTableChangeAsync"
               Size="@TableSize.Small"
               Bordered
               ScrollX="1200"
               Loading="_busy">
            <PropertyColumn Property="p => p.Name" Title="@L["Common_Name"]" Ellipsis />
            <PropertyColumn Property="p => p.Sku" Title="@L["OrgCatalog_Sku"]" Width="120" />
            <PropertyColumn Property="p => p.Barcode" Title="@L["OrgCatalog_Barcode"]" Width="140" />
            <PropertyColumn Property="p => p.CategoryName" Title="@L["OrgCatalog_Category"]" Width="140" />
            <PropertyColumn Property="p => p.SellingPrice" Title="@L["OrgCatalog_Price"]" Width="100" />
            <PropertyColumn Property="p => p.Status" Title="@L["Common_Status"]" Width="100">
                <AdminStatusTag Value="@context.Status" />
            </PropertyColumn>
            <PropertyColumn Property="p => p.SourceType" Title="@L["OrgCatalog_SourceType"]" Width="140" />
            <PropertyColumn Property="p => p.CatalogSource" Title="@L["OrgCatalog_CatalogSource"]" Width="120" />
            <PropertyColumn Property="p => p.IsTracked" Title="@L["OrgCatalog_Tracked"]" Width="90">
                @(context.IsTracked ? L["Common_Yes"] : L["Common_No"])
            </PropertyColumn>
            <PropertyColumn Property="p => p.OnHandQuantity" Title="@L["OrgCatalog_OnHand"]" Width="90">
                @(context.IsTracked ? context.OnHandQuantity?.ToString() ?? "0" : "—")
            </PropertyColumn>
        </Table>
    }
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }

    private bool CanAccess => Permissions.HasPermission(PlatformPermissionCodes.ManageOrganizations);

    private ApiCallResult<OrganizationCatalogVisibilityDto>? _catalog;
    private string? _search;
    private int _page = 1;
    private int _pageSize = 20;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        await Shell.EnsureLoadedAsync();
        if (OrganizationShellHandoff.TryRedirect(Shell, Nav, "/products"))
        {
            return;
        }

        if (!Permissions.Loaded || !CanAccess)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _search = null;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnTableChangeAsync(QueryModel<OrganizationCatalogProductDto> _)
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _catalog = await Api.GetOrganizationCatalogAsync(OrganizationId, _page, _pageSize, _search);
        }
        finally
        {
            _busy = false;
        }
    }
}

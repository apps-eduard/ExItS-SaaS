@page "/admin/privacy-compliance"
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L
@inject PlatformPermissionState Permissions
@inject NavigationManager Nav

@if (!Permissions.Loaded)
{
    <LoadingState />
}
else if (!CanView)
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ViewPrivacyCompliance" />
}
else
{
    <AdminPageHeader Title="@L["PrivacyCompliance_OverviewTitle"]"
                     Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_PrivacyCompliance"]}")"
                     Description="@L["PrivacyCompliance_OverviewDescription"]" />

    <Alert Type="@AlertType.Info"
           ShowIcon="true"
           Message="@L["PrivacyCompliance_ReadinessBannerTitle"]"
           Description="@ReadinessBannerDescription"
           Style="margin-bottom:16px;" />

    <Alert Type="@AlertType.Warning"
           ShowIcon="true"
           Message="@L["PrivacyCompliance_DisclaimerTitle"]"
           Description="@L["PrivacyCompliance_DisclaimerMessage"]"
           Style="margin-bottom:16px;" />

    @if (_overview is null)
    {
        <LoadingState Message="@L["PrivacyCompliance_LoadingOverview"]" />
    }
    else if (!_overview.IsSuccess)
    {
        <ErrorState Detail="@_overview.Error?.Detail" CorrelationId="@_overview.Error?.CorrelationId" Unavailable="@(_overview.Status == ApiCallStatus.Unavailable)" />
    }
    else
    {
        var data = _overview.Data!;
        <Card Size="@CardSize.Small" Style="margin-bottom:16px;">
            <p style="margin:0 0 8px 0;"><strong>@L["PrivacyCompliance_ReadinessLabel"]</strong>
                <PrivacyComplianceStatusTag Value="@data.OverallReadiness" />
            </p>
            <Row Gutter="(12, 8)">
                <AntDesign.Col Xs="24" Md="12">
                    <span class="muted">@L["PrivacyCompliance_TechnicalSafeguardsLabel"]: </span>
                    <strong>@TechnicalSummaryLabel(data.TechnicalSafeguardsSummary)</strong>
                </AntDesign.Col>
                <AntDesign.Col Xs="24" Md="12">
                    <span class="muted">@L["PrivacyCompliance_GovernanceLabel"]: </span>
                    <strong>@data.GovernanceDocumentationSummary</strong>
                </AntDesign.Col>
                <AntDesign.Col Xs="24" Md="12">
                    <span class="muted">@L["PrivacyCompliance_LegalReviewLabel"]: </span>
                    <strong>@LegalSummaryLabel(data.LegalReviewSummary)</strong>
                </AntDesign.Col>
                <AntDesign.Col Xs="24" Md="12">
                    <span class="muted">@L["PrivacyCompliance_NpcLabel"]: </span>
                    <strong>@NpcSummaryLabel(data.NpcVerificationSummary)</strong>
                </AntDesign.Col>
            </Row>
        </Card>

        <Row Gutter="(12, 12)" Style="margin-bottom:16px;">
            <AntDesign.Col Xs="24" Sm="12" Md="8" Lg="4">
                <AdminSummaryCard Label="@L["PrivacyCompliance_TotalRequirements"]">@data.TotalRequirements</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="8" Lg="4">
                <AdminSummaryCard Label="@L["PrivacyCompliance_ReadyCount"]">@data.ReadyCount</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="8" Lg="4">
                <AdminSummaryCard Label="@L["PrivacyCompliance_ActionNeededCount"]">@data.ActionNeededCount</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="8" Lg="4">
                <AdminSummaryCard Label="@L["PrivacyCompliance_ExternalLegalCount"]">@data.ExternalLegalReviewCount</AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="8" Lg="4">
                <AdminSummaryCard Label="@L["PrivacyCompliance_EvidenceCoverage"]">
                    @data.RequirementsWithEvidenceCount / @data.TotalRequirements
                </AdminSummaryCard>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Sm="12" Md="8" Lg="4">
                <AdminSummaryCard Label="@L["PrivacyCompliance_TotalSystems"]">@data.TotalSystems</AdminSummaryCard>
            </AntDesign.Col>
        </Row>

        @if (data.LastUpdatedUtc is DateTimeOffset updated)
        {
            <p class="muted" style="margin-bottom:16px;">@L["PrivacyCompliance_LastUpdated"]: <UtcTimestamp Value="@updated" /></p>
        }

        <Card Title="@L["PrivacyCompliance_CategoryReadiness"]" Size="@CardSize.Small" Style="margin-bottom:16px;">
            @if (data.CategorySummaries is null || data.CategorySummaries.Count == 0)
            {
                <Empty Description="@L["PrivacyCompliance_NoData"].Value" />
            }
            else
            {
                <Table TItem="PrivacyReadinessCategorySummaryDto"
                       DataSource="data.CategorySummaries"
                       HidePagination
                       Bordered
                       Size="@TableSize.Small"
                       ScrollX="960">
                    <Column TData="string" Title="@L["PrivacyCompliance_ColumnCategory"]">
                        @CategoryGroupLabel(context.Group)
                    </Column>
                    <Column TData="string" Title="@L["Common_Status"]">
                        <PrivacyComplianceStatusTag Value="@context.Status" />
                    </Column>
                    <Column TData="int" Title="@L["Common_Count"]" DataIndex="RequirementCount">@context.RequirementCount</Column>
                    <Column TData="int" Title="@L["PrivacyCompliance_ReadyCount"]" DataIndex="ReadyCount">@context.ReadyCount</Column>
                    <Column TData="int" Title="@L["PrivacyCompliance_ActionNeededCount"]" DataIndex="ActionNeededCount">@context.ActionNeededCount</Column>
                    <Column TData="int" Title="@L["PrivacyCompliance_EvidenceCoverage"]">
                        @context.EvidenceCoveredCount / @context.RequirementCount
                    </Column>
                    <Column TData="DateOnly?" Title="@L["PrivacyCompliance_LastReviewed"]">
                        @(context.LastReviewedDate?.ToString("yyyy-MM-dd") ?? L["PrivacyCompliance_NotAssessed"].Value)
                    </Column>
                    <ActionColumn Title="@L["Common_Actions"]">
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick="() => Nav.NavigateTo(context.DetailRoute)">
                            @L["Common_ViewDetails"]
                        </Button>
                    </ActionColumn>
                </Table>
            }
        </Card>

        <Card Title="@L["PrivacyCompliance_PrivacyImpactFollowUps"]" Size="@CardSize.Small" Style="margin-bottom:16px;">
            @if (data.PrivacyImpactFollowUps is null || data.PrivacyImpactFollowUps.Count == 0)
            {
                <Empty Description="@L["PrivacyCompliance_NoPrivacyImpacts"].Value" />
            }
            else
            {
                <Table TItem="PrivacyImpactFollowUpDto"
                       DataSource="data.PrivacyImpactFollowUps"
                       HidePagination
                       Bordered
                       Size="@TableSize.Small"
                       ScrollX="960">
                    <Column TData="string" Title="@L["Common_Name"]" DataIndex="Title">@context.Title</Column>
                    <Column TData="string" Title="@L["PrivacyCompliance_ColumnCode"]" DataIndex="Code">
                        <span class="muted">@context.Code</span>
                    </Column>
                    <Column TData="string" Title="@L["Common_Status"]">
                        <PrivacyComplianceStatusTag Value="@context.Status" />
                    </Column>
                    <Column TData="bool" Title="@L["PrivacyCompliance_LegalReviewRequired"]">
                        @(context.RequiresDpoLegalVerification ? L["Common_Yes"] : L["Common_No"])
                    </Column>
                    <Column TData="int" Title="@L["PrivacyCompliance_ColumnEvidence"]" DataIndex="EvidenceCount">@context.EvidenceCount</Column>
                    <ActionColumn Title="@L["Common_Actions"]">
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/privacy-compliance/pias")'>
                            @L["Common_ViewDetails"]
                        </Button>
                    </ActionColumn>
                </Table>
            }
        </Card>

        <Row Gutter="(12, 12)" Style="margin-bottom:16px;">
            <AntDesign.Col Xs="24" Md="12">
                <Card Title="@L["PrivacyCompliance_RequirementsByStatus"]" Size="@CardSize.Small">
                    @if (data.RequirementsByStatus.Count == 0)
                    {
                        <Empty Description="@L["PrivacyCompliance_NoData"].Value" />
                    }
                    else
                    {
                        <Table TItem="KeyValuePair<string, int>"
                               DataSource="@StatusRows(data.RequirementsByStatus)"
                               HidePagination
                               Bordered
                               Size="@TableSize.Small">
                            <Column TData="string" Title="@L["Common_Status"]">
                                <PrivacyComplianceStatusTag Value="@context.Key" />
                            </Column>
                            <Column TData="int" Title="@L["Common_Count"]" DataIndex="Value">
                                @context.Value
                            </Column>
                        </Table>
                    }
                </Card>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Md="12">
                <Card Title="@L["PrivacyCompliance_QuickLinks"]" Size="@CardSize.Small">
                    <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                        <Button Block OnClick='() => Nav.NavigateTo("/admin/privacy-compliance/documents")'>@L["Nav_PrivacyComplianceDocuments"]</Button>
                        <Button Block OnClick='() => Nav.NavigateTo("/admin/privacy-compliance/systems")'>@L["Nav_PrivacyComplianceSystems"]</Button>
                        <Button Block OnClick='() => Nav.NavigateTo("/admin/privacy-compliance/pias")'>@L["Nav_PrivacyCompliancePias"]</Button>
                        <Button Block OnClick='() => Nav.NavigateTo("/admin/privacy-compliance/evidence")'>@L["Nav_PrivacyComplianceEvidence"]</Button>
                        <Button Block OnClick='() => Nav.NavigateTo("/admin/privacy-compliance/dpo-npc")'>@L["Nav_PrivacyComplianceDpoNpc"]</Button>
                    </Space>
                </Card>
            </AntDesign.Col>
        </Row>

        <Card Title="@L["PrivacyCompliance_ImportantGaps"]" Size="@CardSize.Small">
            @if (_gaps is null)
            {
                <Spin />
            }
            else if (_gaps.Count == 0)
            {
                <Empty Description="@L["PrivacyCompliance_NoGaps"].Value" />
            }
            else
            {
                <Table TItem="ComplianceRequirementDto"
                       DataSource="_gaps"
                       HidePagination
                       Bordered
                       Size="@TableSize.Small"
                       ScrollX="960">
                    <Column TData="string" Title="@L["Common_Name"]" DataIndex="Title">@context.Title</Column>
                    <Column TData="string" Title="@L["PrivacyCompliance_ColumnCode"]" DataIndex="Code">
                        <span class="muted">@context.Code</span>
                    </Column>
                    <Column TData="string" Title="@L["Common_Status"]">
                        <PrivacyComplianceStatusTag Value="@context.Status" />
                    </Column>
                    <ActionColumn Title="@L["Common_Actions"]">
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick='() => Nav.NavigateTo("/admin/privacy-compliance/documents")'>
                            @L["Common_ViewDetails"]
                        </Button>
                    </ActionColumn>
                </Table>
            }
        </Card>
    }
}

@code {
    private ApiCallResult<PrivacyComplianceOverviewDto>? _overview;
    private IReadOnlyList<ComplianceRequirementDto>? _gaps;

    private bool CanView => Permissions.HasPermission(PlatformPermissionCodes.ViewPrivacyCompliance);

    private string ReadinessBannerDescription =>
        $"{L["PrivacyCompliance_ReadinessBannerMessage"]} {L["PrivacyCompliance_NoCertificationClaim"]}";

    protected override async Task OnInitializedAsync()
    {
        await Permissions.EnsureLoadedAsync();
        if (!CanView)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _overview = await Api.GetPrivacyComplianceOverviewAsync();
        if (!_overview.IsSuccess)
        {
            return;
        }

        var requirements = await Api.ListPrivacyComplianceRequirementsAsync();
        if (requirements.IsSuccess && requirements.Data is not null)
        {
            _gaps = requirements.Data.Where(PrivacyComplianceFilters.IsImportantGap).ToList();
        }
    }

    private static List<KeyValuePair<string, int>> StatusRows(IReadOnlyDictionary<string, int> source) =>
        source.OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase).ToList();

    private string TechnicalSummaryLabel(string value) => value switch
    {
        "Implemented" => L["PrivacyCompliance_Technical_Implemented"],
        "Partial" => L["PrivacyCompliance_Technical_Partial"],
        "ActionNeeded" => L["PrivacyCompliance_Technical_ActionNeeded"],
        "Unavailable" => L["PrivacyCompliance_Unavailable"],
        _ => value
    };

    private string LegalSummaryLabel(string value) =>
        string.Equals(value, "Required", StringComparison.OrdinalIgnoreCase)
            ? L["PrivacyCompliance_LegalReviewRequired"]
            : value;

    private string NpcSummaryLabel(string value) => value switch
    {
        "NotVerified" => L["PrivacyCompliance_Npc_NotVerified"],
        "InternalRecordApproved" => L["PrivacyCompliance_Npc_InternalRecord"],
        _ => value
    };

    private string CategoryGroupLabel(string group) => group switch
    {
        "NoticesAndConsent" => L["PrivacyCompliance_Group_NoticesAndConsent"],
        "Governance" => L["PrivacyCompliance_Group_Governance"],
        "DataInventory" => L["PrivacyCompliance_Group_DataInventory"],
        "RetentionAndDeletion" => L["PrivacyCompliance_Group_Retention"],
        "DataSubjectRequests" => L["PrivacyCompliance_Group_Dsar"],
        "SecurityAndAccess" => L["PrivacyCompliance_Group_Security"],
        "IncidentResponse" => L["PrivacyCompliance_Group_Incidents"],
        "BusinessContinuity" => L["PrivacyCompliance_Group_Bcp"],
        "VendorsAndProcessors" => L["PrivacyCompliance_Group_Vendors"],
        "DpoRegulatoryReadiness" => L["PrivacyCompliance_Group_Dpo"],
        "PrivacyImpact" => L["PrivacyCompliance_Group_PrivacyImpact"],
        _ => group
    };
}

@page "/admin/reset-password"
@layout EmptyLayout
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@attribute [AllowAnonymous]
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav

<PageTitle>@L["Brand_Name"] — Reset password</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-login-brand">
                <span class="exits-brand-mark">EA</span>
                <span>@L["ResetPassword_Title"]</span>
            </div>
        </TitleTemplate>
        <Body>
            <Paragraph Type="@TextElementType.Secondary">@L["ResetPassword_Hint"]</Paragraph>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Closable="true" OnClose="() => _error = null" Style="margin-bottom: 1rem;" />
            }

            @if (_done)
            {
                <Alert Type="@AlertType.Success" Message="@L["ResetPassword_Success"]" ShowIcon="true" Style="margin-bottom: 1rem;" />
                <Button Type="@ButtonType.Primary" Block Size="@ButtonSize.Small" OnClick="@(() => Nav.NavigateTo("/admin/login"))">
                    @L["Login_SignIn"]
                </Button>
            }
            else
            {
                <div class="exits-login-form">
                    <div class="ant-form-item">
                        <label class="ant-form-item-label" for="reset-password">@L["ResetPassword_NewPassword"]</label>
                        <InputPassword Id="reset-password" @bind-Value="_password" Disabled="_busy" />
                    </div>
                    <div class="ant-form-item">
                        <label class="ant-form-item-label" for="reset-confirm">@L["Activate_ConfirmPassword"]</label>
                        <InputPassword Id="reset-confirm" @bind-Value="_confirm" Disabled="_busy" />
                    </div>
                    <Button Type="@ButtonType.Primary" Block Size="@ButtonSize.Small" Loading="_busy" Disabled="_busy || string.IsNullOrWhiteSpace(_token)" OnClick="SubmitAsync">
                        @L["ResetPassword_Submit"]
                    </Button>
                    <div class="exits-login-links">
                        <a href="/admin/login">@L["Login_SignIn"]</a>
                    </div>
                </div>
            }
        </Body>
    </Card>
</div>

@code {
    private string _token = "";
    private string _password = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;
    private bool _done;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var tokenValues))
        {
            _token = tokenValues.ToString();
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = L["ResetPassword_TokenMissing"];
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            _error = L["ResetPassword_PasswordRequired"];
            return;
        }

        if (!string.Equals(_password, _confirm, StringComparison.Ordinal))
        {
            _error = L["Activate_PasswordMismatch"];
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.ResetPasswordAsync(new ResetPasswordRequest(_token, _password));
            if (!result.IsSuccess)
            {
                _error = result.Error?.Detail ?? L["Common_ActionFailed"];
                return;
            }

            _done = true;
        }
        finally
        {
            _busy = false;
        }
    }
}

@page "/admin/reset-password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@attribute [AllowAnonymous]
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav

<PageTitle>@L["Brand_Name"] — Reset password</PageTitle>

<div class="login-shell">
    <div class="login-panel page-frame page-frame--form">
        <h1>Reset password</h1>
        <p class="muted">Redeem a one-time reset token. All sessions are revoked after success.</p>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="form-validation-summary" role="alert">@_error</div> }
        @if (_done)
        {
            <p>Password reset. Sign in with the new password.</p>
            <p><a href="/admin/login">Sign in</a></p>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="OnSubmitAsync" FormName="reset-password">
                <div class="form-field">
                    <label class="form-field-label" for="tok">Reset token</label>
                    <InputText id="tok" class="form-control" @bind-Value="_model.Token" autocomplete="off" />
                </div>
                <div class="form-field">
                    <label class="form-field-label" for="np">New password</label>
                    <InputText id="np" type="password" class="form-control" @bind-Value="_model.NewPassword" autocomplete="new-password" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-primary" disabled="@_busy">@(_busy ? "Saving…" : "Reset password")</button>
                    <a href="/admin/login">Back to sign in</a>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private readonly Model _model = new();
    private string? _error;
    private bool _busy;
    private bool _done;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var tokenValues))
        {
            _model.Token = tokenValues.ToString();
        }
    }

    private async Task OnSubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.ResetPasswordAsync(new ResetPasswordRequest(_model.Token, _model.NewPassword));
            if (!result.IsSuccess)
            {
                _error = result.Error?.Detail ?? "Reset failed.";
                return;
            }

            _done = true;
        }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string Token { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
    }
}

@page "/admin/global-catalog/categories"
@page "/admin/global-catalog/categories/{Id:guid}"
@using AntDesign
@using AntDesign.TableModels
@using ExItS.Platform.Admin.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject PlatformPermissionState Permissions

@if (!Permissions.Loaded)
{
    <Spin />
}
else if (!CanView)
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ViewGlobalCatalog" />
}
else if (Id is null)
{
    <PageHeader Class="exits-page-header" Title="@L["GlobalCategories_Title"]" SubTitle="@L["GlobalCategories_Description"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_ProductCatalog"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_GlobalCategories"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            @if (CanManage)
            {
                <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ToggleCreate">
                    @(_showCreate ? L["GlobalCategories_HideCreate"] : L["GlobalCategories_Create"])
                </Button>
            }
        </PageHeaderExtra>
    </PageHeader>

    <Space Style="margin-bottom:12px; width:100%;" Wrap>
        <Input @bind-Value="_search" Size="@InputSize.Small" Placeholder="@L["GlobalCategories_SearchPlaceholder"]" Style="width:220px;" OnPressEnter="ApplyFiltersAsync" />
        <Select TItemValue="string" TItem="string" @bind-Value="_status" Size="@InputSize.Small" Placeholder="@L["Common_Status"]" Style="width:140px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Active")" Label="@L["Status_Active"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Inactive")" Label="@L["Status_Inactive"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Archived")" Label="@L["Status_Archived"]" />
            </SelectOptions>
        </Select>
        <Select TItemValue="string" TItem="string" @bind-Value="_businessTypeCode" Size="@InputSize.Small" Placeholder="@L["GlobalCatalog_BusinessType"]" Style="width:180px;" AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                @foreach (var bt in _activeBusinessTypes)
                {
                    <SelectOption TItemValue="string" TItem="string" Value="@bt.Code" Label="@($"{bt.Name} ({bt.Code})")" />
                }
            </SelectOptions>
        </Select>
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ApplyFiltersAsync">@L["Common_Apply"]</Button>
        <Button Size="@ButtonSize.Small" OnClick="ClearFiltersAsync">@L["Common_Reset"]</Button>
    </Space>

    @if (_showCreate && CanManage)
    {
        <Card Size="@CardSize.Small" Title="@L["GlobalCategories_CreateSection"]" Style="margin-bottom:12px;">
            <FormValidationSummary Title="@L["GlobalCategories_CreateFailed"]" Message="@_formError" IsConflict="_formConflict" />
            <Space Direction="SpaceDirection.Vertical" Style="width:100%; max-width:560px;">
                <div>
                    <label class="ant-form-item-label" for="gc-cat-name">@L["Common_Name"]</label>
                    <Input Id="gc-cat-name" @bind-Value="_newName" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <div>
                    <label class="ant-form-item-label">@L["GlobalCategories_Parent"]</label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_newParentId" Size="@InputSize.Small" Style="width:100%;" AllowClear Disabled="_busy" Placeholder="@L["GlobalCategories_NoParent"]">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["GlobalCategories_NoParent"]" />
                            @foreach (var c in ParentOptions)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@c.Id.ToString("D")" Label="@c.Name" />
                            }
                        </SelectOptions>
                    </Select>
                </div>
                <div>
                    <label class="ant-form-item-label" for="gc-cat-icon">@L["GlobalCategories_IconReference"]</label>
                    <Input Id="gc-cat-icon" @bind-Value="_newIcon" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <div>
                    <label class="ant-form-item-label" for="gc-cat-sort">@L["GlobalCategories_SortOrder"]</label>
                    <AntDesign.InputNumber Id="gc-cat-sort" TValue="int" @bind-Value="_newSortOrder" Min="0" Disabled="_busy" Style="width:120px;" />
                </div>
                <div>
                    <label class="ant-form-item-label">@L["GlobalCatalog_BusinessTypes"]</label>
                    <CheckboxGroup @bind-Value="_newBusinessTypeIds" Options="@_businessTypeCheckboxOptions" Disabled="_busy" />
                </div>
                <Space>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="CreateAsync">@L["Common_Create"]</Button>
                    <Button Size="@ButtonSize.Small" OnClick="HideCreate" Disabled="_busy">@L["Common_Cancel"]</Button>
                </Space>
            </Space>
        </Card>
    }

    @if (CanManage && _selectedIds.Count > 0)
    {
        <Card Size="@CardSize.Small" Title="@L["GlobalCategories_BulkAssignTitle"]" Style="margin-bottom:12px;">
            <Space Wrap Style="width:100%;">
                <span>@string.Format(L["GlobalCategories_BulkSelected"].Value, _selectedIds.Count)</span>
                <Select TItemValue="string" TItem="string"
                        Mode="@SelectMode.Multiple"
                        @bind-Values="_bulkBusinessTypeIds"
                        Size="@InputSize.Small"
                        Style="min-width:260px;"
                        Placeholder="@L["GlobalCatalog_BusinessTypes"]"
                        Disabled="_busy">
                    <SelectOptions>
                        @foreach (var bt in _activeBusinessTypes)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value="@bt.Id.ToString("D")" Label="@($"{bt.Name} ({bt.Code})")" />
                        }
                    </SelectOptions>
                </Select>
                <Select TItemValue="string" TItem="string" @bind-Value="_bulkMode" Size="@InputSize.Small" Style="width:140px;" Disabled="_busy">
                    <SelectOptions>
                        <SelectOption TItemValue="string" TItem="string" Value="@("Add")" Label="@L["GlobalCategories_BulkModeAdd"]" />
                        <SelectOption TItemValue="string" TItem="string" Value="@("Remove")" Label="@L["GlobalCategories_BulkModeRemove"]" />
                        <SelectOption TItemValue="string" TItem="string" Value="@("Replace")" Label="@L["GlobalCategories_BulkModeReplace"]" />
                    </SelectOptions>
                </Select>
                <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="BulkAssignAsync">@L["GlobalCategories_BulkAssign"]</Button>
                <Button Size="@ButtonSize.Small" OnClick="ClearSelection" Disabled="_busy">@L["Common_Reset"]</Button>
            </Space>
        </Card>
    }

    @if (_list is { IsSuccess: false })
    {
        <Result Status="@ResultStatus.Error" Title="@(_list.Error?.Title ?? L["Common_Error"])" SubTitle="@_list.Error?.Detail" />
    }
    else if (_list is { IsSuccess: true, Data.Items.Count: 0 })
    {
        <Empty Description="@L["GlobalCategories_Empty"].Value" />
    }
    else
    {
        <Table TItem="GlobalCategoryDto"
               Class="exits-table-fit"
               DataSource="@(_list?.Data?.Items ?? Array.Empty<GlobalCategoryDto>())"
               Total="@(_list?.Data?.TotalCount ?? 0)"
               @bind-PageIndex="_page"
               PageSize="@(_list?.Data?.PageSize ?? 50)"
               Loading="@(_list is null)"
               Size="@TableSize.Small"
               Bordered
               Resizable
               ScrollX="900"
               RemoteDataSource
               OnChange="OnCategoriesTableChangeAsync">
            @if (CanManage)
            {
                <PropertyColumn Property="c => c.Id" Title=" " Width="48" Sortable="false">
                    <Checkbox Checked="@_selectedIds.Contains(context.Id)"
                              CheckedChanged="isChecked => ToggleSelected(context.Id, isChecked)" />
                </PropertyColumn>
            }
            <PropertyColumn Property="c => c.Name" Title="@L["Common_Name"]" Sortable>
                <a href="/admin/global-catalog/categories/@context.Id">@Indent(context)@context.Name</a>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Sortable Width="110">
                <AdminStatusTag Value="@context.Status" />
            </PropertyColumn>
            <PropertyColumn Property="c => c.BusinessTypes" Title="@L["GlobalCatalog_BusinessTypes"]" Width="220">
                @if (context.BusinessTypes.Count == 0)
                {
                    <span>—</span>
                }
                else
                {
                    @foreach (var typeCode in context.BusinessTypes)
                    {
                        <Tag Style="margin-bottom:2px;">@typeCode</Tag>
                    }
                }
            </PropertyColumn>
            <PropertyColumn Property="c => c.UpdatedAtUtc" Title="@L["Common_UpdatedUtc"]" Sortable Width="180">
                <LocalTimestamp Value="@context.UpdatedAtUtc" />
            </PropertyColumn>
            <ActionColumn Title="@L["Common_Open"]" Width="80">
                <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/global-catalog/categories/{context.Id}")">@L["Common_Open"]</a>
            </ActionColumn>
        </Table>
    }
}
else
{
    <PageHeader Class="exits-page-header" Title="@(_category?.Data?.Name ?? L["GlobalCategories_DetailTitle"])" SubTitle="@L["GlobalCategories_DetailDescription"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem Href="/admin/global-catalog/categories">@L["Nav_GlobalCategories"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Common_Detail"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            @if (_category?.IsSuccess == true && CanManage)
            {
                var c = _category.Data!;
                <Space>
                    @if (c.Status == "Inactive" || c.Status == "Archived")
                    {
                        <Popconfirm Title="@L["GlobalCategories_ConfirmActivate"]" OnConfirm="ActivateCategoryAsync" OkText="@L["Common_Confirm"]" CancelText="@L["Common_Cancel"]">
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy">@L["GlobalCategories_Activate"]</Button>
                        </Popconfirm>
                    }
                    @if (c.Status == "Active")
                    {
                        <Popconfirm Title="@L["GlobalCategories_ConfirmDeactivate"]" OnConfirm="DeactivateCategoryAsync" OkText="@L["Common_Confirm"]" CancelText="@L["Common_Cancel"]">
                            <Button Size="@ButtonSize.Small" Loading="_busy">@L["GlobalCategories_Deactivate"]</Button>
                        </Popconfirm>
                    }
                    @if (c.Status is "Active" or "Inactive")
                    {
                        <Popconfirm Title="@L["GlobalCategories_ConfirmArchive"]" OnConfirm="ArchiveCategoryAsync" OkText="@L["Common_Confirm"]" CancelText="@L["Common_Cancel"]">
                            <Button Size="@ButtonSize.Small" Danger Loading="_busy">@L["GlobalCategories_Archive"]</Button>
                        </Popconfirm>
                    }
                </Space>
            }
        </PageHeaderExtra>
    </PageHeader>

    @if (_category is null)
    {
        <div style="padding:2rem;text-align:center;"><Spin Tip="@L["GlobalCategories_DetailLoading"]" /></div>
    }
    else if (!_category.IsSuccess)
    {
        <Result Status="@ResultStatus.Error" Title="@(_category.Error?.Title ?? L["Common_Error"])" SubTitle="@_category.Error?.Detail" />
    }
    else
    {
        var c = _category.Data!;
        <Descriptions Bordered Size="@DescriptionsSize.Small" Column="2" Style="margin-bottom:12px;">
            <DescriptionsItem Title="@L["Common_Status"]"><AdminStatusTag Value="@c.Status" /></DescriptionsItem>
            <DescriptionsItem Title="@L["GlobalCategories_Parent"]">@ParentName(c.ParentId)</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_CreatedUtc"]"><UtcTimestamp Value="@c.CreatedAtUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Common_UpdatedUtc"]"><UtcTimestamp Value="@c.UpdatedAtUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["GlobalCatalog_BusinessTypes"]">
                @if (c.BusinessTypes.Count == 0)
                {
                    <span>—</span>
                }
                else
                {
                    @foreach (var typeCode in c.BusinessTypes)
                    {
                        <Tag>@typeCode</Tag>
                    }
                }
            </DescriptionsItem>
        </Descriptions>

        @if (CanManage && c.Status != "Archived")
        {
            <Card Size="@CardSize.Small" Title="@L["GlobalCategories_EditSection"]">
                <FormValidationSummary Title="@L["GlobalCategories_SaveFailed"]" Message="@_formError" IsConflict="_formConflict" />
                <Space Direction="SpaceDirection.Vertical" Style="width:100%; max-width:560px;">
                    <div>
                        <label class="ant-form-item-label" for="gc-cat-edit-name">@L["Common_Name"]</label>
                        <Input Id="gc-cat-edit-name" @bind-Value="_editName" Size="@InputSize.Small" Disabled="_busy" />
                    </div>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalCategories_Parent"]</label>
                        <Select TItemValue="string" TItem="string" @bind-Value="_editParentId" Size="@InputSize.Small" Style="width:100%;" AllowClear Disabled="_busy">
                            <SelectOptions>
                                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["GlobalCategories_NoParent"]" />
                                @foreach (var opt in ParentOptions.Where(p => p.Id != c.Id))
                                {
                                    <SelectOption TItemValue="string" TItem="string" Value="@opt.Id.ToString("D")" Label="@opt.Name" />
                                }
                            </SelectOptions>
                        </Select>
                    </div>
                    <div>
                        <label class="ant-form-item-label" for="gc-cat-edit-icon">@L["GlobalCategories_IconReference"]</label>
                        <Input Id="gc-cat-edit-icon" @bind-Value="_editIcon" Size="@InputSize.Small" Disabled="_busy" />
                    </div>
                    <div>
                        <label class="ant-form-item-label" for="gc-cat-edit-sort">@L["GlobalCategories_SortOrder"]</label>
                        <AntDesign.InputNumber Id="gc-cat-edit-sort" TValue="int" @bind-Value="_editSortOrder" Min="0" Disabled="_busy" Style="width:120px;" />
                    </div>
                    <div>
                        <label class="ant-form-item-label">@L["GlobalCatalog_BusinessTypes"]</label>
                        <CheckboxGroup @bind-Value="_editBusinessTypeIds" Options="@_businessTypeCheckboxOptions" Disabled="_busy" />
                    </div>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="SaveAsync">@L["Common_Save"]</Button>
                </Space>
            </Card>
        }
        else
        {
            <Descriptions Size="@DescriptionsSize.Small" Column="1">
                <DescriptionsItem Title="@L["Common_Name"]">@c.Name</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalCategories_IconReference"]">@(c.IconReference ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalCategories_SortOrder"]">@c.SortOrder</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalCatalog_BusinessTypes"]">
                    @(c.BusinessTypes.Count == 0 ? "—" : string.Join(", ", c.BusinessTypes))
                </DescriptionsItem>
            </Descriptions>
        }
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private CheckboxOption<string>[] _businessTypeCheckboxOptions = [];
    private List<BusinessTypeDto> _activeBusinessTypes = [];

    private ApiCallResult<PagedResult<GlobalCategoryDto>>? _list;
    private ApiCallResult<GlobalCategoryDto>? _category;
    private List<GlobalCategoryDto> _allForLookup = [];
    private readonly HashSet<Guid> _selectedIds = [];
    private IEnumerable<string> _bulkBusinessTypeIds = Array.Empty<string>();
    private string _bulkMode = "Add";
    private int _page = 1;
    private string? _sortBy;
    private bool _sortDesc;
    private string _search = "";
    private string _status = "";
    private string _businessTypeCode = "";
    private bool _showCreate;
    private string _newName = "";
    private string _newParentId = "";
    private string _newIcon = "";
    private int _newSortOrder;
    private string[] _newBusinessTypeIds = [];
    private string _editName = "";
    private string _editParentId = "";
    private string _editIcon = "";
    private int _editSortOrder;
    private string[] _editBusinessTypeIds = [];
    private DateTimeOffset? _expectedUpdatedAt;
    private string? _formError;
    private bool _formConflict;
    private bool _busy;
    private readonly AdminPageLoadGate _loadGate = new();

    private bool CanView => Permissions.HasPermission(PlatformPermissionCodes.ViewGlobalCatalog);
    private bool CanManage => Permissions.HasPermission(PlatformPermissionCodes.ManageGlobalCategories);

    private IEnumerable<GlobalCategoryDto> ParentOptions =>
        _allForLookup.Where(c => c.Status != "Archived").OrderBy(c => c.SortOrder).ThenBy(c => c.Name);

    protected override async Task OnParametersSetAsync()
    {
        _formError = null;
        _formConflict = false;
        if (!CanView)
        {
            return;
        }

        await EnsureLookupsAsync();

        if (Id is null)
        {
            if (!_loadGate.ShouldLoad("list"))
            {
                return;
            }

            await LoadListAsync();
        }
        else if (_loadGate.ShouldLoad(Id))
        {
            await LoadDetailAsync();
        }
    }

    private async Task EnsureLookupsAsync()
    {
        if (_allForLookup.Count == 0)
        {
            var result = await Api.GetGlobalCategoriesAsync(page: 1, pageSize: 200);
            if (result is { IsSuccess: true, Data: not null })
            {
                _allForLookup = result.Data.Items.ToList();
            }
        }

        if (_activeBusinessTypes.Count == 0)
        {
            var types = await Api.GetBusinessTypesAsync(page: 1, pageSize: 200, status: "Active", sortBy: "SortOrder");
            if (types is { IsSuccess: true, Data: not null })
            {
                _activeBusinessTypes = types.Data.Items.ToList();
                _businessTypeCheckboxOptions = _activeBusinessTypes
                    .Select(bt => new CheckboxOption<string>
                    {
                        Label = $"{bt.Name} ({bt.Code})",
                        Value = bt.Id.ToString("D")
                    })
                    .ToArray();
            }
        }
    }

    private async Task LoadListAsync() =>
        _list = await Api.GetGlobalCategoriesAsync(
            page: _page,
            pageSize: 50,
            status: string.IsNullOrWhiteSpace(_status) ? null : _status,
            businessTypeCode: string.IsNullOrWhiteSpace(_businessTypeCode) ? null : _businessTypeCode,
            search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
            sortBy: _sortBy,
            sortDesc: _sortBy is null ? null : _sortDesc);

    private async Task OnCategoriesTableChangeAsync(QueryModel<GlobalCategoryDto> queryModel)
    {
        await AdminTableSort.ApplyChangeAsync(
            queryModel,
            MapSortField,
            () => _sortBy,
            v => _sortBy = v,
            () => _sortDesc,
            v => _sortDesc = v,
            () => _page,
            v => _page = v,
            LoadListAsync);
    }

    private static string? MapSortField(string? fieldName) => fieldName switch
    {
        "Name" => "Name",
        "SortOrder" => "SortOrder",
        "Status" => "Status",
        "UpdatedAtUtc" => "UpdatedAtUtc",
        _ => null
    };

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        ClearSelection();
        await LoadListAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _search = "";
        _status = "";
        _businessTypeCode = "";
        _sortBy = null;
        _sortDesc = false;
        _page = 1;
        ClearSelection();
        await LoadListAsync();
    }

    private void ToggleSelected(Guid id, bool selected)
    {
        if (selected)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        _bulkBusinessTypeIds = Array.Empty<string>();
    }

    private async Task BulkAssignAsync()
    {
        if (!CanManage || _selectedIds.Count == 0 || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        var ids = _bulkBusinessTypeIds
            .Where(v => Guid.TryParse(v, out _))
            .Select(Guid.Parse)
            .ToList();
        if (ids.Count == 0 && !string.Equals(_bulkMode, "Replace", StringComparison.OrdinalIgnoreCase))
        {
            _busy = false;
            await Message.WarningAsync(L["GlobalCategories_BulkNeedTypes"].Value);
            return;
        }

        var failures = 0;
        foreach (var categoryId in _selectedIds.ToList())
        {
            var category = _list?.Data?.Items.FirstOrDefault(c => c.Id == categoryId);
            var result = await Api.BulkAssignCategoryBusinessTypesAsync(
                categoryId,
                new BulkAssignCategoryBusinessTypesRequest(
                    _bulkMode,
                    BusinessTypeIds: ids,
                    ExpectedUpdatedAtUtc: category?.UpdatedAtUtc));
            if (!result.IsSuccess)
            {
                failures++;
            }
        }

        _busy = false;
        if (failures > 0)
        {
            await Message.ErrorAsync(string.Format(L["GlobalCategories_BulkPartialFail"].Value, failures));
        }
        else
        {
            await Message.SuccessAsync(L["GlobalCategories_BulkAssigned"].Value);
        }

        ClearSelection();
        _allForLookup.Clear();
        await EnsureLookupsAsync();
        await LoadListAsync();
    }

    private async Task LoadDetailAsync()
    {
        if (Id is null) return;
        _category = await Api.GetGlobalCategoryAsync(Id.Value);
        if (_category is { IsSuccess: true, Data: not null })
        {
            BindEdit(_category.Data);
        }
    }

    private void BindEdit(GlobalCategoryDto c)
    {
        _editName = c.Name;
        _editParentId = c.ParentId?.ToString("D") ?? "";
        _editIcon = c.IconReference ?? "";
        _editSortOrder = c.SortOrder;
        _editBusinessTypeIds = c.BusinessTypeIds.Select(id => id.ToString("D")).ToArray();
        _expectedUpdatedAt = c.UpdatedAtUtc;
    }

    private string Indent(GlobalCategoryDto c) => c.ParentId is null ? "" : "↳ ";

    private string ParentName(Guid? parentId)
    {
        if (parentId is null) return L["GlobalCategories_NoParent"];
        var match = _allForLookup.FirstOrDefault(x => x.Id == parentId)
            ?? _list?.Data?.Items.FirstOrDefault(x => x.Id == parentId);
        return match?.Name ?? parentId.Value.ToString("D")[..8];
    }

    private void ToggleCreate() => _showCreate = !_showCreate;

    private void HideCreate()
    {
        _showCreate = false;
        _formError = null;
        _formConflict = false;
    }

    private static IReadOnlyList<Guid>? ParseIds(string[] values) =>
        values.Length == 0
            ? null
            : values.Where(v => Guid.TryParse(v, out _)).Select(Guid.Parse).ToList();

    private async Task CreateAsync()
    {
        if (!CanManage || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        _formError = null;
        _formConflict = false;
        Guid? parentId = Guid.TryParse(_newParentId, out var pid) ? pid : null;
        var result = await Api.CreateGlobalCategoryAsync(new CreateGlobalCategoryRequest(
            _newName,
            parentId,
            string.IsNullOrWhiteSpace(_newIcon) ? null : _newIcon.Trim(),
            _newSortOrder,
            BusinessTypeIds: ParseIds(_newBusinessTypeIds)));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        await Message.SuccessAsync(L["GlobalCategories_Created"].Value);
        _allForLookup.Clear();
        Nav.NavigateTo($"/admin/global-catalog/categories/{result.Data!.Id}");
    }

    private async Task SaveAsync()
    {
        if (Id is null || !CanManage || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        _formError = null;
        _formConflict = false;
        Guid? parentId = Guid.TryParse(_editParentId, out var pid) ? pid : null;
        var result = await Api.UpdateGlobalCategoryAsync(Id.Value, new UpdateGlobalCategoryRequest(
            _editName,
            parentId,
            string.IsNullOrWhiteSpace(_editIcon) ? null : _editIcon.Trim(),
            _editSortOrder,
            BusinessTypeIds: ParseIds(_editBusinessTypeIds) ?? Array.Empty<Guid>(),
            ExpectedUpdatedAtUtc: _expectedUpdatedAt));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        await Message.SuccessAsync(L["GlobalCategories_Saved"].Value);
        _category = result;
        _allForLookup.Clear();
        BindEdit(result.Data!);
    }

    private Task ActivateCategoryAsync() => SetStatusAsync("Active");
    private Task DeactivateCategoryAsync() => SetStatusAsync("Inactive");
    private Task ArchiveCategoryAsync() => SetStatusAsync("Archived");

    private async Task SetStatusAsync(string status)
    {
        if (Id is null || _category?.Data is null || !CanManage || !AdminFormErrorMapper.TryBeginSubmit(ref _busy)) return;
        var result = await Api.SetGlobalCategoryStatusAsync(
            Id.Value,
            new SetGlobalCategoryStatusRequest(status, _category.Data.UpdatedAtUtc));
        _busy = false;
        if (!result.IsSuccess)
        {
            await Message.ErrorAsync(AdminFormErrorMapper.MapPageError(result) ?? L["Common_Error"].Value);
            return;
        }

        await Message.SuccessAsync(L["GlobalCategories_StatusChanged"].Value);
        _allForLookup.Clear();
        await LoadDetailAsync();
    }
}

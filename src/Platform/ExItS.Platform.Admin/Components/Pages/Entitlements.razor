@page "/admin/entitlements"
@page "/admin/entitlements/{Id:guid}"
@page "/admin/entitlements/history/{OrganizationId:guid}/{ProductCode}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

@if (Id is not null)
{
    <PageHeader Title="@L["Entitlements_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Entitlements"]} / {L["Common_Detail"]}")" Description="@L["Entitlements_DetailDescription"]" />
    <section class="warning" role="note">@L["Entitlements_DetailWarning"]</section>
    @if (_detail is null) { <LoadingState Message="@L["Entitlements_DetailLoading"]" /> }
    else if (!_detail.IsSuccess) { <ErrorState Title="@(_detail.Error?.Title ?? L["Common_Error"])" Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" /> }
    else
    {
        var s = _detail.Data!;
        <dl>
            <dt>@L["Common_Organization"]</dt><dd><a href="/admin/organizations/@s.OrganizationId">@s.OrganizationId</a></dd>
            <dt>@L["Common_Product"]</dt><dd>@s.ProductCode</dd>
            <dt>@L["Common_Subscription"]</dt><dd><a href="/admin/subscriptions/@s.SubscriptionId">@s.SubscriptionId</a></dd>
            <dt>@L["Common_Plan"]</dt><dd>@s.PlanCode v@s.PlanVersionNumber</dd>
            <dt>@L["Entitlements_SnapshotVersion"]</dt><dd>@s.SnapshotVersion</dd>
            <dt>@L["Entitlements_SchemaVersion"]</dt><dd>@s.SchemaVersion</dd>
            <dt>@L["Entitlements_SubscriptionStatus"]</dt><dd><StatusBadge Value="@s.SubscriptionStatus" /></dd>
            <dt>@L["Entitlements_InGracePeriod"]</dt><dd>@s.InGracePeriod</dd>
            <dt>@L["Common_GeneratedUtc"]</dt><dd><UtcTimestamp Value="@s.GeneratedAtUtc" /></dd>
            <dt>@L["Common_EffectiveUtc"]</dt><dd><UtcTimestamp Value="@s.EffectiveAtUtc" /></dd>
            <dt>@L["Entitlements_RefreshByUtc"]</dt><dd><UtcTimestamp Value="@s.RefreshByUtc" /></dd>
            <dt>@L["Common_ExpiresUtc"]</dt><dd><UtcTimestamp Value="@s.ExpiresAtUtc" /></dd>
            <dt>@L["Common_History"]</dt><dd><a href="/admin/entitlements/history/@s.OrganizationId/@s.ProductCode">@L["Common_ViewHistory"]</a></dd>
        </dl>

        <h2>@L["Entitlements_FeatureGrants"]</h2>
        @if (s.Grants.Count == 0) { <EmptyState Message="@L["Entitlements_NoGrants"]" /> }
        else
        {
            <table class="data-table responsive-table">
                <thead><tr><th>@L["Common_Feature"]</th><th>@L["Common_Enabled"]</th><th>@L["Common_Limit"]</th><th>@L["Common_Source"]</th><th>@L["Common_EffectiveUtc"]</th><th>@L["Common_ExpiresUtc"]</th></tr></thead>
                <tbody>
                @foreach (var g in s.Grants)
                {
                    <tr>
                        <td data-label="@L["Common_Feature"]">@g.FeatureCode</td>
                        <td data-label="@L["Common_Enabled"]">@g.Enabled</td>
                        <td data-label="@L["Common_Limit"]">@(g.NumericLimit?.ToString() ?? "—")</td>
                        <td data-label="@L["Common_Source"]">@g.Source</td>
                        <td data-label="@L["Common_EffectiveUtc"]"><UtcTimestamp Value="@g.EffectiveAtUtc" /></td>
                        <td data-label="@L["Common_ExpiresUtc"]"><UtcTimestamp Value="@g.ExpiresAtUtc" /></td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h2>@L["Entitlements_FeatureOverrideHistory"]</h2>
        @if (_overrides is null) { <LoadingState Message="@L["Entitlements_OverridesLoading"]" /> }
        else if (!_overrides.IsSuccess) { <ErrorState Title="@(_overrides.Error?.Title ?? L["Entitlements_OverridesUnavailable"])" Detail="@_overrides.Error?.Detail" /> }
        else if (_overrides.Data!.Items.Count == 0) { <EmptyState Message="@L["Entitlements_NoOverrides"]" /> }
        else
        {
            <table class="data-table responsive-table">
                <thead><tr><th>@L["Common_Feature"]</th><th>@L["Common_Enabled"]</th><th>@L["Common_Limit"]</th><th>@L["Common_Status"]</th><th>@L["Common_Reason"]</th><th>@L["Entitlements_Column_EffectiveFromUtc"]</th></tr></thead>
                <tbody>
                @foreach (var o in _overrides.Data.Items)
                {
                    <tr>
                        <td data-label="@L["Common_Feature"]">@o.FeatureCode</td>
                        <td data-label="@L["Common_Enabled"]">@o.Enabled</td>
                        <td data-label="@L["Common_Limit"]">@(o.NumericLimit?.ToString() ?? "—")</td>
                        <td data-label="@L["Common_Status"]"><StatusBadge Value="@o.Status" /></td>
                        <td data-label="@L["Common_Reason"]">@o.Reason</td>
                        <td data-label="@L["Entitlements_Column_EffectiveFromUtc"]"><UtcTimestamp Value="@o.EffectiveFromUtc" /></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
}
else if (OrganizationId is not null && ProductCode is not null)
{
    <ReportPageShell>
        <ReportHeader Title="@L["Entitlements_HistoryTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Entitlements"]} / {L["Common_History"]}")" Description="@L["Entitlements_HistoryDescription"]" />
        <ReportSection Title="@L["Entitlements_HistoryTitle"]">
            <ReportDataPanel IsLoading="@(_history is null)"
                            HasError="@(_history is { IsSuccess: false })"
                            IsEmpty="@(_history is { IsSuccess: true, Data.Items.Count: 0 })"
                            LoadingMessage="@L["Entitlements_HistoryLoading"]"
                            EmptyMessage="@L["Entitlements_HistoryEmpty"]"
                            ErrorTitle="@(_history?.Error?.Title ?? L["Common_Error"])"
                            ErrorDetail="@_history?.Error?.Detail"
                            ErrorCorrelationId="@_history?.Error?.CorrelationId"
                            ErrorUnavailable="@(_history?.Status == ApiCallStatus.Unavailable)">
                <ReportTable TItem="EntitlementSnapshotDto"
                             Items="_history!.Data!.Items"
                             Columns="_historyColumns"
                             Caption="@L["Entitlements_HistoryTitle"]"
                             ItemKey="x => x.Id"
                             CellTemplate="HistoryCell" />
                <ReportTotalsRow Label="@L["Report_PaymentsTotals"]" Value="@($"{_history.Data.Items.Count}")" />
            </ReportDataPanel>
        </ReportSection>
    </ReportPageShell>
}
else
{
    <ReportPageShell>
        <ReportHeader Title="@L["Entitlements_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Entitlements"]}")" Description="@L["Entitlements_Description"]" />
        <section class="warning" role="note">@L["Entitlements_Warning"]</section>
        <ReportSection Title="@L["Entitlements_Title"]">
            <ReportDataPanel IsLoading="@(_latest is null || _listBusy)"
                            HasError="@(_latest is { IsSuccess: false })"
                            IsEmpty="@(_latest is { IsSuccess: true, Data.Items.Count: 0 })"
                            LoadingMessage="@L["Entitlements_Loading"]"
                            EmptyMessage="@L["Entitlements_Empty"]"
                            ErrorTitle="@(_latest?.Error?.Title ?? L["Common_Error"])"
                            ErrorDetail="@_latest?.Error?.Detail"
                            ErrorCorrelationId="@_latest?.Error?.CorrelationId"
                            ErrorUnavailable="@(_latest?.Status == ApiCallStatus.Unavailable)">
                <ReportTable TItem="EntitlementLatestSummaryDto"
                             Items="_latest!.Data!.Items"
                             Columns="_latestColumns"
                             Caption="@L["Entitlements_Title"]"
                             ItemKey="x => x.Id"
                             CellTemplate="LatestCell" />
                <ReportTotalsRow Label="@L["Report_PaymentsTotals"]" Value="@($"{_latest.Data.Items.Count}")" />
                <AdminPagination Page="_latest.Data.Page"
                                 PageSize="_latest.Data.PageSize"
                                 TotalCount="_latest.Data.TotalCount"
                                 PageChanged="OnLatestPageAsync"
                                 Disabled="_listBusy" />
            </ReportDataPanel>
        </ReportSection>
    </ReportPageShell>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public Guid? OrganizationId { get; set; }
    [Parameter] public string? ProductCode { get; set; }

    private ApiCallResult<PagedResult<EntitlementLatestSummaryDto>>? _latest;
    private ApiCallResult<EntitlementSnapshotDto>? _detail;
    private ApiCallResult<PagedResult<EntitlementSnapshotDto>>? _history;
    private ApiCallResult<PagedResult<FeatureOverrideDto>>? _overrides;
    private bool _listBusy;
    private int _page = 1;
    private List<AdminColumnDefinition> _latestColumns = new();
    private List<AdminColumnDefinition> _historyColumns = new();

    protected override void OnInitialized()
    {
        _latestColumns =
        [
            new("product", L["Common_Product"], Primary: true),
            new("org", L["Common_Organization"]),
            new("version", L["Common_Version"]),
            new("status", L["Common_Status"]),
            new("generated", L["Common_GeneratedUtc"]),
            new("history", L["Common_History"])
        ];
        _historyColumns =
        [
            new("version", L["Common_Version"], Primary: true),
            new("schema", L["Entitlements_SchemaVersion"]),
            new("status", L["Common_Status"]),
            new("generated", L["Common_GeneratedUtc"])
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is not null)
        {
            _detail = await Api.GetEntitlementAsync(Id.Value);
            if (_detail.IsSuccess && _detail.Data is not null)
            {
                _overrides = await Api.GetFeatureOverridesAsync(_detail.Data.OrganizationId, _detail.Data.ProductCode);
            }
        }
        else if (OrganizationId is not null && ProductCode is not null)
        {
            _history = await Api.GetEntitlementHistoryAsync(OrganizationId.Value, ProductCode);
        }
        else
        {
            await LoadLatestAsync();
        }
    }

    private async Task LoadLatestAsync()
    {
        _listBusy = true;
        try
        {
            _latest = await Api.GetLatestEntitlementsAsync(page: _page);
        }
        finally
        {
            _listBusy = false;
        }
    }

    private async Task OnLatestPageAsync(int page)
    {
        _page = page;
        await LoadLatestAsync();
    }

    private RenderFragment<(EntitlementLatestSummaryDto Item, AdminColumnDefinition Column)> LatestCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "product":
                b.AddContent(0, ctx.Item.ProductCode);
                break;
            case "org":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/organizations/{ctx.Item.OrganizationId}");
                b.AddContent(2, ctx.Item.OrganizationId);
                b.CloseElement();
                break;
            case "version":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/entitlements/{ctx.Item.Id}");
                b.AddContent(2, ctx.Item.SnapshotVersion);
                b.CloseElement();
                break;
            case "status":
                b.OpenComponent<ReportStatusBadge>(0);
                b.AddAttribute(1, nameof(ReportStatusBadge.Value), ctx.Item.SubscriptionStatus);
                b.CloseComponent();
                break;
            case "generated":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.GeneratedAtUtc);
                b.CloseComponent();
                break;
            case "history":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/entitlements/history/{ctx.Item.OrganizationId}/{ctx.Item.ProductCode}");
                b.AddContent(2, L["Common_History"].Value);
                b.CloseElement();
                break;
        }
    };

    private RenderFragment<(EntitlementSnapshotDto Item, AdminColumnDefinition Column)> HistoryCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "version":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/entitlements/{ctx.Item.Id}");
                b.AddContent(2, ctx.Item.SnapshotVersion);
                b.CloseElement();
                break;
            case "schema":
                b.AddContent(0, ctx.Item.SchemaVersion);
                break;
            case "status":
                b.OpenComponent<ReportStatusBadge>(0);
                b.AddAttribute(1, nameof(ReportStatusBadge.Value), ctx.Item.SubscriptionStatus);
                b.CloseComponent();
                break;
            case "generated":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.GeneratedAtUtc);
                b.CloseComponent();
                break;
        }
    };
}

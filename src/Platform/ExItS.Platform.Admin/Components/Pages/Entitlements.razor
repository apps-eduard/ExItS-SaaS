@page "/admin/entitlements"
@page "/admin/entitlements/{Id:guid}"
@page "/admin/entitlements/history/{OrganizationId:guid}/{ProductCode}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api

@if (Id is not null)
{
    <PageHeader Title="Entitlement snapshot" Breadcrumb="Platform Admin / Entitlements / Detail" Description="Platform-authoritative snapshot state. Not proof of delivery to a product." />
    <section class="warning" role="note">
        This snapshot is authoritative Platform state only. It is not evidence that HealthCare or POS received or applied entitlements. Provisional refresh policy remains open where applicable.
    </section>
    @if (_detail is null) { <LoadingState Message="Loading snapshot…" /> }
    else if (!_detail.IsSuccess) { <ErrorState Title="@(_detail.Error?.Title ?? "Error")" Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" /> }
    else
    {
        var s = _detail.Data!;
        <dl>
            <dt>Organization</dt><dd><a href="/admin/organizations/@s.OrganizationId">@s.OrganizationId</a></dd>
            <dt>Product</dt><dd>@s.ProductCode</dd>
            <dt>Subscription</dt><dd><a href="/admin/subscriptions/@s.SubscriptionId">@s.SubscriptionId</a></dd>
            <dt>Plan</dt><dd>@s.PlanCode v@s.PlanVersionNumber</dd>
            <dt>Snapshot version</dt><dd>@s.SnapshotVersion</dd>
            <dt>Schema version</dt><dd>@s.SchemaVersion</dd>
            <dt>Subscription status</dt><dd><StatusBadge Value="@s.SubscriptionStatus" /></dd>
            <dt>In grace period</dt><dd>@s.InGracePeriod</dd>
            <dt>Generated (UTC)</dt><dd><UtcTimestamp Value="@s.GeneratedAtUtc" /></dd>
            <dt>Effective (UTC)</dt><dd><UtcTimestamp Value="@s.EffectiveAtUtc" /></dd>
            <dt>Refresh by (UTC)</dt><dd><UtcTimestamp Value="@s.RefreshByUtc" /></dd>
            <dt>Expires (UTC)</dt><dd><UtcTimestamp Value="@s.ExpiresAtUtc" /></dd>
            <dt>History</dt><dd><a href="/admin/entitlements/history/@s.OrganizationId/@s.ProductCode">View history</a></dd>
        </dl>

        <h2>Feature grants</h2>
        @if (s.Grants.Count == 0) { <EmptyState Message="No grants on this snapshot." /> }
        else
        {
            <table>
                <thead><tr><th>Feature</th><th>Enabled</th><th>Limit</th><th>Source</th><th>Effective (UTC)</th><th>Expires (UTC)</th></tr></thead>
                <tbody>
                @foreach (var g in s.Grants)
                {
                    <tr>
                        <td>@g.FeatureCode</td>
                        <td>@g.Enabled</td>
                        <td>@(g.NumericLimit?.ToString() ?? "—")</td>
                        <td>@g.Source</td>
                        <td><UtcTimestamp Value="@g.EffectiveAtUtc" /></td>
                        <td><UtcTimestamp Value="@g.ExpiresAtUtc" /></td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h2>Feature override history</h2>
        @if (_overrides is null) { <LoadingState Message="Loading feature overrides…" /> }
        else if (!_overrides.IsSuccess) { <ErrorState Title="@(_overrides.Error?.Title ?? "Overrides unavailable")" Detail="@_overrides.Error?.Detail" /> }
        else if (_overrides.Data!.Items.Count == 0) { <EmptyState Message="No feature overrides for this organization/product." /> }
        else
        {
            <table>
                <thead><tr><th>Feature</th><th>Enabled</th><th>Limit</th><th>Status</th><th>Reason</th><th>Effective from (UTC)</th></tr></thead>
                <tbody>
                @foreach (var o in _overrides.Data.Items)
                {
                    <tr>
                        <td>@o.FeatureCode</td>
                        <td>@o.Enabled</td>
                        <td>@(o.NumericLimit?.ToString() ?? "—")</td>
                        <td><StatusBadge Value="@o.Status" /></td>
                        <td>@o.Reason</td>
                        <td><UtcTimestamp Value="@o.EffectiveFromUtc" /></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
}
else if (OrganizationId is not null && ProductCode is not null)
{
    <PageHeader Title="Entitlement history" Breadcrumb="Platform Admin / Entitlements / History" Description="Immutable snapshot versions for an organization/product pair." />
    @if (_history is null) { <LoadingState Message="Loading history…" /> }
    else if (!_history.IsSuccess) { <ErrorState Title="@(_history.Error?.Title ?? "Error")" Detail="@_history.Error?.Detail" CorrelationId="@_history.Error?.CorrelationId" Unavailable="@(_history.Status == ApiCallStatus.Unavailable)" /> }
    else if (_history.Data!.Items.Count == 0) { <EmptyState Message="No snapshots in history." /> }
    else
    {
        <table>
            <thead><tr><th>Version</th><th>Schema</th><th>Status</th><th>Generated (UTC)</th></tr></thead>
            <tbody>
            @foreach (var x in _history.Data.Items)
            {
                <tr>
                    <td><a href="/admin/entitlements/@x.Id">@x.SnapshotVersion</a></td>
                    <td>@x.SchemaVersion</td>
                    <td><StatusBadge Value="@x.SubscriptionStatus" /></td>
                    <td><UtcTimestamp Value="@x.GeneratedAtUtc" /></td>
                </tr>
            }
            </tbody>
        </table>
    }
}
else
{
    <PageHeader Title="Latest entitlements" Breadcrumb="Platform Admin / Entitlements" Description="Latest snapshot per organization/product. Snapshot ≠ product delivery." />
    <section class="warning" role="note">
        Listed snapshots are Platform state only and do not prove product-local delivery.
    </section>
    @if (_latest is null) { <LoadingState Message="Loading latest entitlements…" /> }
    else if (!_latest.IsSuccess) { <ErrorState Title="@(_latest.Error?.Title ?? "Error")" Detail="@_latest.Error?.Detail" CorrelationId="@_latest.Error?.CorrelationId" Unavailable="@(_latest.Status == ApiCallStatus.Unavailable)" /> }
    else if (_latest.Data!.Items.Count == 0) { <EmptyState Message="No entitlement snapshots exist yet." /> }
    else
    {
        <table>
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Organization</th>
                    <th scope="col">Version</th>
                    <th scope="col">Status</th>
                    <th scope="col">Generated (UTC)</th>
                    <th scope="col">History</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in _latest.Data.Items)
                {
                    <tr>
                        <td>@x.ProductCode</td>
                        <td><a href="/admin/organizations/@x.OrganizationId">@x.OrganizationId</a></td>
                        <td><a href="/admin/entitlements/@x.Id">@x.SnapshotVersion</a></td>
                        <td><StatusBadge Value="@x.SubscriptionStatus" /></td>
                        <td><UtcTimestamp Value="@x.GeneratedAtUtc" /></td>
                        <td><a href="/admin/entitlements/history/@x.OrganizationId/@x.ProductCode">History</a></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted">Showing @_latest.Data.Items.Count of @_latest.Data.TotalCount</p>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public Guid? OrganizationId { get; set; }
    [Parameter] public string? ProductCode { get; set; }

    private ApiCallResult<PagedResult<EntitlementLatestSummaryDto>>? _latest;
    private ApiCallResult<EntitlementSnapshotDto>? _detail;
    private ApiCallResult<PagedResult<EntitlementSnapshotDto>>? _history;
    private ApiCallResult<PagedResult<FeatureOverrideDto>>? _overrides;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is not null)
        {
            _detail = await Api.GetEntitlementAsync(Id.Value);
            if (_detail.IsSuccess && _detail.Data is not null)
            {
                _overrides = await Api.GetFeatureOverridesAsync(_detail.Data.OrganizationId, _detail.Data.ProductCode);
            }
        }
        else if (OrganizationId is not null && ProductCode is not null)
        {
            _history = await Api.GetEntitlementHistoryAsync(OrganizationId.Value, ProductCode);
        }
        else
        {
            _latest = await Api.GetLatestEntitlementsAsync();
        }
    }
}

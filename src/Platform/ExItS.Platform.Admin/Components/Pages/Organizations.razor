@page "/admin/organizations"
@page "/admin/organizations/{Id:guid}"
@rendermode InteractiveServer
@using AntDesign
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

@if (Id is null)
{
    <PageHeader Class="exits-page-header" Title="@L["Organizations_Title"]" SubTitle="@L["Organizations_Description"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_Organizations"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
    </PageHeader>

    @if (_list is { IsSuccess: false })
    {
        <Result Status="@ResultStatus.Error" Title="@(_list.Error?.Title ?? L["Common_Error"])" SubTitle="@_list.Error?.Detail" />
    }
    else
    {
        <Table TItem="OrganizationDto"
               DataSource="@(_list?.Data?.Items ?? Array.Empty<OrganizationDto>())"
               Total="@(_list?.Data?.TotalCount ?? 0)"
               @bind-PageIndex="_page"
               PageSize="@(_list?.Data?.PageSize ?? 20)"
               Loading="@(_list is null)"
               Size="@TableSize.Small"
               Bordered
               RemoteDataSource
               OnPageIndexChange="OnOrgPageChangedAsync"
               ScrollX="900">
            <PropertyColumn Property="c => c.DisplayName" Title="@L["Common_DisplayName"]" Sortable>
                <a href="/admin/organizations/@context.Id">@context.DisplayName</a>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Slug" Title="@L["Common_Slug"]" Sortable />
            <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Sortable>
                <Tag Color="@StatusColor(context.Status)">@context.Status</Tag>
            </PropertyColumn>
            <PropertyColumn Property="c => c.CreatedAtUtc" Title="@L["Common_CreatedUtc"]" Format="u" Sortable />
            <PropertyColumn Property="c => c.UpdatedAtUtc" Title="@L["Common_UpdatedUtc"]" Format="u" Sortable />
            <ActionColumn Title="@L["Common_Open"]" Width="88">
                <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/organizations/{context.Id}")">@L["Common_Open"]</a>
            </ActionColumn>
        </Table>
    }
}
else
{
    <PageHeader Class="exits-page-header" Title="@L["Organizations_DetailTitle"]" SubTitle="@L["Organizations_DetailDescription"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem Href="/admin/organizations">@L["Nav_Organizations"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Common_Detail"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
    </PageHeader>

    @if (_detail is null)
    {
        <div style="padding:2rem;text-align:center;"><Spin Tip="@L["Organizations_DetailLoading"]" /></div>
    }
    else if (!_detail.IsSuccess)
    {
        <Result Status="@ResultStatus.Error" Title="@(_detail.Error?.Title ?? L["Common_Error"])" SubTitle="@_detail.Error?.Detail" />
    }
    else
    {
        var d = _detail.Data!;
        <Descriptions Bordered Size="@DescriptionsSize.Small" Column="2" Style="margin-bottom:12px;">
            <DescriptionsItem Title="@L["Common_DisplayName"]">@d.Organization.DisplayName</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Slug"]">@d.Organization.Slug</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Status"]">
                <Tag Color="@StatusColor(d.Organization.Status)">@d.Organization.Status</Tag>
            </DescriptionsItem>
            <DescriptionsItem Title="@L["Common_CreatedUtc"]"><UtcTimestamp Value="@d.Organization.CreatedAtUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Common_UpdatedUtc"]"><UtcTimestamp Value="@d.Organization.UpdatedAtUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Organizations_CommercialAdmin"]" Span="2">
                <Space Wrap>
                    <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/organizations/{Id}/members")">@L["Common_Members"]</a>
                    <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/organizations/{Id}/product-access")">@L["Common_ProductAccess"]</a>
                    <a class="ant-btn ant-btn-link ant-btn-sm" href="/admin/subscriptions">@L["Organizations_StartTrialSubscriptions"]</a>
                    <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/payments?organizationId={Id}")">@L["Organizations_CreateViewPayments"]</a>
                </Space>
            </DescriptionsItem>
        </Descriptions>

        <Title Level="5">@L["Organizations_SubscriptionsByProduct"]</Title>
        <Paragraph Type="@TextElementType.Secondary">@L["Organizations_SubscriptionsHint"]</Paragraph>
        @if (d.Subscriptions.Count == 0)
        {
            <Empty Description="@L["Organizations_SubscriptionsEmpty"].Value" />
        }
        else
        {
            <Table TItem="SubscriptionDto" DataSource="d.Subscriptions" Size="@TableSize.Small" HidePagination Bordered Style="margin-bottom:12px;">
                <PropertyColumn Property="c => c.ProductCode" Title="@L["Common_Product"]" />
                <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]">
                    <Tag Color="@StatusColor(context.Status)">@context.Status</Tag>
                </PropertyColumn>
                <ActionColumn Title="@L["Common_Detail"]">
                    <a href="/admin/subscriptions/@context.Id">@L["Organizations_OpenSubscription"]</a>
                </ActionColumn>
            </Table>
        }

        <Title Level="5">@L["Organizations_PaymentHistory"]</Title>
        @if (d.Payments.Count == 0)
        {
            <Empty Description="@L["Organizations_PaymentsEmpty"].Value" />
        }
        else
        {
            <Table TItem="PaymentDto" DataSource="d.Payments" Size="@TableSize.Small" HidePagination Bordered Style="margin-bottom:12px;">
                <PropertyColumn Property="c => c.ExternalReference" Title="@L["Common_Reference"]" />
                <PropertyColumn Property="c => c.Amount" Title="@L["Common_Amount"]">
                    <AmountDisplay Amount="@((decimal?)context.Amount)" CurrencyCode="@context.CurrencyCode" />
                </PropertyColumn>
                <PropertyColumn Property="c => c.Method" Title="@L["Common_Method"]" />
                <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]">
                    <Tag Color="@StatusColor(context.Status)">@context.Status</Tag>
                </PropertyColumn>
                <ActionColumn Title="@L["Common_Detail"]">
                    <a href="/admin/payments/@context.Id">@L["Organizations_OpenPayment"]</a>
                </ActionColumn>
            </Table>
        }

        <Title Level="5">@L["Organizations_LatestEntitlements"]</Title>
        @if (d.LatestEntitlements.Count == 0)
        {
            <Empty Description="@L["Organizations_EntitlementsEmpty"].Value" />
        }
        else
        {
            <Table TItem="EntitlementLatestSummaryDto" DataSource="d.LatestEntitlements" Size="@TableSize.Small" HidePagination Bordered>
                <PropertyColumn Property="c => c.ProductCode" Title="@L["Common_Product"]" />
                <PropertyColumn Property="c => c.SnapshotVersion" Title="@L["Common_Version"]">
                    <a href="/admin/entitlements/@context.Id">@context.SnapshotVersion</a>
                </PropertyColumn>
                <PropertyColumn Property="c => c.SubscriptionStatus" Title="@L["Common_Status"]">
                    <Tag Color="@StatusColor(context.SubscriptionStatus)">@context.SubscriptionStatus</Tag>
                </PropertyColumn>
                <PropertyColumn Property="c => c.GeneratedAtUtc" Title="@L["Common_GeneratedUtc"]" Format="u" />
                <ActionColumn Title="@L["Common_History"]">
                    <a href="/admin/entitlements/history/@context.OrganizationId/@context.ProductCode">@L["Common_History"]</a>
                </ActionColumn>
            </Table>
        }
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private ApiCallResult<PagedResult<OrganizationDto>>? _list;
    private ApiCallResult<OrganizationCommercialSummaryDto>? _detail;
    private int _page = 1;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null) await LoadOrgsAsync();
        else _detail = await Api.GetOrganizationCommercialSummaryAsync(Id.Value);
    }

    private async Task LoadOrgsAsync() => _list = await Api.GetOrganizationsAsync(page: _page);

    private async Task OnOrgPageChangedAsync(PaginationEventArgs args)
    {
        _page = args.Page;
        await LoadOrgsAsync();
    }

    private static string StatusColor(string status) => status switch
    {
        "Active" => "success",
        "Trialing" => "processing",
        "Suspended" or "PastDue" or "GracePeriod" => "warning",
        "Cancelled" or "Expired" or "Deactivated" => "default",
        _ => "processing"
    };
}

@page "/admin/organizations"
@page "/admin/organizations/{Id:guid}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

@if (Id is null)
{
    <PageHeader Title="@L["Organizations_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Organizations"]}")" Description="@L["Organizations_Description"]" />
    @if (_list is null) { <LoadingState Message="@L["Organizations_Loading"]" /> }
    else if (!_list.IsSuccess) { <ErrorState Title="@(_list.Error?.Title ?? L["Common_Error"])" Detail="@_list.Error?.Detail" CorrelationId="@_list.Error?.CorrelationId" Unavailable="@(_list.Status == ApiCallStatus.Unavailable)" /> }
    else if (_list.Data!.Items.Count == 0) { <EmptyState Message="@L["Organizations_Empty"]" /> }
    else
    {
    <table class="data-table responsive-table">
        <caption class="sr-only">@L["Organizations_Title"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Common_DisplayName"]</th>
                    <th scope="col">@L["Common_Slug"]</th>
                    <th scope="col">@L["Common_Status"]</th>
                    <th scope="col">@L["Common_CreatedUtc"]</th>
                    <th scope="col">@L["Common_UpdatedUtc"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _list.Data.Items)
                {
                    <tr>
                        <td data-label="@L["Common_DisplayName"]"><a href="/admin/organizations/@item.Id">@item.DisplayName</a></td>
                        <td data-label="@L["Common_Slug"]">@item.Slug</td>
                        <td data-label="@L["Common_Status"]"><StatusBadge Value="@item.Status" /></td>
                        <td data-label="@L["Common_CreatedUtc"]"><UtcTimestamp Value="@item.CreatedAtUtc" /></td>
                        <td data-label="@L["Common_UpdatedUtc"]"><UtcTimestamp Value="@item.UpdatedAtUtc" /></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted">@string.Format(L["Common_ShowingCount"], _list.Data.Items.Count, _list.Data.TotalCount)</p>
    }
}
else
{
    <PageHeader Title="@L["Organizations_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Organizations"]} / {L["Common_Detail"]}")" Description="@L["Organizations_DetailDescription"]" />
    @if (_detail is null) { <LoadingState Message="@L["Organizations_DetailLoading"]" /> }
    else if (!_detail.IsSuccess) { <ErrorState Title="@(_detail.Error?.Title ?? L["Common_Error"])" Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" /> }
    else
    {
        var d = _detail.Data!;
        <dl>
            <dt>@L["Common_DisplayName"]</dt><dd>@d.Organization.DisplayName</dd>
            <dt>@L["Common_Slug"]</dt><dd>@d.Organization.Slug</dd>
            <dt>@L["Common_Status"]</dt><dd><StatusBadge Value="@d.Organization.Status" /></dd>
            <dt>@L["Common_CreatedUtc"]</dt><dd><UtcTimestamp Value="@d.Organization.CreatedAtUtc" /></dd>
            <dt>@L["Common_UpdatedUtc"]</dt><dd><UtcTimestamp Value="@d.Organization.UpdatedAtUtc" /></dd>
            <dt>@L["Organizations_CommercialAdmin"]</dt>
            <dd>
                <a href="/admin/organizations/@Id/members">@L["Common_Members"]</a>
                ·
                <a href="/admin/organizations/@Id/product-access">@L["Common_ProductAccess"]</a>
                ·
                <a href="/admin/subscriptions">@L["Organizations_StartTrialSubscriptions"]</a>
                ·
                <a href="/admin/payments?organizationId=@Id">@L["Organizations_CreateViewPayments"]</a>
            </dd>
        </dl>

        <h2>@L["Organizations_SubscriptionsByProduct"]</h2>
        <p class="muted">@L["Organizations_SubscriptionsHint"]</p>
        @if (d.Subscriptions.Count == 0) { <EmptyState Message="@L["Organizations_SubscriptionsEmpty"]" /> }
        else
        {
            <table class="data-table">
                <thead><tr><th>@L["Common_Product"]</th><th>@L["Common_Status"]</th><th>@L["Common_Detail"]</th></tr></thead>
                <tbody>
                @foreach (var group in d.Subscriptions.GroupBy(s => s.ProductCode))
                {
                    @foreach (var s in group)
                    {
                        <tr>
                            <td>@s.ProductCode</td>
                            <td><StatusBadge Value="@s.Status" /></td>
                            <td><a href="/admin/subscriptions/@s.Id">@L["Organizations_OpenSubscription"]</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        }

        <h2>@L["Organizations_PaymentHistory"]</h2>
        @if (d.Payments.Count == 0) { <EmptyState Message="@L["Organizations_PaymentsEmpty"]" /> }
        else
        {
            <table class="data-table">
                <thead><tr><th>@L["Common_Reference"]</th><th>@L["Common_Amount"]</th><th>@L["Common_Method"]</th><th>@L["Common_Status"]</th><th>@L["Common_Detail"]</th></tr></thead>
                <tbody>
                @foreach (var p in d.Payments)
                {
                    <tr>
                        <td>@p.ExternalReference</td>
                        <td>@p.Amount @p.CurrencyCode</td>
                        <td>@p.Method</td>
                        <td><StatusBadge Value="@p.Status" /></td>
                        <td><a href="/admin/payments/@p.Id">@L["Organizations_OpenPayment"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h2>@L["Organizations_LatestEntitlements"]</h2>
        @if (d.LatestEntitlements.Count == 0) { <EmptyState Message="@L["Organizations_EntitlementsEmpty"]" /> }
        else
        {
            <table class="data-table">
                <thead><tr><th>@L["Common_Product"]</th><th>@L["Common_Version"]</th><th>@L["Common_Status"]</th><th>@L["Common_GeneratedUtc"]</th><th>@L["Common_History"]</th></tr></thead>
                <tbody>
                @foreach (var e in d.LatestEntitlements)
                {
                    <tr>
                        <td>@e.ProductCode</td>
                        <td><a href="/admin/entitlements/@e.Id">@e.SnapshotVersion</a></td>
                        <td><StatusBadge Value="@e.SubscriptionStatus" /></td>
                        <td><UtcTimestamp Value="@e.GeneratedAtUtc" /></td>
                        <td><a href="/admin/entitlements/history/@e.OrganizationId/@e.ProductCode">@L["Common_History"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private ApiCallResult<PagedResult<OrganizationDto>>? _list;
    private ApiCallResult<OrganizationCommercialSummaryDto>? _detail;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null) _list = await Api.GetOrganizationsAsync();
        else _detail = await Api.GetOrganizationCommercialSummaryAsync(Id.Value);
    }
}

@page "/admin/global-catalog/imports"
@page "/admin/global-catalog/imports/{Id:guid}"
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@implements IDisposable
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject PlatformPermissionState Permissions
@using ExItS.Platform.Admin.Services
@inject IJSRuntime Js

@if (!Permissions.Loaded)
{
    <Spin />
}
else if (!CanImport)
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ImportGlobalProducts" />
}
else if (Id is null)
{
    <PageHeader Class="exits-page-header" Title="@L["GlobalImports_Title"]" SubTitle="@L["GlobalImports_Description"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_ProductCatalog"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_GlobalImports"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
    </PageHeader>

    <Card Size="@CardSize.Small" Title="@L["GlobalImports_UploadSection"]" Style="margin-bottom:12px;">
        <FormValidationSummary Title="@L["GlobalImports_UploadFailed"]" Message="@_uploadError" IsConflict="false" />
        <Space Direction="SpaceDirection.Vertical" Style="width:100%; max-width:720px;">
            <Alert Type="@AlertType.Info" ShowIcon="true" Message="@L["GlobalImports_TemplateInstructions"]" />
            <Space>
                <Button Size="@ButtonSize.Small" Loading="_downloadBusy" OnClick="DownloadTemplateAsync">
                    @L["GlobalImports_DownloadTemplate"]
                </Button>
            </Space>
            <InputFile OnChange="OnFileSelected" accept=".csv,.xlsx" disabled="@_busy" />
            @if (!string.IsNullOrWhiteSpace(_selectedFileName))
            {
                <span>@_selectedFileName</span>
            }
            <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" Loading="_busy" Disabled="@(_selectedFile is null)" OnClick="UploadAsync">
                @L["GlobalImports_Upload"]
            </Button>
        </Space>
    </Card>

    <Table TItem="CatalogImportJobDto"
           DataSource="_jobs"
           Loading="_loading"
           Size="@TableSize.Small"
           Bordered
           Resizable
           ScrollX="1200"
           HidePagination="true">
        <PropertyColumn Property="c => c.FileName" Title="@L["GlobalImports_FileName"]" Sortable>
            <a href="/admin/global-catalog/imports/@context.Id">@context.FileName</a>
        </PropertyColumn>
        <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Sortable Width="120" />
        <PropertyColumn Property="c => c.TotalCount" Title="@L["GlobalImports_Total"]" Sortable Width="90" />
        <PropertyColumn Property="c => c.ImportedCount" Title="@L["GlobalImports_Imported"]" Sortable Width="100" />
        <PropertyColumn Property="c => c.SkippedCount" Title="@L["GlobalImports_Skipped"]" Sortable Width="100" />
        <PropertyColumn Property="c => c.FailedCount" Title="@L["GlobalImports_Failed"]" Sortable Width="90" />
        <PropertyColumn Property="c => c.CreatedAtUtc" Title="@L["Common_CreatedUtc"]" Sortable Width="180" Format="u" />
        <ActionColumn Title="@L["Common_Actions"]" Width="90">
            <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/global-catalog/imports/{context.Id}")">@L["Common_Open"]</a>
        </ActionColumn>
    </Table>
}
else
{
    <PageHeader Class="exits-page-header" Title="@(_job?.FileName ?? L["GlobalImports_Title"])" SubTitle="@L["GlobalImports_DetailSubtitle"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_ProductCatalog"]</BreadcrumbItem>
                <BreadcrumbItem Href="/admin/global-catalog/imports">@L["Nav_GlobalImports"]</BreadcrumbItem>
                <BreadcrumbItem>@(_job?.FileName ?? Id?.ToString("D"))</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            <Button Size="@ButtonSize.Small" Loading="_downloadBusy" OnClick="DownloadTemplateAsync">
                @L["GlobalImports_DownloadTemplate"]
            </Button>
            <Button Size="@ButtonSize.Small" OnClick="RefreshDetailAsync" Loading="_busy">@L["Common_Retry"]</Button>
            @if (_job?.Status == "Validated")
            {
                <Button Size="@ButtonSize.Small"
                        Type="@ButtonType.Primary"
                        Loading="_busy"
                        Disabled="@ConfirmDisabled"
                        OnClick="ConfirmAsync">
                    @L["GlobalImports_Confirm"]
                </Button>
            }
        </PageHeaderExtra>
    </PageHeader>

    @if (_job is null)
    {
        <Spin />
    }
    else
    {
        <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
            <Descriptions Bordered Size="@DescriptionsSize.Small" Column="2">
                <DescriptionsItem Title="@L["Common_Status"]">@_job.Status</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_Stage"]">@(_job.CurrentStage ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_Total"]">@_job.TotalCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_ValidProducts"]">@_job.ValidProductCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_ExistingCategories"]">@_job.ExistingCategoriesReferencedCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_NewCategories"]">@_job.NewCategoriesToCreateCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_Processed"]">@_job.ProcessedCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_Imported"]">@_job.ImportedCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_Skipped"]">@_job.SkippedCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_Failed"]">@_job.FailedCount</DescriptionsItem>
                <DescriptionsItem Title="@L["GlobalImports_Pending"]">@_job.PendingCount</DescriptionsItem>
            </Descriptions>

            @if (!string.IsNullOrWhiteSpace(_job.PreviewSummary))
            {
                <Alert Type="@AlertType.Info" ShowIcon="true" Message="@_job.PreviewSummary" />
            }

            @if (_job.Status == "Validated")
            {
                <Card Size="@CardSize.Small" Title="@L["GlobalImports_Destination"]" Style="max-width:720px;">
                    <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                        <RadioGroup TValue="string" @bind-Value="_destinationMode" Disabled="_busy">
                            <Radio Value="@DestinationGlobalOnly">@L["GlobalImports_GlobalOnly"]</Radio>
                            <Radio Value="@DestinationGlobalPlusTemplate">@L["GlobalImports_GlobalPlusTemplate"]</Radio>
                        </RadioGroup>

                        @if (LinkToTemplate)
                        {
                            <div>
                                <div style="margin-bottom:4px;">@L["GlobalImports_Template"]</div>
                                <Select TItemValue="string"
                                        TItem="string"
                                        @bind-Value="_selectedTemplateId"
                                        Size="@InputSize.Small"
                                        Style="width:100%; max-width:480px;"
                                        Placeholder="@L["GlobalImports_Template"]"
                                        AllowClear
                                        Disabled="_busy"
                                        Loading="_templatesLoading">
                                    <SelectOptions>
                                        @foreach (var template in _templates)
                                        {
                                            <SelectOption TItemValue="string"
                                                          TItem="string"
                                                          Value="@template.Id.ToString("D")"
                                                          Label="@($"{template.Name} ({template.ProductCount})")" />
                                        }
                                    </SelectOptions>
                                </Select>
                            </div>
                        }

                        <Card Size="@CardSize.Small" Title="@L["GlobalImports_ConfirmPreview"]">
                            <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1">
                                <DescriptionsItem Title="@L["GlobalImports_ValidProducts"]">@_job.ValidProductCount</DescriptionsItem>
                                <DescriptionsItem Title="@L["GlobalImports_Failed"]">@_job.FailedCount</DescriptionsItem>
                                <DescriptionsItem Title="@L["GlobalImports_Skipped"]">@_job.SkippedCount</DescriptionsItem>
                                @if (LinkToTemplate)
                                {
                                    <DescriptionsItem Title="@L["GlobalImports_Template"]">@(SelectedTemplateName ?? "—")</DescriptionsItem>
                                    <DescriptionsItem Title="@L["GlobalImports_EstimatedToAdd"]">@EstimatedProductsToAdd</DescriptionsItem>
                                    <DescriptionsItem Title="@L["GlobalImports_AlreadyInTemplate"]">@ProductsAlreadyInTemplate</DescriptionsItem>
                                }
                            </Descriptions>
                        </Card>

                        <Button Type="@ButtonType.Primary"
                                Size="@ButtonSize.Small"
                                Loading="_busy"
                                Disabled="@ConfirmDisabled"
                                OnClick="ConfirmAsync">
                            @L["GlobalImports_Confirm"]
                        </Button>
                    </Space>
                </Card>
            }

            @if (_job.Status is "Queued" or "Processing")
            {
                <Progress Percent="@ProgressPercent" />
                <div>@L["GlobalImports_Polling"]</div>
            }

            @if (!string.IsNullOrWhiteSpace(_job.ErrorSummary))
            {
                <Alert Type="@AlertType.Warning" ShowIcon="true" Message="@_job.ErrorSummary" />
            }

            <Card Size="@CardSize.Small" Title="@L["GlobalImports_Preview"]">
                <Table TItem="CatalogImportItemDto"
                       DataSource="@(_job.PreviewItems ?? Array.Empty<CatalogImportItemDto>())"
                       Size="@TableSize.Small"
                       Bordered
                       Resizable
                       ScrollX="1280"
                       HidePagination="true">
                    <PropertyColumn Property="c => c.RowNumber" Title="#" Sortable Width="60" />
                    <PropertyColumn Property="c => c.Name" Title="@L["Common_Name"]" Sortable />
                    <PropertyColumn Property="c => c.CategoryName" Title="@L["GlobalProducts_Category"]" Sortable Width="140" />
                    <PropertyColumn Property="c => c.Sku" Title="@L["GlobalProducts_Sku"]" Sortable Width="120" />
                    <PropertyColumn Property="c => c.Barcode" Title="@L["GlobalProducts_Barcode"]" Sortable Width="140" />
                    <PropertyColumn Property="c => c.CostPrice" Title="@L["GlobalProducts_CostPrice"]" Sortable Width="110">
                        @AdminCurrency.FormatPhp(context.CostPrice)
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.SellingPrice" Title="@L["GlobalProducts_SellingPrice"]" Sortable Width="110">
                        @AdminCurrency.FormatPhp(context.SellingPrice)
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Unit" Title="@L["GlobalProducts_Unit"]" Sortable Width="90" />
                    <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Sortable Width="120" />
                    <PropertyColumn Property="c => c.ErrorMessage" Title="@L["GlobalImports_Notes"]" Sortable />
                </Table>
            </Card>

            @if (_job.FailedCount + _job.SkippedCount > 0)
            {
                <Card Size="@CardSize.Small" Title="@L["GlobalImports_Errors"]">
                    <Button Size="@ButtonSize.Small" OnClick="LoadErrorsAsync" Loading="_busy" Style="margin-bottom:8px;">
                        @L["GlobalImports_LoadErrors"]
                    </Button>
                    <Table TItem="CatalogImportErrorDto"
                           DataSource="_errors"
                           Size="@TableSize.Small"
                           Bordered
                           Resizable
                           ScrollX="960"
                           HidePagination="true">
                        <PropertyColumn Property="c => c.RowNumber" Title="#" Sortable Width="60" />
                        <PropertyColumn Property="c => c.Name" Title="@L["Common_Name"]" Sortable />
                        <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Sortable Width="120" />
                        <PropertyColumn Property="c => c.ErrorCode" Title="@L["GlobalImports_ErrorCode"]" Sortable Width="180" />
                        <PropertyColumn Property="c => c.ErrorMessage" Title="@L["GlobalImports_Error"]" Sortable />
                    </Table>
                </Card>
            }
        </Space>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private const string DestinationGlobalOnly = "global";
    private const string DestinationGlobalPlusTemplate = "template";
    private const string TemplateFileName = "exits-global-product-import-template.csv";

    private bool CanImport => Permissions.HasPermission(PlatformPermissionCodes.ImportGlobalProducts);
    private bool _loading;
    private bool _busy;
    private bool _downloadBusy;
    private bool _templatesLoading;
    private string? _uploadError;
    private string? _selectedFileName;
    private IBrowserFile? _selectedFile;
    private IReadOnlyList<CatalogImportJobDto> _jobs = [];
    private CatalogImportJobDto? _job;
    private IReadOnlyList<CatalogImportErrorDto> _errors = [];
    private IReadOnlyList<CatalogTemplateSummaryDto> _templates = [];
    private string _destinationMode = DestinationGlobalOnly;
    private string? _selectedTemplateId;
    private CancellationTokenSource? _pollCts;

    private bool LinkToTemplate => _destinationMode == DestinationGlobalPlusTemplate;

    private bool ConfirmDisabled =>
        _busy || (LinkToTemplate && string.IsNullOrWhiteSpace(_selectedTemplateId));

    private CatalogTemplateSummaryDto? SelectedTemplate =>
        Guid.TryParse(_selectedTemplateId, out var id)
            ? _templates.FirstOrDefault(t => t.Id == id)
            : null;

    private string? SelectedTemplateName =>
        SelectedTemplate?.Name
        ?? _job?.TargetTemplateName;

    private int EstimatedProductsToAdd =>
        _job is null
            ? 0
            : (_job.EstimatedTemplateLinks
               ?? (_job.ValidProductCount > 0 ? _job.ValidProductCount : _job.PendingCount));

    private int ProductsAlreadyInTemplate =>
        _job?.ProductsAlreadyInTemplate
        ?? _job?.TargetTemplateProductCount
        ?? SelectedTemplate?.ProductCount
        ?? 0;

    private int ProgressPercent =>
        _job is null || _job.TotalCount <= 0
            ? 0
            : Math.Clamp((int)Math.Round(100.0 * _job.ProcessedCount / _job.TotalCount), 0, 100);

    protected override async Task OnParametersSetAsync()
    {
        StopPolling();
        if (!Permissions.Loaded || !CanImport)
        {
            return;
        }

        if (Id is null)
        {
            _destinationMode = DestinationGlobalOnly;
            _selectedTemplateId = null;
            await LoadListAsync();
        }
        else
        {
            await RefreshDetailAsync();
            if (_job?.Status == "Validated")
            {
                await EnsureTemplatesLoadedAsync();
            }

            MaybeStartPolling();
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.FileCount > 0 ? e.File : null;
        _selectedFileName = _selectedFile?.Name;
        _uploadError = null;
    }

    private async Task DownloadTemplateAsync()
    {
        _downloadBusy = true;
        try
        {
            var result = await Api.DownloadCatalogImportTemplateAsync();
            if (!result.IsSuccess || result.Data is null || result.Data.Length == 0)
            {
                await Message.ErrorAsync(result.Error?.Message ?? L["GlobalImports_DownloadTemplateFailed"].Value);
                return;
            }

            var base64 = Convert.ToBase64String(result.Data);
            await Js.InvokeVoidAsync("exitsDownloadBase64", TemplateFileName, base64, "text/csv;charset=utf-8");
            await Message.SuccessAsync(L["GlobalImports_DownloadTemplateSucceeded"].Value);
        }
        finally
        {
            _downloadBusy = false;
        }
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _busy = true;
        _uploadError = null;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var idempotencyKey = Guid.NewGuid().ToString("N");
            var result = await Api.UploadCatalogImportAsync(
                stream,
                _selectedFile.Name,
                _selectedFile.ContentType,
                idempotencyKey);
            if (!result.IsSuccess || result.Data is null)
            {
                _uploadError = result.Error?.Message ?? L["GlobalImports_UploadFailed"];
                return;
            }

            await Message.SuccessAsync(L["GlobalImports_UploadSucceeded"].Value);
            Nav.NavigateTo($"/admin/global-catalog/imports/{result.Data.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadListAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.GetCatalogImportsAsync();
            _jobs = result.Data?.Items ?? [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshDetailAsync()
    {
        if (Id is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.GetCatalogImportAsync(Id.Value);
            _job = result.Data;
            if (_job?.TargetTemplateId is Guid templateId)
            {
                _destinationMode = DestinationGlobalPlusTemplate;
                _selectedTemplateId = templateId.ToString("D");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EnsureTemplatesLoadedAsync()
    {
        if (_templates.Count > 0 || _templatesLoading)
        {
            return;
        }

        _templatesLoading = true;
        try
        {
            var result = await Api.GetCatalogTemplatesAsync(page: 1, pageSize: 200);
            _templates = result.Data?.Items ?? [];
        }
        finally
        {
            _templatesLoading = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (Id is null || ConfirmDisabled)
        {
            return;
        }

        Guid? targetTemplateId = null;
        if (LinkToTemplate)
        {
            if (!Guid.TryParse(_selectedTemplateId, out var parsed))
            {
                return;
            }

            targetTemplateId = parsed;
        }

        _busy = true;
        try
        {
            var result = await Api.ConfirmCatalogImportAsync(Id.Value, targetTemplateId);
            if (!result.IsSuccess || result.Data is null)
            {
                await Message.ErrorAsync(result.Error?.Message ?? L["GlobalImports_ConfirmFailed"].Value);
                return;
            }

            _job = result.Data;
            await Message.SuccessAsync(L["GlobalImports_ConfirmSucceeded"].Value);
            MaybeStartPolling();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadErrorsAsync()
    {
        if (Id is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.GetCatalogImportErrorsAsync(Id.Value);
            _errors = result.Data?.Items ?? [];
        }
        finally
        {
            _busy = false;
        }
    }

    private void MaybeStartPolling()
    {
        if (_job?.Status is not ("Queued" or "Processing"))
        {
            return;
        }

        StopPolling();
        _pollCts = new CancellationTokenSource();
        _ = PollProgressAsync(_pollCts.Token);
    }

    private async Task PollProgressAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(2000, ct);
                await RefreshDetailAsync();
                await InvokeAsync(StateHasChanged);
                if (_job?.Status is not ("Queued" or "Processing"))
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // expected on dispose / navigation
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
    }

    public void Dispose() => StopPolling();
}

@page "/admin/payments"
@page "/admin/payments/{Id:guid}"
@using AntDesign
@using AntDesign.TableModels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject NavigationManager Nav
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject PlatformPermissionState Permissions

@if (!Permissions.Loaded)
{
    <LoadingState />
}
else if (!Permissions.HasPermission(PlatformPermissionCodes.ManageManualPayments))
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ManageManualPayments" />
}
else if (Id is null)
{
    <PageHeader Class="exits-page-header" Title="Payments" SubTitle="Review and manage manual SaaS subscription payments.">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_Payments"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            <Button Type="@ButtonType.Primary" Icon="plus" OnClick="OpenCreateDrawer">Record Payment</Button>
        </PageHeaderExtra>
    </PageHeader>

    <Alert Type="@AlertType.Warning"
           ShowIcon="true"
           Class="admin-payments-alert"
           Style="margin-bottom:24px;"
           Message="Manual attestation and provider-linked Online payments."
           Description="Successful PayNow / renewals / upgrades appear here as Confirmed Online payments linked to a subscription. Manual Cash / Bank Transfer / GCash rows still require staff confirmation. This workspace never shows card numbers, CVV, PIN, OTP, gateway secrets, or GCash credentials." />

    <Row Gutter="(16, 16)" Style="margin-bottom:24px;">
        <AntDesign.Col Xs="24" Sm="12" Lg="8">
            <div role="button"
                 tabindex="0"
                 style="@SummaryCardStyle("PendingConfirmation")"
                 @onclick="@(() => FilterByStatusAsync("PendingConfirmation"))"
                 @onkeydown="@(e => OnSummaryKeyAsync(e, "PendingConfirmation"))">
                <Card Class="admin-elevated-card" Size="@CardSize.Small">
                    <Statistic Title="Pending Confirmation" Value="@_summaryPending" />
                </Card>
            </div>
        </AntDesign.Col>
        <AntDesign.Col Xs="24" Sm="12" Lg="8">
            <div role="button"
                 tabindex="0"
                 style="@SummaryCardStyle("Confirmed")"
                 @onclick="@(() => FilterByStatusAsync("Confirmed"))"
                 @onkeydown="@(e => OnSummaryKeyAsync(e, "Confirmed"))">
                <Card Class="admin-elevated-card" Size="@CardSize.Small">
                    <Statistic Title="Confirmed" Value="@_summaryConfirmed" />
                </Card>
            </div>
        </AntDesign.Col>
        <AntDesign.Col Xs="24" Sm="12" Lg="8">
            <div role="button"
                 tabindex="0"
                 style="@SummaryCardStyle("Rejected")"
                 @onclick="@(() => FilterByStatusAsync("Rejected"))"
                 @onkeydown="@(e => OnSummaryKeyAsync(e, "Rejected"))">
                <Card Class="admin-elevated-card" Size="@CardSize.Small">
                    <Statistic Title="Rejected / Voided" Value="@_summaryRejectedOrVoided" />
                </Card>
            </div>
        </AntDesign.Col>
    </Row>
    <Paragraph Class="muted" Style="margin:-8px 0 16px;">
        Summary totals are unfiltered. Click a card to show that status in the list below.
    </Paragraph>

    <Card Class="admin-elevated-card" Title="Payment records" Style="margin-bottom:24px;">
        <Space Wrap Style="width:100%;margin-bottom:12px;" Size="@("small")">
            <Input @bind-Value="_search"
                   Size="@InputSize.Small"
                   Placeholder="Search reference or product"
                   Style="width:220px;"
                   AllowClear
                   OnPressEnter="ApplyFiltersAsync" />
            <Button Size="@ButtonSize.Small" Type="@(_quickRange == ReportQuickRange.Today ? ButtonType.Primary : ButtonType.Default)"
                    OnClick="@(() => OnQuickRangeAsync(ReportQuickRange.Today))">Today</Button>
            <Button Size="@ButtonSize.Small" Type="@(_quickRange == ReportQuickRange.Last7Days ? ButtonType.Primary : ButtonType.Default)"
                    OnClick="@(() => OnQuickRangeAsync(ReportQuickRange.Last7Days))">7 days</Button>
            <Button Size="@ButtonSize.Small" Type="@(_quickRange == ReportQuickRange.Last30Days ? ButtonType.Primary : ButtonType.Default)"
                    OnClick="@(() => OnQuickRangeAsync(ReportQuickRange.Last30Days))">30 days</Button>
            <Button Size="@ButtonSize.Small" Type="@(_quickRange == ReportQuickRange.ThisMonth ? ButtonType.Primary : ButtonType.Default)"
                    OnClick="@(() => OnQuickRangeAsync(ReportQuickRange.ThisMonth))">This month</Button>
            <Select TItemValue="string"
                    TItem="string"
                    Value="@_status"
                    ValueChanged="OnStatusChangedAsync"
                    Size="@InputSize.Small"
                    Style="width:170px;"
                    Placeholder="Status">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("Confirmed")" Label="Confirmed" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("PendingConfirmation")" Label="Pending Confirmation" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Rejected")" Label="Rejected" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Voided")" Label="Voided" />
                </SelectOptions>
            </Select>
            <Select TItemValue="string" TItem="string" @bind-Value="_productCode" Size="@InputSize.Small" Style="width:180px;" Placeholder="Product" AllowClear>
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="All products" />
                    @foreach (var product in _productOptions)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@product.Code"
                                      Label="@(string.IsNullOrWhiteSpace(product.DisplayName) ? product.Code : product.DisplayName)" />
                    }
                </SelectOptions>
            </Select>
            <Select TItemValue="string" TItem="string" @bind-Value="_organizationIdText" Size="@InputSize.Small" Style="width:200px;" Placeholder="Organization" AllowClear>
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="All organizations" />
                    @foreach (var org in _organizationOptions)
                    {
                        <SelectOption TItemValue="string" TItem="string" Value="@org.Id.ToString("D")" Label="@org.DisplayName" />
                    }
                </SelectOptions>
            </Select>
            <Button Size="@ButtonSize.Small" OnClick="ClearFiltersAsync" Disabled="_listBusy">Reset</Button>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ApplyFiltersAsync" Loading="_listBusy">Refresh</Button>
        </Space>

        <Space Wrap Style="width:100%;margin-bottom:16px;" Size="@("small")">
            <span class="muted">From</span>
            <DatePicker TValue="DateTime?" @bind-Value="_fromDateTime" Size="@InputSize.Small" Style="width:140px;" />
            <span class="muted">To</span>
            <DatePicker TValue="DateTime?" @bind-Value="_toDateTime" Size="@InputSize.Small" Style="width:140px;" />
            @if (!string.IsNullOrWhiteSpace(_fromError) || !string.IsNullOrWhiteSpace(_toError))
            {
                <span style="color:#ff4d4f;font-size:12px;">@(_toError ?? _fromError)</span>
            }
        </Space>

        @if (_list is { IsSuccess: false })
        {
            <Result Status="@ResultStatus.Error" Title="@(_list.Error?.Title ?? L["Common_Error"])" SubTitle="@_list.Error?.Detail" />
        }
        else if (_list is null)
        {
            <div style="padding:2rem;text-align:center;"><Spin Tip="@L["Payments_Loading"]" /></div>
        }
        else if (VisiblePayments.Count is 0)
        {
            <Empty Description="@EmptyFilterMessage" />
        }
        else
        {
            <Table TItem="PaymentDto"
                   Class="exits-table-fit"
                   DataSource="@VisiblePayments"
                   Total="@(_list?.Data?.TotalCount ?? 0)"
                   @bind-PageIndex="_page"
                   PageSize="@(_list?.Data?.PageSize ?? 20)"
                   Loading="_listBusy"
                   Size="@TableSize.Small"
                   Bordered
                   RemoteDataSource
                   OnChange="OnPaymentsTableChangeAsync"
                   ScrollX="1280">
                <PropertyColumn Property="c => c.OrganizationId" Title="@L["Common_Organization"]">
                    <a href="@($"/admin/organizations/{context.OrganizationId:D}")">@OrgLabel(context.OrganizationId)</a>
                </PropertyColumn>
                <PropertyColumn Property="c => c.ProductCode" Title="@L["Common_Product"]" Width="140">
                    @ProductLabel(context.ProductCode)
                </PropertyColumn>
                <PropertyColumn Property="c => c.Amount" Title="@L["Common_Amount"]" Align="ColumnAlign.Right" Width="120">
                    <AdminMoneyDisplay Amount="@context.Amount" CurrencyCode="@context.CurrencyCode" />
                </PropertyColumn>
                <PropertyColumn Property="c => c.Method" Title="@L["Common_Method"]" Width="110" />
                <PropertyColumn Property="c => c.ExternalReference" Title="@L["Common_Reference"]" Ellipsis Width="160">
                    <Tooltip Title="@(context.ExternalReference ?? "")">
                        <a href="@($"/admin/payments/{context.Id:D}")">@(string.IsNullOrWhiteSpace(context.ExternalReference) ? "View" : context.ExternalReference)</a>
                    </Tooltip>
                </PropertyColumn>
                <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Width="140">
                    <AdminStatusTag Value="@context.Status" />
                </PropertyColumn>
                <PropertyColumn Property="c => c.PaidAtUtc" Title="Paid Date" Width="180">
                    <LocalTimestamp Value="@context.PaidAtUtc" />
                </PropertyColumn>
                <PropertyColumn Property="c => c.ConfirmedBy" Title="Recorded By" Width="140">
                    @DisplayOrDash(context.ConfirmedBy)
                </PropertyColumn>
                <ActionColumn Title="@L["Common_Actions"]" Width="90">
                    <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="@(() => Nav.NavigateTo($"/admin/payments/{context.Id:D}"))">
                        Details
                    </Button>
                </ActionColumn>
            </Table>
        }
    </Card>

    <Drawer Visible="@_createOpen"
            Title="@("Record Payment")"
            Width="520"
            Closable
            MaskClosable="@(!_busy)"
            OnClose="CloseCreateDrawer">
        <FormValidationSummary Title="@L["Payments_CreateFailed"]" Message="@_formError" IsConflict="_formConflict" />
        <div style="display:flex;flex-direction:column;gap:16px;max-width:480px;">
            <div>
                <label class="ant-form-item-label"><span class="ant-form-item-required">Organization</span></label>
                <Select TItemValue="string" TItem="string" @bind-Value="_createOrgId" Style="width:100%;" Disabled="_busy" Placeholder="Select organization" AllowClear>
                    <SelectOptions>
                        @foreach (var org in _organizationOptions)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value="@org.Id.ToString("D")" Label="@org.DisplayName" />
                        }
                    </SelectOptions>
                </Select>
                @if (!string.IsNullOrWhiteSpace(_fieldOrg))
                {
                    <div style="color:#ff4d4f;font-size:12px;margin-top:4px;">@_fieldOrg</div>
                }
            </div>
            <div>
                <label class="ant-form-item-label"><span class="ant-form-item-required">Product</span></label>
                <Select TItemValue="string" TItem="string" @bind-Value="_createProductCode" Style="width:100%;" Disabled="_busy" Placeholder="Select product" AllowClear>
                    <SelectOptions>
                        @foreach (var product in _productOptions)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value="@product.Code"
                                          Label="@(string.IsNullOrWhiteSpace(product.DisplayName) ? product.Code : product.DisplayName)" />
                        }
                    </SelectOptions>
                </Select>
            </div>
            <Row Gutter="12">
                <AntDesign.Col Span="14">
                    <label class="ant-form-item-label"><span class="ant-form-item-required">Amount</span></label>
                    <AntDesign.InputNumber TValue="decimal" @bind-Value="_createAmountValue" Style="width:100%;" Disabled="_busy" Min="0" />
                    @if (!string.IsNullOrWhiteSpace(_fieldAmount))
                    {
                        <div style="color:#ff4d4f;font-size:12px;margin-top:4px;">@_fieldAmount</div>
                    }
                </AntDesign.Col>
                <AntDesign.Col Span="10">
                    <label class="ant-form-item-label"><span class="ant-form-item-required">Currency</span></label>
                    <Select TItemValue="string" TItem="string" @bind-Value="_createCurrency" Style="width:100%;" Disabled="_busy">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("PHP")" Label="PHP" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("USD")" Label="USD" />
                        </SelectOptions>
                    </Select>
                </AntDesign.Col>
            </Row>
            <div>
                <label class="ant-form-item-label"><span class="ant-form-item-required">Method</span></label>
                <Select TItemValue="string" TItem="string" @bind-Value="_createMethod" Style="width:100%;" Disabled="_busy">
                    <SelectOptions>
                        <SelectOption TItemValue="string" TItem="string" Value="@("Cash")" Label="Cash" />
                        <SelectOption TItemValue="string" TItem="string" Value="@("BankTransfer")" Label="Bank transfer" />
                        <SelectOption TItemValue="string" TItem="string" Value="@("GCash")" Label="GCash" />
                    </SelectOptions>
                </Select>
            </div>
            <div>
                <label class="ant-form-item-label">Reference</label>
                <Input @bind-Value="_createReference" Disabled="_busy" Placeholder="External reference" />
            </div>
            <div>
                <label class="ant-form-item-label"><span class="ant-form-item-required">Paid date and time</span></label>
                <DatePicker TValue="DateTime?" @bind-Value="_createPaidLocal" ShowTime="@true" Style="width:100%;" Disabled="_busy" />
                @if (!string.IsNullOrWhiteSpace(_fieldPaidAt))
                {
                    <div style="color:#ff4d4f;font-size:12px;margin-top:4px;">@_fieldPaidAt</div>
                }
                <div class="muted" style="font-size:12px;margin-top:4px;">Local time is converted to UTC when saved.</div>
            </div>
            <Space Style="margin-top:8px;">
                <Button OnClick="CloseCreateDrawer" Disabled="_busy">Cancel</Button>
                <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="CreatePaymentAsync">Save Payment</Button>
            </Space>
        </div>
    </Drawer>
}
else
{
    <AdminPageHeader Title="@L["Payments_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Payments"]} / {L["Common_Detail"]}")" Description="@L["Payments_DetailDescription"]">
        <Actions>
            <Button OnClick='() => Nav.NavigateTo("/admin/payments")'>Back to payments</Button>
        </Actions>
    </AdminPageHeader>
    <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom:16px;" Message="@L["Payments_DetailWarning"]" />

    @if (_detail is null) { <LoadingState Message="@L["Payments_DetailLoading"]" /> }
    else if (!_detail.IsSuccess) { <ErrorState Title="@(_detail.Error?.Title ?? L["Common_Error"])" Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" /> }
    else
    {
        var p = _detail.Data!;
        @if (!string.IsNullOrWhiteSpace(_formError)) { <ErrorState Title="@L["Common_ActionFailed"]" Detail="@_formError" /> }

        <Card Class="admin-elevated-card" Style="margin-bottom:24px;">
            <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1">
                <DescriptionsItem Title="@L["Common_Reference"]">@DisplayOrDash(p.ExternalReference)</DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Amount"]"><AdminMoneyDisplay Amount="@p.Amount" CurrencyCode="@p.CurrencyCode" /></DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Method"]">@p.Method</DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Status"]"><AdminStatusTag Value="@p.Status" /></DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Organization"]">
                    <a href="@($"/admin/organizations/{p.OrganizationId:D}")">@OrgLabel(p.OrganizationId)</a>
                </DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Product"]">@ProductLabel(p.ProductCode)</DescriptionsItem>
                <DescriptionsItem Title="Linked subscription">
                    @if (p.SubscriptionId is Guid sid) { <a href="@($"/admin/subscriptions/{sid:D}")">Details</a> }
                    else { <span>—</span> }
                </DescriptionsItem>
                <DescriptionsItem Title="Paid"><LocalTimestamp Value="@p.PaidAtUtc" /></DescriptionsItem>
                <DescriptionsItem Title="Confirmed"><LocalTimestamp Value="@p.ConfirmedAtUtc" /> · @DisplayOrDash(p.ConfirmedBy)</DescriptionsItem>
                <DescriptionsItem Title="Rejected"><LocalTimestamp Value="@p.RejectedAtUtc" /> · @DisplayOrDash(p.RejectedBy)</DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Reason"]">@DisplayOrDash(p.RejectionReason)</DescriptionsItem>
                <DescriptionsItem Title="Voided"><LocalTimestamp Value="@p.VoidedAtUtc" /> · @DisplayOrDash(p.VoidedBy)</DescriptionsItem>
                <DescriptionsItem Title="Void reason">@DisplayOrDash(p.VoidReason)</DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Version"]">@p.Version</DescriptionsItem>
                <DescriptionsItem Title="Record ID">@p.Id</DescriptionsItem>
            </Descriptions>
        </Card>

        <Card Class="admin-elevated-card" Title="@L["Payments_PaymentActions"]">
            @if (p.Status == "PendingConfirmation")
            {
                <Space Direction="SpaceDirection.Vertical" Style="width:100%;max-width:520px;">
                    <Input @bind-Value="_activateSubscriptionId" Placeholder="Subscription ID for confirm-and-activate" Disabled="_busy" />
                    <Input @bind-Value="_periodStartText" Placeholder="Period start UTC" Disabled="_busy" />
                    <Input @bind-Value="_periodEndText" Placeholder="Period end UTC" Disabled="_busy" />
                    <Input @bind-Value="_actionReason" Placeholder="Reject / void reason" Disabled="_busy" />
                    <Space Wrap>
                        <Button Type="@ButtonType.Primary" Loading="_busy" OnClick='() => Ask(L["Common_Confirm"], L["Payments_ConfirmPaymentMessage"], ConfirmAsync, AdminDialogKind.Confirm)'>Confirm payment</Button>
                        <Button Loading="_busy" OnClick="ConfirmAndActivateAsync">Confirm and activate</Button>
                        <Button Danger Loading="_busy" OnClick='() => Ask(L["Common_Confirm"], L["Payments_RejectConfirmMessage"], RejectAsync, AdminDialogKind.Destructive)'>Reject</Button>
                    </Space>
                </Space>
            }
            else if (p.Status == "Confirmed")
            {
                <Space Direction="SpaceDirection.Vertical" Style="width:100%;max-width:520px;">
                    <Input @bind-Value="_actionReason" Placeholder="Void reason" Disabled="_busy" />
                    @if (p.SubscriptionId is null)
                    {
                        <Input @bind-Value="_activateSubscriptionId" Placeholder="Subscription ID" Disabled="_busy" />
                        <Input @bind-Value="_periodStartText" Placeholder="Period start UTC" Disabled="_busy" />
                        <Input @bind-Value="_periodEndText" Placeholder="Period end UTC" Disabled="_busy" />
                        <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="ConfirmAndActivateAsync">Activate subscription</Button>
                    }
                    else
                    {
                        <p class="muted">Payment is already linked to a subscription and cannot be reused for another activation.</p>
                    }
                    <Button Danger Loading="_busy" OnClick='() => Ask(L["Common_Confirm"], L["Payments_VoidConfirmMessage"], VoidAsync, AdminDialogKind.Destructive)'>Void payment</Button>
                </Space>
            }
            else
            {
                <p class="muted">No further payment actions for status @FriendlyStatus(p.Status).</p>
            }
        </Card>
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true"
                   Title="@_confirm.Title"
                   Message="@_confirm.Message"
                   Kind="@_confirm.Kind"
                   OnConfirm="RunConfirmAsync"
                   OnCancel="ClearConfirm"
                   Busy="_busy" />
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private string _status = "Confirmed";
    private string _productCode = "";
    private string _organizationIdText = "";
    private string _search = "";
    private ApiCallResult<PagedResult<PaymentDto>>? _list;
    private ApiCallResult<PaymentDto>? _detail;
    private bool _createOpen;
    private string _createOrgId = "";
    private string _createProductCode = "";
    private decimal _createAmountValue = 1000m;
    private string _createCurrency = "PHP";
    private string _createMethod = "GCash";
    private string _createReference = "";
    private DateTime? _createPaidLocal = DateTime.Now;
    private string _activateSubscriptionId = "";
    private string _periodStartText = DateTimeOffset.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ");
    private string _periodEndText = DateTimeOffset.UtcNow.AddDays(30).ToString("yyyy-MM-ddTHH:mm:ssZ");
    private string _actionReason = "";
    private string? _formError;
    private bool _formConflict;
    private string? _fieldOrg;
    private string? _fieldAmount;
    private string? _fieldPaidAt;
    private bool _busy;
    private bool _listBusy;
    private ConfirmState? _confirm;
    private int _page = 1;
    private DateTime? _fromDateTime;
    private DateTime? _toDateTime;
    private ReportQuickRange? _quickRange = ReportQuickRange.Last30Days;
    private string? _fromError;
    private string? _toError;
    private const int MaxInclusiveReportDays = 366;
    private List<OrganizationDto> _organizationOptions = [];
    private List<ProductDto> _productOptions = [];
    private Dictionary<Guid, string> _orgNames = new();
    private Dictionary<string, string> _productNames = new(StringComparer.OrdinalIgnoreCase);
    private int _summaryPending;
    private int _summaryConfirmed;
    private int _summaryRejectedOrVoided;
    /// <summary>Prevents Layout LocationChanged re-renders from re-entering list load and killing the circuit.</summary>
    private readonly AdminPageLoadGate _loadGate = new();

    private IReadOnlyList<PaymentDto> VisiblePayments
    {
        get
        {
            var items = _list?.Data?.Items ?? Array.Empty<PaymentDto>();
            if (string.IsNullOrWhiteSpace(_search))
            {
                return FilterByPaidDate(items);
            }

            var q = _search.Trim();
            return FilterByPaidDate(items.Where(p =>
                (p.ExternalReference?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (p.ProductCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (p.Method?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || OrgLabel(p.OrganizationId).Contains(q, StringComparison.OrdinalIgnoreCase)).ToList());
        }
    }

    private string EmptyFilterMessage
    {
        get
        {
            var statusLabel = FriendlyStatus(_status);
            if (_status == "PendingConfirmation" && _summaryConfirmed > 0)
            {
                return $"No {statusLabel} payments in this date range. Confirmed summary is {_summaryConfirmed} — switch Status to Confirmed (or click that card).";
            }

            return $"No {statusLabel} payments match the current filters.";
        }
    }

    protected override void OnInitialized()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var (from, to) = ReportQuickRangeHelper.Resolve(ReportQuickRange.Last30Days, today);
        _fromDateTime = from.ToDateTime(TimeOnly.MinValue);
        _toDateTime = to.ToDateTime(TimeOnly.MaxValue);
    }

    protected override async Task OnParametersSetAsync()
    {
        await Permissions.EnsureLoadedAsync();
        if (!Permissions.HasPermission(PlatformPermissionCodes.ManageManualPayments))
        {
            return;
        }

        if (Id is not null)
        {
            if (!_loadGate.ShouldLoad(Id))
            {
                return;
            }

            _detail = await Api.GetPaymentAsync(Id.Value);
            return;
        }

        if (!_loadGate.ShouldLoad("list"))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        await EnsureLookupsAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("organizationId", out var org) && Guid.TryParse(org, out var orgId))
        {
            _organizationIdText = orgId.ToString("D");
            _createOrgId = orgId.ToString("D");
        }

        await LoadListAsync();
        await LoadSummaryAsync();
    }

    private async Task EnsureLookupsAsync()
    {
        if (_organizationOptions.Count is 0)
        {
            var orgs = await Api.GetOrganizationsAsync(page: 1, pageSize: 100, status: "Active");
            if (orgs.IsSuccess && orgs.Data is not null)
            {
                _organizationOptions = orgs.Data.Items.OrderBy(o => o.DisplayName).ToList();
                _orgNames = _organizationOptions.ToDictionary(o => o.Id, o => o.DisplayName);
            }
        }

        if (_productOptions.Count is 0)
        {
            var products = await Api.GetProductsAsync(page: 1, pageSize: 100);
            if (products.IsSuccess && products.Data is not null)
            {
                _productOptions = products.Data.Items.OrderBy(p => p.DisplayName).ToList();
                _productNames = _productOptions.ToDictionary(
                    p => p.Code,
                    p => string.IsNullOrWhiteSpace(p.DisplayName) ? p.Code : p.DisplayName,
                    StringComparer.OrdinalIgnoreCase);
            }
        }
    }

    private async Task LoadSummaryAsync()
    {
        try
        {
            var pendingTask = Api.GetPaymentsAsync(status: "PendingConfirmation", page: 1, pageSize: 1);
            var confirmedTask = Api.GetPaymentsAsync(status: "Confirmed", page: 1, pageSize: 1);
            var rejectedTask = Api.GetPaymentsAsync(status: "Rejected", page: 1, pageSize: 1);
            var voidedTask = Api.GetPaymentsAsync(status: "Voided", page: 1, pageSize: 1);
            await Task.WhenAll(pendingTask, confirmedTask, rejectedTask, voidedTask);

            var pending = await pendingTask;
            var confirmed = await confirmedTask;
            var rejected = await rejectedTask;
            var voided = await voidedTask;
            _summaryPending = pending.IsSuccess ? pending.Data?.TotalCount ?? 0 : 0;
            _summaryConfirmed = confirmed.IsSuccess ? confirmed.Data?.TotalCount ?? 0 : 0;
            _summaryRejectedOrVoided =
                (rejected.IsSuccess ? rejected.Data?.TotalCount ?? 0 : 0)
                + (voided.IsSuccess ? voided.Data?.TotalCount ?? 0 : 0);
        }
        catch
        {
            // Summary is best-effort; list remains authoritative.
        }
    }

    private async Task LoadListAsync()
    {
        if (_listBusy)
        {
            return;
        }

        _listBusy = true;
        try
        {
            Guid? orgId = Guid.TryParse(_organizationIdText, out var parsed) ? parsed : null;
            _list = await Api.GetPaymentsAsync(
                string.IsNullOrWhiteSpace(_status) ? "Confirmed" : _status,
                string.IsNullOrWhiteSpace(_productCode) ? null : _productCode,
                orgId,
                page: _page);
        }
        finally
        {
            _listBusy = false;
        }
    }

    private IReadOnlyList<PaymentDto> FilterByPaidDate(IReadOnlyList<PaymentDto> items)
    {
        if (_fromDateTime is null || _toDateTime is null)
        {
            return items;
        }

        var fromUtc = DateTime.SpecifyKind(_fromDateTime.Value, DateTimeKind.Local).ToUniversalTime();
        var toUtc = DateTime.SpecifyKind(_toDateTime.Value, DateTimeKind.Local).ToUniversalTime();
        return items.Where(p => p.PaidAtUtc >= fromUtc && p.PaidAtUtc <= toUtc).ToList();
    }

    private bool ValidateDateRange()
    {
        _fromError = _toError = null;
        if (_fromDateTime is null || _toDateTime is null)
        {
            return true;
        }

        var from = DateOnly.FromDateTime(_fromDateTime.Value);
        var to = DateOnly.FromDateTime(_toDateTime.Value);
        if (to < from)
        {
            _toError = L["Report_DateRangeInvalid"];
            return false;
        }

        if (!ReportQuickRangeHelper.IsWithinMaxSpan(from, to, MaxInclusiveReportDays))
        {
            _toError = string.Format(L["Report_DateRangeTooLarge"], MaxInclusiveReportDays);
            return false;
        }

        return true;
    }

    private async Task ApplyFiltersAsync()
    {
        if (!ValidateDateRange())
        {
            await Message.WarningAsync(_toError ?? _fromError ?? "Invalid date range.");
            return;
        }

        _page = 1;
        await LoadListAsync();
    }

    private async Task OnQuickRangeAsync(ReportQuickRange range)
    {
        _quickRange = range;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var (from, to) = ReportQuickRangeHelper.Resolve(range, today);
        _fromDateTime = from.ToDateTime(TimeOnly.MinValue);
        _toDateTime = to.ToDateTime(TimeOnly.MaxValue);
        _fromError = _toError = null;
        await ApplyFiltersAsync();
    }

    private async Task OnPaymentsTableChangeAsync(QueryModel<PaymentDto> queryModel)
    {
        // Avoid reload loops: Table OnChange fires on mount/data bind; only page changes need a fetch.
        if (_listBusy)
        {
            return;
        }

        var newPage = queryModel.PageIndex >= 1 ? queryModel.PageIndex : 1;
        if (newPage == _page)
        {
            return;
        }

        _page = newPage;
        await LoadListAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _status = "Confirmed";
        _productCode = "";
        _organizationIdText = "";
        _search = "";
        _page = 1;
        _quickRange = ReportQuickRange.Last30Days;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var (from, to) = ReportQuickRangeHelper.Resolve(ReportQuickRange.Last30Days, today);
        _fromDateTime = from.ToDateTime(TimeOnly.MinValue);
        _toDateTime = to.ToDateTime(TimeOnly.MaxValue);
        _fromError = _toError = null;
        await LoadListAsync();
        await LoadSummaryAsync();
    }

    private async Task FilterByStatusAsync(string status)
    {
        _status = status;
        await ApplyFiltersAsync();
    }

    private async Task OnStatusChangedAsync(string status)
    {
        var next = string.IsNullOrWhiteSpace(status) ? "Confirmed" : status;
        if (string.Equals(_status, next, StringComparison.Ordinal))
        {
            return;
        }

        _status = next;
        await ApplyFiltersAsync();
    }

    private async Task OnSummaryKeyAsync(KeyboardEventArgs e, string status)
    {
        if (e.Key is "Enter" or " ")
        {
            await FilterByStatusAsync(status);
        }
    }

    private string SummaryCardStyle(string status) =>
        string.Equals(_status, status, StringComparison.Ordinal)
            ? "cursor:pointer;outline:2px solid var(--ant-primary-color,#1677ff);outline-offset:2px;border-radius:8px;"
            : "cursor:pointer;";

    private void OpenCreateDrawer()
    {
        _formError = null;
        _formConflict = false;
        _fieldOrg = _fieldAmount = _fieldPaidAt = null;
        _createPaidLocal ??= DateTime.Now;
        _createOpen = true;
    }

    private void CloseCreateDrawer()
    {
        if (_busy)
        {
            return;
        }

        _createOpen = false;
    }

    private async Task CreatePaymentAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            await Message.WarningAsync("Please wait — a request is already in progress.");
            return;
        }

        _formError = null;
        _formConflict = false;
        _fieldOrg = _fieldAmount = _fieldPaidAt = null;

        try
        {
            if (!Guid.TryParse(_createOrgId, out var orgId))
            {
                _fieldOrg = "Select an organization.";
                await Message.WarningAsync(_fieldOrg);
                return;
            }

            if (string.IsNullOrWhiteSpace(_createProductCode))
            {
                _formError = "Select a product.";
                await Message.WarningAsync(_formError);
                return;
            }

            if (_createAmountValue <= 0)
            {
                _fieldAmount = L["Payments_AmountInvalid"];
                await Message.WarningAsync(_fieldAmount);
                return;
            }

            if (_createPaidLocal is null)
            {
                _fieldPaidAt = "Paid date and time are required.";
                await Message.WarningAsync(_fieldPaidAt);
                return;
            }

            var paidAt = DateTime.SpecifyKind(_createPaidLocal.Value, DateTimeKind.Local).ToUniversalTime();
            var result = await Api.CreateManualPaymentAsync(new CreateManualPaymentRequest(
                orgId,
                _createProductCode.Trim(),
                _createAmountValue,
                _createCurrency.Trim(),
                _createMethod,
                _createReference.Trim(),
                new DateTimeOffset(paidAt)));

            if (!result.IsSuccess)
            {
                _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
                _formError = AdminFormErrorMapper.MapPageError(result) ?? "Payment could not be recorded.";
                await Message.ErrorAsync(_formError);
                return;
            }

            await Message.SuccessAsync(L["Payments_ToastCreated"].Value);
            _createOpen = false;
            await LoadListAsync();
            await LoadSummaryAsync();
            Nav.NavigateTo($"/admin/payments/{result.Data!.Id}");
        }
        catch (Exception ex)
        {
            _formError = "An unexpected error occurred while recording the payment.";
            await Message.ErrorAsync(_formError);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Ask(string title, string message, Func<Task> action, AdminDialogKind kind) =>
        _confirm = new ConfirmState(title, message, action, kind);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private Task ClearConfirm() { _confirm = null; return Task.CompletedTask; }

    private async Task ConfirmAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        try
        {
            _formError = null;
            _formConflict = false;
            var result = await Api.ConfirmPaymentAsync(Id.Value, new ConfirmPaymentRequest("dev-admin"));
            await ClearConfirm();
            if (!result.IsSuccess)
            {
                _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
                _formError = AdminFormErrorMapper.MapPageError(result);
                await Message.ErrorAsync(_formError ?? L["Common_ActionFailed"]);
                return;
            }

            await Message.SuccessAsync("Payment confirmed (manual attestation only).");
            _detail = ApiCallResult<PaymentDto>.Success(result.Data!);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmAndActivateAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        try
        {
            _formError = null;
            _formConflict = false;
            if (!Guid.TryParse(_activateSubscriptionId, out var subscriptionId))
            {
                _formError = "Subscription ID is required for activation.";
                await Message.WarningAsync(_formError);
                return;
            }

            if (!DateTimeOffset.TryParse(_periodStartText, out var start) || !DateTimeOffset.TryParse(_periodEndText, out var end))
            {
                _formError = "Paid period start/end must be valid UTC timestamps.";
                await Message.WarningAsync(_formError);
                return;
            }

            var result = await Api.ConfirmPaymentAndActivateAsync(Id.Value, new ActivateSubscriptionForPaymentRequest(
                "dev-admin", subscriptionId, start.ToUniversalTime(), end.ToUniversalTime()));
            if (!result.IsSuccess)
            {
                _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
                _formError = AdminFormErrorMapper.MapPageError(result);
                await Message.ErrorAsync(_formError ?? L["Common_ActionFailed"]);
                return;
            }

            await Message.SuccessAsync($"Payment linked and subscription {result.Data!.Subscription.Status}.");
            _detail = ApiCallResult<PaymentDto>.Success(result.Data.Payment);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync()
    {
        if (Id is null)
        {
            return;

    private string OrgLabel(Guid organizationId) =>
        _orgNames.TryGetValue(organizationId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : "Organization";

    private string ProductLabel(string? productCode) =>
        !string.IsNullOrWhiteSpace(productCode) && _productNames.TryGetValue(productCode, out var name)
            ? name
            : (productCode ?? "—");

    private static string DisplayOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FriendlyStatus(string status) => status switch
    {
        "PendingConfirmation" => "Pending Confirmation",
        "Confirmed" => "Confirmed",
        "Rejected" => "Rejected",
        "Voided" => "Voided",
        _ => status
    };

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action, AdminDialogKind Kind);
}

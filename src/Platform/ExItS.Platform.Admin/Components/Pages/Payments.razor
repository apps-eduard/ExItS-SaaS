@page "/admin/payments"
@page "/admin/payments/{Id:guid}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IStringLocalizer<AdminResources> L

@if (Id is null)
{
    <ReportPageShell>
        <ReportHeader Title="@L["Payments_Title"]"
                      Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Payments"]}")"
                      Description="@L["Payments_Description"]" />
        <section class="warning" role="note">@L["Payments_Warning"]</section>

        <FormSection Title="@L["Payments_CreateSection"]">
            <FormValidationSummary Title="@L["Payments_CreateFailed"]" Message="@(_showCreate ? _formError : null)" IsConflict="_formConflict" />
            <div class="form-grid">
                <FormField Label="@($"{L["Common_Organization"]} ID")" FieldId="pay-org" Required="true" Error="@_fieldOrg">
                    <AdminInput @bind-Value="_createOrgId" Placeholder="GUID" Disabled="_busy" />
                </FormField>
                <FormField Label="@L["OrgProductAccess_ProductCode"]" FieldId="pay-product" Required="true">
                    <AdminInput @bind-Value="_createProductCode" Disabled="_busy" />
                </FormField>
                <FormField Label="@L["Common_Amount"]" FieldId="pay-amount" Required="true" Error="@_fieldAmount" Help="Decimal amount; server remains authoritative.">
                    <AdminInput @bind-Value="_createAmount" Type="number" InputMode="decimal" Step="0.01" Disabled="_busy" />
                </FormField>
                <FormField Label="Currency" FieldId="pay-currency">
                    <AdminInput @bind-Value="_createCurrency" Placeholder="PHP" Disabled="_busy" />
                </FormField>
                <FormField Label="@L["Common_Method"]" FieldId="pay-method" Required="true">
                    <AdminSelect @bind-Value="_createMethod" Disabled="_busy">
                        <option>Cash</option>
                        <option>BankTransfer</option>
                        <option>GCash</option>
                    </AdminSelect>
                </FormField>
                <FormField Label="@L["Common_Reference"]" FieldId="pay-ref">
                    <AdminInput @bind-Value="_createReference" Autocomplete="off" Disabled="_busy" />
                </FormField>
                <FormField Label="@L["Common_PaidUtc"]" FieldId="pay-paid" Required="true" Error="@_fieldPaidAt" Help="UTC timestamp (yyyy-MM-ddTHH:mm:ssZ)">
                    <AdminInput @bind-Value="_createPaidAt" Placeholder="yyyy-MM-ddTHH:mm:ssZ" Disabled="_busy" />
                </FormField>
            </div>
            <FormActions PrimaryText="@L["Payments_CreateButton"]" Busy="_busy" OnPrimary="CreatePaymentAsync" />
        </FormSection>

        <ResponsiveReportLayout>
            <Filters>
                <ReportFilterBar Busy="_listBusy" OnApply="ApplyFiltersAsync" OnReset="ClearFiltersAsync">
                    <ReportQuickRangeSelector Active="_quickRange" RangeSelected="OnQuickRangeAsync" Disabled="_listBusy" />
                    <ReportDateRangeFilter @bind-FromDate="_fromDate"
                                          @bind-ToDate="_toDate"
                                          FromError="@_fromError"
                                          ToError="@_toError"
                                          Help="@L["Report_PaidRangeHelp"]"
                                          Disabled="_listBusy" />
                    <FormField Label="@L["Common_Status"]" FieldId="pay-filter-status">
                        <AdminSelect @bind-Value="_status" Disabled="_listBusy">
                            <option value="PendingConfirmation">PendingConfirmation</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Voided">Voided</option>
                        </AdminSelect>
                    </FormField>
                    <FormField Label="@L["OrgProductAccess_ProductCode"]" FieldId="pay-filter-product">
                        <AdminInput @bind-Value="_productCode" Placeholder="optional" Disabled="_listBusy" />
                    </FormField>
                    <FormField Label="@($"{L["Common_Organization"]} id")" FieldId="pay-filter-org">
                        <AdminInput @bind-Value="_organizationIdText" Placeholder="optional GUID" Disabled="_listBusy" />
                    </FormField>
                </ReportFilterBar>
                <AdminFilterSummary Items="_filterChips" OnClear="ClearFiltersAsync" />
            </Filters>
            <ChildContent>
                <ReportSection Title="@L["Report_PaymentsSection"]">
                    <ReportDataPanel IsLoading="@(_list is null || _listBusy)"
                                    HasError="@(_list is { IsSuccess: false })"
                                    IsEmpty="@(_list is { IsSuccess: true, Data.Items.Count: 0 })"
                                    LoadingMessage="@L["Payments_Loading"]"
                                    EmptyMessage="@L["Payments_Empty"]"
                                    ErrorTitle="@(_list?.Error?.Title ?? L["Common_Error"])"
                                    ErrorDetail="@_list?.Error?.Detail"
                                    ErrorCorrelationId="@_list?.Error?.CorrelationId"
                                    ErrorUnavailable="@(_list?.Status == ApiCallStatus.Unavailable)">
                        <ReportGroupHeader Title="@L["Report_PageResults"]"
                                           Meta="@L["Report_PaidRangeHelp"]" />
                        <ReportTable TItem="PaymentDto"
                                     Items="_list!.Data!.Items"
                                     Columns="_paymentColumns"
                                     Caption="@L["Payments_Title"]"
                                     ItemKey="p => p.Id"
                                     CellTemplate="PaymentCell" />
                        <ReportTotalsRow Label="@L["Report_PaymentsTotals"]"
                                         Value="@($"{_list.Data.Items.Count}")"
                                         AriaLabel="@L["Report_PaymentsTotals"]" />
                        <AdminPagination Page="_list!.Data!.Page"
                                         PageSize="_list.Data.PageSize"
                                         TotalCount="_list.Data.TotalCount"
                                         PageChanged="OnPaymentPageAsync"
                                         Disabled="_listBusy" />
                    </ReportDataPanel>
                </ReportSection>
            </ChildContent>
        </ResponsiveReportLayout>
    </ReportPageShell>
}
else
{
    <PageHeader Title="@L["Payments_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Payments"]} / {L["Common_Detail"]}")" Description="@L["Payments_DetailDescription"]" />
    <section class="warning" role="note">@L["Payments_DetailWarning"]</section>

    @if (_detail is null) { <LoadingState Message="@L["Payments_DetailLoading"]" /> }
    else if (!_detail.IsSuccess) { <ErrorState Title="@(_detail.Error?.Title ?? L["Common_Error"])" Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" /> }
    else
    {
        var p = _detail.Data!;
        @if (!string.IsNullOrWhiteSpace(_toast)) { <p class="toast" role="status">@_toast</p> }
        @if (!string.IsNullOrWhiteSpace(_formError)) { <ErrorState Title="@L["Common_ActionFailed"]" Detail="@_formError" /> }

        <dl>
            <dt>@L["Common_Reference"]</dt><dd>@p.ExternalReference</dd>
            <dt>@L["Common_Amount"]</dt><dd>@p.Amount @p.CurrencyCode</dd>
            <dt>@L["Common_Method"]</dt><dd>@p.Method</dd>
            <dt>@L["Common_Status"]</dt><dd><StatusBadge Value="@p.Status" /></dd>
            <dt>@L["Common_Organization"]</dt><dd><a href="/admin/organizations/@p.OrganizationId">@p.OrganizationId</a></dd>
            <dt>@L["Common_Product"]</dt><dd>@p.ProductCode</dd>
            <dt>Linked subscription</dt>
            <dd>
                @if (p.SubscriptionId is Guid sid) { <a href="/admin/subscriptions/@sid">@sid</a> }
                else { <span>—</span> }
            </dd>
            <dt>@L["Common_PaidUtc"]</dt><dd><UtcTimestamp Value="@p.PaidAtUtc" /></dd>
            <dt>Confirmed at (UTC)</dt><dd><UtcTimestamp Value="@p.ConfirmedAtUtc" /></dd>
            <dt>Confirmed by</dt><dd>@(p.ConfirmedBy ?? "—")</dd>
            <dt>Rejected at (UTC)</dt><dd><UtcTimestamp Value="@p.RejectedAtUtc" /></dd>
            <dt>Rejected by</dt><dd>@(p.RejectedBy ?? "—")</dd>
            <dt>@L["Common_Reason"]</dt><dd>@(p.RejectionReason ?? "—")</dd>
            <dt>Voided at (UTC)</dt><dd><UtcTimestamp Value="@p.VoidedAtUtc" /></dd>
            <dt>Voided by</dt><dd>@(p.VoidedBy ?? "—")</dd>
            <dt>Void reason</dt><dd>@(p.VoidReason ?? "—")</dd>
            <dt>@L["Common_Version"]</dt><dd>@p.Version</dd>
        </dl>

        <section class="panel" aria-label="@L["Payments_PaymentActions"]">
            <h2>@L["Payments_PaymentActions"]</h2>
            @if (p.Status == "PendingConfirmation")
            {
                <div class="form-grid">
                    <label>Subscription ID (for confirm-and-activate) <input @bind="_activateSubscriptionId" placeholder="GUID of eligible subscription" /></label>
                    <label>Period start (UTC) <input @bind="_periodStartText" /></label>
                    <label>Period end (UTC) <input @bind="_periodEndText" /></label>
                    <label>Reject / void reason <input @bind="_actionReason" /></label>
                </div>
                <div class="actions">
                    <button type="button" @onclick='() => Ask(L["Common_Confirm"], L["Payments_ConfirmPaymentMessage"], ConfirmAsync, AdminDialogKind.Confirm)' disabled="@_busy">Confirm payment</button>
                    <button type="button" @onclick="ConfirmAndActivateAsync" disabled="@_busy">Confirm and activate subscription</button>
                    <button type="button" class="danger" @onclick='() => Ask(L["Common_Confirm"], L["Payments_RejectConfirmMessage"], RejectAsync, AdminDialogKind.Destructive)' disabled="@_busy">Reject payment</button>
                </div>
            }
            else if (p.Status == "Confirmed")
            {
                <div class="form-grid">
                    <label>Void reason <input @bind="_actionReason" /></label>
                    <label>Subscription ID (activate if not linked) <input @bind="_activateSubscriptionId" /></label>
                    <label>Period start (UTC) <input @bind="_periodStartText" /></label>
                    <label>Period end (UTC) <input @bind="_periodEndText" /></label>
                </div>
                <div class="actions">
                    @if (p.SubscriptionId is null)
                    {
                        <button type="button" @onclick="ConfirmAndActivateAsync" disabled="@_busy">Activate subscription with this payment</button>
                    }
                    <button type="button" class="danger" @onclick='() => Ask(L["Common_Confirm"], L["Payments_VoidConfirmMessage"], VoidAsync, AdminDialogKind.Destructive)' disabled="@_busy">Void payment</button>
                </div>
                @if (p.SubscriptionId is not null)
                {
                    <p class="muted">Payment is already linked to a subscription and cannot be reused for another activation.</p>
                }
            }
            else
            {
                <p class="muted">No further payment actions for status @p.Status.</p>
            }
        </section>
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true"
                   Title="@_confirm.Title"
                   Message="@_confirm.Message"
                   Kind="@_confirm.Kind"
                   OnConfirm="RunConfirmAsync"
                   OnCancel="ClearConfirm"
                   Busy="_busy" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private string _status = "PendingConfirmation";
    private string? _productCode;
    private string? _organizationIdText;
    private ApiCallResult<PagedResult<PaymentDto>>? _list;
    private ApiCallResult<PaymentDto>? _detail;
    private bool _showCreate = true;
    private string _createOrgId = "";
    private string _createProductCode = "";
    private string _createAmount = "1000";
    private string _createCurrency = "PHP";
    private string _createMethod = "GCash";
    private string _createReference = "";
    private string _createPaidAt = DateTimeOffset.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ");
    private string _activateSubscriptionId = "";
    private string _periodStartText = DateTimeOffset.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ");
    private string _periodEndText = DateTimeOffset.UtcNow.AddDays(30).ToString("yyyy-MM-ddTHH:mm:ssZ");
    private string _actionReason = "";
    private string? _toast;
    private string? _formError;
    private bool _formConflict;
    private string? _fieldOrg;
    private string? _fieldAmount;
    private string? _fieldPaidAt;
    private bool _busy;
    private bool _listBusy;
    private ConfirmState? _confirm;
    private int _page = 1;
    private List<AdminColumnDefinition> _paymentColumns = new();
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private ReportQuickRange? _quickRange;
    private string? _fromError;
    private string? _toError;
    private const int MaxInclusiveReportDays = 366;

    protected override void OnInitialized()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        (_fromDate, _toDate) = ReportQuickRangeHelper.Resolve(ReportQuickRange.Last30Days, today);
        _quickRange = ReportQuickRange.Last30Days;
        _paymentColumns =
        [
            new("ref", L["Common_Reference"], Primary: true),
            new("amount", L["Common_Amount"], Numeric: true),
            new("method", L["Common_Method"]),
            new("status", L["Common_Status"]),
            new("org", L["Common_Organization"]),
            new("paid", L["Common_PaidUtc"])
        ];
    }

    private IReadOnlyList<AdminFilterChip> _filterChips
    {
        get
        {
            var chips = new List<AdminFilterChip>
            {
                new(L["Common_Status"], string.IsNullOrWhiteSpace(_status) ? "PendingConfirmation" : _status)
            };
            if (!string.IsNullOrWhiteSpace(_productCode))
            {
                chips.Add(new(L["OrgProductAccess_ProductCode"], _productCode));
            }

            if (!string.IsNullOrWhiteSpace(_organizationIdText))
            {
                chips.Add(new(L["Common_Organization"], _organizationIdText));
            }

            if (_fromDate is not null && _toDate is not null)
            {
                chips.Add(new(L["Report_FromDate"], _fromDate.Value.ToString("yyyy-MM-dd")));
                chips.Add(new(L["Report_ToDate"], _toDate.Value.ToString("yyyy-MM-dd")));
            }

            return chips;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _toast = null;
        _formError = null;
        _formConflict = false;
        if (Id is null)
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("organizationId", out var org) && Guid.TryParse(org, out var orgId))
            {
                _organizationIdText = orgId.ToString();
                _createOrgId = orgId.ToString();
            }
            await LoadListAsync();
        }
        else
        {
            _detail = await Api.GetPaymentAsync(Id.Value);
        }
    }

    private async Task LoadListAsync()
    {
        _listBusy = true;
        try
        {
            Guid? orgId = Guid.TryParse(_organizationIdText, out var parsed) ? parsed : null;
            _list = await Api.GetPaymentsAsync(
                string.IsNullOrWhiteSpace(_status) ? "PendingConfirmation" : _status,
                string.IsNullOrWhiteSpace(_productCode) ? null : _productCode,
                orgId,
                page: _page);
        }
        finally
        {
            _listBusy = false;
        }
    }

    private bool ValidateDateRange()
    {
        _fromError = _toError = null;
        if (_fromDate is null || _toDate is null)
        {
            return true;
        }

        if (_toDate < _fromDate)
        {
            _toError = L["Report_DateRangeInvalid"];
            return false;
        }

        if (!ReportQuickRangeHelper.IsWithinMaxSpan(_fromDate.Value, _toDate.Value, MaxInclusiveReportDays))
        {
            _toError = string.Format(L["Report_DateRangeTooLarge"], MaxInclusiveReportDays);
            return false;
        }

        return true;
    }

    private async Task ApplyFiltersAsync()
    {
        if (!ValidateDateRange())
        {
            return;
        }

        _page = 1;
        await LoadListAsync();
    }

    private async Task OnQuickRangeAsync(ReportQuickRange range)
    {
        _quickRange = range;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        (_fromDate, _toDate) = ReportQuickRangeHelper.Resolve(range, today);
        _fromError = _toError = null;
        await ApplyFiltersAsync();
    }

    private async Task OnPaymentPageAsync(int page)
    {
        _page = page;
        await LoadListAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _status = "PendingConfirmation";
        _productCode = null;
        _organizationIdText = null;
        _page = 1;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _quickRange = ReportQuickRange.Last30Days;
        (_fromDate, _toDate) = ReportQuickRangeHelper.Resolve(ReportQuickRange.Last30Days, today);
        _fromError = _toError = null;
        await LoadListAsync();
    }

    private RenderFragment<(PaymentDto Item, AdminColumnDefinition Column)> PaymentCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "ref":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/payments/{ctx.Item.Id}");
                b.AddContent(2, ctx.Item.ExternalReference);
                b.CloseElement();
                break;
            case "amount":
                b.OpenComponent<AmountDisplay>(0);
                b.AddAttribute(1, nameof(AmountDisplay.Amount), (decimal?)ctx.Item.Amount);
                b.AddAttribute(2, nameof(AmountDisplay.CurrencyCode), ctx.Item.CurrencyCode);
                b.CloseComponent();
                break;
            case "method":
                b.AddContent(0, ctx.Item.Method);
                break;
            case "status":
                b.OpenComponent<ReportStatusBadge>(0);
                b.AddAttribute(1, nameof(ReportStatusBadge.Value), ctx.Item.Status);
                b.CloseComponent();
                break;
            case "org":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/organizations/{ctx.Item.OrganizationId}");
                b.AddContent(2, ctx.Item.OrganizationId);
                b.CloseElement();
                break;
            case "paid":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.PaidAtUtc);
                b.CloseComponent();
                break;
        }
    };

    private async Task CreatePaymentAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        _fieldOrg = _fieldAmount = _fieldPaidAt = null;
        _showCreate = true;

        if (!Guid.TryParse(_createOrgId, out var orgId))
        {
            _fieldOrg = L["Payments_OrgIdInvalid"];
            _busy = false;
            return;
        }

        if (!decimal.TryParse(_createAmount, out var amount))
        {
            _fieldAmount = L["Payments_AmountInvalid"];
            _busy = false;
            return;
        }

        if (!DateTimeOffset.TryParse(_createPaidAt, out var paidAt))
        {
            _fieldPaidAt = L["Payments_PaidAtInvalid"];
            _busy = false;
            return;
        }

        var result = await Api.CreateManualPaymentAsync(new CreateManualPaymentRequest(
            orgId, _createProductCode.Trim(), amount, _createCurrency.Trim(), _createMethod, _createReference.Trim(), paidAt.ToUniversalTime()));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["Payments_ToastCreated"], ToastKind.Success);
        Nav.NavigateTo($"/admin/payments/{result.Data!.Id}");
    }

    private void Ask(string title, string message, Func<Task> action, AdminDialogKind kind) =>
        _confirm = new ConfirmState(title, message, action, kind);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private Task ClearConfirm() { _confirm = null; return Task.CompletedTask; }

    private async Task ConfirmAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.ConfirmPaymentAsync(Id.Value, new ConfirmPaymentRequest("dev-admin"));
        _busy = false;
        await ClearConfirm();
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show("Payment confirmed (manual attestation only).", ToastKind.Success);
        _detail = ApiCallResult<PaymentDto>.Success(result.Data!);
    }

    private async Task ConfirmAndActivateAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        if (!Guid.TryParse(_activateSubscriptionId, out var subscriptionId))
        {
            _formError = "Subscription ID is required for activation.";
            _busy = false;
            return;
        }

        if (!DateTimeOffset.TryParse(_periodStartText, out var start) || !DateTimeOffset.TryParse(_periodEndText, out var end))
        {
            _formError = "Paid period start/end must be valid UTC timestamps.";
            _busy = false;
            return;
        }

        var result = await Api.ConfirmPaymentAndActivateAsync(Id.Value, new ActivateSubscriptionForPaymentRequest(
            "dev-admin", subscriptionId, start.ToUniversalTime(), end.ToUniversalTime()));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show($"Payment linked and subscription {result.Data!.Subscription.Status}.", ToastKind.Success);
        _detail = ApiCallResult<PaymentDto>.Success(result.Data.Payment);
    }

    private async Task RejectAsync()
    {
        if (Id is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_actionReason))
        {
            _formError = "Rejection reason is required.";
            await ClearConfirm();
            return;
        }

        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.RejectPaymentAsync(Id.Value, new RejectPaymentRequest("dev-admin", _actionReason));
        _busy = false;
        await ClearConfirm();
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show("Payment rejected.", ToastKind.Success);
        _detail = ApiCallResult<PaymentDto>.Success(result.Data!);
    }

    private async Task VoidAsync()
    {
        if (Id is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_actionReason))
        {
            _formError = "Void reason is required.";
            await ClearConfirm();
            return;
        }

        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.VoidPaymentAsync(Id.Value, new VoidPaymentRequest("dev-admin", _actionReason));
        _busy = false;
        await ClearConfirm();
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show("Payment voided.", ToastKind.Success);
        _detail = ApiCallResult<PaymentDto>.Success(result.Data!);
    }

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action, AdminDialogKind Kind);
}

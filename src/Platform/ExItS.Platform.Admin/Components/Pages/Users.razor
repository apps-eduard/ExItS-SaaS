    private string? DirectoryFilter
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
            if (path.EndsWith("/users/unassigned", StringComparison.OrdinalIgnoreCase)) return "Unassigned";
            if (path.EndsWith("/users/organization", StringComparison.OrdinalIgnoreCase)) return "Organization";
            if (path.EndsWith("/users/platform-staff", StringComparison.OrdinalIgnoreCase)) return "PlatformStaff";
            if (path.EndsWith("/users/personal", StringComparison.OrdinalIgnoreCase)) return "Personal";
            return null;
        }
    }


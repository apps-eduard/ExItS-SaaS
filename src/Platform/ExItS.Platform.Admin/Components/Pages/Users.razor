    private void OpenLifecycleModal(LifecycleAction action)
    {
        _lifecycleAction = action;
        _lifecycleReason = "";
        _lifecycleActorPassword = "";
        _lifecycleMfaCode = "";
        _fieldLifecycleReason = null;
        _fieldLifecyclePassword = null;
        _formError = null;
        (_lifecycleModalTitle, _lifecycleModalHint, _lifecycleTargetStatus, _lifecycleRequiresReason, _lifecycleRequiresStepUp) = action switch
        {
            LifecycleAction.Suspend => (
                L["Users_Action_Suspend"].Value,
                L["Users_SuspendConfirmMessage"].Value,
                L["Status_Suspended"].Value,
                true,
                false),
            LifecycleAction.GlobalSuspend => (
                L["Users_Action_GlobalSuspend"].Value,
                L["Users_GlobalSuspendConfirmMessage"].Value,
                L["Status_Suspended"].Value,
                true,
                false),
            LifecycleAction.Deactivate => (
                L["Users_Action_Deactivate"].Value,
                L["Users_DeactivateConfirmMessage"].Value,
                L["Status_Deactivated"].Value,
                true,
                true),
            LifecycleAction.MoveToSuspended => (
                L["Users_Action_MoveToSuspended"].Value,
                L["Users_MoveToSuspendedConfirmMessage"].Value,
                L["Status_Suspended"].Value,
                true,
                true),
            LifecycleAction.ReactivateFromDeactivated => (
                L["Users_Action_Reactivate"].Value,
                L["Users_ReactivateDeactivatedConfirmMessage"].Value,
                L["Status_Active"].Value,
                true,
                true),
            _ => ("", "", "", false, false)
        };
        _lifecycleModalVisible = true;
    }

    private void CloseLifecycleModal()
    {
        _lifecycleModalVisible = false;
        _lifecycleReason = "";
        _lifecycleActorPassword = "";
        _lifecycleMfaCode = "";
        _fieldLifecycleReason = null;
        _fieldLifecyclePassword = null;
    }


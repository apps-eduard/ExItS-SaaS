@page "/admin/users"
@page "/admin/users/{Id:guid}"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject ToastService Toasts
@inject IStringLocalizer<AdminResources> L

@if (Id is null)
{
    <PageHeader Title="@L["Users_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Users"]}")" Description="@L["Users_Description"]" />
    <div class="warning" role="note">@L["Users_Warning"]</div>

    <div class="filters">
        <label>@L["Common_Search"] <input @bind="_search" @bind:event="oninput" placeholder="@L["Users_SearchPlaceholder"]" /></label>
        <label>@L["Common_Status"]
            <select @bind="_status">
                <option value="">@L["Common_All"]</option>
                <option>Active</option>
                <option>Suspended</option>
                <option>Deactivated</option>
            </select>
        </label>
        <button type="button" @onclick="ApplyUserFiltersAsync">@L["Common_Apply"]</button>
        <button type="button" class="secondary" @onclick="ToggleCreate">@(_showCreate ? L["Users_HideCreate"] : L["Users_CreateUser"])</button>
    </div>

    @if (_showCreate)
    {
        <FormSection Title="@L["Users_CreateSection"]">
            <FormValidationSummary Title="@L["Users_CreateFailed"]" Message="@_formError" IsConflict="_formConflict" />
            <div class="form-grid">
                <FormField Label="@L["Common_Username"]" FieldId="user-create-username" Required="true" Error="@_fieldUsername">
                    <AdminInput @bind-Value="_newUsername" Autocomplete="off" Disabled="_busy" />
                </FormField>
                <FormField Label="@L["Common_DisplayName"]" FieldId="user-create-displayname" Required="true" Error="@_fieldDisplayName">
                    <AdminInput @bind-Value="_newDisplayName" Disabled="_busy" />
                </FormField>
                <FormField Label="@L["Common_Email"]" FieldId="user-create-email" Required="true" Error="@_fieldEmail">
                    <AdminInput @bind-Value="_newEmail" Type="email" Autocomplete="off" Disabled="_busy" />
                </FormField>
            </div>
            <FormActions PrimaryText="@L["Common_Create"]" Busy="_busy" OnPrimary="CreateAsync"
                        SecondaryText="@L["Common_Cancel"]" OnSecondary="HideCreate" />
        </FormSection>
    }

    @if (_list is null) { <LoadingState Message="@L["Users_Loading"]" /> }
    else if (!_list.IsSuccess) { <ErrorState Title="@(_list.Error?.Title ?? L["Common_Error"])" Detail="@_list.Error?.Detail" CorrelationId="@_list.Error?.CorrelationId" Unavailable="@(_list.Status == ApiCallStatus.Unavailable)" /> }
    else if (_list.Data!.Items.Count == 0) { <EmptyState Message="@L["Users_Empty"]" /> }
    else
    {
        <AdminFilterSummary Items="_userFilterChips" />
        <AdminDataTable TItem="PlatformUserDto"
                        Items="_list.Data.Items"
                        Columns="_userColumns"
                        Caption="@L["Users_Title"]"
                        ItemKey="u => u.Id"
                        CellTemplate="UserCell" />
        <AdminPagination Page="_list.Data.Page"
                         PageSize="_list.Data.PageSize"
                         TotalCount="_list.Data.TotalCount"
                         PageChanged="OnUserPageAsync" />
    }
}
else
{
    <PageHeader Title="@L["Users_DetailTitle"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Users"]} / {L["Common_Detail"]}")" Description="@L["Users_DetailDescription"]" />
    @if (_detail is null) { <LoadingState Message="@L["Users_DetailLoading"]" /> }
    else if (!_detail.IsSuccess) { <ErrorState Title="@(_detail.Error?.Title ?? L["Common_Error"])" Detail="@_detail.Error?.Detail" CorrelationId="@_detail.Error?.CorrelationId" Unavailable="@(_detail.Status == ApiCallStatus.Unavailable)" /> }
    else
    {
        var u = _detail.Data!;
        <FormValidationSummary Title="@L["Common_ActionFailed"]" Message="@_formError" IsConflict="_formConflict" />

        <dl>
            <dt>@L["Common_Username"]</dt><dd>@u.Username</dd>
            <dt>@L["Common_Status"]</dt><dd><StatusBadge Value="@u.Status" /></dd>
            <dt>@L["Common_CreatedUtc"]</dt><dd><UtcTimestamp Value="@u.CreatedAtUtc" /></dd>
            <dt>@L["Common_UpdatedUtc"]</dt><dd><UtcTimestamp Value="@u.UpdatedAtUtc" /></dd>
            @if (u.SuspendedAtUtc is not null)
            {
                <dt>@L["Users_SuspendedUtc"]</dt><dd><UtcTimestamp Value="@u.SuspendedAtUtc.Value" /></dd>
                <dt>@L["Users_SuspensionReason"]</dt><dd>@(u.SuspensionReason ?? "—")</dd>
            }
        </dl>

        <FormSection Title="@L["Users_EditProfile"]">
            <div class="form-grid">
                <FormField Label="@L["Common_DisplayName"]" FieldId="user-edit-displayname" Required="true" Error="@_fieldDisplayName">
                    <AdminInput @bind-Value="_editDisplayName" Disabled="_busy" />
                </FormField>
                <FormField Label="@L["Common_Email"]" FieldId="user-edit-email" Required="true" Error="@_fieldEmail">
                    <AdminInput @bind-Value="_editEmail" Type="email" Disabled="_busy" />
                </FormField>
            </div>
            <FormActions PrimaryText="@L["Users_SaveProfile"]" Busy="_busy" OnPrimary="SaveProfileAsync"
                        SecondaryText="@L["Common_Cancel"]" OnSecondary="ResetProfileAsync" />
        </FormSection>

        <FormSection Title="@L["Users_Lifecycle"]" Description="@L["Users_LifecycleHint"]">
            <div class="actions">
                <button type="button" class="secondary" @onclick='() => AskConfirm(L["Users_SuspendUser"], L["Users_SuspendConfirmMessage"], SuspendAsync, AdminDialogKind.Destructive)' disabled="@_busy">@L["Users_SuspendUser"]</button>
                <button type="button" class="secondary" @onclick="ReactivateAsync" disabled="@_busy">@L["Users_ReactivateUser"]</button>
                <button type="button" class="danger" @onclick='() => AskConfirm(L["Users_DisableUser"], L["Users_DisableConfirmMessage"], DisableAsync, AdminDialogKind.Destructive)' disabled="@_busy">@L["Users_DisableUser"]</button>
            </div>
        </FormSection>

        <h2>@L["Users_OrgMemberships"]</h2>
        <p class="muted">@L["Users_OrgMembershipsHint"]</p>
        @if (_memberships is null) { <LoadingState Message="@L["Users_LoadingMemberships"]" /> }
        else if (!_memberships.IsSuccess) { <ErrorState Title="@L["Users_MembershipsUnavailable"]" Detail="@_memberships.Error?.Detail" /> }
        else if (_memberships.Data!.Items.Count == 0) { <EmptyState Message="@L["Users_MembershipsEmpty"]" /> }
        else
        {
            <table class="data-table responsive-table">
                <thead><tr><th>@L["Common_Organization"]</th><th>@L["Common_Role"]</th><th>@L["Common_Status"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var m in _memberships.Data.Items)
                {
                    <tr>
                        <td data-label="@L["Common_Organization"]"><a href="/admin/organizations/@m.OrganizationId/members">@m.OrganizationId</a></td>
                        <td data-label="@L["Common_Role"]">@m.Role</td>
                        <td data-label="@L["Common_Status"]"><StatusBadge Value="@m.Status" /></td>
                        <td data-label="@L["Common_Open"]"><a href="/admin/organizations/@m.OrganizationId/members">@L["Common_Manage"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h2>@L["Users_ProductAccess"]</h2>
        <div class="warning" role="note">@L["Users_ProductAccessWarning"]</div>
        @if (_access is null) { <LoadingState Message="@L["Users_LoadingProductAccess"]" /> }
        else if (!_access.IsSuccess) { <ErrorState Title="@L["Users_ProductAccessUnavailable"]" Detail="@_access.Error?.Detail" /> }
        else if (_access.Data!.Items.Count == 0) { <EmptyState Message="@L["Users_ProductAccessEmpty"]" /> }
        else
        {
            <table class="data-table responsive-table">
                <thead><tr><th>@L["Common_Product"]</th><th>@L["Common_Organization"]</th><th>@L["Common_Status"]</th><th>@L["Common_GrantedUtc"]</th><th>@L["Common_RevokedUtc"]</th></tr></thead>
                <tbody>
                @foreach (var a in _access.Data.Items)
                {
                    <tr>
                        <td data-label="@L["Common_Product"]">@a.ProductCode</td>
                        <td data-label="@L["Common_Organization"]"><a href="/admin/organizations/@a.OrganizationId/product-access">@a.OrganizationId</a></td>
                        <td data-label="@L["Common_Status"]"><StatusBadge Value="@a.Status" /></td>
                        <td data-label="@L["Common_GrantedUtc"]"><UtcTimestamp Value="@a.GrantedAtUtc" /></td>
                        <td data-label="@L["Common_RevokedUtc"]">@(a.RevokedAtUtc is null ? "—" : null)@if (a.RevokedAtUtc is not null){<UtcTimestamp Value="@a.RevokedAtUtc.Value" />}</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true"
                   Title="@_confirm.Title"
                   Message="@_confirm.Message"
                   Kind="@_confirm.Kind"
                   OnConfirm="RunConfirmAsync"
                   OnCancel="CloseConfirm"
                   Busy="_busy" />
}

@if (_unsavedVisible)
{
    <ConfirmDialog Visible="true"
                   Kind="AdminDialogKind.UnsavedChanges"
                   Message="@L["Dialog_UnsavedMessage"]"
                   OnConfirm="DiscardCreateAsync"
                   OnCancel="KeepEditingAsync"
                   Busy="_busy" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private ApiCallResult<PagedResult<PlatformUserDto>>? _list;
    private ApiCallResult<PlatformUserDto>? _detail;
    private ApiCallResult<PagedResult<OrganizationMembershipDto>>? _memberships;
    private ApiCallResult<PagedResult<ProductAccessAssignmentDto>>? _access;
    private string _search = "";
    private string _status = "";
    private bool _showCreate;
    private string _newUsername = "";
    private string _newDisplayName = "";
    private string _newEmail = "";
    private string _editDisplayName = "";
    private string _editEmail = "";
    private string _savedDisplayName = "";
    private string _savedEmail = "";
    private string? _formError;
    private bool _formConflict;
    private string? _fieldUsername;
    private string? _fieldDisplayName;
    private string? _fieldEmail;
    private bool _busy;
    private ConfirmState? _confirm;
    private bool _unsavedVisible;
    private int _page = 1;
    private List<AdminColumnDefinition> _userColumns = new();

    private IReadOnlyList<AdminFilterChip> _userFilterChips
    {
        get
        {
            var chips = new List<AdminFilterChip>();
            if (!string.IsNullOrWhiteSpace(_search))
            {
                chips.Add(new(L["Common_Search"], _search));
            }

            if (!string.IsNullOrWhiteSpace(_status))
            {
                chips.Add(new(L["Common_Status"], _status));
            }

            return chips;
        }
    }

    protected override void OnInitialized()
    {
        _userColumns =
        [
            new("user", L["Common_User"], Primary: true),
            new("username", L["Common_Username"]),
            new("email", L["Common_Email"]),
            new("status", L["Common_Status"]),
            new("updated", L["Common_UpdatedUtc"])
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        _formError = null;
        _formConflict = false;
        ClearFieldErrors();
        if (Id is null) await ReloadListAsync();
        else await ReloadDetailAsync();
    }

    private async Task ReloadListAsync() =>
        _list = await Api.GetUsersAsync(
            page: _page,
            status: string.IsNullOrWhiteSpace(_status) ? null : _status,
            search: string.IsNullOrWhiteSpace(_search) ? null : _search);

    private async Task ApplyUserFiltersAsync()
    {
        _page = 1;
        await ReloadListAsync();
    }

    private async Task OnUserPageAsync(int page)
    {
        _page = page;
        await ReloadListAsync();
    }

    private RenderFragment<(PlatformUserDto Item, AdminColumnDefinition Column)> UserCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "user":
                b.OpenElement(0, "span");
                b.AddAttribute(1, "class", "avatar");
                b.AddAttribute(2, "aria-hidden", "true");
                b.AddContent(3, Initials(ctx.Item.DisplayName));
                b.CloseElement();
                b.AddContent(4, " ");
                b.OpenElement(5, "a");
                b.AddAttribute(6, "href", $"/admin/users/{ctx.Item.Id}");
                b.AddContent(7, ctx.Item.DisplayName);
                b.CloseElement();
                break;
            case "username":
                b.AddContent(0, ctx.Item.Username);
                break;
            case "email":
                b.AddContent(0, ctx.Item.Email);
                break;
            case "status":
                b.OpenComponent<StatusBadge>(0);
                b.AddAttribute(1, nameof(StatusBadge.Value), ctx.Item.Status);
                b.CloseComponent();
                break;
            case "updated":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.UpdatedAtUtc);
                b.CloseComponent();
                break;
        }
    };

    private async Task ReloadDetailAsync()
    {
        if (Id is null) return;
        _detail = await Api.GetUserAsync(Id.Value);
        if (_detail.IsSuccess)
        {
            _editDisplayName = _detail.Data!.DisplayName;
            _editEmail = _detail.Data.Email;
            _savedDisplayName = _editDisplayName;
            _savedEmail = _editEmail;
        }
        _memberships = await Api.GetUserMembershipsAsync(Id.Value);
        _access = await Api.GetUserProductAccessAsync(Id.Value);
    }

    private void ToggleCreate()
    {
        if (_showCreate && HasCreateDraft())
        {
            _unsavedVisible = true;
            return;
        }

        _showCreate = !_showCreate;
        if (!_showCreate)
        {
            ClearCreate();
        }
    }

    private Task HideCreate()
    {
        if (HasCreateDraft())
        {
            _unsavedVisible = true;
            return Task.CompletedTask;
        }

        _showCreate = false;
        ClearCreate();
        return Task.CompletedTask;
    }

    private bool HasCreateDraft() =>
        !string.IsNullOrWhiteSpace(_newUsername)
        || !string.IsNullOrWhiteSpace(_newDisplayName)
        || !string.IsNullOrWhiteSpace(_newEmail);

    private void ClearCreate()
    {
        _newUsername = _newDisplayName = _newEmail = "";
        ClearFieldErrors();
        _formError = null;
        _formConflict = false;
    }

    private Task DiscardCreateAsync()
    {
        _unsavedVisible = false;
        _showCreate = false;
        ClearCreate();
        return Task.CompletedTask;
    }

    private Task KeepEditingAsync()
    {
        _unsavedVisible = false;
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        ClearFieldErrors();
        _formError = null;
        _formConflict = false;

        if (string.IsNullOrWhiteSpace(_newUsername))
        {
            _fieldUsername = L["Users_UsernameRequired"];
        }

        if (string.IsNullOrWhiteSpace(_newDisplayName))
        {
            _fieldDisplayName = L["Users_DisplayNameRequired"];
        }

        if (string.IsNullOrWhiteSpace(_newEmail))
        {
            _fieldEmail = L["Users_EmailRequired"];
        }

        if (_fieldUsername is not null || _fieldDisplayName is not null || _fieldEmail is not null)
        {
            _busy = false;
            return;
        }

        var result = await Api.CreateUserAsync(new CreatePlatformUserRequest(_newUsername, _newDisplayName, _newEmail));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["Users_ToastCreated"], ToastKind.Success);
        _showCreate = false;
        ClearCreate();
        await ReloadListAsync();
    }

    private async Task SaveProfileAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        ClearFieldErrors();
        _formError = null;
        _formConflict = false;

        if (string.IsNullOrWhiteSpace(_editDisplayName))
        {
            _fieldDisplayName = L["Users_DisplayNameRequired"];
        }

        if (string.IsNullOrWhiteSpace(_editEmail))
        {
            _fieldEmail = L["Users_EmailRequired"];
        }

        if (_fieldDisplayName is not null || _fieldEmail is not null)
        {
            _busy = false;
            return;
        }

        var result = await Api.UpdateUserAsync(Id.Value, new UpdatePlatformUserRequest(_editDisplayName, _editEmail));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["Users_ToastProfileUpdated"], ToastKind.Success);
        await ReloadDetailAsync();
    }

    private Task ResetProfileAsync()
    {
        _editDisplayName = _savedDisplayName;
        _editEmail = _savedEmail;
        ClearFieldErrors();
        _formError = null;
        _formConflict = false;
        return Task.CompletedTask;
    }

    private void AskConfirm(string title, string message, Func<Task> action, AdminDialogKind kind) =>
        _confirm = new ConfirmState(title, message, action, kind);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private Task CloseConfirm()
    {
        _confirm = null;
        return Task.CompletedTask;
    }

    private async Task SuspendAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.SuspendUserAsync(Id.Value, "Suspended from Platform Admin");
        _busy = false;
        await CloseConfirm();
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["Users_ToastSuspended"], ToastKind.Success);
        await ReloadDetailAsync();
    }

    private async Task ReactivateAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.ReactivateUserAsync(Id.Value);
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["Users_ToastReactivated"], ToastKind.Success);
        await ReloadDetailAsync();
    }

    private async Task DisableAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        var result = await Api.DisableUserAsync(Id.Value);
        _busy = false;
        await CloseConfirm();
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        Toasts.Show(L["Users_ToastDisabled"], ToastKind.Success);
        await ReloadDetailAsync();
    }

    private void ClearFieldErrors()
    {
        _fieldUsername = _fieldDisplayName = _fieldEmail = null;
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action, AdminDialogKind Kind);
}

    private async Task OnUsersTableChangeAsync(QueryModel<PlatformUserDto> queryModel)
    {
        var newPage = queryModel.PageIndex >= 1 ? queryModel.PageIndex : 1;
        var (newSortBy, newSortDesc) = ExtractSort(queryModel);
        var sortChanged = !string.Equals(_sortBy, newSortBy, StringComparison.Ordinal) || _sortDesc != newSortDesc;
        var pageChanged = _page != newPage;

        if (!sortChanged && !pageChanged)
        {
            return;
        }

        if (sortChanged)
        {
            _sortBy = newSortBy;
            _sortDesc = newSortDesc;
            _page = 1;
        }
        else
        {
            _page = newPage;
        }

        await ReloadListAsync();
    }

    private static (string? SortBy, bool SortDesc) ExtractSort(QueryModel<PlatformUserDto> queryModel)
    {
        var activeSort = queryModel.SortModel
            .FirstOrDefault(s => !IsClearedSort(s.SortDirection));

        if (activeSort is null)
        {
            return (null, false);
        }

        var sortBy = MapSortField(activeSort.FieldName);
        if (sortBy is null)
        {
            return (null, false);
        }

        return (sortBy, IsDescendingSortDirection(activeSort.SortDirection));
    }

    private static string? MapSortField(string? fieldName) => fieldName switch
    {
        "DisplayName" => "displayName",
        "Username" => "username",
        "Email" => "email",
        "AccountClasses" => "accountType",
        "OrganizationNames" => "organization",
        "Status" => "status",
        "UpdatedAtUtc" => "updatedUtc",
        _ => null
    };

    private static bool IsClearedSort(SortDirection sort) => sort == SortDirection.None;

    private static bool IsDescendingSortDirection(SortDirection sort) => sort == SortDirection.Descending;


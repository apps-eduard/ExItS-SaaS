            LastName: string.IsNullOrWhiteSpace(_editLastName) ? null : _editLastName,
            Phone: string.IsNullOrWhiteSpace(_editPhone) ? null : _editPhone,
            EmployeeCode: string.IsNullOrWhiteSpace(_editEmployeeCode) ? null : _editEmployeeCode));

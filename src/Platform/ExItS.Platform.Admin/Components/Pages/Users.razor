    private async Task ToggleCreate()
    {
        if (_showCreate && HasCreateDraft())
        {
            var result = await Confirm.Show(
                L["Dialog_UnsavedMessage"].Value,
                L["Dialog_UnsavedTitle"].Value,
                ConfirmButtons.OKCancel,
                ConfirmIcon.Warning);
            if (result != ConfirmResult.OK)
            {
                return;
            }

            ClearCreate();
            _showCreate = false;
            return;
        }

        _showCreate = !_showCreate;
        if (!_showCreate)
        {
            ClearCreate();
        }
    }

    private async Task HideCreate()
    {
        if (HasCreateDraft())
        {
            var result = await Confirm.Show(
                L["Dialog_UnsavedMessage"].Value,
                L["Dialog_UnsavedTitle"].Value,
                ConfirmButtons.OKCancel,
                ConfirmIcon.Warning);
            if (result != ConfirmResult.OK)
            {
                return;
            }
        }

        _showCreate = false;
        ClearCreate();
    }

    private bool HasCreateDraft() =>
        !string.IsNullOrWhiteSpace(_staffPerson.FirstName)
        || !string.IsNullOrWhiteSpace(_staffPerson.LastName)
        || !string.IsNullOrWhiteSpace(_staffPerson.DisplayName)
        || !string.IsNullOrWhiteSpace(_staffPerson.Email)
        || !string.IsNullOrWhiteSpace(_staffPerson.Phone)
        || !string.IsNullOrWhiteSpace(_staffPerson.EmployeeCode)
        || !string.IsNullOrWhiteSpace(_newPlatformRole)
        || _staffPerson.RequireEmailVerification;

    private void ClearCreate()
    {
        _staffPerson.Clear();
        _staffPersonErrors = null;
        _newPlatformRole = "";
        ClearFieldErrors();
        _formError = null;
        _formConflict = false;
    }

    private async Task CreateAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        ClearFieldErrors();
        _staffPersonErrors = null;
        _formError = null;
        _formConflict = false;

        var personValidation = _staffPerson.Validate();
        if (!personValidation.IsValid)
        {
            _staffPersonErrors = personValidation.Errors;
        }

        if (string.IsNullOrWhiteSpace(_newPlatformRole))
        {
            _fieldPlatformRole = L["Users_PlatformRoleRequired"];
        }

        if (!personValidation.IsValid
            || _fieldPlatformRole is not null)
        {
            _busy = false;
            return;
        }

        var result = await Api.CreateUserAsync(new CreatePlatformUserRequest(
            _staffPerson.ResolvedDisplayName(),
            _staffPerson.Email.Trim(),
            _newPlatformRole,
            FirstName: _staffPerson.FirstName.Trim(),
            LastName: _staffPerson.LastName.Trim(),
            Phone: string.IsNullOrWhiteSpace(_staffPerson.Phone) ? null : _staffPerson.Phone.Trim(),
            EmployeeCode: string.IsNullOrWhiteSpace(_staffPerson.EmployeeCode) ? null : _staffPerson.EmployeeCode.Trim(),
            RequireEmailVerification: _staffPerson.RequireEmailVerification,
            SendEmailVerification: _staffPerson.RequireEmailVerification));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        await Message.SuccessAsync(L["Users_ToastCreated"].Value);
        _showCreate = false;
        ClearCreate();
        await ReloadListAsync();
    }


@implements IDisposable
@page "/admin/users"
@page "/admin/users/unassigned"
@page "/admin/users/organization"
@page "/admin/users/platform-staff"
@page "/admin/users/personal"
@page "/admin/users/{Id:guid}"
@using AntDesign
@using AntDesign.TableModels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject ConfirmService Confirm
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject PlatformPermissionState Permissions
@inject AdminShellContext Shell

@if (!Permissions.Loaded || !Shell.Loaded)
{
    <div style="padding:2rem;text-align:center;"><Spin /></div>
}
else if (!Shell.IsPlatformShell)
{
    <Result Status="@ResultStatus.Warning"
            Title="@L["Scope_PlatformAccountsDenied"]"
            SubTitle="@Shell.RoleLabel" />
}
else if (!Permissions.HasPermission(PlatformPermissionCodes.ManagePlatformUsers))
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ManagePlatformUsers" />
}
else if (Id is null)
{
    <PageHeader Class="exits-page-header" Title="@L["Users_Title"]" SubTitle="@DirectorySubtitle">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem>@L["Brand_Name"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Nav_Users"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
        <PageHeaderExtra>
            @if (CanCreatePlatformStaff)
            {
                <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ToggleCreate">
                    @(_showCreate ? L["Users_HideCreate"] : L["Users_CreateUser"])
                </Button>
            }
        </PageHeaderExtra>
    </PageHeader>

    <Alert Type="@AlertType.Warning" ShowIcon="true" Message="@L["Users_Warning"]" Style="margin-bottom:12px;" />
    <Alert Type="@AlertType.Info" ShowIcon="true" Message="@L["Users_AccountProfilesHint"]" Style="margin-bottom:12px;" />

    <Space Style="margin-bottom:12px; width:100%;" Wrap>
        <Input @bind-Value="_search" Size="@InputSize.Small" Placeholder="@L["Users_SearchPlaceholder"]" Style="width:220px;" OnPressEnter="ApplyUserFiltersAsync" />
        <Select TItemValue="string"
                TItem="string"
                @bind-Value="_status"
                Size="@InputSize.Small"
                Placeholder="@L["Common_Status"]"
                Style="width:140px;"
                AllowClear>
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value="@("")" Label="@L["Common_All"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Active")" Label="@L["Status_Active"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Suspended")" Label="@L["Status_Suspended"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("Deactivated")" Label="@L["Status_Deactivated"]" />
                <SelectOption TItemValue="string" TItem="string" Value="@("PendingVerification")" Label="@L["Status_PendingVerification"]" />
            </SelectOptions>
        </Select>
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="ApplyUserFiltersAsync">@L["Common_Apply"]</Button>
        <Button Size="@ButtonSize.Small" OnClick="ClearUserFiltersAsync">@L["Common_Reset"]</Button>
    </Space>

    @if (_showCreate && CanCreatePlatformStaff)
    {
        <Card Size="@CardSize.Small" Title="@L["Users_CreateSection"]" Style="margin-bottom:12px;">
            <FormValidationSummary Title="@L["Users_CreateFailed"]" Message="@_formError" IsConflict="_formConflict" />
            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                <StaffPersonFieldsForm Value="_staffPerson"
                                       Errors="_staffPersonErrors"
                                       IdPrefix="user-create"
                                       Disabled="_busy"
                                       ValueChanged="OnStaffPersonChanged" />
                <div>
                    <label class="ant-form-item-label" for="user-create-platform-role">@L["Users_PlatformRole"]</label>
                    <Select Id="user-create-platform-role"
                            TItemValue="string"
                            TItem="string"
                            @bind-Value="_newPlatformRole"
                            Size="@InputSize.Small"
                            Style="width:100%;"
                            Disabled="_busy"
                            Placeholder="@L["Users_PlatformRolePlaceholder"]">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("PlatformAdministrator")" Label="@L["Users_Role_PlatformAdministrator"]" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("BillingAdministrator")" Label="@L["Users_Role_BillingAdministrator"]" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("PlatformSupport")" Label="@L["Users_Role_PlatformSupport"]" />
                        </SelectOptions>
                    </Select>
                    @if (_fieldPlatformRole is not null) { <span class="exits-field-error">@_fieldPlatformRole</span> }
                </div>
                @if (_staffPerson.RequireEmailVerification)
                {
                    <div class="ant-form-item-explain" style="margin-top:4px;">@L["Users_SendEmailVerificationHint"]</div>
                }
                <Space>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="CreateAsync">@L["Common_Create"]</Button>
                    <Button Size="@ButtonSize.Small" OnClick="HideCreate" Disabled="_busy">@L["Common_Cancel"]</Button>
                </Space>
            </Space>
        </Card>
    }

    @if (_list is { IsSuccess: false })
    {
        <Result Status="@ResultStatus.Error" Title="@(_list.Error?.Title ?? L["Common_Error"])" SubTitle="@_list.Error?.Detail" />
    }
    else
    {
        <Table TItem="PlatformUserDto"
               DataSource="@(_list?.Data?.Items ?? Array.Empty<PlatformUserDto>())"
               Total="@(_list?.Data?.TotalCount ?? 0)"
               @bind-PageIndex="_page"
               PageSize="@(_list?.Data?.PageSize ?? 20)"
               Loading="@(_list is null)"
               Size="@TableSize.Small"
               Bordered
               RemoteDataSource
               OnChange="OnUsersTableChangeAsync">
            <PropertyColumn Property="c => c.DisplayName" Title="@L["Common_User"]" Sortable>
                <a href="/admin/users/@context.Id">@context.DisplayName</a>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Username" Title="@L["Common_Username"]" Sortable />
            <PropertyColumn Property="c => c.Email" Title="@L["Common_Email"]" Ellipsis Sortable />
            <PropertyColumn Property="c => c.AccountClasses" Title="@L["Users_AccountType"]" Sortable>
                @foreach (var accountClass in (context.AccountClasses ?? Array.Empty<string>()))
                {
                    <Tag Color="@AccountClassColor(accountClass)" Style="margin-right:4px;">@accountClass</Tag>
                }
                @if (context.AccountClasses is null || context.AccountClasses.Count == 0)
                {
                    <span>—</span>
                }
            </PropertyColumn>
            <PropertyColumn Property="c => c.OrganizationNames" Title="@L["Users_OrganizationName"]" Ellipsis Sortable>
                @{
                    var orgs = context.Organizations ?? Array.Empty<PlatformUserOrganizationDirectoryItem>();
                }
                @if (orgs.Count == 0)
                {
                    <span>—</span>
                }
                else
                {
                    @foreach (var org in orgs)
                    {
                        <div style="margin-bottom:2px;">
                            <span>@org.Name</span>
                            <Tag Color="@(org.Role == "OrganizationOwner" ? "gold" : "default")"
                                 Style="@(org.Role == "OrganizationOwner" ? "font-weight:600;margin-left:6px;" : "margin-left:6px;")">
                                @org.RoleDisplay
                            </Tag>
                        </div>
                    }
                }
            </PropertyColumn>
            <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]" Sortable>
                <Tag Color="@StatusColor(context.Status)">
                    @(context.Status == "PendingVerification" ? L["Status_PendingVerification"] : context.Status)
                </Tag>
            </PropertyColumn>
            <PropertyColumn Property="c => c.UpdatedAtUtc" Title="@L["Common_UpdatedUtc"]" Format="u" Sortable />
            <ActionColumn Title="@L["Common_Open"]" Width="88">
                <a class="ant-btn ant-btn-link ant-btn-sm" href="@($"/admin/users/{context.Id}")">@L["Common_Open"]</a>
            </ActionColumn>
        </Table>
    }
}
else
{
    <PageHeader Class="exits-page-header" Title="@L["Users_DetailTitle"]" SubTitle="@L["Users_DetailDescription"]">
        <PageHeaderBreadcrumb>
            <Breadcrumb>
                <BreadcrumbItem Href="/admin/users">@L["Nav_Users"]</BreadcrumbItem>
                <BreadcrumbItem>@L["Common_Detail"]</BreadcrumbItem>
            </Breadcrumb>
        </PageHeaderBreadcrumb>
    </PageHeader>
    @if (_detail is null) { <div style="padding:2rem;text-align:center;"><Spin Tip="@L["Users_DetailLoading"]" /></div> }
    else if (!_detail.IsSuccess) { <Result Status="@ResultStatus.Error" Title="@(_detail.Error?.Title ?? L["Common_Error"])" SubTitle="@_detail.Error?.Detail" /> }
    else
    {
        var u = _detail.Data!;
        <FormValidationSummary Title="@L["Common_ActionFailed"]" Message="@_formError" IsConflict="_formConflict" />

        <Descriptions Bordered Size="@DescriptionsSize.Small" Column="2" Style="margin-bottom:12px;">
            <DescriptionsItem Title="@L["Users_StaffNumber"]">@(u.StaffNumber ?? "—")</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Status"]">
                <Tag Color="@StatusColor(u.Status)">
                    @(u.Status == "PendingVerification" ? L["Status_PendingVerification"] : u.Status)
                </Tag>
            </DescriptionsItem>
            <DescriptionsItem Title="@L["Users_FirstName"]">@(u.FirstName ?? "—")</DescriptionsItem>
            <DescriptionsItem Title="@L["Users_LastName"]">@(u.LastName ?? "—")</DescriptionsItem>
            <DescriptionsItem Title="@L["Common_Username"]">@u.Username</DescriptionsItem>
            <DescriptionsItem Title="@L["Users_Phone"]">@(u.Phone ?? "—")</DescriptionsItem>
            <DescriptionsItem Title="@L["Users_EmployeeCode"]">@(u.EmployeeCode ?? "—")</DescriptionsItem>
            <DescriptionsItem Title="@L["Users_AccountType"]">
                @foreach (var accountClass in (u.AccountClasses ?? Array.Empty<string>()))
                {
                    <Tag Color="@AccountClassColor(accountClass)" Style="margin-right:4px;">@accountClass</Tag>
                }
                @if (u.AccountClasses is null || u.AccountClasses.Count == 0)
                {
                    <text>—</text>
                }
            </DescriptionsItem>
            <DescriptionsItem Title="@L["Users_OrganizationName"]">
                @{
                    var detailOrgs = u.Organizations ?? Array.Empty<PlatformUserOrganizationDirectoryItem>();
                }
                @if (detailOrgs.Count == 0)
                {
                    <text>—</text>
                }
                else
                {
                    @foreach (var org in detailOrgs)
                    {
                        <div style="margin-bottom:4px;">
                            <span>@org.Name</span>
                            <Tag Color="@(org.Role == "OrganizationOwner" ? "gold" : "default")"
                                 Style="@(org.Role == "OrganizationOwner" ? "font-weight:600;margin-left:6px;" : "margin-left:6px;")">
                                @org.RoleDisplay
                            </Tag>
                        </div>
                    }
                }
            </DescriptionsItem>
            <DescriptionsItem Title="@L["Common_CreatedUtc"]"><UtcTimestamp Value="@u.CreatedAtUtc" /></DescriptionsItem>
            <DescriptionsItem Title="@L["Common_UpdatedUtc"]"><UtcTimestamp Value="@u.UpdatedAtUtc" /></DescriptionsItem>
            @if (u.SuspendedAtUtc is not null)
            {
                <DescriptionsItem Title="@L["Users_SuspendedUtc"]"><UtcTimestamp Value="@u.SuspendedAtUtc.Value" /></DescriptionsItem>
                <DescriptionsItem Title="@L["Users_SuspensionReason"]">@(u.SuspensionReason ?? "—")</DescriptionsItem>
            }
        </Descriptions>

        <Card Size="@CardSize.Small" Title="@L["Users_EditProfile"]" Style="margin-bottom:12px;">
            <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                <div>
                    <label class="ant-form-item-label">@L["Users_StaffNumber"]</label>
                    <Input Value="@(u.StaffNumber ?? "—")" Size="@InputSize.Small" Disabled="true" />
                </div>
                <div>
                    <label class="ant-form-item-label" for="user-edit-firstname">@L["Users_FirstName"]</label>
                    <Input Id="user-edit-firstname" @bind-Value="_editFirstName" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <div>
                    <label class="ant-form-item-label" for="user-edit-lastname">@L["Users_LastName"]</label>
                    <Input Id="user-edit-lastname" @bind-Value="_editLastName" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <div>
                    <label class="ant-form-item-label" for="user-edit-displayname">@L["Common_DisplayName"]</label>
                    <Input Id="user-edit-displayname" @bind-Value="_editDisplayName" Size="@InputSize.Small" Disabled="_busy" />
                    @if (_fieldDisplayName is not null) { <span class="exits-field-error">@_fieldDisplayName</span> }
                </div>
                <div>
                    <label class="ant-form-item-label" for="user-edit-email">@L["Common_Email"]</label>
                    <Input Id="user-edit-email" @bind-Value="_editEmail" Size="@InputSize.Small" Disabled="_busy" />
                    @if (_fieldEmail is not null) { <span class="exits-field-error">@_fieldEmail</span> }
                </div>
                <div>
                    <label class="ant-form-item-label" for="user-edit-phone">@L["Users_Phone"]</label>
                    <Input Id="user-edit-phone" @bind-Value="_editPhone" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <div>
                    <label class="ant-form-item-label" for="user-edit-employee-code">@L["Users_EmployeeCode"]</label>
                    <Input Id="user-edit-employee-code" @bind-Value="_editEmployeeCode" Size="@InputSize.Small" Disabled="_busy" />
                </div>
                <Space>
                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="SaveProfileAsync">@L["Users_SaveProfile"]</Button>
                    <Button Size="@ButtonSize.Small" OnClick="ResetProfileAsync" Disabled="_busy">@L["Common_Cancel"]</Button>
                </Space>
            </Space>
        </Card>

        <Card Size="@CardSize.Small" Title="@L["Users_Lifecycle"]" Style="margin-bottom:12px;">
            <Paragraph Type="@TextElementType.Secondary">@L["Users_LifecycleHint"]</Paragraph>
            @{
                var status = _detail?.Data?.Status;
                var isPlatformAccount = _detail?.Data?.AccountClasses?.Any(c =>
                    string.Equals(c, "Platform", StringComparison.OrdinalIgnoreCase)) == true;
            }
            <Space Wrap>
                @if (status == "Active")
                {
                    @if (isPlatformAccount)
                    {
                        <Button Size="@ButtonSize.Small" Danger Disabled="_busy" OnClick="() => OpenLifecycleModal(LifecycleAction.Suspend)">
                            @L["Users_Action_Suspend"]
                        </Button>
                        <Button Size="@ButtonSize.Small" Danger Disabled="_busy" OnClick="() => OpenLifecycleModal(LifecycleAction.Deactivate)">
                            @L["Users_Action_Deactivate"]
                        </Button>
                    }
                    else
                    {
                        <Button Size="@ButtonSize.Small" Danger Disabled="_busy" OnClick="() => OpenLifecycleModal(LifecycleAction.GlobalSuspend)">
                            @L["Users_Action_GlobalSuspend"]
                        </Button>
                    }
                }
                else if (status == "Suspended")
                {
                    @if (isPlatformAccount)
                    {
                        <Popconfirm Title="@L["Users_ReactivateConfirmMessage"]"
                                    OnConfirm="() => ConfirmSimpleReactivateAsync(global: false)"
                                    OkText="@L["Common_Confirm"]"
                                    CancelText="@L["Common_Cancel"]"
                                    Disabled="_busy">
                            <Button Size="@ButtonSize.Small" Disabled="_busy">@L["Users_Action_Reactivate"]</Button>
                        </Popconfirm>
                        <Button Size="@ButtonSize.Small" Danger Disabled="_busy" OnClick="() => OpenLifecycleModal(LifecycleAction.Deactivate)">
                            @L["Users_Action_Deactivate"]
                        </Button>
                    }
                    else
                    {
                        <Popconfirm Title="@L["Users_GlobalReactivateConfirmMessage"]"
                                    OnConfirm="() => ConfirmSimpleReactivateAsync(global: true)"
                                    OkText="@L["Common_Confirm"]"
                                    CancelText="@L["Common_Cancel"]"
                                    Disabled="_busy">
                            <Button Size="@ButtonSize.Small" Disabled="_busy">@L["Users_Action_GlobalReactivate"]</Button>
                        </Popconfirm>
                    }
                }
                else if (status == "Deactivated")
                {
                    <Button Size="@ButtonSize.Small" Disabled="_busy" OnClick="() => OpenLifecycleModal(LifecycleAction.ReactivateFromDeactivated)">
                        @L["Users_Action_Reactivate"]
                    </Button>
                    <Button Size="@ButtonSize.Small" Danger Disabled="_busy" OnClick="() => OpenLifecycleModal(LifecycleAction.MoveToSuspended)">
                        @L["Users_Action_MoveToSuspended"]
                    </Button>
                }
            </Space>
        </Card>

        <Modal Title="@_lifecycleModalTitle"
               Visible="_lifecycleModalVisible"
               ConfirmLoading="_busy"
               OnOk="SubmitLifecycleModalAsync"
               OnCancel="CloseLifecycleModal"
               OkText="@L["Common_Confirm"].Value"
               CancelText="@L["Common_Cancel"].Value">
            <Alert Type="@AlertType.Warning" ShowIcon="true" Message="@_lifecycleModalHint" Style="margin-bottom:12px;" />
            <Descriptions Size="@DescriptionsSize.Small" Column="1" Bordered Style="margin-bottom:12px;">
                <DescriptionsItem Title="@L["Common_DisplayName"]">@(_detail?.Data?.DisplayName ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Email"]">@(_detail?.Data?.Email ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="@L["Common_Status"]">@(_detail?.Data?.Status ?? "—")</DescriptionsItem>
                <DescriptionsItem Title="@L["OrgMembers_TargetStatus"]">@_lifecycleTargetStatus</DescriptionsItem>
            </Descriptions>
            @if (_lifecycleRequiresReason)
            {
                <div style="margin-bottom:12px;">
                    <label class="ant-form-item-label">@L["Users_LifecycleReason"]</label>
                    <TextArea @bind-Value="_lifecycleReason" Rows="3" Disabled="_busy" />
                    @if (_fieldLifecycleReason is not null) { <span class="exits-field-error">@_fieldLifecycleReason</span> }
                </div>
            }
            @if (_lifecycleRequiresStepUp)
            {
                <div style="margin-bottom:12px;">
                    <label class="ant-form-item-label">@L["Users_ActorPassword"]</label>
                    <InputPassword @bind-Value="_lifecycleActorPassword" Disabled="_busy" />
                    @if (_fieldLifecyclePassword is not null) { <span class="exits-field-error">@_fieldLifecyclePassword</span> }
                </div>
                <div style="margin-bottom:12px;">
                    <label class="ant-form-item-label">@L["Users_MfaCode"]</label>
                    <Input @bind-Value="_lifecycleMfaCode" Size="@InputSize.Small" Disabled="_busy" Placeholder="@L["Users_MfaCodeHint"]" />
                </div>
            }
        </Modal>

        <Card Size="@CardSize.Small" Title="Credentials" Style="margin-bottom:12px;">
            @if (_credentials is null) { <Spin /> }
            else if (!_credentials.IsSuccess) { <Alert Type="@AlertType.Error" Message="Credentials unavailable" Description="@_credentials.Error?.Detail" ShowIcon="true" /> }
            else
            {
                var c = _credentials.Data!;
                <Descriptions Size="@DescriptionsSize.Small" Column="2" Bordered Style="margin-bottom:8px;">
                    <DescriptionsItem Title="Has password">@(c.HasPassword ? "Yes" : "No")</DescriptionsItem>
                    <DescriptionsItem Title="Email verified">@(c.EmailVerified ? "Yes" : "No")</DescriptionsItem>
                    <DescriptionsItem Title="Locked out">@(c.IsLockedOut ? $"Yes until {c.LockoutEndUtc}" : "No")</DescriptionsItem>
                    <DescriptionsItem Title="Failed attempts">@c.FailedAccessCount</DescriptionsItem>
                </Descriptions>
                <InputPassword @bind-Value="_setPassword" Size="@InputSize.Small" Placeholder="Set / replace password" Disabled="_busy" Style="margin-bottom:8px; width:100%;" />
                <Space>
                    <Button Size="@ButtonSize.Small" OnClick="SetPasswordAsync" Disabled="_busy">Set password</Button>
                    <Button Size="@ButtonSize.Small" OnClick="UnlockCredentialAsync" Disabled="_busy">Unlock</Button>
                    <Button Size="@ButtonSize.Small" OnClick="MarkEmailVerifiedAsync" Disabled="_busy">Mark email verified</Button>
                </Space>
            }
        </Card>

        <Title Level="5">@L["Users_OrgMemberships"]</Title>
        <Paragraph Type="@TextElementType.Secondary">@L["Users_OrgMembershipsHint"]</Paragraph>
        @if (_memberships is null) { <Spin /> }
        else if (!_memberships.IsSuccess) { <Alert Type="@AlertType.Error" Message="@L["Users_MembershipsUnavailable"].Value" ShowIcon="true" /> }
        else if (_memberships.Data!.Items.Count == 0) { <Empty Description="@L["Users_MembershipsEmpty"].Value" /> }
        else
        {
            <Table TItem="OrganizationMembershipDto" DataSource="_memberships.Data.Items" Size="@TableSize.Small" HidePagination Bordered>
                <PropertyColumn Property="c => c.OrganizationId" Title="@L["Common_Organization"]">
                    <a href="/admin/organizations/@context.OrganizationId/members">@context.OrganizationId</a>
                </PropertyColumn>
                <PropertyColumn Property="c => c.Role" Title="@L["Common_Role"]">
                    <Tag Color="@(context.Role == "OrganizationOwner" ? "gold" : "default")"
                         Style="@(context.Role == "OrganizationOwner" ? "font-weight:600;" : null)">
                        @(context.RoleDisplay ?? FormatOrgRoleDisplay(context.Role))
                    </Tag>
                </PropertyColumn>
                <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]">
                    <Tag>@context.Status</Tag>
                </PropertyColumn>
            </Table>
        }

        <Title Level="5">@L["Users_ProductAccess"]</Title>
        <Alert Type="@AlertType.Warning" ShowIcon="true" Message="@L["Users_ProductAccessWarning"].Value" Style="margin-bottom:8px;" />
        @if (_access is null) { <Spin /> }
        else if (!_access.IsSuccess) { <Alert Type="@AlertType.Error" Message="@L["Users_ProductAccessUnavailable"].Value" ShowIcon="true" /> }
        else if (_access.Data!.Items.Count == 0) { <Empty Description="@L["Users_ProductAccessEmpty"].Value" /> }
        else
        {
            <Table TItem="ProductAccessAssignmentDto" DataSource="_access.Data.Items" Size="@TableSize.Small" HidePagination Bordered>
                <PropertyColumn Property="c => c.ProductCode" Title="@L["Common_Product"]" />
                <PropertyColumn Property="c => c.OrganizationId" Title="@L["Common_Organization"]" />
                <PropertyColumn Property="c => c.Status" Title="@L["Common_Status"]"><Tag>@context.Status</Tag></PropertyColumn>
            </Table>
        }
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private ApiCallResult<PagedResult<PlatformUserDto>>? _list;
    private ApiCallResult<PlatformUserDto>? _detail;
    private ApiCallResult<PagedResult<OrganizationMembershipDto>>? _memberships;
    private ApiCallResult<PagedResult<ProductAccessAssignmentDto>>? _access;
    private ApiCallResult<PlatformCredentialStatusDto>? _credentials;
    private string _setPassword = "";
    private string _search = "";
    private string _status = "";
    private bool _showCreate;
    private enum LifecycleAction
    {
        Suspend,
        GlobalSuspend,
        Deactivate,
        MoveToSuspended,
        ReactivateFromDeactivated
    }

    private bool _lifecycleModalVisible;
    private LifecycleAction _lifecycleAction;
    private string _lifecycleModalTitle = "";
    private string _lifecycleModalHint = "";
    private string _lifecycleTargetStatus = "";
    private bool _lifecycleRequiresReason;
    private bool _lifecycleRequiresStepUp;
    private string _lifecycleReason = "";
    private string _lifecycleActorPassword = "";
    private string _lifecycleMfaCode = "";
    private string? _fieldLifecycleReason;
    private string? _fieldLifecyclePassword;
    private readonly StaffPersonFieldsModel _staffPerson = new();
    private StaffPersonFieldErrors? _staffPersonErrors;
    private string _newPlatformRole = "";
    private string _editDisplayName = "";
    private string _editEmail = "";
    private string _editFirstName = "";
    private string _editLastName = "";
    private string _editPhone = "";
    private string _editEmployeeCode = "";
    private string _savedDisplayName = "";
    private string _savedEmail = "";
    private string _savedFirstName = "";
    private string _savedLastName = "";
    private string _savedPhone = "";
    private string _savedEmployeeCode = "";
    private string? _formError;
    private bool _formConflict;
    private string? _fieldDisplayName;
    private string? _fieldEmail;
    private string? _fieldPlatformRole;
    private bool _busy;
    private int _page = 1;
    private string? _sortBy;
    private bool _sortDesc;
    private Guid? _loadedId;
    private string? _loadedDirectory;

    private bool CanManage => Permissions.HasPermission(PlatformPermissionCodes.ManagePlatformUsers);
    private bool CanCreatePlatformStaff => DirectoryFilter == "PlatformStaff" && CanManage;

    protected override void OnInitialized()
    {
        // Same component serves /users, /users/unassigned, etc. — parameters do not change,
        // so OnParametersSetAsync alone will not reload when only the directory path changes.
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Shell.EnsureLoadedAsync();
        await Permissions.EnsureLoadedAsync();
        if (!Shell.IsPlatformShell || !Permissions.HasPermission(PlatformPermissionCodes.ManagePlatformUsers))
        {
            return;
        }

        if (Id is null)
        {
            await EnsureDirectoryListAsync(force: false);
        }
        else if (_loadedId != Id || _detail is null)
        {
            _formError = null;
            _formConflict = false;
            ClearFieldErrors();
            _loadedId = Id;
            _loadedDirectory = null;
            await ReloadDetailAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (!Shell.IsPlatformShell
                || !Permissions.Loaded
                || !Permissions.HasPermission(PlatformPermissionCodes.ManagePlatformUsers))
            {
                return;
            }

            if (Id is not null)
            {
                return;
            }

            await EnsureDirectoryListAsync(force: false);
            StateHasChanged();
        });
    }

    private async Task EnsureDirectoryListAsync(bool force)
    {
        var directory = DirectoryFilter;
        if (!force
            && _list is not null
            && _loadedId is null
            && string.Equals(_loadedDirectory, directory, StringComparison.Ordinal))
        {
            return;
        }

        _formError = null;
        _formConflict = false;
        ClearFieldErrors();
        _page = 1;
        _list = null;
        _loadedId = null;
        _loadedDirectory = directory;
        await ReloadListAsync();
    }


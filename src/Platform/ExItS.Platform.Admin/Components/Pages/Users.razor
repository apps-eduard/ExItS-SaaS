    private async Task SubmitLifecycleModalAsync()
    {
        if (Id is null || !AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _fieldLifecycleReason = null;
        _fieldLifecyclePassword = null;
        _formError = null;
        _formConflict = false;

        if (_lifecycleRequiresReason && string.IsNullOrWhiteSpace(_lifecycleReason))
        {
            _fieldLifecycleReason = L["Users_LifecycleReasonRequired"];
            _busy = false;
            return;
        }

        if (_lifecycleRequiresStepUp && string.IsNullOrWhiteSpace(_lifecycleActorPassword))
        {
            _fieldLifecyclePassword = L["Users_ActorPasswordRequired"];
            _busy = false;
            return;
        }

        ApiCallResult<PlatformUserDto> result = _lifecycleAction switch
        {
            LifecycleAction.Suspend => await Api.SuspendUserAsync(Id.Value, _lifecycleReason.Trim()),
            LifecycleAction.GlobalSuspend => await Api.SuspendUserAsync(Id.Value, _lifecycleReason.Trim(), global: true),
            LifecycleAction.Deactivate => await Api.DeactivateUserAsync(
                Id.Value,
                _lifecycleReason.Trim(),
                _lifecycleActorPassword,
                string.IsNullOrWhiteSpace(_lifecycleMfaCode) ? null : _lifecycleMfaCode.Trim()),
            LifecycleAction.MoveToSuspended => await Api.MoveUserToSuspendedAsync(
                Id.Value,
                _lifecycleReason.Trim(),
                _lifecycleActorPassword,
                string.IsNullOrWhiteSpace(_lifecycleMfaCode) ? null : _lifecycleMfaCode.Trim()),
            LifecycleAction.ReactivateFromDeactivated => await Api.ReactivateUserAsync(
                Id.Value,
                new ReactivatePlatformUserRequest(
                    _lifecycleReason.Trim(),
                    _lifecycleActorPassword,
                    string.IsNullOrWhiteSpace(_lifecycleMfaCode) ? null : _lifecycleMfaCode.Trim())),
            _ => new ApiCallResult<PlatformUserDto>(ApiCallStatus.Failed)
        };

        _busy = false;
        if (!result.IsSuccess)
        {
            _formConflict = AdminFormErrorMapper.IsConflict(result.Error);
            _formError = AdminFormErrorMapper.MapPageError(result);
            return;
        }

        CloseLifecycleModal();
        var toast = _lifecycleAction switch
        {
            LifecycleAction.Suspend or LifecycleAction.GlobalSuspend => L["Users_ToastSuspended"].Value,
            LifecycleAction.Deactivate => L["Users_ToastDeactivated"].Value,
            LifecycleAction.MoveToSuspended => L["Users_ToastMovedToSuspended"].Value,
            _ => L["Users_ToastReactivated"].Value
        };
        await Message.SuccessAsync(toast);
        await ReloadDetailAsync();
    }

    private void ClearFieldErrors()
    {
        _fieldDisplayName = _fieldEmail = _fieldPlatformRole = null;
    }

@page "/admin/organizations/{OrganizationId:guid}/enabled-products"
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject ToastService Toasts
@inject IStringLocalizer<AdminResources> L
@inject PlatformPermissionState Permissions
@inject AdminShellContext Shell
@inject NavigationManager Nav

@if (!Permissions.Loaded)
{
    <LoadingState />
}
else if (!CanAccessPage)
{
    <UnauthorizedPanel RequiredPermission="@PlatformPermissionCodes.ManageProductAccess" />
}
else
{
    <AdminPageHeader Title="@(CanManageRoles ? L["OrgEnabledProducts_Title"] : L["Nav_MyProducts"])"
                     Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_SectionProducts"]} / {(CanManageRoles ? L["OrgEnabledProducts_Title"] : L["Nav_MyProducts"])}")"
                     Description="@L["OrgEnabledProducts_Description"]" />
    <Alert Type="@AlertType.Info" ShowIcon="true" Message="@L["OrgEnabledProducts_Warning"]" Style="margin-bottom:1rem;" />

    <p>
        <a href="/admin/organizations/@OrganizationId">← @L["Common_BackToSummary"]</a>
        @if (CanManageRoles)
        {
            <text> · </text>
            <a href="#manage-staff-access">@L["OrgEnabledProducts_ManageStaffAccess"]</a>
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <ErrorState Title="@L["Common_ActionFailed"]" Detail="@_formError" />
    }

    <AdminDataPanel IsLoading="@(_products is null)"
                    HasError="@(_products is { IsSuccess: false })"
                    IsEmpty="@(_products is { IsSuccess: true, Data.Count: 0 })"
                    LoadingMessage="@L["OrgEnabledProducts_Loading"]"
                    EmptyMessage="@L["OrgEnabledProducts_Empty"]"
                    ErrorTitle="@L["OrgEnabledProducts_Unavailable"]"
                    ErrorDetail="@_products?.Error?.Detail">
        <div class="form-grid" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;">
            @foreach (var product in DeduplicatedProducts)
            {
                var title = ProductTitle(product);
                <Card Class="admin-elevated-card" Size="@CardSize.Small" Title="@title" Style="margin-bottom:0;">
                    <ChildContent>
                        <dl style="margin:0;">
                            <dt>@L["OrgEnabledProducts_Entitlement"]</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(product.EntitlementStatus))
                                {
                                    <AdminStatusTag Value="@product.EntitlementStatus" />
                                }
                                else
                                {
                                    @(product.EntitlementActive ? L["OrgEnabledProducts_EntitlementEnabled"] : L["OrgEnabledProducts_EntitlementDisabled"])
                                }
                            </dd>
                            <dt>@L["OrgEnabledProducts_Provisioning"]</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(product.ProvisioningStatus))
                                {
                                    <AdminStatusTag Value="@product.ProvisioningStatus" />
                                }
                                else
                                {
                                    @L["Common_EmDash"]
                                }
                            </dd>
                            <dt>@L["OrgEnabledProducts_YourRole"]</dt>
                            <dd>@YourRoleLabel(product)</dd>
                            @if (!product.CanLaunch && !string.IsNullOrWhiteSpace(FriendlyDenial(product)))
                            {
                                <dt>@L["Common_Reason"]</dt>
                                <dd>@FriendlyDenial(product)</dd>
                            }
                        </dl>
                        <Space Wrap Style="margin-top:12px;">
                            @if (product.CanLaunch)
                            {
                                <Button Type="@ButtonType.Primary"
                                        Size="@ButtonSize.Small"
                                        Disabled="_busy"
                                        OnClick="@(() => LaunchAsync(product))">
                                    @L["OrgEnabledProducts_OpenProduct"]
                                </Button>
                            }
                            else
                            {
                                <Button Type="@ButtonType.Default" Size="@ButtonSize.Small" Disabled="true">
                                    @L["OrgEnabledProducts_LaunchDenied"]
                                </Button>
                            }
                            @if (CanManageRoles)
                            {
                                <Button Size="@ButtonSize.Small"
                                        OnClick="@(() => FocusManageAccess(product))">
                                    @L["OrgEnabledProducts_ManageStaffAccess"]
                                </Button>
                            }
                        </Space>
                    </ChildContent>
                </Card>
            }
        </div>
    </AdminDataPanel>

    @if (CanManageRoles)
    {
        <div id="manage-staff-access">
            <Card Class="admin-elevated-card" Size="@CardSize.Small" Title="@L["OrgEnabledProducts_ManageStaffAccess"]" Style="margin-top:1rem;margin-bottom:12px;">
                <ChildContent>
                    <div class="form-grid">
                        <FormField Label="@L["OrgEnabledProducts_SelectStaff"]" FieldId="role-staff" Required="true">
                            <Select TItemValue="string"
                                    TItem="string"
                                    Style="width:100%"
                                    Disabled="_busy || _staffOptions.Count == 0"
                                    @bind-Value="_selectedStaffUserId"
                                    Placeholder="@L["OrgEnabledProducts_SelectStaff"]">
                                <SelectOptions>
                                    @foreach (var member in _staffOptions)
                                    {
                                        <SelectOption TItemValue="string"
                                                      TItem="string"
                                                      Value="@member.UserId.ToString("D")"
                                                      Label="@StaffLabel(member)" />
                                    }
                                </SelectOptions>
                            </Select>
                        </FormField>
                        <FormField Label="@L["OrgEnabledProducts_SelectProduct"]" FieldId="role-product" Required="true">
                            <Select TItemValue="string"
                                    TItem="string"
                                    Style="width:100%"
                                    Disabled="_busy || DeduplicatedProducts.Count == 0"
                                    @bind-Value="_selectedProductKey"
                                    Placeholder="@L["OrgEnabledProducts_SelectProduct"]">
                                <SelectOptions>
                                    @foreach (var product in DeduplicatedProducts)
                                    {
                                        <SelectOption TItemValue="string"
                                                      TItem="string"
                                                      Value="@(product.ProductKey ?? product.ProductCode)"
                                                      Label="@ProductTitle(product)" />
                                    }
                                </SelectOptions>
                            </Select>
                        </FormField>
                        <FormField Label="@L["OrgEnabledProducts_SelectProductRole"]" FieldId="role-code" Required="true">
                            <Select TItemValue="string"
                                    TItem="string"
                                    Style="width:100%"
                                    Disabled="_busy"
                                    @bind-Value="_roleCode">
                                <SelectOptions>
                                    <SelectOption TItemValue="string" TItem="string" Value="@("Owner")" Label="POS Owner" />
                                    <SelectOption TItemValue="string" TItem="string" Value="@("Manager")" Label="Store Manager" />
                                    <SelectOption TItemValue="string" TItem="string" Value="@("Cashier")" Label="Cashier" />
                                    <SelectOption TItemValue="string" TItem="string" Value="@("Viewer")" Label="Reporting User" />
                                </SelectOptions>
                            </Select>
                        </FormField>
                        <FormField Label="@L["Common_Reason"]" FieldId="role-reason">
                            <AdminInput @bind-Value="_roleReason" Disabled="_busy" />
                        </FormField>
                    </div>
                    <FormActions PrimaryText="@L["OrgEnabledProducts_AssignRole"]" Busy="_busy" OnPrimary="AssignRoleAsync" />
                </ChildContent>
            </Card>
        </div>

        <AdminDataPanel IsLoading="@(_roles is null)"
                        HasError="@(_roles is { IsSuccess: false })"
                        IsEmpty="@(_roles is { IsSuccess: true, Data.Count: 0 })"
                        LoadingMessage="@L["OrgEnabledProducts_LoadingRoles"]"
                        EmptyMessage="@L["OrgEnabledProducts_RolesEmpty"]"
                        ErrorTitle="@L["OrgEnabledProducts_RolesUnavailable"]"
                        ErrorDetail="@_roles?.Error?.Detail">
            <AdminDataTable TItem="ProductLocalRoleGrantDto"
                            Items="_roles!.Data!"
                            Columns="_roleColumns"
                            Caption="@L["OrgEnabledProducts_RolesTitle"]"
                            ItemKey="r => r.Id"
                            CellTemplate="RoleCell"
                            RowActions="RoleActions"
                            ActionsHeader="@L["Common_Actions"]" />
        </AdminDataPanel>
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true"
                   Title="@_confirm.Title"
                   Message="@_confirm.Message"
                   Kind="AdminDialogKind.Destructive"
                   OnConfirm="RunConfirmAsync"
                   OnCancel="ClearConfirm"
                   Busy="_busy" />
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }

    private ApiCallResult<IReadOnlyList<EnabledProductDto>>? _products;
    private ApiCallResult<IReadOnlyList<ProductLocalRoleGrantDto>>? _roles;
    private List<OrganizationMembershipDto> _staffOptions = [];
    private List<AdminColumnDefinition> _roleColumns = new();
    private string _selectedStaffUserId = "";
    private string _selectedProductKey = "";
    private string _roleCode = "Cashier";
    private string _roleReason = "";
    private string? _formError;
    private bool _busy;
    private ConfirmState? _confirm;

    private bool CanAccessPage =>
        Permissions.HasPermission(PlatformPermissionCodes.ManageProductAccess)
        || (Shell.IsOrganizationShell
            && Shell.SelectedOrganizationId == OrganizationId
            && Shell.SelectedOrganizationId is not null);

    private bool CanManageRoles =>
        Permissions.HasPermission(PlatformPermissionCodes.ManageMemberships)
        || IsOrgAdminMembership;

    private bool IsOrgAdminMembership =>
        string.Equals(Shell.MembershipRole, "OrganizationOwner", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Shell.MembershipRole, "OrganizationAdministrator", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<EnabledProductDto> DeduplicatedProducts
    {
        get
        {
            if (_products?.Data is null)
            {
                return Array.Empty<EnabledProductDto>();
            }

            // Prefer ProductId; fall back to ProductKey so multiple grants never duplicate cards.
            var byId = new List<EnabledProductDto>();
            var seenIds = new HashSet<Guid>();
            var seenKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var product in _products.Data)
            {
                if (product.ProductId is Guid id && !seenIds.Add(id))
                {
                    continue;
                }

                var key = (product.ProductKey ?? product.ProductCode).Trim();
                if (!seenKeys.Add(key))
                {
                    continue;
                }

                byId.Add(product);
            }

            return byId;
        }
    }

    protected override void OnInitialized()
    {
        _roleColumns =
        [
            new("user", L["Common_User"], Primary: true),
            new("product", L["Common_Product"]),
            new("role", L["OrgEnabledProducts_Role"]),
            new("status", L["Common_Status"]),
            new("granted", L["Common_GrantedUtc"])
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        await Permissions.EnsureLoadedAsync();
        await Shell.EnsureLoadedAsync();
        if (!CanAccessPage)
        {
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _products = await Api.GetEnabledProductsAsync(OrganizationId);
        if (_products is { IsSuccess: true, Data.Count: > 0 }
            && string.IsNullOrWhiteSpace(_selectedProductKey))
        {
            var first = DeduplicatedProducts.FirstOrDefault();
            if (first is not null)
            {
                _selectedProductKey = first.ProductKey ?? first.ProductCode;
            }
        }

        if (CanManageRoles)
        {
            _roles = await Api.GetProductLocalRolesAsync(OrganizationId, status: "Active");
            var members = await Api.GetOrganizationMembersAsync(OrganizationId, page: 1, pageSize: 100, status: "Active");
            _staffOptions = members is { IsSuccess: true, Data: not null }
                ? members.Data.Items.ToList()
                : [];
            if (string.IsNullOrWhiteSpace(_selectedStaffUserId) && _staffOptions.Count > 0)
            {
                _selectedStaffUserId = _staffOptions[0].UserId.ToString("D");
            }
        }
    }

    private string YourRoleLabel(EnabledProductDto product)
    {
        if (!string.IsNullOrWhiteSpace(product.ProductRole))
        {
            return product.ProductRole!;
        }

        var mapped = FormatProductRole(product.ProductLocalRoleCode);
        return string.IsNullOrWhiteSpace(mapped) ? L["Common_EmDash"] : mapped;
    }

    private string ProductTitle(EnabledProductDto product) =>
        !string.IsNullOrWhiteSpace(product.ProductDisplayName)
            ? product.ProductDisplayName!
            : !string.IsNullOrWhiteSpace(product.DisplayName)
                ? product.DisplayName
                : L["Common_Product"];

    private static string FriendlyDenial(EnabledProductDto product) =>
        !string.IsNullOrWhiteSpace(product.DenialReasonDisplay)
            ? product.DenialReasonDisplay!
            : MapDenial(product.DenialReasonCode ?? product.ReasonCode);

    private static string MapDenial(string? reasonCode) => reasonCode switch
    {
        "product_local_role_missing" => "You do not have a role assigned for this Product.",
        "product_assignment_missing" => "Product access has not been granted for your account in this Organization.",
        "entitlement_missing" or "entitlement_denied" => "This Organization is not entitled to use this Product.",
        "membership_missing" or "membership_inactive" => "Your Organization membership is not active.",
        "user_inactive" => "Your account is not active.",
        "organization_inactive" => "This Organization is not active.",
        "allowed" or null or "" => string.Empty,
        _ => "You cannot open this Product right now."
    };

    private static string FormatProductRole(string? roleCode) => roleCode?.Trim() switch
    {
        "Owner" or "POS Owner" or "PosOwner" => "POS Owner",
        "Manager" or "StoreManager" or "Store Manager" => "Store Manager",
        "Cashier" => "Cashier",
        "Viewer" or "ReportingUser" or "Reporting User" => "Reporting User",
        _ => roleCode ?? string.Empty
    };

    private static string FormatOrgRole(string? role) => role switch
    {
        "OrganizationOwner" => "Organization Owner",
        "OrganizationAdministrator" => "Organization Administrator",
        "OrganizationMember" => "Organization Staff",
        _ => role ?? string.Empty
    };

    private static string StaffLabel(OrganizationMembershipDto member)
    {
        var name = string.IsNullOrWhiteSpace(member.DisplayName) ? member.Email ?? member.Username : member.DisplayName;
        var orgRole = member.RoleDisplay ?? FormatOrgRole(member.Role);
        return string.IsNullOrWhiteSpace(orgRole) ? name ?? "Staff" : $"{name} ({orgRole})";
    }

    private void FocusManageAccess(EnabledProductDto product)
    {
        _selectedProductKey = product.ProductKey ?? product.ProductCode;
        Nav.NavigateTo($"/admin/organizations/{OrganizationId}/enabled-products#manage-staff-access", forceLoad: false);
    }

    private RenderFragment<(ProductLocalRoleGrantDto Item, AdminColumnDefinition Column)> RoleCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "user":
                b.AddContent(0, string.IsNullOrWhiteSpace(ctx.Item.UserDisplayName)
                    ? ctx.Item.UserIdentityId.ToString("D")
                    : ctx.Item.UserDisplayName);
                break;
            case "product":
                b.AddContent(0, string.IsNullOrWhiteSpace(ctx.Item.ProductDisplayName)
                    ? ctx.Item.ProductCode
                    : ctx.Item.ProductDisplayName);
                break;
            case "role":
                b.AddContent(0, string.IsNullOrWhiteSpace(ctx.Item.RoleDisplay)
                    ? FormatProductRole(ctx.Item.RoleCode)
                    : ctx.Item.RoleDisplay);
                break;
            case "status":
                b.OpenComponent<AdminStatusTag>(0);
                b.AddAttribute(1, nameof(AdminStatusTag.Value), ctx.Item.Status);
                b.CloseComponent();
                break;
            case "granted":
                b.OpenComponent<LocalTimestamp>(0);
                b.AddAttribute(1, nameof(LocalTimestamp.Value), ctx.Item.GrantedAtUtc);
                b.CloseComponent();
                break;
        }
    };

    private RenderFragment<ProductLocalRoleGrantDto> RoleActions => item => b =>
    {
        if (!string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        b.OpenElement(0, "button");
        b.AddAttribute(1, "type", "button");
        b.AddAttribute(2, "class", "danger");
        b.AddAttribute(3, "disabled", _busy);
        b.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () =>
            Ask(L["OrgEnabledProducts_RevokeRole"], L["OrgEnabledProducts_RevokeConfirm"], () => RevokeRoleAsync(item.Id))));
        b.AddContent(5, L["OrgEnabledProducts_RevokeRole"]);
        b.CloseElement();
    };

    private async Task LaunchAsync(EnabledProductDto product)
    {
        _formError = null;
        _busy = true;
        try
        {
            var productKey = product.ProductKey ?? product.ProductCode;
            var result = await Api.LaunchProductAsync(OrganizationId, productKey);
            if (!result.IsSuccess || result.Data is null)
            {
                _formError = result.Error?.Detail
                    ?? FriendlyDenial(product)
                    ?? L["OrgEnabledProducts_LaunchDenied"];
                return;
            }

            Nav.NavigateTo(result.Data.LaunchPath);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AssignRoleAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        if (!Guid.TryParse(_selectedStaffUserId, out var userId) || userId == Guid.Empty)
        {
            _formError = L["OrgEnabledProducts_SelectStaffRequired"];
            _busy = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedProductKey))
        {
            _formError = L["OrgEnabledProducts_SelectProductRequired"];
            _busy = false;
            return;
        }

        if (_staffOptions.All(m => m.UserId != userId))
        {
            _formError = L["OrgEnabledProducts_StaffNotInOrganization"];
            _busy = false;
            return;
        }

        var result = await Api.AssignProductLocalRoleAsync(
            OrganizationId,
            new AssignProductLocalRoleRequest(userId, _selectedProductKey.Trim(), _roleCode, _roleReason));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formError = result.Error?.Detail ?? result.Error?.Title;
            return;
        }

        Toasts.Show(L["OrgEnabledProducts_ToastRoleAssigned"], ToastKind.Success);
        await ReloadAsync();
    }

    private void Ask(string title, string message, Func<Task> action) =>
        _confirm = new ConfirmState(title, message, action);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private Task ClearConfirm()
    {
        _confirm = null;
        return Task.CompletedTask;
    }

    private async Task RevokeRoleAsync(Guid grantId)
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        var result = await Api.RevokeProductLocalRoleAsync(
            OrganizationId,
            grantId,
            new RevokeProductLocalRoleRequest(L["OrgEnabledProducts_RevokeAuditReason"]));
        _busy = false;
        await ClearConfirm();
        if (!result.IsSuccess)
        {
            _formError = result.Error?.Detail ?? result.Error?.Title;
            return;
        }

        Toasts.Show(L["OrgEnabledProducts_ToastRoleRevoked"], ToastKind.Success);
        await ReloadAsync();
    }

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action);
}

@page "/admin/register"
@layout EmptyLayout
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Brand_Name"] — Register</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-login-brand">
                <span class="exits-brand-mark">EA</span>
                <span>@L["Register_Title"]</span>
            </div>
        </TitleTemplate>
        <Body>
            <Paragraph Type="@TextElementType.Secondary">@L["Register_Hint"]</Paragraph>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <Alert Type="@AlertType.Error" Message="@Error" ShowIcon="true" Style="margin-bottom: 1rem;" />
            }

            @if (Done)
            {
                <Alert Type="@AlertType.Success" Message="@L["Register_Success"]" ShowIcon="true" Style="margin-bottom: 1rem;" />
                <Paragraph>
                    <a href="http://localhost:8025" target="_blank" rel="noopener">Open Mailpit</a>
                    · <a href="/admin/login">@L["Login_SignIn"]</a>
                </Paragraph>
            }
            else
            {
                @* Native form POST — Interactive Server OnClick is not available without a circuit (Mailpit / Docker). *@
                <form method="post" action="/admin/register/submit" class="exits-login-form">
                    <div class="ant-form-item">
                        <label class="ant-form-item-label" for="reg-displayname">@L["Common_DisplayName"]</label>
                        <input id="reg-displayname"
                               name="DisplayName"
                               type="text"
                               class="ant-input"
                               autocomplete="name"
                               required
                               value="@DisplayName" />
                    </div>
                    <div class="ant-form-item">
                        <label class="ant-form-item-label" for="reg-email">@L["Common_Email"]</label>
                        <input id="reg-email"
                               name="Email"
                               type="email"
                               class="ant-input"
                               autocomplete="email"
                               required
                               value="@Email" />
                    </div>
                    <div class="ant-form-item">
                        <label>
                            <input type="checkbox" name="AcceptTerms" value="true" />
                            @L["Register_AcceptTerms"]
                        </label>
                    </div>
                    <button type="submit" class="ant-btn ant-btn-primary ant-btn-block ant-btn-sm">
                        @L["Register_Submit"]
                    </button>
                    <div class="exits-login-links">
                        <a href="/admin/login">@L["Login_SignIn"]</a>
                    </div>
                </form>
            }
        </Body>
    </Card>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "done")]
    public string? DoneQuery { get; set; }

    [SupplyParameterFromQuery(Name = "displayName")]
    public string? DisplayName { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private bool Done =>
        string.Equals(DoneQuery, "1", StringComparison.OrdinalIgnoreCase)
        || string.Equals(DoneQuery, "true", StringComparison.OrdinalIgnoreCase);
}

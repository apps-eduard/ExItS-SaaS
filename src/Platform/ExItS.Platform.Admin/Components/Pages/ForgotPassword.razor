@page "/admin/forgot-password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Brand_Name"] — Forgot password</PageTitle>

<div class="login-shell">
    <div class="login-panel page-frame page-frame--form">
        <h1>Forgot password</h1>
        <p class="muted">If an eligible account exists, a reset token is issued. Email vendor delivery is not configured in this release — use the secure operator channel or non-Production debug token when enabled.</p>
        @if (!string.IsNullOrWhiteSpace(_message)) { <div class="form-validation-summary" role="status">@_message</div> }
        @if (!string.IsNullOrWhiteSpace(_debugToken))
        {
            <p class="muted">Debug token (non-Production only): <code>@_debugToken</code></p>
            <p><a href="/admin/reset-password">Continue to reset</a></p>
        }
        <EditForm Model="_model" OnValidSubmit="OnSubmitAsync" FormName="forgot-password">
            <div class="form-field">
                <label class="form-field-label" for="id">Username or email</label>
                <InputText id="id" class="form-control" @bind-Value="_model.UsernameOrEmail" autocomplete="username" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary" disabled="@_busy">@(_busy ? "Submitting…" : "Request reset")</button>
                <a href="/admin/login">Back to sign in</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly Model _model = new();
    private string? _message;
    private string? _debugToken;
    private bool _busy;

    private async Task OnSubmitAsync()
    {
        _busy = true;
        _message = null;
        _debugToken = null;
        try
        {
            var result = await Api.ForgotPasswordAsync(new ForgotPasswordRequest(_model.UsernameOrEmail));
            _message = result.IsSuccess
                ? (result.Data?.Message ?? "If an eligible account exists, a password reset token was issued.")
                : (result.Error?.Detail ?? "Request failed.");
            _debugToken = result.Data?.DebugToken;
        }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string UsernameOrEmail { get; set; } = string.Empty;
    }
}

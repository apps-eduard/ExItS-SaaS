@page "/admin/forgot-password"
@layout EmptyLayout
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Brand_Name"] — Forgot password</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-login-brand">
                <span class="exits-brand-mark">EA</span>
                <span>@L["Login_ForgotPassword"]</span>
            </div>
        </TitleTemplate>
        <Body>
            <Paragraph Type="@TextElementType.Secondary">
                If an eligible account exists, a reset message is sent. During Local Validation, open Mailpit at http://localhost:8025.
            </Paragraph>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <Alert Type="@AlertType.Error" Message="@Error" ShowIcon="true" Style="margin-bottom: 1rem;" />
            }

            @if (Done)
            {
                <Alert Type="@AlertType.Success" Message="If an eligible account exists, a password reset token was issued." ShowIcon="true" Style="margin-bottom: 1rem;" />
                <Paragraph>
                    <a href="http://localhost:8025" target="_blank" rel="noopener">Open Mailpit</a>
                    · <a href="/admin/login">@L["Login_SignIn"]</a>
                </Paragraph>
            }
            else
            {
                @* Native form POST — Interactive Server OnClick is not available without a circuit. *@
                <form method="post" action="/admin/forgot-password/submit" class="exits-login-form">
                    <div class="ant-form-item">
                        <label class="ant-form-item-label" for="forgot-id">@L["Login_Email"]</label>
                        <input id="forgot-id"
                               name="UsernameOrEmail"
                               type="text"
                               class="ant-input"
                               autocomplete="username"
                               required />
                    </div>
                    <button type="submit" class="ant-btn ant-btn-primary ant-btn-block ant-btn-sm">
                        Request reset
                    </button>
                    <div class="exits-login-links">
                        <a href="/admin/login">@L["Login_SignIn"]</a>
                    </div>
                </form>
            }
        </Body>
    </Card>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "done")]
    public string? DoneQuery { get; set; }

    private bool Done =>
        string.Equals(DoneQuery, "1", StringComparison.OrdinalIgnoreCase)
        || string.Equals(DoneQuery, "true", StringComparison.OrdinalIgnoreCase);
}

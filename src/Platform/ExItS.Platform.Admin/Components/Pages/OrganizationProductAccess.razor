@page "/admin/organizations/{OrganizationId:guid}/product-access"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject IStringLocalizer<AdminResources> L

<PageHeader Title="@L["OrgProductAccess_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Organizations"]} / {L["Common_ProductAccess"]}")" Description="@L["OrgProductAccess_Description"]" />
<div class="warning" role="note">@L["OrgProductAccess_Warning"]</div>

@if (_org is null) { <LoadingState Message="@L["OrgProductAccess_Loading"]" /> }
else if (!_org.IsSuccess) { <ErrorState Title="@(_org.Error?.Title ?? L["Common_Error"])" Detail="@_org.Error?.Detail" Unavailable="@(_org.Status == ApiCallStatus.Unavailable)" /> }
else
{
    <p><a href="/admin/organizations/@OrganizationId">← @_org.Data!.DisplayName @L["Common_CommercialSummary"]</a> · <a href="/admin/organizations/@OrganizationId/members">@L["Common_Members"]</a></p>
    @if (!string.IsNullOrWhiteSpace(_toast)) { <p class="toast" role="status">@_toast</p> }
    @if (!string.IsNullOrWhiteSpace(_formError)) { <ErrorState Title="@L["Common_ActionFailed"]" Detail="@_formError" /> }

    <section class="panel" aria-label="@L["OrgProductAccess_AriaGrant"]">
        <h2>@L["OrgProductAccess_GrantSection"]</h2>
        <div class="form-grid">
            <label>@L["OrgMembers_UserId"] <input @bind="_grantUserId" placeholder="@L["OrgProductAccess_GrantUserIdPlaceholder"]" /></label>
            <label>@L["OrgProductAccess_ProductCode"] <input @bind="_grantProductCode" placeholder="e.g. pinoybusinesspos" /></label>
            <label>@L["Common_Reason"] <input @bind="_grantReason" /></label>
        </div>
        <div class="actions">
            <button type="button" @onclick="GrantAsync" disabled="@_busy">@L["OrgProductAccess_GrantAccess"]</button>
        </div>
    </section>

    <section class="panel" aria-label="@L["OrgProductAccess_AriaEvaluate"]">
        <h2>@L["OrgProductAccess_EvaluateSection"]</h2>
        <div class="form-grid">
            <label>@L["OrgMembers_UserId"] <input @bind="_evalUserId" /></label>
            <label>@L["OrgProductAccess_ProductCode"] <input @bind="_evalProductCode" /></label>
        </div>
        <div class="actions">
            <button type="button" class="secondary" @onclick="EvaluateAsync" disabled="@_busy">@L["Common_Evaluate"]</button>
        </div>
        @if (_evaluation is not null)
        {
            @if (!_evaluation.IsSuccess) { <ErrorState Title="@L["OrgProductAccess_EvaluationFailed"]" Detail="@_evaluation.Error?.Detail" /> }
            else
            {
                var e = _evaluation.Data!;
                <AccessStateIndicator Allowed="@e.Allowed" ReasonCode="@e.ReasonCode" />
                <dl>
                    <dt>@L["Common_Membership"]</dt><dd>@(e.MembershipId?.ToString() ?? "—")</dd>
                    <dt>@L["Common_Assignment"]</dt><dd>@(e.AssignmentId?.ToString() ?? "—")</dd>
                    <dt>@L["Common_Subscription"]</dt><dd>@(e.SubscriptionId?.ToString() ?? "—")</dd>
                    <dt>@L["Common_Snapshot"]</dt><dd>@(e.SnapshotId?.ToString() ?? "—")</dd>
                    <dt>@L["Common_EvaluatedUtc"]</dt><dd><UtcTimestamp Value="@e.EvaluatedAtUtc" /></dd>
                </dl>
            }
        }
    </section>

    <div class="filters">
        <label>@L["Common_Status"]
            <select @bind="_status">
                <option value="">@L["Common_All"]</option>
                <option>Active</option>
                <option>Revoked</option>
            </select>
        </label>
        <button type="button" @onclick="ReloadAsync">@L["Common_Apply"]</button>
    </div>

    @if (_assignments is null) { <LoadingState Message="@L["OrgProductAccess_LoadingAssignments"]" /> }
    else if (!_assignments.IsSuccess) { <ErrorState Title="@L["OrgProductAccess_AssignmentsUnavailable"]" Detail="@_assignments.Error?.Detail" /> }
    else if (_assignments.Data!.Items.Count == 0) { <EmptyState Message="@L["OrgProductAccess_Empty"]" /> }
    else
    {
        <table class="data-table responsive-table">
            <thead><tr><th>@L["Common_User"]</th><th>@L["Common_Product"]</th><th>@L["Common_Status"]</th><th>@L["Common_GrantedUtc"]</th><th>@L["Common_RevokedUtc"]</th><th>@L["Common_Actions"]</th></tr></thead>
            <tbody>
            @foreach (var a in _assignments.Data.Items)
            {
                <tr>
                    <td data-label="@L["Common_User"]"><a href="/admin/users/@a.UserId">@a.UserId</a></td>
                    <td data-label="@L["Common_Product"]">@a.ProductCode</td>
                    <td data-label="@L["Common_Status"]"><StatusBadge Value="@a.Status" /></td>
                    <td data-label="@L["Common_GrantedUtc"]"><UtcTimestamp Value="@a.GrantedAtUtc" /></td>
                    <td data-label="@L["Common_RevokedUtc"]">@(a.RevokedAtUtc is null ? "—" : null)@if (a.RevokedAtUtc is not null){<UtcTimestamp Value="@a.RevokedAtUtc.Value" />}</td>
                    <td data-label="@L["Common_Actions"]">
                        @if (a.Status == "Active")
                        {
                            <button type="button" class="danger" @onclick='() => Ask(L["OrgProductAccess_RevokeAccess"], "Revoke commercial product access for this user? Historical assignment remains queryable.", () => RevokeAsync(a.Id))'>@L["OrgProductAccess_RevokeAccess"]</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true" Title="@_confirm.Title" Message="@_confirm.Message" OnConfirm="RunConfirmAsync" OnCancel="ClearConfirm" Busy="_busy" />
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    private ApiCallResult<OrganizationDto>? _org;
    private ApiCallResult<PagedResult<ProductAccessAssignmentDto>>? _assignments;
    private ApiCallResult<EffectiveProductAccessResultDto>? _evaluation;
    private string _status = "";
    private string _grantUserId = "";
    private string _grantProductCode = "";
    private string _grantReason = "";
    private string _evalUserId = "";
    private string _evalProductCode = "";
    private string? _toast;
    private string? _formError;
    private bool _busy;
    private ConfirmState? _confirm;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _org = await Api.GetOrganizationAsync(OrganizationId);
        _assignments = await Api.GetOrganizationProductAccessAsync(OrganizationId, status: string.IsNullOrWhiteSpace(_status) ? null : _status);
    }

    private async Task GrantAsync()
    {
        _formError = null; _toast = null;
        if (!Guid.TryParse(_grantUserId, out var userId)) { _formError = "User ID must be a valid GUID."; return; }
        _busy = true;
        var result = await Api.GrantProductAccessAsync(OrganizationId, new GrantProductAccessRequest(userId, _grantProductCode, "dev-admin", _grantReason));
        _busy = false;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Product access granted.";
        await ReloadAsync();
    }

    private async Task EvaluateAsync()
    {
        _formError = null;
        if (!Guid.TryParse(_evalUserId, out var userId)) { _formError = "User ID must be a valid GUID."; return; }
        _busy = true;
        _evaluation = await Api.EvaluateAccessAsync(userId, OrganizationId, _evalProductCode);
        _busy = false;
    }

    private void Ask(string title, string message, Func<Task> action) => _confirm = new ConfirmState(title, message, action);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private Task ClearConfirm()
    {
        _confirm = null;
        return Task.CompletedTask;
    }

    private async Task RevokeAsync(Guid assignmentId)
    {
        _busy = true; _formError = null;
        var result = await Api.RevokeProductAccessAsync(assignmentId, new RevokeProductAccessRequest("dev-admin", "Revoked from Admin"));
        _busy = false; _confirm = null;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Product access revoked; history retained.";
        await ReloadAsync();
    }

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action);
}

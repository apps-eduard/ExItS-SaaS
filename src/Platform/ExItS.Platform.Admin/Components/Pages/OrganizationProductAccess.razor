@page "/admin/organizations/{OrganizationId:guid}/product-access"
@rendermode InteractiveServer
@inject IPlatformApiClient Api
@inject ToastService Toasts
@inject IStringLocalizer<AdminResources> L

<AdminPageHeader Title="@L["OrgProductAccess_Title"]" Breadcrumb="@($"{L["Brand_Name"]} / {L["Nav_Organizations"]} / {L["Common_ProductAccess"]}")" Description="@L["OrgProductAccess_Description"]" />
<div class="warning" role="note">@L["OrgProductAccess_Warning"]</div>

@if (_org is null) { <LoadingState Message="@L["OrgProductAccess_Loading"]" /> }
else if (!_org.IsSuccess) { <ErrorState Title="@(_org.Error?.Title ?? L["Common_Error"])" Detail="@_org.Error?.Detail" Unavailable="@(_org.Status == ApiCallStatus.Unavailable)" /> }
else
{
    <p>
        <a href="/admin/organizations/@OrganizationId">← @_org.Data!.DisplayName — @L["Common_BackToSummary"]</a>
        ·
        <a href="/admin/organizations/@OrganizationId/members">@L["Common_Members"]</a>
    </p>
    @if (!string.IsNullOrWhiteSpace(_formError)) { <ErrorState Title="@L["Common_ActionFailed"]" Detail="@_formError" /> }

    <FormSection Title="@L["OrgProductAccess_GrantSection"]">
        <div class="form-grid">
            <FormField Label="@L["OrgMembers_UserId"]" FieldId="grant-user" Required="true">
                <AdminInput @bind-Value="_grantUserId" Placeholder="@L["OrgProductAccess_GrantUserIdPlaceholder"]" Disabled="_busy" />
            </FormField>
            <FormField Label="@L["OrgProductAccess_ProductCode"]" FieldId="grant-product" Required="true">
                <AdminInput @bind-Value="_grantProductCode" Placeholder="@L["OrgProductAccess_ProductCodePlaceholder"]" Disabled="_busy" />
            </FormField>
            <FormField Label="@L["Common_Reason"]" FieldId="grant-reason">
                <AdminInput @bind-Value="_grantReason" Disabled="_busy" />
            </FormField>
        </div>
        <FormActions PrimaryText="@L["OrgProductAccess_GrantAccess"]" Busy="_busy" OnPrimary="GrantAsync" />
    </FormSection>

    <FormSection Title="@L["OrgProductAccess_EvaluateSection"]">
        <div class="form-grid">
            <FormField Label="@L["OrgMembers_UserId"]" FieldId="eval-user" Required="true">
                <AdminInput @bind-Value="_evalUserId" Disabled="_busy" />
            </FormField>
            <FormField Label="@L["OrgProductAccess_ProductCode"]" FieldId="eval-product" Required="true">
                <AdminInput @bind-Value="_evalProductCode" Disabled="_busy" />
            </FormField>
        </div>
        <div class="actions">
            <button type="button" class="secondary" @onclick="EvaluateAsync" disabled="@_busy">@L["Common_Evaluate"]</button>
        </div>
        @if (_evaluation is not null)
        {
            @if (!_evaluation.IsSuccess) { <ErrorState Title="@L["OrgProductAccess_EvaluationFailed"]" Detail="@_evaluation.Error?.Detail" /> }
            else
            {
                var e = _evaluation.Data!;
                <AccessStateIndicator Allowed="@e.Allowed" ReasonCode="@e.ReasonCode" />
                <dl>
                    <dt>@L["Common_Membership"]</dt><dd>@(e.MembershipId?.ToString() ?? L["Common_EmDash"])</dd>
                    <dt>@L["Common_Assignment"]</dt><dd>@(e.AssignmentId?.ToString() ?? L["Common_EmDash"])</dd>
                    <dt>@L["Common_Subscription"]</dt><dd>@(e.SubscriptionId?.ToString() ?? L["Common_EmDash"])</dd>
                    <dt>@L["Common_Snapshot"]</dt><dd>@(e.SnapshotId?.ToString() ?? L["Common_EmDash"])</dd>
                    <dt>@L["Common_EvaluatedUtc"]</dt><dd><UtcTimestamp Value="@e.EvaluatedAtUtc" /></dd>
                </dl>
            }
        }
    </FormSection>

    <div class="filters" role="search" aria-label="@L["Common_Filter"]">
        <label>@L["Common_Status"]
            <select @bind="_status">
                <option value="">@L["Common_All"]</option>
                <option value="Active">@L["Status_Active"]</option>
                <option value="Revoked">@L["Status_Revoked"]</option>
            </select>
        </label>
        <button type="button" @onclick="ReloadAsync">@L["Common_Apply"]</button>
    </div>

    <AdminDataPanel IsLoading="@(_assignments is null)"
                    HasError="@(_assignments is { IsSuccess: false })"
                    IsEmpty="@(_assignments is { IsSuccess: true, Data.Items.Count: 0 })"
                    LoadingMessage="@L["OrgProductAccess_LoadingAssignments"]"
                    EmptyMessage="@L["OrgProductAccess_Empty"]"
                    ErrorTitle="@L["OrgProductAccess_AssignmentsUnavailable"]"
                    ErrorDetail="@_assignments?.Error?.Detail">
        <AdminDataTable TItem="ProductAccessAssignmentDto"
                        Items="_assignments!.Data!.Items"
                        Columns="_columns"
                        Caption="@L["OrgProductAccess_Title"]"
                        ItemKey="a => a.Id"
                        CellTemplate="AssignmentCell"
                        RowActions="AssignmentActions"
                        ActionsHeader="@L["Common_Actions"]" />
    </AdminDataPanel>
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true"
                   Title="@_confirm.Title"
                   Message="@_confirm.Message"
                   Kind="AdminDialogKind.Destructive"
                   OnConfirm="RunConfirmAsync"
                   OnCancel="ClearConfirm"
                   Busy="_busy" />
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    private ApiCallResult<OrganizationDto>? _org;
    private ApiCallResult<PagedResult<ProductAccessAssignmentDto>>? _assignments;
    private ApiCallResult<EffectiveProductAccessResultDto>? _evaluation;
    private string _status = "";
    private string _grantUserId = "";
    private string _grantProductCode = "";
    private string _grantReason = "";
    private string _evalUserId = "";
    private string _evalProductCode = "";
    private string? _formError;
    private bool _busy;
    private ConfirmState? _confirm;
    private List<AdminColumnDefinition> _columns = new();

    protected override void OnInitialized()
    {
        _columns =
        [
            new("user", L["Common_User"], Primary: true),
            new("product", L["Common_Product"]),
            new("status", L["Common_Status"]),
            new("granted", L["Common_GrantedUtc"]),
            new("revoked", L["Common_RevokedUtc"])
        ];
    }

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _org = await Api.GetOrganizationAsync(OrganizationId);
        _assignments = await Api.GetOrganizationProductAccessAsync(OrganizationId, status: string.IsNullOrWhiteSpace(_status) ? null : _status);
    }

    private async Task GrantAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        if (!Guid.TryParse(_grantUserId, out var userId))
        {
            _formError = L["OrgMembers_UserIdInvalid"];
            _busy = false;
            return;
        }

        var result = await Api.GrantProductAccessAsync(OrganizationId, new GrantProductAccessRequest(userId, _grantProductCode, "dev-admin", _grantReason));
        _busy = false;
        if (!result.IsSuccess)
        {
            _formError = result.Error?.Detail ?? result.Error?.Title;
            return;
        }

        Toasts.Show(L["OrgProductAccess_ToastGranted"], ToastKind.Success);
        await ReloadAsync();
    }

    private async Task EvaluateAsync()
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        if (!Guid.TryParse(_evalUserId, out var userId))
        {
            _formError = L["OrgMembers_UserIdInvalid"];
            _busy = false;
            return;
        }

        _evaluation = await Api.EvaluateAccessAsync(userId, OrganizationId, _evalProductCode);
        _busy = false;
    }

    private void Ask(string title, string message, Func<Task> action) =>
        _confirm = new ConfirmState(title, message, action);

    private async Task RunConfirmAsync()
    {
        if (_confirm is null)
        {
            return;
        }

        await _confirm.Action();
    }

    private Task ClearConfirm()
    {
        _confirm = null;
        return Task.CompletedTask;
    }

    private async Task RevokeAsync(Guid assignmentId)
    {
        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            return;
        }

        _formError = null;
        var result = await Api.RevokeProductAccessAsync(assignmentId, new RevokeProductAccessRequest("dev-admin", L["OrgProductAccess_RevokeAuditReason"]));
        _busy = false;
        await ClearConfirm();
        if (!result.IsSuccess)
        {
            _formError = result.Error?.Detail ?? result.Error?.Title;
            return;
        }

        Toasts.Show(L["OrgProductAccess_ToastRevoked"], ToastKind.Success);
        await ReloadAsync();
    }

    private RenderFragment<(ProductAccessAssignmentDto Item, AdminColumnDefinition Column)> AssignmentCell => ctx => b =>
    {
        switch (ctx.Column.Key)
        {
            case "user":
                b.OpenElement(0, "a");
                b.AddAttribute(1, "href", $"/admin/users/{ctx.Item.UserId}");
                b.AddContent(2, ctx.Item.UserId);
                b.CloseElement();
                break;
            case "product":
                b.AddContent(0, ctx.Item.ProductCode);
                break;
            case "status":
                b.OpenComponent<StatusBadge>(0);
                b.AddAttribute(1, nameof(StatusBadge.Value), ctx.Item.Status);
                b.CloseComponent();
                break;
            case "granted":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.GrantedAtUtc);
                b.CloseComponent();
                break;
            case "revoked":
                b.OpenComponent<UtcTimestamp>(0);
                b.AddAttribute(1, nameof(UtcTimestamp.Value), ctx.Item.RevokedAtUtc);
                b.CloseComponent();
                break;
        }
    };

    private RenderFragment<ProductAccessAssignmentDto> AssignmentActions => item => b =>
    {
        if (item.Status != "Active")
        {
            return;
        }

        b.OpenElement(0, "button");
        b.AddAttribute(1, "type", "button");
        b.AddAttribute(2, "class", "danger");
        b.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () =>
            Ask(L["OrgProductAccess_RevokeAccess"], L["OrgProductAccess_RevokeConfirmMessage"], () => RevokeAsync(item.Id))));
        b.AddContent(4, L["OrgProductAccess_RevokeAccess"]);
        b.CloseElement();
    };

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action);
}

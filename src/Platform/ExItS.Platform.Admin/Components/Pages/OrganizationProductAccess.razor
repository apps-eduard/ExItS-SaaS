@page "/admin/organizations/{OrganizationId:guid}/product-access"
@rendermode InteractiveServer
@inject IPlatformApiClient Api

<PageHeader Title="Product access" Breadcrumb="Platform Admin / Organizations / Product access" Description="Commercial product-access assignments. Development-stage; unauthenticated." />
<div class="warning" role="note">
    Product access grants commercial entry eligibility only. It does <strong>not</strong> assign Doctor, Nurse, Clinic Admin, Cashier, Store Manager, POS Administrator, Patient, or any other product-local role.
    Effective access also requires active user, membership, product, Trialing/Active subscription, and a current entitlement snapshot.
</div>

@if (_org is null) { <LoadingState Message="Loading organization…" /> }
else if (!_org.IsSuccess) { <ErrorState Title="@(_org.Error?.Title ?? "Error")" Detail="@_org.Error?.Detail" Unavailable="@(_org.Status == ApiCallStatus.Unavailable)" /> }
else
{
    <p><a href="/admin/organizations/@OrganizationId">← @_org.Data!.DisplayName commercial summary</a> · <a href="/admin/organizations/@OrganizationId/members">Members</a></p>
    @if (!string.IsNullOrWhiteSpace(_toast)) { <p class="toast" role="status">@_toast</p> }
    @if (!string.IsNullOrWhiteSpace(_formError)) { <ErrorState Title="Action failed" Detail="@_formError" /> }

    <section class="panel">
        <h2>Grant product access</h2>
        <div class="form-grid">
            <label>User ID <input @bind="_grantUserId" placeholder="GUID of active member" /></label>
            <label>Product code <input @bind="_grantProductCode" placeholder="e.g. pinoybusinesspos" /></label>
            <label>Reason <input @bind="_grantReason" /></label>
        </div>
        <div class="actions">
            <button type="button" @onclick="GrantAsync" disabled="@_busy">Grant access</button>
        </div>
    </section>

    <section class="panel">
        <h2>Evaluate effective access</h2>
        <div class="form-grid">
            <label>User ID <input @bind="_evalUserId" /></label>
            <label>Product code <input @bind="_evalProductCode" /></label>
        </div>
        <div class="actions">
            <button type="button" class="secondary" @onclick="EvaluateAsync" disabled="@_busy">Evaluate</button>
        </div>
        @if (_evaluation is not null)
        {
            @if (!_evaluation.IsSuccess) { <ErrorState Title="Evaluation failed" Detail="@_evaluation.Error?.Detail" /> }
            else
            {
                var e = _evaluation.Data!;
                <AccessStateIndicator Allowed="@e.Allowed" ReasonCode="@e.ReasonCode" />
                <dl>
                    <dt>Membership</dt><dd>@(e.MembershipId?.ToString() ?? "—")</dd>
                    <dt>Assignment</dt><dd>@(e.AssignmentId?.ToString() ?? "—")</dd>
                    <dt>Subscription</dt><dd>@(e.SubscriptionId?.ToString() ?? "—")</dd>
                    <dt>Snapshot</dt><dd>@(e.SnapshotId?.ToString() ?? "—")</dd>
                    <dt>Evaluated (UTC)</dt><dd><UtcTimestamp Value="@e.EvaluatedAtUtc" /></dd>
                </dl>
            }
        }
    </section>

    <div class="filters">
        <label>Status
            <select @bind="_status">
                <option value="">All</option>
                <option>Active</option>
                <option>Revoked</option>
            </select>
        </label>
        <button type="button" @onclick="ReloadAsync">Apply</button>
    </div>

    @if (_assignments is null) { <LoadingState Message="Loading assignments…" /> }
    else if (!_assignments.IsSuccess) { <ErrorState Title="Assignments unavailable" Detail="@_assignments.Error?.Detail" /> }
    else if (_assignments.Data!.Items.Count == 0) { <EmptyState Message="No product-access assignments for this organization." /> }
    else
    {
        <table class="responsive-table">
            <thead><tr><th>User</th><th>Product</th><th>Status</th><th>Granted (UTC)</th><th>Revoked (UTC)</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var a in _assignments.Data.Items)
            {
                <tr>
                    <td data-label="User"><a href="/admin/users/@a.UserId">@a.UserId</a></td>
                    <td data-label="Product">@a.ProductCode</td>
                    <td data-label="Status"><StatusBadge Value="@a.Status" /></td>
                    <td data-label="Granted"><UtcTimestamp Value="@a.GrantedAtUtc" /></td>
                    <td data-label="Revoked">@(a.RevokedAtUtc is null ? "—" : null)@if (a.RevokedAtUtc is not null){<UtcTimestamp Value="@a.RevokedAtUtc.Value" />}</td>
                    <td data-label="Actions">
                        @if (a.Status == "Active")
                        {
                            <button type="button" class="danger" @onclick='() => Ask("Revoke product access", "Revoke commercial product access for this user? Historical assignment remains queryable.", () => RevokeAsync(a.Id))'>Revoke access</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@if (_confirm is not null)
{
    <ConfirmDialog Visible="true" Title="@_confirm.Title" Message="@_confirm.Message" OnConfirm="_confirm.Action" OnCancel="ClearConfirm" Busy="_busy" />
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }
    private ApiCallResult<OrganizationDto>? _org;
    private ApiCallResult<PagedResult<ProductAccessAssignmentDto>>? _assignments;
    private ApiCallResult<EffectiveProductAccessResultDto>? _evaluation;
    private string _status = "";
    private string _grantUserId = "";
    private string _grantProductCode = "";
    private string _grantReason = "";
    private string _evalUserId = "";
    private string _evalProductCode = "";
    private string? _toast;
    private string? _formError;
    private bool _busy;
    private ConfirmState? _confirm;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _org = await Api.GetOrganizationAsync(OrganizationId);
        _assignments = await Api.GetOrganizationProductAccessAsync(OrganizationId, status: string.IsNullOrWhiteSpace(_status) ? null : _status);
    }

    private async Task GrantAsync()
    {
        _formError = null; _toast = null;
        if (!Guid.TryParse(_grantUserId, out var userId)) { _formError = "User ID must be a valid GUID."; return; }
        _busy = true;
        var result = await Api.GrantProductAccessAsync(OrganizationId, new GrantProductAccessRequest(userId, _grantProductCode, "dev-admin", _grantReason));
        _busy = false;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Product access granted.";
        await ReloadAsync();
    }

    private async Task EvaluateAsync()
    {
        _formError = null;
        if (!Guid.TryParse(_evalUserId, out var userId)) { _formError = "User ID must be a valid GUID."; return; }
        _busy = true;
        _evaluation = await Api.EvaluateAccessAsync(userId, OrganizationId, _evalProductCode);
        _busy = false;
    }

    private void Ask(string title, string message, Func<Task> action) => _confirm = new ConfirmState(title, message, action);

    private Task ClearConfirm()
    {
        _confirm = null;
        return Task.CompletedTask;
    }

    private async Task RevokeAsync(Guid assignmentId)
    {
        _busy = true; _formError = null;
        var result = await Api.RevokeProductAccessAsync(assignmentId, new RevokeProductAccessRequest("dev-admin", "Revoked from Admin"));
        _busy = false; _confirm = null;
        if (!result.IsSuccess) { _formError = result.Error?.Detail ?? result.Error?.Title; return; }
        _toast = "Product access revoked; history retained.";
        await ReloadAsync();
    }

    private sealed record ConfirmState(string Title, string Message, Func<Task> Action);
}

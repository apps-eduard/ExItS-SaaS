@page "/admin/organizations/{OrganizationId:guid}/commercial"
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IPlatformApiClient Api
@inject IMessageService Message
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@inject PlatformPermissionState Permissions
@inject AdminShellContext Shell
@inject ConfirmService Confirm
@inject LocalValidationSignInService LocalValidation
@inject IJSRuntime Js

<AdminPageHeader Title="Current Subscription" Breadcrumb="@PageBreadcrumb" Description="Manage your plan, billing, and subscription status." />

@if (_loading)
{
    <LoadingState />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <ErrorState Title="@L["Common_Error"].Value" Detail="@_error" />
    <Button Type="@ButtonType.Primary" OnClick="@(() => LoadAsync())" Style="margin-top:12px;">Retry</Button>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <Alert Type="@AlertType.Error" ShowIcon="true" Closable Message="@_actionError" Style="margin-bottom:16px;" />
    }

    <Row Gutter="(16, 16)" Style="margin-bottom:24px;">
        <AntDesign.Col Xs="24" Lg="14">
            <Card Size="@CardSize.Small" Title="Subscription Summary">
                @if (_statusAlert is not null)
                {
                    <Alert Type="@_statusAlert.Value.Type" ShowIcon="true" Message="@_statusAlert.Value.Message" Style="margin-bottom:12px;" />
                }
                <Descriptions Bordered Size="@DescriptionsSize.Small" Column="1">
                    <DescriptionsItem Title="Scope">Organization Administration</DescriptionsItem>
                    <DescriptionsItem Title="Role">@DisplayOrDash(FormatOrgRole(Shell.MembershipRole) ?? Shell.RoleLabel)</DescriptionsItem>
                    <DescriptionsItem Title="Product">@DisplayOrDash(_currentSubscription?.ProductCode ?? DefaultProductCode)</DescriptionsItem>
                    <DescriptionsItem Title="Organization">@DisplayOrDash(_org?.DisplayName)</DescriptionsItem>
                    <DescriptionsItem Title="Current plan">@DisplayOrDash(_currentSubscription?.PlanDisplayName ?? _currentPlan?.DisplayName)</DescriptionsItem>
                    <DescriptionsItem Title="Status">
                        @if (_currentSubscription is null)
                        {
                            <Tag>No current plan</Tag>
                        }
                        else
                        {
                            <Tag Color="@StatusColor(_currentSubscription.Status)">@_currentSubscription.Status</Tag>
                        }
                    </DescriptionsItem>
                    <DescriptionsItem Title="Billing cycle">@DisplayOrDash(_currentSubscription?.BillingCycle ?? _subscribeBillingCycle)</DescriptionsItem>
                    <DescriptionsItem Title="Current price">@AmountDisplay(_currentSubscription?.AgreedPrice, _currentSubscription?.CurrencyCode ?? _currentPlan?.CurrencyCode)</DescriptionsItem>
                    <DescriptionsItem Title="Trial / renewal">@PeriodLabel(_currentSubscription)</DescriptionsItem>
                    @if (_pendingPlanChange is not null)
                    {
                        <DescriptionsItem Title="Pending plan">
                            @DisplayOrDash(_pendingPlanChange.DisplayName)
                            @if (_pendingPlanChange.EffectiveAtUtc is not null)
                            {
                                <span> · @_pendingPlanChange.EffectiveAtUtc.Value.ToLocalTime().ToString("g")</span>
                            }
                        </DescriptionsItem>
                    }
                </Descriptions>
            </Card>
        </AntDesign.Col>
        <AntDesign.Col Xs="24" Lg="10">
            <Card Size="@CardSize.Small" Title="Subscription Actions">
                @if (!CanManageCommercial)
                {
                    <Alert Type="@AlertType.Warning" ShowIcon="true"
                           Message="You can view this subscription, but commercial changes require Organization Owner or Platform Manage Subscriptions." />
                }
                else
                {
                    <Space Direction="SpaceDirection.Vertical" Style="width:100%;">
                        @if (_currentSubscription is null)
                        {
                            <Alert Type="@AlertType.Info" ShowIcon="true" Message="No subscription yet. Choose a plan below to start a trial or subscribe." />
                        }
                        else if (IsTrialing || IsExpired)
                        {
                            <Button Type="@ButtonType.Primary" Block Loading="_busy" OnClick="ScrollToPlansAsync">
                                @(IsTrialing ? "Convert trial — choose a plan" : "Subscribe — choose a plan")
                            </Button>
                        }
                        else if (ShowActivePlanManagement)
                        {
                            <Button Type="@ButtonType.Primary" Block Loading="_busy" OnClick="ScrollToPlansAsync">View upgrade options</Button>
                        }
                        <Button Block Disabled="_busy" OnClick="ScrollToPlansAsync">View Plans</Button>
                        <Button Block Disabled="_busy" OnClick="ScrollToHistoryAsync">View History</Button>
                        @if (SubscriptionDetailHref is not null)
                        {
                            <Button Type="@ButtonType.Link" Block OnClick="GoToSubscriptionDetailAsync">@L["Common_ViewDetails"]</Button>
                        }
                    </Space>
                }
                <div style="margin-top:16px;">
                    <span style="margin-right:8px;">Billing cycle for new actions:</span>
                    <Select TItemValue="string" TItem="string" @bind-Value="_subscribeBillingCycle" Style="width:140px;" Disabled="_busy || !CanManageCommercial">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("Monthly")" Label="Monthly" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("Annual")" Label="Annual" />
                        </SelectOptions>
                    </Select>
                </div>
            </Card>
        </AntDesign.Col>
    </Row>

    <div id="available-plans" style="margin-bottom:24px;">
        <FormSection Title="Available Plans">
            @if (_plans.Count is 0)
            {
                <Empty Description="@L["Plans_Empty"].Value" />
            }
            else
            {
                <Row Gutter="(16, 16)">
                    @foreach (var plan in _plans.OrderBy(p => p.SortOrder))
                    {
                        var designation = PlanDesignation(plan);
                        var isCurrent = designation == "current";
                        <AntDesign.Col Xs="24" Sm="24" Md="8">
                            <Card Size="@CardSize.Small"
                                  Title="@plan.DisplayName"
                                  Style="@(isCurrent ? "border:2px solid #1890ff;height:100%;" : "height:100%;")"
                                  BodyStyle="display:flex;flex-direction:column;min-height:260px;">
                                @if (isCurrent)
                                {
                                    <Tag Color="@("blue")" Style="margin-bottom:8px;align-self:flex-start;">Current plan</Tag>
                                }
                                else
                                {
                                    <Tag Color="@DesignationColor(designation)" Style="margin-bottom:8px;align-self:flex-start;">@designation</Tag>
                                }
                                <div style="margin-bottom:8px;">
                                    <div style="font-weight:600;">@($"{plan.MonthlyPrice:0} {plan.CurrencyCode}") / month</div>
                                    <div style="color:#8c8c8c;">@($"{plan.AnnualPrice:0} {plan.CurrencyCode}") / year</div>
                                </div>
                                <p style="margin-bottom:8px;">
                                    @(plan.TrialAllowed && plan.DefaultTrialDays > 0
                                        ? $"{plan.DefaultTrialDays}-day trial available"
                                        : "Subscribe only")
                                </p>
                                <ul style="margin:0 0 16px;padding-left:1.1rem;flex:1;">
                                    @foreach (var line in FeatureSummary(plan))
                                    {
                                        <li>@line</li>
                                    }
                                </ul>
                                <Space Direction="SpaceDirection.Vertical" Style="width:100%;margin-top:auto;">
                                    @if (CanManageCommercial && _currentSubscription is null)
                                    {
                                        @if (plan.TrialAllowed && plan.DefaultTrialDays > 0)
                                        {
                                            <Button Type="@ButtonType.Primary" Block Loading="_busy"
                                                    OnClick="@(async () => await StartFromCatalogAsync(plan, startAsTrial: true))">
                                                Start Free Trial
                                            </Button>
                                        }
                                        <Button Type="@(plan.TrialAllowed ? ButtonType.Default : ButtonType.Primary)" Block Loading="_busy"
                                                OnClick="@(async () => await StartFromCatalogAsync(plan, startAsTrial: false))">
                                            Subscribe Now
                                        </Button>
                                    }
                                    else if (CanManageCommercial && (IsTrialing || IsExpired))
                                    {
                                        <Button Type="@ButtonType.Primary" Block Loading="_busy"
                                                OnClick="@(async () => await SubscribeFromTrialAsync(plan))">
                                            Subscribe Now
                                        </Button>
                                    }
                                    else if (CanManageCommercial && ShowActivePlanManagement && designation == "upgrade")
                                    {
                                        <Button Type="@ButtonType.Primary" Block Loading="_busy"
                                                OnClick="@(async () => await UpgradeAsync(plan))">
                                            Upgrade
                                        </Button>
                                    }
                                    else if (CanManageCommercial && ShowActivePlanManagement && designation == "downgrade")
                                    {
                                        <Button Block Loading="_busy"
                                                OnClick="@(async () => await DowngradeAsync(plan))">
                                            Downgrade
                                        </Button>
                                    }
                                    else if (isCurrent)
                                    {
                                        <Button Block Disabled>Current plan</Button>
                                    }
                                </Space>
                            </Card>
                        </AntDesign.Col>
                    }
                </Row>
            }
        </FormSection>
    </div>

    <div id="subscription-history" style="margin-bottom:24px;">
        <FormSection Title="Subscription History">
            @if (HasSubscriptions)
            {
                <Table TItem="SubscriptionDto" DataSource="@_summarySubscriptions" Size="@TableSize.Small" Bordered HidePagination ScrollX="800">
                    <PropertyColumn Property="c => c.ProductCode" Title="Product" />
                    <PropertyColumn Property="c => c.PlanDisplayName" Title="Plan" />
                    <PropertyColumn Property="c => c.BillingCycle" Title="Billing" />
                    <PropertyColumn Property="c => c.AgreedPrice" Title="Price" />
                    <PropertyColumn Property="c => c.Status" Title="Status">
                        <Tag Color="@StatusColor(context.Status)">@context.Status</Tag>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.CreatedAtUtc" Title="Start">
                        @FriendlyDate(context.CreatedAtUtc)
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Status" Title="Trial / Renewal / End">
                        @HistoryEndLabel(context)
                    </PropertyColumn>
                    <ActionColumn Title="Actions">
                        <Button Type="@ButtonType.Link" Size="@ButtonSize.Small"
                                OnClick="@(() => Nav.NavigateTo($"/admin/subscriptions/{context.Id:D}"))">
                            Details
                        </Button>
                    </ActionColumn>
                </Table>
            }
            else
            {
                <Empty Description="@L["Organizations_SubscriptionsEmpty"].Value" />
            }
        </FormSection>
    </div>

    @if (_showLvPayments && ShowActivePlanManagement)
    {
        <FormSection Title="TestPayments">
            <Alert Type="@AlertType.Warning" ShowIcon="true" Message="Test payment (Local Validation only)" Style="margin-bottom:12px;" />
            @if (_currentSubscription is null)
            {
                <Empty Description="@RequiresSubscriptionText" />
            }
            else
            {
                <Space Wrap>
                    @foreach (var sim in _simulationPresets)
                    {
                        <Button Size="@ButtonSize.Small" Loading="_busy" OnClick="@(async () => await SimulateAsync(sim))">@sim</Button>
                    }
                </Space>
                @if (!string.IsNullOrWhiteSpace(_simResult))
                {
                    <Alert Type="@AlertType.Info" Message="@_simResult" ShowIcon="true" Style="margin-top:12px;" />
                }
            }
        </FormSection>
    }
}

@code {
    [Parameter] public Guid OrganizationId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _loadInFlight;
    private int _loadGeneration;
    private Guid? _loadedOrganizationId;
    private string? _error;
    private string? _actionError;
    private string? _simResult;
    private string _subscribeBillingCycle = "Monthly";
    private OrganizationDto? _org;
    private OrganizationCurrentPlanDto? _currentPlanView;
    private OrganizationCommercialSummaryDto? _summary;
    private SubscriptionDto? _currentSubscription;
    private PlanDto? _currentPlan;
    private PendingPlanChangeDto? _pendingPlanChange;
    private List<PlanDto> _plans = [];
    private List<SubscriptionDto> _summarySubscriptions = [];
    private bool _showLvPayments;
    private const string DefaultProductCode = "pinoy-business-pos";

    private static readonly string[] _simulationPresets =
        ["Succeeded", "Declined", "Pending", "Failed", "RenewalSucceeded", "RenewalFailed", "Refunded"];

    private static readonly string RequiresSubscriptionText = "Requires an active subscription";

    private bool HasSubscriptions => _summarySubscriptions.Count > 0;

    private bool IsTrialing =>
        string.Equals(_currentSubscription?.Status, "Trialing", StringComparison.OrdinalIgnoreCase);

    private bool IsExpired =>
        string.Equals(_currentSubscription?.Status, "Expired", StringComparison.OrdinalIgnoreCase);

    private bool ShowActivePlanManagement =>
        _currentSubscription is not null
        && (string.Equals(_currentSubscription.Status, "Active", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_currentSubscription.Status, "GracePeriod", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_currentSubscription.Status, "PastDue", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_currentSubscription.Status, "Suspended", StringComparison.OrdinalIgnoreCase));

    private (AlertType Type, string Message)? _statusAlert => _currentSubscription?.Status switch
    {
        "Trialing" => (AlertType.Info, "Trial is active. Convert to a paid plan before the trial ends — there is no automatic charge."),
        "PastDue" => (AlertType.Warning, "Payment is past due. Recover billing to restore full access."),
        "Suspended" => (AlertType.Error, "Subscription is suspended. Reactivate after resolving billing."),
        "Cancelled" => (AlertType.Warning, "Subscription is cancelled."),
        "Expired" => (AlertType.Warning, "Trial or subscription expired. Choose a plan to continue. Product data is retained."),
        "GracePeriod" => (AlertType.Warning, "Grace period is active. Resolve payment before access is reduced."),
        _ => null
    };

    private string PageBreadcrumb => $"{L["Brand_Name"].Value} · {L["Nav_Organizations"].Value} · Current Subscription";
    private string? SubscriptionDetailHref => _currentSubscription is null ? null : $"/admin/subscriptions/{_currentSubscription.Id:D}";

    private bool CanManageCommercial =>
        Permissions.HasPermission(PlatformPermissionCodes.ManageSubscriptions)
        || (Shell.IsOrganizationShell && Shell.SelectedOrganizationId == OrganizationId);

    protected override async Task OnParametersSetAsync()
    {
        // Only reload when the organization route changes. Parent re-renders must not
        // tear down AntDesign listeners (DomEventListener "Collection was modified").
        if (_loadedOrganizationId == OrganizationId)
        {
            return;
        }

        await LoadAsync(showFullPageLoading: true);
    }

    private static string DisplayOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string? FormatOrgRole(string? role) => role switch
    {
        "OrganizationOwner" => "Owner",
        "OrganizationAdministrator" => "Administrator",
        "OrganizationMember" => "Staff",
        _ => string.IsNullOrWhiteSpace(role) ? null : role
    };

    private static string AmountDisplay(decimal? amount, string? currency) =>
        amount is null ? "—" : $"{amount:0.00} {currency ?? ""}".Trim();

    private static string FriendlyDate(DateTimeOffset? value) =>
        value is null ? "—" : value.Value.ToLocalTime().ToString("g");

    private static string PeriodLabel(SubscriptionDto? sub)
    {
        if (sub is null) return "—";
        if (string.Equals(sub.Status, "Trialing", StringComparison.OrdinalIgnoreCase) && sub.TrialEndUtc is not null)
        {
            return $"Trial ends {sub.TrialEndUtc.Value.ToLocalTime():g}";
        }

        if (sub.CurrentPeriodEndUtc is not null)
        {
            return $"Renews / ends {sub.CurrentPeriodEndUtc.Value.ToLocalTime():g}";
        }

        if (sub.PaidPeriodEndUtc is not null)
        {
            return $"Period ends {sub.PaidPeriodEndUtc.Value.ToLocalTime():g}";
        }

        return "—";
    }

    private static string HistoryEndLabel(SubscriptionDto sub)
    {
        if (sub.TrialEndUtc is not null
            && (string.Equals(sub.Status, "Trialing", StringComparison.OrdinalIgnoreCase)
                || string.Equals(sub.Status, "Expired", StringComparison.OrdinalIgnoreCase)))
        {
            return FriendlyDate(sub.TrialEndUtc);
        }

        return FriendlyDate(sub.CurrentPeriodEndUtc ?? sub.PaidPeriodEndUtc);
    }

    private static IEnumerable<string> FeatureSummary(PlanDto plan)
    {
        yield return $"{plan.MaxBranches} branch{(plan.MaxBranches == 1 ? "" : "es")}";
        yield return $"{plan.MaxActiveStaff} active staff";
        if (plan.CustomerCreditEnabled) yield return "Customer credit";
        if (plan.AdvancedReportsEnabled) yield return "Advanced reports";
        if (plan.ExportEnabled) yield return "Export";
    }

    private async Task GoToSubscriptionDetailAsync()
    {
        if (SubscriptionDetailHref is null)
        {
            return;
        }

        // Defer navigation so AntDesign DomEventListener finishes enumerating handlers.
        await Task.Yield();
        await Task.Delay(1);
        Nav.NavigateTo(SubscriptionDetailHref);
    }

    private Task ScrollToPlansAsync() => ScrollToElementAsync("available-plans");

    private Task ScrollToHistoryAsync() => ScrollToElementAsync("subscription-history");

    private async Task ScrollToElementAsync(string elementId)
    {
        // Do not use NavigationManager hash navigation — it remounts and races DomEventListener.
        await Task.Yield();
        try
        {
            await Js.InvokeVoidAsync(
                "eval",
                $"document.getElementById('{elementId}')?.scrollIntoView({{behavior:'smooth',block:'start'}})");
        }
        catch (JSDisconnectedException)
        {
            // Circuit disposed.
        }
        catch (JSException)
        {
            // Element missing or JS unavailable — ignore.
        }
    }

    private async Task LoadAsync(bool showFullPageLoading = true)
    {
        if (_loadInFlight && !showFullPageLoading)
        {
            return;
        }

        var generation = ++_loadGeneration;
        _loadInFlight = true;
        if (showFullPageLoading)
        {
            _loading = true;
        }

        _error = null;
        _actionError = null;
        try
        {
            await Shell.EnsureLoadedAsync();
            if (generation != _loadGeneration)
            {
                return;
            }

            _showLvPayments = LocalValidation.IsAvailable;
            var orgResult = await Api.GetOrganizationAsync(OrganizationId);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (!orgResult.IsSuccess)
            {
                _error = orgResult.Error?.Detail ?? orgResult.Error?.Title ?? "Organization could not be loaded.";
                return;
            }

            _org = orgResult.Data;

            var currentPlan = await Api.GetOrganizationCurrentPlanAsync(OrganizationId, DefaultProductCode);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (!currentPlan.IsSuccess)
            {
                _error = currentPlan.Error?.Detail ?? currentPlan.Error?.Title ?? "Current plan could not be loaded.";
                return;
            }

            _currentPlanView = currentPlan.Data;
            _currentSubscription = _currentPlanView?.CurrentSubscription;
            _currentPlan = _currentPlanView?.CurrentPlan;
            _pendingPlanChange = _currentPlanView?.PendingPlanChange;
            _plans = _currentPlanView?.AvailablePlans.OrderBy(p => p.SortOrder).ToList() ?? [];

            if (_plans.Count is 0)
            {
                var commercialPlans = await Api.GetCommercialPlansAsync(DefaultProductCode);
                if (generation != _loadGeneration)
                {
                    return;
                }

                if (commercialPlans.IsSuccess && commercialPlans.Data is not null)
                {
                    _plans = commercialPlans.Data.OrderBy(p => p.SortOrder).ToList();
                }
            }

            var summary = await Api.GetOrganizationCommercialSummaryAsync(OrganizationId);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (summary.IsSuccess && summary.Data is not null)
            {
                _summary = summary.Data;
                _summarySubscriptions = _summary.Subscriptions?.ToList() ?? [];
            }
            else if (_currentSubscription is not null)
            {
                _summarySubscriptions = [_currentSubscription];
            }

            if (_currentSubscription?.BillingCycle is not null)
            {
                _subscribeBillingCycle = _currentSubscription.BillingCycle;
            }

            _loadedOrganizationId = OrganizationId;
        }
        catch (Exception ex)
        {
            if (generation == _loadGeneration)
            {
                _error = "An unexpected error occurred while loading commercial data.";
                Console.Error.WriteLine(ex);
            }
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _loading = false;
                _loadInFlight = false;
            }
        }
    }

    private string PlanDesignation(PlanDto plan)
    {
        if (_currentSubscription is null)
        {
            return "available";
        }

        if (plan.Id == _currentSubscription.PlanId)
        {
            return "current";
        }

        var current = _plans.FirstOrDefault(p => p.Id == _currentSubscription.PlanId) ?? _currentPlan;
        return current is null ? "available" : plan.SortOrder > current.SortOrder ? "upgrade" : "downgrade";
    }

    private static string DesignationColor(string designation) => designation switch
    {
        "current" => "blue",
        "upgrade" => "green",
        "downgrade" => "orange",
        _ => "default"
    };

    private async Task StartFromCatalogAsync(PlanDto plan, bool startAsTrial)
    {
        if (!CanManageCommercial)
        {
            await Message.ErrorAsync("You are not authorized to change this organization's subscription.");
            return;
        }

        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            await Message.WarningAsync("Please wait — a request is already in progress.");
            return;
        }

        _actionError = null;
        try
        {
            if (!startAsTrial && !LocalValidation.IsAvailable)
            {
                _actionError = "Paid subscribe requires Local Validation payment simulation in this environment.";
                await Message.ErrorAsync(_actionError);
                return;
            }

            var planKey = plan.PlanKey ?? plan.Code;
            var result = await Api.StartOrganizationCommercialSubscriptionAsync(
                OrganizationId,
                new StartOrganizationCommercialRequest(
                    ProductCode: DefaultProductCode,
                    PlanKey: planKey,
                    PlanId: plan.Id,
                    BillingCycle: _subscribeBillingCycle,
                    StartAsTrial: startAsTrial,
                    PayNow: !startAsTrial,
                    IdempotencyKey: Guid.NewGuid().ToString("N")));

            if (!result.IsSuccess)
            {
                _actionError = FriendlyApiError(result);
                await Message.ErrorAsync(_actionError);
                return;
            }

            await Message.SuccessAsync(startAsTrial
                ? $"Started {plan.DisplayName} trial."
                : $"Subscribed to {plan.DisplayName}.");
            await LoadAsync(showFullPageLoading: false);
        }
        catch (Exception ex)
        {
            _actionError = "Could not start the subscription. Please retry.";
            await Message.ErrorAsync(_actionError);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubscribeFromTrialAsync(PlanDto plan)
    {
        if (_currentSubscription is null)
        {
            await Message.ErrorAsync("No trial or expired subscription to convert.");
            return;
        }

        if (!CanManageCommercial)
        {
            await Message.ErrorAsync("You are not authorized to change this organization's subscription.");
            return;
        }

        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            await Message.WarningAsync("Please wait — a request is already in progress.");
            return;
        }

        _actionError = null;
        try
        {
            if (!LocalValidation.IsAvailable)
            {
                _actionError = "Subscribe requires Local Validation payment simulation in this environment.";
                await Message.ErrorAsync(_actionError);
                return;
            }

            var price = _subscribeBillingCycle == "Annual" ? plan.AnnualPrice : plan.MonthlyPrice;
            var result = await Api.ConvertTrialSubscriptionAsync(
                OrganizationId,
                _currentSubscription.Id,
                new ConvertTrialSubscriptionRequest(
                    plan.Id,
                    plan.PlanKey,
                    _subscribeBillingCycle,
                    Guid.NewGuid().ToString("N"),
                    _currentSubscription.Version));

            if (!result.IsSuccess)
            {
                _actionError = FriendlyApiError(result);
                await Message.ErrorAsync(_actionError);
                return;
            }

            await Message.SuccessAsync($"Subscribed to {plan.DisplayName} ({price:0} {plan.CurrencyCode}).");
            await LoadAsync(showFullPageLoading: false);
        }
        catch (Exception ex)
        {
            _actionError = "Subscription failed unexpectedly. Please retry.";
            await Message.ErrorAsync(_actionError);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UpgradeAsync(PlanDto plan)
    {
        if (_currentSubscription is null || !CanManageCommercial)
        {
            await Message.ErrorAsync("Upgrade is not available for this subscription.");
            return;
        }

        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            await Message.WarningAsync("Please wait — a request is already in progress.");
            return;
        }

        _actionError = null;
        try
        {
            if (!LocalValidation.IsAvailable)
            {
                _actionError = "Paid upgrades require Local Validation payment simulation in this environment.";
                await Message.ErrorAsync(_actionError);
                return;
            }

            var confirmed = await Confirm.Show(
                $"Upgrade to {plan.DisplayName} now?\n\n"
                + "This uses the supported immediate plan upgrade on your current subscription (not a silent plan rewrite). "
                + "Payment is collected first; on success the plan, price, and entitlement update immediately. "
                + "Subscription history is preserved on the same subscription record.",
                "Confirm upgrade",
                ConfirmButtons.OKCancel,
                ConfirmIcon.Warning);
            if (confirmed != ConfirmResult.OK)
            {
                return;
            }

            var result = await Api.UpgradeSubscriptionAsync(
                OrganizationId,
                _currentSubscription.Id,
                new UpgradeSubscriptionRequest(
                    plan.Id,
                    plan.PlanKey,
                    _currentSubscription.BillingCycle ?? _subscribeBillingCycle,
                    Guid.NewGuid().ToString("N")));

            if (!result.IsSuccess)
            {
                _actionError = FriendlyApiError(result);
                await Message.ErrorAsync(_actionError);
                return;
            }

            await Message.SuccessAsync($"Upgraded to {plan.DisplayName}.");
            await LoadAsync(showFullPageLoading: false);
        }
        catch (Exception ex)
        {
            _actionError = "Upgrade failed unexpectedly. Please retry.";
            await Message.ErrorAsync(_actionError);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DowngradeAsync(PlanDto plan)
    {
        if (_currentSubscription is null || !CanManageCommercial)
        {
            await Message.ErrorAsync("Downgrade is not available for this subscription.");
            return;
        }

        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            await Message.WarningAsync("Please wait — a request is already in progress.");
            return;
        }

        _actionError = null;
        try
        {
            var preview = await Api.PreviewPlanChangeAsync(
                OrganizationId,
                _currentSubscription.Id,
                plan.Id,
                plan.PlanKey);
            var impactLines = new List<string>();
            if (preview.IsSuccess && preview.Data is not null)
            {
                if (!preview.Data.BranchCountAvailable
                    && !string.IsNullOrWhiteSpace(preview.Data.BranchCountUnavailableReason))
                {
                    impactLines.Add(preview.Data.BranchCountUnavailableReason);
                }

                foreach (var conflict in preview.Data.UsageConflicts)
                {
                    impactLines.Add(conflict.Message);
                }

                foreach (var lost in preview.Data.LostFeatures)
                {
                    impactLines.Add($"Lost feature: {lost}");
                }
            }

            var retentionNote =
                "Existing data is not deleted. After the downgrade takes effect, new over-limit creation is blocked.";
            var content = impactLines.Count == 0
                ? $"Schedule downgrade to {plan.DisplayName} at period end? {retentionNote}"
                : $"Schedule downgrade to {plan.DisplayName}?\n\n" + string.Join("\n", impactLines) + $"\n\n{retentionNote}";

            var confirmed = await Confirm.Show(
                content,
                "Confirm downgrade",
                ConfirmButtons.OKCancel,
                ConfirmIcon.Warning);
            if (confirmed != ConfirmResult.OK)
            {
                return;
            }

            var effective = _currentSubscription.CurrentPeriodEndUtc ?? _currentSubscription.PaidPeriodEndUtc ?? DateTimeOffset.UtcNow;
            var result = await Api.DowngradeSubscriptionAsync(
                OrganizationId,
                _currentSubscription.Id,
                new DowngradeSubscriptionRequest(plan.Id, plan.PlanKey, effective, Guid.NewGuid().ToString("N")));
            if (!result.IsSuccess)
            {
                _actionError = FriendlyApiError(result);
                await Message.ErrorAsync(_actionError);
                return;
            }

            await Message.SuccessAsync("Downgrade scheduled.");
            await LoadAsync(showFullPageLoading: false);
        }
        catch (Exception ex)
        {
            _actionError = "Downgrade failed unexpectedly. Please retry.";
            await Message.ErrorAsync(_actionError);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SimulateAsync(string simulation)
    {
        if (_currentSubscription is null || !LocalValidation.IsAvailable)
        {
            await Message.ErrorAsync("Local Validation test payments are not available.");
            return;
        }

        if (!AdminFormErrorMapper.TryBeginSubmit(ref _busy))
        {
            await Message.WarningAsync("Please wait — a request is already in progress.");
            return;
        }

        try
        {
            var plan = _plans.FirstOrDefault(p => p.Id == _currentSubscription.PlanId) ?? _currentPlan;
            var result = await Api.SimulateLocalValidationPaymentAsync(new SimulateLocalValidationPaymentRequest(
                simulation,
                OrganizationId,
                _currentSubscription.Id,
                plan?.MonthlyPrice ?? _currentSubscription.AgreedPrice ?? 0m,
                _currentSubscription.CurrencyCode ?? plan?.CurrencyCode ?? "PHP",
                Guid.NewGuid().ToString("N"),
                Purpose: "test",
                BillingCycle: _currentSubscription.BillingCycle ?? "Monthly"));
            _simResult = result.IsSuccess
                ? $"{simulation}: {result.Data?.Status}"
                : FriendlyApiError(result);
            if (!result.IsSuccess)
            {
                await Message.ErrorAsync(_simResult);
            }

            await LoadAsync(showFullPageLoading: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FriendlyApiError<T>(ApiCallResult<T> result)
    {
        var detail = result.Error?.Detail ?? result.Error?.Title;
        if (string.IsNullOrWhiteSpace(detail))
        {
            return "The request could not be completed.";
        }

        // Keep browser message business-friendly; strip raw stack-like noise.
        return detail.Length > 280 ? detail[..280] + "…" : detail;
    }

    private static string StatusColor(string status) => status switch
    {
        "Trialing" => "blue",
        "Active" => "green",
        "GracePeriod" => "gold",
        "PastDue" => "orange",
        "Suspended" => "red",
        "Cancelled" or "Expired" => "default",
        _ => "default"
    };
}

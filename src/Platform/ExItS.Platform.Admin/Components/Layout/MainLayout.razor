@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject IOptions<DevelopmentOperatorOptions> OperatorOptions
@inject IHostEnvironment Env
@inject IStringLocalizer<AdminResources> L

@*
  Authoritative Platform Admin shell (P11-WP02).
  Do not introduce a second layout/shell. Theme persistence relies on theme-boot.js
  (Blazor.enhancedload + pageshow) and ThemeSelector LocationChanged — not document-wide permanence attributes.
*@

<a class="skip-link" href="#main-content">@L["Nav_SkipToContent"]</a>

<div class="app-shell" id="app-shell">
    <input type="checkbox" id="nav-drawer-toggle" class="shell-toggle" />
    <input type="checkbox" id="nav-collapse-toggle" class="shell-toggle" />

    <label class="drawer-backdrop" for="nav-drawer-toggle" aria-hidden="true"></label>

    <aside class="app-sidebar" id="app-sidebar" aria-label="@L["Aria_AdminNav"]">
        <div class="brand-row">
            <a class="brand-mark" href="/admin" aria-hidden="true" tabindex="-1">EA</a>
            <a class="brand-text" href="/admin">@L["Brand_Name"]</a>
            <label class="icon-btn drawer-close" for="nav-drawer-toggle" aria-label="@L["Nav_CloseDrawer"]" aria-controls="app-sidebar">
                <NavIcon Name="close" />
            </label>
        </div>
        <AdminNav @rendermode="InteractiveServer" />
    </aside>

    <div class="app-content">
        <header class="app-header" role="banner">
            <label class="icon-btn menu-toggle" for="nav-drawer-toggle" aria-label="@L["Nav_OpenDrawer"]" aria-controls="app-sidebar" aria-expanded="false">
                <NavIcon Name="menu" />
            </label>
            <label class="icon-btn collapse-toggle" for="nav-collapse-toggle" aria-label="@L["Nav_CollapseSidebar"]" title="@L["Nav_CollapseSidebar"]">
                <NavIcon Name="collapse" />
            </label>
            <div class="app-header-context" aria-live="polite">
                <span class="app-header-title">@L["Brand_Name"]</span>
                @if (!string.IsNullOrWhiteSpace(ActorDisplayName))
                {
                    <span class="app-header-chip">@ActorDisplayName</span>
                }
                <OrganizationContextSwitcher />
            </div>
            <span class="app-header-spacer"></span>
            <div class="app-header-controls">
                <ThemeSelector @rendermode="InteractiveServer" />
                <LanguageSelector @rendermode="InteractiveServer" />
                <EnvironmentBanner ActorDisplayName="@ActorDisplayName" />
                <AuthorizeView>
                    <Authorized>
                        <a class="icon-btn" href="/admin/account/change-password" title="Change password" aria-label="Change password">Pwd</a>
                        <a class="icon-btn" href="/admin/account/recovery-email" title="Recovery email" aria-label="Recovery email">Rec</a>
                        <a class="icon-btn" href="/admin/logout" title="Sign out" aria-label="Sign out">Out</a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="app-main" id="main-content" tabindex="-1">
            @Body
        </main>

        <footer class="app-footer">
            <p>@L["Footer_Text"]</p>
            @if (!string.IsNullOrWhiteSpace(ActorDisplayName))
            {
                <p class="muted">@string.Format(L["Footer_ActorContext"].Value, ActorDisplayName)</p>
            }
        </footer>
    </div>

    <ToastHost @rendermode="InteractiveServer" />
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    @L["Error_Unhandled"]
    <a href="." class="reload">@L["Error_Reload"]</a>
    <span class="dismiss">@L["Error_Dismiss"]</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _authDisplayName;

    protected override async Task OnParametersSetAsync()
    {
        _authDisplayName = null;
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                _authDisplayName = state.User.Identity.Name;
            }
        }
    }

    private string? ActorDisplayName
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_authDisplayName))
            {
                return _authDisplayName;
            }

            return (Env.IsDevelopment() || Env.IsEnvironment("Testing"))
                   && !string.IsNullOrWhiteSpace(OperatorOptions.Value.DisplayName)
                ? OperatorOptions.Value.DisplayName
                : null;
        }
    }
}

@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using AntDesign
@inject IOptions<DevelopmentOperatorOptions> OperatorOptions
@inject IHostEnvironment Env
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav

@*
  Authoritative Platform Admin shell (P15-WP01 Ant Design Pro–inspired).
  Single shell — do not introduce a parallel layout.
*@

<a class="skip-link" href="#main-content">@L["Nav_SkipToContent"]</a>

<Layout Class="exits-admin-layout">
    <Sider Collapsible
           @bind-Collapsed="_collapsed"
           Theme="SiderTheme.Dark"
           Width="220"
           CollapsedWidth="64"
           Breakpoint="@BreakpointType.Lg"
           Class="exits-admin-sider">
        <div class="exits-brand" @onclick='() => Nav.NavigateTo("/admin")'>
            <span class="exits-brand-mark">EA</span>
            @if (!_collapsed)
            {
                <span class="exits-brand-text">@L["Brand_Name"]</span>
            }
        </div>
        <AdminNav @rendermode="InteractiveServer" Collapsed="_collapsed" />
    </Sider>

    <Layout>
        <Header Class="exits-admin-header">
            <div class="exits-header-left">
                <Button Type="@ButtonType.Text"
                        Icon="@(_collapsed ? "menu-unfold" : "menu-fold")"
                        OnClick="ToggleCollapsed"
                        AriaLabel="@(_collapsed ? L["Nav_OpenDrawer"] : L["Nav_CollapseSidebar"])" />
                <span class="exits-header-title">@L["Brand_Name"]</span>
                @if (!string.IsNullOrWhiteSpace(ActorDisplayName))
                {
                    <Tag Color="@("blue")">@ActorDisplayName</Tag>
                }
                <OrganizationContextSwitcher />
            </div>
            <div class="exits-header-right">
                <ThemeSelector @rendermode="InteractiveServer" />
                <LanguageSelector @rendermode="InteractiveServer" />
                <EnvironmentBanner ActorDisplayName="@ActorDisplayName" />
                <AuthorizeView>
                    <Authorized>
                        <Dropdown>
                            <Overlay>
                                <Menu>
                                    <MenuItem OnClick='() => Nav.NavigateTo("/admin/account/change-password")'>Change password</MenuItem>
                                    <MenuItem OnClick='() => Nav.NavigateTo("/admin/account/recovery-email")'>Recovery email</MenuItem>
                                    <MenuDivider />
                                    <MenuItem OnClick='() => Nav.NavigateTo("/admin/logout", forceLoad: true)'>Sign out</MenuItem>
                                </Menu>
                            </Overlay>
                            <ChildContent>
                                <Button Type="@ButtonType.Text" Class="exits-account-btn">
                                    <Avatar Size="AvatarSize.Small" Style="background:#085652">@AvatarInitial</Avatar>
                                    <span class="exits-account-label">Account</span>
                                </Button>
                            </ChildContent>
                        </Dropdown>
                    </Authorized>
                </AuthorizeView>
            </div>
        </Header>

        <Content Class="exits-admin-content">
            <div id="main-content" tabindex="-1">
                @Body
            </div>
        </Content>

        <Footer Class="exits-admin-footer">
            <span>@L["Footer_Text"]</span>
            @if (!string.IsNullOrWhiteSpace(ActorDisplayName))
            {
                <span class="muted"> — @string.Format(L["Footer_ActorContext"].Value, ActorDisplayName)</span>
            }
        </Footer>
    </Layout>
</Layout>

<ToastHost @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet role="alert">
    @L["Error_Unhandled"]
    <a href="." class="reload">@L["Error_Reload"]</a>
    <span class="dismiss">@L["Error_Dismiss"]</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _authDisplayName;
    private bool _collapsed;

    protected override async Task OnParametersSetAsync()
    {
        _authDisplayName = null;
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                _authDisplayName = state.User.Identity.Name;
            }
        }
    }

    private string? ActorDisplayName
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_authDisplayName))
            {
                return _authDisplayName;
            }

            return (Env.IsDevelopment() || Env.IsEnvironment("Testing"))
                   && !string.IsNullOrWhiteSpace(OperatorOptions.Value.DisplayName)
                ? OperatorOptions.Value.DisplayName
                : null;
        }
    }

    private string AvatarInitial =>
        string.IsNullOrWhiteSpace(ActorDisplayName) ? "A" : ActorDisplayName.Trim()[0].ToString().ToUpperInvariant();

    private void ToggleCollapsed() => _collapsed = !_collapsed;
}

@using AntDesign
@using ExItS.Platform.Admin.Models
@using ExItS.Platform.Admin.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IPlatformApiClient Api
@inject AdminShellContext Shell
@inject PlatformPermissionState Permissions
@inject NavigationManager Nav
@inject IStringLocalizer<AdminResources> L

@*
  Organization switcher is for Organization-shell actors only.
  Platform Administration must never appear beside ordinary organizations here.
*@
<AuthorizeView>
    <Authorized>
        @if (Shell.Loaded && Shell.IsOrganizationShell)
        {
            <div class="org-context" aria-live="polite">
                @if (_loading)
                {
                    <span class="app-header-chip">@L["OrgSwitcher_Loading"]</span>
                }
                else if (_activeCount == 0)
                {
                    <span class="app-header-chip" title="@L["OrgSwitcher_NoMembershipTitle"]">@L["OrgSwitcher_NoOrganization"]</span>
                }
                else if (_activeCount == 1 && _selectedId is not null)
                {
                    <span class="app-header-chip" title="@_selectedName">@_selectedName</span>
                }
                else
                {
                    <Select TItemValue="string"
                            TItem="string"
                            Style="min-width:160px; max-width:220px;"
                            Size="@InputSize.Small"
                            Placeholder="@L["OrgSwitcher_SelectPlaceholder"]"
                            Disabled="_busy"
                            Value="@(_selectedId?.ToString("D") ?? string.Empty)"
                            ValueChanged="OnOrganizationChangedAsync">
                        <SelectOptions>
                            @foreach (var org in _organizations)
                            {
                                <SelectOption TItemValue="string"
                                              TItem="string"
                                              Value="@org.OrganizationId.ToString("D")"
                                              Label="@org.DisplayName" />
                            }
                        </SelectOptions>
                    </Select>
                }
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <span class="org-context-error" role="alert">@_error</span>
                }
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private Guid? _selectedId;
    private string? _selectedName;
    private int _activeCount;
    private List<EligibleOrganizationDto> _organizations = [];

    protected override async Task OnInitializedAsync()
    {
        await Shell.EnsureLoadedAsync();
        if (Shell.IsOrganizationShell)
        {
            await RefreshAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var me = await Api.GetAuthMeAsync();
            if (!me.IsSuccess || me.Data is null)
            {
                _organizations = [];
                _selectedId = null;
                _selectedName = null;
                _activeCount = 0;
                return;
            }

            _selectedId = me.Data.SelectedOrganizationId;
            _selectedName = me.Data.SelectedOrganizationDisplayName;
            _activeCount = me.Data.ActiveOrganizationCount;

            var list = await Api.GetEligibleOrganizationsAsync();
            _organizations = list.IsSuccess && list.Data is not null
                ? list.Data.ToList()
                : [];
            _activeCount = Math.Max(_activeCount, _organizations.Count);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnOrganizationChangedAsync(string value)
    {
        if (_busy)
        {
            return;
        }

        Guid? organizationId = null;
        if (!string.IsNullOrWhiteSpace(value) && Guid.TryParse(value, out var parsed) && parsed != Guid.Empty)
        {
            organizationId = parsed;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Api.SetOrganizationContextAsync(new SetOrganizationContextRequest(organizationId));
            if (!result.IsSuccess || result.Data is null)
            {
                _error = result.Error?.Detail ?? L["OrgSwitcher_ChangeFailed"];
                await RefreshAsync();
                return;
            }

            _selectedId = result.Data.SelectedOrganizationId;
            _selectedName = result.Data.SelectedOrganizationDisplayName;
            _activeCount = result.Data.ActiveOrganizationCount;

            await Permissions.RefreshAsync();
            await Shell.RefreshAsync();

            if (_selectedId is Guid selected)
            {
                Nav.NavigateTo($"/admin/organizations/{selected:D}", forceLoad: false);
            }
            else
            {
                Nav.NavigateTo("/admin", forceLoad: false);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

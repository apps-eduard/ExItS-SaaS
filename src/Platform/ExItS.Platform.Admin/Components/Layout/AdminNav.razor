@inject PlatformPermissionState Permissions
@inject AdminShellContext Shell
@inject LocalValidationSignInService LocalValidation
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@using AntDesign
@implements IDisposable

@*
  Business navigation only. Session / profile / sign-out live in the header.
  Platform / Organization / Personal menus are mutually exclusive and follow AccountClass.
*@

@if (!_ready)
{
    <div class="exits-nav-loading" style="padding:12px;text-align:center;">
        <Spin Size="@SpinSize.Small" />
        @if (_shellLoadFailed)
        {
            <div style="margin-top:8px;">
                <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick="RetryShellAsync">@L["Common_Retry"]</Button>
            </div>
        }
    </div>
}

<Menu Theme="MenuTheme.Dark"
      Mode="MenuMode.Inline"
      InlineCollapsed="Collapsed"
      SelectedKeys="_selected"
      DefaultOpenKeys="_openKeys"
      Class="exits-admin-menu"
      OnMenuItemClicked="OnMenuItemClicked">
    <MenuItem Key="dashboard" RouterLink="/admin" RouterMatch="NavLinkMatch.All" Icon="dashboard">
        @(_ready && Shell.IsPersonalShell ? L["Nav_Home"] : L["Nav_Dashboard"])
    </MenuItem>

    @if (_ready && Shell.IsPlatformShell && Permissions.Loaded)
    {
        @if (PlatformAccountItems.Count > 0)
        {
            <SubMenu Key="accounts" TitleTemplate="@AccountsTitle">
                @foreach (var item in PlatformAccountItems)
                {
                    @if (item.Implemented && item.Route is not null)
                    {
                        <MenuItem Key="@item.Key" RouterLink="@item.Route" RouterMatch="NavLinkMatch.All" Icon="@AccountItemIcon(item.Key)">
                            @L[item.LabelKey]
                        </MenuItem>
                    }
                    else
                    {
                        <MenuItem Key="@item.Key" Disabled="true">
                            @L[item.LabelKey] <span class="exits-phase15-tag">@L["Nav_ComingSoon"]</span>
                        </MenuItem>
                    }
                }
            </SubMenu>
        }

        @if (ShowCommercialSection)
        {
            <SubMenu Key="commercial" TitleTemplate="@CommercialTitle">
                @if (CanView(PlatformPermissionCodes.ViewPortfolio))
                {
                    <MenuItem Key="organizations" RouterLink="/admin/organizations" Icon="bank">
                        @L["Nav_Organizations"]
                    </MenuItem>
                    <MenuItem Key="products" RouterLink="/admin/products" Icon="appstore">
                        @L["Nav_Products"]
                    </MenuItem>
                    <MenuItem Key="plans" RouterLink="/admin/plans" Icon="profile">
                        @L["Nav_Plans"]
                    </MenuItem>
                    <MenuItem Key="personal-features" RouterLink="/admin/personal-features" Icon="gift">
                        @L["Nav_PersonalFeatures"]
                    </MenuItem>
                }
                @if (CanView(PlatformPermissionCodes.ManageSubscriptions))
                {
                    <MenuItem Key="subscriptions" RouterLink="/admin/subscriptions" Icon="calendar">
                        @L["Nav_Subscriptions"]
                    </MenuItem>
                }
                @if (CanView(PlatformPermissionCodes.ManageEntitlementOverrides)
                     || CanView(PlatformPermissionCodes.ManageSubscriptions)
                     || CanView(PlatformPermissionCodes.ViewPortfolio))
                {
                    <MenuItem Key="entitlements" RouterLink="/admin/entitlements" Icon="safety-certificate">
                        @L["Nav_Entitlements"]
                    </MenuItem>
                }
                @if (CanView(PlatformPermissionCodes.ManageManualPayments))
                {
                    <MenuItem Key="payments" RouterLink="/admin/payments" Icon="dollar">
                        @L["Nav_Payments"]
                    </MenuItem>
                }
                @if (LocalValidationAvailable && CanView(PlatformPermissionCodes.ManageSubscriptions))
                {
                    <MenuItem Key="lv-test-payments" RouterLink="/admin/local-validation/test-payments" Icon="experiment">
                        Test Payments
                    </MenuItem>
                }
            </SubMenu>
        }

        @if (CanView(PlatformPermissionCodes.ViewGlobalCatalog))
        {
            <SubMenu Key="product-catalog" TitleTemplate="@ProductCatalogTitle">
                <MenuItem Key="global-business-types" RouterLink="/admin/global-catalog/business-types" Icon="tags">
                    @L["Nav_GlobalBusinessTypes"]
                </MenuItem>
                <MenuItem Key="global-categories" RouterLink="/admin/global-catalog/categories" Icon="apartment">
                    @L["Nav_GlobalCategories"]
                </MenuItem>
                <MenuItem Key="global-products" RouterLink="/admin/global-catalog/products" Icon="shopping">
                    @L["Nav_GlobalProducts"]
                </MenuItem>
                <MenuItem Key="global-templates" RouterLink="/admin/global-catalog/templates" Icon="appstore-add">
                    @L["Nav_GlobalTemplates"]
                </MenuItem>
                @if (CanView(PlatformPermissionCodes.ImportGlobalProducts))
                {
                    <MenuItem Key="global-imports" RouterLink="/admin/global-catalog/imports" Icon="upload">
                        @L["Nav_GlobalImports"]
                    </MenuItem>
                }
            </SubMenu>
        }

        @if (CanView(PlatformPermissionCodes.ViewPrivacyCompliance))
        {
            <SubMenu Key="privacy-compliance" TitleTemplate="@PrivacyComplianceTitle">
                <MenuItem Key="privacy-overview" RouterLink="/admin/privacy-compliance" RouterMatch="NavLinkMatch.All" Icon="dashboard">
                    @L["Nav_PrivacyComplianceOverview"]
                </MenuItem>
                <MenuItem Key="privacy-documents" RouterLink="/admin/privacy-compliance/documents" Icon="file-text">
                    @L["Nav_PrivacyComplianceDocuments"]
                </MenuItem>
                <MenuItem Key="privacy-systems" RouterLink="/admin/privacy-compliance/systems" Icon="cluster">
                    @L["Nav_PrivacyComplianceSystems"]
                </MenuItem>
                <MenuItem Key="privacy-pias" RouterLink="/admin/privacy-compliance/pias" Icon="audit">
                    @L["Nav_PrivacyCompliancePias"]
                </MenuItem>
                <MenuItem Key="privacy-data-inventory" RouterLink="/admin/privacy-compliance/data-inventory" Icon="database">
                    @L["Nav_PrivacyComplianceDataInventory"]
                </MenuItem>
                <MenuItem Key="privacy-retention" RouterLink="/admin/privacy-compliance/retention" Icon="history">
                    @L["Nav_PrivacyComplianceRetention"]
                </MenuItem>
                <MenuItem Key="privacy-incidents" RouterLink="/admin/privacy-compliance/incidents" Icon="alert">
                    @L["Nav_PrivacyComplianceIncidents"]
                </MenuItem>
                <MenuItem Key="privacy-vendors" RouterLink="/admin/privacy-compliance/vendors" Icon="shop">
                    @L["Nav_PrivacyComplianceVendors"]
                </MenuItem>
                <MenuItem Key="privacy-dpo-npc" RouterLink="/admin/privacy-compliance/dpo-npc" Icon="solution">
                    @L["Nav_PrivacyComplianceDpoNpc"]
                </MenuItem>
                <MenuItem Key="privacy-evidence" RouterLink="/admin/privacy-compliance/evidence" Icon="paper-clip">
                    @L["Nav_PrivacyComplianceEvidence"]
                </MenuItem>
            </SubMenu>
        }

        <SubMenu Key="operations" TitleTemplate="@OperationsTitle">
            @if (CanView(PlatformPermissionCodes.ManagePlatformUsers))
            {
                <MenuItem Key="platform-roles" RouterLink="/admin/platform-roles" Icon="key">
                    @L["Nav_RolesPermissions"]
                </MenuItem>
            }
            @if (CanView(PlatformPermissionCodes.ManageMemberships))
            {
                <MenuItem Key="org-users" RouterLink="/admin/organization-users" Icon="cluster">
                    @L["Nav_OrganizationMemberships"]
                </MenuItem>
            }
            @if (CanView(PlatformPermissionCodes.ViewAuditRecords))
            {
                <MenuItem Key="audit" RouterLink="/admin/audit" Icon="audit">
                    @L["Nav_AuditLogs"]
                </MenuItem>
            }
        </SubMenu>

        <SubMenu Key="settings" TitleTemplate="@SettingsTitle">
            @if (Shell.SelectedOrganizationId is Guid settingsOrg
                 && (CanView(PlatformPermissionCodes.ViewPortfolio) || CanView(PlatformPermissionCodes.ManageOrganizations)))
            {
                <MenuItem Key="org-settings" RouterLink="@($"/admin/organizations/{settingsOrg}")" Icon="setting">
                    @L["Nav_OrganizationSettings"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="org-settings" Disabled="true">
                    @L["Nav_OrganizationSettings"] <span class="exits-phase15-tag">@L["Nav_SelectOrganization"]</span>
                </MenuItem>
            }
            @if (Shell.SelectedOrganizationId is Guid brandingOrg
                 && (CanView(PlatformPermissionCodes.ViewPortfolio) || CanView(PlatformPermissionCodes.ManageOrganizations)))
            {
                <MenuItem Key="branding" RouterLink="@($"/admin/organizations/{brandingOrg}/branding")" Icon="bg-colors">
                    @L["Nav_Branding"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="branding" Disabled="true">
                    @L["Nav_Branding"] <span class="exits-phase15-tag">@L["Nav_SelectOrganization"]</span>
                </MenuItem>
            }
        </SubMenu>
    }
    else if (_ready && Shell.IsOrganizationShell)
    {
        <MenuItem Key="open-org-web" Icon="export" OnClick='() => Nav.NavigateTo("/admin/handoff/organization", forceLoad: true)'>
            Open Organization Web
        </MenuItem>
        @if (OrganizationPeopleItems.Count > 0)
        {
            <SubMenu Key="people" TitleTemplate="@PeopleTitle">
                @foreach (var item in OrganizationPeopleItems)
                {
                    @if (item.Implemented && item.Route is not null)
                    {
                        <MenuItem Key="@item.Key" RouterLink="@item.Route" Icon="@PeopleItemIcon(item.Key)">
                            @L[item.LabelKey]
                        </MenuItem>
                    }
                    else if (item.Implemented && item.Route is null)
                    {
                        <MenuItem Key="@item.Key" Disabled="true">
                            @L[item.LabelKey] <span class="exits-phase15-tag">@L["Nav_SelectOrganization"]</span>
                        </MenuItem>
                    }
                    else
                    {
                        <MenuItem Key="@item.Key" Disabled="true">
                            @L[item.LabelKey] <span class="exits-phase15-tag">@L["Nav_ComingSoon"]</span>
                        </MenuItem>
                    }
                }
            </SubMenu>
        }

        <SubMenu Key="org-products" TitleTemplate="@OrgProductsTitle">
            @if (Shell.SelectedOrganizationId is Guid productsOrg)
            {
                <MenuItem Key="my-products" RouterLink="@($"/admin/organizations/{productsOrg}/enabled-products")" Icon="appstore">
                    @L["Nav_MyProducts"]
                </MenuItem>
                @if (IsOrgAdminMembership)
                {
                    <MenuItem Key="enabled-products" RouterLink="@($"/admin/organizations/{productsOrg}/enabled-products")" Icon="rocket">
                        @L["OrgEnabledProducts_Title"]
                    </MenuItem>
                }
            }
            else
            {
                <MenuItem Key="my-products" Disabled="true">
                    @L["Nav_MyProducts"] <span class="exits-phase15-tag">@L["Nav_SelectOrganization"]</span>
                </MenuItem>
            }
        </SubMenu>

        <SubMenu Key="subscription" TitleTemplate="@SubscriptionTitle">
            @if (Shell.SelectedOrganizationId is Guid planOrg && IsOrgAdminMembership)
            {
                <MenuItem Key="current-plan" RouterLink="@($"/admin/organizations/{planOrg}/commercial")" Icon="profile">
                    @L["Nav_CurrentPlan"]
                </MenuItem>
                <MenuItem Key="billing" RouterLink="@($"/admin/organizations/{planOrg}/commercial")" Icon="credit-card">
                    @L["Nav_BillingRenewal"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="current-plan" Disabled="true">
                    @L["Nav_CurrentPlan"] <span class="exits-phase15-tag">@(IsOrgAdminMembership ? L["Nav_SelectOrganization"] : L["Unauthorized_Title"])</span>
                </MenuItem>
            }
            <MenuItem Key="usage" Disabled="true">
                @L["Nav_Usage"] <span class="exits-phase15-tag">@L["Nav_ComingSoon"]</span>
            </MenuItem>
        </SubMenu>

        <SubMenu Key="security" TitleTemplate="@SecurityTitle">
            <MenuItem Key="activity-log" Disabled="true">
                @L["Nav_ActivityLog"] <span class="exits-phase15-tag">@L["Nav_ComingSoon"]</span>
            </MenuItem>
        </SubMenu>

        <SubMenu Key="settings" TitleTemplate="@SettingsTitle">
            @if (Shell.SelectedOrganizationId is Guid orgSettingsId && IsOrgAdminMembership)
            {
                <MenuItem Key="org-settings" RouterLink="@($"/admin/organizations/{orgSettingsId}")" Icon="setting">
                    @L["Nav_OrganizationSettings"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="org-settings" Disabled="true">
                    @L["Nav_OrganizationSettings"] <span class="exits-phase15-tag">@(IsOrgAdminMembership ? L["Nav_SelectOrganization"] : L["Unauthorized_Title"])</span>
                </MenuItem>
            }
            @if (Shell.SelectedOrganizationId is Guid orgBrandingId && IsOrgAdminMembership)
            {
                <MenuItem Key="branding" RouterLink="@($"/admin/organizations/{orgBrandingId}/branding")" Icon="bg-colors">
                    @L["Nav_Branding"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="branding" Disabled="true">
                    @L["Nav_Branding"] <span class="exits-phase15-tag">@(IsOrgAdminMembership ? L["Nav_SelectOrganization"] : L["Unauthorized_Title"])</span>
                </MenuItem>
            }
        </SubMenu>
    }
    else if (_ready && Shell.IsPersonalShell)
    {
        <MenuItem Key="open-personal-web" Icon="export" OnClick='() => Nav.NavigateTo("/admin/handoff/personal", forceLoad: true)'>
            Open Personal Web
        </MenuItem>
        @foreach (var item in PersonalContactItems)
        {
            @if (item.Implemented && item.Route is not null)
            {
                <MenuItem Key="@item.Key" RouterLink="@item.Route" Icon="contacts">
                    @L[item.LabelKey]
                </MenuItem>
            }
        }

        <SubMenu Key="utang" TitleTemplate="@UtangTitle">
            <MenuItem Key="utang-lent" RouterLink="/admin/personal/utang/lent" Icon="export">
                @L["Nav_UtangLent"]
            </MenuItem>
            <MenuItem Key="utang-borrowed" RouterLink="/admin/personal/utang/borrowed" Icon="import">
                @L["Nav_UtangBorrowed"]
            </MenuItem>
            <MenuItem Key="utang-invitations" RouterLink="/admin/personal/utang/invitations" Icon="mail">
                @L["Nav_Invitations"]
            </MenuItem>
            <MenuItem Key="utang-payments" Disabled="true">
                @L["Nav_UtangPayments"] <span class="exits-phase15-tag">@L["Nav_ComingSoon"]</span>
            </MenuItem>
            <MenuItem Key="utang-reminders" Disabled="true">
                @L["Nav_UtangReminders"] <span class="exits-phase15-tag">@L["Nav_ComingSoon"]</span>
            </MenuItem>
            <MenuItem Key="utang-history" Disabled="true">
                @L["Nav_UtangHistory"] <span class="exits-phase15-tag">@L["Nav_ComingSoon"]</span>
            </MenuItem>
        </SubMenu>
        <MenuItem Key="personal-start-business" RouterLink="/admin/personal/start-business" Icon="shop">
            Start a Business
        </MenuItem>
        <MenuItem Key="personal-notifications" RouterLink="/admin/personal/notifications" Icon="bell">
            @L["Nav_Notifications"]
        </MenuItem>
        <MenuItem Key="personal-profile" RouterLink="/admin/personal/profile" Icon="user">
            @L["Nav_Profile"]
        </MenuItem>
        <MenuItem Key="personal-settings" RouterLink="/admin/personal/settings" Icon="setting">
            @L["Nav_PersonalSettings"]
        </MenuItem>
    }
</Menu>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool _ready;
    private bool _shellLoadFailed;
    private string[] _selected = ["dashboard"];
    private string[] _openKeys = ["accounts", "commercial", "product-catalog", "privacy-compliance", "operations", "settings", "people", "org-products", "subscription", "security", "utang"];

    private RenderFragment AccountsTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_Accounts"]); b.CloseElement(); };
    private RenderFragment CommercialTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionCommercial"]); b.CloseElement(); };
    private RenderFragment ProductCatalogTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_ProductCatalog"]); b.CloseElement(); };
    private RenderFragment PrivacyComplianceTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_PrivacyCompliance"]); b.CloseElement(); };
    private RenderFragment OperationsTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionOperations"]); b.CloseElement(); };
    private RenderFragment SettingsTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionSettings"]); b.CloseElement(); };
    private RenderFragment PeopleTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_People"]); b.CloseElement(); };
    private RenderFragment OrgProductsTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionProducts"]); b.CloseElement(); };
    private RenderFragment SubscriptionTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionSubscription"]); b.CloseElement(); };
    private RenderFragment SecurityTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionSecurity"]); b.CloseElement(); };
    private RenderFragment UtangTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_UtangTracker"]); b.CloseElement(); };

    private IReadOnlyList<AdminAccountUserNav.Item> PlatformAccountItems =>
        AdminAccountUserNav.PlatformAccounts(CanView(PlatformPermissionCodes.ManagePlatformUsers));

    private IReadOnlyList<AdminAccountUserNav.Item> OrganizationPeopleItems =>
        AdminAccountUserNav.OrganizationPeople(IsOrgAdminMembership, Shell.SelectedOrganizationId);

    private IReadOnlyList<AdminAccountUserNav.Item> PersonalContactItems =>
        AdminAccountUserNav.PersonalContacts();

    private bool ShowCommercialSection =>
        CanView(PlatformPermissionCodes.ViewPortfolio)
        || CanView(PlatformPermissionCodes.ManageSubscriptions)
        || CanView(PlatformPermissionCodes.ManageEntitlementOverrides)
        || CanView(PlatformPermissionCodes.ManageManualPayments);

    private bool LocalValidationAvailable => LocalValidation.IsAvailable;

    protected override async Task OnInitializedAsync()
    {
        Permissions.Changed += OnPermissionsChanged;
        Shell.Changed += OnShellChanged;
        Nav.LocationChanged += OnLocationChanged;
        // New circuit/session: reset selection so a prior account-class menu cannot linger.
        _selected = ["dashboard"];
        await LoadShellForNavAsync();
    }

    private async Task RetryShellAsync()
    {
        _shellLoadFailed = false;
        _ready = false;
        await InvokeAsync(StateHasChanged);
        await LoadShellForNavAsync();
    }

    private async Task LoadShellForNavAsync()
    {
        try
        {
            await Shell.EnsureLoadedAsync();
            if (!Shell.Loaded)
            {
                // One intentional retry after circuit session capture — no delay loops.
                await Shell.RefreshAsync();
            }
        }
        catch
        {
            // Keep Spin + Retry instead of painting a false Dashboard-only menu.
        }

        await ApplyNavReadyFromShellAsync();
    }

    private async Task ApplyNavReadyFromShellAsync()
    {
        if (!Shell.Loaded)
        {
            _shellLoadFailed = true;
            _ready = false;
            SyncSelection();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (Shell.IsPlatformShell)
        {
            try
            {
                await Permissions.EnsureLoadedAsync();
            }
            catch
            {
                // Nav falls back to permission-safe empty Platform submenus once shell is known.
            }
        }

        _shellLoadFailed = false;
        _ready = true;
        SyncSelection();
        await InvokeAsync(StateHasChanged);
    }

    private void OnPermissionsChanged()
    {
        if (Shell.Loaded && !_ready)
        {
            _ = ApplyNavReadyFromShellAsync();
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnShellChanged()
    {
        if (Shell.Loaded && !_ready)
        {
            _ = ApplyNavReadyFromShellAsync();
            return;
        }

        if (!Shell.Loaded && _ready)
        {
            _ready = false;
            _shellLoadFailed = true;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnMenuItemClicked(MenuItem item)
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSelection();
        if (!_ready)
        {
            _ = LoadShellForNavAsync();
        }
        else
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void SyncSelection()
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.AbsolutePath.TrimEnd('/');
        string[] next = path switch
        {
            "/admin" => ["dashboard"],
            "/admin/users" => ["all-accounts"],
            "/admin/users/unassigned" => ["needs-review"],
            "/admin/users/organization" => ["organization-accounts"],
            "/admin/users/platform-staff" => ["platform-accounts"],
            var p when p.StartsWith("/admin/users/", StringComparison.Ordinal) => ["all-accounts"],
            var p when p.StartsWith("/admin/platform-roles", StringComparison.Ordinal) => ["platform-roles"],
            var p when p.StartsWith("/admin/organization-users", StringComparison.Ordinal) => ["org-users"],
            var p when p.Contains("/roles", StringComparison.Ordinal) => ["org-roles"],
            var p when p.Contains("/invitations", StringComparison.Ordinal) =>
                Shell.IsOrganizationShell ? ["org-invitations"] : ["org-users"],
            var p when p.Contains("/members", StringComparison.Ordinal) =>
                Shell.IsOrganizationShell ? ["org-staff"] : ["org-users"],
            var p when p.Contains("/enabled-products", StringComparison.Ordinal) =>
                IsOrgAdminMembership ? ["enabled-products", "my-products"] : ["my-products"],
            var p when p.Contains("/product-access", StringComparison.Ordinal) => ["organizations"],
            var p when p.EndsWith("/branding", StringComparison.Ordinal) => ["branding"],
            var p when p.StartsWith("/admin/organizations", StringComparison.Ordinal) =>
                Shell.IsOrganizationShell ? ["org-settings"] : ["organizations"],
            var p when p.StartsWith("/admin/global-catalog/categories", StringComparison.Ordinal) => ["global-categories"],
            var p when p.StartsWith("/admin/global-catalog/imports", StringComparison.Ordinal) => ["global-imports"],
            var p when p.StartsWith("/admin/global-catalog/products", StringComparison.Ordinal) => ["global-products"],
            var p when p.StartsWith("/admin/global-catalog/templates", StringComparison.Ordinal) => ["global-templates"],
            "/admin/privacy-compliance" => ["privacy-overview"],
            var p when p.StartsWith("/admin/privacy-compliance/documents", StringComparison.Ordinal) => ["privacy-documents"],
            var p when p.StartsWith("/admin/privacy-compliance/systems", StringComparison.Ordinal) => ["privacy-systems"],
            var p when p.StartsWith("/admin/privacy-compliance/pias", StringComparison.Ordinal) => ["privacy-pias"],
            var p when p.StartsWith("/admin/privacy-compliance/data-inventory", StringComparison.Ordinal) => ["privacy-data-inventory"],
            var p when p.StartsWith("/admin/privacy-compliance/retention", StringComparison.Ordinal) => ["privacy-retention"],
            var p when p.StartsWith("/admin/privacy-compliance/incidents", StringComparison.Ordinal) => ["privacy-incidents"],
            var p when p.StartsWith("/admin/privacy-compliance/vendors", StringComparison.Ordinal) => ["privacy-vendors"],
            var p when p.StartsWith("/admin/privacy-compliance/dpo-npc", StringComparison.Ordinal) => ["privacy-dpo-npc"],
            var p when p.StartsWith("/admin/privacy-compliance/evidence", StringComparison.Ordinal) => ["privacy-evidence"],
            var p when p.StartsWith("/admin/products", StringComparison.Ordinal) => ["products"],
            var p when p.StartsWith("/admin/plans", StringComparison.Ordinal) => ["plans"],
            var p when p.StartsWith("/admin/subscriptions", StringComparison.Ordinal) => ["subscriptions"],
            var p when p.StartsWith("/admin/entitlements", StringComparison.Ordinal) => ["entitlements"],
            var p when p.StartsWith("/admin/payments", StringComparison.Ordinal) => ["payments"],
            var p when p.StartsWith("/admin/audit", StringComparison.Ordinal) =>
                Shell.IsOrganizationShell ? ["activity-log"] : ["audit"],
            "/admin/personal/utang/people" => ["personal-contacts"],
            "/admin/personal/utang/lent" => ["utang-lent"],
            "/admin/personal/utang/borrowed" => ["utang-borrowed"],
            "/admin/personal/utang/invitations" => ["utang-invitations"],
            "/admin/personal/notifications" => ["personal-notifications"],
            "/admin/personal/profile" => ["personal-profile"],
            "/admin/personal/settings" => ["personal-settings"],
            _ => _selected
        };

        if (next.Length == _selected.Length && next.SequenceEqual(_selected, StringComparer.Ordinal))
        {
            return;
        }

        _selected = next;
    }

    private bool CanView(string permission) => Permissions.HasPermission(permission);

    private bool IsOrgAdminMembership =>
        string.Equals(Shell.MembershipRole, "OrganizationOwner", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Shell.MembershipRole, "OrganizationAdministrator", StringComparison.OrdinalIgnoreCase);

    private static string AccountItemIcon(string key) => key switch
    {
        "all-accounts" => "team",
        "platform-accounts" => "safety",
        "organization-accounts" => "bank",
        "personal-accounts" => "user",
        "needs-review" => "alert",
        _ => "user"
    };

    private static string PeopleItemIcon(string key) => key switch
    {
        "org-staff" => "team",
        "org-invitations" => "mail",
        "org-customers" => "idcard",
        "org-customer-linking" => "link",
        _ => "team"
    };

    public void Dispose()
    {
        Permissions.Changed -= OnPermissionsChanged;
        Shell.Changed -= OnShellChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

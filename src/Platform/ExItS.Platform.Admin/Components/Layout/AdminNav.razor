@inject PlatformPermissionState Permissions
@inject IStringLocalizer<AdminResources> L

<nav class="admin-nav-scroll" aria-label="@L["Aria_AdminNav"]">
    <div class="nav-section">@L["Nav_SectionOverview"]</div>
    <NavLink class="nav-item" href="/admin" Match="NavLinkMatch.All">
        <NavIcon Name="dashboard" /><span class="nav-label">@L["Nav_Dashboard"]</span>
    </NavLink>

    <div class="nav-section">@L["Nav_SectionCommercial"]</div>
    @if (CanView(PlatformPermissionCodes.ViewPortfolio))
    {
        <NavLink class="nav-item" href="/admin/products">
            <NavIcon Name="products" /><span class="nav-label">@L["Nav_Products"]</span>
        </NavLink>
        <NavLink class="nav-item" href="/admin/organizations">
            <NavIcon Name="organizations" /><span class="nav-label">@L["Nav_Organizations"]</span>
        </NavLink>
    }
    @if (CanView(PlatformPermissionCodes.ManageSubscriptions))
    {
        <NavLink class="nav-item" href="/admin/subscriptions">
            <NavIcon Name="subscriptions" /><span class="nav-label">@L["Nav_Subscriptions"]</span>
        </NavLink>
    }
    @if (CanView(PlatformPermissionCodes.ManageManualPayments))
    {
        <NavLink class="nav-item" href="/admin/payments">
            <NavIcon Name="payments" /><span class="nav-label">@L["Nav_Payments"]</span>
        </NavLink>
    }

    <div class="nav-section">@L["Nav_SectionAccess"]</div>
    @if (CanView(PlatformPermissionCodes.ManagePlatformUsers))
    {
        <NavLink class="nav-item" href="/admin/users">
            <NavIcon Name="users" /><span class="nav-label">@L["Nav_Users"]</span>
        </NavLink>
    }
    @if (CanView(PlatformPermissionCodes.ViewPortfolio))
    {
        <NavLink class="nav-item" href="/admin/entitlements">
            <NavIcon Name="entitlements" /><span class="nav-label">@L["Nav_Entitlements"]</span>
        </NavLink>
    }

    @if (CanView(PlatformPermissionCodes.ViewAuditRecords))
    {
        <div class="nav-section">@L["Nav_SectionCompliance"]</div>
        <NavLink class="nav-item" href="/admin/audit">
            <NavIcon Name="audit" /><span class="nav-label">@L["Nav_Audit"]</span>
        </NavLink>
    }
</nav>

@code {
    protected override async Task OnInitializedAsync() => await Permissions.EnsureLoadedAsync();

    private bool CanView(string permission) => !Permissions.Loaded || Permissions.HasPermission(permission);
}

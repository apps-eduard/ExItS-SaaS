@inject PlatformPermissionState Permissions
@inject AdminShellContext Shell
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@using AntDesign
@implements IDisposable

@*
  Business navigation only. Session / profile / sign-out live in the header.
  Platform vs Organization menus are mutually exclusive (platform permissions win).
*@

<Menu Theme="MenuTheme.Dark"
      Mode="MenuMode.Inline"
      InlineCollapsed="Collapsed"
      SelectedKeys="_selected"
      DefaultOpenKeys="_openKeys"
      Class="exits-admin-menu"
      OnMenuItemClicked="OnMenuItemClicked">
    <MenuItem Key="dashboard" RouterLink="/admin" RouterMatch="NavLinkMatch.All" Icon="dashboard">
        @L["Nav_Dashboard"]
    </MenuItem>

    @if (_ready && Shell.IsPlatformShell)
    {
        @if (ShowPlatformUsersSection)
        {
            <SubMenu Key="users" TitleTemplate="@UsersTitle">
                @if (CanView(PlatformPermissionCodes.ManagePlatformUsers))
                {
                    <MenuItem Key="all-users" RouterLink="/admin/users" Icon="user">
                        @L["Nav_AllUsers"]
                    </MenuItem>
                    <MenuItem Key="unassigned-users" RouterLink="/admin/users/unassigned" Icon="user-delete">
                        @L["Nav_UnassignedUsers"]
                    </MenuItem>
                    <MenuItem Key="org-directory-users" RouterLink="/admin/users/organization" Icon="team">
                        @L["Nav_OrganizationUsers"]
                    </MenuItem>
                    <MenuItem Key="platform-staff" RouterLink="/admin/users/platform-staff" Icon="safety">
                        @L["Nav_PlatformStaff"]
                    </MenuItem>
                    <MenuItem Key="platform-roles" RouterLink="/admin/platform-roles" Icon="key">
                        @L["Nav_RolesPermissions"]
                    </MenuItem>
                }
                @if (CanView(PlatformPermissionCodes.ManageMemberships))
                {
                    <MenuItem Key="org-users" RouterLink="/admin/organization-users" Icon="cluster">
                        @L["Nav_OrganizationUsers"]
                    </MenuItem>
                }
            </SubMenu>
        }

        @if (ShowCommercialSection)
        {
            <SubMenu Key="commercial" TitleTemplate="@CommercialTitle">
                @if (CanView(PlatformPermissionCodes.ViewPortfolio))
                {
                    <MenuItem Key="organizations" RouterLink="/admin/organizations" Icon="bank">
                        @L["Nav_Organizations"]
                    </MenuItem>
                    <MenuItem Key="products" RouterLink="/admin/products" Icon="appstore">
                        @L["Nav_Products"]
                    </MenuItem>
                    <MenuItem Key="plans" RouterLink="/admin/plans" Icon="profile">
                        @L["Nav_Plans"]
                    </MenuItem>
                }
                @if (CanView(PlatformPermissionCodes.ManageSubscriptions))
                {
                    <MenuItem Key="subscriptions" RouterLink="/admin/subscriptions" Icon="calendar">
                        @L["Nav_Subscriptions"]
                    </MenuItem>
                }
                @if (CanView(PlatformPermissionCodes.ManageEntitlementOverrides)
                     || CanView(PlatformPermissionCodes.ManageSubscriptions)
                     || CanView(PlatformPermissionCodes.ViewPortfolio))
                {
                    <MenuItem Key="entitlements" RouterLink="/admin/entitlements" Icon="safety-certificate">
                        @L["Nav_Entitlements"]
                    </MenuItem>
                }
                @if (CanView(PlatformPermissionCodes.ManageManualPayments))
                {
                    <MenuItem Key="payments" RouterLink="/admin/payments" Icon="dollar">
                        @L["Nav_Payments"]
                    </MenuItem>
                }
            </SubMenu>
        }

        <SubMenu Key="operations" TitleTemplate="@OperationsTitle">
            @if (CanView(PlatformPermissionCodes.ManageProductAccess))
            {
                <MenuItem Key="product-access" Disabled="true">
                    @L["Nav_ProductAccess"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
            <MenuItem Key="system-status" Disabled="true">
                @L["Nav_SystemStatus"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
            </MenuItem>
            @if (CanView(PlatformPermissionCodes.ViewAuditRecords))
            {
                <MenuItem Key="audit" RouterLink="/admin/audit" Icon="audit">
                    @L["Nav_AuditLogs"]
                </MenuItem>
            }
        </SubMenu>

        <SubMenu Key="settings" TitleTemplate="@SettingsTitle">
            @if (Shell.SelectedOrganizationId is Guid settingsOrg
                 && (CanView(PlatformPermissionCodes.ViewPortfolio) || CanView(PlatformPermissionCodes.ManageOrganizations)))
            {
                <MenuItem Key="org-settings" RouterLink="@($"/admin/organizations/{settingsOrg}")" Icon="setting">
                    @L["Nav_OrganizationSettings"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="org-settings" Disabled="true">
                    @L["Nav_OrganizationSettings"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
            @if (Shell.SelectedOrganizationId is Guid brandingOrg
                 && (CanView(PlatformPermissionCodes.ViewPortfolio) || CanView(PlatformPermissionCodes.ManageOrganizations)))
            {
                <MenuItem Key="branding" RouterLink="@($"/admin/organizations/{brandingOrg}/branding")" Icon="bg-colors">
                    @L["Nav_Branding"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="branding" Disabled="true">
                    @L["Nav_Branding"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
        </SubMenu>
    }
    else if (_ready && Shell.IsOrganizationShell)
    {
        <SubMenu Key="organization" TitleTemplate="@OrganizationTitle">
            @if (Shell.SelectedOrganizationId is Guid orgId
                 && (CanView(PlatformPermissionCodes.ViewPortfolio) || IsOrgAdminMembership))
            {
                <MenuItem Key="org-profile" RouterLink="@($"/admin/organizations/{orgId}")" Icon="bank">
                    @L["Nav_OrganizationProfile"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="org-profile" Disabled="true">
                    @L["Nav_OrganizationProfile"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
            @if (Shell.SelectedOrganizationId is Guid membersOrg
                 && (CanView(PlatformPermissionCodes.ManageMemberships) || IsOrgAdminMembership))
            {
                <MenuItem Key="org-members" RouterLink="@($"/admin/organizations/{membersOrg}/members")" Icon="team">
                    @L["Nav_Members"]
                </MenuItem>
                <MenuItem Key="org-invitations" RouterLink="@($"/admin/organizations/{membersOrg}/members")" Icon="mail">
                    @L["Nav_Invitations"]
                </MenuItem>
                <MenuItem Key="org-roles" RouterLink="@($"/admin/organizations/{membersOrg}/roles")" Icon="key">
                    @L["Nav_RolesPermissions"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="org-members" Disabled="true">
                    @L["Nav_Members"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
        </SubMenu>

        <SubMenu Key="org-products" TitleTemplate="@OrgProductsTitle">
            @if (Shell.SelectedOrganizationId is Guid accessOrg
                 && (IsOrgAdminMembership || CanView(PlatformPermissionCodes.ManageProductAccess)))
            {
                <MenuItem Key="my-products" RouterLink="@($"/admin/organizations/{accessOrg}/product-access")" Icon="appstore">
                    @L["Nav_MyProducts"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="my-products" Disabled="true">
                    @L["Nav_MyProducts"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
            <MenuItem Key="launch-product" Disabled="true">
                @L["Nav_LaunchProduct"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
            </MenuItem>
        </SubMenu>

        <SubMenu Key="subscription" TitleTemplate="@SubscriptionTitle">
            @if (Shell.SelectedOrganizationId is Guid planOrg
                 && (CanView(PlatformPermissionCodes.ViewPortfolio) || IsOrgAdminMembership))
            {
                <MenuItem Key="current-plan" RouterLink="@($"/admin/organizations/{planOrg}")" Icon="profile">
                    @L["Nav_CurrentPlan"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="current-plan" Disabled="true">
                    @L["Nav_CurrentPlan"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
            <MenuItem Key="usage" Disabled="true">
                @L["Nav_Usage"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
            </MenuItem>
            <MenuItem Key="billing" Disabled="true">
                @L["Nav_BillingRenewal"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
            </MenuItem>
        </SubMenu>

        <SubMenu Key="security" TitleTemplate="@SecurityTitle">
            @if (CanView(PlatformPermissionCodes.ViewAuditRecords))
            {
                <MenuItem Key="activity-log" RouterLink="/admin/audit" Icon="audit">
                    @L["Nav_ActivityLog"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="activity-log" Disabled="true">
                    @L["Nav_ActivityLog"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
        </SubMenu>

        <SubMenu Key="settings" TitleTemplate="@SettingsTitle">
            @if (Shell.SelectedOrganizationId is Guid orgSettingsId)
            {
                <MenuItem Key="org-settings" RouterLink="@($"/admin/organizations/{orgSettingsId}")" Icon="setting">
                    @L["Nav_OrganizationSettings"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="org-settings" Disabled="true">
                    @L["Nav_OrganizationSettings"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
            @if (Shell.SelectedOrganizationId is Guid orgBrandingId && IsOrgAdminMembership)
            {
                <MenuItem Key="branding" RouterLink="@($"/admin/organizations/{orgBrandingId}/branding")" Icon="bg-colors">
                    @L["Nav_Branding"]
                </MenuItem>
            }
            else
            {
                <MenuItem Key="branding" Disabled="true">
                    @L["Nav_Branding"] <span class="exits-phase15-tag">@L["Nav_Phase15"]</span>
                </MenuItem>
            }
        </SubMenu>
    }
</Menu>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool _ready;
    private string[] _selected = ["dashboard"];
    private string[] _openKeys = ["users", "commercial", "operations", "settings", "organization", "org-products", "subscription", "security"];

    private RenderFragment UsersTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_Users"]); b.CloseElement(); };
    private RenderFragment CommercialTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionCommercial"]); b.CloseElement(); };
    private RenderFragment OperationsTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionOperations"]); b.CloseElement(); };
    private RenderFragment SettingsTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionSettings"]); b.CloseElement(); };
    private RenderFragment OrganizationTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionOrganization"]); b.CloseElement(); };
    private RenderFragment OrgProductsTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionProducts"]); b.CloseElement(); };
    private RenderFragment SubscriptionTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionSubscription"]); b.CloseElement(); };
    private RenderFragment SecurityTitle => b => { b.OpenElement(0, "span"); b.AddContent(1, L["Nav_SectionSecurity"]); b.CloseElement(); };

    private bool ShowPlatformUsersSection =>
        CanView(PlatformPermissionCodes.ManagePlatformUsers)
        || CanView(PlatformPermissionCodes.ManageMemberships);

    private bool ShowCommercialSection =>
        CanView(PlatformPermissionCodes.ViewPortfolio)
        || CanView(PlatformPermissionCodes.ManageSubscriptions)
        || CanView(PlatformPermissionCodes.ManageEntitlementOverrides)
        || CanView(PlatformPermissionCodes.ManageManualPayments);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Permissions.EnsureLoadedAsync();
            await Shell.EnsureLoadedAsync();
        }
        catch
        {
            // Keep Dashboard usable if shell APIs are briefly rate-limited after login.
        }

        _ready = true;
        SyncSelection();
        Nav.LocationChanged += OnLocationChanged;
    }

    private async Task OnMenuItemClicked(MenuItem item)
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncSelection()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        string[] next = path switch
        {
            "/admin" => ["dashboard"],
            var p when p.StartsWith("/admin/users", StringComparison.Ordinal) => ["platform-users"],
            var p when p.StartsWith("/admin/organization-users", StringComparison.Ordinal) => ["org-users"],
            var p when p.Contains("/members", StringComparison.Ordinal) => Shell.IsOrganizationShell ? ["org-members"] : ["org-users"],
            var p when p.Contains("/product-access", StringComparison.Ordinal) => Shell.IsOrganizationShell ? ["my-products"] : ["organizations"],
            var p when p.EndsWith("/branding", StringComparison.Ordinal) => ["branding"],
            var p when p.StartsWith("/admin/organizations", StringComparison.Ordinal) =>
                Shell.IsOrganizationShell ? ["org-profile"] : ["organizations"],
            var p when p.StartsWith("/admin/products", StringComparison.Ordinal) => ["products"],
            var p when p.StartsWith("/admin/plans", StringComparison.Ordinal) => ["plans"],
            var p when p.StartsWith("/admin/subscriptions", StringComparison.Ordinal) => ["subscriptions"],
            var p when p.StartsWith("/admin/entitlements", StringComparison.Ordinal) => ["entitlements"],
            var p when p.StartsWith("/admin/payments", StringComparison.Ordinal) => ["payments"],
            var p when p.StartsWith("/admin/audit", StringComparison.Ordinal) =>
                Shell.IsOrganizationShell ? ["activity-log"] : ["audit"],
            _ => _selected
        };

        if (next.Length == _selected.Length && next.SequenceEqual(_selected, StringComparer.Ordinal))
        {
            return;
        }

        _selected = next;
    }

    private bool CanView(string permission) => Permissions.HasPermission(permission);

    private bool IsOrgAdminMembership =>
        string.Equals(Shell.MembershipRole, "OrganizationOwner", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Shell.MembershipRole, "OrganizationAdministrator", StringComparison.OrdinalIgnoreCase);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

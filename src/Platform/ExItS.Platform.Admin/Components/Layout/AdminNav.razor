@inject PlatformPermissionState Permissions
@inject IStringLocalizer<AdminResources> L
@inject NavigationManager Nav
@using AntDesign
@implements IDisposable

<Menu Theme="MenuTheme.Dark"
      Mode="MenuMode.Inline"
      InlineCollapsed="Collapsed"
      SelectedKeys="_selected"
      DefaultOpenKeys="_openKeys"
      Class="exits-admin-menu">
    <MenuItem Key="dashboard" RouterLink="/admin" RouterMatch="NavLinkMatch.All" Icon="dashboard">
        @L["Nav_Dashboard"]
    </MenuItem>

    <SubMenu Key="users" TitleTemplate="@UsersTitle">
        @if (CanView(PlatformPermissionCodes.ManagePlatformUsers))
        {
            <MenuItem Key="platform-users" RouterLink="/admin/users" Icon="user">
                Platform Users
            </MenuItem>
        }
        @if (CanView(PlatformPermissionCodes.ViewPortfolio))
        {
            <MenuItem Key="org-users" RouterLink="/admin/organizations" Icon="team">
                Organization Users
            </MenuItem>
        }
    </SubMenu>

    <SubMenu Key="commercial" TitleTemplate="@CommercialTitle">
        @if (CanView(PlatformPermissionCodes.ViewPortfolio))
        {
            <MenuItem Key="organizations" RouterLink="/admin/organizations" Icon="bank">
                @L["Nav_Organizations"]
            </MenuItem>
            <MenuItem Key="products" RouterLink="/admin/products" Icon="appstore">
                @L["Nav_Products"]
            </MenuItem>
            <MenuItem Key="product-entry" RouterLink="/admin/product-entry" Icon="plus-square">
                @L["Nav_ProductEntry"]
            </MenuItem>
            <MenuItem Key="plans" RouterLink="/admin/products" Icon="profile">
                Plans
            </MenuItem>
        }
        @if (CanView(PlatformPermissionCodes.ManageSubscriptions))
        {
            <MenuItem Key="subscriptions" RouterLink="/admin/subscriptions" Icon="calendar">
                @L["Nav_Subscriptions"]
            </MenuItem>
        }
        @if (CanView(PlatformPermissionCodes.ManageManualPayments))
        {
            <MenuItem Key="payments" RouterLink="/admin/payments" Icon="dollar">
                @L["Nav_Payments"]
            </MenuItem>
        }
        @if (CanView(PlatformPermissionCodes.ViewPortfolio))
        {
            <MenuItem Key="entitlements" RouterLink="/admin/entitlements" Icon="key">
                @L["Nav_Entitlements"]
            </MenuItem>
        }
    </SubMenu>

    @if (CanView(PlatformPermissionCodes.ViewAuditRecords))
    {
        <SubMenu Key="ops" TitleTemplate="@OpsTitle">
            <MenuItem Key="audit" RouterLink="/admin/audit" Icon="audit">
                @L["Nav_Audit"]
            </MenuItem>
        </SubMenu>
    }
</Menu>

@code {
    [Parameter] public bool Collapsed { get; set; }

    private string[] _selected = ["dashboard"];
    private string[] _openKeys = ["users", "commercial", "ops"];

    private RenderFragment UsersTitle => @<span><Icon Type="team" Theme="IconThemeType.Outline" /><span>Users</span></span>;
    private RenderFragment CommercialTitle => @<span><Icon Type="shop" Theme="IconThemeType.Outline" /><span>@L["Nav_SectionCommercial"]</span></span>;
    private RenderFragment OpsTitle => @<span><Icon Type="safety" Theme="IconThemeType.Outline" /><span>Operations</span></span>;

    protected override async Task OnInitializedAsync()
    {
        await Permissions.EnsureLoadedAsync();
        SyncSelection();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncSelection()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        _selected = path switch
        {
            "/admin" => ["dashboard"],
            var p when p.StartsWith("/admin/users", StringComparison.Ordinal) => ["platform-users"],
            var p when p.StartsWith("/admin/organizations", StringComparison.Ordinal) => ["organizations"],
            var p when p.StartsWith("/admin/products", StringComparison.Ordinal) => ["products"],
            var p when p.StartsWith("/admin/product-entry", StringComparison.Ordinal) => ["product-entry"],
            var p when p.StartsWith("/admin/subscriptions", StringComparison.Ordinal) => ["subscriptions"],
            var p when p.StartsWith("/admin/payments", StringComparison.Ordinal) => ["payments"],
            var p when p.StartsWith("/admin/entitlements", StringComparison.Ordinal) => ["entitlements"],
            var p when p.StartsWith("/admin/audit", StringComparison.Ordinal) => ["audit"],
            _ => _selected
        };
    }

    private bool CanView(string permission) => !Permissions.Loaded || Permissions.HasPermission(permission);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

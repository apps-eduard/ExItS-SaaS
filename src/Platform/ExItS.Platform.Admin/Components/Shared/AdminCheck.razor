@*
  Checkbox / toggle styled control with accessible label association via FormField or standalone.
*@
<label class="form-check @(Toggle ? "form-check--toggle" : null)">
    <input type="checkbox"
           id="@ResolvedId"
           checked="@Value"
           @onchange="OnChange"
           disabled="@IsDisabled"
           aria-describedby="@Context?.AriaDescribedBy" />
    <span>@(CheckLabel ?? Context?.FieldId)</span>
</label>

@code {
    [CascadingParameter] public FormFieldContext? Context { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? CheckLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Toggle { get; set; }

    private string ResolvedId => Id ?? Context?.FieldId ?? $"check-{Guid.NewGuid():N}";
    private bool IsDisabled => Disabled || (Context?.Disabled ?? false);

    private async Task OnChange(ChangeEventArgs e)
    {
        var next = e.Value is bool b && b || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await ValueChanged.InvokeAsync(next);
    }
}

@inject ThemeService Theme
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IStringLocalizer<AdminResources> L
@using AntDesign
@implements IDisposable

@*
  Compact Light / Dark / System selector for the Admin header.
*@

@if (_ready)
{
    <Select TItemValue="string"
            TItem="string"
            Value="@_value"
            ValueChanged="OnValueChangedAsync"
            Style="width: 104px"
            Size="@InputSize.Small"
            Class="exits-theme-select"
            Placeholder="@L["Theme_Label"]">
        <SelectOptions>
            <SelectOption TItemValue="string" TItem="string" Value="@("light")" Label="@L["Theme_Light"]" />
            <SelectOption TItemValue="string" TItem="string" Value="@("dark")" Label="@L["Theme_Dark"]" />
            <SelectOption TItemValue="string" TItem="string" Value="@("system")" Label="@L["Theme_System"]" />
        </SelectOptions>
    </Select>
}
else
{
    <span class="exits-theme-select-placeholder muted">@L["Theme_Label"]</span>
}

@code {
    private bool _ready;
    private string _value = "light";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Theme.Changed += OnThemeChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready)
        {
            return;
        }

        await Theme.InitializeAsync();
        _value = ThemeService.ToStorageValue(Theme.Current);
        _ready = true;
        StateHasChanged();
    }

    private async Task OnValueChangedAsync(string value)
    {
        if (!_ready || string.Equals(value, _value, StringComparison.Ordinal))
        {
            return;
        }

        _value = value;
        await Theme.SetThemeAsync(ThemeService.Parse(value));
    }

    private async Task OnThemeChangedAsync()
    {
        _value = ThemeService.ToStorageValue(Theme.Current);
        await InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try { await Js.InvokeVoidAsync("exitsAdminTheme.reapplyFromStorage"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Theme.Changed -= OnThemeChangedAsync;
    }
}

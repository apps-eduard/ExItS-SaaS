@inject ThemeService Theme
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IStringLocalizer<AdminResources> L
@using AntDesign
@implements IDisposable

<Select TItem="string"
        TItemValue="string"
        Value="@_selected"
        ValueChanged="OnChangedAsync"
        Disabled="@(!_ready)"
        Size="@InputSize.Small"
        Style="width: 7.5rem;"
        Placeholder="@L["Theme_Label"]"
        AllowClear="false">
    <SelectOptions>
        <SelectOption TItem="string" TItemValue="string" Value="@("system")" Label="@L["Theme_System"]" />
        <SelectOption TItem="string" TItemValue="string" Value="@("light")" Label="@L["Theme_Light"]" />
        <SelectOption TItem="string" TItemValue="string" Value="@("dark")" Label="@L["Theme_Dark"]" />
    </SelectOptions>
</Select>

@code {
    private bool _ready;
    private string _selected = "system";

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready)
        {
            return;
        }

        await Theme.InitializeAsync();
        _selected = ThemeService.ToStorageValue(Theme.Current);
        _ready = true;
        StateHasChanged();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try { await Js.InvokeVoidAsync("exitsAdminTheme.reapplyFromStorage"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task OnChangedAsync(string value)
    {
        _selected = value ?? "system";
        await Theme.SetThemeAsync(ThemeService.Parse(_selected));
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

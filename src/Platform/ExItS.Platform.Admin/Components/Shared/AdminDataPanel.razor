@inject IStringLocalizer<AdminResources> L

@*
  Shared loading / empty / error / denied / conflict gate for Admin data views.
  Child content is rendered only when data is ready to display.
*@
@if (IsLoading)
{
    <LoadingState Message="@LoadingMessage" />
}
else if (IsDenied)
{
    <DeniedState RequiredPermission="@DeniedPermission" Message="@DeniedMessage" />
}
else if (IsConflict)
{
    <ConflictState Title="@ConflictTitle" Message="@ConflictMessage" />
}
else if (HasError)
{
    <ErrorState Title="@ErrorTitle" Detail="@ErrorDetail" CorrelationId="@ErrorCorrelationId" Unavailable="ErrorUnavailable" />
}
else if (IsEmpty)
{
    <EmptyState Message="@EmptyMessage" />
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsDenied { get; set; }
    [Parameter] public bool IsConflict { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public bool IsEmpty { get; set; }

    [Parameter] public string? LoadingMessage { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public string? ErrorTitle { get; set; }
    [Parameter] public string? ErrorDetail { get; set; }
    [Parameter] public string? ErrorCorrelationId { get; set; }
    [Parameter] public bool ErrorUnavailable { get; set; }
    [Parameter] public string? DeniedPermission { get; set; }
    [Parameter] public string? DeniedMessage { get; set; }
    [Parameter] public string? ConflictTitle { get; set; }
    [Parameter] public string? ConflictMessage { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@inject IStringLocalizer<AdminResources> L

<div class="form-actions actions" role="group" aria-label="@L["Form_ActionsAria"]">
    @if (Secondary is not null)
    {
        @Secondary
    }
    else if (!string.IsNullOrWhiteSpace(SecondaryText))
    {
        <button type="button" class="secondary" @onclick="OnSecondary" disabled="@(Busy || Disabled)">@SecondaryText</button>
    }

    <button type="button"
            class="@(DestructivePrimary ? "danger" : null)"
            @onclick="OnPrimary"
            disabled="@(Busy || Disabled)">
        @(Busy ? (BusyText ?? L["Common_Saving"]) : (PrimaryText ?? L["Common_Save"]))
    </button>
</div>

@code {
    [Parameter] public string? PrimaryText { get; set; }
    [Parameter] public string? SecondaryText { get; set; }
    [Parameter] public string? BusyText { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool DestructivePrimary { get; set; }
    [Parameter] public EventCallback OnPrimary { get; set; }
    [Parameter] public EventCallback OnSecondary { get; set; }
    [Parameter] public RenderFragment? Secondary { get; set; }
}

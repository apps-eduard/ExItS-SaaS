@inject IStringLocalizer<AdminResources> L

<section class="state error" role="alert">
    <h2>@(Unavailable ? L["State_Unavailable"] : Title)</h2>
    @if (!string.IsNullOrWhiteSpace(Detail))
    {
        <p>@Detail</p>
    }
    @if (!string.IsNullOrWhiteSpace(CorrelationId))
    {
        <p class="muted">@L["State_CorrelationId"]: <code>@CorrelationId</code></p>
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string? CorrelationId { get; set; }
    [Parameter] public bool Unavailable { get; set; }

    protected override void OnParametersSet() => Title ??= L["State_Error"];
}

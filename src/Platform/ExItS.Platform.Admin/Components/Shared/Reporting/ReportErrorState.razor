<ErrorState Title="@Title" Detail="@Detail" CorrelationId="@CorrelationId" Unavailable="Unavailable" />

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string? CorrelationId { get; set; }
    [Parameter] public bool Unavailable { get; set; }
}

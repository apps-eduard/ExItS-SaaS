@inject IStringLocalizer<AdminResources> L

<div class="report-date-range form-grid">
    <FormField Label="@(FromLabel ?? L["Report_FromDate"])" FieldId="@_fromId" Error="@FromError" Help="@Help">
        <AdminInput Value="@FromText" ValueChanged="OnFromChanged" Type="date" Disabled="Disabled" />
    </FormField>
    <FormField Label="@(ToLabel ?? L["Report_ToDate"])" FieldId="@_toId" Error="@ToError">
        <AdminInput Value="@ToText" ValueChanged="OnToChanged" Type="date" Disabled="Disabled" />
    </FormField>
</div>

@code {
    [Parameter] public DateOnly? FromDate { get; set; }
    [Parameter] public EventCallback<DateOnly?> FromDateChanged { get; set; }
    [Parameter] public DateOnly? ToDate { get; set; }
    [Parameter] public EventCallback<DateOnly?> ToDateChanged { get; set; }
    [Parameter] public string? FromLabel { get; set; }
    [Parameter] public string? ToLabel { get; set; }
    [Parameter] public string? FromError { get; set; }
    [Parameter] public string? ToError { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private readonly string _fromId = $"rpt-from-{Guid.NewGuid():N}";
    private readonly string _toId = $"rpt-to-{Guid.NewGuid():N}";

    private string? FromText => FromDate?.ToString("yyyy-MM-dd");
    private string? ToText => ToDate?.ToString("yyyy-MM-dd");

    private async Task OnFromChanged(string? raw)
    {
        DateOnly? parsed = DateOnly.TryParse(raw, out var d) ? d : null;
        FromDate = parsed;
        await FromDateChanged.InvokeAsync(parsed);
    }

    private async Task OnToChanged(string? raw)
    {
        DateOnly? parsed = DateOnly.TryParse(raw, out var d) ? d : null;
        ToDate = parsed;
        await ToDateChanged.InvokeAsync(parsed);
    }
}

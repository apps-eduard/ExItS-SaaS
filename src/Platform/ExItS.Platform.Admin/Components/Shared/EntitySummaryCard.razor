<article class="entity-summary-card @(Clickable ? "is-clickable" : null)">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <h3 class="entity-summary-title">@Title</h3>
    }
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <p class="entity-summary-subtitle muted">@Subtitle</p>
    }
    @if (Status is not null)
    {
        <div class="entity-summary-status"><StatusBadge Value="@Status" /></div>
    }
    @ChildContent
</article>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@namespace ExItS.Platform.Admin.Components.Shared
@using ExItS.DesignSystem.Components.Data
@inject IStringLocalizer<AdminResources> L

<SearchBar Value="@Value"
           ValueChanged="OnValueChanged"
           Placeholder="@(Placeholder ?? L["Common_Search"])"
           AriaLabel="@(Label ?? Placeholder ?? L["Common_Search"])"
           Disabled="@Disabled" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task OnValueChanged(string? value)
    {
        var text = value ?? string.Empty;
        Value = text;
        await ValueChanged.InvokeAsync(text);
    }
}

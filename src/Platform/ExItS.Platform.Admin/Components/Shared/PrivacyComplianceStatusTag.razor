@inject IStringLocalizer<AdminResources> L

<Tag Color="@Color">@DisplayValue</Tag>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    private string DisplayValue => Value switch
    {
        "NotStarted" => L["PrivacyCompliance_Status_NotStarted"],
        "InProgress" => L["PrivacyCompliance_Status_InProgress"],
        "ReadyForReview" => L["PrivacyCompliance_Status_ReadyForReview"],
        "Approved" => L["PrivacyCompliance_Status_VerifiedInternally"],
        "NeedsUpdate" => L["PrivacyCompliance_Status_NeedsUpdate"],
        "NotApplicable" => L["PrivacyCompliance_Status_NotApplicable"],
        "ActionNeeded" => L["PrivacyCompliance_Status_ActionNeeded"],
        "VerifiedInternally" => L["PrivacyCompliance_Status_VerifiedInternally"],
        "ExternalLegalReviewRequired" => L["PrivacyCompliance_Status_ExternalLegalReview"],
        "NotAssessed" => L["PrivacyCompliance_Status_NotAssessed"],
        "Required" => L["PrivacyCompliance_Level_Required"],
        "Conditional" => L["PrivacyCompliance_Level_Conditional"],
        "Optional" => L["PrivacyCompliance_Level_Optional"],
        _ => Value
    };

    private string Color => Value switch
    {
        "Approved" or "VerifiedInternally" or "ReadyForReview" => "processing",
        "InProgress" => "processing",
        "NeedsUpdate" or "ActionNeeded" or "ExternalLegalReviewRequired" => "warning",
        "NotStarted" or "NotAssessed" or "NotApplicable" => "default",
        "Required" => "error",
        "Conditional" => "gold",
        "Optional" => "default",
        _ => "default"
    };
}

@inject IStringLocalizer<AdminResources> L

<div class="access-state @(Allowed ? "allowed" : "denied")" role="status">
    <strong>@(Allowed ? L["Access_Allowed"] : L["Access_Denied"])</strong>
    <span>@L["Access_Reason"] @ReasonCode</span>
</div>

@code {
    [Parameter] public bool Allowed { get; set; }
    [Parameter] public string ReasonCode { get; set; } = "";
}

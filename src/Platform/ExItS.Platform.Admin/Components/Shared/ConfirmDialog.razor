@using ExItS.Platform.Admin.Forms
@inject IStringLocalizer<AdminResources> L
@inject IJSRuntime Js

@if (Visible)
{
    <div class="dialog-backdrop"
         role="presentation"
         @onclick="OnBackdropClickAsync">
        <div class="dialog dialog--@KindCss"
             role="@(Kind is AdminDialogKind.Destructive or AdminDialogKind.UnsavedChanges ? "alertdialog" : "dialog")"
             aria-modal="true"
             aria-labelledby="@_titleId"
             aria-describedby="@_bodyId"
             tabindex="-1"
             @ref="_dialogRef"
             @onclick:stopPropagation="true"
             @onkeydown="OnKeyDownAsync">
            <h2 id="@_titleId">@ResolvedTitle</h2>
            <p id="@_bodyId">@Message</p>
            <div class="actions">
                <button type="button"
                        class="secondary"
                        @ref="_cancelRef"
                        @onclick="CancelAsync"
                        disabled="@Busy">
                    @ResolvedCancel
                </button>
                <button type="button"
                        class="@ConfirmCss"
                        @ref="_confirmRef"
                        @onclick="ConfirmAsync"
                        disabled="@Busy">
                    @(Busy ? L["Common_Saving"] : ResolvedConfirm)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public AdminDialogKind Kind { get; set; } = AdminDialogKind.Destructive;
    [Parameter] public string? ConfirmText { get; set; }
    [Parameter] public string? CancelText { get; set; }
    /// <summary>Prefer EventCallback so the owning page re-renders after confirm/cancel.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    private ElementReference _confirmRef;
    private ElementReference _cancelRef;
    private ElementReference _dialogRef;
    private readonly string _titleId = $"dlg-title-{Guid.NewGuid():N}";
    private readonly string _bodyId = $"dlg-body-{Guid.NewGuid():N}";
    private bool _wasVisible;
    private bool _trapActive;

    private string KindCss => Kind switch
    {
        AdminDialogKind.Conflict => "conflict",
        AdminDialogKind.UnsavedChanges => "unsaved",
        AdminDialogKind.Confirm => "confirm",
        _ => "destructive"
    };

    private string ConfirmCss => Kind switch
    {
        AdminDialogKind.Destructive => "danger",
        AdminDialogKind.UnsavedChanges => "danger",
        _ => ""
    };

    private string ResolvedTitle => Title ?? Kind switch
    {
        AdminDialogKind.Conflict => L["Dialog_ConflictTitle"],
        AdminDialogKind.UnsavedChanges => L["Dialog_UnsavedTitle"],
        _ => L["Common_Confirm"]
    };

    private string ResolvedConfirm => ConfirmText ?? Kind switch
    {
        AdminDialogKind.UnsavedChanges => L["Dialog_Discard"],
        AdminDialogKind.Conflict => L["Common_Close"],
        _ => L["Common_Confirm"]
    };

    private string ResolvedCancel => CancelText ?? Kind switch
    {
        AdminDialogKind.UnsavedChanges => L["Dialog_KeepEditing"],
        _ => L["Common_Cancel"]
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_wasVisible)
        {
            try
            {
                await Js.InvokeVoidAsync("exitsAdminA11y.dialogOpen", _dialogRef);
                _trapActive = true;
            }
            catch
            {
                _trapActive = false;
            }

            try
            {
                await _confirmRef.FocusAsync();
            }
            catch
            {
                try
                {
                    await _dialogRef.FocusAsync();
                }
                catch
                {
                    // Focus may fail during circuit transitions.
                }
            }
        }
        else if (!Visible && _wasVisible && _trapActive)
        {
            await CloseTrapAsync();
        }

        _wasVisible = Visible;
    }

    private async Task ConfirmAsync()
    {
        if (Busy || !OnConfirm.HasDelegate)
        {
            return;
        }

        await CloseTrapAsync();
        await OnConfirm.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        if (Busy || !OnCancel.HasDelegate)
        {
            return;
        }

        await CloseTrapAsync();
        await OnCancel.InvokeAsync();
    }

    private async Task OnBackdropClickAsync()
    {
        if (CloseOnBackdrop && !Busy)
        {
            await CancelAsync();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !Busy)
        {
            await CancelAsync();
        }
    }

    private async Task CloseTrapAsync()
    {
        if (!_trapActive)
        {
            return;
        }

        _trapActive = false;
        try
        {
            await Js.InvokeVoidAsync("exitsAdminA11y.dialogClose");
        }
        catch
        {
            // Ignore when JS not yet available.
        }
    }
}

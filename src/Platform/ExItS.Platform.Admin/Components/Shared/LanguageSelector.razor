@inject CultureService Culture
@inject IStringLocalizer<AdminResources> L
@using AntDesign

<Select TItem="string"
        TItemValue="string"
        Value="@_current"
        ValueChanged="OnChangedAsync"
        Disabled="@(!_ready)"
        Size="@InputSize.Small"
        Style="width: 7.5rem;"
        Placeholder="@L["Language_Label"]"
        AllowClear="false">
    <SelectOptions>
        @foreach (var option in CultureService.Options)
        {
            <SelectOption TItem="string" TItemValue="string" Value="@option.Code" Label="@option.NativeLabel" />
        }
    </SelectOptions>
</Select>

@code {
    private string _current = CultureService.English;
    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready)
        {
            return;
        }

        _current = await Culture.GetCurrentAsync();
        _ready = true;
        StateHasChanged();
    }

    private async Task OnChangedAsync(string value)
    {
        // Ant Design Select often raises ValueChanged when it becomes enabled after first render.
        // CultureService.SetCultureAsync force-loads the page — that must not run on init.
        if (!_ready)
        {
            return;
        }

        var next = value ?? CultureService.English;
        if (string.Equals(next, _current, StringComparison.Ordinal))
        {
            return;
        }

        _current = next;
        await Culture.SetCultureAsync(_current);
    }
}

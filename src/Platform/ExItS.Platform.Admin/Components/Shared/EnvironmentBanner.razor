@inject IStringLocalizer<AdminResources> L

<div class="env-banner-wrap">
    <button type="button" class="env-chip" @onclick="Toggle" aria-expanded="@_expanded" aria-controls="env-banner-detail" title="@L["Banner_DevSecurityDetail"]">
        <span class="dot" aria-hidden="true"></span>
        <span>@L["Banner_DevSecurityCompact"]</span>
    </button>
    @if (_expanded)
    {
        <div id="env-banner-detail" class="env-banner-detail" role="note">
            <p>@L["Banner_DevSecurityDetail"]</p>
            @if (!string.IsNullOrWhiteSpace(ActorDisplayName))
            {
                <p class="muted">@string.Format(L["Footer_ActorContext"], ActorDisplayName)</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? ActorDisplayName { get; set; }
    private bool _expanded;
    private void Toggle() => _expanded = !_expanded;
}

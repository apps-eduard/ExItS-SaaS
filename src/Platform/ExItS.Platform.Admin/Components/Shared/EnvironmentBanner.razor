@inject IStringLocalizer<AdminResources> L
@using AntDesign

@if (_show)
{
    <Alert Type="@AlertType.Warning"
           Message="@L["Banner_DevSecurityCompact"]"
           Description="@Description"
           Closable="true"
           OnClose="() => _show = false"
           ShowIcon="true"
           Class="exits-env-alert"
           Style="margin:0; max-width: 18rem;" />
}

@code {
    [Parameter] public string? ActorDisplayName { get; set; }
    private bool _show = true;

    private string Description =>
        string.IsNullOrWhiteSpace(ActorDisplayName)
            ? L["Banner_DevSecurityDetail"]
            : $"{L["Banner_DevSecurityDetail"]} {string.Format(L["Footer_ActorContext"], ActorDisplayName)}";
}

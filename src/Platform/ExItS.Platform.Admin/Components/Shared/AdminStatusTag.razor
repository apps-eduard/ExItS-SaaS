@* Standards alias for StatusBadge (§13). *@
@if (UseAntTag)
{
    <Tag Color="@AntColor">@DisplayValue</Tag>
}
else
{
    <StatusBadge Value="@Value" />
}

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    /// <summary>When true, render Ant Design Tag colors from the shared status map.</summary>
    [Parameter] public bool UseAntTag { get; set; } = true;

    [Inject] private IStringLocalizer<AdminResources> L { get; set; } = default!;

    private string DisplayValue => Value switch
    {
        "Active" => L["Status_Active"],
        "Suspended" => L["Status_Suspended"],
        "Deactivated" => L["Status_Deactivated"],
        "Removed" => L["Status_Removed"],
        "Revoked" => L["Status_Revoked"],
        "PendingConfirmation" => L["Status_PendingConfirmation"],
        "PendingVerification" => L["Status_PendingVerification"],
        "Confirmed" => L["Status_Confirmed"],
        "Rejected" => L["Status_Rejected"],
        "Voided" => L["Status_Voided"],
        "Trialing" => L["Status_Trialing"],
        "GracePeriod" => L["Status_GracePeriod"],
        "PastDue" => L["Status_PastDue"],
        "Cancelled" => L["Status_Cancelled"],
        "Expired" => L["Status_Expired"],
        "Succeeded" => L["Status_Succeeded"],
        "Denied" => L["Status_Denied"],
        "Failed" => L["Status_Failed"],
        "Inactive" => L["Status_Inactive"],
        "Retired" => L["Status_Retired"],
        "Archived" => L["Status_Archived"],
        "Draft" => L["Status_Draft"],
        "Published" => L["Status_Published"],
        "Pending" => L["Status_Pending"],
        _ => Value
    };

    private string AntColor => Value switch
    {
        "Active" or "Confirmed" or "Succeeded" or "Published" => "success",
        "Trialing" or "Pending" or "PendingConfirmation" or "PendingVerification" => "processing",
        "GracePeriod" => "gold",
        "PastDue" => "orange",
        "Suspended" or "Rejected" or "Denied" or "Failed" => "error",
        "Cancelled" or "Expired" or "Voided" or "Removed" or "Deactivated" or "Revoked" or "Inactive" or "Retired" or "Archived" => "default",
        "Draft" => "default",
        _ => "default"
    };
}

<!DOCTYPE html>
<html lang="@CultureName">

@using AntDesign

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <ResourcePreloader />
    @* Root-absolute assets: relative URLs from /admin/* hit FallbackPolicy. AntDesign + branding. *@
    <script src="@RootAsset("theme-boot.js")"></script>
    <script src="@RootAsset("admin-a11y.js")"></script>
    <link href="/_content/AntDesign/css/ant-design-blazor.css" rel="stylesheet" />
    <link rel="stylesheet" href="@RootAsset("app.css")" />
    <link rel="stylesheet" href="@RootAsset("ExItS.Platform.Admin.styles.css")" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <AntContainer />
    <ReconnectModal />
    <script src="/_content/AntDesign/js/ant-design-blazor.js"></script>
    <script src="@RootAsset("_framework/blazor.web.js")"></script>
</body>

</html>

@code {
    private string CultureName => System.Globalization.CultureInfo.CurrentUICulture.Name switch
    {
        "fil-PH" => "fil-PH",
        _ => "en"
    };

    private string RootAsset(string key)
    {
        var path = Assets[key].ToString();
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        return path.StartsWith('/') ? path : "/" + path;
    }
}

<!DOCTYPE html>
<html lang="@CultureName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <ResourcePreloader />
    @* Root-absolute asset URLs: relative hrefs from /admin/* resolve under /admin/ and hit FallbackPolicy (302 → login). *@
    <script src="@RootAsset("theme-boot.js")"></script>
    <script src="@RootAsset("admin-a11y.js")"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@RootAsset("app.css")" />
    <link rel="stylesheet" href="@RootAsset("ExItS.Platform.Admin.styles.css")" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@RootAsset("_framework/blazor.web.js")"></script>
</body>

</html>

@code {
    private string CultureName => System.Globalization.CultureInfo.CurrentUICulture.Name switch
    {
        "fil-PH" => "fil-PH",
        _ => "en"
    };

    private string RootAsset(string key)
    {
        var path = Assets[key].ToString();
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        return path.StartsWith('/') ? path : "/" + path;
    }
}

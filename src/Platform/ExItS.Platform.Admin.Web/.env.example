# Platform API origin used by the typed HTTP client.
# Browser session cookies stay HttpOnly; do not put tokens in localStorage or sessionStorage.
VITE_PLATFORM_API_BASE_URL=http://localhost:8091

# Local Validation only: set to true to allow 1-character passwords in activate/reset UI
# (must match PlatformAuthentication__Password__MinimumLength=1 on Platform API).
# VITE_LOCAL_VALIDATION_TOOLS=true

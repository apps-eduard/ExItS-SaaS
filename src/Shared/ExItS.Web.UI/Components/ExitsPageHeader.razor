@using AntDesign

<PageHeader Class="exits-page-header" Title="@Title" SubTitle="@Subtitle">
    <PageHeaderExtra>
        @ChildContent
    </PageHeaderExtra>
</PageHeader>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@namespace ExItS.DesignSystem.Components.Overlay
@using ExItS.DesignSystem.Components.Primitives
@inject IStringLocalizer<DesignSystemResources> L

<div class="exds-loading-overlay-wrap">
    @ChildContent
    @if (Visible)
    {
        <div class="exds-loading-overlay" role="status" aria-live="polite">
            <Spinner Size="SpinnerSize.Lg" Label="@(Label ?? L["Loading_Label"])" />
            <span class="exds-loading-overlay__label" aria-hidden="true">@(Label ?? L["Loading_Label"])</span>
        </div>
    }
</div>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

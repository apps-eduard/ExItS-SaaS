@namespace ExItS.DesignSystem.Components.Overlay
@using ExItS.DesignSystem.Components.Forms
@using ExItS.DesignSystem.Components.Primitives
@inject IStringLocalizer<DesignSystemResources> L

@if (Visible)
{
    <div class="exds-dialog__backdrop" @onclick="CancelAsync">
        <div class="exds-dialog exds-confirm"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             aria-describedby="@_messageId"
             tabindex="-1"
             @ref="_dialogRef"
             @onclick:stopPropagation="true"
             @onkeydown="HandleKeyDown">
            <div class="exds-dialog__header">
                <h2 class="exds-dialog__title" id="@_titleId">@Title</h2>
                <IconButton AriaLabel="@CancelLabelResolved" IconName="close" Disabled="@IsLoading" OnClick="CancelAsync" />
            </div>
            <div class="exds-dialog__body">
                <p class="exds-confirm__message" id="@_messageId">@Message</p>
                @if (ShowReason)
                {
                    <TextArea Label="@ReasonLabelResolved" Value="@Reason" ValueChanged="OnReasonChanged" Rows="3" Disabled="@IsLoading" />
                }
                @if (ShowPassword)
                {
                    <TextInput Label="@PasswordLabelResolved"
                               Type="password"
                               AdditionalAttributes="@_passwordAutocomplete"
                               Value="@Password"
                               ValueChanged="OnPasswordChanged"
                               Disabled="@IsLoading"
                               Required="true" />
                }
            </div>
            <div class="exds-dialog__footer">
                <Button Variant="ButtonVariant.Ghost" Disabled="@IsLoading" OnClick="CancelAsync">@CancelLabelResolved</Button>
                <Button Variant="@(Danger ? ButtonVariant.Danger : ButtonVariant.Primary)" IsLoading="@IsLoading" OnClick="ConfirmAsync">@ConfirmLabelResolved</Button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool ShowReason { get; set; }
    [Parameter] public bool ShowPassword { get; set; }
    [Parameter] public bool RequireReason { get; set; }
    [Parameter] public bool RequirePassword { get; set; }
    [Parameter] public string? Reason { get; set; }
    [Parameter] public EventCallback<string?> ReasonChanged { get; set; }
    [Parameter] public string? Password { get; set; }
    [Parameter] public EventCallback<string?> PasswordChanged { get; set; }
    [Parameter] public string? ReasonLabel { get; set; }
    [Parameter] public string? PasswordLabel { get; set; }
    [Parameter] public string? ConfirmLabel { get; set; }
    [Parameter] public string? CancelLabel { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly string _titleId = "exds-confirm-title-" + Guid.NewGuid().ToString("N");
    private readonly string _messageId = "exds-confirm-msg-" + Guid.NewGuid().ToString("N");
    private readonly Dictionary<string, object> _passwordAutocomplete = new() { ["autocomplete"] = "current-password" };
    private ElementReference _dialogRef;
    private bool _wasVisible;

    private string ConfirmLabelResolved => ConfirmLabel ?? L["Action_Confirm"];
    private string CancelLabelResolved => CancelLabel ?? L["Action_Cancel"];
    private string ReasonLabelResolved => ReasonLabel ?? L["Confirm_ReasonLabel"];
    private string PasswordLabelResolved => PasswordLabel ?? L["Confirm_PasswordLabel"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_wasVisible)
        {
            try
            {
                await _dialogRef.FocusAsync();
            }
            catch
            {
                // Focus is best-effort in hybrid hosts.
            }
        }

        _wasVisible = Visible;
    }

    private async Task OnReasonChanged(string? value)
    {
        Reason = value;
        if (ReasonChanged.HasDelegate) await ReasonChanged.InvokeAsync(value);
    }

    private async Task OnPasswordChanged(string? value)
    {
        Password = value;
        if (PasswordChanged.HasDelegate) await PasswordChanged.InvokeAsync(value);
    }

    private async Task ConfirmAsync()
    {
        if (RequireReason && string.IsNullOrWhiteSpace(Reason))
        {
            return;
        }

        if (RequirePassword && string.IsNullOrWhiteSpace(Password))
        {
            return;
        }

        if (OnConfirm.HasDelegate) await OnConfirm.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        if (IsLoading) return;
        Visible = false;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        if (OnCancel.HasDelegate) await OnCancel.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CancelAsync();
    }
}

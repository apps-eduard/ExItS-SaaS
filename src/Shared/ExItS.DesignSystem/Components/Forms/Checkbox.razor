@namespace ExItS.DesignSystem.Components.Forms

<label class="exds-checkbox @(Disabled ? "exds-checkbox--disabled" : null)">
    <input type="checkbox"
           id="@_id"
           checked="@Value"
           disabled="@Disabled"
           aria-invalid="@(IsInvalid ? "true" : "false")"
           @onchange="HandleChange" />
    <span class="exds-checkbox__box" aria-hidden="true"></span>
    <span class="exds-checkbox__label">@ChildContent</span>
</label>
@if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
{
    <span class="exds-field__error" role="alert">@ErrorText</span>
}

@code {
    private readonly string _id = $"exds-cb-{Guid.NewGuid():N}";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsInvalid { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleChange(ChangeEventArgs args)
    {
        // Parent owns the model. Do not mutate [Parameter] Value here — that desyncs
        // checked UI from the bound boolean on MAUI WebView after re-renders.
        var next = ParseChecked(args.Value);
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(next);
        }
    }

    internal static bool ParseChecked(object? raw) => raw switch
    {
        bool b => b,
        string s when bool.TryParse(s, out var parsed) => parsed,
        // HTML checkbox change events often report the default value "on" when checked.
        string s when string.Equals(s, "on", StringComparison.OrdinalIgnoreCase) => true,
        null => false,
        _ => false
    };
}

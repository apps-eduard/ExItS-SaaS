@namespace ExItS.DesignSystem.Components.Primitives
@using ExItS.DesignSystem.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DesignSystemResources> L

<div class="exds-field @(IsInvalid ? "exds-field--invalid" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <Label For="@_id" Required="@Required">@Label</Label>
    }

    @if (Options is not null)
    {
        <button id="@_id"
                type="button"
                class="exds-field__control exds-select-trigger"
                disabled="@Disabled"
                aria-haspopup="listbox"
                aria-expanded="@_open"
                aria-invalid="@(IsInvalid ? "true" : "false")"
                @onclick="OpenPicker"
                @attributes="AdditionalAttributes">
            <span class="exds-select-trigger__value">@DisplayText</span>
            <span class="exds-select-trigger__icon" aria-hidden="true">▾</span>
        </button>
    }
    else
    {
        <select id="@_id"
                class="exds-field__control"
                disabled="@Disabled"
                value="@Value"
                aria-invalid="@(IsInvalid ? "true" : "false")"
                @onchange="HandleNativeChange"
                @attributes="AdditionalAttributes">
            @ChildContent
        </select>
    }

    @if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
    {
        <span class="exds-field__error" role="alert">@ErrorText</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="exds-field__hint">@Hint</span>
    }
</div>

@if (_open && Options is not null)
{
    <div class="exds-select-picker__backdrop" @onclick="ClosePicker">
        <div class="exds-select-picker"
             role="dialog"
             aria-modal="true"
             aria-label="@(Label ?? L["Select_PickerTitle"].Value)"
             @onclick:stopPropagation="true"
             @onkeydown="OnPickerKeyDown">
            <div class="exds-select-picker__header">
                <div class="exds-select-picker__title">@(Label ?? L["Select_PickerTitle"].Value)</div>
                <button type="button"
                        class="exds-select-picker__close"
                        aria-label="@L["Action_Close"]"
                        @onclick="ClosePicker">×</button>
            </div>
            <div class="exds-select-picker__list" role="listbox" aria-labelledby="@_id">
                @if (Options.Count == 0)
                {
                    <div class="exds-select-picker__empty">@L["Select_Empty"]</div>
                }
                else
                {
                    @foreach (var option in Options)
                    {
                        var selected = string.Equals(Value, option.Value, StringComparison.Ordinal);
                        <button type="button"
                                class="@($"exds-select-option{(selected ? " exds-select-option--selected" : string.Empty)}")"
                                role="option"
                                aria-selected="@selected"
                                @onclick="() => ChooseAsync(option.Value)"
                                @onclick:stopPropagation="true">
                            <span class="exds-select-option__label">@option.Text</span>
                            <span class="exds-select-option__indicator exds-select-option__indicator--radio" aria-hidden="true"></span>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private readonly string _id = $"exds-select-{Guid.NewGuid():N}";
    private bool _open;

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<SelectOption>? Options { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsInvalid { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string DisplayText
    {
        get
        {
            if (Options is null)
            {
                return L["Select_Placeholder"];
            }

            var match = Options.FirstOrDefault(o => string.Equals(o.Value, Value, StringComparison.Ordinal));
            if (match is not null)
            {
                return match.Text;
            }

            return string.IsNullOrEmpty(Value) ? L["Select_Placeholder"] : Value;
        }
    }

    private void OpenPicker()
    {
        if (Disabled || Options is null)
        {
            return;
        }

        _open = true;
    }

    private void ClosePicker() => _open = false;

    private async Task ChooseAsync(string value)
    {
        // Invoke before closing: on MAUI/WebView, closing the overlay first can let the
        // originating tap fall through / cancel so the first pick appears to do nothing.
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(value);
        }

        _open = false;
    }

    private async Task HandleNativeChange(ChangeEventArgs args)
    {
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(args.Value?.ToString());
        }
    }

    private void OnPickerKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
        {
            ClosePicker();
        }
    }
}

@namespace ExItS.DesignSystem.Components.Primitives

<span class="exds-avatar @SizeClass" aria-hidden="@(string.IsNullOrEmpty(AriaLabel) ? "true" : null)" aria-label="@AriaLabel">
    @if (ShowImage)
    {
        <img src="@ImageUrl" alt="" @onerror="OnImageError" />
    }
    else
    {
        @Initials
    }
</span>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Md;

    private bool _imageFailed;
    private string? _trackedImageUrl;

    private bool ShowImage =>
        !_imageFailed && !string.IsNullOrWhiteSpace(ImageUrl);

    private string SizeClass => Size switch
    {
        AvatarSize.Sm => "exds-avatar--sm",
        AvatarSize.Lg => "exds-avatar--lg",
        _ => "",
    };

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Name))
            {
                return "?";
            }

            var parts = Name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
                _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
            };
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_trackedImageUrl, ImageUrl, StringComparison.Ordinal))
        {
            _trackedImageUrl = ImageUrl;
            _imageFailed = false;
        }
    }

    private void OnImageError() => _imageFailed = true;
}

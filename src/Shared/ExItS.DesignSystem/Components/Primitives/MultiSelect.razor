@namespace ExItS.DesignSystem.Components.Primitives
@using ExItS.DesignSystem.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DesignSystemResources> L

<div class="exds-field @(IsInvalid ? "exds-field--invalid" : null)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <Label For="@_id" Required="@Required">@Label</Label>
    }
    <button id="@_id"
            type="button"
            class="exds-field__control exds-select-trigger"
            disabled="@Disabled"
            aria-haspopup="listbox"
            aria-expanded="@_open"
            aria-invalid="@(IsInvalid ? "true" : "false")"
            @onclick="OpenPicker"
            @attributes="AdditionalAttributes">
        <span class="exds-select-trigger__value">@DisplayText</span>
        <span class="exds-select-trigger__icon" aria-hidden="true">▾</span>
    </button>
    @if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
    {
        <span class="exds-field__error" role="alert">@ErrorText</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="exds-field__hint">@Hint</span>
    }
</div>

@if (_open)
{
    <div class="exds-select-picker__backdrop" @onclick="ClosePicker">
        <div class="exds-select-picker"
             role="dialog"
             aria-modal="true"
             aria-label="@(Label ?? L["MultiSelect_PickerTitle"].Value)"
             @onclick:stopPropagation="true"
             @onkeydown="OnPickerKeyDown">
            <div class="exds-select-picker__header">
                <div class="exds-select-picker__title">@(Label ?? L["MultiSelect_PickerTitle"].Value)</div>
                <button type="button"
                        class="exds-select-picker__close"
                        aria-label="@L["Action_Close"]"
                        @onclick="ClosePicker">×</button>
            </div>
            <div class="exds-select-picker__list" role="listbox" aria-multiselectable="true" aria-labelledby="@_id">
                @if (Options is null || Options.Count == 0)
                {
                    <div class="exds-select-picker__empty">@L["Select_Empty"]</div>
                }
                else
                {
                    @foreach (var option in Options)
                    {
                        var selected = IsSelected(option.Value);
                        <button type="button"
                                class="@($"exds-select-option{(selected ? " exds-select-option--selected" : string.Empty)}")"
                                role="option"
                                aria-selected="@selected"
                                @onclick="() => ToggleAsync(option.Value)">
                            <span class="exds-select-option__indicator exds-select-option__indicator--check" aria-hidden="true"></span>
                            <span class="exds-select-option__label">@option.Text</span>
                        </button>
                    }
                }
            </div>
            <div class="exds-select-picker__actions" role="group">
                <button type="button" class="exds-btn exds-btn--primary exds-btn--md" @onclick="ClosePicker">@L["Action_Done"]</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly string _id = $"exds-multiselect-{Guid.NewGuid():N}";
    private bool _open;

    [Parameter] public string? Label { get; set; }
    [Parameter] public IReadOnlyList<string>? Values { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }
    [Parameter] public IReadOnlyList<SelectOption>? Options { get; set; }
    [Parameter] public bool IsInvalid { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string DisplayText
    {
        get
        {
            var selected = Values ?? Array.Empty<string>();
            if (selected.Count == 0)
            {
                return L["MultiSelect_Placeholder"];
            }

            if (Options is null || Options.Count == 0)
            {
                return L["MultiSelect_SelectedCount", selected.Count];
            }

            var labels = Options
                .Where(o => selected.Contains(o.Value, StringComparer.Ordinal))
                .Select(o => o.Text)
                .ToList();

            if (labels.Count == 0)
            {
                return L["MultiSelect_SelectedCount", selected.Count];
            }

            if (labels.Count <= 2)
            {
                return string.Join(", ", labels);
            }

            return L["MultiSelect_SelectedCount", labels.Count];
        }
    }

    private bool IsSelected(string value) =>
        Values is not null && Values.Contains(value, StringComparer.Ordinal);

    private void OpenPicker()
    {
        if (Disabled)
        {
            return;
        }

        _open = true;
    }

    private void ClosePicker() => _open = false;

    private async Task ToggleAsync(string value)
    {
        var next = Values?.ToList() ?? [];
        if (next.Contains(value, StringComparer.Ordinal))
        {
            next.RemoveAll(v => string.Equals(v, value, StringComparison.Ordinal));
        }
        else
        {
            next.Add(value);
        }

        if (ValuesChanged.HasDelegate)
        {
            await ValuesChanged.InvokeAsync(next);
        }
    }

    private void OnPickerKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
        {
            ClosePicker();
        }
    }
}

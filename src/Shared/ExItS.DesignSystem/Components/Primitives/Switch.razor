@namespace ExItS.DesignSystem.Components.Primitives

<label class="exds-switch">
    <input type="checkbox"
           checked="@Checked"
           disabled="@Disabled"
           role="switch"
           aria-checked="@(Checked ? "true" : "false")"
           @onchange="HandleChange" />
    <span class="exds-switch__track"><span class="exds-switch__thumb"></span></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="exds-switch__label">@Label</span>
    }
</label>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task HandleChange(ChangeEventArgs args)
    {
        Checked = args.Value is bool b && b;
        if (CheckedChanged.HasDelegate)
        {
            await CheckedChanged.InvokeAsync(Checked);
        }
    }
}

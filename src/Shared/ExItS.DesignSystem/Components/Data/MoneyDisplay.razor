@namespace ExItS.DesignSystem.Components.Data
@using System.Globalization
@inject IStringLocalizer<DesignSystemResources> L

<span class="@CssClass"
      title="@Title"
      aria-label="@AccessibleLabel">
    @DisplayText
</span>

@code {
    [Parameter] public decimal? Amount { get; set; }
    [Parameter] public string CurrencyCode { get; set; } = "PHP";
    [Parameter] public bool Unavailable { get; set; }
    /// <summary>When true, uses display-total typography (cashier totals).</summary>
    [Parameter] public bool Emphasized { get; set; }

    private string CssClass
    {
        get
        {
            var size = Emphasized ? " exds-money--display" : string.Empty;
            if (Unavailable || Amount is null) return "exds-money exds-money--unavailable" + size;
            if (Amount < 0) return "exds-money exds-money--negative" + size;
            if (Amount == 0) return "exds-money exds-money--zero" + size;
            return "exds-money" + size;
        }
    }

    private string DisplayText
    {
        get
        {
            if (Unavailable || Amount is null) return L["Money_Unavailable"];
            var amount = Amount.Value.ToString("N2", CultureInfo.CurrentUICulture);
            return $"{CurrencyCode} {amount}";
        }
    }

    private string AccessibleLabel => DisplayText;

    private string? Title => Unavailable || Amount is null ? L["Money_Unavailable"].Value : null;
}

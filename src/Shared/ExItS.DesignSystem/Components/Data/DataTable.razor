@namespace ExItS.DesignSystem.Components.Data
@typeparam TItem

<ResponsiveDataList TItem="TItem"
                    Items="Items"
                    Columns="Columns"
                    CellTemplate="CellTemplate"
                    IsLoading="IsLoading"
                    LoadingLabel="LoadingLabel"
                    EmptyTitle="EmptyTitle"
                    EmptyMessage="EmptyMessage"
                    ErrorTitle="ErrorTitle"
                    ErrorMessage="ErrorMessage"
                    RetryLabel="RetryLabel"
                    OnRetry="OnRetry"
                    AriaLabel="AriaLabel"
                    AdditionalAttributes="AdditionalAttributes" />

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public IReadOnlyList<DataColumnDefinition>? Columns { get; set; }
    [Parameter] public RenderFragment<(TItem Item, DataColumnDefinition Column)>? CellTemplate { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? LoadingLabel { get; set; }
    [Parameter] public string? EmptyTitle { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public string? ErrorTitle { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? RetryLabel { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}

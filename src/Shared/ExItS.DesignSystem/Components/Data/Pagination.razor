@namespace ExItS.DesignSystem.Components.Data
@using ExItS.DesignSystem.Components.Internal
@inject IStringLocalizer<DesignSystemResources> L

<nav class="exds-pagination" aria-label="@(AriaLabel ?? L["Data_PaginationLabel"])">
    <button type="button"
            class="exds-pagination__btn"
            disabled="@(Disabled || Page <= 1)"
            aria-label="@L["Data_Previous"]"
            @onclick="() => GoAsync(Page - 1)">
        <span class="exds-pagination__icon" aria-hidden="true">@IconGlyphs.Get("back")</span>
    </button>
    <PaginationSummary Page="Page" PageSize="PageSize" TotalCount="TotalCount" />
    <button type="button"
            class="exds-pagination__btn"
            disabled="@(Disabled || Page >= TotalPages)"
            aria-label="@L["Data_Next"]"
            @onclick="() => GoAsync(Page + 1)">
        <span class="exds-pagination__icon exds-pagination__icon--next" aria-hidden="true">@IconGlyphs.Get("back")</span>
    </button>
</nav>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize)));

    private async Task GoAsync(int page)
    {
        page = Math.Clamp(page, 1, TotalPages);
        Page = page;
        if (PageChanged.HasDelegate) await PageChanged.InvokeAsync(page);
    }
}

@namespace ExItS.DesignSystem.Components.Layout

<header class="exds-page-header" @attributes="AdditionalAttributes">
    <div class="exds-page-header__row">
        <div>
            <h1 class="exds-page-header__title">@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="exds-page-header__subtitle">@Subtitle</p>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="exds-page-header__actions">@Actions</div>
        }
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}

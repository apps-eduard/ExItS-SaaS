# Browser/PWA uses same-origin `/platform-api` by default (Vite or future nginx reverse proxy).
# Leave VITE_PLATFORM_API_BASE_URL unset for local validation and the future production host.
# VITE_PLATFORM_API_BASE_URL=

# Vite dev/preview proxy target only. Not bundled into the browser. Loopback Platform API only.
# EXITS_PLATFORM_API_PROXY_TARGET=http://127.0.0.1:8091

VITE_POS_API_BASE_URL=http://127.0.0.1:8092
VITE_APP_VERSION=0.0.1-impl-03a

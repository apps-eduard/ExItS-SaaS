@page "/customers"
@page "/customers/{CustomerId:guid}"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosCustomerClient CustomerApi
@inject IPlatformAccessClient Platform
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Customers_Title"]</PageTitle>

@if (!Shell.CanSee("customers"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
        <ExitsPageHeader Title="@L["Customers_Title"]" Subtitle="@L["Customers_Subtitle"]" />
        <div class="org-toolbar">
            <SearchBar Value="@_search"
                       ValueChanged="OnSearchChanged"
                       Placeholder="@L["Common_Search"]"
                       AriaLabel="@L["Common_Search"]"
                       OnSearch="SearchAsync" />
            <Button OnClick="SearchAsync">@L["Common_Search"]</Button>
        </div>
        <OrgAlert Error="@_error" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]" OnDismissError="() => _error = null" />
        <OrgLoading Active="_loading" />

        @if (!_loading && string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
        {
            <OrgEmpty Title="@L["Customers_EmptyTitle"]" Message="@L["Customers_EmptyMessage"]" />
        }
        else if (!_loading && _items.Count > 0)
        {
        <div class="org-table-wrap">
        <table class="org-table">
            <thead>
                <tr><th>Name</th><th>Mobile</th><th>Status</th><th>Linked</th></tr>
            </thead>
            <tbody>
                @foreach (var c in _items)
                {
                    <tr>
                        <td><a href="@($"/customers/{c.CustomerId:D}")">@c.DisplayName</a></td>
                        <td>@c.MobileNumber</td>
                        <td><OrgStatusBadge Text="@c.Status" Tone="@c.Status" /></td>
                        <td><OrgStatusBadge Text="@(c.PlatformBusinessCustomerId is null ? "Unlinked" : "Platform customer")" Tone="@(c.PlatformBusinessCustomerId is null ? null : "success")" /></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <OrgPager Page="_page" PageSize="20" TotalCount="_total" PageChanged="ChangePageAsync" />
        }

        @if (!_loading && _detail is not null)
        {
        <Card Size="@CardSize.Small" Title="@_detail.DisplayName">
            <p class="org-note">Mobile: @_detail.MobileNumber · <OrgStatusBadge Text="@_detail.Status" Tone="@_detail.Status" /></p>
            @if (_credit is not null)
            {
                <p>Outstanding Utang: @OrgWebUi.Money(_credit.OutstandingAmount) (@_credit.ActiveEntryCount open entries)</p>
            }
            @if (_link is not null)
            {
                <p>Link status: <OrgStatusBadge Text="@_link.Status" Tone="@_link.Status" /></p>
            }
            else
            {
                <p class="org-note">No Personal identity link on file for this customer.</p>
            }
        </Card>
        }
    </div>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _search;
    private int _page = 1;
    private int _total;
    private List<PosCustomerListItemDto> _items = [];
    private PosCustomerDetailDto? _detail;
    private PosCustomerCreditSummaryDto? _credit;
    private PlatformCustomerLinkStatusDto? _link;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return Task.CompletedTask;
    }

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var list = await CustomerApi.ListAsync(_search, page: _page, pageSize: 20);
        if (!list.IsSuccess || list.Data is null)
        {
            _error = OrgWebUi.Error(list.Error);
            _loading = false;
            return;
        }

        _items = list.Data.Items;
        _total = list.Data.TotalCount;
        _error = null;
        if (CustomerId == Guid.Empty)
        {
            _detail = null;
            _loading = false;
            return;
        }

        var detail = await CustomerApi.GetAsync(CustomerId);
        _detail = detail.Data;
        var credit = await CustomerApi.GetCreditSummaryAsync(CustomerId);
        _credit = credit.Data;
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is not null && _detail?.PlatformBusinessCustomerId is Guid businessId)
        {
            var link = await Platform.GetCustomerLinkStatusAsync(orgId.Value, businessId);
            _link = link.Data;
        }
        else
        {
            _link = null;
        }
        _loading = false;
    }
}

@page "/reports/utang"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosReportingClient Reporting
@inject IPosCustomerClient Customers
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Utang_Title"]</PageTitle>

@if (!Shell.CanSee("reports"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Utang_Title"]" Subtitle="@L["Utang_Subtitle"]" />
    <div class="org-toolbar">
        <ExitsField Label="From"><Input @bind-Value="_from" /></ExitsField>
        <ExitsField Label="To"><Input @bind-Value="_to" /></ExitsField>
        <Button OnClick="LoadAsync">Run</Button>
    </div>
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _report is not null)
    {
        <div class="org-metrics">
            <OrgMetricCard Label="Outstanding" Value="@OrgWebUi.Money(_report.ActiveCustomerOutstanding)" />
            <OrgMetricCard Label="Overdue" Value="@OrgWebUi.Money(_report.OverdueAmount)" />
            <OrgMetricCard Label="Customers" Value="@_report.CustomersWithBalances.ToString()" />
            <OrgMetricCard Label="Repayments" Value="@OrgWebUi.Money(_report.RepaymentsRecordedInPeriod)" />
        </div>
        <h3>Customer balances</h3>
        <div class="org-table-wrap">
            <table class="org-table">
                <thead><tr><th>Customer</th><th>Outstanding</th><th>Overdue</th></tr></thead>
                <tbody>
                    @foreach (var row in _report.CustomersWithBalancesList)
                    {
                        <tr><td>@row.DisplayName</td><td>@OrgWebUi.Money(row.OutstandingAmount)</td><td>@OrgWebUi.Money(row.OverdueAmount)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!_loading && string.IsNullOrWhiteSpace(_error))
    {
        <OrgEmpty Title="@L["Utang_EmptyTitle"]" Message="@L["Utang_EmptyMessage"]" />
    }

    @if (!_loading)
    {
    <Card Size="@CardSize.Small" Title="Overdue customers (paged)">
        <div class="org-table-wrap">
            <table class="org-table">
                <thead><tr><th>Customer</th><th>Outstanding</th><th>Overdue</th></tr></thead>
                <tbody>
                    @foreach (var row in _overdue)
                    {
                        <tr><td>@row.DisplayName</td><td>@OrgWebUi.Money(row.OutstandingAmount)</td><td>@OrgWebUi.Money(row.OverdueAmount)</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <OrgPager Page="_page" PageSize="20" TotalCount="_overdueTotal" PageChanged="ChangePageAsync" />
    </Card>
    }
    </div>
}

@code {
    private string? _from;
    private string? _to;
    private string? _error;
    private bool _loading = true;
    private PosUtangReportDto? _report;
    private int _page = 1;
    private int _overdueTotal;
    private List<PosOverdueCustomerListItemDto> _overdue = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await LoadOverdueAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            DateOnly? from = DateOnly.TryParse(_from, out var f) ? f : null;
            DateOnly? to = DateOnly.TryParse(_to, out var t) ? t : null;
            var result = await Reporting.GetUtangReportAsync(from, to);
            if (!result.IsSuccess)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _report = result.Data;
            _error = null;
            await LoadOverdueAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadOverdueAsync()
    {
        var overdue = await Customers.ListOverdueCustomersAsync(_page, 20);
        if (overdue.IsSuccess && overdue.Data is not null)
        {
            _overdue = overdue.Data.Items;
            _overdueTotal = overdue.Data.TotalCount;
        }
    }
}

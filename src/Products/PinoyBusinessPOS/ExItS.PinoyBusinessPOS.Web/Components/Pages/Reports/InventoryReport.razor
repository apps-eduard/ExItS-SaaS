@page "/reports/inventory"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosReportingClient Reporting
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["InventoryReport_Title"]</PageTitle>

@if (!Shell.CanSee("reports"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["InventoryReport_Title"]" Subtitle="@L["InventoryReport_Subtitle"]" />
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _report is not null)
    {
        <div class="org-metrics">
            <OrgMetricCard Label="Tracked" Value="@_report.TrackedCount.ToString()" />
            <OrgMetricCard Label="Low stock" Value="@_report.LowStockCount.ToString()" />
            <OrgMetricCard Label="Out of stock" Value="@_report.OutOfStockCount.ToString()" />
        </div>
        <div class="org-table-wrap">
            <table class="org-table">
                <thead><tr><th>Product</th><th>SKU</th><th>On hand</th><th>Reorder</th><th>Flags</th></tr></thead>
                <tbody>
                    @foreach (var row in _report.Rows.Take(100))
                    {
                        <tr>
                            <td>@row.ProductName</td>
                            <td>@row.Sku</td>
                            <td>@row.OnHandQuantity</td>
                            <td>@row.ReorderLevel</td>
                            <td><OrgStatusBadge Text="@(row.IsOutOfStock ? "Out of stock" : row.IsLowStock ? "Low stock" : "Normal")" Tone="@(row.IsOutOfStock ? "out" : row.IsLowStock ? "low" : "normal")" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!_loading && string.IsNullOrWhiteSpace(_error))
    {
        <OrgEmpty Title="@L["Stock_EmptyTitle"]" Message="@L["Stock_EmptyMessage"]" />
    }
    </div>
}

@code {
    private string? _error;
    private bool _loading = true;
    private PosInventoryStatusReportDto? _report;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Reporting.GetInventoryStatusReportAsync();
            if (!result.IsSuccess)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _report = result.Data;
            _error = null;
        }
        finally
        {
            _loading = false;
        }
    }
}

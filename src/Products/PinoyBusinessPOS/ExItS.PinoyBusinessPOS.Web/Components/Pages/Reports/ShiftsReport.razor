@page "/reports/shifts"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosReportingClient Reporting
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["ShiftsReport_Title"]</PageTitle>

@if (!Shell.CanSee("reports"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["ShiftsReport_Title"]" Subtitle="@L["ShiftsReport_Subtitle"]" />
    <div class="org-toolbar">
        <ExitsField Label="From"><Input @bind-Value="_from" /></ExitsField>
        <ExitsField Label="To"><Input @bind-Value="_to" /></ExitsField>
        <Button OnClick="LoadAsync">Run</Button>
    </div>
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _shifts is not null && _variance is not null)
    {
        <div class="org-metrics">
            <OrgMetricCard Label="Shifts" Value="@_shifts.ShiftCount.ToString()" />
            <OrgMetricCard Label="Signed variance" Value="@OrgWebUi.Money(_variance.TotalSignedVariance)" />
            <OrgMetricCard Label="Absolute variance" Value="@OrgWebUi.Money(_variance.TotalAbsoluteVariance)" />
        </div>
        <div class="org-table-wrap">
            <table class="org-table">
                <thead><tr><th>Shift</th><th>Date</th><th>Mode</th><th>Expected</th><th>Counted</th><th>Variance</th><th>State</th></tr></thead>
                <tbody>
                    @foreach (var row in _variance.Rows)
                    {
                        <tr>
                            <td>@row.ShiftNumber</td>
                            <td>@row.BusinessDate</td>
                            <td>@row.EffectiveCashCountMode</td>
                            <td>@(row.ExpectedCashAmount?.ToString("N2") ?? "—")</td>
                            <td>@(row.ClosingCashAmount?.ToString("N2") ?? "—")</td>
                            <td>@(row.CashVarianceAmount?.ToString("N2") ?? "—")</td>
                            <td><OrgStatusBadge Text="@row.CashCountState" Tone="@row.CashCountState" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!_loading && string.IsNullOrWhiteSpace(_error))
    {
        <OrgEmpty Title="@L["Shifts_EmptyTitle"]" Message="@L["Shifts_EmptyMessage"]" />
    }
    </div>
}

@code {
    private string? _from;
    private string? _to;
    private string? _error;
    private bool _loading = true;
    private PosShiftSummaryReportDto? _shifts;
    private PosCashVarianceReportDto? _variance;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            DateOnly? from = DateOnly.TryParse(_from, out var f) ? f : null;
            DateOnly? to = DateOnly.TryParse(_to, out var t) ? t : null;
            var shifts = Reporting.GetShiftSummaryReportAsync(from, to);
            var variance = Reporting.GetCashVarianceReportAsync(from, to);
            await Task.WhenAll(shifts, variance);
            var s = await shifts;
            var v = await variance;
            if (!s.IsSuccess || !v.IsSuccess)
            {
                _error = OrgWebUi.Error(s.Error ?? v.Error);
                return;
            }

            _shifts = s.Data;
            _variance = v.Data;
            _error = null;
        }
        finally
        {
            _loading = false;
        }
    }
}

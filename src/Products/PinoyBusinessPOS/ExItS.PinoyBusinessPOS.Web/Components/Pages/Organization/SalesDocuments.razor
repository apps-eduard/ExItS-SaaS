@page "/organization/sales-documents"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["SalesDocument_EducationTitle"]</PageTitle>

@if (!Shell.CanSee("sales-documents"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader
        Title="@L["SalesDocument_EducationTitle"]"
        Subtitle="@L["SalesDocuments_Subtitle"]" />

    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _status is not null)
    {
        @if (_status.RequiresOwnerAction)
        {
            <Alert Type="@AlertType.Warning"
                   Message="@L["SalesDocument_EducationActionNeeded"]"
                   Description="@L["SalesDocument_EducationOwnerRequired"]"
                   ShowIcon="true"
                   Style="margin-bottom: 1rem;" />
        }
        else
        {
            <Alert Type="@AlertType.Success"
                   Message="@L["SalesDocument_EducationAcknowledged"]"
                   ShowIcon="true"
                   Style="margin-bottom: 1rem;" />
        }

        <Card Size="@CardSize.Small" Title="@L["SalesDocument_EducationTitle"]" Style="margin-bottom: 1rem;">
            <p><strong>@L["SalesDocument_CurrentDocument"]</strong></p>
            <p><strong>@L["SalesDocument_BirInvoicingNotEnabled"]</strong></p>
            <p>@L["SalesDocument_EducationBody1"]</p>
            <p>@L["SalesDocument_EducationBody2"]</p>
            <p>@L["SalesDocument_EducationBody3"]</p>
            <p>@L["SalesDocument_EducationBody4"]</p>

            @if (_status.RequiresOwnerAction)
            {
                <div style="margin-top: 1rem;">
                    <Checkbox Checked="@_understood" CheckedChanged="value => _understood = value">
                        @L["SalesDocument_EducationAckCheckbox"]
                    </Checkbox>
                </div>
                <Button Type="@ButtonType.Primary"
                        Loading="_saving"
                        Disabled="@(!_understood)"
                        OnClick="AcknowledgeAsync"
                        Style="margin-top: 1rem;">
                    @L["SalesDocument_EducationContinue"]
                </Button>
            }
            else if (_status.AcknowledgedAtUtc is not null)
            {
                <p class="org-note" style="margin-top: 1rem;">
                    @L["SalesDocument_EducationAcknowledged"] · @_status.AcknowledgedAtUtc.Value.LocalDateTime.ToString("g")
                </p>
            }
        </Card>

        <Card Size="@CardSize.Small" Title="@L["SalesDocument_ComplianceTitle"]">
            <p><strong>@L["SalesDocument_ComplianceReview"]:</strong> <OrgStatusBadge Text="@(_compliance?.ComplianceEligibilityStatus ?? "NotRequested")" Tone="@(_compliance?.ComplianceEligibilityStatus ?? "pending")" /></p>
            <p><strong>@L["SalesDocument_ComplianceIssuance"]:</strong>
                @((_compliance?.TaxDocumentIssuanceEnabled ?? false)
                    ? L["SalesDocument_ComplianceIssuanceEnabled"]
                    : L["SalesDocument_ComplianceIssuanceDisabled"])
            </p>
            <p>@L["SalesDocument_ComplianceNeedHelp"]</p>
            <p class="org-note">
                <a href="/organization/tax-compliance">@L["TaxCompliance_Title"]</a>
            </p>
            @if (Shell.IsExactOrgOwner
                 && (_compliance is null
                     || _compliance.ComplianceEligibilityStatus is "NotRequested" or "Rejected" or "Revoked"))
            {
                <Button Loading="_requesting"
                        OnClick="RequestComplianceAsync"
                        Style="margin-top: 0.75rem;">
                    @L["SalesDocument_ComplianceContactSupport"]
                </Button>
            }
            else if (_compliance is not null
                     && _compliance.ComplianceEligibilityStatus is not "NotRequested")
            {
                <p class="org-note" style="margin-top: 0.75rem;">@L["SalesDocument_ComplianceRequestRecorded"]</p>
            }
        </Card>
    }
    else if (!_loading && string.IsNullOrWhiteSpace(_error))
    {
        <OrgEmpty Title="@L["Common_Unavailable"]" Message="@L["Error_GenericLoad"]" />
    }
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _requesting;
    private bool _understood;
    private string? _error;
    private OrganizationSalesDocumentEducationStatusDto? _status;
    private OrganizationComplianceStatusDto? _compliance;

    protected override async Task OnInitializedAsync()
    {
        if (!Shell.CanSee("sales-documents"))
        {
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null)
            {
                _error = "No organization selected.";
                return;
            }

            var result = await Platform.GetSalesDocumentEducationStatusAsync(orgId.Value);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _status = result.Data;
            var compliance = await Platform.GetOrganizationComplianceStatusAsync(orgId.Value);
            _compliance = compliance.IsSuccess ? compliance.Data : null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AcknowledgeAsync()
    {
        if (!_understood || CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var result = await Platform.AcknowledgeSalesDocumentEducationAsync(orgId);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _status = result.Data;
            _understood = false;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RequestComplianceAsync()
    {
        if (!Shell.IsExactOrgOwner)
        {
            return;
        }

        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            return;
        }

        _requesting = true;
        _error = null;
        try
        {
            var result = await Platform.RequestOrganizationComplianceReviewAsync(orgId.Value);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _compliance = result.Data;
        }
        finally
        {
            _requesting = false;
        }
    }
}

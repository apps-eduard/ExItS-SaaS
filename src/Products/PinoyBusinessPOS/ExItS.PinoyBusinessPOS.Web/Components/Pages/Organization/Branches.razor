@page "/organization/branches"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L
@using ExItS.DesignSystem.Components.Overlay
@using ExItS.PinoyBusinessPOS.Application.Platform

<PageTitle>@L["Branches_Title"]</PageTitle>

@if (!Shell.CanSee("branches"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Branches_Title"]" Subtitle="@L["Branches_Subtitle"]">
        @if (_authorized && !_loading)
        {
            <Button Type="@ButtonType.Primary" OnClick="OpenCreateAsync">@L["Branches_Add"]</Button>
        }
    </ExitsPageHeader>

    <p class="org-note">@L["Branches_PosContextNote"]</p>

    @if (_capacity is not null)
    {
        <p class="org-note">@string.Format(L["Branches_Capacity"].Value, _capacity.Used, _capacity.Allowed)</p>
    }

    <OrgAlert Error="@_error" Success="@_success" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]"
              OnDismissError="() => _error = null" OnDismissSuccess="() => _success = null" />
    <OrgLoading Active="_loading" />

    @if (!_loading && _authorized && string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <OrgEmpty Title="@L["Branches_EmptyTitle"]" Message="@L["Branches_EmptyMessage"]">
            <Button Type="@ButtonType.Primary" OnClick="OpenCreateAsync">@L["Branches_Add"]</Button>
        </OrgEmpty>
    }
    else if (!_loading && _items.Count > 0)
    {
        <div class="org-table-wrap">
            <table class="org-table">
                <thead>
                    <tr>
                        <th>@L["Branches_ColName"]</th>
                        <th>@L["Branches_ColCode"]</th>
                        <th>@L["Branches_ColAddress"]</th>
                        <th>Fulfillment</th>
                        <th>Location</th>
                        <th>@L["Branches_ColStatus"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in _items)
                    {
                        <tr>
                            <td>
                                @b.Name
                                @if (b.IsPrimary)
                                {
                                    <span class="org-badge" style="margin-left:.35rem">@L["Branches_Primary"]</span>
                                }
                            </td>
                            <td>@b.Code</td>
                            <td>
                                <strong>@b.AddressLine1</strong>
                                <div class="org-note">@string.Join(", ", new[] { b.AddressLine2, b.City, b.Region, b.PostalCode, b.CountryCode }.Where(s => !string.IsNullOrWhiteSpace(s)))</div>
                            </td>
                            <td>
                                <div class="org-note">Online: @FulfillmentOnline(b)</div>
                                <div class="org-note">Pickup: @(b.PickupEnabled ? "Enabled" : "Disabled") · Delivery: @FulfillmentDelivery(b)</div>
                            </td>
                            <td>@(b.Latitude is null ? "—" : $"{b.Latitude:0.######}, {b.Longitude:0.######}")</td>
                            <td><OrgStatusBadge Text="@OrgWebUi.Badge(b.Status)" Tone="@b.Status" /></td>
                            <td class="org-actions">
                                <Button Size="@ButtonSize.Small" Disabled="_busy" OnClick="@(() => Nav.NavigateTo($"/organization/branches/{b.Id:D}"))">@L["Common_Edit"]</Button>
                                @if (!b.IsPrimary && !string.Equals(b.Status, "Archived", StringComparison.OrdinalIgnoreCase))
                                {
                                    <Button Size="@ButtonSize.Small" Danger Disabled="_busy" OnClick="() => AskArchive(b)">@L["Branches_Archive"]</Button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <Modal Title="@L["Branches_Add"].Value"
           Visible="_formOpen"
           ConfirmLoading="_busy"
           OnOk="SaveFormAsync"
           OnCancel="CloseForm"
           OkText="@L["Common_Save"].Value"
           CancelText="@L["Common_Cancel"].Value"
           DestroyOnClose>
        <div class="org-form-grid">
            <ExitsField Label="@L["Branches_FieldCode"]">
                <Input @bind-Value="_formCode" Disabled="_busy" Placeholder="@L["Branches_FieldCode"]" />
            </ExitsField>
            <ExitsField Label="@L["Branches_FieldName"]">
                <Input @bind-Value="_formName" Disabled="_busy" Placeholder="@L["Branches_FieldName"]" />
            </ExitsField>
            <ExitsField Label="City / municipality"><Input @bind-Value="_city" Disabled="_busy" /></ExitsField>
        </div>
        <p class="org-note">@L["Branches_CreateHint"]</p>
    </Modal>

    <ConfirmDialog Visible="@(_archiveTarget is not null)"
                   VisibleChanged="v => { if (!v) CloseArchiveDialog(); }"
                   Title="@string.Format(L["Branches_ArchiveTitle"].Value, _archiveTarget?.Name ?? string.Empty)"
                   Message="@L["Branches_ArchiveMessage"]"
                   Danger="true"
                   ShowReason="true"
                   ShowPassword="true"
                   RequireReason="true"
                   RequirePassword="true"
                   Reason="@_archiveReason"
                   ReasonChanged="v => _archiveReason = v"
                   Password="@_archivePassword"
                   PasswordChanged="v => _archivePassword = v"
                   ConfirmLabel="@L["Branches_Archive"]"
                   IsLoading="@_busy"
                   OnConfirm="ConfirmArchiveAsync"
                   OnCancel="CloseArchiveDialog" />
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _formOpen;
    private bool _authorized;
    private string? _error;
    private string? _success;
    private string? _formCode;
    private string? _formName;
    private string? _city;
    private BranchCapacityDto? _capacity;
    private List<OrganizationBranchDto> _items = [];
    private OrganizationBranchDto? _archiveTarget;
    private string? _archiveReason;
    private string? _archivePassword;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _authorized = false;
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            _loading = false;
            _error = L["Error_SessionExpired"];
            return;
        }

        var list = await Platform.GetBranchesAsync(orgId.Value);
        var cap = await Platform.GetBranchCapacityAsync(orgId.Value);
        if (list.IsSuccess && list.Data is not null)
        {
            _items = list.Data.ToList();
            _error = null;
            _authorized = true;
        }
        else
        {
            _items = [];
            _error = OrgWebUi.Error(list.Error, L["Error_GenericLoad"]);
            _authorized = false;
        }

        _capacity = cap.IsSuccess ? cap.Data : null;
        _loading = false;
    }

    private Task OpenCreateAsync()
    {
        _formCode = _formName = _city = null;
        _formOpen = true;
        return Task.CompletedTask;
    }

    private static string FulfillmentOnline(OrganizationBranchDto b) =>
        b.OnlineOrdersPaused ? "Paused" : b.CustomerOrderingEnabled ? "Enabled" : b.CustomerOrderingReady ? "Ready" : "Setup required";

    private static string FulfillmentDelivery(OrganizationBranchDto b) =>
        b.DeliveryEnabled ? "Enabled" : "Setup required";

    private void CloseForm()
    {
        if (_busy)
        {
            return;
        }

        _formOpen = false;
    }

    private async Task SaveFormAsync()
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            _error = L["Error_SessionExpired"];
            return;
        }

        if (string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formCode))
        {
            _error = L["Branches_ValidationRequired"];
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.CreateBranchAsync(
                orgId.Value,
                new CreateBranchRequest(_formCode!.Trim(), _formName.Trim(), City: _city?.Trim()));
            if (!result.IsSuccess)
            {
                _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
                return;
            }

            _formOpen = false;
            _error = null;
            _success = L["Branches_Saved"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskArchive(OrganizationBranchDto branch)
    {
        _archiveTarget = branch;
        _archiveReason = null;
        _archivePassword = null;
    }

    private void CloseArchiveDialog()
    {
        if (_busy) return;
        _archiveTarget = null;
        _archiveReason = null;
        _archivePassword = null;
    }

    private async Task ConfirmArchiveAsync()
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || _archiveTarget is null || string.IsNullOrWhiteSpace(_archiveReason) || string.IsNullOrWhiteSpace(_archivePassword))
        {
            return;
        }

        _busy = true;
        var password = _archivePassword;
        _archivePassword = null;
        try
        {
            var stepUp = await GovernanceCriticalActionFlow.IssueStepUpTokenAsync(
                Platform,
                orgId.Value,
                PlatformGovernanceActionCodes.BranchArchive,
                PlatformGovernanceTargetTypes.OrganizationBranch,
                _archiveTarget.Id,
                password);
            if (!stepUp.IsSuccess || stepUp.Data is null)
            {
                _error = OrgWebUi.Error(stepUp.Error, L["Error_GenericLoad"]);
                return;
            }

            var result = await Platform.ArchiveBranchAsync(
                orgId.Value,
                _archiveTarget.Id,
                new GovernanceCriticalActionRequest(_archiveReason.Trim(), stepUp.Data));
            if (result.IsSuccess)
            {
                _error = null;
                _success = L["Branches_Archived"];
                _archiveTarget = null;
                _archiveReason = null;
                await LoadAsync();
            }
            else
            {
                _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
            }
        }
        finally
        {
            _busy = false;
            _archivePassword = null;
        }
    }
}

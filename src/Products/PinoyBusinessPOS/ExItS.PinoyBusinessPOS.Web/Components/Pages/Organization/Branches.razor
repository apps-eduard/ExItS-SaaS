@page "/organization/branches"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Branches_Title"]</PageTitle>

@if (!Shell.CanSee("branches"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Branches_Title"]" Subtitle="@L["Branches_Subtitle"]">
        @if (_authorized && !_loading)
        {
            <Button Type="@ButtonType.Primary" OnClick="OpenCreateAsync">@L["Branches_Add"]</Button>
        }
    </ExitsPageHeader>

    @if (_capacity is not null)
    {
        <p class="org-note">@string.Format(L["Branches_Capacity"].Value, _capacity.Used, _capacity.Allowed)</p>
    }

    <OrgAlert Error="@_error" Success="@_success" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]"
              OnDismissError="() => _error = null" OnDismissSuccess="() => _success = null" />
    <OrgLoading Active="_loading" />

    @if (!_loading && _authorized && string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <OrgEmpty Title="@L["Branches_EmptyTitle"]" Message="@L["Branches_EmptyMessage"]">
            <Button Type="@ButtonType.Primary" OnClick="OpenCreateAsync">@L["Branches_Add"]</Button>
        </OrgEmpty>
    }
    else if (!_loading && _items.Count > 0)
    {
        <div class="org-table-wrap">
            <table class="org-table">
                <thead>
                    <tr>
                        <th>@L["Branches_ColName"]</th>
                        <th>@L["Branches_ColCode"]</th>
                        <th>@L["Branches_ColAddress"]</th>
                        <th>Fulfillment</th>
                        <th>Location</th>
                        <th>@L["Branches_ColStatus"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in _items)
                    {
                        <tr>
                            <td>
                                @b.Name
                                @if (b.IsPrimary)
                                {
                                    <span class="org-badge" style="margin-left:.35rem">@L["Branches_Primary"]</span>
                                }
                            </td>
                            <td>@b.Code</td>
                            <td>
                                <strong>@b.AddressLine1</strong>
                                <div class="org-note">@string.Join(", ", new[] { b.AddressLine2, b.City, b.Region, b.PostalCode, b.CountryCode }.Where(s => !string.IsNullOrWhiteSpace(s)))</div>
                            </td>
                            <td>
                                @if (b.PickupEnabled) { <span class="org-badge">Pickup</span> }
                                @if (b.DeliveryEnabled) { <span class="org-badge">Delivery</span> }
                            </td>
                            <td>@(b.Latitude is null ? "—" : $"{b.Latitude:0.######}, {b.Longitude:0.######}")</td>
                            <td><OrgStatusBadge Text="@OrgWebUi.Badge(b.Status)" Tone="@b.Status" /></td>
                            <td class="org-actions">
                                <Button Size="@ButtonSize.Small" Disabled="_busy" OnClick="() => OpenEditAsync(b)">@L["Common_Edit"]</Button>
                                @if (!b.IsPrimary && !string.Equals(b.Status, "Archived", StringComparison.OrdinalIgnoreCase))
                                {
                                    <Button Size="@ButtonSize.Small" Danger Disabled="_busy" OnClick="() => ArchiveAsync(b)">@L["Branches_Archive"]</Button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <Modal Title="@(_editing is null ? L["Branches_Add"].Value : L["Branches_Edit"].Value)"
           Visible="_formOpen"
           ConfirmLoading="_busy"
           OnOk="SaveFormAsync"
           OnCancel="CloseForm"
           OkText="@L["Common_Save"].Value"
           CancelText="@L["Common_Cancel"].Value"
           DestroyOnClose>
        <ExitsField Label="@L["Branches_FieldCode"]">
            <Input @bind-Value="_formCode" Disabled="_editing is not null || _busy" Placeholder="@L["Branches_FieldCode"]" />
        </ExitsField>
        <ExitsField Label="@L["Branches_FieldName"]">
            <Input @bind-Value="_formName" Disabled="_busy" Placeholder="@L["Branches_FieldName"]" />
        </ExitsField>
        <div class="org-form-grid">
            <ExitsField Label="Address line 1"><Input @bind-Value="_address1" Disabled="_busy" /></ExitsField>
            <ExitsField Label="Address line 2"><Input @bind-Value="_address2" Disabled="_busy" /></ExitsField>
            <ExitsField Label="City / municipality"><Input @bind-Value="_city" Disabled="_busy" /></ExitsField>
            <ExitsField Label="Province / region"><Input @bind-Value="_region" Disabled="_busy" /></ExitsField>
            <ExitsField Label="Postal code"><Input @bind-Value="_postalCode" Disabled="_busy" /></ExitsField>
            <ExitsField Label="Country code"><Input @bind-Value="_countryCode" Disabled="_busy" /></ExitsField>
            <ExitsField Label="Latitude"><Input @bind-Value="_latitude" Disabled="_busy" /></ExitsField>
            <ExitsField Label="Longitude"><Input @bind-Value="_longitude" Disabled="_busy" /></ExitsField>
        </div>
        <div class="org-form-grid">
            <label><input type="checkbox" @bind="_pickupEnabled" disabled="@_busy" /> Pickup enabled</label>
            <label><input type="checkbox" @bind="_deliveryEnabled" disabled="@_busy" /> Delivery enabled</label>
        </div>
        @if (_deliveryEnabled)
        {
            <h4>Delivery policy</h4>
            <div class="org-form-grid">
                <ExitsField Label="Minimum order"><Input @bind-Value="_minimumOrder" Disabled="_busy" /></ExitsField>
                <ExitsField Label="Base fee"><Input @bind-Value="_baseFee" Disabled="_busy" /></ExitsField>
                <ExitsField Label="Included km"><Input @bind-Value="_includedKm" Disabled="_busy" /></ExitsField>
                <ExitsField Label="Additional fee / km"><Input @bind-Value="_additionalPerKm" Disabled="_busy" /></ExitsField>
                <ExitsField Label="Maximum km"><Input @bind-Value="_maximumKm" Disabled="_busy" /></ExitsField>
                <ExitsField Label="Free delivery threshold"><Input @bind-Value="_freeThreshold" Disabled="_busy" /></ExitsField>
            </div>
        }
    </Modal>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _formOpen;
    private bool _authorized;
    private string? _error;
    private string? _success;
    private string? _formCode;
    private string? _formName;
    private string? _address1;
    private string? _address2;
    private string? _city;
    private string? _region;
    private string? _postalCode;
    private string? _countryCode;
    private string? _latitude;
    private string? _longitude;
    private bool _pickupEnabled = true;
    private bool _deliveryEnabled;
    private string _minimumOrder = "0";
    private string _baseFee = "0";
    private string _includedKm = "0";
    private string _additionalPerKm = "0";
    private string _maximumKm = "0";
    private string? _freeThreshold;
    private OrganizationBranchDto? _editing;
    private BranchCapacityDto? _capacity;
    private List<OrganizationBranchDto> _items = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _authorized = false;
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            _loading = false;
            _error = L["Error_SessionExpired"];
            return;
        }

        var list = await Platform.GetBranchesAsync(orgId.Value);
        var cap = await Platform.GetBranchCapacityAsync(orgId.Value);
        if (list.IsSuccess && list.Data is not null)
        {
            _items = list.Data.ToList();
            _error = null;
            _authorized = true;
        }
        else
        {
            _items = [];
            _error = OrgWebUi.Error(list.Error, L["Error_GenericLoad"]);
            _authorized = false;
        }

        _capacity = cap.IsSuccess ? cap.Data : null;
        _loading = false;
    }

    private Task OpenCreateAsync()
    {
        _editing = null;
        _formCode = _formName = _address1 = _address2 = _city = _region = _postalCode = _countryCode = _latitude = _longitude = null;
        _pickupEnabled = true;
        _deliveryEnabled = false;
        _formOpen = true;
        return Task.CompletedTask;
    }

    private Task OpenEditAsync(OrganizationBranchDto branch)
    {
        _editing = branch;
        _formCode = branch.Code;
        _formName = branch.Name;
        _address1 = branch.AddressLine1; _address2 = branch.AddressLine2; _city = branch.City; _region = branch.Region;
        _postalCode = branch.PostalCode; _countryCode = branch.CountryCode;
        _latitude = branch.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _longitude = branch.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _pickupEnabled = branch.PickupEnabled; _deliveryEnabled = branch.DeliveryEnabled;
        if (branch.DeliveryPolicy is { } policy)
        {
            _minimumOrder = F(policy.MinimumOrderAmount); _baseFee = F(policy.BaseDeliveryFee); _includedKm = F(policy.IncludedDistanceKm);
            _additionalPerKm = F(policy.AdditionalFeePerKm); _maximumKm = F(policy.MaximumDeliveryDistanceKm);
            _freeThreshold = policy.FreeDeliveryThreshold is null ? null : F(policy.FreeDeliveryThreshold.Value);
        }
        _formOpen = true;
        return Task.CompletedTask;
    }

    private void CloseForm()
    {
        if (_busy)
        {
            return;
        }

        _formOpen = false;
        _editing = null;
    }

    private async Task SaveFormAsync()
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            _error = L["Error_SessionExpired"];
            return;
        }

        if (string.IsNullOrWhiteSpace(_formName) || (_editing is null && string.IsNullOrWhiteSpace(_formCode)))
        {
            _error = L["Branches_ValidationRequired"];
            return;
        }

        _busy = true;
        try
        {
            Guid? savedBranchId = _editing?.Id;
            if (_editing is null)
            {
                var result = await Platform.CreateBranchAsync(
                    orgId.Value,
                    new CreateBranchRequest(_formCode!.Trim(), _formName.Trim(), _address1, _address2, _city, _region,
                        _postalCode, _countryCode, NullableD(_latitude), NullableD(_longitude), _pickupEnabled, _deliveryEnabled));
                if (!result.IsSuccess)
                {
                    _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
                    return;
                }
                savedBranchId = result.Data?.Id;
            }
            else
            {
                var result = await Platform.UpdateBranchAsync(
                    orgId.Value,
                    _editing.Id,
                    new UpdateBranchRequest(_formName.Trim(), _address1, _address2, _city, _region, _postalCode,
                        _countryCode, null, NullableD(_latitude), NullableD(_longitude),
                        string.IsNullOrWhiteSpace(_latitude) && string.IsNullOrWhiteSpace(_longitude), _pickupEnabled, _deliveryEnabled));
                if (!result.IsSuccess)
                {
                    _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
                    return;
                }
            }

            if (_deliveryEnabled && savedBranchId is Guid branchId)
            {
                var policy = await Platform.UpsertBranchDeliveryPolicyAsync(orgId.Value, branchId,
                    new UpsertBranchDeliveryPolicyRequest(D(_minimumOrder), D(_baseFee), D(_includedKm),
                        D(_additionalPerKm), D(_maximumKm), NullableD(_freeThreshold)));
                if (!policy.IsSuccess)
                {
                    _error = OrgWebUi.Error(policy.Error, L["Error_GenericLoad"]);
                    return;
                }
            }

            _formOpen = false;
            _editing = null;
            _error = null;
            _success = L["Branches_Saved"];
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string F(decimal value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static decimal D(string? value) => decimal.TryParse(value, System.Globalization.NumberStyles.Number,
        System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0m;
    private static decimal? NullableD(string? value) => string.IsNullOrWhiteSpace(value) ? null : D(value);

    private async Task ArchiveAsync(OrganizationBranchDto branch)
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.ArchiveBranchAsync(orgId.Value, branch.Id);
            if (result.IsSuccess)
            {
                _error = null;
                _success = L["Branches_Archived"];
                await LoadAsync();
            }
            else
            {
                _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

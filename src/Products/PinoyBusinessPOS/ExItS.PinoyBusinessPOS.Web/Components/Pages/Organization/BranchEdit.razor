@page "/organization/branches/{BranchId:guid}"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<OrgWebResources> L
@inject NavigationManager Nav

<PageTitle>@L["Branches_Edit"]</PageTitle>

@if (!Shell.CanSee("branches"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page org-page--form org-branch-edit">
        <ExitsPageHeader Title="@L["Branches_Edit"]" Subtitle="@_code">
            <Button OnClick='() => Nav.NavigateTo("/organization/branches")'>@L["Common_Back"]</Button>
        </ExitsPageHeader>
        <OrgAlert Error="@_error" Success="@_success" OnDismissError="() => _error = null" OnDismissSuccess="() => _success = null" />
        <OrgLoading Active="_loading" />

        @if (!_loading && _branch is not null)
        {
            <ErrorBoundary>
            <ChildContent>
            <section class="org-panel org-setup">
                <h3>@L["Branches_Setup"]</h3>
                <div class="org-setup-rows" role="list">
                    <button type="button" class="org-setup-nav" role="listitem"
                            aria-label="@($"{L["Branches_Details"]}, {L["Branches_StatusReady"]}")"
                            @onclick="FocusDetails">
                        <span>@L["Branches_Details"]</span>
                        <span class="org-badge">@L["Branches_StatusReady"]</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="org-setup-nav" role="listitem"
                            aria-label="@($"{L["Branches_Staff"]}, {L["Branches_StaffNotAuto"]}")"
                            @onclick='() => Nav.NavigateTo("/staff")'>
                        <span>@L["Branches_Staff"]</span>
                        <span class="org-badge">@L["Branches_StaffNotAuto"]</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="org-setup-nav" role="listitem"
                            aria-label="@($"{L["Branches_Devices"]}, {DeviceStatusLabel()}")"
                            @onclick='() => Nav.NavigateTo("/operations/devices")'>
                        <span>@L["Branches_Devices"]</span>
                        <span class="org-badge">@DeviceStatusLabel()</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="org-setup-nav" role="listitem"
                            aria-label="@($"{L["Branches_Inventory"]}, {L["Branches_InventoryNotCopied"]}")"
                            @onclick="() => _showInventoryActions = !_showInventoryActions">
                        <span>@L["Branches_Inventory"]</span>
                        <span class="org-badge">@L["Branches_InventoryNotCopied"]</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    @if (_showInventoryActions)
                    {
                        <button type="button" class="org-setup-nav org-setup-nav--sub" role="listitem" @onclick='() => Nav.NavigateTo("/inventory")'>
                            <span>@L["Branches_AddOpeningStock"]</span>
                            <span aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="org-setup-nav org-setup-nav--sub" role="listitem" @onclick='() => Nav.NavigateTo("/inventory/transfers")'>
                            <span>@L["Branches_TransferStock"]</span>
                            <span aria-hidden="true">›</span>
                        </button>
                    }
                    <button type="button" class="org-setup-nav" role="listitem"
                            aria-label="@($"{L["Branches_OperatingHours"]}, {HoursStatusLabel()}")"
                            @onclick="FocusHours">
                        <span>@L["Branches_OperatingHours"]</span>
                        <span class="org-badge" title="@HoursStatusLabel()">@CompactStatus(HoursStatusLabel())</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="org-setup-nav" role="listitem"
                            title="@L["Branches_OrgCatalogHint"]"
                            aria-label="@($"{L["Branches_OrgCatalog"]}, {L["Branches_OrgWide"]}")"
                            @onclick='() => Nav.NavigateTo("/products")'>
                        <span>@L["Branches_Catalog"]</span>
                        <span class="org-badge">@L["Branches_OrgWide"]</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="org-setup-nav" role="listitem"
                            title="@L["Branches_OrgCustomersHint"]"
                            aria-label="@($"{L["Branches_OrgCustomers"]}, {L["Branches_OrgWide"]}")"
                            @onclick='() => Nav.NavigateTo("/customers")'>
                        <span>@L["Branches_Customers"]</span>
                        <span class="org-badge">@L["Branches_OrgWide"]</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    @if (_readiness is not null)
                    {
                        <button type="button" class="org-setup-nav" role="listitem"
                                aria-label="@($"{L["Branches_Fulfillment"]}, {FulfillmentRowStatus()}")"
                                @onclick="FocusFulfillment">
                            <span>@L["Branches_Fulfillment"]</span>
                            <span class="org-badge" title="@FulfillmentRowStatus()">@FulfillmentRowStatus()</span>
                            <span aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            </section>

            <section id="branch-details" class="org-fold">
                <button type="button" class="org-setup-nav org-fold-toggle"
                        aria-expanded="@_detailsOpen"
                        aria-controls="branch-details-body"
                        @onclick="ToggleDetails">
                    <span>@L["Branches_Details"]</span>
                    <span class="org-badge">@L["Branches_StatusReady"]</span>
                    <span aria-hidden="true">›</span>
                </button>
                @if (_detailsOpen)
                {
                    <div id="branch-details-body" class="org-form-grid">
                    <ExitsField Label="@L["Branches_FieldName"]"><Input @bind-Value="_name" Disabled="_busy" /></ExitsField>
                    <ExitsField Label="@L["Branches_ContactPhone"]"><Input @bind-Value="_contactPhone" Disabled="_busy" /></ExitsField>
                    <ExitsField Label="@L["Branches_TimeZone"]"><Input @bind-Value="_timeZoneId" Disabled="_busy" Placeholder="@L["Branches_TimeZoneHint"]" /></ExitsField>
                    <ExitsField Label="@L["Branches_ColStatus"]">
                        <select class="org-select" @bind="_status" disabled="@_busy">
                            @foreach (var status in BranchLocationUi.StatusCodesFor(_status))
                            {
                                <option value="@status">@StatusLabel(status)</option>
                            }
                        </select>
                    </ExitsField>
                    </div>
                }
            </section>

            <section id="branch-address" class="org-fold">
                <button type="button" class="org-setup-nav org-fold-toggle"
                        aria-expanded="@_addressOpen"
                        aria-controls="branch-address-body"
                        @onclick="() => _addressOpen = !_addressOpen">
                    <span>@L["Branches_AddressLocation"]</span>
                    <span class="org-badge">@(AddressIncomplete || MapIncomplete ? L["Branches_Required"] : L["Branches_StatusReady"])</span>
                    <span aria-hidden="true">›</span>
                </button>
                @if (_addressOpen)
                {
                    <div id="branch-address-body" class="org-address-grid">
                    <ExitsField Label="@L["Branches_AddressLine1"]"><Input @bind-Value="_address1" Disabled="_busy" /></ExitsField>
                    @if (_showAddressLine2 || !string.IsNullOrWhiteSpace(_address2))
                    {
                        <ExitsField Label="@L["Branches_AddressLine2"]"><Input @bind-Value="_address2" Disabled="_busy" /></ExitsField>
                    }
                    else
                    {
                        <button type="button" class="org-disclose" @onclick="() => _showAddressLine2 = true">@L["Branches_AddAddressLine2"]</button>
                    }
                    <ExitsField Label="@L["Branches_FieldCity"]"><Input @bind-Value="_city" Disabled="_busy" /></ExitsField>
                    <ExitsField Label="@L["Branches_Region"]"><Input @bind-Value="_region" Disabled="_busy" /></ExitsField>
                    <div class="org-address-pair">
                        <ExitsField Label="@L["Branches_PostalCode"]"><Input @bind-Value="_postalCode" Disabled="_busy" /></ExitsField>
                        <ExitsField Label="@L["Branches_Country"]">
                            <select class="org-select" @bind="_countryCode" disabled="@_busy" aria-label="@L["Branches_Country"]">
                                <option value="@BranchLocationUi.UnspecifiedCode">@L["Branches_None"]</option>
                                @foreach (var country in BranchLocationUi.CodesFor(_countryCode))
                                {
                                    <option value="@country">@CountryName(country)</option>
                                }
                            </select>
                        </ExitsField>
                    </div>
                    <button type="button" class="org-setup-nav org-setup-nav--nested"
                            aria-expanded="@_mapOpen"
                            aria-label="@($"{L["Branches_MapLocation"]}, {L["Branches_LocationHint"]}")"
                            @onclick="() => _mapOpen = !_mapOpen">
                        <span class="org-setup-nav__stack">
                            <span>@L["Branches_MapLocation"]</span>
                            <span class="org-note">@(MapIncomplete ? L["Branches_NotConfigured"] : L["Branches_StatusReady"])</span>
                        </span>
                        <span class="org-badge">@L["Branches_LocationHint"]</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    @if (_mapOpen)
                    {
                        <ExitsField Label="@L["Branches_Latitude"]"><Input @bind-Value="_latitude" Disabled="_busy" /></ExitsField>
                        <ExitsField Label="@L["Branches_Longitude"]"><Input @bind-Value="_longitude" Disabled="_busy" /></ExitsField>
                    }
                    </div>
                }
            </section>

            <section id="branch-hours" class="org-fold">
                <button type="button" class="org-setup-nav org-fold-toggle"
                        aria-expanded="@_hoursOpen"
                        aria-controls="branch-hours-body"
                        @onclick="ToggleHours">
                    <span>@L["Branches_OperatingHours"]</span>
                    <span class="org-badge" title="@HoursStatusLabel()">@CompactStatus(HoursStatusLabel())</span>
                    <span aria-hidden="true">›</span>
                </button>
                @if (_hoursOpen)
                {
                    <div id="branch-hours-body">
                    <div class="org-hours" role="list">
                    @foreach (var day in _hours)
                    {
                        <button type="button"
                                class="org-hours-row"
                                role="listitem"
                                disabled="@_busy"
                                aria-label="@($"{DayFullLabel(day.DayOfWeek)}, {DaySummary(day)}")"
                                @onclick="() => OpenDayEditor(day)">
                            <strong>@DayLabel(day.DayOfWeek)</strong>
                            <span>@DaySummary(day)</span>
                            <span aria-hidden="true">›</span>
                        </button>
                    }
                    </div>
                    @if (_showCopyPanel)
                    {
                        <div class="org-hours-copy">
                            <p class="org-note">@L["Branches_CopyHoursTo"]</p>
                            <div class="org-hours-copy__days">
                                @foreach (var day in _hours.Where(d => !string.Equals(d.DayOfWeek, nameof(DayOfWeek.Monday), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <Checkbox Checked="@_copyTargets.Contains(day.DayOfWeek)"
                                              CheckedChanged="@((bool value) => ToggleCopyTarget(day.DayOfWeek, value))">
                                        @DayLabel(day.DayOfWeek)
                                    </Checkbox>
                                }
                            </div>
                            <Button Size="@ButtonSize.Small" Disabled="_busy" OnClick="ApplyCopyHours">@L["Branches_ApplyCopy"]</Button>
                        </div>
                    }
                    else
                    {
                        <Button Size="@ButtonSize.Small" Disabled="_busy" OnClick="OpenCopyPanel">@L["Branches_CopyHours"]</Button>
                    }
                    </div>
                }
            </section>

            @if (_readiness is not null)
            {
                <section id="branch-fulfillment" class="org-fold">
                    <button type="button" class="org-setup-nav org-fold-toggle"
                            aria-expanded="@_fulfillmentOpen"
                            aria-controls="branch-fulfillment-body"
                            @onclick="ToggleFulfillment">
                        <span>@L["Branches_Fulfillment"]</span>
                        <span class="org-badge" title="@FulfillmentRowStatus()">@FulfillmentRowStatus()</span>
                        <span aria-hidden="true">›</span>
                    </button>
                    @if (_fulfillmentOpen)
                    {
                    <div id="branch-fulfillment-body">
                    @if (!string.IsNullOrWhiteSpace(_readiness.StoreStatusMessage))
                    {
                        <p class="org-note">@_readiness.StoreStatusMessage</p>
                    }
                    <div class="org-fulfill-summary">
                        <button type="button" class="org-setup-nav" aria-expanded="@_onlineOpen"
                                aria-label="@($"{L["Branches_OnlineOrders"]}, {OnlineOrdersStatus()}")"
                                @onclick="() => _onlineOpen = !_onlineOpen">
                            <span>@L["Branches_OnlineOrders"]</span>
                            <span class="org-badge" title="@OnlineOrdersStatus()">@CompactStatus(OnlineOrdersStatus())</span>
                            <span aria-hidden="true">›</span>
                        </button>
                        @if (_onlineOpen)
                        {
                            <div class="org-fold-actions">
                                @if (_readiness.CanUseCustomerOrdering && !_readiness.CustomerOrderingEnabled && _readiness.CustomerOrderingReady)
                                {
                                    <Button Size="@ButtonSize.Small" Loading="_busy" OnClick="() => ToggleFulfillmentAsync(ordering: true)">@L["Branches_Enable"]</Button>
                                }
                                @if (_readiness.OnlineOrdersPaused)
                                {
                                    <Button Size="@ButtonSize.Small" Loading="_busy" OnClick="() => PauseOrdersAsync(false)">@L["Branches_ResumeOrders"]</Button>
                                }
                                else if (_readiness.CustomerOrderingEnabled)
                                {
                                    <Button Size="@ButtonSize.Small" Danger Loading="_busy" OnClick="() => PauseOrdersAsync(true)">@L["Branches_PauseOrders"]</Button>
                                }
                            </div>
                        }
                        <button type="button" class="org-setup-nav" aria-expanded="@_pickupOpen"
                                aria-label="@($"{L["Branches_Pickup"]}, {PickupStatus()}")"
                                @onclick="() => _pickupOpen = !_pickupOpen">
                            <span>@L["Branches_Pickup"]</span>
                            <span class="org-badge">@PickupStatus()</span>
                            <span aria-hidden="true">›</span>
                        </button>
                        @if (_pickupOpen)
                        {
                            <div class="org-fold-actions">
                                @if (_readiness.CustomerOrderingEnabled && _readiness.PickupReady && !_readiness.PickupEnabled)
                                {
                                    <Button Size="@ButtonSize.Small" Loading="_busy" OnClick="() => ToggleFulfillmentAsync(pickup: true)">@L["Branches_Enable"]</Button>
                                }
                            </div>
                        }
                        <button type="button" class="org-setup-nav" aria-expanded="@_deliveryOpen"
                                aria-label="@($"{L["Branches_Delivery"]}, {DeliveryRowStatus()}")"
                                @onclick="() => _deliveryOpen = !_deliveryOpen">
                            <span>@L["Branches_Delivery"]</span>
                            <span class="org-badge" title="@DeliveryRowStatus()">@DeliveryRowStatus()</span>
                            <span aria-hidden="true">›</span>
                        </button>
                    </div>
                    @if (_deliveryOpen)
                    {
                        <div class="org-delivery">
                            <h4>@L["Branches_DeliverySetup"]</h4>
                            @if (DeliveryMissingCount > 0 && _readiness.CanUseDelivery)
                            {
                                <p class="org-note">@string.Format(L["Branches_MissingCount"].Value, DeliveryMissingCount)</p>
                            }
                            <div class="org-ready-grid">
                                <div>
                                    <p class="org-list-label">@L["Branches_CheckMissing"]</p>
                                    <ul class="org-pills">
                                        @foreach (var item in DeliveryChecks().Where(c => c.Missing))
                                        {
                                            <li class="org-pill org-pill--missing">
                                                @item.Label
                                                <span class="org-sr-only">@L["Branches_CheckMissing"]</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div>
                                    <p class="org-list-label">@L["Branches_ReadyList"]</p>
                                    <ul class="org-pills">
                                        @foreach (var item in DeliveryChecks().Where(c => !c.Missing))
                                        {
                                            <li class="org-pill org-pill--ok">
                                                @item.Label
                                                <span class="org-sr-only">@L["Branches_CheckOk"]</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                            <div class="org-fold-actions">
                                @if (_readiness.CanUseDelivery && _readiness.DeliveryReady && !_readiness.DeliveryEnabled)
                                {
                                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" Loading="_busy" OnClick="() => ToggleFulfillmentAsync(delivery: true)">@L["Branches_EnableDelivery"]</Button>
                                }
                                else if (_readiness.DeliveryEnabled)
                                {
                                    <Button Size="@ButtonSize.Small" Loading="_busy" OnClick="() => ToggleFulfillmentAsync(delivery: false)">@L["Branches_DisableDelivery"]</Button>
                                }
                                else if (_readiness.CanUseDelivery && !_readiness.DeliveryReady)
                                {
                                    <Button Size="@ButtonSize.Small" OnClick="() => _showDeliverySettings = true">@L["Branches_Configure"]</Button>
                                }
                            </div>
                        </div>
                    }
                    @if (_showDeliverySettings)
                    {
                        <h4>@L["Branches_DeliverySettings"]</h4>
                        <div class="org-form-grid">
                            <ExitsField Label="@L["Branches_MinimumOrder"]"><Input @bind-Value="_minimumOrder" Disabled="_busy" /></ExitsField>
                            <ExitsField Label="@L["Branches_BaseFee"]"><Input @bind-Value="_baseFee" Disabled="_busy" /></ExitsField>
                            <ExitsField Label="@L["Branches_IncludedKm"]"><Input @bind-Value="_includedKm" Disabled="_busy" /></ExitsField>
                            <ExitsField Label="@L["Branches_AdditionalPerKm"]"><Input @bind-Value="_additionalPerKm" Disabled="_busy" /></ExitsField>
                            <ExitsField Label="@L["Branches_MaximumKm"]"><Input @bind-Value="_maximumKm" Disabled="_busy" /></ExitsField>
                            <ExitsField Label="@L["Branches_FreeThreshold"]"><Input @bind-Value="_freeThreshold" Disabled="_busy" Placeholder="@L["Branches_None"]" /></ExitsField>
                        </div>
                    }
                    </div>
                    }
                </section>
            }

            <div class="org-branch-edit__sticky" role="region" aria-label="@L["Branches_SaveActions"]">
                <Button OnClick='() => Nav.NavigateTo("/organization/branches")'>@L["Common_Cancel"]</Button>
                <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="SaveAsync">@L["Common_Save"]</Button>
            </div>
            </ChildContent>
            <ErrorContent>
                <OrgAlert Error="@L["Error_GenericLoad"].Value" />
            </ErrorContent>
            </ErrorBoundary>
        }

        <Modal Title="@(_dayDraft is null ? L["Branches_OperatingHours"].Value : DayFullLabel(_dayDraft.DayOfWeek))"
               Visible="_dayDraft is not null"
               OnOk="DoneDayEditor"
               OnCancel="CloseDayEditor"
               OkText="@L["Branches_HoursDone"].Value"
               CancelText="@L["Common_Cancel"].Value"
               DestroyOnClose>
            @if (_dayDraft is not null)
            {
                <div class="org-hours-editor">
                    <div class="org-hours-editor__modes" role="radiogroup" aria-label="@L["Branches_OperatingHours"]">
                        <Button Size="@ButtonSize.Small" Type="@(_dayDraft.Mode == BranchHoursScheduleUi.ModeOpen ? ButtonType.Primary : ButtonType.Default)" OnClick='() => SetDraftMode(BranchHoursScheduleUi.ModeOpen)'>@L["Branches_HoursOpen"]</Button>
                        <Button Size="@ButtonSize.Small" Type="@(_dayDraft.Mode == BranchHoursScheduleUi.ModeOpen24 ? ButtonType.Primary : ButtonType.Default)" OnClick='() => SetDraftMode(BranchHoursScheduleUi.ModeOpen24)'>@L["Branches_Open24h"]</Button>
                        <Button Size="@ButtonSize.Small" Type="@(_dayDraft.Mode == BranchHoursScheduleUi.ModeClosed ? ButtonType.Primary : ButtonType.Default)" OnClick='() => SetDraftMode(BranchHoursScheduleUi.ModeClosed)'>@L["Branches_Closed"]</Button>
                    </div>
                    @if (BranchHoursScheduleUi.ShowsTimes(_dayDraft.IsClosed, _dayDraft.IsOpen24Hours))
                    {
                        <ExitsField Label="@L["Branches_HoursStart"]">
                            <input class="org-select"
                                   type="time"
                                   aria-label="@L["Branches_HoursStart"]"
                                   value="@BranchHoursScheduleUi.FormatStoredTime(_dayDraft.OpenTime)"
                                   @onchange="e => _dayDraft.OpenTime = ParseChangedTime(e.Value, _dayDraft.OpenTime)" />
                        </ExitsField>
                        <ExitsField Label="@L["Branches_HoursEnd"]">
                            <input class="org-select"
                                   type="time"
                                   aria-label="@L["Branches_HoursEnd"]"
                                   value="@BranchHoursScheduleUi.FormatStoredTime(_dayDraft.CloseTime)"
                                   @onchange="e => _dayDraft.CloseTime = ParseChangedTime(e.Value, _dayDraft.CloseTime)" />
                        </ExitsField>
                    }
                    <div class="org-hours-copy">
                        <p class="org-note">@L["Branches_ApplyToOtherDays"]</p>
                        <div class="org-hours-copy__days">
                            @foreach (var day in _hours.Where(d => !string.Equals(d.DayOfWeek, _dayDraft.DayOfWeek, StringComparison.OrdinalIgnoreCase)))
                            {
                                <Checkbox Checked="@_applyTargets.Contains(day.DayOfWeek)"
                                          CheckedChanged="@((bool value) => ToggleApplyTarget(day.DayOfWeek, value))">
                                    @DayLabel(day.DayOfWeek)
                                </Checkbox>
                            }
                        </div>
                    </div>
                </div>
            }
        </Modal>
    </div>
}

@code {
    [Parameter] public Guid BranchId { get; set; }
    private OrganizationBranchDto? _branch;
    private BranchFulfillmentReadinessDto? _readiness;
    private readonly List<BranchHoursDayDraft> _hours = [];
    private BranchHoursDayDraft? _editingDay;
    private BranchHoursDayDraft? _dayDraft;
    private bool _showCopyPanel;
    private HashSet<string> _copyTargets = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _applyTargets = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading = true;
    private bool _busy;
    private bool _showInventoryActions;
    private bool _showDeliverySettings;
    private bool _showAddressLine2;
    private bool _mapOpen;
    private bool _detailsOpen;
    private bool _addressOpen;
    private bool _hoursOpen;
    private bool _fulfillmentOpen;
    private bool _onlineOpen;
    private bool _pickupOpen;
    private bool _deliveryOpen;
    private string? _error;
    private string? _success;
    private string? _code;
    private string? _name;
    private string? _contactPhone;
    private string? _timeZoneId;
    private string _status = "Active";
    private string? _address1;
    private string? _address2;
    private string? _city;
    private string? _region;
    private string? _postalCode;
    private string _countryCode = BranchLocationUi.UnspecifiedCode;
    private string? _latitude;
    private string? _longitude;
    private int _deviceCount;
    private string _minimumOrder = "0";
    private string _baseFee = "0";
    private string _includedKm = "0";
    private string _additionalPerKm = "0";
    private string _maximumKm = "0";
    private string? _freeThreshold;

    private bool AddressIncomplete => string.IsNullOrWhiteSpace(_address1) || string.IsNullOrWhiteSpace(_city);
    private bool MapIncomplete => string.IsNullOrWhiteSpace(_latitude) || string.IsNullOrWhiteSpace(_longitude);
    private int DeliveryMissingCount => DeliveryChecks().Count(c => c.Missing);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null) { _error = L["Error_SessionExpired"]; return; }
            var list = await Platform.GetBranchesAsync(orgId.Value);
            _branch = list.Data?.FirstOrDefault(b => b.Id == BranchId);
            if (_branch is null) { _error = L["Error_GenericLoad"]; return; }
            Map(_branch);
            await LoadFulfillmentAsync(orgId.Value);
            var devices = await Platform.GetPosDevicesAsync(orgId.Value);
            _deviceCount = devices.Data?.Count(d => d.BranchId == BranchId) ?? 0;
            _showDeliverySettings = false;
            _showAddressLine2 = !string.IsNullOrWhiteSpace(_address2);
            _mapOpen = false;
            _detailsOpen = false;
            _addressOpen = AddressIncomplete;
            _hoursOpen = !BranchHoursScheduleUi.HasConfiguredHours(_hours);
            _fulfillmentOpen = false;
        }
        catch
        {
            _error = L["Error_GenericLoad"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadFulfillmentAsync(Guid orgId)
    {
        var readiness = await Platform.GetBranchFulfillmentReadinessAsync(orgId, BranchId);
        if (readiness.IsSuccess) _readiness = readiness.Data;
        var hours = await Platform.GetBranchOperatingHoursAsync(orgId, BranchId);
        _hours.Clear();
        if (hours.IsSuccess && hours.Data is not null)
        {
            foreach (var day in hours.Data.OrderBy(d => DayOrder(d.DayOfWeek)))
            {
                _hours.Add(new BranchHoursDayDraft
                {
                    DayOfWeek = day.DayOfWeek,
                    IsClosed = day.IsClosed,
                    IsOpen24Hours = day.IsOpen24Hours,
                    OpenTime = BranchHoursScheduleUi.ParseTime(day.OpenTime, new TimeOnly(8, 0)),
                    CloseTime = BranchHoursScheduleUi.ParseTime(day.CloseTime, new TimeOnly(21, 0))
                });
            }
        }
        else
        {
            foreach (var day in BranchHoursScheduleUi.OrderedDays)
            {
                _hours.Add(new BranchHoursDayDraft { DayOfWeek = day, IsClosed = true });
            }
        }
    }

    private void Map(OrganizationBranchDto b)
    {
        _code = b.Code; _name = b.Name;
        _status = BranchLocationUi.BindStatus(b.Status);
        _contactPhone = b.ContactPhone; _timeZoneId = b.TimeZoneId;
        _address1 = b.AddressLine1; _address2 = b.AddressLine2; _city = b.City; _region = b.Region;
        _postalCode = b.PostalCode;
        _countryCode = BranchLocationUi.BindCode(b.CountryCode);
        _latitude = b.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _longitude = b.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (b.DeliveryPolicy is { } p)
        {
            _minimumOrder = F(p.MinimumOrderAmount); _baseFee = F(p.BaseDeliveryFee); _includedKm = F(p.IncludedDistanceKm);
            _additionalPerKm = F(p.AdditionalFeePerKm); _maximumKm = F(p.MaximumDeliveryDistanceKm);
            _freeThreshold = p.FreeDeliveryThreshold is null ? null : F(p.FreeDeliveryThreshold.Value);
        }
    }

    private async Task SaveAsync()
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || string.IsNullOrWhiteSpace(_name)) return;
        _busy = true;
        var updated = await Platform.UpdateBranchAsync(orgId.Value, BranchId, new UpdateBranchRequest(
            _name.Trim(), _address1, _address2, _city, _region, _postalCode, BranchLocationUi.ToStoredCode(_countryCode), _status,
            NullableD(_latitude), NullableD(_longitude), string.IsNullOrWhiteSpace(_latitude) && string.IsNullOrWhiteSpace(_longitude),
            _contactPhone?.Trim(), _timeZoneId?.Trim()));
        if (!updated.IsSuccess) { _error = OrgWebUi.Error(updated.Error, L["Error_GenericLoad"]); _busy = false; return; }
        if (!await SaveHoursCoreAsync(orgId.Value)) { _busy = false; return; }
        var policy = await Platform.UpsertBranchDeliveryPolicyAsync(orgId.Value, BranchId,
            new UpsertBranchDeliveryPolicyRequest(D(_minimumOrder), D(_baseFee), D(_includedKm), D(_additionalPerKm), D(_maximumKm), NullableD(_freeThreshold)));
        if (!policy.IsSuccess) { _error = OrgWebUi.Error(policy.Error, L["Error_GenericLoad"]); _busy = false; return; }
        await LoadFulfillmentAsync(orgId.Value);
        _success = L["Branches_Saved"]; _busy = false;
    }

    private async Task<bool> SaveHoursCoreAsync(Guid orgId)
    {
        var days = _hours.Select(BranchHoursScheduleUi.ToDto).ToList();
        var result = await Platform.UpsertBranchOperatingHoursAsync(orgId, BranchId, new UpsertBranchOperatingHoursRequest(days));
        if (!result.IsSuccess) { _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]); return false; }
        _readiness = result.Data;
        return true;
    }

    private void OpenDayEditor(BranchHoursDayDraft day)
    {
        if (_busy) return;
        _editingDay = day;
        _dayDraft = day.Clone();
        _applyTargets = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private void CloseDayEditor()
    {
        _editingDay = null;
        _dayDraft = null;
    }

    private void DoneDayEditor()
    {
        if (_editingDay is null || _dayDraft is null) return;
        _editingDay.ApplyFrom(_dayDraft);
        if (_applyTargets.Count > 0)
        {
            BranchHoursScheduleUi.CopyToSelected(_hours, _dayDraft.DayOfWeek, _applyTargets);
        }
        CloseDayEditor();
    }

    private void SetDraftMode(string mode)
    {
        if (_dayDraft is null) return;
        _dayDraft.Mode = mode;
    }

    private void OpenCopyPanel()
    {
        _copyTargets = BranchHoursScheduleUi.DefaultCopyTargets(nameof(DayOfWeek.Monday));
        _showCopyPanel = true;
    }

    private void ToggleCopyTarget(string day, bool selected)
    {
        if (selected) _copyTargets.Add(day);
        else _copyTargets.Remove(day);
    }

    private void ToggleApplyTarget(string day, bool selected)
    {
        if (selected) _applyTargets.Add(day);
        else _applyTargets.Remove(day);
    }

    private void ApplyCopyHours()
    {
        BranchHoursScheduleUi.CopyToSelected(_hours, nameof(DayOfWeek.Monday), _copyTargets);
        _showCopyPanel = false;
    }

    private void CopyMondayToWeekdays()
    {
        BranchHoursScheduleUi.CopyToSelected(
            _hours,
            nameof(DayOfWeek.Monday),
            BranchHoursScheduleUi.DefaultCopyTargets(nameof(DayOfWeek.Monday)));
    }

    private async Task ToggleFulfillmentAsync(bool? ordering = null, bool? pickup = null, bool? delivery = null)
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null) return;
        _busy = true;
        var result = await Platform.UpdateBranchFulfillmentSettingsAsync(orgId.Value, BranchId,
            new UpdateBranchFulfillmentSettingsRequest(ordering, pickup, delivery));
        if (!result.IsSuccess) _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
        else { _readiness = result.Data; _success = L["Branches_Saved"]; }
        _busy = false;
    }

    private async Task PauseOrdersAsync(bool paused)
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null) return;
        _busy = true;
        var result = await Platform.SetBranchOnlineOrdersPausedAsync(orgId.Value, BranchId, new SetBranchOnlineOrdersPausedRequest(paused, paused ? "TooBusy" : null));
        if (!result.IsSuccess) _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
        else { _readiness = result.Data; _success = L["Branches_Saved"]; }
        _busy = false;
    }

    private void FocusDetails() => _detailsOpen = true;

    private void ToggleDetails() => _detailsOpen = !_detailsOpen;

    private void FocusHours() => _hoursOpen = true;

    private void ToggleHours() => _hoursOpen = !_hoursOpen;

    private void FocusFulfillment() => _fulfillmentOpen = true;

    private void ToggleFulfillment() => _fulfillmentOpen = !_fulfillmentOpen;

    private string DeviceStatusLabel() =>
        _deviceCount == 0 ? L["Branches_DevicesNone"] : string.Format(L["Branches_DevicesCount"].Value, _deviceCount);

    private string CompactStatus(string label) =>
        string.Equals(label, L["Branches_StatusSetupRequired"].Value, StringComparison.Ordinal)
            ? L["Branches_ChipSetupRequired"].Value
            : label;

    private string FulfillmentRowStatus() =>
        DeliveryMissingCount > 0
            ? string.Format(L["Branches_MissingShort"].Value, DeliveryMissingCount)
            : CompactStatus(FulfillmentSetupStatus());

    private string DeliveryRowStatus() =>
        DeliveryMissingCount > 0 && _readiness?.CanUseDelivery == true
            ? string.Format(L["Branches_MissingShort"].Value, DeliveryMissingCount)
            : CompactStatus(DeliveryStatus());

    private string CountryName(string code)
    {
        var localized = L[$"Branches_Country_{code}"];
        return localized.ResourceNotFound ? code : localized.Value;
    }

    private string StatusLabel(string status) => status switch
    {
        "Inactive" => L["Branches_StatusInactive"],
        "Archived" => L["Branches_StatusInactive"],
        _ => L["Branches_StatusActive"]
    };

    private string HoursStatusLabel() =>
        BranchHoursScheduleUi.HasConfiguredHours(_hours)
            ? L["Branches_StatusReady"]
            : L["Branches_StatusSetupRequired"];

    private string FulfillmentSetupStatus() => _readiness switch
    {
        { OnlineOrdersPaused: true } => L["Branches_StatusPaused"],
        { CustomerOrderingEnabled: true } => L["Branches_StatusEnabled"],
        { CustomerOrderingReady: true } => L["Branches_StatusSetupReady"],
        _ => L["Branches_StatusSetupRequired"]
    };

    private string OnlineOrdersStatus() => _readiness switch
    {
        { OnlineOrdersPaused: true } => L["Branches_StatusPaused"],
        { CustomerOrderingEnabled: true } => L["Branches_StatusEnabled"],
        { CustomerOrderingReady: true } => L["Branches_StatusSetupReady"],
        _ => L["Branches_StatusSetupRequired"]
    };

    private string PickupStatus() => _readiness switch
    {
        { PickupEnabled: true } => L["Branches_StatusEnabled"],
        { PickupReady: true } => L["Branches_StatusOff"],
        _ => L["Branches_StatusDisabled"]
    };

    private string DeliveryStatus() => _readiness switch
    {
        { CanUseDelivery: false } => L["Branches_StatusNotInPlan"],
        { DeliveryEnabled: true } => L["Branches_StatusEnabled"],
        { DeliveryReady: true } => L["Branches_StatusSetupReady"],
        _ => L["Branches_StatusSetupRequired"]
    };

    private IEnumerable<CheckItem> DeliveryChecks()
    {
        if (_readiness is null) yield break;
        var codes = (_readiness.ReasonCodes ?? Array.Empty<string>()).ToHashSet(StringComparer.Ordinal);
        yield return new CheckItem(codes.Contains("delivery_policy_incomplete"), L["Branches_CheckDistance"]);
        yield return new CheckItem(codes.Contains("branch_address_incomplete"), L["Branches_CheckAddress"]);
        yield return new CheckItem(codes.Contains("map_location_missing"), L["Branches_CheckLocation"]);
        yield return new CheckItem(codes.Contains("store_hours_missing"), L["Branches_CheckHours"]);
        yield return new CheckItem(codes.Contains("store_contact_missing"), L["Branches_CheckPhone"]);
        yield return new CheckItem(codes.Contains("delivery_policy_missing"), L["Branches_CheckPricing"]);
    }

    private string DayLabel(string day) =>
        Enum.TryParse<DayOfWeek>(day, true, out var parsed) ? L[$"Branches_Day_{parsed}"] : day;

    private string DayFullLabel(string day) =>
        Enum.TryParse<DayOfWeek>(day, true, out var parsed) ? L[$"Branches_DayFull_{parsed}"] : day;

    private string DaySummary(BranchHoursDayDraft day) =>
        BranchHoursScheduleUi.FormatSummary(
            day.IsClosed,
            day.IsOpen24Hours,
            day.OpenTime,
            day.CloseTime,
            L["Branches_Closed"],
            L["Branches_Open24h"]);

    private static int DayOrder(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => 0,
        DayOfWeek.Tuesday => 1,
        DayOfWeek.Wednesday => 2,
        DayOfWeek.Thursday => 3,
        DayOfWeek.Friday => 4,
        DayOfWeek.Saturday => 5,
        _ => 6
    };

    private static int DayOrder(string day) =>
        Enum.TryParse<DayOfWeek>(day, true, out var parsed) ? DayOrder(parsed) : 99;

    private static TimeOnly ParseChangedTime(object? value, TimeOnly fallback) =>
        value switch
        {
            TimeOnly time => time,
            DateTime dateTime => TimeOnly.FromDateTime(dateTime),
            string text => BranchHoursScheduleUi.ParseTime(text, fallback),
            _ => fallback
        };

    private static string F(decimal v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static decimal D(string? v) => decimal.TryParse(v, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var p) ? p : 0m;
    private static decimal? NullableD(string? v) => string.IsNullOrWhiteSpace(v) ? null : D(v);

    private readonly record struct CheckItem(bool Missing, string Label);
}

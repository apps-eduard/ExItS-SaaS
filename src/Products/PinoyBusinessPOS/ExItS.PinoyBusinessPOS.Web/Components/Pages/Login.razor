@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject IStringLocalizer<OrgWebResources> L
@inject Microsoft.Extensions.Options.IOptions<ExItSWebHostOptions> Hosts

<PageTitle>Sign in — Organization Admin</PageTitle>

<div class="exits-login-shell">
    <Card Class="exits-login-card" Bordered>
        <TitleTemplate>
            <div class="exits-brand">
                <span class="exits-brand-mark">OA</span>
                <span>@L["Brand"]</span>
            </div>
        </TitleTemplate>
        <Body>
            <Paragraph Type="@TextElementType.Secondary">@L["Boundary_NotPos"]</Paragraph>
            <Paragraph>Canonical ExItS sign-in is used for Organization Web. You will return here after authentication.</Paragraph>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Style="margin-bottom:1rem;" />
            }
            <a class="ant-btn ant-btn-primary ant-btn-block" href="@SignInUrl">Sign in</a>
        </Body>
    </Card>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private string? _error;
    private string SignInUrl => Hosts.Value.CanonicalLoginUrl(WebApps.Organization, "/overview");

    protected override void OnParametersSet() => _error = Error;
}

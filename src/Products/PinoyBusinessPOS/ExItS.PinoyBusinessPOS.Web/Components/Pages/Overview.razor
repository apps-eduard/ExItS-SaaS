@page "/overview"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPosReportingClient Reporting
@inject IPlatformAccessClient Platform
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Overview_Title"]</PageTitle>

@if (!Shell.CanSee("overview"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
        <ExitsPageHeader Title="@L["Overview_Title"]" Subtitle="@L["Overview_Subtitle"]" />
        <p class="org-note">@L["Boundary_NotPos"]</p>

        <OrgAlert Error="@_error" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]" OnDismissError="() => _error = null" />
        @if (!_loading && Shell.IncomingSupplierRequestCount > 0)
        {
            <Alert Type="@AlertType.Info"
                   ShowIcon="true"
                   Message="@L["Suppliers_IncomingBannerTitle"]"
                   Description="@L["Suppliers_IncomingBannerBody", Shell.IncomingSupplierRequestCount]"
                   Style="margin-bottom:12px;" />
            <div style="margin-bottom:12px;">
                <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/suppliers/requests")'>
                    @L["Suppliers_ReviewIncoming"]
                </Button>
            </div>
        }
        @if (!_loading && _overviewUnavailable && _hasCore)
        {
            <Alert Type="@AlertType.Warning"
                   ShowIcon="true"
                   Message="Sales metrics temporarily unavailable"
                   Description="Organization branch and staff counts below still reflect live management data when loaded."
                   Style="margin-bottom:12px;" />
        }
        <OrgLoading Active="_loading" />

        @if (!_loading && _hasCore)
        {
            <OrgSection Title="@L["Overview_SectionToday"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Sales" Value="@(_overview is null ? "—" : OrgWebUi.Money(_overview.TodaySalesTotal))" Hint="@(_overview is null ? null : $"{_overview.TodaySaleCount} sales")" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Cash sales" Value="@(_overview is null ? "—" : OrgWebUi.Money(_overview.TodayCashSalesTotal))" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Utang sales" Value="@(_overview is null ? "—" : OrgWebUi.Money(_overview.TodayUtangSalesTotal))" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Payments received" Value="@(_overview is null ? "—" : OrgWebUi.Money(_overview.TodayPaymentsReceived))" Unavailable="_overviewUnavailable" />
                </div>
            </OrgSection>
            <OrgSection Title="@L["Overview_SectionInventory"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Low stock" Value="@(_overview?.LowStockProductCount.ToString() ?? "—")" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Expired lots" Value="@(_overview?.ExpiredLotCount.ToString() ?? "—")" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Near expiry" Value="@(_overview?.NearExpiryLotCount.ToString() ?? "—")" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Pending transfers" Value="@(_overview?.PendingTransferCount.ToString() ?? "—")" Unavailable="_overviewUnavailable" />
                </div>
            </OrgSection>
            <OrgSection Title="@L["Overview_SectionOperations"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Open shifts" Value="@(_overview?.OpenShiftCount.ToString() ?? "—")" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Active registers" Value="@(_overview?.ActiveRegisterCount.ToString() ?? "—")" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Active branches" Value="@_activeBranches.ToString()" Unavailable="_branchesUnavailable" />
                    <OrgMetricCard Label="POS devices" Value="@_deviceCount.ToString()" Unavailable="_devicesUnavailable" />
                </div>
            </OrgSection>
            <OrgSection Title="@L["Overview_SectionBusiness"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Open Utang" Value="@(_overview is null ? "—" : OrgWebUi.Money(_overview.OpenUtangOutstanding))" Unavailable="_overviewUnavailable" />
                    <OrgMetricCard Label="Staff" Value="@_staffCount.ToString()" Unavailable="_staffUnavailable" />
                    <OrgMetricCard Label="Pending customer links" Value="@_pendingLinks.ToString()" Unavailable="_linksUnavailable" />
                    <OrgMetricCard Label="Unread alerts" Value="@Shell.UnreadNotificationCount.ToString()" />
                </div>
            </OrgSection>
            @if (_overview is not null)
            {
                <p class="org-note">Business date @_overview.BusinessDate.</p>
            }
            else if (_overviewUnavailable)
            {
                <p class="org-note">Sales and inventory metrics are temporarily unavailable. Organization management below still reflects live branch and staff counts when loaded.</p>
            }
        }
        else if (!_loading && !_hasCore && string.IsNullOrWhiteSpace(_error))
        {
            <OrgEmpty Title="@L["Overview_Title"]" Message="No organization metrics are available yet." />
        }
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private PosManagementOverviewDto? _overview;
    private int _activeBranches;
    private int _staffCount;
    private int _deviceCount;
    private int _pendingLinks;
    private bool _overviewUnavailable;
    private bool _branchesUnavailable;
    private bool _staffUnavailable;
    private bool _devicesUnavailable;
    private bool _linksUnavailable;
    private bool _hasCore;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _hasCore = false;
        _overview = null;
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || !Shell.CanSee("overview"))
        {
            _loading = false;
            return;
        }

        var overviewTask = Reporting.GetManagementOverviewAsync();
        var branchesTask = Platform.GetBranchesAsync(orgId.Value);
        var membersTask = Platform.GetOrganizationMembersAsync(orgId.Value, page: 1, pageSize: 1);
        var devicesTask = Platform.GetPosDevicesAsync(orgId.Value);
        var linksTask = Platform.GetCustomerLinkRequestStatsAsync(orgId.Value);
        var incomingTask = ConnectedSuppliers.ListRelationshipsAsync("supplier");
        await Task.WhenAll(overviewTask, branchesTask, membersTask, devicesTask, linksTask, incomingTask);

        var overview = await overviewTask;
        _overviewUnavailable = !overview.IsSuccess || overview.Data is null;
        _overview = overview.Data;

        var branches = await branchesTask;
        _branchesUnavailable = !branches.IsSuccess || branches.Data is null;
        _activeBranches = branches.Data?.Count(b => string.Equals(b.Status, "Active", StringComparison.OrdinalIgnoreCase)) ?? 0;
        var members = await membersTask;
        _staffUnavailable = !members.IsSuccess || members.Data is null;
        _staffCount = members.Data?.TotalCount ?? 0;
        var devices = await devicesTask;
        _devicesUnavailable = !devices.IsSuccess || devices.Data is null;
        _deviceCount = devices.Data?.Count(d => !string.Equals(d.Status, "Revoked", StringComparison.OrdinalIgnoreCase)) ?? 0;
        var links = await linksTask;
        _linksUnavailable = !links.IsSuccess;
        _pendingLinks = 0;
        if (links.Data?.CountsByStatus is not null)
        {
            foreach (var pair in links.Data.CountsByStatus)
            {
                if (pair.Key.Contains("Pending", StringComparison.OrdinalIgnoreCase))
                {
                    _pendingLinks += pair.Value;
                }
            }
        }

        // Core Owner workspace is usable when Platform management data or POS overview succeeds.
        _hasCore = !_overviewUnavailable || !_branchesUnavailable || !_staffUnavailable;

        var incoming = await incomingTask;
        Shell.IncomingSupplierRequestCount = incoming.IsSuccess && incoming.Data is not null
            ? incoming.Data.Count(x => string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase))
            : 0;

        if (!_hasCore)
        {
            _error = OrgWebUi.Error(
                overview.Error ?? branches.Error ?? members.Error,
                "Management overview is unavailable.");
        }

        _loading = false;
    }
}

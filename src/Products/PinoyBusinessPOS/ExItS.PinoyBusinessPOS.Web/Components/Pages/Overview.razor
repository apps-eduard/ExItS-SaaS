@page "/overview"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPosReportingClient Reporting
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Overview_Title"]</PageTitle>

@if (!Shell.CanSee("overview"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
        <ExitsPageHeader Title="@L["Overview_Title"]" Subtitle="@L["Overview_Subtitle"]" />
        <p class="org-note">@L["Boundary_NotPos"]</p>

        <OrgAlert Error="@_error" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]" OnDismissError="() => _error = null" />
        <OrgLoading Active="_loading" />

        @if (!_loading && string.IsNullOrWhiteSpace(_error) && _overview is not null)
        {
            <OrgSection Title="@L["Overview_SectionToday"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Sales" Value="@OrgWebUi.Money(_overview.TodaySalesTotal)" Hint="@($"{_overview.TodaySaleCount} sales")" />
                    <OrgMetricCard Label="Cash sales" Value="@OrgWebUi.Money(_overview.TodayCashSalesTotal)" />
                    <OrgMetricCard Label="Utang sales" Value="@OrgWebUi.Money(_overview.TodayUtangSalesTotal)" />
                    <OrgMetricCard Label="Payments received" Value="@OrgWebUi.Money(_overview.TodayPaymentsReceived)" />
                </div>
            </OrgSection>
            <OrgSection Title="@L["Overview_SectionInventory"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Low stock" Value="@_overview.LowStockProductCount.ToString()" />
                    <OrgMetricCard Label="Expired lots" Value="@_overview.ExpiredLotCount.ToString()" />
                    <OrgMetricCard Label="Near expiry" Value="@_overview.NearExpiryLotCount.ToString()" />
                    <OrgMetricCard Label="Pending transfers" Value="@_overview.PendingTransferCount.ToString()" />
                </div>
            </OrgSection>
            <OrgSection Title="@L["Overview_SectionOperations"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Open shifts" Value="@_overview.OpenShiftCount.ToString()" />
                    <OrgMetricCard Label="Active registers" Value="@_overview.ActiveRegisterCount.ToString()" />
                    <OrgMetricCard Label="Active branches" Value="@_activeBranches.ToString()" Unavailable="_branchesUnavailable" />
                    <OrgMetricCard Label="POS devices" Value="@_deviceCount.ToString()" Unavailable="_devicesUnavailable" />
                </div>
            </OrgSection>
            <OrgSection Title="@L["Overview_SectionBusiness"]">
                <div class="org-metrics">
                    <OrgMetricCard Label="Open Utang" Value="@OrgWebUi.Money(_overview.OpenUtangOutstanding)" />
                    <OrgMetricCard Label="Staff" Value="@_staffCount.ToString()" Unavailable="_staffUnavailable" />
                    <OrgMetricCard Label="Pending customer links" Value="@_pendingLinks.ToString()" />
                    <OrgMetricCard Label="Unread alerts" Value="@Shell.UnreadNotificationCount.ToString()" />
                </div>
            </OrgSection>
            <p class="org-note">Business date @_overview.BusinessDate.</p>
        }
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private PosManagementOverviewDto? _overview;
    private int _activeBranches;
    private int _staffCount;
    private int _deviceCount;
    private int _pendingLinks;
    private bool _branchesUnavailable;
    private bool _staffUnavailable;
    private bool _devicesUnavailable;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || !Shell.CanSee("overview"))
        {
            _loading = false;
            return;
        }

        var overviewTask = Reporting.GetManagementOverviewAsync();
        var branchesTask = Platform.GetBranchesAsync(orgId.Value);
        var membersTask = Platform.GetOrganizationMembersAsync(orgId.Value, page: 1, pageSize: 1);
        var devicesTask = Platform.GetPosDevicesAsync(orgId.Value);
        var linksTask = Platform.GetCustomerLinkRequestStatsAsync(orgId.Value);
        await Task.WhenAll(overviewTask, branchesTask, membersTask, devicesTask, linksTask);

        var overview = await overviewTask;
        if (!overview.IsSuccess || overview.Data is null)
        {
            _error = OrgWebUi.Error(overview.Error, "Management overview is unavailable.");
            _loading = false;
            return;
        }

        _overview = overview.Data;
        var branches = await branchesTask;
        _branchesUnavailable = !branches.IsSuccess || branches.Data is null;
        _activeBranches = branches.Data?.Count(b => string.Equals(b.Status, "Active", StringComparison.OrdinalIgnoreCase)) ?? 0;
        var members = await membersTask;
        _staffUnavailable = !members.IsSuccess || members.Data is null;
        _staffCount = members.Data?.TotalCount ?? 0;
        var devices = await devicesTask;
        _devicesUnavailable = !devices.IsSuccess || devices.Data is null;
        _deviceCount = devices.Data?.Count(d => !string.Equals(d.Status, "Revoked", StringComparison.OrdinalIgnoreCase)) ?? 0;
        var links = await linksTask;
        _pendingLinks = 0;
        if (links.Data?.CountsByStatus is not null)
        {
            foreach (var pair in links.Data.CountsByStatus)
            {
                if (pair.Key.Contains("Pending", StringComparison.OrdinalIgnoreCase))
                {
                    _pendingLinks += pair.Value;
                }
            }
        }

        _loading = false;
    }
}

@page "/notifications"
@attribute [Authorize]
@using ExItS.PinoyBusinessPOS.Application.ConnectedSuppliers
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IUtangCapabilityEvaluator Capabilities
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Notifications_Title"]</PageTitle>

@if (!Shell.CanSee("notifications"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Notifications_Title"]" Subtitle="@L["Notifications_Subtitle"]" />
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />

    <div style="margin-bottom:12px;display:flex;gap:8px;">
        <Button Type="@(_unreadOnly ? ButtonType.Primary : ButtonType.Default)"
                OnClick="() => SetFilter(true)">
            @L["Notifications_FilterUnread"]
        </Button>
        <Button Type="@(!_unreadOnly ? ButtonType.Primary : ButtonType.Default)"
                OnClick="() => SetFilter(false)">
            @L["Notifications_FilterAll"]
        </Button>
    </div>

    <OrgLoading Active="_loading" />
    @if (!_loading && Filtered.Count == 0)
    {
        <OrgEmpty Title="@L["Notifications_EmptyTitle"]" Message="@L["Notifications_EmptyMessage"]" />
    }
    else if (!_loading)
    {
        <div class="org-table-wrap">
            <table class="org-table">
                <thead><tr><th>When</th><th>Title</th><th>Preview</th><th></th></tr></thead>
                <tbody>
                    @foreach (var n in Filtered)
                    {
                        var relationship = ResolveRelationship(n);
                        <tr class="org-clickable-row" style="cursor:pointer;" @onclick="() => OpenRowAsync(n)">
                            <td>@n.CreatedAtUtc.LocalDateTime</td>
                            <td>
                                @n.Title
                                @if (!n.IsRead)
                                {
                                    <OrgStatusBadge Name="Unread" Tone="info" />
                                }
                                else if (IsSupplierRequested(n)
                                         && string.Equals(relationship?.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <OrgStatusBadge Name="@L["Notifications_ActionNeeded"]" Tone="warning" />
                                }
                            </td>
                            <td>@n.Preview</td>
                            <td @onclick:stopPropagation="true">
                                @if (IsSupplierRequested(n))
                                {
                                    @if (string.Equals(relationship?.Status, "Pending", StringComparison.OrdinalIgnoreCase)
                                         && Capabilities.IsAllowed(UtangCapability.ManageSuppliers)
                                         && relationship is not null)
                                    {
                                        <Space>
                                            <Button Type="@ButtonType.Primary"
                                                    Size="@ButtonSize.Small"
                                                    Loading="_busy"
                                                    OnClick="() => RespondAsync(n, relationship.RelationshipId, true)">
                                                @L["Notifications_Accept"]
                                            </Button>
                                            <Button Size="@ButtonSize.Small"
                                                    Loading="_busy"
                                                    OnClick="() => RespondAsync(n, relationship.RelationshipId, false)">
                                                @L["Notifications_Decline"]
                                            </Button>
                                        </Space>
                                    }
                                    else
                                    {
                                        <span>@StatusLabel(relationship?.Status)</span>
                                    }
                                }
                                else if (IsSupplierAcceptedOrDeclined(n))
                                {
                                    <Button Type="@ButtonType.Link"
                                            Size="@ButtonSize.Small"
                                            OnClick="() => OpenSupplierAsync(n)">
                                        @L["Notifications_Open"]
                                    </Button>
                                }
                                else if (!n.IsRead)
                                {
                                    <button type="button" class="ant-btn ant-btn-sm" @onclick="() => ReadAsync(n)">
                                        @L["Notifications_MarkRead"]
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
}

@code {
    private string? _error;
    private bool _loading = true;
    private bool _busy;
    private bool _unreadOnly = true;
    private List<OrganizationInAppNotificationDto> _items = [];
    private Dictionary<Guid, ConnectedSupplierRelationshipDto> _relationshipsById = new();

    private IReadOnlyList<OrganizationInAppNotificationDto> Filtered =>
        _unreadOnly
            ? _items.Where(n => !n.IsRead).ToList()
            : _items;

    protected override Task OnInitializedAsync() => LoadAsync();

    private void SetFilter(bool unreadOnly) => _unreadOnly = unreadOnly;

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null) return;
            var result = await Platform.GetOrganizationNotificationsAsync(orgId.Value);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _items = result.Data.OrderByDescending(n => n.CreatedAtUtc).ToList();
            Shell.UnreadNotificationCount = _items.Count(n => !n.IsRead);
            _error = null;

            _relationshipsById = new Dictionary<Guid, ConnectedSupplierRelationshipDto>();
            if (_items.Any(IsSupplierConnection) && Capabilities.IsAllowed(UtangCapability.ViewSuppliers))
            {
                var supplierView = await ConnectedSuppliers.ListRelationshipsAsync("supplier");
                var buyerView = await ConnectedSuppliers.ListRelationshipsAsync("buyer");
                foreach (var list in new[] { supplierView, buyerView })
                {
                    if (list.IsSuccess && list.Data is not null)
                    {
                        foreach (var row in list.Data)
                        {
                            _relationshipsById[row.RelationshipId] = row;
                        }
                    }
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private ConnectedSupplierRelationshipDto? ResolveRelationship(OrganizationInAppNotificationDto item) =>
        Guid.TryParse(item.RelatedId, out var id) && _relationshipsById.TryGetValue(id, out var relationship)
            ? relationship
            : null;

    private static bool IsSupplierConnection(OrganizationInAppNotificationDto item) =>
        SupplierConnectionNotificationTypes.IsSupplierConnection(item.RelatedType);

    private static bool IsSupplierRequested(OrganizationInAppNotificationDto item) =>
        string.Equals(item.RelatedType, SupplierConnectionNotificationTypes.Requested, StringComparison.Ordinal);

    private static bool IsSupplierAcceptedOrDeclined(OrganizationInAppNotificationDto item) =>
        string.Equals(item.RelatedType, SupplierConnectionNotificationTypes.Accepted, StringComparison.Ordinal)
        || string.Equals(item.RelatedType, SupplierConnectionNotificationTypes.Declined, StringComparison.Ordinal);

    private string StatusLabel(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase)
            ? L["Notifications_StatusConnected"]
            : string.Equals(status, "Declined", StringComparison.OrdinalIgnoreCase)
                ? L["Notifications_StatusDeclined"]
                : string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase)
                    ? L["Notifications_ActionNeeded"]
                    : L["Notifications_StatusUnavailable"];

    private async Task OpenRowAsync(OrganizationInAppNotificationDto note)
    {
        if (IsSupplierRequested(note))
        {
            await MarkReadOptimisticAsync(note);
            return;
        }

        if (IsSupplierAcceptedOrDeclined(note))
        {
            await OpenSupplierAsync(note);
            return;
        }

        await MarkReadOptimisticAsync(note);
        if (note.RelatedType.Contains("CustomerLink", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/customers");
        }
    }

    private async Task RespondAsync(OrganizationInAppNotificationDto note, Guid relationshipId, bool accept)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageSuppliers) || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = accept
                ? await ConnectedSuppliers.ApproveAsync(relationshipId, new RespondConnectionRequest())
                : await ConnectedSuppliers.DeclineAsync(relationshipId, new RespondConnectionRequest());
            if (!result.IsSuccess)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            await MarkReadOptimisticAsync(note);
            if (!string.IsNullOrWhiteSpace(note.RelatedType) && !string.IsNullOrWhiteSpace(note.RelatedId))
            {
                var orgId = CurrentUser.Session?.OrganizationId;
                if (orgId is not null)
                {
                    await Platform.MarkRelatedOrganizationNotificationsReadAsync(
                        orgId.Value, note.RelatedType, note.RelatedId);
                }
            }

            await LoadAsync();
            if (accept)
            {
                Nav.NavigateTo("/suppliers/buyers");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenSupplierAsync(OrganizationInAppNotificationDto note)
    {
        await MarkReadOptimisticAsync(note);
        // Buyer-side Accepted/Declined → suppliers list (domain source of truth).
        Nav.NavigateTo("/suppliers");
    }

    private async Task ReadAsync(OrganizationInAppNotificationDto note) => await MarkReadOptimisticAsync(note);

    private async Task MarkReadOptimisticAsync(OrganizationInAppNotificationDto note)
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || note.IsRead)
        {
            return;
        }

        var result = await Platform.MarkOrganizationNotificationReadAsync(orgId.Value, note.Id);
        if (!result.IsSuccess)
        {
            _error = OrgWebUi.Error(result.Error);
            return;
        }

        ApplyLocalRead(note.Id);
        Shell.UnreadNotificationCount = _items.Count(n => !n.IsRead);
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyLocalRead(Guid notificationId)
    {
        _items = _items
            .Select(n => n.Id == notificationId
                ? n with { IsRead = true, ReadAtUtc = DateTimeOffset.UtcNow }
                : n)
            .OrderByDescending(n => n.CreatedAtUtc)
            .ToList();
    }
}

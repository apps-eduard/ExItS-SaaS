@page "/notifications"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Notifications_Title"]</PageTitle>

@if (!Shell.CanSee("notifications"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Notifications_Title"]" Subtitle="@L["Notifications_Subtitle"]" />
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _items.Count == 0)
    {
        <OrgEmpty Title="@L["Notifications_EmptyTitle"]" Message="@L["Notifications_EmptyMessage"]" />
    }
    else if (!_loading)
    {
        <div class="org-table-wrap">
            <table class="org-table">
                <thead><tr><th>When</th><th>Title</th><th>Preview</th><th></th></tr></thead>
                <tbody>
                    @foreach (var n in _items)
                    {
                        <tr>
                            <td>@n.CreatedAtUtc.LocalDateTime</td>
                            <td>@n.Title @if (!n.IsRead) { <OrgStatusBadge Text="Unread" Tone="info" /> }</td>
                            <td>@n.Preview</td>
                            <td>
                                @if (!n.IsRead)
                                {
                                    <button type="button" class="ant-btn ant-btn-sm" @onclick="() => ReadAsync(n)">Mark read</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
}

@code {
    private string? _error;
    private bool _loading = true;
    private List<OrganizationInAppNotificationDto> _items = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null) return;
            var result = await Platform.GetOrganizationNotificationsAsync(orgId.Value);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _items = result.Data.ToList();
            Shell.UnreadNotificationCount = _items.Count(n => !n.IsRead);
            _error = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReadAsync(OrganizationInAppNotificationDto note)
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null) return;
        var result = await Platform.MarkOrganizationNotificationReadAsync(orgId.Value, note.Id);
        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            _error = OrgWebUi.Error(result.Error);
        }
    }
}

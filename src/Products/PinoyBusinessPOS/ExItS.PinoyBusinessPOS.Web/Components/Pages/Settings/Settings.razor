@page "/settings"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosOperationalSetupClient Setup

<PageTitle>Settings</PageTitle>

@if (!Shell.CanSee("settings"))
{
    <AccessDeniedPanel />
}
else
{
    <ExitsPageHeader Title="Settings" Subtitle="Organization POS and cash-handling configuration. Changes apply to future shifts." />
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" />
    }
    @if (!string.IsNullOrWhiteSpace(_ok))
    {
        <Alert Type="@AlertType.Success" Message="@_ok" ShowIcon="true" />
    }
    @if (_dto is not null)
    {
        <Card Size="@CardSize.Small" Title="General / POS">
            <div class="org-form">
                <ExitsField Label="Store display name"><Input @bind-Value="_store" /></ExitsField>
                <ExitsField Label="Currency"><Input @bind-Value="_currency" /></ExitsField>
                <ExitsField Label="Tax mode"><Input @bind-Value="_taxMode" /></ExitsField>
                <ExitsField Label="Tax rate %"><Input @bind-Value="_taxRate" /></ExitsField>
                <ExitsField Label="Receipt header"><Input @bind-Value="_header" /></ExitsField>
                <ExitsField Label="Receipt footer"><Input @bind-Value="_footer" /></ExitsField>
                <ExitsField Label="Business address"><Input @bind-Value="_address" /></ExitsField>
                <ExitsField Label="Contact phone"><Input @bind-Value="_phone" /></ExitsField>
            </div>
        </Card>
        <Card Size="@CardSize.Small" Title="Cash handling">
            <p class="org-note">Cash Count Policy. Changes apply to the next shift. An already-open shift keeps the policy it started with.</p>
            <label>
                Cash Count Policy
                <select @bind="_cashCount">
                    <option value="Required">Required — Recommended. Cashiers must count physical drawer cash when opening and closing shifts.</option>
                    <option value="Optional">Optional. Cashiers may count physical cash or skip the count.</option>
                </select>
            </label>
            <p class="org-note">Denomination breakdown is a counting helper. The Cash Count total remains the authoritative accounting value.</p>
            <table class="org-table">
                <thead>
                    <tr>
                        <th>Value</th>
                        <th>Enabled</th>
                        <th>Order</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var denom in _denominations)
                    {
                        <tr>
                            <td>PHP @denom.Value.ToString("N2")</td>
                            <td><Checkbox Checked="@denom.IsEnabled" CheckedChanged="v => ToggleDenominationAsync(denom, v)" Disabled="@(!CanManage)" /></td>
                            <td>@denom.SortOrder</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (CanManage)
            {
                <div class="org-form">
                    <ExitsField Label="Add denomination">
                        <Input @bind-Value="_newDenomination" Placeholder="5000" />
                    </ExitsField>
                    <Button Type="@ButtonType.Default" Loading="_denomBusy" OnClick="AddDenominationAsync">Add denomination</Button>
                </div>
            }
        </Card>
        @if (CanManage)
        {
            <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="SaveAsync">Save settings</Button>
        }
        else
        {
            <p class="org-note">You can view these settings but cannot change them.</p>
        }
    }
}

@code {
    private bool _busy;
    private bool _denomBusy;
    private string? _error;
    private string? _ok;
    private PosOperationalSetupDto? _dto;
    private string? _store;
    private string? _currency;
    private string? _taxMode;
    private string? _taxRate;
    private string? _header;
    private string? _footer;
    private string? _address;
    private string? _phone;
    private string _cashCount = "Required";
    private string? _newDenomination;
    private List<OrganizationCashDenominationDto> _denominations = [];

    private bool CanManage => Shell.Can(UtangCapability.ManageOperationalSetup) || Shell.IsOrgOwner;

    protected override async Task OnInitializedAsync()
    {
        var result = await Setup.GetAsync();
        if (!result.IsSuccess || result.Data is null)
        {
            _error = OrgWebUi.Error(result.Error);
            return;
        }

        Apply(result.Data);
        await LoadDenominationsAsync();
    }

    private void Apply(PosOperationalSetupDto dto)
    {
        _dto = dto;
        _store = dto.StoreDisplayName;
        _currency = dto.CurrencyCode;
        _taxMode = dto.TaxPricingMode;
        _taxRate = dto.TaxRatePercent.ToString("0.##");
        _header = dto.ReceiptHeader;
        _footer = dto.ReceiptFooter;
        _address = dto.BusinessAddress;
        _phone = dto.ContactPhone;
        _cashCount = string.Equals(dto.CashCountMode, "Off", StringComparison.OrdinalIgnoreCase)
            ? "Optional"
            : string.IsNullOrWhiteSpace(dto.CashCountMode) ? "Required" : dto.CashCountMode;
    }

    private async Task LoadDenominationsAsync()
    {
        var result = await Setup.ListCashDenominationsAsync();
        if (result.IsSuccess && result.Data is not null)
        {
            _denominations = result.Data.OrderBy(d => d.SortOrder).ThenBy(d => d.Value).ToList();
        }
    }

    private Task ToggleDenominationAsync(OrganizationCashDenominationDto denom, bool enabled) =>
        SaveDenominationsAsync(_denominations.Select(d => new CashDenominationWriteDto(
            d.Value,
            d.DenominationId == denom.DenominationId ? enabled : d.IsEnabled,
            d.SortOrder,
            d.DisplayLabel,
            d.DenominationId)).ToList());

    private async Task AddDenominationAsync()
    {
        if (!decimal.TryParse(_newDenomination, out var value) || value <= 0)
        {
            _error = "Denomination value must be greater than zero.";
            return;
        }

        var items = _denominations
            .Select(d => new CashDenominationWriteDto(d.Value, d.IsEnabled, d.SortOrder, d.DisplayLabel, d.DenominationId))
            .ToList();
        items.Add(new CashDenominationWriteDto(value, true, items.Count));
        await SaveDenominationsAsync(items);
        _newDenomination = null;
    }

    private async Task SaveDenominationsAsync(IReadOnlyList<CashDenominationWriteDto> items)
    {
        if (!CanManage)
        {
            return;
        }

        _denomBusy = true;
        try
        {
            var result = await Setup.ReplaceCashDenominationsAsync(new ReplaceCashDenominationsRequest(items));
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _denominations = result.Data.OrderBy(d => d.SortOrder).ThenBy(d => d.Value).ToList();
            _error = null;
            _ok = "Denominations saved.";
        }
        finally
        {
            _denomBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_dto is null || string.IsNullOrWhiteSpace(_store) || !decimal.TryParse(_taxRate, out var rate))
        {
            _error = "Store name and tax rate are required.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Setup.UpdateAsync(new UpdateOperationalSetupRequest(
                _store.Trim(),
                string.IsNullOrWhiteSpace(_currency) ? "PHP" : _currency.Trim(),
                string.IsNullOrWhiteSpace(_taxMode) ? "TaxExclusive" : _taxMode.Trim(),
                rate,
                _dto.UpdatedAtUtc,
                _header,
                _footer,
                _address,
                _phone,
                _cashCount));
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            Apply(result.Data);
            _error = null;
            _ok = "Settings saved for future shifts.";
        }
        finally
        {
            _busy = false;
        }
    }
}

@page "/account/subscription"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Subscription_Title"]</PageTitle>

@if (!Shell.CanSee("subscription"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Subscription_Title"]" Subtitle="@L["Subscription_Subtitle"]" />
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _sub is not null)
    {
        <div class="org-metrics">
            <OrgMetricCard Label="Plan" Value="@(_sub.PlanDisplayName ?? _sub.PlanKey ?? "—")" />
            <OrgMetricCard Label="Status" Value="@_sub.Status" />
            <OrgMetricCard Label="Period end" Value="@(_sub.CurrentPeriodEndUtc?.LocalDateTime.ToString("d") ?? "—")" />
        </div>
    }
    else if (!_loading && string.IsNullOrWhiteSpace(_error))
    {
        <OrgEmpty Title="@L["Common_Unavailable"]" Message="@L["Error_GenericLoad"]" />
    }
    @if (!_loading && _entitlement is not null)
    {
        <p class="org-note">Entitlement @_entitlement.PlanCode v@_entitlement.SnapshotVersion · @_entitlement.SubscriptionStatus · expires @_entitlement.ExpiresAtUtc</p>
    }
    @if (CurrentUser.Session?.EnabledFeatureCodes is { Count: > 0 } features)
    {
        <Card Size="@CardSize.Small" Title="Active features">
            <ul>
                @foreach (var featureCode in features)
                {
                    <li>@featureCode</li>
                }
            </ul>
        </Card>
    }
    </div>
}

@code {
    private string? _error;
    private bool _loading = true;
    private PlatformSubscriptionDto? _sub;
    private PlatformEntitlementSnapshotDto? _entitlement;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null) return;
            var sub = await Platform.GetCurrentSubscriptionAsync(orgId.Value, PosProductCodes.PinoyBusinessPos);
            var ent = await Platform.GetLatestEntitlementAsync(orgId.Value, PosProductCodes.PinoyBusinessPos);
            _sub = sub.Data;
            _entitlement = ent.Data;
            _error = !sub.IsSuccess && !ent.IsSuccess ? OrgWebUi.Error(sub.Error) : null;
        }
        finally
        {
            _loading = false;
        }
    }
}

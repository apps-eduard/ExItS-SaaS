@page "/staff/roles"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosPermissionClient Permissions
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Roles_Title"]</PageTitle>

@if (!Shell.CanSee("roles"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
        <ExitsPageHeader Title="@L["Roles_Title"]" Subtitle="@L["Roles_Subtitle"]" />
        <p class="org-note">Permissions are enforced on the server. Navigation reflects the sections available to the signed-in user.</p>

        <OrgAlert Error="@_error" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]" OnDismissError="() => _error = null" />
        <OrgLoading Active="_loading" />

        @if (!_loading && string.IsNullOrWhiteSpace(_error) && _roles.Count == 0)
        {
            <OrgEmpty Title="No roles available" Message="No POS roles are currently available for this organization." />
        }
        else if (!_loading && _roles.Count > 0)
        {
        <div class="org-table-wrap">
            <table class="org-table">
                <thead>
                    <tr><th>Role</th><th>Display</th></tr>
                </thead>
                <tbody>
                    @foreach (var role in _roles)
                    {
                        <tr>
                            <td>@role.Role</td>
                            <td>@role.DisplayName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <ul class="org-note">
            <li>Owner / Admin — full management including staff and settings</li>
            <li>Store Manager — catalog, inventory, reports (cannot manage permissions)</li>
            <li>Cashier — selling on POS only; not Organization Web checkout</li>
            <li>Inventory Staff — stock, transfers, lots</li>
            <li>Reporting User — reports without operational selling</li>
        </ul>
        }
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<PosRoleDto> _roles = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await Permissions.ListRolesAsync();
        if (result.IsSuccess && result.Data is not null)
        {
            _roles = result.Data.ToList();
        }
        else
        {
            _error = OrgWebUi.Error(result.Error);
        }
        _loading = false;
    }
}

@page "/staff/{MembershipId:guid}"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IPosPermissionClient Permissions
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Staff_Title"]</PageTitle>

@if (!Shell.CanSee("staff"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page org-page--narrow">
        <ExitsPageHeader Title="@L["Staff_Title"]" Subtitle="@L["Staff_Subtitle"]" />
        <OrgAlert Error="@_error" Success="@_ok" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]"
                  OnDismissError="() => _error = null" OnDismissSuccess="() => _ok = null" />
        <OrgLoading Active="_loading" />

        @if (!_loading && _member is not null)
        {
            <OrgSection Title="@(_member.DisplayName ?? _member.Username ?? L["Staff_Title"].Value)">
                <p class="org-note">
                    Organization role: @_member.Role ·
                    <OrgStatusBadge Text="@_member.Status" Tone="@_member.Status" /> ·
                    Contact: @_member.Email
                </p>
            </OrgSection>

            <Card Size="@CardSize.Small" Title="POS role">
                <p class="org-note">Choose one of the system-defined roles for this staff member.</p>
                <select @bind="_posRole">
                    <option value="Cashier">Cashier</option>
                    <option value="InventoryStaff">Inventory Staff</option>
                    <option value="ReportingUser">Reporting User</option>
                    <option value="StoreManager">Store Manager</option>
                    <option value="Admin">Admin</option>
                    <option value="Owner">Owner</option>
                </select>
                <Button Loading="_busy" OnClick="AssignPosRoleAsync">Assign POS role</Button>
                @if (_assignment is not null)
                {
                    <p class="org-note">Current: @_assignment.RoleDisplayName <OrgStatusBadge Text="@_assignment.Status" Tone="@_assignment.Status" /></p>
                    <Button Danger="true" Loading="_busy" OnClick="RevokePosRoleAsync">Revoke POS role</Button>
                }
            </Card>

            <Card Size="@CardSize.Small" Title="@L["Staff_BranchesTitle"]">
                @if (_member is not null && UsesExplicitBranchAssignments(_member.Role))
                {
                    @if (_branchAssignments.Count == 0 && !_branchesLoading)
                    {
                        <p class="org-note">@L["Staff_BranchesNone"]</p>
                    }
                    else
                    {
                        <div class="org-branch-matrix">
                            @foreach (var branch in _orgBranches)
                            {
                                var selected = _selectedBranchIds.Contains(branch.Id);
                                <label class="org-branch-matrix__row">
                                    <input type="checkbox"
                                           checked="@selected"
                                           disabled="@_busy"
                                           @onchange="e => ToggleBranch(branch.Id, e)" />
                                    <span class="org-branch-matrix__name">@branch.Name</span>
                                    @if (branch.IsPrimary)
                                    {
                                        <span class="org-branch-matrix__tag">@L["Staff_BranchPrimary"]</span>
                                    }
                                </label>
                            }
                        </div>
                        <Button Loading="_busy" OnClick="SaveBranchAssignmentsAsync">@L["Staff_BranchesSave"]</Button>
                    }
                }
                else
                {
                    <p class="org-note">@L["Staff_BranchesAll"]</p>
                }
            </Card>

            <Card Size="@CardSize.Small" Title="Membership">
                @if (string.Equals(_member.Status, "Active", StringComparison.OrdinalIgnoreCase))
                {
                    <Button Danger="true" Loading="_busy" OnClick="SuspendAsync">Deactivate</Button>
                }
                else
                {
                    <Button Loading="_busy" OnClick="ReactivateAsync">Reactivate</Button>
                }
            </Card>
        }
    </div>
}

@code {
    [Parameter] public Guid MembershipId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _ok;
    private string _posRole = "Cashier";
    private PlatformMembershipDto? _member;
    private PosRoleAssignmentDto? _assignment;
    private IReadOnlyList<OrganizationBranchDto> _orgBranches = [];
    private IReadOnlyList<MembershipBranchAssignmentDto> _branchAssignments = [];
    private HashSet<Guid> _selectedBranchIds = [];
    private bool _branchesLoading;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            _error = L["Error_SessionExpired"];
            _loading = false;
            return;
        }

        var members = await Platform.GetOrganizationMembersAsync(orgId.Value, 1, 100);
        if (!members.IsSuccess || members.Data is null)
        {
            _error = OrgWebUi.Error(members.Error, L["Error_GenericLoad"]);
            _loading = false;
            return;
        }

        _member = members.Data?.Items.FirstOrDefault(m => m.Id == MembershipId);
        if (_member is null)
        {
            _error = "Staff membership was not found in this organization.";
            _loading = false;
            return;
        }

        var roles = await Permissions.ListAssignmentsAsync(status: "Active", actorId: _member.UserId, page: 1, pageSize: 20);
        _assignment = roles.Data?.Items.FirstOrDefault();
        if (_assignment is not null)
        {
            _posRole = _assignment.Role;
        }

        await LoadBranchAssignmentsAsync(orgId.Value);
        _loading = false;
    }

    private async Task LoadBranchAssignmentsAsync(Guid orgId)
    {
        if (_member is null || !UsesExplicitBranchAssignments(_member.Role))
        {
            return;
        }

        _branchesLoading = true;
        var branches = await Platform.GetBranchesAsync(orgId);
        _orgBranches = branches.IsSuccess && branches.Data is not null
            ? branches.Data
                .Where(b => string.Equals(b.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(b => b.IsPrimary)
                .ThenBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                .ToList()
            : [];

        var assignments = await Platform.GetMembershipBranchAssignmentsAsync(orgId, MembershipId);
        _branchAssignments = assignments.IsSuccess && assignments.Data is not null
            ? assignments.Data.Branches
            : [];
        _selectedBranchIds = _branchAssignments.Select(b => b.BranchId).ToHashSet();
        _branchesLoading = false;
    }

    private static bool UsesExplicitBranchAssignments(string? role) =>
        string.Equals(role, "OrganizationMember", StringComparison.OrdinalIgnoreCase)
        || string.Equals(role, "Member", StringComparison.OrdinalIgnoreCase);

    private void ToggleBranch(Guid branchId, ChangeEventArgs e)
    {
        var selected = e.Value is bool on && on;
        if (selected)
        {
            _selectedBranchIds.Add(branchId);
        }
        else
        {
            _selectedBranchIds.Remove(branchId);
        }
    }

    private async Task SaveBranchAssignmentsAsync()
    {
        if (_member is null || CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            return;
        }

        if (_selectedBranchIds.Count == 0)
        {
            _error = L["Staff_BranchesRequired"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Platform.SetMembershipBranchAssignmentsAsync(
                orgId,
                MembershipId,
                new SetMembershipBranchAssignmentsRequest("Explicit", _selectedBranchIds.ToList()));
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error, L["Staff_BranchesSaveFailed"]);
            _ok = result.IsSuccess ? L["Staff_BranchesSaved"] : null;
            if (result.IsSuccess && result.Data is not null)
            {
                _branchAssignments = result.Data.Branches;
                _selectedBranchIds = result.Data.Branches.Select(b => b.BranchId).ToHashSet();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AssignPosRoleAsync()
    {
        if (_member is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Permissions.AssignAsync(new AssignPosRoleRequest(_member.UserId, _posRole));
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            _ok = result.IsSuccess ? "POS role assigned." : null;
            _assignment = result.Data;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokePosRoleAsync()
    {
        if (_assignment is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Permissions.RevokeAsync(_assignment.AssignmentId, new RevokePosRoleRequest("Revoked from Organization Admin"));
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                _assignment = null;
                _ok = "POS role revoked.";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SuspendAsync()
    {
        _busy = true;
        try
        {
            var result = await Platform.SuspendMembershipAsync(MembershipId, new PlatformMembershipLifecycleRequest("Deactivated from Organization Admin"));
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                _member = result.Data;
                _ok = "Membership deactivated.";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReactivateAsync()
    {
        _busy = true;
        try
        {
            var result = await Platform.ReactivateMembershipAsync(MembershipId, new PlatformMembershipLifecycleRequest("Reactivated from Organization Admin"));
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                _member = result.Data;
                _ok = "Membership reactivated.";
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

@page "/staff/invite"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["StaffInvite_Title"]</PageTitle>

@if (!Shell.CanSee("staff"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page org-page--narrow">
        <ExitsPageHeader Title="@L["StaffInvite_Title"]" Subtitle="@L["StaffInvite_Subtitle"]" />
        <p class="org-note">The invitee sets a password for a separate staff login. You can assign or change the POS role later.</p>
        <OrgAlert Error="@(_errors.Count == 0 ? null : string.Join(" ", _errors))" OnDismissError="() => _errors = []" />
        <div class="org-form">
            <ExitsField Label="Contact email"><Input @bind-Value="_email" /></ExitsField>
            <ExitsField Label="Display name"><Input @bind-Value="_displayName" /></ExitsField>
            <label>
                POS role (optional)
                <select @bind="_productRole">
                    <option value="">Assign later</option>
                    <option value="Cashier">Cashier</option>
                    <option value="InventoryStaff">Inventory Staff</option>
                    <option value="ReportingUser">Reporting User</option>
                    <option value="StoreManager">Store Manager</option>
                    <option value="Admin">Admin</option>
                </select>
            </label>
            <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="InviteAsync">Send invite</Button>
        </div>
    </div>
}

@code {
    private bool _busy;
    private string? _email;
    private string? _displayName;
    private string? _productRole;
    private List<string> _errors = [];

    private async Task InviteAsync()
    {
        _errors = [];
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || string.IsNullOrWhiteSpace(_email))
        {
            _errors.Add("Contact email is required.");
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.CreateOrganizationInvitationAsync(
                orgId.Value,
                new CreateInvitationRequest(
                    Email: _email.Trim(),
                    Role: "OrganizationMember",
                    DisplayName: string.IsNullOrWhiteSpace(_displayName) ? null : _displayName.Trim(),
                    ProductRole: string.IsNullOrWhiteSpace(_productRole) ? null : _productRole));
            if (!result.IsSuccess)
            {
                _errors.Add(OrgWebUi.Error(result.Error, "Invite failed."));
                return;
            }

            Nav.NavigateTo("/staff");
        }
        finally
        {
            _busy = false;
        }
    }
}

@page "/inventory/lots"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosInventoryClient Inventory
@inject IPlatformAccessClient Platform
@inject ICurrentUserContext CurrentUser

<PageTitle>Expiration lots</PageTitle>

@if (!Shell.CanSee("inventory"))
{
    <AccessDeniedPanel />
}
else
{
    <PageHeader Title="Expiration / lots" Subtitle="On-hand lots only. Expired inventory is not sellable stock." />
    <div class="org-toolbar">
        <select @bind="_window">
            <option value="Expired">Expired</option>
            <option value="Days7">7 days</option>
            <option value="Days14">14 days</option>
            <option value="Days30">30 days</option>
            <option value="Custom">Custom</option>
        </select>
        <TextInput Label="From" @bind-Value="_from" Placeholder="yyyy-MM-dd" />
        <TextInput Label="To" @bind-Value="_to" Placeholder="yyyy-MM-dd" />
        <select @bind="_branchId">
            <option value="">All branches</option>
            @foreach (var b in _branches)
            {
                <option value="@b.Id">@b.Name</option>
            }
        </select>
        <TextInput Label="Search" @bind-Value="_search" />
        <Button OnClick="SearchAsync">Filter</Button>
    </div>
    @if (_result is not null)
    {
        <p class="org-note">Expired @_result.ExpiredCount · Near expiry @_result.NearExpiryCount (page totals from server).</p>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <Alert Tone="AlertTone.Danger" Message="@_error" />
    }
    <div class="org-table-wrap">
        <table class="org-table">
            <thead>
                <tr><th>Product</th><th>SKU</th><th>Lot</th><th>Expiry</th><th>Qty</th><th>Status</th></tr>
            </thead>
            <tbody>
                @if (_result is not null)
                {
                    @foreach (var lot in _result.Items)
                    {
                        <tr>
                            <td>@lot.ProductName</td>
                            <td>@lot.Sku</td>
                            <td>@lot.LotNumber</td>
                            <td>@lot.ExpirationDate</td>
                            <td>@lot.QuantityOnHand</td>
                            <td><span class="org-badge">@lot.ExpiryStatus</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <OrgPager Page="_page" PageSize="20" TotalCount="@(_result?.TotalCount ?? 0)" PageChanged="ChangePageAsync" />
}

@code {
    private string? _error;
    private string _window = "Days7";
    private string? _from;
    private string? _to;
    private string? _branchId;
    private string? _search;
    private int _page = 1;
    private PosExpiringLotPagedResult? _result;
    private List<OrganizationBranchDto> _branches = [];

    protected override async Task OnInitializedAsync()
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is not null)
        {
            var branches = await Platform.GetBranchesAsync(orgId.Value);
            _branches = branches.Data?.ToList() ?? [];
        }

        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Guid? branch = Guid.TryParse(_branchId, out var id) ? id : null;
        DateOnly? from = DateOnly.TryParse(_from, out var f) ? f : null;
        DateOnly? to = DateOnly.TryParse(_to, out var t) ? t : null;
        var result = await Inventory.ListExpiringLotsAsync(_window, from, to, branch, _search, _page, 20);
        if (!result.IsSuccess)
        {
            _error = OrgWebUi.Error(result.Error);
            return;
        }

        _result = result.Data;
        _error = null;
    }
}

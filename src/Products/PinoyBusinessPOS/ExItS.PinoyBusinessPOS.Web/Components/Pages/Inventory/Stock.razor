@page "/inventory"
@page "/inventory/{ProductId:guid}"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosInventoryClient Inventory
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Stock_Title"]</PageTitle>

@if (!Shell.CanSee("inventory"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Stock_Title"]" Subtitle="@L["Stock_Subtitle"]" />
    <div class="org-subnav">
        <a href="/inventory">Stock on hand</a>
        <a href="/inventory/transfers">Transfers</a>
        <a href="/inventory/lots">Expiration</a>
    </div>
    <p class="org-note">Inventory is for viewing and controlling stock you already have. To buy or receive goods, use Purchasing on POS (Receive stock, Purchase orders, Goods receipts).</p>
    <div class="org-toolbar">
        <ExitsField Label="Search"><Input @bind-Value="_search" /></ExitsField>
        <label><input type="checkbox" @bind="_lowStock" /> Low stock</label>
        <Button OnClick="SearchAsync">Filter</Button>
    </div>
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _items.Count == 0)
    {
        <OrgEmpty Title="@L["Stock_EmptyTitle"]" Message="@L["Stock_EmptyMessage"]" />
    }
    else if (!_loading)
    {
    <div class="org-table-wrap">
        <table class="org-table">
            <thead>
                <tr><th>Product</th><th>On hand</th><th>Sellable</th><th>Expired</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var row in _items)
                {
                    <tr>
                        <td>@row.Name</td>
                        <td>@row.OnHandQuantity</td>
                        <td>@(row.SellableQuantity?.ToString("N2") ?? "—")</td>
                        <td>@(row.ExpiredQuantity?.ToString("N2") ?? "—")</td>
                        <td><OrgStatusBadge Text="@(row.IsLowStock ? $"{row.StockStatus} · low" : row.StockStatus)" Tone="@(row.IsLowStock ? "warning" : row.StockStatus)" /></td>
                        <td><a href="@($"/inventory/{row.ProductId:D}")">Adjust / history</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <OrgPager Page="_page" PageSize="20" TotalCount="_total" Busy="_busy" PageChanged="ChangePageAsync" />
    }

    @if (_detail is not null)
    {
        <Card Size="@CardSize.Small" Title="@($"Adjust {_detail.Name}")">
            <p class="org-note">Direction Receive stock / Stock out creates a stock movement. Quantity overwrite is not allowed. Stock increases when you confirm a Receive stock adjustment.</p>
            @if (Shell.Can(UtangCapability.ManageInventory))
            {
                <div class="org-form">
                    <select @bind="_direction">
                        <option value="In">Receive stock</option>
                        <option value="Out">Stock out</option>
                    </select>
                    <ExitsField Label="Quantity"><Input @bind-Value="_qty" /></ExitsField>
                    <ExitsField Label="Remarks"><Input @bind-Value="_reason" /></ExitsField>
                    @if (_detail.TracksExpiration)
                    {
                        <ExitsField Label="Lot number"><Input @bind-Value="_lot" /></ExitsField>
                        <ExitsField Label="Expiry (yyyy-MM-dd)"><Input @bind-Value="_expiry" /></ExitsField>
                    }
                    <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="AdjustAsync">Record adjustment</Button>
                </div>
            }
            <h3>Recent movements</h3>
            <div class="org-table-wrap">
                <table class="org-table">
                    <thead>
                        <tr><th>When</th><th>Type</th><th>Qty</th><th>Remarks</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _movements)
                        {
                            <tr>
                                <td>@m.RecordedAtUtc.LocalDateTime</td>
                                <td>@StockMovementPresentation.ToFriendlyLabel(m.MovementType)</td>
                                <td>@m.QuantityEffect.ToString("+0.###;-0.###")</td>
                                <td>@m.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
    }
    </div>
}

@code {
    [Parameter] public Guid ProductId { get; set; }

    private bool _busy;
    private bool _loading = true;
    private string? _error;
    private string? _search;
    private bool _lowStock;
    private int _page = 1;
    private int _total;
    private List<PosInventoryAccountDto> _items = [];
    private PosInventoryAccountDto? _detail;
    private List<PosStockMovementDto> _movements = [];
    private string _direction = "In";
    private string? _qty;
    private string? _reason;
    private string? _lot;
    private string? _expiry;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var list = await Inventory.ListAsync(_search, tracked: true, lowStock: _lowStock ? true : null, page: _page, pageSize: 20);
            if (!list.IsSuccess || list.Data is null)
            {
                _error = OrgWebUi.Error(list.Error);
                return;
            }

            _items = list.Data.Items;
            _total = list.Data.TotalCount;
            _error = null;

            if (ProductId != Guid.Empty)
            {
                var detail = await Inventory.GetAsync(ProductId);
                _detail = detail.Data;
                var moves = await Inventory.ListMovementsAsync(ProductId, page: 1, pageSize: 20);
                _movements = moves.Data?.Items ?? [];
            }
            else
            {
                _detail = null;
                _movements = [];
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AdjustAsync()
    {
        if (_detail is null || !decimal.TryParse(_qty, out var qty) || string.IsNullOrWhiteSpace(_reason))
        {
            _error = "Quantity and remarks are required.";
            return;
        }

        DateOnly? expiry = DateOnly.TryParse(_expiry, out var d) ? d : null;
        _busy = true;
        try
        {
            var result = await Inventory.AdjustAsync(
                _detail.ProductId,
                new AdjustInventoryRequest(_direction, qty, _reason.Trim(), LotNumber: _lot, ExpirationDate: expiry));
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                _qty = _reason = _lot = _expiry = null;
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

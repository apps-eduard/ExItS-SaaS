@page "/suppliers"
@page "/suppliers/requests"
@page "/suppliers/buyers"
@page "/suppliers/buyers/{RelationshipId:guid}"
@attribute [Authorize]
@using ExItS.PinoyBusinessPOS.Application.ConnectedSuppliers
@using ExItS.PinoyBusinessPOS.Application.Suppliers
@inject OrgWebShellState Shell
@inject IPosSupplierClient SupplierApi
@inject IPosConnectedSupplierClient ConnectedApi
@inject IUtangCapabilityEvaluator Capabilities
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Suppliers_Title"]</PageTitle>

@if (!Shell.CanSee("suppliers"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
        <ExitsPageHeader Title="@L["Suppliers_Title"]" Subtitle="@L["Suppliers_Subtitle"]" />

        <div class="org-toolbar">
            <Space>
                <Button Type="@(_tab == "list" ? ButtonType.Primary : ButtonType.Default)" OnClick='() => SwitchTab("list")'>
                    @L["Suppliers_TabList"]
                </Button>
                <Button Type="@(_tab == "requests" ? ButtonType.Primary : ButtonType.Default)" OnClick='() => SwitchTab("requests")'>
                    @L["Suppliers_TabRequests"]
                    @if (_incomingPending.Count > 0)
                    {
                        <span> (@_incomingPending.Count)</span>
                    }
                </Button>
                <Button Type="@(_tab == "buyers" ? ButtonType.Primary : ButtonType.Default)" OnClick='() => SwitchTab("buyers")'>
                    @L["Suppliers_TabBuyers"]
                    @if (_connectedBuyers.Count > 0)
                    {
                        <span> (@_connectedBuyers.Count)</span>
                    }
                </Button>
                @if (Capabilities.IsAllowed(UtangCapability.ManageSuppliers))
                {
                    <Button OnClick='() => Nav.NavigateTo("/suppliers/connect")'>@L["Suppliers_ConnectExIts"]</Button>
                }
            </Space>
        </div>

        <OrgAlert Error="@_error" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]" OnDismissError="() => _error = null" />
        @if (!_loading && _incomingPending.Count > 0 && _tab == "list")
        {
            <Alert Type="@AlertType.Info"
                   ShowIcon="true"
                   Message="@L["Suppliers_IncomingBannerTitle"]"
                   Description="@L["Suppliers_IncomingBannerBody", _incomingPending.Count]"
                   Style="margin-bottom:12px;" />
            <div style="margin-bottom:12px;">
                <Button Type="@ButtonType.Primary" OnClick='() => SwitchTab("requests")'>
                    @L["Suppliers_ReviewIncoming"]
                </Button>
            </div>
        }
        <OrgLoading Active="_loading" />

        @if (!_loading && _tab == "list")
        {
            @if (_suppliers.Count == 0)
            {
                <OrgEmpty Title="@L["Suppliers_EmptyTitle"]" Message="@L["Suppliers_EmptyMessage"]" />
            }
            else
            {
                <div class="org-table-wrap">
                    <table class="org-table">
                        <thead>
                            <tr>
                                <th>@L["Suppliers_ColName"]</th>
                                <th>@L["Suppliers_ColType"]</th>
                                <th>@L["Suppliers_ColStatus"]</th>
                                <th>@L["Suppliers_ColConnection"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _suppliers)
                            {
                                var relStatus = s.ConnectedRelationshipId is Guid rid
                                    && _buyerStatuses.TryGetValue(rid, out var st) ? st : null;
                                <tr>
                                    <td>@s.Name</td>
                                    <td>@(string.Equals(s.ConnectionType, "ConnectedOrganization", StringComparison.OrdinalIgnoreCase)
                                        ? L["Suppliers_TypeConnected"]
                                        : L["Suppliers_TypeExternal"])</td>
                                    <td><OrgStatusBadge Text="@s.Status" Tone="@s.Status" /></td>
                                    <td>
                                        @if (relStatus is null)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <OrgStatusBadge Name="@ConnectionLabel(relStatus)" Tone="@relStatus" />
                                            @if (string.Equals(relStatus, "Pending", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="org-note">@L["Suppliers_WaitingApproval"]</div>
                                            }
                                            else if (string.Equals(relStatus, "Declined", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="org-note">@L["Suppliers_RequestDeclined"]</div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        @if (!_loading && _tab == "requests")
        {
            <h3 class="org-section-title">@L["Suppliers_IncomingSection"]</h3>
            @if (_incomingPending.Count == 0)
            {
                <OrgEmpty Title="@L["Suppliers_NoIncomingTitle"]" Message="@L["Suppliers_NoIncomingMessage"]" />
            }
            else
            {
                <div class="org-table-wrap">
                    <table class="org-table">
                        <thead>
                            <tr>
                                <th>@L["Suppliers_ColRequester"]</th>
                                <th>@L["Suppliers_ColPublicId"]</th>
                                <th>@L["Suppliers_ColRequested"]</th>
                                <th>@L["Common_Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _incomingPending)
                            {
                                var name = string.IsNullOrWhiteSpace(r.CounterpartyDisplayName)
                                    ? L["Suppliers_RequestingBusiness"].Value
                                    : r.CounterpartyDisplayName;
                                <tr>
                                    <td>
                                        <div>@name</div>
                                        <div class="org-note">@L["Suppliers_IncomingPlain", name]</div>
                                    </td>
                                    <td>@(r.CounterpartyPublicOrganizationId ?? "—")</td>
                                    <td>@r.RequestedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td>
                                        @if (Capabilities.IsAllowed(UtangCapability.ManageSuppliers))
                                        {
                                            <Space>
                                                <Button Type="@ButtonType.Primary"
                                                        Loading="_busy"
                                                        OnClick="() => RespondAsync(r.RelationshipId, true)">
                                                    @L["Suppliers_Accept"]
                                                </Button>
                                                <Button Danger Loading="_busy"
                                                        OnClick="() => RespondAsync(r.RelationshipId, false)">
                                                    @L["Suppliers_Decline"]
                                                </Button>
                                            </Space>
                                        }
                                        else
                                        {
                                            <span class="org-note">@L["Suppliers_ViewOnly"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h3 class="org-section-title" style="margin-top:1.5rem;">@L["Suppliers_SentSection"]</h3>
            @if (_sent.Count == 0)
            {
                <OrgEmpty Title="@L["Suppliers_NoSentTitle"]" Message="@L["Suppliers_NoSentMessage"]" />
            }
            else
            {
                <div class="org-table-wrap">
                    <table class="org-table">
                        <thead>
                            <tr>
                                <th>@L["Suppliers_ColSupplier"]</th>
                                <th>@L["Suppliers_ColPublicId"]</th>
                                <th>@L["Suppliers_ColConnection"]</th>
                                <th>@L["Suppliers_ColRequested"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _sent)
                            {
                                <tr>
                                    <td>@(r.CounterpartyDisplayName ?? L["Suppliers_TypeConnected"])</td>
                                    <td>@(r.CounterpartyPublicOrganizationId ?? "—")</td>
                                    <td><OrgStatusBadge Name="@ConnectionLabel(r.Status)" Tone="@r.Status" /></td>
                                    <td>@r.RequestedAtUtc.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        @if (!_loading && _tab == "buyers")
        {
            @if (_selectedBuyer is not null)
            {
                <div style="margin-bottom:12px;">
                    <Button OnClick="ClearBuyerDetail">@L["Suppliers_BackToBuyers"]</Button>
                </div>
                <h3 class="org-section-title">@_selectedBuyer.CounterpartyDisplayName</h3>
                <div class="org-table-wrap">
                    <table class="org-table">
                        <tbody>
                            <tr>
                                <th>@L["Suppliers_ColPublicId"]</th>
                                <td>@(_selectedBuyer.CounterpartyPublicOrganizationId ?? "—")</td>
                            </tr>
                            <tr>
                                <th>@L["Suppliers_ColConnection"]</th>
                                <td><OrgStatusBadge Name="@ConnectionLabel(_selectedBuyer.Status)" Tone="@_selectedBuyer.Status" /></td>
                            </tr>
                            <tr>
                                <th>@L["Suppliers_ColDirection"]</th>
                                <td>@L["Suppliers_BuyerDirection"]</td>
                            </tr>
                            <tr>
                                <th>@L["Suppliers_ColConnectedSince"]</th>
                                <td>
                                    @(_selectedBuyer.RespondedAtUtc?.ToLocalTime().ToString("d") ?? "—")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="org-note" style="margin-top:12px;">@L["Suppliers_BuyerNotCustomerNote"]</p>
            }
            else
            {
                <h3 class="org-section-title">@L["Suppliers_BuyersSection"]</h3>
                <p class="org-note">@L["Suppliers_BuyersHelp"]</p>
                @if (_connectedBuyers.Count == 0)
                {
                    <OrgEmpty Title="@L["Suppliers_NoBuyersTitle"]" Message="@L["Suppliers_NoBuyersMessage"]" />
                }
                else
                {
                    <div class="org-table-wrap">
                        <table class="org-table">
                            <thead>
                                <tr>
                                    <th>@L["Suppliers_ColBuyer"]</th>
                                    <th>@L["Suppliers_ColPublicId"]</th>
                                    <th>@L["Suppliers_ColConnection"]</th>
                                    <th>@L["Suppliers_ColConnectedSince"]</th>
                                    <th>@L["Common_Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in _connectedBuyers)
                                {
                                    var name = string.IsNullOrWhiteSpace(b.CounterpartyDisplayName)
                                        ? L["Suppliers_UnknownBusiness"].Value
                                        : b.CounterpartyDisplayName;
                                    <tr>
                                        <td>@name</td>
                                        <td>@(b.CounterpartyPublicOrganizationId ?? "—")</td>
                                        <td><OrgStatusBadge Name="@ConnectionLabel(b.Status)" Tone="@b.Status" /></td>
                                        <td>@(b.RespondedAtUtc?.ToLocalTime().ToString("d") ?? "—")</td>
                                        <td>
                                            <Button Type="@ButtonType.Link"
                                                    Size="@ButtonSize.Small"
                                                    OnClick="() => OpenBuyer(b)">
                                                @L["Suppliers_ViewBuyer"]
                                            </Button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    </div>
}

@code {
    [Parameter] public Guid? RelationshipId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _tab = "list";
    private List<PosSupplierDto> _suppliers = [];
    private Dictionary<Guid, string> _buyerStatuses = [];
    private List<ConnectedSupplierRelationshipDto> _incomingPending = [];
    private List<ConnectedSupplierRelationshipDto> _sent = [];
    private List<ConnectedSupplierRelationshipDto> _connectedBuyers = [];
    private ConnectedSupplierRelationshipDto? _selectedBuyer;

    protected override async Task OnParametersSetAsync()
    {
        if (Nav.Uri.Contains("/suppliers/buyers", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "buyers";
        }
        else if (Nav.Uri.Contains("/suppliers/requests", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "requests";
        }
        else
        {
            _tab = "list";
        }

        await LoadAsync();

        if (_tab == "buyers" && RelationshipId is Guid id)
        {
            _selectedBuyer = _connectedBuyers.FirstOrDefault(x => x.RelationshipId == id);
            if (_selectedBuyer is null)
            {
                var all = await ConnectedApi.ListRelationshipsAsync("supplier");
                if (all.IsSuccess && all.Data is not null)
                {
                    _selectedBuyer = all.Data.FirstOrDefault(x => x.RelationshipId == id);
                }
            }
        }
        else if (_tab == "buyers")
        {
            _selectedBuyer = null;
        }
    }

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        _selectedBuyer = null;
        if (tab == "requests")
        {
            Nav.NavigateTo("/suppliers/requests");
        }
        else if (tab == "buyers")
        {
            Nav.NavigateTo("/suppliers/buyers");
        }
        else
        {
            Nav.NavigateTo("/suppliers");
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var list = await SupplierApi.ListAsync(page: 1, pageSize: 100);
            if (!list.IsSuccess || list.Data is null)
            {
                _error = OrgWebUi.Error(list.Error);
                _suppliers = [];
            }
            else
            {
                _suppliers = list.Data.Items.ToList();
            }

            var buyerRels = await ConnectedApi.ListRelationshipsAsync("buyer");
            if (buyerRels.IsSuccess && buyerRels.Data is not null)
            {
                _buyerStatuses = buyerRels.Data.ToDictionary(x => x.RelationshipId, x => x.Status);
                _sent = buyerRels.Data
                    .OrderByDescending(x => x.RequestedAtUtc)
                    .ToList();
            }
            else
            {
                _buyerStatuses = [];
                _sent = [];
            }

            var supplierRels = await ConnectedApi.ListRelationshipsAsync("supplier");
            if (supplierRels.IsSuccess && supplierRels.Data is not null)
            {
                _incomingPending = supplierRels.Data
                    .Where(x => string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(x => x.RequestedAtUtc)
                    .ToList();
                _connectedBuyers = supplierRels.Data
                    .Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(x => x.RespondedAtUtc ?? x.RequestedAtUtc)
                    .ToList();
            }
            else
            {
                _incomingPending = [];
                _connectedBuyers = [];
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RespondAsync(Guid relationshipId, bool accept)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageSuppliers) || _busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = accept
                ? await ConnectedApi.ApproveAsync(relationshipId, new RespondConnectionRequest())
                : await ConnectedApi.DeclineAsync(relationshipId, new RespondConnectionRequest());
            if (!result.IsSuccess)
            {
                _error = result.Error?.Detail ?? L["Suppliers_RespondFailed"];
                return;
            }

            await LoadAsync();
            Shell.IncomingSupplierRequestCount = _incomingPending.Count;
            if (accept)
            {
                _tab = "buyers";
                Nav.NavigateTo("/suppliers/buyers");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenBuyer(ConnectedSupplierRelationshipDto buyer)
    {
        _selectedBuyer = buyer;
        Nav.NavigateTo($"/suppliers/buyers/{buyer.RelationshipId:D}");
    }

    private void ClearBuyerDetail()
    {
        _selectedBuyer = null;
        Nav.NavigateTo("/suppliers/buyers");
    }

    private string ConnectionLabel(string status) => status switch
    {
        "Active" => L["Suppliers_StatusConnected"],
        "Pending" => L["Suppliers_StatusPending"],
        "Declined" => L["Suppliers_StatusDeclined"],
        "Disconnected" => L["Suppliers_StatusDisconnected"],
        _ => status
    };
}

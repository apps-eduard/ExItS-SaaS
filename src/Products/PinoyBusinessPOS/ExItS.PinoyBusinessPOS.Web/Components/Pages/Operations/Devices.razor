@page "/operations/devices"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<OrgWebResources> L
@using ExItS.DesignSystem.Components.Overlay
@using ExItS.PinoyBusinessPOS.Application.Platform

<PageTitle>@L["Devices_Title"]</PageTitle>

@if (!Shell.CanSee("devices"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Devices_Title"]" Subtitle="@L["Devices_Subtitle"]" />
    @if (_capacity is not null)
    {
        <p class="org-note">Capacity @_capacity.Used / @_capacity.Allowed</p>
    }
    <OrgAlert Error="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    <OrgLoading Active="_loading" />
    @if (!_loading && _items.Count == 0)
    {
        <OrgEmpty Title="@L["Devices_EmptyTitle"]" Message="@L["Devices_EmptyMessage"]" />
    }
    else if (!_loading)
    {
    <div class="org-table-wrap">
        <table class="org-table">
            <thead>
                <tr><th>Name</th><th>Branch</th><th>Status</th><th>Last seen</th><th>Platform</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var d in _items)
                {
                    <tr>
                        <td>
                            <input value="@d.FriendlyName" @onchange="e => _names[d.Id] = e.Value?.ToString() ?? d.FriendlyName" />
                        </td>
                        <td>@BranchLabel(d.BranchId)</td>
                        <td><OrgStatusBadge Text="@d.Status" Tone="@d.Status" /></td>
                        <td>@d.LastSeenAtUtc.LocalDateTime</td>
                        <td>@d.Platform @d.Model</td>
                        <td>
                            <button type="button" class="ant-btn ant-btn-sm" @onclick="() => RenameAsync(d)">Rename</button>
                            @if (!string.Equals(d.Status, "Revoked", StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="ant-btn ant-btn-sm ant-btn-danger" @onclick="() => OpenRevokeDialog(d)">Revoke</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }

    <ConfirmDialog Visible="@(_revokeTarget is not null)"
                   VisibleChanged="v => { if (!v) CloseRevokeDialog(); }"
                   Title="@string.Format(L["Devices_RevokeTitle"].Value, _revokeTarget?.FriendlyName ?? string.Empty)"
                   Message="@L["Devices_RevokeMessage"]"
                   Danger="true"
                   ShowReason="true"
                   ShowPassword="true"
                   RequireReason="true"
                   RequirePassword="true"
                   Reason="@_revokeReason"
                   ReasonChanged="v => _revokeReason = v"
                   Password="@_revokePassword"
                   PasswordChanged="v => _revokePassword = v"
                   ConfirmLabel="@L["Devices_Revoke"]"
                   IsLoading="@_busy"
                   OnConfirm="ConfirmRevokeAsync"
                   OnCancel="CloseRevokeDialog" />
    </div>
}

@code {
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _busy;
    private PosDeviceCapacityDto? _capacity;
    private List<PosDeviceDto> _items = [];
    private readonly Dictionary<Guid, string> _names = [];
    private readonly Dictionary<Guid, string> _branchNames = [];

    private PosDeviceDto? _revokeTarget;
    private string? _revokeReason;
    private string? _revokePassword;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null) return;
            var list = await Platform.GetPosDevicesAsync(orgId.Value);
            var cap = await Platform.GetPosDeviceCapacityAsync(orgId.Value);
            var branches = await Platform.GetBranchesAsync(orgId.Value);
            _items = list.Data?.ToList() ?? [];
            foreach (var d in _items) _names[d.Id] = d.FriendlyName;
            _branchNames.Clear();
            foreach (var branch in branches.Data ?? [])
            {
                _branchNames[branch.Id] = branch.Name;
            }
            _capacity = cap.Data;
            _error = list.IsSuccess ? null : OrgWebUi.Error(list.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string BranchLabel(Guid branchId) =>
        _branchNames.GetValueOrDefault(branchId, L["Common_Unavailable"]);

    private async Task RenameAsync(PosDeviceDto device)
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null) return;
        var name = _names.GetValueOrDefault(device.Id, device.FriendlyName);
        var result = await Platform.RenamePosDeviceAsync(orgId.Value, device.Id, name);
        _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
    }

    private void OpenRevokeDialog(PosDeviceDto device)
    {
        _revokeTarget = device;
        _revokeReason = null;
        _revokePassword = null;
    }

    private void CloseRevokeDialog()
    {
        _revokeTarget = null;
        _revokeReason = null;
        _revokePassword = null;
    }

    private async Task ConfirmRevokeAsync()
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || _revokeTarget is null || string.IsNullOrWhiteSpace(_revokeReason) || string.IsNullOrWhiteSpace(_revokePassword))
            return;

        _busy = true;
        var password = _revokePassword;
        _revokePassword = null;
        try
        {
            var stepUp = await GovernanceCriticalActionFlow.IssueStepUpTokenAsync(
                Platform,
                orgId.Value,
                PlatformGovernanceActionCodes.PosDeviceRevoke,
                PlatformGovernanceTargetTypes.PosDevice,
                _revokeTarget.Id,
                password);
            if (!stepUp.IsSuccess || stepUp.Data is null)
            {
                _error = OrgWebUi.Error(stepUp.Error, L["Error_GenericLoad"]);
                return;
            }

            var result = await Platform.RevokePosDeviceAsync(
                orgId.Value,
                _revokeTarget.Id,
                new GovernanceCriticalActionRequest(_revokeReason.Trim(), stepUp.Data));
            if (result.IsSuccess)
            {
                _error = null;
                _success = L["Devices_Revoked"];
                _revokeTarget = null;
                _revokeReason = null;
                await LoadAsync();
            }
            else
            {
                _error = OrgWebUi.Error(result.Error, L["Error_GenericLoad"]);
            }
        }
        finally
        {
            _busy = false;
            _revokePassword = null;
        }
    }
}

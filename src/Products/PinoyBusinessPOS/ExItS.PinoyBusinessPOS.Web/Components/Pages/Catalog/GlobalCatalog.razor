@page "/catalog"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IMerchantCatalogDiscoveryClient Discovery
@inject IPosCatalogImportClient Import
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["GlobalCatalog_Title"]</PageTitle>

@if (!Shell.CanSee("products"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["GlobalCatalog_Title"]" Subtitle="@L["GlobalCatalog_Subtitle"]" />
    <div class="org-toolbar">
        <ExitsField Label="@L["Common_Search"]"><Input @bind-Value="_search" /></ExitsField>
        <Button OnClick="SearchAsync">@L["Common_Search"]</Button>
        @if (Shell.Can(UtangCapability.ManageCatalog))
        {
            <Button Type="@ButtonType.Primary" Loading="_busy" Disabled="_selected.Count == 0" OnClick="ImportAsync">Import selected</Button>
        }
    </div>
    <OrgAlert Error="@_error" Success="@_ok" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]"
              OnDismissError="() => _error = null" OnDismissSuccess="() => _ok = null" />
    <OrgLoading Active="_loading" />
    @if (!_loading && string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <OrgEmpty Title="No published products found" Message="Try another search or check again after products are published to the Global Catalog." />
    }
    else if (!_loading && _items.Count > 0)
    {
    <div class="org-table-wrap">
        <table class="org-table">
            <thead>
                <tr><th></th><th>Name</th><th>SKU</th><th>Barcode</th><th>State</th></tr>
            </thead>
            <tbody>
                @foreach (var p in _items)
                {
                    var imported = _imported.Contains(p.Id);
                    <tr>
                        <td>
                            @if (!imported)
                            {
                                <input type="checkbox" checked="@_selected.Contains(p.Id)" @onchange="e => Toggle(p.Id, (bool)e.Value!)" />
                            }
                        </td>
                        <td>@p.Name</td>
                        <td>@p.Sku</td>
                        <td>@p.Barcode</td>
                        <td>
                            @if (imported)
                            {
                                <OrgStatusBadge Text="Already added" Tone="success" />
                            }
                            else
                            {
                                <OrgStatusBadge Text="New" Tone="info" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <OrgPager Page="_page" PageSize="20" TotalCount="_total" Busy="_busy" PageChanged="ChangePageAsync" />
    }
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _search;
    private string? _error;
    private string? _ok;
    private int _page = 1;
    private int _total;
    private List<PlatformMerchantGlobalProductDto> _items = [];
    private HashSet<Guid> _imported = [];
    private readonly HashSet<Guid> _selected = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private void Toggle(Guid id, bool on)
    {
        if (on)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _busy = true;
        try
        {
            var result = await Discovery.SearchActiveProductsAsync(_search, page: _page, pageSize: 20);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _items = result.Data.Items.ToList();
            _total = result.Data.TotalCount;
            var ids = _items.Select(i => i.Id).ToList();
            if (ids.Count > 0)
            {
                var imported = await Import.ListImportedGlobalProductsAsync(ids);
                _imported = imported.Data?.ImportedIds.ToHashSet() ?? [];
            }
            else
            {
                _imported = [];
            }

            _selected.RemoveWhere(id => _imported.Contains(id));
            _error = null;
        }
        finally
        {
            _loading = false;
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        var ids = _selected.Where(id => !_imported.Contains(id)).ToList();
        if (ids.Count == 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Import.ImportSelectedProductsAsync(new ImportSelectedProductsRequest(ids));
            if (!result.IsSuccess)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            _ok = "Import started. Already-added products stay marked and are not duplicated.";
            _selected.Clear();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}

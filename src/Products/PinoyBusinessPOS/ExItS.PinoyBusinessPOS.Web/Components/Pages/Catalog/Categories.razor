@page "/categories"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosCatalogClient Catalog
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@L["Categories_Title"]</PageTitle>

@if (!Shell.CanSee("products"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page">
    <ExitsPageHeader Title="@L["Categories_Title"]" Subtitle="@L["Categories_Subtitle"]" />
    @if (Shell.Can(UtangCapability.ManageCatalog))
    {
        <div class="org-toolbar">
            <ExitsField Label="New category"><Input @bind-Value="_name" /></ExitsField>
            <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="CreateAsync">Create</Button>
        </div>
    }
    <OrgAlert Error="@_error" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]" OnDismissError="() => _error = null" />
    <OrgLoading Active="_loading" />
    @if (!_loading && string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <OrgEmpty Title="@L["Categories_EmptyTitle"]" Message="@L["Categories_EmptyMessage"]" />
    }
    else if (!_loading && _items.Count > 0)
    {
    <div class="org-table-wrap">
        <table class="org-table">
            <thead>
                <tr><th>Name</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in _items)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td><OrgStatusBadge Text="@c.Status" Tone="@c.Status" /></td>
                        <td>
                            @if (Shell.Can(UtangCapability.ManageCatalog) && string.Equals(c.Status, "Active", StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="ant-btn ant-btn-sm" @onclick="() => DeactivateAsync(c.CategoryId)">Deactivate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <OrgPager Page="_page" PageSize="20" TotalCount="_total" Busy="_busy" PageChanged="ChangePageAsync" />
    }
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _name;
    private int _page = 1;
    private int _total;
    private List<PosProductCategoryDto> _items = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Catalog.ListCategoriesAsync(page: _page, pageSize: 20);
        if (result.IsSuccess && result.Data is not null)
        {
            _items = result.Data.Items;
            _total = result.Data.TotalCount;
            _error = null;
        }
        else
        {
            _error = OrgWebUi.Error(result.Error);
        }
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Name is required.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Catalog.CreateCategoryAsync(new CreatePosProductCategoryRequest(_name.Trim()));
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                _name = null;
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync(Guid id)
    {
        _busy = true;
        try
        {
            var result = await Catalog.DeactivateCategoryAsync(id);
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

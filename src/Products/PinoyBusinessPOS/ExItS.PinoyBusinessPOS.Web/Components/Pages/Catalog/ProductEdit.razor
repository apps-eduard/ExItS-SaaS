@page "/products/new"
@page "/products/{ProductId:guid}"
@attribute [Authorize]
@inject OrgWebShellState Shell
@inject IPosCatalogClient Catalog
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L

<PageTitle>@(_isNew ? L["ProductEdit_NewTitle"] : L["ProductEdit_EditTitle"])</PageTitle>

@if (!Shell.CanSee("products"))
{
    <AccessDeniedPanel />
}
else
{
    <div class="org-page org-page--form">
        <ExitsPageHeader Title="@(_isNew ? L["ProductEdit_NewTitle"] : L["ProductEdit_EditTitle"])" Subtitle="@L["ProductEdit_Subtitle"]" />
        <OrgAlert Error="@_error" OnRetry="LoadAsync" RetryLabel="@L["Common_Retry"]" OnDismissError="() => _error = null" />
        <OrgLoading Active="_loading" />
        @if (!_loading)
        {
            <div class="org-form">
                <ExitsField Label="Name"><Input @bind-Value="_name" /></ExitsField>
                <ExitsField Label="SKU"><Input @bind-Value="_sku" /></ExitsField>
                <ExitsField Label="Barcode"><Input @bind-Value="_barcode" /></ExitsField>
                <ExitsField Label="Unit"><Input @bind-Value="_unit" /></ExitsField>
                <ExitsField Label="Selling price"><Input @bind-Value="_price" /></ExitsField>
                <ExitsField Label="Description"><Input @bind-Value="_description" /></ExitsField>
                <label>
                    <input type="checkbox" @bind="_tracksExpiration" />
                    Tracks expiration
                </label>
                <ExitsField Label="Expiration warning days"><Input @bind-Value="_warningDays" /></ExitsField>
                @if (_existing is not null)
                {
                    <p class="org-note">Status: <OrgStatusBadge Text="@_existing.Status" Tone="@_existing.Status" /> · Source: @_existing.CatalogSource · Global: @(_existing.PlatformGlobalProductId is null ? "No" : "Yes")</p>
                }
                @if (Shell.Can(UtangCapability.ManageCatalog))
                {
                    <Button Type="@ButtonType.Primary" Loading="_busy" OnClick="SaveAsync">@L["Common_Save"]</Button>
                    @if (_existing is not null && string.Equals(_existing.Status, "Active", StringComparison.OrdinalIgnoreCase))
                    {
                        <Button Danger="true" Loading="_busy" OnClick="DeactivateAsync">Deactivate</Button>
                    }
                    else if (_existing is not null)
                    {
                        <Button Loading="_busy" OnClick="ReactivateAsync">Reactivate</Button>
                    }
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid ProductId { get; set; }

    private bool _loading = true;
    private bool _isNew;
    private bool _busy;
    private string? _error;
    private string? _name;
    private string? _sku;
    private string? _barcode;
    private string? _unit = "pc";
    private string? _price;
    private string? _description;
    private bool _tracksExpiration;
    private string? _warningDays;
    private PosCatalogProductDto? _existing;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _isNew = !Nav.ToBaseRelativePath(Nav.Uri).Contains("/products/", StringComparison.OrdinalIgnoreCase)
                 || ProductId == Guid.Empty;
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        _isNew = path.StartsWith("products/new", StringComparison.OrdinalIgnoreCase);
        if (_isNew)
        {
            _loading = false;
            return;
        }

        var result = await Catalog.GetProductAsync(ProductId);
        if (!result.IsSuccess || result.Data is null)
        {
            _error = OrgWebUi.Error(result.Error);
            _loading = false;
            return;
        }

        _existing = result.Data;
        _name = _existing.Name;
        _sku = _existing.Sku;
        _barcode = _existing.Barcode;
        _unit = _existing.UnitOfMeasure;
        _price = _existing.SellingPrice.ToString("0.##");
        _description = _existing.Description;
        _tracksExpiration = _existing.TracksExpiration;
        _warningDays = _existing.ExpirationWarningDays?.ToString();
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || !decimal.TryParse(_price, out var price))
        {
            _error = "Name and a valid price are required.";
            return;
        }

        int? warning = int.TryParse(_warningDays, out var days) ? days : null;
        _busy = true;
        try
        {
            ApiResult<PosCatalogProductDto> result;
            if (_isNew)
            {
                result = await Catalog.CreateProductAsync(new CreatePosCatalogProductRequest(
                    _name.Trim(),
                    string.IsNullOrWhiteSpace(_unit) ? "pc" : _unit.Trim(),
                    price,
                    _description,
                    _sku,
                    _barcode,
                    TracksExpiration: _tracksExpiration,
                    ExpirationWarningDays: warning));
            }
            else
            {
                result = await Catalog.UpdateProductAsync(ProductId, new UpdatePosCatalogProductRequest(
                    _name.Trim(),
                    string.IsNullOrWhiteSpace(_unit) ? "pc" : _unit.Trim(),
                    price,
                    _description,
                    _sku,
                    _barcode,
                    TracksExpiration: _tracksExpiration,
                    ExpirationWarningDays: warning));
            }

            if (!result.IsSuccess)
            {
                _error = OrgWebUi.Error(result.Error);
                return;
            }

            Nav.NavigateTo("/products");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeactivateAsync()
    {
        _busy = true;
        try
        {
            var result = await Catalog.DeactivateProductAsync(ProductId);
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                Nav.NavigateTo("/products");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReactivateAsync()
    {
        _busy = true;
        try
        {
            var result = await Catalog.ReactivateProductAsync(ProductId);
            _error = result.IsSuccess ? null : OrgWebUi.Error(result.Error);
            if (result.IsSuccess)
            {
                Nav.NavigateTo("/products");
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

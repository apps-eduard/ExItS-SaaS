@if (TotalCount > 0)
{
    <div class="org-pager">
        <button type="button" class="exds-btn" disabled="@(Page <= 1 || Busy)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">Previous</button>
        <span>Page @Page of @LastPage (@TotalCount)</span>
        <button type="button" class="exds-btn" disabled="@(Page >= LastPage || Busy)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">Next</button>
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int LastPage => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize)));
}

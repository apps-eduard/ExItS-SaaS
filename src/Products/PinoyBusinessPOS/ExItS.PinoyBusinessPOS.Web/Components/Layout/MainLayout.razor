@inherits LayoutComponentBase
@inject OrgWebSessionHydrator Hydrator
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L
@inject Microsoft.Extensions.Options.IOptions<ExItSWebHostOptions> Hosts
@attribute [Authorize]

<a class="skip-link" href="#main-content">Skip to content</a>

<Layout Class="exits-web-layout">
    @if (!_mobile)
    {
        <Sider Collapsible
               @bind-Collapsed="_collapsed"
               Theme="SiderTheme.Dark"
               Width="220"
               CollapsedWidth="64"
               Breakpoint="@BreakpointType.Lg"
               OnBreakpoint="OnBreakpoint"
               Class="exits-web-sider">
            <div class="exits-brand" @onclick='() => Nav.NavigateTo("/overview")'>
                <span class="exits-brand-mark">OA</span>
                @if (!_collapsed)
                {
                    <span>@L["Brand"]</span>
                }
            </div>
            <Menu Theme="MenuTheme.Dark" Mode="MenuMode.Inline" InlineCollapsed="_collapsed" Class="exits-web-menu">
                @if (Shell.CanSee("overview"))
                {
                    <MenuItem Key="overview" RouterLink="/overview" RouterMatch="NavLinkMatch.All" Icon="dashboard">@L["Nav_Overview"]</MenuItem>
                }
                @if (Shell.CanSee("profile") || Shell.CanSee("branches") || Shell.CanSee("devices"))
                {
                    <SubMenu Key="business" Title="Business">
                        @if (Shell.CanSee("profile"))
                        {
                            <MenuItem Key="profile" RouterLink="/organization/profile">Business profile</MenuItem>
                        }
                        @if (Shell.CanSee("branches"))
                        {
                            <MenuItem Key="branches" RouterLink="/organization/branches" Icon="bank">@L["Nav_Branches"]</MenuItem>
                        }
                        @if (Shell.CanSee("devices"))
                        {
                            <MenuItem Key="devices" RouterLink="/operations/devices">Devices</MenuItem>
                            <MenuItem Key="registers" RouterLink="/operations/registers">Registers</MenuItem>
                        }
                    </SubMenu>
                }
                @if (Shell.CanSee("staff") || Shell.CanSee("customers") || Shell.CanSee("suppliers"))
                {
                    <SubMenu Key="people" Title="People">
                        @if (Shell.CanSee("staff"))
                        {
                            <MenuItem Key="staff-list" RouterLink="/staff">Staff</MenuItem>
                            <MenuItem Key="roles" RouterLink="/staff/roles">Roles</MenuItem>
                        }
                        @if (Shell.CanSee("customers"))
                        {
                            <MenuItem Key="customers" RouterLink="/customers" Icon="team">@L["Nav_Customers"]</MenuItem>
                        }
                    </SubMenu>
                }
                @if (Shell.CanSee("products"))
                {
                    <SubMenu Key="catalog" Title="Catalog">
                        <MenuItem Key="product-list" RouterLink="/products" Icon="appstore">Products</MenuItem>
                        <MenuItem Key="categories" RouterLink="/categories">Categories</MenuItem>
                        <MenuItem Key="catalog" RouterLink="/catalog">Global Catalog</MenuItem>
                    </SubMenu>
                }
                @if (Shell.CanSee("inventory"))
                {
                    <SubMenu Key="inventory" Title="@L["Nav_Inventory"]">
                        <MenuItem Key="stock" RouterLink="/inventory">Stock</MenuItem>
                        <MenuItem Key="transfers" RouterLink="/inventory/transfers">Transfers</MenuItem>
                        <MenuItem Key="lots" RouterLink="/inventory/lots">Expiration</MenuItem>
                    </SubMenu>
                }
                @if (Shell.CanSee("reports") || Shell.CanSee("sales"))
                {
                    <SubMenu Key="sales" Title="Sales">
                        <MenuItem Key="sales-history" RouterLink="/sales">Sales history</MenuItem>
                        <MenuItem Key="sales-report" RouterLink="/reports/sales">Sales report</MenuItem>
                        <MenuItem Key="utang" RouterLink="/reports/utang">Business credit</MenuItem>
                    </SubMenu>
                }
                @if (Shell.CanSee("shifts") || Shell.CanSee("reports"))
                {
                    <SubMenu Key="ops" Title="@L["Nav_Operations"]">
                        @if (Shell.CanSee("shifts"))
                        {
                            <MenuItem Key="shifts" RouterLink="/operations/shifts">Shifts</MenuItem>
                            <MenuItem Key="shift-report" RouterLink="/reports/shifts">Cash / shift report</MenuItem>
                        }
                        @if (Shell.CanSee("reports"))
                        {
                            <MenuItem Key="inv-report" RouterLink="/reports/inventory">Inventory report</MenuItem>
                        }
                    </SubMenu>
                }
                @if (Shell.CanSee("settings") || Shell.CanSee("subscription") || Shell.CanSee("sales-documents") || Shell.CanSee("ownership-transfer"))
                {
                    <SubMenu Key="settings" Title="@L["Nav_Settings"]">
                        @if (Shell.CanSee("settings"))
                        {
                            <MenuItem Key="general" RouterLink="/settings">Operational settings</MenuItem>
                        }
                        @if (Shell.CanSee("sales-documents"))
                        {
                            <MenuItem Key="sales-documents" RouterLink="/organization/sales-documents">@L["SalesDocument_EducationTitle"]</MenuItem>
                        }
                        @if (Shell.CanSee("ownership-transfer"))
                        {
                            <MenuItem Key="ownership" RouterLink="/organization/ownership-transfer">Ownership</MenuItem>
                        }
                        @if (Shell.CanSee("subscription"))
                        {
                            <MenuItem Key="sub" RouterLink="/account/subscription">@L["Nav_Subscription"]</MenuItem>
                        }
                        @if (Shell.CanSee("notifications"))
                        {
                            <MenuItem Key="notifications" RouterLink="/notifications">Alerts</MenuItem>
                        }
                    </SubMenu>
                }
            </Menu>
        </Sider>
    }

    <Layout>
        <Header Class="exits-web-header">
            <div class="exits-header-left">
                @if (_mobile)
                {
                    <Button Type="@ButtonType.Text" Icon="menu" OnClick="() => _drawer = true" />
                }
                <span class="exits-header-title">@(CurrentUser.Session?.OrganizationDisplayName ?? L["Brand"])</span>
            </div>
            <div class="exits-header-right">
                @if (Shell.CanSee("notifications"))
                {
                    <Badge Count="Shell.UnreadNotificationCount" Size="@BadgeSize.Small">
                        <Button Type="@ButtonType.Text" Icon="bell" OnClick='() => Nav.NavigateTo("/notifications")' />
                    </Badge>
                }
                <ExitsThemeSelector />
                <ExitsLanguageSelector />
                <div class="exits-identity">
                    <div class="exits-identity-text">
                        <span class="exits-identity-name">@(CurrentUser.Session?.DisplayName)</span>
                        <span class="exits-identity-meta">Organization</span>
                    </div>
                    <Dropdown>
                        <Overlay>
                            <Menu>
                                <MenuItem OnClick='() => Nav.NavigateTo("/handoff/personal", forceLoad: true)'>Personal workspace</MenuItem>
                                <MenuItem OnClick='() => Nav.NavigateTo("/select-organization")'>Switch organization</MenuItem>
                                <MenuDivider />
                                <MenuItem>
                                    <a href="/logout">Sign out</a>
                                </MenuItem>
                            </Menu>
                        </Overlay>
                        <ChildContent>
                            <Button Type="@ButtonType.Text" Icon="user" />
                        </ChildContent>
                    </Dropdown>
                </div>
            </div>
        </Header>
        <Content Class="exits-web-content" Id="main-content">
            @if (!Shell.Ready)
            {
                <div style="padding:2rem;text-align:center;"><Spin /></div>
            }
            else if (CurrentUser.Session?.OrganizationId is null)
            {
                <ExitsPageHeader
                    Title="No organization"
                    Subtitle="Organization Admin needs an active organization membership. After a Local Validation reset, Olivia and Rafael are Platform Administrators only — they are not organization accounts until you Start a Business (or seed Full demo orgs)." />
                <Space Direction="SpaceDirection.Vertical" Style="margin-top:1rem;">
                    @if (Shell.Organizations.Count > 0)
                    {
                        <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/select-organization")'>
                            Select organization
                        </Button>
                    }
                    else
                    {
                        <Button Type="@ButtonType.Primary" OnClick="GoPlatformAdmin">
                            Open Platform Admin
                        </Button>
                        <Button OnClick='() => Nav.NavigateTo("/handoff/personal", forceLoad: true)'>
                            Personal workspace (Start a Business)
                        </Button>
                    }
                </Space>
            }
            else if (!Shell.CanAccessOrganizationWeb)
            {
                <ExitsPageHeader
                    Title="Organization Admin is for managers"
                    Subtitle="POS cashier staff use the PinoyBusinessPOS mobile app. This workspace is for Organization Owners and Managers only." />
                <Space Direction="SpaceDirection.Vertical" Style="margin-top:1rem;">
                    <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/handoff/personal", forceLoad: true)'>
                        Personal workspace
                    </Button>
                    <Button OnClick='() => Nav.NavigateTo("/logout", forceLoad: true)'>
                        Sign out
                    </Button>
                </Space>
            }
            else
            {
                @Body
            }
        </Content>
    </Layout>
</Layout>

@if (_mobile)
{
    <Drawer Visible="_drawer" Placement="DrawerPlacement.Left" Closable="true" OnClose="() => _drawer = false" Title="@L["Brand"].Value">
        <Menu Mode="MenuMode.Inline" OnMenuItemClicked="() => _drawer = false">
            @if (Shell.CanSee("overview")) { <MenuItem RouterLink="/overview">@L["Nav_Overview"]</MenuItem> }
            @if (Shell.CanSee("products")) { <MenuItem RouterLink="/products">Products</MenuItem> }
            @if (Shell.CanSee("inventory")) { <MenuItem RouterLink="/inventory">Inventory</MenuItem> }
            @if (Shell.CanSee("customers")) { <MenuItem RouterLink="/customers">Customers</MenuItem> }
            @if (Shell.CanSee("staff")) { <MenuItem RouterLink="/staff">Staff</MenuItem> }
            @if (Shell.CanSee("reports")) { <MenuItem RouterLink="/reports/sales">Reports</MenuItem> }
            @if (Shell.CanSee("settings")) { <MenuItem RouterLink="/settings">Settings</MenuItem> }
            @if (Shell.CanSee("sales-documents")) { <MenuItem RouterLink="/organization/sales-documents">@L["SalesDocument_EducationTitle"]</MenuItem> }
        </Menu>
    </Drawer>
}

@code {
    private bool _collapsed;
    private bool _mobile;
    private bool _drawer;

    protected override async Task OnInitializedAsync()
    {
        await Hydrator.HydrateAsync();
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (CurrentUser.Session?.OrganizationId is null
            && !path.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            && !path.StartsWith("select-organization", StringComparison.OrdinalIgnoreCase)
            && !path.StartsWith("session/", StringComparison.OrdinalIgnoreCase)
            && Shell.Organizations.Count > 1)
        {
            Nav.NavigateTo("/select-organization");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Interactive circuit: re-hydrate when prerender ran without the session cookie token.
        if (CurrentUser.Session?.OrganizationId is null && Shell.Organizations.Count == 0)
        {
            await Hydrator.HydrateAsync();
            if (CurrentUser.Session?.OrganizationId is not null || Shell.Organizations.Count > 0)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnBreakpoint(bool broken) => _mobile = broken;

    private void GoPlatformAdmin()
    {
        var origin = Hosts.Value.GetOrigin(WebApps.Platform).TrimEnd('/');
        Nav.NavigateTo($"{origin}/admin", forceLoad: true);
    }
}

@inherits LayoutComponentBase
@inject OrgWebSessionHydrator Hydrator
@inject OrgWebShellState Shell
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject IStringLocalizer<OrgWebResources> L
@inject Microsoft.Extensions.Options.IOptions<ExItSWebHostOptions> Hosts
@attribute [Authorize]

<a class="skip-link" href="#main-content">Skip to content</a>

<Layout Class="exits-web-layout">
    @if (!_mobile)
    {
        <Sider Collapsible
               @bind-Collapsed="_collapsed"
               Theme="SiderTheme.Dark"
               Width="220"
               CollapsedWidth="64"
               Breakpoint="@BreakpointType.Lg"
               OnBreakpoint="OnBreakpoint"
               Class="exits-web-sider">
            <div class="exits-brand" @onclick='() => Nav.NavigateTo("/overview")'>
                <span class="exits-brand-mark">OA</span>
                @if (!_collapsed)
                {
                    <span>@L["Brand"]</span>
                }
            </div>
            <Menu Theme="MenuTheme.Dark"
                  Mode="MenuMode.Inline"
                  InlineCollapsed="_collapsed"
                  ShowCollapsedTooltip="true"
                  Class="exits-web-menu">
                @if (Shell.CanSee("overview"))
                {
                    <MenuItem Key="overview" RouterLink="/overview" RouterMatch="NavLinkMatch.All" Icon="dashboard" Title="@L["Nav_Overview"]">@L["Nav_Overview"]</MenuItem>
                }
                @if (Shell.CanSee("profile") || Shell.CanSee("branches") || Shell.CanSee("devices"))
                {
                    <SubMenu Key="business" TitleTemplate="@BusinessTitle">
                        @if (Shell.CanSee("profile"))
                        {
                            <MenuItem Key="profile" RouterLink="/organization/profile" Icon="idcard" Title="@L["Nav_Profile"]">@L["Nav_Profile"]</MenuItem>
                        }
                        @if (Shell.CanSee("branches"))
                        {
                            <MenuItem Key="branches" RouterLink="/organization/branches" Icon="apartment" Title="@L["Nav_Branches"]">@L["Nav_Branches"]</MenuItem>
                        }
                        @if (Shell.CanSee("devices"))
                        {
                            <MenuItem Key="devices" RouterLink="/operations/devices" Icon="tablet" Title="@L["Nav_Devices"]">@L["Nav_Devices"]</MenuItem>
                            <MenuItem Key="registers" RouterLink="/operations/registers" Icon="desktop" Title="@L["Nav_Registers"]">@L["Nav_Registers"]</MenuItem>
                        }
                    </SubMenu>
                }
                @if (Shell.CanSee("staff") || Shell.CanSee("customers") || Shell.CanSee("suppliers"))
                {
                    <SubMenu Key="people" TitleTemplate="@PeopleTitle">
                        @if (Shell.CanSee("staff"))
                        {
                            <MenuItem Key="staff-list" RouterLink="/staff" Icon="usergroup-add" Title="@L["Nav_Staff"]">@L["Nav_Staff"]</MenuItem>
                            <MenuItem Key="roles" RouterLink="/staff/roles" Icon="safety-certificate" Title="@L["Nav_Roles"]">@L["Nav_Roles"]</MenuItem>
                        }
                        @if (Shell.CanSee("customers"))
                        {
                            <MenuItem Key="customers" RouterLink="/customers" Icon="contacts" Title="@L["Nav_Customers"]">@L["Nav_Customers"]</MenuItem>
                        }
                        @if (Shell.CanSee("suppliers"))
                        {
                            <MenuItem Key="suppliers" RouterLink="/suppliers" Icon="shop" Title="@L["Nav_Suppliers"]">@L["Nav_Suppliers"]</MenuItem>
                            <MenuItem Key="supplier-requests" RouterLink="/suppliers/requests" Icon="mail" Title="@L["Nav_SupplierRequests"]">
                                @L["Nav_SupplierRequests"]
                                @if (Shell.IncomingSupplierRequestCount > 0)
                                {
                                    <span> (@Shell.IncomingSupplierRequestCount)</span>
                                }
                            </MenuItem>
                        }
                    </SubMenu>
                }
                @if (Shell.CanSee("products"))
                {
                    <SubMenu Key="catalog" TitleTemplate="@CatalogTitle">
                        <MenuItem Key="product-list" RouterLink="/products" Icon="barcode" Title="@L["Nav_Products"]">@L["Nav_Products"]</MenuItem>
                        <MenuItem Key="categories" RouterLink="/categories" Icon="tags" Title="@L["Categories_Title"]">@L["Categories_Title"]</MenuItem>
                        <MenuItem Key="catalog" RouterLink="/catalog" Icon="global" Title="@L["GlobalCatalog_Title"]">@L["GlobalCatalog_Title"]</MenuItem>
                    </SubMenu>
                }
                @if (Shell.CanSee("inventory"))
                {
                    <SubMenu Key="inventory" TitleTemplate="@InventoryTitle">
                        <MenuItem Key="stock" RouterLink="/inventory" Icon="inbox" Title="@L["Stock_Title"]">@L["Stock_Title"]</MenuItem>
                        <MenuItem Key="transfers" RouterLink="/inventory/transfers" Icon="swap" Title="@L["Transfers_Title"]">@L["Transfers_Title"]</MenuItem>
                        <MenuItem Key="lots" RouterLink="/inventory/lots" Icon="clock-circle" Title="@L["Lots_Title"]">@L["Lots_Title"]</MenuItem>
                    </SubMenu>
                }
                @if (Shell.CanSee("reports") || Shell.CanSee("sales"))
                {
                    <SubMenu Key="sales" TitleTemplate="@SalesTitle">
                        <MenuItem Key="sales-history" RouterLink="/sales" Icon="history" Title="@L["SalesHistory_Title"]">@L["SalesHistory_Title"]</MenuItem>
                        <MenuItem Key="sales-report" RouterLink="/reports/sales" Icon="bar-chart" Title="@L["SalesReport_Title"]">@L["SalesReport_Title"]</MenuItem>
                        <MenuItem Key="utang" RouterLink="/reports/utang" Icon="wallet" Title="@L["Utang_Title"]">@L["Utang_Title"]</MenuItem>
                    </SubMenu>
                }
                @if (Shell.CanSee("shifts") || Shell.CanSee("reports"))
                {
                    <SubMenu Key="ops" TitleTemplate="@OperationsTitle">
                        @if (Shell.CanSee("shifts"))
                        {
                            <MenuItem Key="shifts" RouterLink="/operations/shifts" Icon="field-time" Title="@L["Shifts_Title"]">@L["Shifts_Title"]</MenuItem>
                            <MenuItem Key="shift-report" RouterLink="/reports/shifts" Icon="fund" Title="@L["ShiftsReport_Title"]">@L["ShiftsReport_Title"]</MenuItem>
                        }
                        @if (Shell.CanSee("reports"))
                        {
                            <MenuItem Key="inv-report" RouterLink="/reports/inventory" Icon="pie-chart" Title="@L["InventoryReport_Title"]">@L["InventoryReport_Title"]</MenuItem>
                        }
                    </SubMenu>
                }
                @if (Shell.CanSee("settings") || Shell.CanSee("subscription") || Shell.CanSee("sales-documents") || Shell.CanSee("ownership-transfer"))
                {
                    <SubMenu Key="settings" TitleTemplate="@SettingsTitle">
                        @if (Shell.CanSee("settings"))
                        {
                            <MenuItem Key="general" RouterLink="/settings" Icon="tool" Title="@L["Nav_OperationalSettings"]">@L["Nav_OperationalSettings"]</MenuItem>
                        }
                        @if (Shell.CanSee("sales-documents"))
                        {
                            <MenuItem Key="sales-documents" RouterLink="/organization/sales-documents" Icon="file-text" Title="@L["SalesDocument_EducationTitle"]">@L["SalesDocument_EducationTitle"]</MenuItem>
                        }
                        @if (Shell.CanSee("ownership-transfer"))
                        {
                            <MenuItem Key="ownership" RouterLink="/organization/ownership-transfer" Icon="user-switch" Title="@L["Nav_Ownership"]">@L["Nav_Ownership"]</MenuItem>
                        }
                        @if (Shell.CanSee("subscription"))
                        {
                            <MenuItem Key="sub" RouterLink="/account/subscription" Icon="crown" Title="@L["Nav_Subscription"]">@L["Nav_Subscription"]</MenuItem>
                        }
                        @if (Shell.CanSee("notifications"))
                        {
                            <MenuItem Key="notifications" RouterLink="/notifications" Icon="bell" Title="@L["Nav_Alerts"]">@L["Nav_Alerts"]</MenuItem>
                        }
                    </SubMenu>
                }
            </Menu>
        </Sider>
    }

    <Layout>
        <Header Class="exits-web-header">
            <div class="exits-header-left">
                @if (_mobile)
                {
                    <Button Type="@ButtonType.Text" Icon="menu" OnClick="() => _drawer = true" />
                }
                <span class="exits-header-title">@(CurrentUser.Session?.OrganizationDisplayName ?? L["Brand"])</span>
            </div>
            <div class="exits-header-right">
                @if (Shell.CanSee("notifications"))
                {
                    <Badge Count="Shell.UnreadNotificationCount" Size="@BadgeSize.Small">
                        <Button Type="@ButtonType.Text"
                                Icon="bell"
                                Title="@NotificationBellTitle"
                                AriaLabel="@NotificationBellTitle"
                                OnClick='() => Nav.NavigateTo("/notifications")' />
                    </Badge>
                }
                <ExitsThemeSelector />
                <ExitsLanguageSelector />
                <div class="exits-identity">
                    <div class="exits-identity-text">
                        <span class="exits-identity-name">@(CurrentUser.Session?.DisplayName)</span>
                        <span class="exits-identity-meta">Organization</span>
                    </div>
                    <Dropdown>
                        <Overlay>
                            <Menu>
                                <MenuItem OnClick='() => Nav.NavigateTo("/handoff/personal", forceLoad: true)'>Personal workspace</MenuItem>
                                <MenuItem OnClick='() => Nav.NavigateTo("/select-organization")'>Switch organization</MenuItem>
                                <MenuDivider />
                                <MenuItem>
                                    <a href="/logout">Sign out</a>
                                </MenuItem>
                            </Menu>
                        </Overlay>
                        <ChildContent>
                            <Button Type="@ButtonType.Text" Icon="user" />
                        </ChildContent>
                    </Dropdown>
                </div>
            </div>
        </Header>
        <Content Class="exits-web-content" Id="main-content">
            @if (!Shell.Ready)
            {
                <div style="padding:2rem;text-align:center;"><Spin /></div>
            }
            else if (CurrentUser.Session?.OrganizationId is null)
            {
                <ExitsPageHeader
                    Title="No organization"
                    Subtitle="Organization Admin needs an active organization membership. After a Local Validation reset, Olivia and Rafael are Platform Administrators only — they are not organization accounts until you Start a Business (or seed Full demo orgs)." />
                <Space Direction="SpaceDirection.Vertical" Style="margin-top:1rem;">
                    @if (Shell.Organizations.Count > 0)
                    {
                        <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/select-organization")'>
                            Select organization
                        </Button>
                    }
                    else
                    {
                        <Button Type="@ButtonType.Primary" OnClick="GoPlatformAdmin">
                            Open Platform Admin
                        </Button>
                        <Button OnClick='() => Nav.NavigateTo("/handoff/personal", forceLoad: true)'>
                            Personal workspace (Start a Business)
                        </Button>
                    }
                </Space>
            }
            else if (!Shell.CanAccessOrganizationWeb)
            {
                <ExitsPageHeader
                    Title="Organization Admin is for managers"
                    Subtitle="POS cashier staff use the PinoyBusinessPOS mobile app. This workspace is for Organization Owners and Managers only." />
                <Space Direction="SpaceDirection.Vertical" Style="margin-top:1rem;">
                    <Button Type="@ButtonType.Primary" OnClick='() => Nav.NavigateTo("/handoff/personal", forceLoad: true)'>
                        Personal workspace
                    </Button>
                    <Button OnClick='() => Nav.NavigateTo("/logout", forceLoad: true)'>
                        Sign out
                    </Button>
                </Space>
            }
            else
            {
                @Body
            }
        </Content>
    </Layout>
</Layout>

@if (_mobile)
{
    <Drawer Visible="_drawer" Placement="DrawerPlacement.Left" Closable="true" OnClose="() => _drawer = false" Title="@L["Brand"].Value" Class="org-mobile-drawer">
        <Menu Mode="MenuMode.Inline" OnMenuItemClicked="() => _drawer = false">
            @if (Shell.CanSee("overview"))
            {
                <MenuItem RouterLink="/overview" Icon="dashboard">@L["Nav_Overview"]</MenuItem>
            }
            @if (Shell.CanSee("profile"))
            {
                <MenuItem RouterLink="/organization/profile" Icon="idcard">@L["Nav_Profile"]</MenuItem>
            }
            @if (Shell.CanSee("branches"))
            {
                <MenuItem RouterLink="/organization/branches" Icon="apartment">@L["Nav_Branches"]</MenuItem>
            }
            @if (Shell.CanSee("devices"))
            {
                <MenuItem RouterLink="/operations/devices" Icon="tablet">@L["Nav_Devices"]</MenuItem>
                <MenuItem RouterLink="/operations/registers" Icon="desktop">@L["Nav_Registers"]</MenuItem>
            }
            @if (Shell.CanSee("staff"))
            {
                <MenuItem RouterLink="/staff" Icon="team">@L["Nav_Staff"]</MenuItem>
                <MenuItem RouterLink="/staff/roles" Icon="safety-certificate">@L["Nav_Roles"]</MenuItem>
            }
            @if (Shell.CanSee("customers"))
            {
                <MenuItem RouterLink="/customers" Icon="contacts">@L["Nav_Customers"]</MenuItem>
            }
            @if (Shell.CanSee("suppliers"))
            {
                <MenuItem RouterLink="/suppliers" Icon="shop">@L["Nav_Suppliers"]</MenuItem>
                <MenuItem RouterLink="/suppliers/requests" Icon="mail">
                    @L["Nav_SupplierRequests"]
                    @if (Shell.IncomingSupplierRequestCount > 0)
                    {
                        <span> (@Shell.IncomingSupplierRequestCount)</span>
                    }
                </MenuItem>
            }
            @if (Shell.CanSee("products"))
            {
                <MenuItem RouterLink="/products" Icon="barcode">@L["Nav_Products"]</MenuItem>
                <MenuItem RouterLink="/categories" Icon="tags">@L["Categories_Title"]</MenuItem>
                <MenuItem RouterLink="/catalog" Icon="global">@L["GlobalCatalog_Title"]</MenuItem>
            }
            @if (Shell.CanSee("inventory"))
            {
                <MenuItem RouterLink="/inventory" Icon="inbox">@L["Stock_Title"]</MenuItem>
                <MenuItem RouterLink="/inventory/transfers" Icon="swap">@L["Transfers_Title"]</MenuItem>
                <MenuItem RouterLink="/inventory/lots" Icon="clock-circle">@L["Lots_Title"]</MenuItem>
            }
            @if (Shell.CanSee("sales") || Shell.CanSee("reports"))
            {
                <MenuItem RouterLink="/sales" Icon="history">@L["SalesHistory_Title"]</MenuItem>
                <MenuItem RouterLink="/reports/sales" Icon="bar-chart">@L["SalesReport_Title"]</MenuItem>
                <MenuItem RouterLink="/reports/utang" Icon="wallet">@L["Utang_Title"]</MenuItem>
            }
            @if (Shell.CanSee("shifts"))
            {
                <MenuItem RouterLink="/operations/shifts" Icon="field-time">@L["Shifts_Title"]</MenuItem>
                <MenuItem RouterLink="/reports/shifts" Icon="fund">@L["ShiftsReport_Title"]</MenuItem>
            }
            @if (Shell.CanSee("reports"))
            {
                <MenuItem RouterLink="/reports/inventory" Icon="pie-chart">@L["InventoryReport_Title"]</MenuItem>
            }
            @if (Shell.CanSee("settings"))
            {
                <MenuItem RouterLink="/settings" Icon="setting">@L["Nav_OperationalSettings"]</MenuItem>
            }
            @if (Shell.CanSee("sales-documents"))
            {
                <MenuItem RouterLink="/organization/sales-documents" Icon="file-text">@L["SalesDocument_EducationTitle"]</MenuItem>
            }
            @if (Shell.CanSee("ownership-transfer"))
            {
                <MenuItem RouterLink="/organization/ownership-transfer" Icon="user-switch">@L["Nav_Ownership"]</MenuItem>
            }
            @if (Shell.CanSee("subscription"))
            {
                <MenuItem RouterLink="/account/subscription" Icon="crown">@L["Nav_Subscription"]</MenuItem>
            }
            @if (Shell.CanSee("notifications"))
            {
                <MenuItem RouterLink="/notifications" Icon="bell">@L["Nav_Alerts"]</MenuItem>
            }
        </Menu>
    </Drawer>
}

@code {
    private bool _collapsed;
    private bool _mobile;
    private bool _drawer;

    private string NotificationBellTitle =>
        Shell.UnreadNotificationCount > 0
            ? string.Format(L["Notifications_AriaUnread"].Value, Shell.UnreadNotificationCount)
            : L["Notifications_Aria"];

    // AntDesign 1.6.2: SubMenu has no Icon parameter — use TitleTemplate (same pattern as Platform Admin).
    private RenderFragment BusinessTitle => SubMenuTitle("shop", L["Nav_Business"]);
    private RenderFragment PeopleTitle => SubMenuTitle("team", L["Nav_People"]);
    private RenderFragment CatalogTitle => SubMenuTitle("appstore", L["Nav_Catalog"]);
    private RenderFragment InventoryTitle => SubMenuTitle("database", L["Nav_Inventory"]);
    private RenderFragment SalesTitle => SubMenuTitle("dollar", L["Nav_Sales"]);
    private RenderFragment OperationsTitle => SubMenuTitle("control", L["Nav_Operations"]);
    private RenderFragment SettingsTitle => SubMenuTitle("setting", L["Nav_Settings"]);

    private static RenderFragment SubMenuTitle(string iconType, string label) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "exits-submenu-title");
        builder.AddAttribute(2, "title", label);
        builder.OpenComponent<Icon>(3);
        builder.AddAttribute(4, "Type", iconType);
        builder.CloseComponent();
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "exits-submenu-label");
        builder.AddContent(7, label);
        builder.CloseElement();
        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        await Hydrator.HydrateAsync();
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (CurrentUser.Session?.OrganizationId is null
            && !path.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            && !path.StartsWith("select-organization", StringComparison.OrdinalIgnoreCase)
            && !path.StartsWith("session/", StringComparison.OrdinalIgnoreCase)
            && Shell.Organizations.Count > 1)
        {
            Nav.NavigateTo("/select-organization");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Interactive circuit: re-hydrate when prerender ran without the session cookie token.
        if (CurrentUser.Session?.OrganizationId is null && Shell.Organizations.Count == 0)
        {
            await Hydrator.HydrateAsync();
            if (CurrentUser.Session?.OrganizationId is not null || Shell.Organizations.Count > 0)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnBreakpoint(bool broken) => _mobile = broken;

    private void GoPlatformAdmin()
    {
        var origin = Hosts.Value.GetOrigin(WebApps.Platform).TrimEnd('/');
        Nav.NavigateTo($"{origin}/admin", forceLoad: true);
    }
}

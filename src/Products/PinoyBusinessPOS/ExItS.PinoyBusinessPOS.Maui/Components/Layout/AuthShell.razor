@namespace ExItS.PinoyBusinessPOS.Maui.Components.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject ICurrentUserContext CurrentUser
@inject AuthShellIdentityState IdentityState
@inject IStringLocalizer<PosResources> L

<div class="exds-root pos-shell pos-shell--auth" data-layout="phone" @key="_cultureEpoch">
    @if (CurrentUser.IsAuthenticated)
    {
        var usePersonalIdentity = !HasOrganizationIdentity;
        <StoreHeader Identity="@(usePersonalIdentity ? StoreHeaderIdentity.Personal : StoreHeaderIdentity.Organization)"
                     ShowSync="true"
                     ShowPersonalHome="@(!usePersonalIdentity)"
                     ShowSwitchOrganization="true"
                     OrganizationIdOverride="@EffectiveOrgId"
                     OrganizationNameOverride="@EffectiveOrgName" />
    }
    else
    {
        <StoreHeader Identity="StoreHeaderIdentity.Brand"
                     ShowSync="false"
                     ShowNotifications="false"
                     ShowAccountMenu="false" />
    }
    <main class="pos-content" id="pos-main">
        @Body
    </main>
    <OnlineRequiredDialogHost />
    <OfflineWorkingWarningHost />
</div>

@code {
    private int _cultureEpoch;

    private Guid? EffectiveOrgId =>
        IdentityState.OrganizationId ?? CurrentUser.Session?.OrganizationId;

    private string? EffectiveOrgName =>
        IdentityState.OrganizationName ?? CurrentUser.Session?.OrganizationDisplayName;

    /// <summary>
    /// Personal-only sessions (and org-select with no preview) must keep the personal
    /// identity on the left so sync/account controls stay on the right.
    /// </summary>
    private bool HasOrganizationIdentity =>
        EffectiveOrgId is not null
        || !string.IsNullOrWhiteSpace(EffectiveOrgName);

    protected override void OnInitialized()
    {
        ThemeCtl.Changed += OnChangedAsync;
        DensityCtl.Changed += OnChangedAsync;
        CultureCtl.Changed += OnChangedAsync;
        CurrentUser.Changed += OnSessionChangedAsync;
        IdentityState.Changed += OnSessionChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ThemeCtl.InitializeAsync();
        await DensityCtl.InitializeAsync();
        await CultureCtl.InitializeAsync();
        _cultureEpoch = CultureCtl.Epoch;
        StateHasChanged();
    }

    private Task OnSessionChangedAsync() => InvokeAsync(StateHasChanged);

    private async Task OnChangedAsync()
    {
        _cultureEpoch = CultureCtl.Epoch;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeCtl.Changed -= OnChangedAsync;
        DensityCtl.Changed -= OnChangedAsync;
        CultureCtl.Changed -= OnChangedAsync;
        CurrentUser.Changed -= OnSessionChangedAsync;
        IdentityState.Changed -= OnSessionChangedAsync;
    }
}

@namespace ExItS.PinoyBusinessPOS.Maui.Components.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject ICurrentUserContext CurrentUser
@inject AuthShellIdentityState IdentityState
@inject IStringLocalizer<PosResources> L

<div class="exds-root pos-shell pos-shell--auth" data-layout="phone" @key="_cultureEpoch">
    <header class="pos-topbar">
        @if (CurrentUser.IsAuthenticated)
        {
            <ShellOrganizationIdentity OrganizationIdOverride="@EffectiveOrgId"
                                       OrganizationNameOverride="@EffectiveOrgName" />
            <div class="pos-topbar__status">
                <ShellAccountMenu ShowPersonalHome="true" />
            </div>
        }
        else
        {
            <div class="pos-topbar__brand">
                <span class="pos-topbar__logo" aria-hidden="true">ES</span>
                <div class="pos-topbar__titles">
                    <span class="pos-topbar__title">@L["Brand_Name"]</span>
                    <span class="pos-topbar__subtitle pos-muted">@L["Brand_Tagline"]</span>
                </div>
            </div>
            <div class="pos-topbar__status">
                @* Unauthenticated chrome keeps product brand; environment is not shown in the top bar. *@
            </div>
        }
    </header>
    <main class="pos-content" id="pos-main">
        @Body
    </main>
</div>

@code {
    private int _cultureEpoch;

    private Guid? EffectiveOrgId =>
        IdentityState.OrganizationId ?? CurrentUser.Session?.OrganizationId;

    private string? EffectiveOrgName =>
        IdentityState.OrganizationName ?? CurrentUser.Session?.OrganizationDisplayName;

    protected override void OnInitialized()
    {
        ThemeCtl.Changed += OnChangedAsync;
        DensityCtl.Changed += OnChangedAsync;
        CultureCtl.Changed += OnChangedAsync;
        CurrentUser.Changed += OnSessionChangedAsync;
        IdentityState.Changed += OnSessionChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ThemeCtl.InitializeAsync();
        await DensityCtl.InitializeAsync();
        await CultureCtl.InitializeAsync();
        _cultureEpoch = CultureCtl.Epoch;
        StateHasChanged();
    }

    private Task OnSessionChangedAsync() => InvokeAsync(StateHasChanged);

    private async Task OnChangedAsync()
    {
        _cultureEpoch = CultureCtl.Epoch;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeCtl.Changed -= OnChangedAsync;
        DensityCtl.Changed -= OnChangedAsync;
        CultureCtl.Changed -= OnChangedAsync;
        CurrentUser.Changed -= OnSessionChangedAsync;
        IdentityState.Changed -= OnSessionChangedAsync;
    }
}

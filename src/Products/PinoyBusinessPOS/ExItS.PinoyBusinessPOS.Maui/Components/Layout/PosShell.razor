@inherits LayoutComponentBase
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject PosStatusState Status
@inject IPosSyncStatusService SyncStatus
@inject IOfflineQueueProcessor QueueProcessor
@inject ICustomerCreditOfflineSyncService CustomerCreditSync
@inject IOfflineOperationQueue OfflineQueue
@inject IConnectivityService Connectivity
@inject NavigationManager Nav
@inject SellingModeService SellingMode
@inject RoleHomeResolver RoleHome
@inject IStringLocalizer<PosResources> L

<a class="skip-link" href="#pos-main">@L["Nav_SkipToContent"]</a>

<div class="exds-root pos-shell" data-layout="phone" @key="_cultureEpoch">
    <header class="pos-topbar">
        <ShellOrganizationIdentity />
        <div class="pos-topbar__status" @onclick:stopPropagation="true">
            <div class="pos-sync-anchor">
                <button type="button"
                        class="pos-sync-status pos-sync-status--chip pos-sync-status--@SyncToneClass @(IsQuietStatus ? "pos-sync-status--quiet" : "pos-sync-status--attention")"
                        title="@SyncTitle"
                        aria-label="@SyncAccessibleLabel"
                        aria-expanded="@_syncPanelOpen"
                        aria-haspopup="dialog"
                        @onclick="ToggleSyncPanelAsync">
                    <span class="pos-sync-status__marker" aria-hidden="true"></span>
                    <span class="pos-sync-status__icon" aria-hidden="true">@IconGlyphs.Get(SyncIconName)</span>
                    @if (ShowPendingBadge)
                    {
                        <span class="pos-sync-status__badge" aria-hidden="true">@PendingBadgeText</span>
                    }
                    @if (ShowChipLabel)
                    {
                        <span class="pos-sync-status__label">@SyncChipLabel</span>
                    }
                </button>

                @if (_syncPanelOpen)
                {
                    <div class="pos-sync-popover"
                         role="dialog"
                         aria-label="@L["SyncStatus_Label"]"
                         aria-modal="false">
                        <div class="pos-sync-popover__header">
                            <span class="pos-sync-status__marker pos-sync-status__marker--@SyncToneClass" aria-hidden="true"></span>
                            <strong class="pos-sync-popover__title">@SyncTitle</strong>
                        </div>
                        <p class="pos-sync-popover__detail pos-muted">@SyncDetail</p>

                        <dl class="pos-sync-popover__facts">
                            <div class="pos-sync-popover__fact">
                                <dt>@L["SyncStatus_ConnectionLabel"]</dt>
                                <dd>@ConnectionLabel</dd>
                            </div>
                            <div class="pos-sync-popover__fact">
                                <dt>@L["SyncStatus_SyncLabel"]</dt>
                                <dd>@SyncSummaryLabel</dd>
                            </div>
                            @if (_pendingCount is > 0)
                            {
                                <div class="pos-sync-popover__fact">
                                    <dt>@L["SyncStatus_PendingCountLabel"]</dt>
                                    <dd>@_pendingCount</dd>
                                </div>
                            }
                            @if (_failedCount is > 0)
                            {
                                <div class="pos-sync-popover__fact">
                                    <dt>@L["SyncStatus_FailedCountLabel"]</dt>
                                    <dd>@_failedCount</dd>
                                </div>
                            }
                            @if (SyncStatus.Current.LastSyncedAtUtc is not null)
                            {
                                <div class="pos-sync-popover__fact">
                                    <dt>@L["SyncStatus_LastSynced"]</dt>
                                    <dd>@FormatLastSyncedTime()</dd>
                                </div>
                            }
                        </dl>

                        @if (_recoveryRequired)
                        {
                            <p class="pos-sync-popover__recovery"><strong>@L["Offline_RecoveryRequired"]</strong></p>
                        }

                        <div class="pos-sync-popover__actions">
                            @if (ShowRetryAction)
                            {
                                <button type="button"
                                        class="pos-sync-popover__action pos-sync-popover__action--primary"
                                        disabled="@(_retryBusy || _refreshBusy)"
                                        @onclick="RetrySyncAsync">
                                    @(_retryBusy ? L["Common_Loading"] : RetryActionLabel)
                                </button>
                            }
                            @if (_canRefreshFromServer)
                            {
                                <button type="button"
                                        class="pos-sync-popover__action"
                                        disabled="@(_retryBusy || _refreshBusy)"
                                        @onclick="RefreshFromServerAsync">
                                    @(_refreshBusy ? L["Common_Loading"] : L["Offline_RefreshFromServer"])
                                </button>
                            }
                            <button type="button"
                                    class="pos-sync-popover__action"
                                    @onclick="CloseSyncPanel">
                                @L["Common_Close"]
                            </button>
                        </div>
                    </div>
                }
            </div>

            <ShellAccountMenu @ref="_accountMenu" OnOpened="OnAccountMenuOpened" />
        </div>
    </header>

    <main class="pos-content" id="pos-main" tabindex="-1" @onclick="CloseOverlays">
        @if (SellingMode.IsSellingMode)
        {
            <div class="pos-sync-panel" role="status">
                <strong>@L["SellingMode_Banner"]</strong>
                <button type="button" class="pos-sync-panel__close" @onclick="ExitSellingMode">@L["SellingMode_Exit"]</button>
            </div>
        }
        @Body
    </main>

    <nav class="pos-bottom-nav" aria-label="@L["Nav_Primary"]">
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="@_homeHref" Match="NavLinkMatch.All">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
            <span class="pos-nav-item__label">@L["Nav_Home"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/catalog">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
            <span class="pos-nav-item__label">@L["Nav_Products"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/sales">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
            <span class="pos-nav-item__label">@L["Nav_Sales"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/customers">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
            <span class="pos-nav-item__label">@L["Nav_Customers"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/more">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("more")</span>
            <span class="pos-nav-item__label">@L["Nav_More"]</span>
        </NavLink>
    </nav>
</div>

@code {
    private int _cultureEpoch;
    private bool _syncPanelOpen;
    private bool _retryBusy;
    private bool _refreshBusy;
    private bool _recoveryRequired;
    private bool _canRefreshFromServer;
    private bool _isConnected;
    private int? _pendingCount;
    private int? _failedCount;
    private string _homeHref = "/home";
    private ShellAccountMenu? _accountMenu;

    protected override void OnInitialized()
    {
        ThemeCtl.Changed += OnChangedAsync;
        DensityCtl.Changed += OnChangedAsync;
        CultureCtl.Changed += OnChangedAsync;
        Status.Changed += OnChangedAsync;
        SyncStatus.Changed += OnChangedAsync;
        SellingMode.Changed += OnChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeCtl.InitializeAsync();
        await DensityCtl.InitializeAsync();
        await CultureCtl.InitializeAsync();
        _cultureEpoch = CultureCtl.Epoch;
        await Status.InitializeAsync();
        await SyncStatus.InitializeAsync();
        await RefreshQueueIndicatorsAsync();
        try
        {
            _homeHref = await RoleHome.ResolvePosHomeAsync();
        }
        catch
        {
            _homeHref = "/home";
        }

        StateHasChanged();
    }

    private void ExitSellingMode()
    {
        var route = SellingMode.ReturnRoute ?? _homeHref;
        SellingMode.Exit();
        Nav.NavigateTo(route);
    }

    private async Task RefreshQueueIndicatorsAsync()
    {
        try
        {
            _isConnected = await Connectivity.IsConnectedAsync();
            _canRefreshFromServer = _isConnected;
            var counts = await OfflineQueue.GetCountsAsync();
            _pendingCount = counts.Pending + counts.Syncing;
            _failedCount = counts.RetryableFailure + counts.PermanentFailure + counts.Conflict + counts.BlockedByAccess;
            _recoveryRequired = counts.Conflict > 0 || counts.PermanentFailure > 0 || counts.BlockedByAccess > 0;
        }
        catch
        {
            _recoveryRequired = false;
            _canRefreshFromServer = false;
            _pendingCount = null;
            _failedCount = null;
        }
    }

    private async Task ToggleSyncPanelAsync()
    {
        if (_accountMenu is not null)
        {
            await _accountMenu.CloseAsync();
        }

        _syncPanelOpen = !_syncPanelOpen;
        if (_syncPanelOpen)
        {
            await RefreshQueueIndicatorsAsync();
        }
    }

    private PosSyncStatusKind SyncKind => SyncStatus.Current.Kind;

    private bool IsQuietStatus =>
        SyncKind is PosSyncStatusKind.Online or PosSyncStatusKind.LastSynced;

    private bool ShowPendingBadge =>
        SyncKind is PosSyncStatusKind.PendingSync or PosSyncStatusKind.Syncing
        && (SyncStatus.Current.PendingCount ?? _pendingCount) is > 0;

    private string PendingBadgeText =>
        ((SyncStatus.Current.PendingCount ?? _pendingCount) ?? 0).ToString();

    private bool ShowChipLabel =>
        SyncKind is not PosSyncStatusKind.Online
        and not PosSyncStatusKind.LastSynced
        and not PosSyncStatusKind.PendingSync;

    private string SyncToneClass => SyncKind switch
    {
        PosSyncStatusKind.Online => "online",
        PosSyncStatusKind.Offline => "offline",
        PosSyncStatusKind.ReconnectRequired => "reconnect",
        PosSyncStatusKind.PendingSync => "pending",
        PosSyncStatusKind.Syncing => "syncing",
        PosSyncStatusKind.SyncFailed => "failed",
        PosSyncStatusKind.LastSynced => "synced",
        PosSyncStatusKind.RecoveryRequired => "recovery",
        _ => "offline",
    };

    private string SyncIconName => SyncKind switch
    {
        PosSyncStatusKind.Online => "check",
        PosSyncStatusKind.Offline => "cloud-off",
        PosSyncStatusKind.ReconnectRequired => "warning",
        PosSyncStatusKind.PendingSync => "inbox",
        PosSyncStatusKind.Syncing => "refresh",
        PosSyncStatusKind.SyncFailed => "error",
        PosSyncStatusKind.LastSynced => "check",
        PosSyncStatusKind.RecoveryRequired => "warning",
        _ => "info",
    };

    private string SyncChipLabel => SyncKind switch
    {
        PosSyncStatusKind.Offline => L["SyncStatus_OfflineShort"],
        PosSyncStatusKind.ReconnectRequired => L["SyncStatus_ReconnectShort"],
        PosSyncStatusKind.Syncing => L["SyncStatus_SyncingShort"],
        PosSyncStatusKind.SyncFailed => L["SyncStatus_FailedShort"],
        PosSyncStatusKind.RecoveryRequired => L["SyncStatus_RecoveryRequiredShort"],
        _ => string.Empty,
    };

    private string SyncTitle => SyncKind switch
    {
        PosSyncStatusKind.Online => L["SyncStatus_Online"],
        PosSyncStatusKind.Offline => L["SyncStatus_Offline"],
        PosSyncStatusKind.ReconnectRequired => L["SyncStatus_Reconnect"],
        PosSyncStatusKind.PendingSync => string.Format(L["SyncStatus_Pending"].Value, SyncStatus.Current.PendingCount ?? _pendingCount ?? 0),
        PosSyncStatusKind.Syncing => L["SyncStatus_Syncing"],
        PosSyncStatusKind.SyncFailed => L["SyncStatus_Failed"],
        PosSyncStatusKind.LastSynced => L["SyncStatus_LastSyncedShort"],
        PosSyncStatusKind.RecoveryRequired => L["SyncStatus_RecoveryRequired"],
        _ => L["SyncStatus_Offline"],
    };

    private string SyncAccessibleLabel => $"{L["SyncStatus_Label"]}: {SyncTitle}";

    private string SyncDetail => SyncKind switch
    {
        PosSyncStatusKind.Online => L["SyncStatus_OnlineDetail"],
        PosSyncStatusKind.Offline => L["SyncStatus_OfflineDetail"],
        PosSyncStatusKind.ReconnectRequired => L["SyncStatus_ReconnectMessage"],
        PosSyncStatusKind.PendingSync => L["SyncStatus_PendingDetail"],
        PosSyncStatusKind.Syncing => L["SyncStatus_SyncingDetail"],
        PosSyncStatusKind.SyncFailed => L["SyncStatus_FailedDetail"],
        PosSyncStatusKind.LastSynced => FormatLastSynced(),
        PosSyncStatusKind.RecoveryRequired => SyncStatus.Current.SafeDetailKey is "SyncStatus_KeyUnavailable"
            ? L["SyncStatus_KeyUnavailable"]
            : L["SyncStatus_RecoveryRequiredDetail"],
        _ => L["SyncStatus_OfflineDetail"],
    };

    private string ConnectionLabel =>
        _isConnected ? L["SyncStatus_Online"] : L["SyncStatus_Offline"];

    private string SyncSummaryLabel => SyncKind switch
    {
        PosSyncStatusKind.Online => L["SyncStatus_OnlineShort"],
        PosSyncStatusKind.Offline => L["SyncStatus_OfflineShort"],
        PosSyncStatusKind.ReconnectRequired => L["SyncStatus_ReconnectShort"],
        PosSyncStatusKind.PendingSync => string.Format(L["SyncStatus_PendingShort"].Value, SyncStatus.Current.PendingCount ?? _pendingCount ?? 0),
        PosSyncStatusKind.Syncing => L["SyncStatus_SyncingShort"],
        PosSyncStatusKind.SyncFailed => L["SyncStatus_FailedShort"],
        PosSyncStatusKind.LastSynced => L["SyncStatus_LastSyncedShort"],
        PosSyncStatusKind.RecoveryRequired => L["SyncStatus_RecoveryRequiredShort"],
        _ => L["SyncStatus_OfflineShort"],
    };

    private bool ShowRetryAction =>
        SyncKind is PosSyncStatusKind.PendingSync
            or PosSyncStatusKind.SyncFailed
            or PosSyncStatusKind.RecoveryRequired
            or PosSyncStatusKind.Offline
            or PosSyncStatusKind.Syncing;

    private string RetryActionLabel =>
        SyncKind is PosSyncStatusKind.SyncFailed or PosSyncStatusKind.RecoveryRequired
            ? L["SyncStatus_RetryNow"]
            : L["SyncStatus_SyncNow"];

    private string FormatLastSynced()
    {
        var at = SyncStatus.Current.LastSyncedAtUtc;
        if (at is null)
        {
            return L["SyncStatus_LastSynced"];
        }

        return string.Format(L["SyncStatus_LastSyncedAt"].Value, at.Value.ToLocalTime().ToString("g"));
    }

    private string FormatLastSyncedTime()
    {
        var at = SyncStatus.Current.LastSyncedAtUtc;
        return at is null
            ? L["SyncStatus_LastSynced"]
            : at.Value.ToLocalTime().ToString("g");
    }

    private void CloseSyncPanel() => _syncPanelOpen = false;

    private async Task RefreshFromServerAsync()
    {
        if (_refreshBusy)
        {
            return;
        }

        _refreshBusy = true;
        try
        {
            if (await Connectivity.IsConnectedAsync())
            {
                await CustomerCreditSync.ReconcileOnReconnectAsync();
            }

            SyncStatus.Refresh();
            await RefreshQueueIndicatorsAsync();
        }
        finally
        {
            _refreshBusy = false;
        }
    }

    private async Task RetrySyncAsync()
    {
        if (_retryBusy)
        {
            return;
        }

        _retryBusy = true;
        try
        {
            if (await Connectivity.IsConnectedAsync())
            {
                await CustomerCreditSync.ReconcileOnReconnectAsync();
            }
            else
            {
                await QueueProcessor.ProcessAvailableAsync();
            }

            SyncStatus.Refresh();
            await RefreshQueueIndicatorsAsync();
        }
        finally
        {
            _retryBusy = false;
        }
    }

    private Task OnAccountMenuOpened()
    {
        _syncPanelOpen = false;
        return RefreshQueueIndicatorsAsync();
    }

    private void CloseOverlays()
    {
        if (_syncPanelOpen)
        {
            _syncPanelOpen = false;
        }
    }

    private async Task OnChangedAsync()
    {
        _cultureEpoch = CultureCtl.Epoch;
        await RefreshQueueIndicatorsAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeCtl.Changed -= OnChangedAsync;
        DensityCtl.Changed -= OnChangedAsync;
        CultureCtl.Changed -= OnChangedAsync;
        Status.Changed -= OnChangedAsync;
        SyncStatus.Changed -= OnChangedAsync;
        SellingMode.Changed -= OnChangedAsync;
    }
}

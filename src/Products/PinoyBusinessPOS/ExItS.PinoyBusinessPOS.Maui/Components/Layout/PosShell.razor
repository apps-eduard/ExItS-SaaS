@inherits LayoutComponentBase
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject PosStatusState Status
@inject IPosSyncStatusService SyncStatus
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject SellingModeService SellingMode
@inject RoleHomeResolver RoleHome
@inject ICurrentUserContext CurrentUser
@inject OfflineAwareNavigation OfflineNav
@inject IStringLocalizer<PosResources> L

<a class="skip-link" href="#pos-main">@L["Nav_SkipToContent"]</a>

<div class="@($"exds-root pos-shell{(_showBottomNav ? string.Empty : " pos-shell--auth")}")" data-layout="phone" @key="_cultureEpoch">
    <StoreHeader @ref="_storeHeader"
                 Identity="StoreHeaderIdentity.Organization"
                 ShowSync="true"
                 ShowPersonalHome="true" />

    <main class="pos-content" id="pos-main" tabindex="-1" @onclick="CloseOverlays">
        @Body
    </main>

    <OnlineRequiredDialogHost />
    <OfflineWorkingWarningHost />

    @if (_showBottomNav)
    {
        <nav class="pos-bottom-nav" aria-label="@L["Nav_Primary"]">
            <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="@_homeHref" Match="NavLinkMatch.All">
                <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
                <span class="pos-nav-item__label">@L["Nav_Home"]</span>
            </NavLink>
            @if (_hasPosAccess)
            {
                <a class="pos-nav-item @(IsCatalogActive ? "pos-nav-item--active" : null)"
                   href="/catalog"
                   @onclick="GoCatalogAsync"
                   @onclick:preventDefault>
                    <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                    <span class="pos-nav-item__label">@L["Nav_Products"]</span>
                </a>
                <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/sales">
                    <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                    <span class="pos-nav-item__label">@L["Nav_Sales"]</span>
                </NavLink>
                <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/customers">
                    <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                    <span class="pos-nav-item__label">@L["Nav_Customers"]</span>
                </NavLink>
            }
            @* POS access not active: Home already resolves to the Organization overview, so the bar
               keeps only Home and More instead of repeating the same destination. *@
            <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/more">
                <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("more")</span>
                <span class="pos-nav-item__label">@L["Nav_More"]</span>
            </NavLink>
        </nav>
    }
</div>

@code {
    private int _cultureEpoch;
    private string _homeHref = "/home";
    private bool _hasPosAccess = true;
    private bool _showBottomNav = true;
    private bool _setupChromeReady;
    private StoreHeader? _storeHeader;

    private bool IsCatalogActive
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            return path.Equals("/catalog", StringComparison.OrdinalIgnoreCase)
                   || path.StartsWith("/catalog/", StringComparison.OrdinalIgnoreCase)
                   || path.Equals("/products", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        ThemeCtl.Changed += OnChangedAsync;
        DensityCtl.Changed += OnChangedAsync;
        CultureCtl.Changed += OnChangedAsync;
        Status.Changed += OnChangedAsync;
        SyncStatus.Changed += OnChangedAsync;
        SellingMode.Changed += OnAccessChangedAsync;
        CurrentUser.Changed += OnAccessChangedAsync;
        Nav.LocationChanged += OnLocationChanged;
        _hasPosAccess = CurrentUser.HasPosAccess;
    }

    private Task GoCatalogAsync() => OfflineNav.NavigateAsync("/catalog");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeCtl.InitializeAsync();
        await DensityCtl.InitializeAsync();
        await CultureCtl.InitializeAsync();
        _cultureEpoch = CultureCtl.Epoch;
        await Status.InitializeAsync();
        await SyncStatus.InitializeAsync();
        await RefreshHomeDestinationAsync();
        await RefreshFirstTimeSetupChromeAsync();
    }

    /// <summary>
    /// Single context-aware Home destination for the bottom tab. Re-evaluated whenever the session,
    /// organization context, POS access, or working-as preference changes.
    /// </summary>
    private async Task RefreshHomeDestinationAsync()
    {
        _hasPosAccess = CurrentUser.HasPosAccess;
        try
        {
            _homeHref = await RoleHome.ResolvePosHomeAsync();
        }
        catch
        {
            _homeHref = _hasPosAccess ? "/home" : RoleHomeResolver.OrgEssentials;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshFirstTimeSetupChromeAsync()
    {
        var incomplete = false;
        try
        {
            incomplete = await Gate.IsOrgPosFirstTimeSetupIncompleteAsync();
        }
        catch
        {
            incomplete = false;
        }

        _showBottomNav = !incomplete;
        _setupChromeReady = true;

        if (incomplete && !NavigationGate.IsOrgFirstTimeSetupRoute(Nav.Uri))
        {
            try
            {
                Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), forceLoad: false, replace: true);
                return;
            }
            catch
            {
                // Keep chrome hidden; page guards still bounce via ResolveStartRouteAsync.
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAccessChangedAsync()
    {
        await RefreshHomeDestinationAsync();
        await RefreshFirstTimeSetupChromeAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        TryExitSellingModeOnReturn(e.Location);

        // Cheap guard: only re-resolve when effective POS access actually flipped.
        if (_hasPosAccess != CurrentUser.HasPosAccess)
        {
            _ = OnAccessChangedAsync();
        }
        else if (_setupChromeReady)
        {
            _ = RefreshFirstTimeSetupChromeAsync();
        }
        else
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void TryExitSellingModeOnReturn(string uri)
    {
        if (!SellingMode.IsSellingMode || string.IsNullOrWhiteSpace(SellingMode.ReturnRoute))
        {
            return;
        }

        var relative = Nav.ToBaseRelativePath(uri);
        var path = "/" + relative.Split('?', '#')[0].Trim('/');
        if (path == "/")
        {
            path = "/home";
        }

        var returnPath = SellingMode.ReturnRoute.TrimEnd('/');
        if (string.Equals(path, returnPath, StringComparison.OrdinalIgnoreCase)
            || string.Equals(path, _homeHref.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
                && string.Equals(_homeHref, SellingMode.ReturnRoute, StringComparison.OrdinalIgnoreCase))
        {
            SellingMode.Exit();
        }
    }

    private void CloseOverlays() => _storeHeader?.CloseOverlays();

    private async Task OnChangedAsync()
    {
        _cultureEpoch = CultureCtl.Epoch;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeCtl.Changed -= OnChangedAsync;
        DensityCtl.Changed -= OnChangedAsync;
        CultureCtl.Changed -= OnChangedAsync;
        Status.Changed -= OnChangedAsync;
        SyncStatus.Changed -= OnChangedAsync;
        SellingMode.Changed -= OnAccessChangedAsync;
        CurrentUser.Changed -= OnAccessChangedAsync;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

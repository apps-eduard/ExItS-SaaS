@inherits LayoutComponentBase
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject PosStatusState Status
@inject IPosSyncStatusService SyncStatus
@inject IAppInfoService AppInfo
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="exds-root pos-shell" data-layout="phone" @key="_cultureEpoch">
    <header class="pos-topbar">
        <div class="pos-topbar__brand">
            <span class="pos-topbar__logo" aria-hidden="true">ES</span>
            <div class="pos-topbar__titles">
                <span class="pos-topbar__title">@L["Brand_Name"]</span>
                <span class="pos-topbar__subtitle pos-muted">@L["Brand_Tagline"]</span>
            </div>
        </div>
        <div class="pos-topbar__status">
            <Badge Tone="@(IsDevelopment ? BadgeTone.Warning : BadgeTone.Neutral)">@EnvironmentLabel</Badge>
            <button type="button"
                    class="pos-sync-status pos-sync-status--@SyncToneClass"
                    title="@SyncTitle"
                    aria-label="@SyncAccessibleLabel"
                    @onclick="ToggleSyncPanel">
                <span class="pos-sync-status__marker" aria-hidden="true"></span>
                <span class="pos-sync-status__icon" aria-hidden="true">@IconGlyphs.Get(SyncIconName)</span>
                <span class="pos-sync-status__label">@SyncShortLabel</span>
            </button>
            <IconButton IconName="settings" AriaLabel="@L["Nav_Settings"]" OnClick="GoToSettings" />
        </div>
    </header>

    @if (_syncPanelOpen)
    {
        <div class="pos-sync-panel" role="status" aria-live="polite">
            <div class="pos-sync-panel__row">
                <span class="pos-sync-status__marker pos-sync-status__marker--@SyncToneClass" aria-hidden="true"></span>
                <strong>@SyncTitle</strong>
            </div>
            <p class="pos-muted">@SyncDetail</p>
            <button type="button" class="pos-sync-panel__close" @onclick="CloseSyncPanel">@L["Common_Close"]</button>
        </div>
    }

    <main class="pos-content" id="pos-main">
        @Body
    </main>

    <nav class="pos-bottom-nav" aria-label="@L["Nav_Primary"]">
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/home" Match="NavLinkMatch.All">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
            <span class="pos-nav-item__label">@L["Nav_Home"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/products">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
            <span class="pos-nav-item__label">@L["Nav_Products"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/sales">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
            <span class="pos-nav-item__label">@L["Nav_Sales"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/customers">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
            <span class="pos-nav-item__label">@L["Nav_Customers"]</span>
        </NavLink>
        <NavLink class="pos-nav-item" ActiveClass="pos-nav-item--active" href="/more">
            <span class="pos-nav-item__icon" aria-hidden="true">@IconGlyphs.Get("more")</span>
            <span class="pos-nav-item__label">@L["Nav_More"]</span>
        </NavLink>
    </nav>
</div>

@code {
    private int _cultureEpoch;
    private bool _syncPanelOpen;

    protected override void OnInitialized()
    {
        ThemeCtl.Changed += OnChangedAsync;
        DensityCtl.Changed += OnChangedAsync;
        CultureCtl.Changed += OnChangedAsync;
        Status.Changed += OnChangedAsync;
        SyncStatus.Changed += OnChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeCtl.InitializeAsync();
        await DensityCtl.InitializeAsync();
        await CultureCtl.InitializeAsync();
        _cultureEpoch = CultureCtl.Epoch;
        await Status.InitializeAsync();
        await SyncStatus.InitializeAsync();
        StateHasChanged();
    }

    private bool IsDevelopment => string.Equals(AppInfo.EnvironmentName, "Development", StringComparison.OrdinalIgnoreCase);

    private string EnvironmentLabel => IsDevelopment ? L["Env_Development"] : L["Env_Production"];

    private PosSyncStatusKind SyncKind => SyncStatus.Current.Kind;

    private string SyncToneClass => SyncKind switch
    {
        PosSyncStatusKind.Online => "online",
        PosSyncStatusKind.Offline => "offline",
        PosSyncStatusKind.ReconnectRequired => "reconnect",
        PosSyncStatusKind.PendingSync => "pending",
        PosSyncStatusKind.Syncing => "syncing",
        PosSyncStatusKind.SyncFailed => "failed",
        _ => "offline",
    };

    private string SyncIconName => SyncKind switch
    {
        PosSyncStatusKind.Online => "check",
        PosSyncStatusKind.Offline => "cloud-off",
        PosSyncStatusKind.ReconnectRequired => "warning",
        PosSyncStatusKind.PendingSync => "inbox",
        PosSyncStatusKind.Syncing => "refresh",
        PosSyncStatusKind.SyncFailed => "error",
        _ => "info",
    };

    private string SyncShortLabel => SyncKind switch
    {
        PosSyncStatusKind.Online => L["SyncStatus_OnlineShort"],
        PosSyncStatusKind.Offline => L["SyncStatus_OfflineShort"],
        PosSyncStatusKind.ReconnectRequired => L["SyncStatus_ReconnectShort"],
        _ => L["SyncStatus_OfflineShort"],
    };

    private string SyncTitle => SyncKind switch
    {
        PosSyncStatusKind.Online => L["SyncStatus_Online"],
        PosSyncStatusKind.Offline => L["SyncStatus_Offline"],
        PosSyncStatusKind.ReconnectRequired => L["SyncStatus_Reconnect"],
        PosSyncStatusKind.PendingSync => L["SyncStatus_Pending"],
        PosSyncStatusKind.Syncing => L["SyncStatus_Syncing"],
        PosSyncStatusKind.SyncFailed => L["SyncStatus_Failed"],
        PosSyncStatusKind.LastSynced => L["SyncStatus_LastSynced"],
        _ => L["SyncStatus_Offline"],
    };

    private string SyncAccessibleLabel => $"{L["SyncStatus_Label"]}: {SyncTitle}";

    private string SyncDetail => SyncKind switch
    {
        PosSyncStatusKind.Online => L["SyncStatus_OnlineDetail"],
        PosSyncStatusKind.Offline => L["SyncStatus_OfflineDetail"],
        PosSyncStatusKind.ReconnectRequired => L["SyncStatus_ReconnectMessage"],
        _ => L["SyncStatus_OfflineDetail"],
    };

    private void ToggleSyncPanel() => _syncPanelOpen = !_syncPanelOpen;

    private void CloseSyncPanel() => _syncPanelOpen = false;

    private void GoToSettings() => Nav.NavigateTo("/settings");

    private async Task OnChangedAsync()
    {
        _cultureEpoch = CultureCtl.Epoch;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeCtl.Changed -= OnChangedAsync;
        DensityCtl.Changed -= OnChangedAsync;
        CultureCtl.Changed -= OnChangedAsync;
        Status.Changed -= OnChangedAsync;
        SyncStatus.Changed -= OnChangedAsync;
    }
}

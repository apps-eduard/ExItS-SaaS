@using ExItS.DesignSystem.Components.Forms
@using ExItS.DesignSystem.Components.Overlay
@using ExItS.DesignSystem.Components.Primitives
@using ExItS.PinoyBusinessPOS.Application.Catalog
@using ExItS.PinoyBusinessPOS.Application.Sales
@inject IStringLocalizer<PosResources> L

<Dialog Visible="@Visible"
        Title="@DialogTitle"
        OnClose="CancelAsync">
    <ChildContent>
        <div class="pos-weight-entry">
            @if (Product is not null)
            {
                <div class="pos-weight-entry__product">
                    <span class="pos-weight-entry__name">@Product.Name</span>
                    <span class="pos-weight-entry__unit-price">
                        <MoneyDisplay Amount="@Product.SellingPrice" CurrencyCode="PHP" />
                        <span> @L["Sales_Checkout_PricePerKg"]</span>
                    </span>
                </div>
            }

            <div class="pos-weight-entry__qty">
                <NumberInput Label="@L["Sales_Checkout_WeightQuantity"]"
                             Value="@_rawValue"
                             ValueChanged="OnValueChanged"
                             DecimalPlaces="@(_unitCode == WeightEntry.UnitGram ? 0 : 3)"
                             Required="true"
                             IsInvalid="@(!string.IsNullOrEmpty(_error))"
                             ErrorText="@_error"
                             Hint="@WeightHint"
                             autofocus="true" />
                <RadioGroup Label="@L["Sales_Checkout_WeightUnit"]"
                            Value="@_unitCode"
                            ValueChanged="OnUnitChanged"
                            Options="@_unitOptions"
                            Inline="true" />
            </div>

            @if (PreviewAmount is decimal amount)
            {
                <div class="pos-weight-entry__total" aria-live="polite">
                    <span class="pos-weight-entry__total-label">@L["Sales_Checkout_WeightLineTotal"]</span>
                    <span class="pos-weight-entry__total-amount">
                        <MoneyDisplay Amount="@amount" CurrencyCode="PHP" />
                    </span>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <FormActions>
            @if (InitialKilograms is > 0m)
            {
                <Button Variant="ButtonVariant.Ghost" OnClick="RemoveAsync">@L["Sales_Checkout_Remove"]</Button>
            }
            <Button Variant="ButtonVariant.Secondary" OnClick="CancelAsync">@L["Sales_Cancel"]</Button>
            <Button Variant="ButtonVariant.Primary" OnClick="ConfirmAsync">@ConfirmLabel</Button>
        </FormActions>
    </Footer>
</Dialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public PosCatalogProductDto? Product { get; set; }
    /// <summary>When editing an existing line, pass the current cart kilograms.</summary>
    [Parameter] public decimal? InitialKilograms { get; set; }
    [Parameter] public EventCallback<decimal> Confirmed { get; set; }
    [Parameter] public EventCallback Removed { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }

    private decimal? _rawValue;
    private string _unitCode = WeightEntry.UnitKilogram;
    private string? _error;
    private string _sessionUnit = WeightEntry.UnitKilogram;
    private List<RadioOption> _unitOptions = [];
    private bool _opened;

    private string DialogTitle =>
        InitialKilograms is > 0m
            ? L["Sales_Checkout_WeightEditTitle"]
            : L["Sales_Checkout_WeightAddTitle"];

    private string ConfirmLabel =>
        InitialKilograms is > 0m
            ? L["Sales_Checkout_WeightUpdate"]
            : L["Sales_Checkout_WeightAdd"];

    private string WeightHint =>
        _unitCode == WeightEntry.UnitGram
            ? L["Sales_Checkout_WeightHint"]
            : L["Sales_Checkout_WeightHintKg"];

    private decimal? PreviewAmount
    {
        get
        {
            if (Product is null
                || !WeightEntry.TryNormalize(_rawValue, _unitCode, out var kilograms, out _))
            {
                return null;
            }

            return PosSaleOptions.RoundMoney(Product.SellingPrice * kilograms);
        }
    }

    protected override void OnParametersSet()
    {
        _unitOptions =
        [
            new RadioOption(WeightEntry.UnitKilogram, L["Sales_Checkout_WeightUnitKg"]),
            new RadioOption(WeightEntry.UnitGram, L["Sales_Checkout_WeightUnitG"])
        ];

        if (Visible && !_opened)
        {
            _opened = true;
            _error = null;
            _unitCode = _sessionUnit;
            if (InitialKilograms is decimal kilograms && kilograms > 0m)
            {
                _rawValue = _unitCode == WeightEntry.UnitGram
                    ? kilograms * 1000m
                    : kilograms;
            }
            else
            {
                _rawValue = null;
            }
        }
        else if (!Visible)
        {
            _opened = false;
        }
    }

    private void OnValueChanged(decimal? value)
    {
        _rawValue = value;
        _error = null;
    }

    private void OnUnitChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || string.Equals(value, _unitCode, StringComparison.Ordinal))
        {
            return;
        }

        var from = _unitCode;
        _unitCode = value;
        _sessionUnit = value;
        _error = null;
        _rawValue = ConvertDisplayedWeight(_rawValue, from, value);
    }

    private static decimal? ConvertDisplayedWeight(decimal? raw, string fromUnit, string toUnit)
    {
        if (raw is null)
        {
            return null;
        }

        if (fromUnit == WeightEntry.UnitGram && toUnit == WeightEntry.UnitKilogram)
        {
            return Math.Round(raw.Value / 1000m, 3, MidpointRounding.AwayFromZero);
        }

        if (fromUnit == WeightEntry.UnitKilogram && toUnit == WeightEntry.UnitGram)
        {
            return Math.Round(raw.Value * 1000m, 0, MidpointRounding.AwayFromZero);
        }

        return raw;
    }

    private async Task ConfirmAsync()
    {
        if (!WeightEntry.TryNormalize(_rawValue, _unitCode, out var kilograms, out var errorCode))
        {
            _error = errorCode switch
            {
                "zero" => L["Sales_Checkout_WeightInvalidZero"],
                "precision" => L["Sales_Checkout_WeightInvalidPrecision"],
                "unit" => L["Sales_Checkout_WeightInvalidUnit"],
                _ => L["Sales_Checkout_WeightInvalid"]
            };
            return;
        }

        await Confirmed.InvokeAsync(kilograms);
        await SetVisibleAsync(false);
    }

    private async Task RemoveAsync()
    {
        if (Removed.HasDelegate)
        {
            await Removed.InvokeAsync();
        }

        await SetVisibleAsync(false);
    }

    private async Task CancelAsync()
    {
        if (Cancelled.HasDelegate)
        {
            await Cancelled.InvokeAsync();
        }

        await SetVisibleAsync(false);
    }

    private async Task SetVisibleAsync(bool visible)
    {
        if (VisibleChanged.HasDelegate)
        {
            await VisibleChanged.InvokeAsync(visible);
        }
    }
}

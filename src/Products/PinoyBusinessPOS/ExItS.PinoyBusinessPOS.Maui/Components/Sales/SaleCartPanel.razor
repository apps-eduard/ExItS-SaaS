@using ExItS.PinoyBusinessPOS.Application.Sales
@using ExItS.PinoyBusinessPOS.Maui.Components.Pages.Sales
@inject SaleCartService Cart
@inject IStringLocalizer<PosResources> L

@if (Cart.IsEmpty)
{
    <EmptyState IconName="sales" Title="@L["Sales_Checkout_CartEmptyTitle"]" Message="@L["Sales_Checkout_CartEmptyMessage"]" />
}
else
{
    <Stack Gap="3">
        @foreach (var item in Cart.Items)
        {
            var byWeight = SalesUiOptions.IsByWeight(item.SellingMode);
            var usesSellUnit = item.SellingUnitId is not null;
            var displayQty = item.EnteredQuantity ?? item.Quantity;
            var displayUnit = usesSellUnit
                ? (item.SellingUnitName ?? item.UnitOfMeasure)
                : item.UnitOfMeasure;
            <div class="pos-cart-line">
                <div>
                    <div class="pos-cart-line__name">@item.Name</div>
                    <div class="pos-cart-line__meta">
                        <span class="pos-tabular">@displayQty.ToString("0.###") @displayUnit</span>
                        <span> × </span>
                        <MoneyDisplay Amount="@item.UnitPrice" CurrencyCode="PHP" />
                        @if (byWeight && !usesSellUnit)
                        {
                            <span> @L["Sales_Checkout_PricePerKg"]</span>
                        }
                        else if (usesSellUnit)
                        {
                            <span> / @displayUnit</span>
                        }
                        <span> · </span>
                        <MoneyDisplay Amount="@item.LineTotal" CurrencyCode="PHP" />
                    </div>
                    @if (usesSellUnit && item.MultiplierToBase != 1m)
                    {
                        <div class="pos-cart-line__stock-hint pos-muted">
                            @string.Format(
                                L["Sales_Checkout_CartStockFromBase"].Value,
                                item.Quantity.ToString("0.###"),
                                item.UnitOfMeasure)
                        </div>
                    }
                </div>
                <div class="pos-cart-line__actions">
                    @if (byWeight && !usesSellUnit)
                    {
                        <Button Variant="ButtonVariant.Secondary"
                                Disabled="@Disabled"
                                OnClick="() => OnEditWeight(item.ProductId)">
                            @L["Sales_Checkout_WeightEdit"]
                        </Button>
                        <Button Variant="ButtonVariant.Ghost"
                                Disabled="@Disabled"
                                OnClick="() => Cart.Remove(item.ProductId)">@L["Sales_Checkout_Remove"]</Button>
                    }
                    else if (usesSellUnit)
                    {
                        <QuantityStepper Value="@displayQty"
                                         ValueChanged="v => OnEnteredQuantityChanged(item, v)"
                                         Step="@(item.MultiplierToBase != 1m && !byWeight ? 1m : 0.001m)"
                                         DecimalPlaces="@(item.MultiplierToBase != 1m && !byWeight ? 0 : 3)"
                                         Disabled="@Disabled"
                                         AriaLabel="@L["Sales_Checkout_Quantity"]"
                                         DecreaseLabel="@L["Sales_Checkout_DecreaseQty"]"
                                         IncreaseLabel="@L["Sales_Checkout_IncreaseQty"]" />
                        <Button Variant="ButtonVariant.Ghost"
                                Disabled="@Disabled"
                                OnClick="() => Cart.Remove(item.ProductId, item.SellingUnitId)">@L["Sales_Checkout_Remove"]</Button>
                    }
                    else
                    {
                        <QuantityStepper Value="@item.Quantity"
                                         ValueChanged="v => OnQuantityChanged(item.ProductId, v)"
                                         Step="@(PosSaleOptions.RequiresWholeQuantity(item.UnitOfMeasure, item.SellingMode) ? 1m : 0.001m)"
                                         DecimalPlaces="@PosSaleOptions.MaxQuantityDecimals(item.UnitOfMeasure, item.SellingMode)"
                                         Disabled="@Disabled"
                                         AriaLabel="@L["Sales_Checkout_Quantity"]"
                                         DecreaseLabel="@L["Sales_Checkout_DecreaseQty"]"
                                         IncreaseLabel="@L["Sales_Checkout_IncreaseQty"]" />
                        <Button Variant="ButtonVariant.Ghost"
                                Disabled="@Disabled"
                                OnClick="() => Cart.Remove(item.ProductId)">@L["Sales_Checkout_Remove"]</Button>
                    }
                </div>
            </div>
        }

        <Divider />

        <div>
            <span class="pos-type-helper">@L["Sales_Field_Subtotal"]</span>
            <div><MoneyDisplay Amount="@Cart.Subtotal" CurrencyCode="PHP" /></div>
        </div>
        @if (TaxPreview > 0m)
        {
            <div>
                <span class="pos-type-helper">@L["Sales_Field_Tax"]</span>
                <div><MoneyDisplay Amount="@TaxPreview" CurrencyCode="PHP" /></div>
            </div>
        }
        <div class="pos-sell-cart__total">
            <span class="pos-sell-cart__total-label">@L["Sales_Field_Total"]</span>
            <MoneyDisplay Amount="@PayableTotal" CurrencyCode="PHP" Emphasized="true" />
        </div>
        <div class="pos-type-helper">@L["Sales_Checkout_ServerAuthoritative"]</div>
        <FormActions>
            <Button Variant="ButtonVariant.Secondary" Disabled="@Disabled" OnClick="() => Cart.Clear()">@L["Sales_Checkout_ClearCart"]</Button>
        </FormActions>
    </Stack>
}

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public decimal TaxPreview { get; set; }
    [Parameter] public decimal PayableTotal { get; set; }
    [Parameter] public EventCallback<Guid> QuantityChanged { get; set; }
    [Parameter] public EventCallback<Guid> EditWeight { get; set; }

    private Task OnQuantityChanged(Guid productId, decimal quantity)
    {
        Cart.SetQuantity(productId, quantity);
        return QuantityChanged.HasDelegate
            ? QuantityChanged.InvokeAsync(productId)
            : Task.CompletedTask;
    }

    private Task OnEnteredQuantityChanged(SaleCartItem item, decimal quantity)
    {
        Cart.SetEnteredQuantity(item.ProductId, item.SellingUnitId, quantity);
        return QuantityChanged.HasDelegate
            ? QuantityChanged.InvokeAsync(item.ProductId)
            : Task.CompletedTask;
    }

    private Task OnEditWeight(Guid productId) =>
        EditWeight.HasDelegate
            ? EditWeight.InvokeAsync(productId)
            : Task.CompletedTask;
}

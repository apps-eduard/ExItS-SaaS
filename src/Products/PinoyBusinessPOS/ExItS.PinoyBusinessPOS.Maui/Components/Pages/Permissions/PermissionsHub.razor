@page "/permissions"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosPermissionClient Permissions
@inject IPlatformAccessClient Platform
@inject IUtangCapabilityEvaluator Capabilities
@inject ICurrentUserContext CurrentUser
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!Capabilities.IsAllowed(UtangCapability.ViewPermissions))
{
    <Page>
        <ErrorState Title="@L["Permissions_DeniedTitle"]" Message="@L["Permissions_DeniedMessage"]" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManagePermissions);
    var actionGridClass = canManage ? "pos-action-grid--three" : "pos-action-grid--two";
<div class="pos-permissions">
    <Page>
        <PageHeader Title="@L["Permissions_Title"]" Subtitle="@L["Permissions_Subtitle"]" />

        <div class="pos-action-grid @actionGridClass pos-permissions__actions" role="group" aria-label="@L["Permissions_Title"]">
            @if (canManage)
            {
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@_isOffline"
                        @onclick="GoNew">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                    <span class="pos-action-tile__label">@L["Permissions_Assign"]</span>
                </button>
            }
            <button type="button"
                    class="pos-action-tile"
                    disabled="@_isOffline"
                    @onclick="GoMyAccess">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                <span class="pos-action-tile__label">@L["Permissions_MyAccess"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(_loading || _isOffline)"
                    @onclick="LoadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Permissions_Refresh"]</span>
            </button>
        </div>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Permissions_OfflineTitle"]" Message="@L["Permissions_OfflineMessage"]" />
        }

        <section class="pos-permissions__list-section"
                 aria-labelledby="permissions-assignments-heading"
                 aria-busy="@_loading">
            <h2 id="permissions-assignments-heading" class="pos-permissions__section-title">
                @L["Permissions_AssignmentsSection"]
            </h2>

            @if (_loading)
            {
                <div class="pos-permissions__loading" role="status" aria-live="polite">
                    <Spinner />
                    <span class="pos-muted">@L["Common_Loading"]</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@L["Permissions_ErrorTitle"]"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="LoadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="customers"
                            Title="@L["Permissions_EmptyTitle"]"
                            Message="@L["Permissions_EmptyMessage"]">
                    <Actions>
                        @if (canManage && !_isOffline)
                        {
                            <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Sm" OnClick="GoNew">
                                @L["Permissions_Assign"]
                            </Button>
                        }
                    </Actions>
                </EmptyState>
            }
            else
            {
                <div class="pos-permissions__list" role="list" aria-label="@L["Permissions_AssignmentsSection"]">
                    @foreach (var item in _items)
                    {
                        var identity = ResolveCachedIdentity(item.ActorId);
                        <button type="button"
                                class="pos-permissions__row"
                                role="listitem"
                                aria-label="@RowAriaLabel(item, identity)"
                                @onclick="() => GoDetail(item.AssignmentId)">
                            <span class="pos-permissions__row-main">
                                <span class="pos-permissions__row-name">@identity.Primary</span>
                                <span class="pos-permissions__row-role">@item.RoleDisplayName</span>
                                @if (!string.IsNullOrWhiteSpace(identity.Secondary))
                                {
                                    <span class="pos-permissions__row-meta pos-muted">@identity.Secondary</span>
                                }
                            </span>
                            <span class="pos-permissions__row-side">
                                <span class="pos-permissions__badge pos-permissions__badge--@StatusTone(item.Status)"
                                      aria-label="@($"{L["Permissions_Status"]}: {StatusLabel(item.Status)}")">
                                    @StatusLabel(item.Status)
                                </span>
                                <span class="pos-permissions__open">
                                    <span class="visually-hidden">@L["Permissions_Open"]</span>
                                    <span class="pos-permissions__chevron" aria-hidden="true">›</span>
                                </span>
                            </span>
                        </button>
                    }
                </div>
            }
        </section>
    </Page>
</div>
}

@code {
    private sealed record ActorIdentity(string Primary, string? Secondary);

    private bool _ready;
    private bool _loading = true;
    private bool _isOffline;
    private string? _errorMessage;
    private IReadOnlyList<PosRoleAssignmentDto> _items = [];
    private readonly Dictionary<Guid, ActorIdentity> _identities = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private void GoNew() => Nav.NavigateTo("/permissions/assignments/new");
    private void GoMyAccess() => Nav.NavigateTo("/permissions/my-access");
    private void GoDetail(Guid id) => Nav.NavigateTo($"/permissions/assignments/{id:D}");

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                _items = [];
                _identities.Clear();
                return;
            }

            var result = await Permissions.ListAssignmentsAsync();
            if (!result.IsSuccess || result.Data is null)
            {
                _errorMessage = result.Error?.Detail ?? L["Permissions_LoadFailed"];
                _items = [];
                _identities.Clear();
            }
            else
            {
                _items = result.Data.Items;
                await ResolveIdentitiesAsync(_items.Select(i => i.ActorId).Distinct());
            }
        }
        catch
        {
            _errorMessage = L["Permissions_LoadFailed"];
            _items = [];
            _identities.Clear();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveIdentitiesAsync(IEnumerable<Guid> actorIds)
    {
        _identities.Clear();
        var orgId = CurrentUser.Session?.OrganizationId;
        Dictionary<Guid, string?> grantNames = new();

        if (orgId is Guid organizationId)
        {
            try
            {
                var grantsResult = await Platform.GetProductLocalRolesAsync(organizationId, status: "Active");
                if (grantsResult.IsSuccess && grantsResult.Data is not null)
                {
                    foreach (var grant in grantsResult.Data)
                    {
                        if (!string.IsNullOrWhiteSpace(grant.UserDisplayName)
                            && !LooksLikeTechnicalId(grant.UserDisplayName))
                        {
                            grantNames[grant.UserIdentityId] = grant.UserDisplayName.Trim();
                        }
                    }
                }
            }
            catch
            {
                // Grant names are optional enrichment.
            }
        }

        string? selfPublicUserId = null;
        var selfId = CurrentUser.Session?.UserId;
        if (selfId is Guid sid && actorIds.Contains(sid))
        {
            try
            {
                var profile = await Platform.GetPersonalProfileAsync();
                if (profile.IsSuccess
                    && profile.Data is not null
                    && !string.IsNullOrWhiteSpace(profile.Data.PublicUserId)
                    && !LooksLikeTechnicalId(profile.Data.PublicUserId))
                {
                    selfPublicUserId = profile.Data.PublicUserId.Trim();
                }
            }
            catch
            {
                // Optional ExItS ID for the signed-in user only.
            }
        }

        foreach (var actorId in actorIds)
        {
            string? displayName = null;
            string? email = null;
            string? exitsId = selfId == actorId ? selfPublicUserId : null;

            try
            {
                var userResult = await Platform.GetUserAsync(actorId);
                if (userResult.IsSuccess && userResult.Data is not null)
                {
                    displayName = FirstMeaningful(
                        userResult.Data.DisplayName,
                        userResult.Data.Username);
                    email = FirstMeaningful(userResult.Data.Email);
                }
            }
            catch
            {
                // Fall through to grant / unknown.
            }

            if (string.IsNullOrWhiteSpace(displayName)
                && grantNames.TryGetValue(actorId, out var grantName))
            {
                displayName = grantName;
            }

            _identities[actorId] = BuildIdentity(displayName, email, exitsId);
        }
    }

    private ActorIdentity ResolveCachedIdentity(Guid actorId) =>
        _identities.TryGetValue(actorId, out var identity)
            ? identity
            : BuildIdentity(null, null, null);

    private ActorIdentity BuildIdentity(string? displayName, string? email, string? exitsId)
    {
        var primary = FirstMeaningful(displayName)
                      ?? FirstMeaningful(email)
                      ?? FirstMeaningful(exitsId)
                      ?? L["Permissions_UnknownUser"].Value;

        string? secondary = null;
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            secondary = FirstMeaningful(email) ?? FirstMeaningful(exitsId);
        }
        else if (!string.IsNullOrWhiteSpace(email))
        {
            secondary = FirstMeaningful(exitsId);
        }

        return new ActorIdentity(primary, secondary);
    }

    private static string? FirstMeaningful(params string?[] values)
    {
        foreach (var value in values)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                continue;
            }

            var trimmed = value.Trim();
            if (LooksLikeTechnicalId(trimmed))
            {
                continue;
            }

            return trimmed;
        }

        return null;
    }

    private static bool LooksLikeTechnicalId(string value)
    {
        if (Guid.TryParse(value, out _))
        {
            return true;
        }

        // Truncated GUID display like "f3e820d5…2412"
        if (value.Contains('…', StringComparison.Ordinal)
            || value.Contains("...", StringComparison.Ordinal))
        {
            return true;
        }

        return false;
    }

    private string StatusLabel(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase) ? L["Permissions_Status_Active"]
        : string.Equals(status, "Revoked", StringComparison.OrdinalIgnoreCase) ? L["Permissions_Status_Revoked"]
        : string.IsNullOrWhiteSpace(status) ? L["Permissions_NoRole"] : status;

    private static string StatusTone(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase) ? "active"
        : string.Equals(status, "Revoked", StringComparison.OrdinalIgnoreCase) ? "revoked"
        : "neutral";

    private string RowAriaLabel(PosRoleAssignmentDto item, ActorIdentity identity)
    {
        var parts = new List<string> { identity.Primary, StatusLabel(item.Status) };
        if (!string.IsNullOrWhiteSpace(identity.Secondary))
        {
            parts.Add(identity.Secondary);
        }

        parts.Add(item.RoleDisplayName);
        return string.Join(", ", parts);
    }
}

@page "/permissions/assignments/{AssignmentId:guid}"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosPermissionClient Permissions
@inject IPlatformAccessClient Platform
@inject IUtangCapabilityEvaluator Capabilities
@inject ICurrentUserContext CurrentUser
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_bootstrapped)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-permissions">
    <Page>
        @if (_loading)
        {
            <div class="pos-permissions__loading" role="status" aria-live="polite">
                <Spinner />
                <span class="pos-muted">@L["Common_Loading"]</span>
            </div>
        }
        else if (_item is null)
        {
            <ErrorState Title="@L["Permissions_ErrorTitle"]"
                        Message="@(_error ?? L["Permissions_LoadFailed"])"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="ReloadAsync" />
        }
        else
        {
            <header class="pos-permissions__header">
                <div class="pos-permissions__heading">
                    <h1 class="pos-permissions__title">@_item.RoleDisplayName</h1>
                    <p class="pos-permissions__subtitle">@L["Permissions_AssignmentDetail"]</p>
                </div>
            </header>

            <dl class="pos-permissions__facts">
                <div class="pos-permissions__fact">
                    <dt>@L["Permissions_Status"]</dt>
                    <dd>
                        <span class="pos-permissions__badge pos-permissions__badge--@StatusTone(_item.Status)"
                              aria-label="@($"{L["Permissions_Status"]}: {StatusLabel(_item.Status)}")">
                            @StatusLabel(_item.Status)
                        </span>
                    </dd>
                </div>
                <div class="pos-permissions__fact">
                    <dt>@L["Permissions_AssignedUser"]</dt>
                    <dd>
                        <span class="pos-permissions__fact-primary">@_actorPrimary</span>
                        @if (!string.IsNullOrWhiteSpace(_actorSecondary))
                        {
                            <span class="pos-permissions__fact-secondary pos-muted">@_actorSecondary</span>
                        }
                    </dd>
                </div>
            </dl>

            @if (_error is not null)
            {
                <Alert Tone="AlertTone.Danger" Title="@L["Permissions_ErrorTitle"]" Message="@_error" />
            }

            @if (_item.Status == "Active" && Capabilities.IsAllowed(UtangCapability.ManagePermissions))
            {
                <div class="pos-permissions__revoke">
                    <Button Variant="ButtonVariant.Danger"
                            Disabled="@_acting"
                            IsLoading="@_acting"
                            OnClick="OpenRevokeConfirm">@L["Permissions_Revoke"]</Button>
                </div>
            }
        }
    </Page>
</div>

    <ConfirmDialog @bind-Visible="_revokeOpen"
                   Title="@L["Permissions_RevokeConfirmTitle"]"
                   Message="@_revokeMessage"
                   Danger="true"
                   ConfirmLabel="@L["Permissions_Revoke"]"
                   CancelLabel="@L["Permissions_Cancel"]"
                   IsLoading="@_acting"
                   OnConfirm="ConfirmRevokeAsync"
                   OnCancel="CancelRevoke" />
}

@code {
    [Parameter] public Guid AssignmentId { get; set; }

    private bool _bootstrapped;
    private bool _loading = true;
    private bool _acting;
    private bool _revokeOpen;
    private string? _error;
    private string? _revokeMessage;
    private PosRoleAssignmentDto? _item;
    private string _actorPrimary = string.Empty;
    private string? _actorSecondary;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewPermissions))
        {
            Nav.NavigateTo("/permissions", replace: true);
            return;
        }

        _bootstrapped = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (!await Connectivity.IsConnectedAsync())
            {
                _item = null;
                _error = L["Permissions_OfflineMessage"];
                return;
            }

            var result = await Permissions.GetAssignmentAsync(AssignmentId);
            if (!result.IsSuccess || result.Data is null)
            {
                _item = null;
                _error = result.Error?.Detail ?? L["Permissions_LoadFailed"];
            }
            else
            {
                _item = result.Data;
                await ResolveActorAsync(_item.ActorId);
            }
        }
        catch
        {
            _item = null;
            _error = L["Permissions_LoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveActorAsync(Guid actorId)
    {
        string? displayName = null;
        string? email = null;
        string? exitsId = null;

        try
        {
            var userResult = await Platform.GetUserAsync(actorId);
            if (userResult.IsSuccess && userResult.Data is not null)
            {
                displayName = FirstMeaningful(userResult.Data.DisplayName, userResult.Data.Username);
                email = FirstMeaningful(userResult.Data.Email);
            }
        }
        catch
        {
            // Fall through.
        }

        if (string.IsNullOrWhiteSpace(displayName)
            && CurrentUser.Session?.OrganizationId is Guid orgId)
        {
            try
            {
                var grantsResult = await Platform.GetProductLocalRolesAsync(orgId, status: "Active");
                var grantName = grantsResult.IsSuccess && grantsResult.Data is not null
                    ? grantsResult.Data.FirstOrDefault(g => g.UserIdentityId == actorId)?.UserDisplayName
                    : null;
                displayName = FirstMeaningful(grantName);
            }
            catch
            {
                // Optional.
            }
        }

        if (CurrentUser.Session?.UserId == actorId)
        {
            try
            {
                var profile = await Platform.GetPersonalProfileAsync();
                if (profile.IsSuccess && profile.Data is not null)
                {
                    exitsId = FirstMeaningful(profile.Data.PublicUserId);
                    displayName ??= FirstMeaningful(profile.Data.DisplayName);
                    email ??= FirstMeaningful(profile.Data.Email);
                }
            }
            catch
            {
                // Optional.
            }
        }

        _actorPrimary = FirstMeaningful(displayName)
                        ?? FirstMeaningful(email)
                        ?? FirstMeaningful(exitsId)
                        ?? L["Permissions_UnknownUser"].Value;

        if (!string.IsNullOrWhiteSpace(displayName))
        {
            _actorSecondary = FirstMeaningful(email) ?? FirstMeaningful(exitsId);
        }
        else if (!string.IsNullOrWhiteSpace(email))
        {
            _actorSecondary = FirstMeaningful(exitsId);
        }
        else
        {
            _actorSecondary = null;
        }
    }

    private void OpenRevokeConfirm()
    {
        if (_item is null || _acting)
        {
            return;
        }

        _revokeMessage = string.Format(
            L["Permissions_RevokeConfirmMessage"].Value,
            _item.RoleDisplayName,
            _actorPrimary);
        _revokeOpen = true;
    }

    private void CancelRevoke()
    {
        _revokeOpen = false;
        _revokeMessage = null;
    }

    private async Task ConfirmRevokeAsync()
    {
        _revokeOpen = false;
        await RevokeAsync();
    }

    private async Task RevokeAsync()
    {
        if (_acting)
        {
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManagePermissions))
        {
            _error = L["Permissions_DeniedMessage"];
            return;
        }

        if (!await Connectivity.IsConnectedAsync())
        {
            _error = L["Permissions_OfflineMessage"];
            return;
        }

        _acting = true;
        _error = null;
        StateHasChanged();

        try
        {
            var result = await Permissions.RevokeAsync(AssignmentId);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = result.Error?.Detail ?? L["Permissions_RevokeFailed"];
                return;
            }

            _item = result.Data;
        }
        catch
        {
            _error = L["Permissions_RevokeFailed"];
        }
        finally
        {
            _acting = false;
        }
    }

    private static string? FirstMeaningful(params string?[] values)
    {
        foreach (var value in values)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                continue;
            }

            var trimmed = value.Trim();
            if (Guid.TryParse(trimmed, out _)
                || trimmed.Contains('…', StringComparison.Ordinal)
                || trimmed.Contains("...", StringComparison.Ordinal))
            {
                continue;
            }

            return trimmed;
        }

        return null;
    }

    private string StatusLabel(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase) ? L["Permissions_Status_Active"]
        : string.Equals(status, "Revoked", StringComparison.OrdinalIgnoreCase) ? L["Permissions_Status_Revoked"]
        : string.IsNullOrWhiteSpace(status) ? L["Permissions_NoRole"] : status;

    private static string StatusTone(string? status) =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase) ? "active"
        : string.Equals(status, "Revoked", StringComparison.OrdinalIgnoreCase) ? "revoked"
        : "neutral";
}

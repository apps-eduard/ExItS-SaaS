@page "/permissions/assignments/new"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosPermissionClient Permissions
@inject IUtangCapabilityEvaluator Capabilities
@inject ICurrentUserContext CurrentUser
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-permissions">
    <Page>
        <header class="pos-permissions__header">
            <div class="pos-permissions__heading">
                <h1 class="pos-permissions__title">@L["Permissions_Assign"]</h1>
                <p class="pos-permissions__subtitle">@L["Permissions_AssignSubtitle"]</p>
            </div>
        </header>

        @if (!Capabilities.IsAllowed(UtangCapability.ManagePermissions))
        {
            <ErrorState Title="@L["Permissions_DeniedTitle"]" Message="@L["Permissions_DeniedMessage"]" />
        }
        else
        {
            <Stack Gap="3">
                <TextInput Label="@L["Permissions_ActorUserId"]"
                           Value="@_actorIdText"
                           ValueChanged="OnActorChanged"
                           Required="true"
                           IsInvalid="@(!string.IsNullOrEmpty(_actorError))"
                           ErrorText="@_actorError"
                           Disabled="@_acting" />

                <Select Label="@L["Permissions_Role"]"
                        Value="@_role"
                        ValueChanged="OnRoleChanged"
                        Options="@RoleOptions"
                        Disabled="@(_acting || _roles.Count == 0)" />

                @if (_error is not null)
                {
                    <Alert Tone="AlertTone.Danger" Title="@L["Permissions_ErrorTitle"]" Message="@_error" />
                }

                <FormActions>
                    <Button Variant="ButtonVariant.Primary"
                            Disabled="@_acting"
                            IsLoading="@_acting"
                            OnClick="SubmitAsync">@L["Permissions_Assign"]</Button>
                </FormActions>
            </Stack>
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private string _actorIdText = string.Empty;
    private string _role = "Cashier";
    private bool _acting;
    private string? _error;
    private string? _actorError;
    private IReadOnlyList<PosRoleDto> _roles = [];

    private IReadOnlyList<SelectOption> RoleOptions =>
        _roles.Select(r => new SelectOption(r.Role, r.DisplayName)).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManagePermissions))
        {
            _ready = true;
            return;
        }

        var roles = await Permissions.ListRolesAsync();
        if (roles.IsSuccess && roles.Data is { Count: > 0 })
        {
            _roles = roles.Data;
            _role = _roles[0].Role;
        }

        _ready = true;
    }

    private void OnActorChanged(string? value)
    {
        _actorIdText = value ?? string.Empty;
        _actorError = null;
    }

    private void OnRoleChanged(string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            _role = value;
        }
    }

    private async Task SubmitAsync()
    {
        if (_acting)
        {
            return;
        }

        _error = null;
        _actorError = null;

        if (!Capabilities.IsAllowed(UtangCapability.ManagePermissions))
        {
            _error = L["Permissions_DeniedMessage"];
            return;
        }

        if (!Guid.TryParse(_actorIdText.Trim(), out var actorId))
        {
            _actorError = L["Permissions_InvalidActor"];
            return;
        }

        if (!await Connectivity.IsConnectedAsync())
        {
            _error = L["Permissions_OfflineMessage"];
            return;
        }

        _acting = true;
        StateHasChanged();

        try
        {
            var result = await Permissions.AssignAsync(new AssignPosRoleRequest(actorId, _role));
            if (!result.IsSuccess || result.Data is null)
            {
                _error = result.Error?.Detail ?? L["Permissions_AssignFailed"];
                return;
            }

            // Return to list so the new assignment appears without a full GUID title flash.
            Nav.NavigateTo("/permissions", replace: true);
        }
        catch
        {
            _error = L["Permissions_AssignFailed"];
        }
        finally
        {
            _acting = false;
        }
    }
}

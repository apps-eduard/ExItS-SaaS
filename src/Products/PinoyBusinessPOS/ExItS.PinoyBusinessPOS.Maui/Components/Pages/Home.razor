@page "/home"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IStringLocalizer<PosResources> L

<Page>
    <Spinner />
    <span class="pos-muted">@L["Common_Loading"]</span>
</Page>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Match Boot: never wait forever on cold resolve (education/setup/permissions).
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
        string route;
        try
        {
            route = await Gate.ResolveStartRouteAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            route = "/owner";
        }

        Nav.NavigateTo(
            string.IsNullOrWhiteSpace(route) || route == "/home" ? "/owner" : route,
            replace: true);
    }
}

@page "/home"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IStringLocalizer<PosResources> L

<Page>
    <Spinner />
    <span class="pos-muted">@L["Common_Loading"]</span>
</Page>

@code {
    protected override async Task OnInitializedAsync()
    {
        var route = await Gate.ResolveStartRouteAsync();
        Nav.NavigateTo(route == "/home" ? "/owner" : route, replace: true);
    }
}

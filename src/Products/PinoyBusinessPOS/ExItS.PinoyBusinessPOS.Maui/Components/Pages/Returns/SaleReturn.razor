@page "/sales/{SaleId:guid}/return"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSaleReturnClient Returns
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject ICurrentUserContext CurrentUser
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/sales/{SaleId:D}")" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Returns_Loading"]</span></Page>
}
else if (_refundable is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Returns_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Returns_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
<div class="pos-sale-return">
<Page>
    <header class="pos-sale-return__header">
        <h1 class="pos-sale-return__title">@L["Returns_Title"]</h1>
        <p class="pos-sale-return__subtitle">@_refundable.SaleNumber</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Returns_OfflineTitle"]" Message="@L["Returns_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Returns_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-sale-return__panel" aria-labelledby="returns-lines-heading">
        <h2 id="returns-lines-heading" class="pos-sale-return__section-title">@L["Returns_LinesSection"]</h2>
        <div class="pos-sale-return__list" role="list">
            @foreach (var line in _refundable.Lines)
            {
                var qty = GetQuantity(line.SaleLineId);
                var byWeight = SalesUiOptions.IsByWeight(line.SellingMode);
                var decimals = PosSaleOptions.MaxQuantityDecimals(line.UnitOfMeasure, line.SellingMode);
                var refundPreview = PreviewRefund(line, qty);
                var refundableQtyLabel = SalesUiOptions.FormatCartQuantity(L, line.RefundableQuantity, line.UnitOfMeasure, line.SellingMode);
                <article class="pos-sale-return__entry @(qty > 0m ? "pos-sale-return__entry--active" : null)" role="listitem">
                    <div class="pos-sale-return__entry-top">
                        <div class="pos-sale-return__entry-info">
                            <span class="pos-sale-return__entry-name">@line.ProductNameSnapshot</span>
                            <span class="pos-sale-return__entry-meta">@L["Returns_RefundableQty", refundableQtyLabel]</span>
                        </div>
                        <span class="pos-sale-return__entry-amount">
                            <MoneyDisplay Amount="@line.RefundableAmount" CurrencyCode="PHP" />
                        </span>
                    </div>
                    <div class="pos-sale-return__entry-controls">
                        <div class="pos-sale-return__qty-row">
                            @if (byWeight)
                            {
                                <NumberInput Label="@L["Returns_QuantityLabel"]"
                                             Value="@(qty > 0m ? qty : null)"
                                             ValueChanged="v => SetQuantity(line, v)"
                                             DecimalPlaces="@decimals"
                                             Hint="@string.Format(L["Returns_QuantityMaxHint"].Value, refundableQtyLabel)" />
                            }
                            else
                            {
                                <div class="pos-sale-return__stepper-wrap">
                                    <span class="pos-sale-return__qty-label">@L["Returns_QuantityLabel"]</span>
                                    <QuantityStepper Value="@qty"
                                                     ValueChanged="v => SetQuantity(line, v)"
                                                     Step="@(PosSaleOptions.RequiresWholeQuantity(line.UnitOfMeasure, line.SellingMode) ? 1m : 0.001m)"
                                                     Min="0"
                                                     Max="@line.RefundableQuantity"
                                                     DecimalPlaces="@decimals"
                                                     AriaLabel="@L["Returns_QuantityLabel"]"
                                                     DecreaseLabel="@L["Sales_Checkout_DecreaseQty"]"
                                                     IncreaseLabel="@L["Sales_Checkout_IncreaseQty"]" />
                                </div>
                            }
                            <Button Variant="ButtonVariant.Secondary"
                                    Disabled="@(qty >= line.RefundableQuantity)"
                                    OnClick="() => SetQuantity(line, line.RefundableQuantity)">
                                @L["Returns_ReturnAll"]
                            </Button>
                        </div>
                        <Select Label="@L["Returns_DispositionLabel"]"
                                Value="@GetDisposition(line.SaleLineId)"
                                ValueChanged="v => SetDisposition(line.SaleLineId, v)"
                                Options="_dispositionOptions" />
                        @if (qty > 0m)
                        {
                            <div class="pos-sale-return__line-refund">
                                <span class="pos-sale-return__line-refund-label">@L["Returns_LineRefund"]</span>
                                <span class="pos-sale-return__line-refund-amount">
                                    <MoneyDisplay Amount="@refundPreview" CurrencyCode="PHP" />
                                </span>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="pos-sale-return__panel" aria-labelledby="returns-reason-heading">
        <h2 id="returns-reason-heading" class="pos-sale-return__section-title">@L["Returns_ReasonSection"]</h2>
        <div class="pos-sale-return__form">
            <TextInput Label="@L["Returns_ReasonLabel"]" @bind-Value="_reason" Required="true" />
            <TextInput Label="@L["Returns_NotesLabel"]" @bind-Value="_notes" />
        </div>
    </section>

    <div class="pos-sale-return__summary" aria-live="polite">
        <span class="pos-sale-return__summary-label">@L["Returns_TotalRefund"]</span>
        <span class="pos-sale-return__summary-amount">
            <MoneyDisplay Amount="@TotalRefundPreview" CurrencyCode="PHP" />
        </span>
    </div>

    <FormActions class="pos-customer-create__footer">
        <Button Variant="ButtonVariant.Primary"
                Disabled="@(!CanSubmit)"
                IsLoading="@_acting"
                OnClick="SubmitAsync">@L["Returns_Submit"]</Button>
    </FormActions>
</Page>
</div>
}

@code {
    [Parameter] public Guid SaleId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _acting;
    private bool _isOffline;
    private PosRefundableSaleDto? _refundable;
    private string? _errorTitle;
    private string? _errorMessage;
    private string _reason = string.Empty;
    private string? _notes;
    private readonly Dictionary<Guid, decimal> _quantities = new();
    private readonly Dictionary<Guid, string> _dispositions = new();
    private IReadOnlyList<SelectOption> _dispositionOptions = Array.Empty<SelectOption>();

    protected override async Task OnInitializedAsync()
    {
        _dispositionOptions =
        [
            new SelectOption("ReturnToStock", L["Returns_Restock"]),
            new SelectOption("DoNotRestock", L["Returns_NoRestock"]),
        ];

        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ProcessReturn))
        {
            Nav.NavigateTo("/sales");
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private bool CanSubmit =>
        !_isOffline
        && Capabilities.IsAllowed(UtangCapability.ProcessReturn)
        && !string.IsNullOrWhiteSpace(_reason)
        && _quantities.Values.Any(q => q > 0m)
        && !_acting;

    private decimal TotalRefundPreview =>
        _refundable is null
            ? 0m
            : _refundable.Lines.Sum(line => PreviewRefund(line, GetQuantity(line.SaleLineId)));

    private decimal GetQuantity(Guid saleLineId) =>
        _quantities.TryGetValue(saleLineId, out var qty) ? qty : 0m;

    private void SetQuantity(PosRefundableSaleLineDto line, decimal? value)
    {
        var decimals = PosSaleOptions.MaxQuantityDecimals(line.UnitOfMeasure, line.SellingMode);
        var qty = Math.Max(0m, value ?? 0m);
        qty = Math.Min(qty, line.RefundableQuantity);
        qty = Math.Round(qty, decimals, MidpointRounding.AwayFromZero);
        _quantities[line.SaleLineId] = qty;
    }

    private string GetDisposition(Guid saleLineId) =>
        _dispositions.TryGetValue(saleLineId, out var d) ? d : "ReturnToStock";

    private void SetDisposition(Guid saleLineId, string? value) =>
        _dispositions[saleLineId] = string.IsNullOrWhiteSpace(value) ? "ReturnToStock" : value;

    private static decimal PreviewRefund(PosRefundableSaleLineDto line, decimal quantity)
    {
        if (quantity <= 0m)
        {
            return 0m;
        }

        if (quantity >= line.RefundableQuantity)
        {
            return line.RefundableAmount;
        }

        return PosSaleOptions.RoundMoney(quantity * line.UnitPriceSnapshot);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();

        if (_isOffline)
        {
            _loading = false;
            return;
        }

        var result = await Returns.GetRefundableAsync(SaleId);
        if (result.IsSuccess && result.Data is not null)
        {
            _refundable = result.Data;
            foreach (var line in _refundable.Lines)
            {
                _dispositions.TryAdd(line.SaleLineId, "ReturnToStock");
            }
        }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        if (_refundable is null || !CanSubmit)
        {
            return;
        }

        _acting = true;
        _errorTitle = null;
        _errorMessage = null;

        var lines = _refundable.Lines
            .Where(l => GetQuantity(l.SaleLineId) > 0m)
            .Select(l => new CreateSaleReturnLineRequest(
                l.SaleLineId,
                GetQuantity(l.SaleLineId),
                GetDisposition(l.SaleLineId)))
            .ToList();

        var result = await Returns.CreateReturnAsync(new CreateSaleReturnRequest(
            SaleId,
            _reason.Trim(),
            lines,
            string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));

        _acting = false;

        if (result.IsSuccess && result.Data is not null)
        {
            Nav.NavigateTo($"/sales/{SaleId:D}");
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }
}

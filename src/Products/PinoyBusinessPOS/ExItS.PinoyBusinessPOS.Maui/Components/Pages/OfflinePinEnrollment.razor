@page "/offline-pin-setup"
@layout Layout.AuthShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject NavigationGate Gate
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-offline-pin">
    <Page>
        <header class="pos-offline-pin__header">
            <div class="pos-offline-pin__badge" aria-hidden="true">@IconGlyphs.Get("lock")</div>
            <h1 class="pos-offline-pin__title">@(_isChange ? L["Offline_PinChangeTitle"] : L["Offline_PinEnrollTitle"])</h1>
            <p class="pos-offline-pin__subtitle">@(_isChange ? L["Offline_PinChangeMessage"] : L["Offline_PinEnrollMessage"])</p>
        </header>

        @if (!string.IsNullOrEmpty(_error))
        {
            <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
        }

        <div class="pos-offline-pin__field">
            <label class="pos-offline-pin__label" for="offline-pin-enroll">@L["Offline_PinLabel"]</label>
            <div class="pos-offline-pin__input-wrap">
                <input id="offline-pin-enroll"
                       type="@(_showPin ? "text" : "password")"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="new-password"
                       maxlength="12"
                       class="pos-offline-pin__input"
                       disabled="@_busy"
                       aria-invalid="@(!string.IsNullOrEmpty(_error))"
                       @bind="_pin"
                       @bind:event="oninput" />
                <button type="button"
                        class="pos-offline-pin__toggle"
                        disabled="@_busy"
                        aria-pressed="@_showPin"
                        aria-label="@(_showPin ? L["Offline_PinHide"] : L["Offline_PinShow"])"
                        @onclick="TogglePinVisibility">
                    @(_showPin ? L["Offline_PinHide"] : L["Offline_PinShow"])
                </button>
            </div>
        </div>

        <div class="pos-offline-pin__field">
            <label class="pos-offline-pin__label" for="offline-pin-confirm">@L["Offline_PinConfirmLabel"]</label>
            <div class="pos-offline-pin__input-wrap">
                <input id="offline-pin-confirm"
                       type="@(_showPin ? "text" : "password")"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="new-password"
                       maxlength="12"
                       class="pos-offline-pin__input"
                       disabled="@_busy"
                       @bind="_confirm"
                       @bind:event="oninput"
                       @onkeydown="OnConfirmKeyDownAsync" />
            </div>
        </div>

        <div class="pos-offline-pin__actions" role="group">
            <Button Variant="ButtonVariant.Primary" IsLoading="_busy" Disabled="_busy" OnClick="SaveAsync">
                @(_isChange ? L["Offline_PinChangeAction"] : L["Offline_PinEnrollAction"])
            </Button>
            @if (_isChange)
            {
                <Button Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="GoBack">
                    @L["Common_Cancel"]
                </Button>
            }
        </div>
    </Page>
</div>

@code {
    private string _pin = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _isChange;
    private bool _showPin;
    private string? _returnPath;

    private void TogglePinVisibility() => _showPin = !_showPin;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        _isChange = TryGetQueryValue(uri, "mode", out var mode)
                    && string.Equals(mode, "change", StringComparison.OrdinalIgnoreCase);
        if (TryGetQueryValue(uri, "return", out var ret) && !string.IsNullOrWhiteSpace(ret) && ret.StartsWith("/", StringComparison.Ordinal))
        {
            _returnPath = ret;
        }

        var hasPin = await Auth.HasOfflinePinConfiguredAsync();
        if (!hasPin)
        {
            // Mandatory enrollment: never auto-dismiss. A leftover device PIN from another
            // account is cleared on grant establish and must be set again here.
            _isChange = false;
            return;
        }

        if (!_isChange)
        {
            // Deep-link to setup when this user already enrolled — continue first-time flow.
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
    }

    private async Task OnConfirmKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_busy)
        {
            return;
        }

        _error = null;
        if (!string.Equals(_pin, _confirm, StringComparison.Ordinal))
        {
            _error = L["Offline_PinConfirmMismatch"];
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.SetOfflinePinAsync(_pin);
            if (!result.Succeeded)
            {
                _error = L[result.SafeMessageKey ?? "Offline_PinInvalidFormat"];
                return;
            }

            if (!string.IsNullOrWhiteSpace(_returnPath))
            {
                Nav.NavigateTo(_returnPath!, replace: true);
                return;
            }

            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(_returnPath))
        {
            Nav.NavigateTo(_returnPath!, replace: true);
            return;
        }

        Nav.NavigateTo("/personal/settings", replace: true);
    }

    private static bool TryGetQueryValue(Uri uri, string key, out string value)
    {
        value = string.Empty;
        var query = uri.Query;
        if (string.IsNullOrEmpty(query) || query.Length < 2)
        {
            return false;
        }

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            var rawKey = eq >= 0 ? part[..eq] : part;
            if (!string.Equals(Uri.UnescapeDataString(rawKey), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            value = eq >= 0
                ? Uri.UnescapeDataString(part[(eq + 1)..].Replace('+', ' '))
                : string.Empty;
            return true;
        }

        return false;
    }
}

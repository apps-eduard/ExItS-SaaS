@page "/organization-select"
@layout Layout.AuthShell
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IProductAccessResolver Access
@inject IOnboardingPreferenceStore Prefs
@inject SellingModeService SellingMode
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["OrgSelect_Title"]" Subtitle="@(_isOwner ? L["OrgSelect_SubtitleOwner"] : L["OrgSelect_SubtitleStaff"])" />

    @if (_loading)
    {
        <Stack Align="StackAlign.Center" Gap="3">
            <Spinner />
            <span>@L["Common_Loading"]</span>
        </Stack>
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_organizations.Count == 0)
    {
        <EmptyState Title="@L["OrgSelect_NoneTitle"]" Message="@L["OrgSelect_NoneEligible"]" />
        <FormActions>
            <Button Variant="ButtonVariant.Primary" OnClick="GoStartBusiness">@L["Personal_StartBusiness"]</Button>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoPersonalAsync">@L["Personal_HomeTitle"]</Button>
            <Button Variant="ButtonVariant.Ghost" OnClick="LogoutAsync">@L["Auth_Logout"]</Button>
        </FormActions>
    }
    else
    {
        <InlineMessage Tone="InlineMessageTone.Info">@(_isOwner ? L["OrgSelect_HintOwnerRoles"] : L["OrgSelect_HintStaff"])</InlineMessage>
        <Stack Gap="3">
            @foreach (var org in _organizations)
            {
                <Card>
                    <Stack Gap="2">
                        <span class="pos-value-md">@org.DisplayName</span>
                        <span class="pos-muted">@(string.IsNullOrWhiteSpace(org.MembershipRole) ? org.MembershipStatus : org.MembershipRole)</span>
                        @if (OrganizationMembershipRoles.IsOwnerRole(org.MembershipRole))
                        {
                            <Stack Gap="2">
                                <Button Disabled="_busy" OnClick="() => SelectAsAsync(org.OrganizationId, RoleHomeResolver.OwnerHome)">@L["OrgSelect_EnterOwner"]</Button>
                                <Button Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="() => SelectAsAsync(org.OrganizationId, RoleHomeResolver.ManagerHome)">@L["OrgSelect_EnterManager"]</Button>
                                <Button Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="() => SelectAsAsync(org.OrganizationId, RoleHomeResolver.CashierHome)">@L["OrgSelect_EnterCashier"]</Button>
                            </Stack>
                        }
                        else
                        {
                            <Button Disabled="_busy" OnClick="() => SelectAsAsync(org.OrganizationId, preferredHome: null)">@L["OrgSelect_Choose"]</Button>
                        }
                    </Stack>
                </Card>
            }
        </Stack>
        @if (_isOwner)
        {
            <FormActions>
                <Button Variant="ButtonVariant.Ghost" OnClick="GoPersonalAsync">@L["Personal_HomeTitle"]</Button>
            </FormActions>
        }
        else
        {
            <FormActions>
                <Button Variant="ButtonVariant.Ghost" OnClick="LogoutAsync">@L["Auth_Logout"]</Button>
            </FormActions>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
        }
    }
</Page>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _authenticated;
    private bool _isOwner;
    private string? _error;
    private IReadOnlyList<EligibleOrganization> _organizations = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (!restore.Succeeded)
                {
                    _authenticated = false;
                    return;
                }
            }

            _authenticated = CurrentUser.IsAuthenticated;
            if (!_authenticated || CurrentUser.Session is null)
            {
                return;
            }

            _organizations = await Access.ListEligibleOrganizationsAsync(CurrentUser.Session.UserId);
            _isOwner = OrganizationMembershipRoles.HasOrganizationOwner(_organizations);

            // Staff with exactly one org: enter assigned role UI immediately (no Personal / role chooser).
            if (!_isOwner
                && _organizations.Count == 1
                && CurrentUser.Session.OrganizationId is null)
            {
                await SelectAsAsync(_organizations[0].OrganizationId, preferredHome: null);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectAsAsync(Guid organizationId, string? preferredHome)
    {
        _busy = true;
        _error = null;
        try
        {
            // Set working-as before bind so RoleHome never resolves Access Denied during navigation.
            if (!string.IsNullOrWhiteSpace(preferredHome))
            {
                SellingMode.EnterWorkingAs(preferredHome);
            }
            else
            {
                SellingMode.Clear();
            }

            var result = await Auth.SelectOrganizationAsync(organizationId);
            if (!result.Succeeded)
            {
                SellingMode.Clear();
                _error = L[result.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            // Role homes require POS operate. Membership-only org entry stays on Org essentials.
            if (result.Session is not { HasPosAccess: true })
            {
                SellingMode.Clear();
                await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.AccessConfirm));
                await Prefs.SetOnboardingCompletedAsync(true);
                Nav.NavigateTo(RoleHomeResolver.OrgEssentials, replace: true);
                return;
            }

            await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.AccessConfirm));
            await Prefs.SetOnboardingCompletedAsync(true);
            Nav.NavigateTo(string.IsNullOrWhiteSpace(preferredHome) ? "/" : preferredHome, replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
    private void GoStartBusiness() => Nav.NavigateTo("/start-business");

    private async Task GoPersonalAsync()
    {
        SellingMode.Clear();
        var result = await Auth.SwitchToPersonalAsync();
        if (result.Succeeded)
        {
            Nav.NavigateTo("/personal", replace: true);
        }
    }

    private async Task LogoutAsync()
    {
        SellingMode.Clear();
        await Auth.LogoutAsync();
        Nav.NavigateTo("/signin");
    }
}

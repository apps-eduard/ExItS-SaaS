@page "/organization-select"
@layout Layout.AuthShell
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IProductAccessResolver Access
@inject IPlatformAccessClient Platform
@inject IOnboardingPreferenceStore Prefs
@inject SellingModeService SellingMode
@inject AuthShellIdentityState IdentityState
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IStringLocalizer<PosResources> L

<Page>
    @if (_loading)
    {
        <Stack Align="StackAlign.Center" Gap="3">
            <Spinner />
            <span>@L["Common_Loading"]</span>
        </Stack>
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_organizations.Count == 0)
    {
        <div class="pos-org-select-empty">
            <EmptyState Title="@L["OrgSelect_NoneTitle"]" Message="@L["OrgSelect_NoneEligible"]" />
            <div class="pos-action-grid pos-action-grid--single pos-org-select-empty__actions" role="group">
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="GoExplorePos">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                    <span class="pos-action-tile__label">@L["Personal_ExplorePos"]</span>
                </button>
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="GoPersonalAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
                    <span class="pos-action-tile__label">@L["Personal_HomeTitle"]</span>
                </button>
            </div>
        </div>
    }
    else if (_focusOrg is not null && OrganizationMembershipRoles.IsOwnerRole(_focusOrg.MembershipRole))
    {
        <div class="pos-org-role">
            <header class="pos-org-role__header">
                <h1 class="pos-org-role__title">@L["OrgSelect_RoleTitle"]</h1>
                <p class="pos-org-role__subtitle">@RoleSubtitle</p>
            </header>

            @if (_organizations.Count > 1)
            {
                <Section Title="@L["OrgSelect_OtherOrgsSection"]">
                    <Stack Gap="2">
                        @foreach (var org in _organizations.Where(o => o.OrganizationId != _focusOrg.OrganizationId))
                        {
                            <button type="button"
                                    class="pos-org-role__card pos-org-role__card--button"
                                    disabled="@_busy"
                                    @onclick="() => FocusOrganizationAsync(org)">
                                <Avatar Name="@org.DisplayName"
                                        ImageUrl="@OrgLogo(org.OrganizationId)"
                                        Size="AvatarSize.Md"
                                        Shape="AvatarShape.SoftSquare"
                                        AriaLabel="@org.DisplayName" />
                                <div class="pos-org-role__card-body">
                                    <span class="pos-org-role__card-title">@org.DisplayName</span>
                                    <span class="pos-org-role__card-meta pos-muted">@FriendlyMembershipRole(org.MembershipRole, org.MembershipStatus)</span>
                                </div>
                                <span class="pos-org-role__chevron" aria-hidden="true">›</span>
                            </button>
                        }
                    </Stack>
                </Section>
            }

            <div class="pos-org-role__card" aria-label="@L["OrgSelect_WorkspaceLabel"]">
                <Avatar Name="@_focusOrg.DisplayName"
                        ImageUrl="@OrgLogo(_focusOrg.OrganizationId)"
                        Size="AvatarSize.Lg"
                        Shape="AvatarShape.SoftSquare"
                        AriaLabel="@_focusOrg.DisplayName" />
                <div class="pos-org-role__card-body">
                    <span class="pos-org-role__card-title">@_focusOrg.DisplayName</span>
                    <span class="pos-org-role__card-meta pos-muted">@L["OrgSelect_WorkspaceLabel"]</span>
                </div>
            </div>

            <Section Title="@L["OrgSelect_AvailableRoles"]">
                <Stack Gap="2">
                    <button type="button" class="pos-org-role__row" disabled="@_busy" @onclick="() => SelectAsAsync(_focusOrg.OrganizationId, RoleHomeResolver.OwnerHome)">
                        <span class="pos-org-role__row-icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                        <span class="pos-org-role__row-body">
                            <span class="pos-org-role__row-title">@L["OrgSelect_EnterOwner"]</span>
                            <span class="pos-org-role__row-desc pos-muted">@L["OrgSelect_OwnerDesc"]</span>
                        </span>
                        <span class="pos-org-role__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-org-role__row" disabled="@_busy" @onclick="() => SelectAsAsync(_focusOrg.OrganizationId, RoleHomeResolver.ManagerHome)">
                        <span class="pos-org-role__row-icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-org-role__row-body">
                            <span class="pos-org-role__row-title">@L["OrgSelect_EnterManager"]</span>
                            <span class="pos-org-role__row-desc pos-muted">@L["OrgSelect_ManagerDesc"]</span>
                        </span>
                        <span class="pos-org-role__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-org-role__row" disabled="@_busy" @onclick="() => SelectAsAsync(_focusOrg.OrganizationId, RoleHomeResolver.CashierHome)">
                        <span class="pos-org-role__row-icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                        <span class="pos-org-role__row-body">
                            <span class="pos-org-role__row-title">@L["OrgSelect_EnterCashier"]</span>
                            <span class="pos-org-role__row-desc pos-muted">@L["OrgSelect_CashierDesc"]</span>
                        </span>
                        <span class="pos-org-role__chevron" aria-hidden="true">›</span>
                    </button>
                </Stack>
            </Section>

            <Section Title="@L["OrgSelect_TeamSection"]">
                @if (_teamLoading)
                {
                    <Stack Align="StackAlign.Center" Gap="2">
                        <Spinner />
                    </Stack>
                }
                else if (_team.Count == 0)
                {
                    <EmptyState Title="@L["Org_StaffEmptyTitle"]" Message="@L["Org_StaffEmptyMessage"]" />
                }
                else
                {
                    <Stack Gap="2">
                        @foreach (var member in _team)
                        {
                            <div class="pos-org-role__team">
                                <Avatar Name="@member.DisplayName"
                                        Size="AvatarSize.Md"
                                        Shape="AvatarShape.Circle"
                                        AriaLabel="@member.DisplayName" />
                                <div class="pos-org-role__card-body">
                                    <span class="pos-org-role__row-title">@member.RoleLabel</span>
                                    <span class="pos-org-role__card-meta">@member.DisplayName</span>
                                    <span class="pos-org-role__card-meta pos-muted">@member.Email</span>
                                </div>
                            </div>
                        }
                    </Stack>
                }
            </Section>

            @if (!string.IsNullOrEmpty(_error))
            {
                <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
            }
        </div>
    }
    else
    {
        <header class="pos-org-role__header">
            <h1 class="pos-org-role__title">@L["OrgSelect_Title"]</h1>
            <p class="pos-org-role__subtitle">@L["OrgSelect_SubtitleStaff"]</p>
        </header>
        <Stack Gap="3">
            @foreach (var org in _organizations)
            {
                <button type="button"
                        class="pos-org-role__card pos-org-role__card--button"
                        disabled="@_busy"
                        @onclick="() => SelectAsAsync(org.OrganizationId, preferredHome: null)">
                    <Avatar Name="@org.DisplayName"
                            ImageUrl="@OrgLogo(org.OrganizationId)"
                            Size="AvatarSize.Lg"
                            Shape="AvatarShape.SoftSquare"
                            AriaLabel="@org.DisplayName" />
                    <div class="pos-org-role__card-body">
                        <span class="pos-org-role__card-title">@org.DisplayName</span>
                        <span class="pos-org-role__card-meta pos-muted">@FriendlyMembershipRole(org.MembershipRole, org.MembershipStatus)</span>
                        <span class="pos-org-role__card-meta pos-muted">@L["OrgSelect_Choose"]</span>
                    </div>
                    <span class="pos-org-role__chevron" aria-hidden="true">›</span>
                </button>
            }
        </Stack>
        @if (!string.IsNullOrEmpty(_error))
        {
            <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
        }
    }
</Page>

@code {
    private sealed record TeamMemberRow(string RoleLabel, string DisplayName, string Email);

    private bool _loading = true;
    private bool _busy;
    private bool _authenticated;
    private bool _isOwner;
    private bool _teamLoading;
    private string? _error;
    private IReadOnlyList<EligibleOrganization> _organizations = [];
    private EligibleOrganization? _focusOrg;
    private IReadOnlyList<TeamMemberRow> _team = [];
    private readonly Dictionary<Guid, string?> _orgLogos = new();

    private string RoleSubtitle =>
        string.Format(L["OrgSelect_RoleSubtitle"].Value, _focusOrg?.DisplayName ?? L["Shell_OrganizationFallback"].Value);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public void Dispose() => IdentityState.Clear();

    private string? OrgLogo(Guid organizationId) =>
        _orgLogos.TryGetValue(organizationId, out var url) ? url : null;

    private string FriendlyMembershipRole(string? role, string status)
    {
        if (OrganizationMembershipRoles.IsOwnerRole(role))
        {
            return L["OrgSelect_EnterOwner"];
        }

        if (string.Equals(role, "StoreManager", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase))
        {
            return L["OrgSelect_EnterManager"];
        }

        if (string.Equals(role, "Cashier", StringComparison.OrdinalIgnoreCase))
        {
            return L["OrgSelect_EnterCashier"];
        }

        if (!string.IsNullOrWhiteSpace(role)
            && role.StartsWith("Organization", StringComparison.OrdinalIgnoreCase)
            && role.Length > "Organization".Length)
        {
            return role["Organization".Length..];
        }

        return string.IsNullOrWhiteSpace(role) ? status : role;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (!restore.Succeeded)
                {
                    _authenticated = false;
                    IdentityState.Clear();
                    return;
                }
            }

            _authenticated = CurrentUser.IsAuthenticated;
            if (!_authenticated || CurrentUser.Session is null)
            {
                IdentityState.Clear();
                return;
            }

            _organizations = await Access.ListEligibleOrganizationsAsync(CurrentUser.Session.UserId);
            _isOwner = OrganizationMembershipRoles.HasOrganizationOwner(_organizations);
            await LoadOrganizationLogosAsync();
            ResolveFocusOrganization();
            PublishTopBarPreview();

            // Exactly one org (owned or assigned) and not already bound: enter it directly.
            // Multi-org users stay on this chooser (including Personal → Organization switches).
            if (_organizations.Count == 1 && CurrentUser.Session.OrganizationId is null)
            {
                var only = _organizations[0];
                var preferred = OrganizationMembershipRoles.IsOwnerRole(only.MembershipRole)
                    ? RoleHomeResolver.OwnerHome
                    : null;
                await SelectAsAsync(only.OrganizationId, preferred);
                return;
            }

            if (_focusOrg is not null && OrganizationMembershipRoles.IsOwnerRole(_focusOrg.MembershipRole))
            {
                await LoadTeamAsync(_focusOrg.OrganizationId);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResolveFocusOrganization()
    {
        var session = CurrentUser.Session;
        EligibleOrganization? preview = null;
        if (session?.OrganizationId is Guid activeId)
        {
            preview = _organizations.FirstOrDefault(o => o.OrganizationId == activeId);
        }

        preview ??= _organizations.FirstOrDefault(o => OrganizationMembershipRoles.IsOwnerRole(o.MembershipRole))
                    ?? _organizations.FirstOrDefault();

        _focusOrg = preview;
    }

    private async Task FocusOrganizationAsync(EligibleOrganization org)
    {
        _focusOrg = org;
        PublishTopBarPreview();
        await LoadTeamAsync(org.OrganizationId);
    }

    private void PublishTopBarPreview()
    {
        if (_focusOrg is null)
        {
            IdentityState.Clear();
            return;
        }

        IdentityState.SetOrganizationPreview(
            _focusOrg.OrganizationId,
            _focusOrg.DisplayName,
            _focusOrg.MembershipRole,
            orgSelectChrome: true);
    }

    private async Task LoadOrganizationLogosAsync()
    {
        _orgLogos.Clear();
        foreach (var org in _organizations)
        {
            try
            {
                var result = await Platform.GetOrganizationAsync(org.OrganizationId);
                var logo = result.IsSuccess ? result.Data?.Branding?.LogoUrl : null;
                _orgLogos[org.OrganizationId] = string.IsNullOrWhiteSpace(logo) ? null : logo.Trim();
            }
            catch
            {
                _orgLogos[org.OrganizationId] = null;
            }
        }
    }

    private async Task LoadTeamAsync(Guid organizationId)
    {
        _teamLoading = true;
        _team = [];
        try
        {
            var membersResult = await Platform.GetOrganizationMembersAsync(organizationId, status: "Active");
            if (!membersResult.IsSuccess || membersResult.Data is null)
            {
                return;
            }

            var grantsResult = await Platform.GetProductLocalRolesAsync(organizationId, status: "Active");
            var grants = grantsResult.IsSuccess && grantsResult.Data is not null
                ? grantsResult.Data
                : [];

            var rows = new List<TeamMemberRow>();
            foreach (var member in membersResult.Data.Items
                         .OrderBy(m => RoleSortKey(
                             m.Role,
                             grants.FirstOrDefault(g => g.UserIdentityId == m.UserId)?.MappedPosRoleCode
                             ?? grants.FirstOrDefault(g => g.UserIdentityId == m.UserId)?.RoleCode)))
            {
                var grant = grants.FirstOrDefault(g => g.UserIdentityId == member.UserId);
                var displayName = FirstMeaningful(
                    member.DisplayName,
                    grant?.UserDisplayName,
                    member.Username,
                    member.Email);
                var email = member.Email ?? string.Empty;

                // Avoid a GetUser storm on org-select (burns Platform rate limits before Owner bind).
                if (string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(email))
                {
                    try
                    {
                        var userResult = await Platform.GetUserAsync(member.UserId);
                        if (userResult.IsSuccess && userResult.Data is not null)
                        {
                            displayName = FirstMeaningful(
                                displayName,
                                userResult.Data.DisplayName,
                                userResult.Data.Username,
                                userResult.Data.Email);
                            if (string.IsNullOrWhiteSpace(email))
                            {
                                email = userResult.Data.Email ?? string.Empty;
                            }
                        }
                    }
                    catch
                    {
                        // Keep membership / grant fallbacks below.
                    }
                }

                if (string.IsNullOrWhiteSpace(displayName))
                {
                    displayName = L["Org_StaffUnknownName"];
                }

                var roleLabel = FriendlyPosOrMembershipRole(
                    grant?.MappedPosRoleCode ?? grant?.RoleCode,
                    member.Role,
                    member.Status);

                rows.Add(new TeamMemberRow(roleLabel, displayName, email));
            }

            _team = rows;
        }
        finally
        {
            _teamLoading = false;
        }
    }

    private static int RoleSortKey(string membershipRole, string? posRole)
    {
        var key = posRole ?? membershipRole;
        if (OrganizationMembershipRoles.IsOwnerRole(key) || string.Equals(key, "Owner", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        if (string.Equals(key, "StoreManager", StringComparison.OrdinalIgnoreCase)
            || string.Equals(key, "Manager", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        if (string.Equals(key, "Cashier", StringComparison.OrdinalIgnoreCase))
        {
            return 2;
        }

        return 3;
    }

    private string FriendlyPosOrMembershipRole(string? posRole, string? membershipRole, string status)
    {
        if (!string.IsNullOrWhiteSpace(posRole))
        {
            if (string.Equals(posRole, "Owner", StringComparison.OrdinalIgnoreCase)
                || string.Equals(posRole, "OrganizationOwner", StringComparison.OrdinalIgnoreCase))
            {
                return L["OrgSelect_EnterOwner"];
            }

            if (string.Equals(posRole, "StoreManager", StringComparison.OrdinalIgnoreCase)
                || string.Equals(posRole, "Manager", StringComparison.OrdinalIgnoreCase))
            {
                return L["OrgSelect_EnterManager"];
            }

            if (string.Equals(posRole, "Cashier", StringComparison.OrdinalIgnoreCase))
            {
                return L["OrgSelect_EnterCashier"];
            }
        }

        return FriendlyMembershipRole(membershipRole, status);
    }

    private async Task SelectAsAsync(Guid organizationId, string? preferredHome)
    {
        _busy = true;
        _error = null;
        try
        {
            var org = _organizations.FirstOrDefault(o => o.OrganizationId == organizationId);
            if (org is not null)
            {
                _focusOrg = org;
                IdentityState.SetOrganizationPreview(
                    org.OrganizationId,
                    org.DisplayName,
                    org.MembershipRole,
                    orgSelectChrome: true);
            }

            // Set working-as before bind so RoleHome never resolves Access Denied during navigation.
            if (!string.IsNullOrWhiteSpace(preferredHome))
            {
                SellingMode.EnterWorkingAs(preferredHome);
            }
            else
            {
                SellingMode.Clear();
            }

            var result = await Auth.SelectOrganizationAsync(organizationId);
            if (!result.Succeeded)
            {
                SellingMode.Clear();
                _error = L[result.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            // Role homes require POS operate. Membership-only org entry stays on Org essentials.
            if (result.Session is not { HasPosAccess: true })
            {
                SellingMode.Clear();
                await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.AccessConfirm));
                await Prefs.SetOnboardingCompletedAsync(true);
                Nav.NavigateTo(RoleHomeResolver.OrgEssentials, replace: true);
                return;
            }

            await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.AccessConfirm));
            await Prefs.SetOnboardingCompletedAsync(true);
            // Always resolve through the gate so missing PIN / incomplete setup are forced before role homes.
            // SellingMode.EnterWorkingAs (preferredHome) is already set for ResolvePosHomeAsync.
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
    private void GoExplorePos() => Nav.NavigateTo("/personal/explore-pos");

    private static string? FirstMeaningful(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return null;
    }

    private async Task GoPersonalAsync()
    {
        SellingMode.Clear();
        IdentityState.Clear();
        var result = await Auth.SwitchToPersonalAsync();
        if (result.Succeeded)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
    }
}

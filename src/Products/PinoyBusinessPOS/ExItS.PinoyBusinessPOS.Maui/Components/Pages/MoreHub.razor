@page "/more"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject OfflineAwareNavigation OfflineNav
@inject NavigationGate Gate
@inject RoleHomeResolver RoleHome
@inject ICurrentUserContext CurrentUser
@inject IOrganizationOwnerProbe OrganizationOwner
@inject IUtangCapabilityEvaluator Capabilities
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<div class="pos-dash pos-more">
    <Page>
        <header class="pos-more__header">
            <h1 class="pos-more__title">@L["Nav_More"]</h1>
            <p class="pos-more__subtitle">@L["More_Subtitle"]</p>
        </header>

        @if (_incomingPendingCount > 0)
        {
            <Alert Tone="AlertTone.Info"
                   Title="@L["ConnectedSuppliers_IncomingCompact", _incomingPendingCount]" />
            <div class="pos-action-grid pos-action-grid--single" role="group">
                <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="GoIncomingRequests">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                    <span class="pos-action-tile__label">@L["ConnectedSuppliers_ReviewIncoming"]</span>
                </button>
            </div>
        }

        <Section Title="@L["More_WorkspaceSection"]">
            <div class="pos-action-grid" role="group" aria-label="@L["More_WorkspaceSection"]">
                @if (CurrentUser.HasPosAccess)
                {
                    <button type="button" class="pos-action-tile" @onclick="GoRoleHome">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
                        <span class="pos-action-tile__label">@L["More_RoleHome"]</span>
                    </button>
                }
                <button type="button" class="pos-action-tile" @onclick="GoOrg">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                    <span class="pos-action-tile__label">@L["Org_SummaryTitle"]</span>
                </button>
            </div>
        </Section>

        <AccountContextSwitcher />

        @if (CurrentUser.Session?.OrganizationId is not null && CurrentUser.HasPosAccess)
        {
            @if (_isOrganizationOwner)
            {
                <Section Title="@L["More_BusinessSection"]">
                    <div class="pos-action-grid" role="group" aria-label="@L["More_BusinessSection"]">
                        <button type="button" class="pos-action-tile" @onclick="GoBranches">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
                            <span class="pos-action-tile__label">@L["Branches_Title"]</span>
                        </button>
                        <button type="button" class="pos-action-tile" @onclick="GoSalesDocumentEducation">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
                            <span class="pos-action-tile__label">@L["SalesDocument_EducationTitle"]</span>
                        </button>
                        <button type="button" class="pos-action-tile" @onclick="GoTaxCompliance">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                            <span class="pos-action-tile__label">@L["TaxCompliance_Title"]</span>
                        </button>
                    </div>
                </Section>
            }

            <Section Title="@L["More_ToolsSection"]">
                <div class="pos-action-grid" role="group" aria-label="@L["More_ToolsSection"]">
                    @if (Capabilities.IsAllowed(UtangCapability.ViewCustomerOrders)
                         || Capabilities.IsAllowed(UtangCapability.ManageCustomerOrders))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoOrders">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("receipt")</span>
                            <span class="pos-action-tile__label">@L["Orders_Title"]</span>
                        </button>
                    }

                    <button type="button" class="pos-action-tile" @onclick="GoOverdue">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                        <span class="pos-action-tile__label">@L["Overdue_OpenOrg"]</span>
                    </button>

                    @if (Capabilities.IsAllowed(UtangCapability.ViewInventory))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoInventory">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                            <span class="pos-action-tile__label">@L["Nav_Inventory"]</span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ViewExpenses))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoExpenses">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                            <span class="pos-action-tile__label">@L["Nav_Expenses"]</span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ViewSuppliers))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoSuppliers">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                            <span class="pos-action-tile__label">@L["Nav_Suppliers"]</span>
                        </button>
                        <button type="button" class="pos-action-tile" @onclick="GoConnectedBuyers">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                            <span class="pos-action-tile__label">@L["ConnectedBuyers_Title"]</span>
                        </button>
                        <button type="button"
                                class="pos-action-tile @(_incomingPendingCount > 0 ? "pos-action-tile--primary" : null)"
                                @onclick="GoIncomingRequests">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                            <span class="pos-action-tile__label">
                                @L["ConnectedSuppliers_IncomingRequests"]
                                @if (_incomingPendingCount > 0)
                                {
                                    <text> · @_incomingPendingCount</text>
                                }
                            </span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoPurchasing">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                            <span class="pos-action-tile__label">@L["Nav_Purchasing"]</span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ViewRegisters))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoRegisters">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                            <span class="pos-action-tile__label">@L["Nav_Registers"]</span>
                        </button>
                    }

                    @if (_isOrganizationOwner
                        || Capabilities.IsAllowed(UtangCapability.ViewOperationalSetup))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoPrivacy">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
                            <span class="pos-action-tile__label">@L["Privacy_Title"]</span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoSetup">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                            <span class="pos-action-tile__label">@L["Nav_Setup"]</span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ViewShifts))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoShifts">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                            <span class="pos-action-tile__label">@L["Nav_Shifts"]</span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ViewPermissions))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoPermissions">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                            <span class="pos-action-tile__label">@L["Nav_Permissions"]</span>
                        </button>
                    }

                    @if (Capabilities.IsAllowed(UtangCapability.ViewReports)
                         || Capabilities.IsAllowed(UtangCapability.ViewDashboard))
                    {
                        <button type="button" class="pos-action-tile" @onclick="GoReports">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
                            <span class="pos-action-tile__label">@L["Nav_Reports"]</span>
                        </button>
                    }
                </div>
            </Section>
        }

    </Page>
</div>

@code {
    private bool _isOrganizationOwner;
    private int _incomingPendingCount;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid organizationId)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        if (CurrentUser.Session is not null)
        {
            _isOrganizationOwner = await OrganizationOwner.IsExactOrganizationOwnerAsync(
                CurrentUser.Session,
                organizationId);
        }

        // Without POS access this hub stays reachable as the organization-context destination
        // (organization overview, context switching, sign out) instead of bouncing to Home.
        if (!CurrentUser.HasPosAccess)
        {
            return;
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (Capabilities.IsAllowed(UtangCapability.ViewSuppliers)
            && await Connectivity.IsConnectedAsync())
        {
            var incoming = await ConnectedSuppliers.ListRelationshipsAsync("supplier");
            if (incoming.IsSuccess && incoming.Data is not null)
            {
                _incomingPendingCount = incoming.Data.Count(x =>
                    string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase));
            }
        }
    }

    private async Task GoRoleHome() => Nav.NavigateTo(await RoleHome.ResolvePosHomeAsync());
    private Task GoOrg() => OfflineNav.NavigateAsync("/org");
    private Task GoBranches() => OfflineNav.NavigateAsync("/organization/branches");
    private Task GoOrders() => OfflineNav.NavigateAsync("/orders");
    private Task GoSalesDocumentEducation() => OfflineNav.NavigateAsync("/sales-document-education");
    private Task GoTaxCompliance() => OfflineNav.NavigateAsync("/organization/tax-compliance");
    private Task GoOverdue() => OfflineNav.NavigateAsync("/overdue");
    private Task GoInventory() => OfflineNav.NavigateAsync("/inventory");
    private Task GoExpenses() => OfflineNav.NavigateAsync("/expenses");
    private Task GoSuppliers() => OfflineNav.NavigateAsync("/suppliers");
    private Task GoConnectedBuyers() => OfflineNav.NavigateAsync("/suppliers/connected/buyers");
    private Task GoIncomingRequests() => OfflineNav.NavigateAsync("/suppliers/connected/requests");
    private Task GoPurchasing() => OfflineNav.NavigateAsync("/purchasing");
    private Task GoRegisters() => OfflineNav.NavigateAsync("/registers");
    private async Task GoSetup() =>
        await OfflineNav.NavigateAsync(await Gate.ResolveOperationalSetupRouteAsync());
    private Task GoPrivacy() => OfflineNav.NavigateAsync("/org/privacy");
    private Task GoShifts() => OfflineNav.NavigateAsync("/shifts");
    private Task GoPermissions() => OfflineNav.NavigateAsync("/permissions");
    private Task GoReports() => OfflineNav.NavigateAsync("/reports");
}

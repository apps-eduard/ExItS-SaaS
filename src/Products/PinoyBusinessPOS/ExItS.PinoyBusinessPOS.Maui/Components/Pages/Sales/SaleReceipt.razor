@page "/sales/{SaleId:guid}/receipt"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Payments
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSaleClient Sales
@inject IPosPaymentAttemptClient PaymentAttempts
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/sales" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Sales_Loading"]</span></Page>
}
else if (_sale is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Sales_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Sales_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
    var sale = _sale;
<div class="pos-sale-receipt">
<Page>
    <header class="pos-sale-receipt__header">
        <div class="pos-sale-receipt__title-row">
            <h1 class="pos-sale-receipt__title">@L["SalesDocument_TransactionSummaryTitle"]</h1>
            <button type="button"
                    class="pos-sale-receipt__new"
                    @onclick="GoNextSale">
                <span class="pos-sale-receipt__new-icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span>@L["Sales_New"]</span>
            </button>
        </div>
        <p class="pos-sale-receipt__subtitle">@L["SalesDocument_TransactionSummarySubtitle"] · @sale.SaleNumber</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Sales_OfflineTitle"]" Message="@L["Sales_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Sales_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-sale-receipt__panel" aria-labelledby="sale-receipt-header-heading">
        <h2 id="sale-receipt-header-heading" class="pos-sale-receipt__section-title">@L["Sales_Field_ReceiptHeader"]</h2>
        <div class="pos-sale-receipt__amount">
            <span class="pos-sale-receipt__amount-label">@L["Sales_Col_Total"]</span>
            <div class="pos-sale-receipt__amount-value">
                <MoneyDisplay Amount="@sale.Total" CurrencyCode="@(sale.CurrencyCode ?? "PHP")" Emphasized="true" />
            </div>
        </div>
        <dl class="pos-sale-receipt__facts">
            @if (!string.IsNullOrWhiteSpace(sale.StoreDisplayName))
            {
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_Store"]</dt>
                    <dd>@sale.StoreDisplayName</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(sale.ReceiptHeader))
            {
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_ReceiptHeader"]</dt>
                    <dd class="pos-wrap">@sale.ReceiptHeader</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(sale.BusinessAddress))
            {
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_BusinessAddress"]</dt>
                    <dd class="pos-wrap">@sale.BusinessAddress</dd>
                </div>
            }
            <div class="pos-sale-receipt__fact">
                <dt>@L["Payment_RecordedAt"]</dt>
                <dd>@sale.RecordedAtUtc.ToLocalTime().ToString("g")</dd>
            </div>
            <div class="pos-sale-receipt__fact">
                <dt>@L["Sales_Field_PaymentMethod"]</dt>
                <dd>@SalesUiOptions.PaymentMethodLabel(L, sale.PaymentMethod)</dd>
            </div>
            @if (sale.CustomerId is not null)
            {
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_SoldTo"]</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(sale.CustomerDisplayName)
                            ? L["Sales_Detail_CustomerFallback"]
                            : sale.CustomerDisplayName)
                    </dd>
                </div>
            }
            @if (_paymentAttempt is not null)
            {
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_PaymentStatus"]</dt>
                    <dd>@PaymentsUiOptions.AttemptStatusLabel(L, _paymentAttempt.Status)</dd>
                </div>
            }
        </dl>
    </section>

    @if (_paymentAttempt is not null)
    {
        <section class="pos-sale-receipt__panel" aria-labelledby="sale-receipt-epay-heading">
            <h2 id="sale-receipt-epay-heading" class="pos-sale-receipt__section-title">@L["Sales_EPayment_Section"]</h2>
            <dl class="pos-sale-receipt__facts">
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_PaymentStatus"]</dt>
                    <dd>@PaymentsUiOptions.AttemptStatusLabel(L, _paymentAttempt.Status)</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.Provider))
                {
                    <div class="pos-sale-receipt__fact">
                        <dt>@L["Sales_Field_Provider"]</dt>
                        <dd>@_paymentAttempt.Provider</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.ProviderReference))
                {
                    <div class="pos-sale-receipt__fact">
                        <dt>@L["Sales_Field_ProviderReference"]</dt>
                        <dd class="pos-wrap">@_paymentAttempt.ProviderReference</dd>
                    </div>
                }
                @if (_paymentAttempt.CompletedAtUtc is DateTimeOffset paidAt)
                {
                    <div class="pos-sale-receipt__fact">
                        <dt>@L["Sales_Field_PaidAt"]</dt>
                        <dd>@paidAt.ToLocalTime().ToString("g")</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.CardBrand))
                {
                    <div class="pos-sale-receipt__fact">
                        <dt>@L["Sales_Field_CardBrand"]</dt>
                        <dd>@_paymentAttempt.CardBrand</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.CardLastFour))
                {
                    <div class="pos-sale-receipt__fact">
                        <dt>@L["Sales_Field_CardLastFour"]</dt>
                        <dd>@_paymentAttempt.CardLastFour</dd>
                    </div>
                }
            </dl>
        </section>
    }

    <section class="pos-sale-receipt__panel" aria-labelledby="sale-receipt-lines-heading">
        <h2 id="sale-receipt-lines-heading" class="pos-sale-receipt__section-title">@L["Sales_LinesSection"]</h2>
        <div class="pos-sale-receipt__list" role="list">
            @foreach (var line in sale.Lines.OrderBy(l => l.LineNumber))
            {
                <article class="pos-sale-receipt__entry" role="listitem">
                    <div class="pos-sale-receipt__entry-top">
                        <span class="pos-sale-receipt__entry-name">@line.Name</span>
                        <span class="pos-sale-receipt__entry-amount">@line.LineTotal.ToString("N2")</span>
                    </div>
                    <p class="pos-sale-receipt__entry-meta">
                        @line.Quantity.ToString("0.###") × @line.UnitPrice.ToString("N2")
                    </p>
                </article>
            }
        </div>
    </section>

    <section class="pos-sale-receipt__panel" aria-labelledby="sale-receipt-totals-heading">
        <h2 id="sale-receipt-totals-heading" class="pos-sale-receipt__section-title">@L["Sales_DetailSection"]</h2>
        <dl class="pos-sale-receipt__facts">
            <div class="pos-sale-receipt__fact">
                <dt>@L["Sales_Field_Subtotal"]</dt>
                <dd>@sale.Subtotal.ToString("N2")</dd>
            </div>
            <div class="pos-sale-receipt__fact">
                <dt>@L["Sales_Col_Total"]</dt>
                <dd>@sale.Total.ToString("N2")</dd>
            </div>
            @if (sale.AmountTendered is decimal tendered)
            {
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_AmountTendered"]</dt>
                    <dd>@tendered.ToString("N2")</dd>
                </div>
            }
            @if (sale.ChangeAmount is decimal change)
            {
                <div class="pos-sale-receipt__fact">
                    <dt>@L["Sales_Field_ChangeAmount"]</dt>
                    <dd>@change.ToString("N2")</dd>
                </div>
            }
        </dl>
        @if (!string.IsNullOrWhiteSpace(sale.ReceiptFooter))
        {
            <p class="pos-sale-receipt__footer pos-wrap">@sale.ReceiptFooter</p>
        }
    </section>

    <section class="pos-sale-receipt__panel" aria-labelledby="sale-document-disclaimer-heading">
        <h2 id="sale-document-disclaimer-heading" class="pos-sale-receipt__section-title">@L["SalesDocument_DisclaimerTitle"]</h2>
        <p class="pos-sale-receipt__footer pos-wrap">@L["SalesDocument_DisclaimerBody"]</p>
    </section>

    <div class="pos-action-grid pos-action-grid--single pos-sale-receipt__actions" role="group">
        <button type="button"
                class="pos-action-tile pos-action-tile--primary"
                @onclick="GoNextSale">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
            <span class="pos-action-tile__label">@L["Sales_New"]</span>
        </button>
    </div>
</Page>
</div>
}

@code {
    [Parameter] public Guid SaleId { get; set; }

    [SupplyParameterFromQuery(Name = "attemptId")]
    public Guid? AttemptId { get; set; }

    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private PosSaleDto? _sale;
    private PaymentAttemptDto? _paymentAttempt;
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewSales))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _sale = null;
            _loading = false;
            return;
        }

        var result = await Sales.GetSaleAsync(SaleId);
        _loading = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _sale = result.Data;
            if (_sale.Status != PosSaleOptions.CompletedStatus)
            {
                Nav.NavigateTo($"/sales/{SaleId:D}", replace: true);
                return;
            }

            await LoadPaymentAttemptAsync();
            return;
        }

        _sale = null;
        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }

    private async Task LoadPaymentAttemptAsync()
    {
        if (AttemptId is not Guid attemptId || attemptId == Guid.Empty)
        {
            return;
        }

        var attemptResult = await PaymentAttempts.GetAsync(attemptId);
        if (attemptResult.IsSuccess && attemptResult.Data is not null && attemptResult.Data.SaleId == SaleId)
        {
            _paymentAttempt = attemptResult.Data;
        }
    }

    private void GoNextSale() => Nav.NavigateTo("/sales/new");
}

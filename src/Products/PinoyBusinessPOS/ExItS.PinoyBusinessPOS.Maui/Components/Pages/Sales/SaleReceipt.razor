@page "/sales/{SaleId:guid}/receipt"
@using ExItS.PinoyBusinessPOS.Application.Payments
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSaleClient Sales
@inject IPosPaymentAttemptClient PaymentAttempts
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/sales" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Sales_Loading"]</span></Page>
}
else if (_sale is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Sales_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Sales_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
    var sale = _sale;
<Page>
    <PageHeader Title="@L["Sales_DetailSubtitle"]" Subtitle="@sale.SaleNumber">
        <Actions>
            <Button Variant="ButtonVariant.Primary" OnClick="GoNextSale">@L["Sales_New"]</Button>
        </Actions>
    </PageHeader>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Sales_OfflineTitle"]" Message="@L["Sales_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Sales_ErrorTitle"])" Message="@_errorMessage" />
    }

    <Section Title="@L["Sales_Field_ReceiptHeader"]">
        <Stack Gap="2">
            @if (!string.IsNullOrWhiteSpace(sale.StoreDisplayName))
            {
                <div class="pos-value-md">@sale.StoreDisplayName</div>
            }
            @if (!string.IsNullOrWhiteSpace(sale.ReceiptHeader))
            {
                <div class="pos-muted pos-wrap">@sale.ReceiptHeader</div>
            }
            @if (!string.IsNullOrWhiteSpace(sale.BusinessAddress))
            {
                <div class="pos-muted pos-wrap">@sale.BusinessAddress</div>
            }
            <div>@sale.RecordedAtUtc.ToLocalTime().ToString("g")</div>
            <div>@SalesUiOptions.PaymentMethodLabel(L, sale.PaymentMethod)</div>
            @if (_paymentAttempt is not null)
            {
                <div class="pos-muted">@PaymentsUiOptions.AttemptStatusLabel(L, _paymentAttempt.Status)</div>
            }
        </Stack>
    </Section>

    @if (_paymentAttempt is not null)
    {
        <Section Title="@L["Sales_EPayment_Section"]">
            <Stack Gap="2">
                <div>@L["Sales_Field_PaymentStatus"]: <strong>@PaymentsUiOptions.AttemptStatusLabel(L, _paymentAttempt.Status)</strong></div>
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.Provider))
                {
                    <div>@L["Sales_Field_Provider"]: <strong>@_paymentAttempt.Provider</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.ProviderReference))
                {
                    <div>@L["Sales_Field_ProviderReference"]: <strong>@_paymentAttempt.ProviderReference</strong></div>
                }
                @if (_paymentAttempt.CompletedAtUtc is DateTimeOffset paidAt)
                {
                    <div>@L["Sales_Field_PaidAt"]: <strong>@paidAt.ToLocalTime().ToString("g")</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.CardBrand))
                {
                    <div>@L["Sales_Field_CardBrand"]: <strong>@_paymentAttempt.CardBrand</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(_paymentAttempt.CardLastFour))
                {
                    <div>@L["Sales_Field_CardLastFour"]: <strong>@_paymentAttempt.CardLastFour</strong></div>
                }
            </Stack>
        </Section>
    }

    <Section Title="@L["Sales_LinesSection"]">
        <Stack Gap="2">
            @foreach (var line in sale.Lines.OrderBy(l => l.LineNumber))
            {
                <div>
                    <strong>@line.Name</strong>
                    <div class="pos-muted">@line.Quantity.ToString("0.###") × @line.UnitPrice.ToString("N2") = @line.LineTotal.ToString("N2")</div>
                </div>
            }
        </Stack>
    </Section>

    <Section Title="@L["Sales_DetailSection"]">
        <Stack Gap="2">
            <div>@L["Sales_Field_Subtotal"]: <strong>@sale.Subtotal.ToString("N2")</strong></div>
            <div>@L["Sales_Col_Total"]: <strong>@sale.Total.ToString("N2")</strong></div>
            @if (sale.AmountTendered is decimal tendered)
            {
                <div>@L["Sales_Field_AmountTendered"]: <strong>@tendered.ToString("N2")</strong></div>
            }
            @if (sale.ChangeAmount is decimal change)
            {
                <div>@L["Sales_Field_ChangeAmount"]: <strong>@change.ToString("N2")</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(sale.ReceiptFooter))
            {
                <div class="pos-muted pos-wrap">@sale.ReceiptFooter</div>
            }
        </Stack>
    </Section>

    <FormActions>
        <Button Variant="ButtonVariant.Primary" OnClick="GoNextSale">@L["Sales_New"]</Button>
    </FormActions>
</Page>
}

@code {
    [Parameter] public Guid SaleId { get; set; }

    [SupplyParameterFromQuery(Name = "attemptId")]
    public Guid? AttemptId { get; set; }

    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private PosSaleDto? _sale;
    private PaymentAttemptDto? _paymentAttempt;
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewSales))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _sale = null;
            _loading = false;
            return;
        }

        var result = await Sales.GetSaleAsync(SaleId);
        _loading = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _sale = result.Data;
            if (_sale.Status != PosSaleOptions.CompletedStatus)
            {
                Nav.NavigateTo($"/sales/{SaleId:D}", replace: true);
                return;
            }

            await LoadPaymentAttemptAsync();
            return;
        }

        _sale = null;
        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }

    private async Task LoadPaymentAttemptAsync()
    {
        if (AttemptId is not Guid attemptId || attemptId == Guid.Empty)
        {
            return;
        }

        var attemptResult = await PaymentAttempts.GetAsync(attemptId);
        if (attemptResult.IsSuccess && attemptResult.Data is not null && attemptResult.Data.SaleId == SaleId)
        {
            _paymentAttempt = attemptResult.Data;
        }
    }

    private void GoNextSale() => Nav.NavigateTo("/sales/new");
}

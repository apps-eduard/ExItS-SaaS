@page "/sales"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSaleClient Sales
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canView = Capabilities.IsAllowed(UtangCapability.ViewSales);
    var canCreate = Capabilities.IsAllowed(UtangCapability.CreateSale);
<div class="pos-dash pos-sales">
    <Page>
        <header class="pos-sales__header">
            <div class="pos-sales__title-row">
                <h1 class="pos-sales__title">@L["Sales_Title"]</h1>
                <button type="button"
                        class="pos-sales__new"
                        disabled="@(!canCreate)"
                        @onclick="GoNew">
                    <span class="pos-sales__new-icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                    <span>@L["Sales_New"]</span>
                </button>
            </div>
            <p class="pos-sales__subtitle">@L["Sales_Subtitle"]</p>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Sales_OfflineTitle"]" Message="@L["Sales_OfflineMessage"]" />
        }
        else if (!canView)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        }

        <div class="pos-sales__toolbar">
            <SearchBar Value="@_saleNumber"
                       ValueChanged="OnSearchInputAsync"
                       Placeholder="@L["Sales_SearchPlaceholder"]"
                       Disabled="@_loading"
                       ShowFilterButton="true"
                       ActiveFilterCount="@ActiveFilterCount"
                       FiltersExpanded="@_filtersOpen"
                       FiltersControlsId="sales-filters"
                       FilterLabel="@L["Sales_FiltersTitle"]"
                       OnFilterClick="ToggleFilters">
                <FilterChips>
                    @if (HasAppliedFilters)
                    {
                        <div aria-label="@L["Sales_AppliedFilters"]">
                            @foreach (var chip in AppliedFilterChips)
                            {
                                <span class="pos-sales__chip">@chip</span>
                            }
                        </div>
                    }
                </FilterChips>
            </SearchBar>
        </div>

        @if (_filtersOpen)
        {
            <section class="pos-sales__panel" id="sales-filters" aria-labelledby="sales-filters-heading">
                <h2 id="sales-filters-heading" class="pos-sales__section-title">@L["Sales_FiltersTitle"]</h2>
                <div class="pos-sales__form">
                    <Select Label="@L["Sales_Filter_Status"]"
                            Value="@_statusFilter"
                            ValueChanged="OnStatusFilterChanged"
                            Options="@SalesUiOptions.StatusFilters(L)" />
                    <Select Label="@L["Sales_Filter_Payment"]"
                            Value="@_paymentFilter"
                            ValueChanged="OnPaymentFilterChanged"
                            Options="@SalesUiOptions.PaymentMethodFilters(L)" />
                    <DateInput Label="@L["Sales_Filter_FromDate"]"
                               Value="@_fromDate"
                               ValueChanged="OnFromDateChanged" />
                    <DateInput Label="@L["Sales_Filter_ToDate"]"
                               Value="@_toDate"
                               ValueChanged="OnToDateChanged" />
                    <button type="button"
                            class="pos-sales__refresh"
                            disabled="@_loading"
                            @onclick="ReloadAsync">
                        <span class="pos-sales__refresh-icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                        <span>@L["Sales_Refresh"]</span>
                    </button>
                </div>
            </section>
        }

        <section class="pos-sales__panel" aria-labelledby="sales-list-heading">
            <h2 id="sales-list-heading" class="pos-sales__section-title">@L["Sales_ListSection"]</h2>
            @if (_loading)
            {
                <div class="pos-sales__loading"><Spinner /><span>@L["Sales_Loading"]</span></div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Sales_OfflineTitle"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState Title="@L["Sales_EmptyTitle"]" Message="@L["Sales_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-sales__list" role="list" aria-label="@L["Sales_Title"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-sales__row"
                           role="listitem"
                           href="@($"/sales/{item.SaleId:D}")">
                            <div class="pos-sales__row-main">
                                <div class="pos-sales__row-top">
                                    <span class="pos-sales__row-name">@item.SaleNumber</span>
                                    <Badge Tone="@(item.Status == PosSaleOptions.CompletedStatus ? BadgeTone.Success : BadgeTone.Neutral)">
                                        @SalesUiOptions.StatusLabel(L, item.Status)
                                    </Badge>
                                </div>
                                <span class="pos-sales__row-meta">
                                    @SalesUiOptions.PaymentMethodLabel(L, item.PaymentMethod)
                                    ·
                                    @item.RecordedAtUtc.ToLocalTime().ToString("g")
                                </span>
                            </div>
                            <span class="pos-sales__row-total">
                                <MoneyDisplay Amount="@item.Total" CurrencyCode="PHP" />
                            </span>
                        </a>
                    }
                </div>
            }
        </section>

        @if (!_loading && _totalCount > 0)
        {
            <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private bool _filtersOpen;
    private string? _saleNumber;
    private string? _statusFilter;
    private string? _paymentFilter;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosSaleDto> _items = Array.Empty<PosSaleDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private bool HasAppliedFilters =>
        !string.IsNullOrWhiteSpace(_saleNumber)
        || !string.IsNullOrWhiteSpace(_statusFilter)
        || !string.IsNullOrWhiteSpace(_paymentFilter)
        || _fromDate is not null
        || _toDate is not null;

    private IEnumerable<string> AppliedFilterChips
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_saleNumber))
            {
                yield return $"{L["Sales_SearchPlaceholder"]}: {_saleNumber}";
            }

            if (!string.IsNullOrWhiteSpace(_statusFilter))
            {
                yield return SalesUiOptions.StatusLabel(L, _statusFilter);
            }

            if (!string.IsNullOrWhiteSpace(_paymentFilter))
            {
                yield return SalesUiOptions.PaymentMethodLabel(L, _paymentFilter);
            }

            if (_fromDate is not null)
            {
                yield return $"{L["Sales_Filter_FromDate"]}: {_fromDate:d}";
            }

            if (_toDate is not null)
            {
                yield return $"{L["Sales_Filter_ToDate"]}: {_toDate:d}";
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private int ActiveFilterCount
    {
        get
        {
            var count = 0;
            if (!string.IsNullOrWhiteSpace(_statusFilter))
            {
                count++;
            }

            if (!string.IsNullOrWhiteSpace(_paymentFilter))
            {
                count++;
            }

            if (_fromDate is not null)
            {
                count++;
            }

            if (_toDate is not null)
            {
                count++;
            }

            return count;
        }
    }

    private Task ToggleFilters()
    {
        _filtersOpen = !_filtersOpen;
        return Task.CompletedTask;
    }

    private async Task OnSearchInputAsync(string? value)
    {
        _saleNumber = value;
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            // superseded by newer keystrokes
        }
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPaymentFilterChanged(string? value)
    {
        _paymentFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnFromDateChanged(DateOnly? value)
    {
        _fromDate = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnToDateChanged(DateOnly? value)
    {
        _toDate = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        // Sales history is server-only: there is no local sale cache to fall back on.
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosSaleDto>();
            _totalCount = 0;
            _errorTitle = L["Sales_OfflineTitle"];
            _errorMessage = L["Sales_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Sales.ListSalesAsync(
            string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
            string.IsNullOrWhiteSpace(_paymentFilter) ? null : _paymentFilter,
            _fromDate,
            _toDate,
            _saleNumber,
            _page,
            _pageSize);

        if (result.IsSuccess && result.Data is not null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            _items = Array.Empty<PosSaleDto>();
            _totalCount = 0;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private void GoNew() => Nav.NavigateTo("/sales/new");
}

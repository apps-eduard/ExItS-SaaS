    private async Task SimulateAsync(string outcome)
    {
        if (_activeAttempt is null || _paymentActing || !_showDevSimulate)
        {
            return;
        }

        _paymentActing = true;
        var result = await PaymentAttempts.SimulateAsync(
            _activeAttempt.Id,
            new SimulatePaymentRequest(outcome));
        _paymentActing = false;

        if (!result.IsSuccess || result.Data is null)
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            return;
        }

        _activeAttempt = result.Data;
        await HandleTerminalAttemptAsync(_activeAttempt);
    }

    private async Task RetryPaymentAsync()
    {
        if (_awaitingPaymentSaleId is not Guid saleId || _paymentActing)
        {
            return;
        }

        _attemptPaymentIdempotencyKey = Guid.NewGuid().ToString("N");
        await CreateOrRestorePaymentAttemptAsync(saleId);
    }

    private Task ChangePaymentMethodAsync()
    {
        ResetElectronicPaymentState(clearPending: true);
        _paymentMethod = PosSaleOptions.CashPaymentMethod;
        _attemptSaleId = Guid.NewGuid();
        return Task.CompletedTask;
    }

    private async Task HandleTerminalAttemptAsync(PaymentAttemptDto attempt)
    {
        if (string.Equals(attempt.Status, nameof(PaymentAttemptStatus.Paid), StringComparison.Ordinal))
        {
            StopCountdownTimer();
            PendingPayment.Clear();
            _electronicPaymentOpen = false;
            _activeAttempt = null;
            _awaitingPaymentSaleId = null;
            _attemptSaleId = Guid.NewGuid();
            _attemptCreditEntryId = Guid.NewGuid();
            _attemptPaymentIdempotencyKey = Guid.NewGuid().ToString("N");
            Nav.NavigateTo($"/sales/{attempt.SaleId:D}/receipt?attemptId={attempt.Id:D}");
            return;
        }

        if (CanRetryAttempt(attempt.Status))
        {
            StopCountdownTimer();
        }

        await InvokeAsync(StateHasChanged);
    }

    private static bool CanRetryAttempt(string? status) =>
        status is nameof(PaymentAttemptStatus.Failed)
            or nameof(PaymentAttemptStatus.Cancelled)
            or nameof(PaymentAttemptStatus.Expired);


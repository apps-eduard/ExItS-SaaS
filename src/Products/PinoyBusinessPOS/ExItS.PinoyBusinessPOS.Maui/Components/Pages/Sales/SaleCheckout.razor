@using ExItS.PinoyBusinessPOS.Application.OperationalSetup
@using ExItS.PinoyBusinessPOS.Application.Payments
@using ExItS.PinoyBusinessPOS.Domain.OperationalSetup
@using ExItS.PinoyBusinessPOS.Domain.Payments
@using ExItS.PinoyBusinessPOS.Maui.Services
@using Microsoft.Maui.ApplicationModel
@page "/sales/new"
@implements IDisposable
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCashierShiftClient ShiftClient
@inject IPosSaleClient Sales
@inject IPosPaymentAttemptClient PaymentAttempts
@inject IPosCatalogClient Catalog
@inject IPosCustomerClient Customers
@inject IPosOperationalSetupClient OperationalSetup
@inject SaleCartService Cart
@inject SellingModeService SellingMode
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IAppInfoService AppInfo
@inject MauiPendingPaymentStore PendingPayment
@inject StoreHeaderState HeaderState
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var isUtang = _paymentMethod == PosSaleOptions.UtangPaymentMethod;
    var isManualGCash = _paymentMethod == PosSaleOptions.ManualGCashPaymentMethod;
    var isElectronic = SalesUiOptions.IsElectronicPaymentMethod(_paymentMethod);
    var isCard = _paymentMethod == PosSaleOptions.CardPaymentMethod;
    var isGCashElectronic = _paymentMethod == PosSaleOptions.GCashPaymentMethod;
    var canCreateCash = Capabilities.IsAllowed(UtangCapability.CreateSale);
    var canCreateUtang = canCreateCash && Capabilities.IsAllowed(UtangCapability.CreateCredit);
    var paymentSelectBlocked = _isOffline || !canCreateCash || _electronicPaymentOpen;
    var blocked = _isOffline || (isUtang ? !canCreateUtang : !canCreateCash) || _openShift is null || _electronicPaymentOpen;
    var checkoutBlocked = blocked || !Cart.IsCheckoutReady;
<Page class="pos-sell-page">
    @if (_shiftRequired && _openShift is null && !_isOffline && canCreateCash)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Shifts_RequiredTitle"]" Message="@L["Shifts_RequiredMessage"]" />
        <FormActions>
            <Button Variant="ButtonVariant.Primary" OnClick="GoOpenShift">@L["Shifts_Open"]</Button>
        </FormActions>
    }

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Sales_OfflineTitle"]" Message="@L["Sales_Checkout_OfflineMessage"]" />
    }
    else if (isUtang ? !canCreateUtang : !canCreateCash)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Sales_ErrorTitle"])" Message="@_errorMessage" />
    }

    @if (_electronicPaymentOpen && _activeAttempt is not null)
    {
        <Section Title="@L["Sales_EPayment_Section"]">
            <Stack Gap="3">
                <div>
                    <span class="pos-muted">@L["Sales_EPayment_Amount"]</span>
                    <div class="pos-value-md"><MoneyDisplay Amount="@_activeAttempt.Amount" CurrencyCode="@(_activeAttempt.Currency ?? "PHP")" /></div>
                </div>
                <div>
                    <span class="pos-muted">@L["Sales_Field_PaymentStatus"]</span>
                    <div class="pos-value-md">
                        <Badge Tone="@AttemptBadgeTone(_activeAttempt.Status)">@PaymentsUiOptions.AttemptStatusLabel(L, _activeAttempt.Status)</Badge>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_activeAttempt.ProviderReference))
                {
                    <div>
                        <span class="pos-muted">@L["Sales_EPayment_ProviderReference"]</span>
                        <div class="pos-value-md pos-wrap">@_activeAttempt.ProviderReference</div>
                    </div>
                }
                @if (_activeAttempt.ExpiresAtUtc is DateTimeOffset expires && PaymentsUiOptions.IsActiveAttemptStatus(_activeAttempt.Status))
                {
                    <div class="pos-muted">@string.Format(L["Sales_EPayment_Countdown"], CountdownText(expires))</div>
                }
                @if (isCard)
                {
                    <Alert Tone="AlertTone.Info" Title="@L["Sales_EPayment_SecureCheckout"]" Message="@L["Sales_EPayment_OpenSecureCheckout"]" />
                    @if (!string.IsNullOrWhiteSpace(_activeAttempt.CheckoutUrl))
                    {
                        <Button Variant="ButtonVariant.Primary"
                                Disabled="@_paymentActing"
                                OnClick="OpenSecureCheckoutAsync">@L["Sales_EPayment_OpenSecureCheckout"]</Button>
                    }
                    @if (_showDevSimulate)
                    {
                        <FormActions>
                            <Button Variant="ButtonVariant.Secondary"
                                    IsLoading="@_paymentActing"
                                    Disabled="@_paymentActing"
                                    OnClick='() => SimulateAsync("success")'>@L["Sales_EPayment_SimulateSuccess"]</Button>
                            <Button Variant="ButtonVariant.Danger"
                                    IsLoading="@_paymentActing"
                                    Disabled="@_paymentActing"
                                    OnClick='() => SimulateAsync("decline")'>@L["Sales_EPayment_SimulateDecline"]</Button>
                        </FormActions>
                    }
                }
                else if (isGCashElectronic)
                {
                    @if (!string.IsNullOrWhiteSpace(_activeAttempt.QrPayload))
                    {
                        <div>
                            <span class="pos-muted">@L["Sales_EPayment_QrLabel"]</span>
                            <div class="pos-epayment-qr">@_activeAttempt.QrPayload</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activeAttempt.DeepLink))
                    {
                        <Button Variant="ButtonVariant.Primary"
                                Disabled="@_paymentActing"
                                OnClick="OpenGCashAsync">@L["Sales_EPayment_OpenGCash"]</Button>
                    }
                    <div class="pos-muted">@L["Sales_EPayment_IHavePaidHint"]</div>
                    <Button Variant="ButtonVariant.Secondary"
                            IsLoading="@_paymentActing"
                            Disabled="@_paymentActing"
                            OnClick="RefreshAttemptAsync">@L["Sales_EPayment_IHavePaid"]</Button>
                }
                @if (_activeAttempt.FailureMessage is not null)
                {
                    <Alert Tone="AlertTone.Danger" Title="@L["Sales_ErrorTitle"]" Message="@_activeAttempt.FailureMessage" />
                }
                @if (CanRetryAttempt(_activeAttempt.Status))
                {
                    <FormActions>
                        <Button Variant="ButtonVariant.Primary"
                                IsLoading="@_paymentActing"
                                Disabled="@_paymentActing"
                                OnClick="RetryPaymentAsync">@L["Sales_EPayment_Retry"]</Button>
                        <Button Variant="ButtonVariant.Secondary"
                                Disabled="@_paymentActing"
                                OnClick="ChangePaymentMethodAsync">@L["Sales_EPayment_ChangeMethod"]</Button>
                    </FormActions>
                }
                else if (PaymentsUiOptions.IsActiveAttemptStatus(_activeAttempt.Status))
                {
                    <FormActions>
                        <Button Variant="ButtonVariant.Danger"
                                IsLoading="@_paymentActing"
                                Disabled="@_paymentActing"
                                OnClick="CancelPaymentAsync">@L["Sales_EPayment_Cancel"]</Button>
                    </FormActions>
                }
            </Stack>
        </Section>
    }

    @if (!_electronicPaymentOpen && !_showPayment)
    {
    <div class="pos-sell-floor pos-sell-floor--compact">
        <section class="pos-sell-products" aria-label="@L["Sales_Checkout_BrowseSection"]">
            <div class="pos-sell-search">
                <TextInput Label="@L["Sales_Checkout_LookupLabel"]"
                           Value="@_lookupText"
                           ValueChanged="OnLookupTextChanged"
                           Hint="@L["Sales_Checkout_LookupHint"]"
                           Disabled="@(blocked || _lookingUp)" />
            </div>

            <aside class="pos-sell-categories" aria-label="@L["Sales_Checkout_CategoryFilter"]">
                @foreach (var opt in CatalogUiOptions.CheckoutCategoryFilters(L, _categories))
                {
                    var selected = string.Equals(_categoryFilter ?? string.Empty, opt.Value ?? string.Empty, StringComparison.Ordinal);
                    <button type="button"
                            class="@($"pos-category-chip{(selected ? " pos-category-chip--selected" : string.Empty)}")"
                            disabled="@(blocked || _loadingBrowse)"
                            aria-pressed="@selected"
                            @onclick="() => OnCategoryFilterChanged(opt.Value)">@opt.Text</button>
                }
            </aside>

            @if (_matches.Count > 0)
            {
                <div class="pos-product-row-list" role="list">
                    @foreach (var match in _matches)
                    {
                        <button type="button"
                                class="pos-product-row"
                                disabled="@blocked"
                                role="listitem"
                                @onclick="() => AddToCart(match)">
                            <div class="pos-product-row__line1">
                                <span class="pos-product-row__name">@match.Name</span>
                                <span class="pos-product-row__price"><MoneyDisplay Amount="@match.SellingPrice" CurrencyCode="PHP" /></span>
                            </div>
                            <div class="pos-product-row__line2">@ProductRowMeta(match)</div>
                        </button>
                    }
                </div>
            }

            @if (_loadingBrowse)
            {
                <Skeleton />
                <Skeleton />
                <Skeleton />
            }
            else if (_browseProducts.Count == 0 && _matches.Count == 0)
            {
                <EmptyState IconName="inbox" Title="@L["Sales_Checkout_NoMatchTitle"]" Message="@L["Sales_Checkout_NoMatchMessage"]" />
            }
            else if (_browseProducts.Count > 0)
            {
                <div class="pos-product-row-list" role="list">
                    @foreach (var product in _browseProducts)
                    {
                        var qty = Cart.GetQuantity(product.ProductId);
                        var inCart = qty > 0m;
                        <div @key="product.ProductId"
                             class="@($"pos-product-row{(inCart ? " pos-product-row--in-cart" : string.Empty)}")"
                             role="listitem">
                            <button type="button"
                                    class="pos-product-row__hit"
                                    disabled="@blocked"
                                    aria-label="@ProductTileAria(product, qty)"
                                    @onclick="() => OnBrowseProductTap(product)">
                                <div class="pos-product-row__line1">
                                    <span class="pos-product-row__name">@product.Name</span>
                                    <span class="pos-product-row__price"><MoneyDisplay Amount="@product.SellingPrice" CurrencyCode="PHP" /></span>
                                </div>
                                <div class="pos-product-row__line2">@ProductRowMeta(product)</div>
                            </button>
                            @if (inCart)
                            {
                                <div class="pos-product-row__qty">
                                    <QuantityStepper Value="@qty"
                                                     ValueChanged="v => SetQuantity(product.ProductId, v)"
                                                     Step="@(PosSaleOptions.RequiresWholeQuantity(product.UnitOfMeasure) ? 1m : 0.001m)"
                                                     DecimalPlaces="@PosSaleOptions.MaxQuantityDecimals(product.UnitOfMeasure)"
                                                     Disabled="@blocked"
                                                     AriaLabel="@L["Sales_Checkout_Quantity"]"
                                                     DecreaseLabel="@L["Sales_Checkout_DecreaseQty"]"
                                                     IncreaseLabel="@L["Sales_Checkout_IncreaseQty"]" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        <aside class="pos-sell-cart pos-sell-cart--landscape-only" aria-label="@L["Sales_Checkout_CartSection"]">
            <SaleCartPanel Disabled="@blocked" TaxPreview="@TaxPreview" PayableTotal="@PayableTotal" />
            @if (!Cart.IsEmpty)
            {
                <FormActions>
                    <Button Variant="ButtonVariant.Primary" Disabled="@blocked" OnClick="EnterPaymentStep">@L["Sales_Checkout_PaymentSection"]</Button>
                </FormActions>
            }
        </aside>
    </div>

    @if (!Cart.IsEmpty)
    {
        <button type="button"
                class="pos-sell-cart-fab"
                disabled="@blocked"
                aria-label="@string.Format(L["Sales_Checkout_CartFab"], Cart.LineCount)"
                @onclick="EnterPaymentStep">
            @string.Format(L["Sales_Checkout_CartFab"], Cart.LineCount)
        </button>
    }
    }

    @if (!_electronicPaymentOpen && _showPayment)
    {
    <div class="pos-sell-payment">
        <section class="pos-sell-payment__summary" aria-label="@L["Sales_Checkout_CartSection"]">
            @foreach (var item in Cart.Items)
            {
                <div class="pos-sell-payment__line">
                    <span class="pos-sell-payment__line-name">@item.Name</span>
                    <span class="pos-sell-payment__line-qty pos-tabular">Ã—@item.Quantity</span>
                    <span class="pos-sell-payment__line-total"><MoneyDisplay Amount="@item.LineTotal" CurrencyCode="PHP" /></span>
                </div>
            }
            <div class="pos-sell-payment__total">
                <span>@L["Sales_Field_Total"]</span>
                <MoneyDisplay Amount="@PayableTotal" CurrencyCode="PHP" Emphasized="true" />
            </div>
        </section>

        <div class="pos-sell-payment__methods">
        <Stack Gap="2">
            <span class="pos-muted">@L["Sales_Field_PaymentMethod"]</span>
            <div class="pos-payment-method-grid pos-payment-method-grid--checkout">
                @foreach (var methodCode in SalesUiOptions.CheckoutPaymentMethodCodes)
                {
                    var selected = string.Equals(_paymentMethod, methodCode, StringComparison.Ordinal);
                    <button type="button"
                            class="@($"pos-payment-method-tile{(selected ? " pos-payment-method-tile--selected" : string.Empty)}")"
                            disabled="@paymentSelectBlocked"
                            aria-pressed="@selected"
                            @onclick="() => OnPaymentMethodChanged(methodCode)">
                        @SalesUiOptions.PaymentMethodLabel(L, methodCode)
                    </button>
                }
            </div>

            <div class="pos-sell-customer">
                <button type="button"
                        class="pos-sell-customer__toggle"
                        disabled="@blocked"
                        aria-expanded="@_customerExpanded"
                        @onclick="() => _customerExpanded = !_customerExpanded">
                    <span>@L["Sales_Checkout_OptionalCustomer"]</span>
                    <span aria-hidden="true">@(_customerExpanded ? "âˆ’" : "+")</span>
                </button>
                @if (_customerExpanded)
                {
                    @if (isUtang)
                    {
                        <Alert Tone="AlertTone.Warning" Title="@L["Sales_Checkout_UtangSection"]" Message="@L["Sales_Checkout_UtangWarning"]" />
                    }
                    <Stack Gap="2">
                        <TextInput Label="@L["Sales_Checkout_CustomerSearch"]"
                                   Value="@_customerSearch"
                                   ValueChanged="v => _customerSearch = v"
                                   Hint="@L["Sales_Checkout_SelectCustomer"]"
                                   Disabled="@(blocked || _searchingCustomers)" />
                        <FormActions>
                            <Button Variant="ButtonVariant.Secondary"
                                    IsLoading="@_searchingCustomers"
                                    Disabled="@blocked"
                                    OnClick="SearchCustomersAsync">@L["Sales_Checkout_Search"]</Button>
                            <Button Variant="ButtonVariant.Ghost"
                                    Disabled="@blocked"
                                    OnClick="GoResolveCustomerExItsId">@L["Personal_AddByExItsId"]</Button>
                            @if (_selectedCustomer is not null)
                            {
                                <Button Variant="ButtonVariant.Secondary"
                                        Disabled="@blocked"
                                        OnClick="ClearCustomerSelection">@L["Sales_Checkout_Remove"]</Button>
                            }
                        </FormActions>
                        @if (_customerMatches.Count > 0)
                        {
                            <Stack Gap="1">
                                @foreach (var match in _customerMatches)
                                {
                                    <div class="pos-row">
                                        <span class="pos-value-md">@match.DisplayName</span>
                                        <span class="pos-muted">@(string.IsNullOrWhiteSpace(match.MobileNumber) ? L["Customers_NoMobile"] : match.MobileNumber)</span>
                                        <Button Variant="ButtonVariant.Secondary"
                                                Disabled="@blocked"
                                                OnClick="() => SelectCustomerAsync(match)">@L["Sales_Checkout_SelectCustomer"]</Button>
                                    </div>
                                }
                            </Stack>
                        }
                        @if (_selectedCustomer is not null)
                        {
                            <div>
                                <span class="pos-muted">@L["Sales_Checkout_SelectCustomer"]</span>
                                <div class="pos-value-md">@_selectedCustomer.DisplayName</div>
                                @if (isUtang && _selectedOutstanding is not null)
                                {
                                    <div class="pos-muted">@L["Sales_Checkout_Outstanding"]: <MoneyDisplay Amount="@_selectedOutstanding.Value" CurrencyCode="PHP" /></div>
                                }
                            </div>
                        }
                        @if (isUtang)
                        {
                            <DateInput Label="@L["Sales_Checkout_DueDateOptional"]"
                                       Value="@_dueDate"
                                       ValueChanged="v => _dueDate = v"
                                       Disabled="@blocked" />
                        }
                    </Stack>
                }
                else if (_selectedCustomer is not null)
                {
                    <div class="pos-sell-customer__summary">@_selectedCustomer.DisplayName</div>
                }
            </div>

            @if (isManualGCash)
            {
                <Alert Tone="AlertTone.Warning" Title="@L["Sales_GCash_ManualTitle"]" Message="@L["Sales_GCash_ManualWarning"]" />
                <TextInput Label="@L["Sales_Field_GCashReference"]"
                           Value="@_gcashReference"
                           ValueChanged="v => _gcashReference = v"
                           Hint="@L["Sales_GCash_ReferenceHint"]"
                           IsInvalid="@(!string.IsNullOrEmpty(_gcashError))"
                           ErrorText="@_gcashError"
                           Disabled="@blocked" />
                <Checkbox Value="@_gcashConfirmed"
                          ValueChanged="v => _gcashConfirmed = v"
                          Disabled="@blocked">@L["Sales_GCash_ConfirmReceived"]</Checkbox>
            }
            else if (isElectronic)
            {
                <div>
                    <span class="pos-muted">@L["Sales_Field_Total"]</span>
                    <div class="pos-value-md"><MoneyDisplay Amount="@PayableTotal" CurrencyCode="PHP" /></div>
                </div>
                <div class="pos-muted">@(isCard ? L["Sales_EPayment_SecureCheckout"] : L["Sales_EPayment_QrLabel"])</div>
            }
            else if (!isUtang)
            {
                <CurrencyInput Label="@L["Sales_Field_AmountTendered"]"
                               Value="@_amountTendered"
                               ValueChanged="v => _amountTendered = v"
                               CurrencyCode="PHP"
                               Required="true"
                               Hint="@L["Sales_TenderHint"]"
                               IsInvalid="@(!string.IsNullOrEmpty(_tenderError))"
                               ErrorText="@_tenderError"
                               Disabled="@blocked" />
                <div class="pos-sell-tender-quick" role="group" aria-label="@L["Sales_Field_AmountTendered"]">
                    <button type="button" class="pos-sell-tender-quick__btn" disabled="@blocked" @onclick="SetTenderExact">@L["Sales_TenderExact"]</button>
                    <button type="button" class="pos-sell-tender-quick__btn" disabled="@blocked" @onclick="() => SetTenderQuick(50m)">@L["Sales_TenderQuick50"]</button>
                    <button type="button" class="pos-sell-tender-quick__btn" disabled="@blocked" @onclick="() => SetTenderQuick(100m)">@L["Sales_TenderQuick100"]</button>
                    <button type="button" class="pos-sell-tender-quick__btn" disabled="@blocked" @onclick="() => SetTenderQuick(200m)">@L["Sales_TenderQuick200"]</button>
                    <button type="button" class="pos-sell-tender-quick__btn" disabled="@blocked" @onclick="() => SetTenderQuick(500m)">@L["Sales_TenderQuick500"]</button>
                </div>
                <div class="pos-sell-change">
                    <span class="pos-sell-change__label">@L["Sales_Field_ChangeAmount"]</span>
                    <span class="pos-sell-change__value"><MoneyDisplay Amount="@ChangePreview" CurrencyCode="PHP" Emphasized="true" /></span>
                </div>
            }
            else if (isUtang && !_customerExpanded)
            {
                <Alert Tone="AlertTone.Warning" Title="@L["Sales_Checkout_UtangSection"]" Message="@L["Sales_Checkout_UtangWarning"]" />
            }
        </Stack>
        </div>

    @if (!_electronicPaymentOpen)
    {
    <div class="pos-sell-payment__actions">
    <FormActions>
        <Button Variant="ButtonVariant.Secondary" Disabled="@_saving" OnClick="ExitPaymentStep">@L["Sales_Cancel"]</Button>
        <div class="pos-sell-record-sale">
            <Button Variant="ButtonVariant.Primary"
                    IsLoading="@_saving"
                    Disabled="@checkoutBlocked"
                    OnClick="OpenConfirm">@L["Sales_Checkout_Confirm"]</Button>
        </div>
    </FormActions>
    </div>
    }
    </div>
    }

    @if (_electronicPaymentOpen)
    {
    <FormActions>
        <Button Variant="ButtonVariant.Secondary" Disabled="@_saving" OnClick="GoList">@L["Sales_Cancel"]</Button>
    </FormActions>
    }

    <ConfirmDialog Visible="@_confirm"
                   VisibleChanged="v => _confirm = v"
                   Title="@L["Sales_Checkout_ConfirmTitle"]"
                   Message="@ConfirmMessage"
                   ConfirmLabel="@L["Sales_Checkout_Confirm"]"
                   IsLoading="@_saving"
                   OnConfirm="CheckoutAsync" />
</Page>
}
@code {
    [SupplyParameterFromQuery(Name = "displayName")]
    public string? ResolvedDisplayName { get; set; }

    [SupplyParameterFromQuery(Name = "publicUserId")]
    public string? ResolvedPublicUserId { get; set; }

    private bool _ready;
    private bool _isOffline;
    private bool _lookingUp;
    private bool _loadingBrowse;
    private bool _searchingCustomers;
    private bool _saving;
    private bool _confirm;
    private bool _gcashConfirmed;
    private string? _lookupText;
    private string? _customerSearch;
    private string? _categoryFilter;
    private string _paymentMethod = PosSaleOptions.CashPaymentMethod;
    private decimal? _amountTendered;
    private string? _gcashReference;
    private string? _tenderError;
    private string? _gcashError;
    private string? _errorTitle;
    private string? _errorMessage;
    private DateOnly? _dueDate;
    private PosCustomerListItemDto? _selectedCustomer;
    private decimal? _selectedOutstanding;
    private IReadOnlyList<PosCatalogProductDto> _matches = Array.Empty<PosCatalogProductDto>();
    private IReadOnlyList<PosCatalogProductDto> _browseProducts = Array.Empty<PosCatalogProductDto>();
    private IReadOnlyList<PosProductCategoryDto> _categories = Array.Empty<PosProductCategoryDto>();
    private IReadOnlyList<PosCustomerListItemDto> _customerMatches = Array.Empty<PosCustomerListItemDto>();
    private PosCashierShiftDto? _openShift;
    private bool _shiftRequired = true;
    private decimal _setupVatPercent;
    private string _setupPricingMode = "TaxExclusive";

    private const int BrowsePageSize = 40;

    /// <summary>
    /// Stable per-attempt sale identifier. Re-sending the same identifier after a failed or unclear
    /// response returns the sale already recorded instead of recording a second one.
    /// </summary>
    private Guid _attemptSaleId = Guid.NewGuid();

    /// <summary>Stable per-attempt credit entry id for Product-Based Utang checkout idempotency.</summary>
    private Guid _attemptCreditEntryId = Guid.NewGuid();

    /// <summary>Stable idempotency key reused while creating or retrying a payment attempt.</summary>
    private string _attemptPaymentIdempotencyKey = Guid.NewGuid().ToString("N");

    private bool _electronicPaymentOpen;
    private bool _showPayment;
    private bool _customerExpanded;
    private bool _paymentHeaderActive;
    private CancellationTokenSource? _lookupDebounceCts;
    private int _searchGeneration;
    private bool _paymentActing;
    private PaymentAttemptDto? _activeAttempt;
    private Guid? _awaitingPaymentSaleId;
    private System.Threading.Timer? _countdownTimer;
    private bool _showDevSimulate;

    protected override void OnInitialized()
    {
        _showDevSimulate = !string.Equals(AppInfo.EnvironmentName, "Production", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(AppInfo.EnvironmentName, "Release", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Preview tax matching server OperationalSetupTaxCalculator (display only).</summary>
    private decimal TaxPreview
    {
        get
        {
            if (_setupVatPercent <= 0m || Cart.Subtotal <= 0m)
            {
                return 0m;
            }

            var mode = ParsePricingMode(_setupPricingMode);
            return OperationalSetupTaxCalculator.ComputeTaxAmount(Cart.Subtotal, _setupVatPercent, mode);
        }
    }

    /// <summary>
    /// Amount the customer must cover. Tax-exclusive adds tax on top; tax-inclusive keeps subtotal.
    /// Must match Sale.Checkout total rules or tender validation rejects a valid-looking cash entry.
    /// </summary>
    private decimal PayableTotal
    {
        get
        {
            var tax = TaxPreview;
            if (tax > 0m && ParsePricingMode(_setupPricingMode) == TaxPricingMode.TaxExclusive)
            {
                return PosSaleOptions.RoundMoney(Cart.Subtotal + tax);
            }

            return Cart.Subtotal;
        }
    }

    private decimal ChangePreview =>
        _amountTendered is null || _amountTendered.Value < PayableTotal
            ? 0m
            : PosSaleOptions.RoundMoney(_amountTendered.Value - PayableTotal);

    private string ConfirmMessage
    {
        get
        {
            if (_paymentMethod == PosSaleOptions.UtangPaymentMethod)
            {
                return string.Format(
                    L["Sales_Checkout_ConfirmUtangMessage"],
                    Cart.LineCount,
                    PayableTotal.ToString("N2"),
                    _selectedCustomer?.DisplayName ?? string.Empty);
            }

            return string.Format(
                L["Sales_Checkout_ConfirmMessage"],
                Cart.LineCount,
                PayableTotal.ToString("N2"));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        Cart.Changed += OnCartChanged;
        _ready = true;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!string.IsNullOrWhiteSpace(ResolvedDisplayName))
        {
            _customerSearch = ResolvedDisplayName;
            if (!_isOffline)
            {
                await SearchCustomersAsync();
            }
        }

        _ = ResolvedPublicUserId;
        if (!_isOffline)
        {
            var shiftResult = await ShiftClient.GetCurrentAsync();
            if (shiftResult.IsSuccess)
            {
                _openShift = shiftResult.Data;
            }

            await LoadOperationalSetupAsync();
            await LoadCategoriesAsync();
            await LoadBrowseProductsAsync();
            await TryRestorePendingPaymentAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && !_isOffline)
        {
            await TryRestorePendingPaymentAsync();
        }
    }

    private async Task TryRestorePendingPaymentAsync()
    {
        var pending = PendingPayment.Get();
        if (pending is null)
        {
            return;
        }

        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is not null && pending.OrganizationId is Guid storedOrg && storedOrg != orgId)
        {
            PendingPayment.Clear();
            return;
        }

        _awaitingPaymentSaleId = pending.SaleId;
        _attemptPaymentIdempotencyKey = string.IsNullOrWhiteSpace(pending.IdempotencyKey)
            ? Guid.NewGuid().ToString("N")
            : pending.IdempotencyKey;
        if (!string.IsNullOrWhiteSpace(pending.PaymentMethod))
        {
            _paymentMethod = pending.PaymentMethod;
        }

        if (pending.AttemptId is not Guid attemptId)
        {
            _electronicPaymentOpen = true;
            await CreateOrRestorePaymentAttemptAsync(pending.SaleId);
            return;
        }

        var attemptResult = await PaymentAttempts.GetAsync(attemptId);
        if (!attemptResult.IsSuccess || attemptResult.Data is null)
        {
            return;
        }

        _activeAttempt = attemptResult.Data;
        if (PaymentsUiOptions.IsTerminalAttemptStatus(_activeAttempt.Status))
        {
            await HandleTerminalAttemptAsync(_activeAttempt);
            return;
        }

        _electronicPaymentOpen = true;
        StartCountdownTimer();
    }

    private async Task LoadOperationalSetupAsync()
    {
        var result = await OperationalSetup.GetAsync();
        if (!result.IsSuccess || result.Data is null || !result.Data.IsCompleted)
        {
            _setupVatPercent = 0m;
            _setupPricingMode = "TaxExclusive";
            return;
        }

        _setupVatPercent = result.Data.TaxRatePercent;
        _setupPricingMode = string.IsNullOrWhiteSpace(result.Data.TaxPricingMode)
            ? "TaxExclusive"
            : result.Data.TaxPricingMode;
    }

    private static TaxPricingMode ParsePricingMode(string? mode) =>
        Enum.TryParse<TaxPricingMode>(mode, ignoreCase: true, out var parsed)
            ? parsed
            : TaxPricingMode.TaxExclusive;


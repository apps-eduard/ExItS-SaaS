    private void OnPaymentMethodChanged(string? value)
    {
        var next = string.IsNullOrWhiteSpace(value) ? PosSaleOptions.CashPaymentMethod : value;
        var wasUtang = _paymentMethod == PosSaleOptions.UtangPaymentMethod;
        _paymentMethod = next;
        _tenderError = null;
        _gcashError = null;
        _errorTitle = null;
        _errorMessage = null;

        if (next == PosSaleOptions.ManualGCashPaymentMethod)
        {
            ClearCustomerSelection();
            _amountTendered = null;
        }
        else if (SalesUiOptions.IsElectronicPaymentMethod(next))
        {
            _amountTendered = null;
        }
        else if (wasUtang && next != PosSaleOptions.UtangPaymentMethod)
        {
            ClearUtangFields();
        }

        if (_paymentMethod == PosSaleOptions.ManualGCashPaymentMethod)
        {
            _amountTendered = null;
        }
        else if (_paymentMethod == PosSaleOptions.UtangPaymentMethod)
        {
            _amountTendered = null;
            _gcashReference = null;
            _gcashConfirmed = false;
            _customerExpanded = true;
            if (_selectedCustomer is not null)
            {
                _ = LoadSelectedCustomerOutstandingAsync();
            }
        }
        else if (SalesUiOptions.IsElectronicPaymentMethod(_paymentMethod))
        {
            _amountTendered = null;
            _gcashReference = null;
            _gcashConfirmed = false;
        }
        else
        {
            _gcashReference = null;
            _gcashConfirmed = false;
        }
    }


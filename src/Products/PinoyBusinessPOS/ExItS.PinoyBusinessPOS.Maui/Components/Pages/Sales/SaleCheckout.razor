    private async Task SelectCustomerAsync(PosCustomerListItemDto customer)
    {
        _selectedCustomer = customer;
        _customerMatches = Array.Empty<PosCustomerListItemDto>();
        _customerSearch = customer.DisplayName;
        _selectedOutstanding = null;
        StateHasChanged();

        if (_paymentMethod != PosSaleOptions.UtangPaymentMethod)
        {
            return;
        }

        await LoadSelectedCustomerOutstandingAsync();
    }

    private async Task LoadSelectedCustomerOutstandingAsync()
    {
        if (_selectedCustomer is null)
        {
            return;
        }

        _selectedOutstanding = null;
        StateHasChanged();

        var summary = await Customers.GetCreditSummaryAsync(_selectedCustomer.CustomerId);
        if (summary.IsSuccess && summary.Data is not null)
        {
            _selectedOutstanding = summary.Data.OutstandingAmount;
        }
        else
        {
            _selectedOutstanding = 0m;
        }
    }

    private void OpenConfirm()
    {
        _tenderError = null;
        _gcashError = null;
        _errorTitle = null;
        _errorMessage = null;

        if (_paymentMethod == PosSaleOptions.UtangPaymentMethod)
        {
            if (_selectedCustomer is null)
            {
                _errorTitle = L["Sales_ErrorTitle"];
                _errorMessage = L["Sales_Checkout_CustomerRequired"];
                return;
            }

            if (Cart.Subtotal <= 0m)
            {
                _errorTitle = L["Sales_ErrorTitle"];
                _errorMessage = L["Sales_Checkout_ZeroTotalUtang"];
                return;
            }
        }
        else if (_paymentMethod == PosSaleOptions.ManualGCashPaymentMethod)
        {
            if (!_gcashConfirmed)
            {
                _gcashError = L["Sales_GCash_ConfirmRequired"];
                return;
            }

            if (string.IsNullOrWhiteSpace(_gcashReference))
            {
                _gcashError = L["Sales_GCash_ReferenceRequired"];
                return;
            }

            if (_gcashReference.Trim().Length > PosSaleOptions.GCashReferenceMaxLength)
            {
                _gcashError = L["Sales_GCash_ReferenceTooLong"];
                return;
            }
        }
        else if (SalesUiOptions.IsElectronicPaymentMethod(_paymentMethod))
        {
            if (Cart.Subtotal <= 0m)
            {
                _errorTitle = L["Sales_ErrorTitle"];
                _errorMessage = L["Sales_Checkout_CartEmptyMessage"];
                return;
            }
        }
        else
        {
            if (_amountTendered is null)
            {
                _tenderError = L["Sales_TenderRequired"];
                return;
            }

            if (_amountTendered.Value < PayableTotal)
            {
                _tenderError = L["Sales_TenderBelowTotal"];
                return;
            }
        }

        _confirm = true;
    }

    private async Task CheckoutAsync()
    {
        _confirm = false;

        if (_saving)
        {
            return;
        }

        // Checkout is online-only: no sale is ever queued or stored locally.
        _isOffline = !await Connectivity.IsConnectedAsync();
        var isUtang = _paymentMethod == PosSaleOptions.UtangPaymentMethod;
        var canCreate = isUtang
            ? Capabilities.IsAllowed(UtangCapability.CreateSale) && Capabilities.IsAllowed(UtangCapability.CreateCredit)
            : Capabilities.IsAllowed(UtangCapability.CreateSale);
        if (_isOffline || !canCreate || !Cart.IsCheckoutReady || _openShift is null)
        {
            return;
        }

        if (isUtang && (_selectedCustomer is null || PayableTotal <= 0m))
        {
            return;
        }

        _saving = true;
        var request = new CheckoutSaleRequest(
            Cart.ToCheckoutLines(),
            _paymentMethod,
            isUtang || _paymentMethod == PosSaleOptions.ManualGCashPaymentMethod || SalesUiOptions.IsElectronicPaymentMethod(_paymentMethod) ? null : _amountTendered,
            _paymentMethod == PosSaleOptions.ManualGCashPaymentMethod ? _gcashReference : null,
            _attemptSaleId,
            isUtang ? _selectedCustomer!.CustomerId : null,
            isUtang ? _dueDate : null,
            isUtang ? _attemptCreditEntryId : null,
            _openShift?.ShiftId);

        var result = await Sales.CheckoutAsync(request);
        _saving = false;

        if (result.IsSuccess && result.Data is not null)
        {
            if (string.Equals(result.Data.Status, PosSaleOptions.AwaitingPaymentStatus, StringComparison.Ordinal))
            {
                _awaitingPaymentSaleId = result.Data.SaleId;
                Cart.Clear();
                ClearCustomerSelection();
                await CreateOrRestorePaymentAttemptAsync(result.Data.SaleId);
                return;
            }

            Cart.Clear();
            ClearCustomerSelection();
            _attemptSaleId = Guid.NewGuid();
            _attemptCreditEntryId = Guid.NewGuid();
            _bypassLeaveGuard = true;
            try
            {
                Nav.NavigateTo($"/sales/{result.Data.SaleId:D}/receipt");
            }
            finally
            {
                _bypassLeaveGuard = false;
            }

            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }

    private async Task CreateOrRestorePaymentAttemptAsync(Guid saleId)
    {
        if (_paymentActing)
        {
            return;
        }

        _paymentActing = true;
        _errorTitle = null;
        _errorMessage = null;

        var request = new CreatePaymentAttemptRequest(
            _paymentMethod,
            _attemptPaymentIdempotencyKey);

        var result = await PaymentAttempts.CreateAsync(saleId, request);
        _paymentActing = false;

        if (!result.IsSuccess || result.Data is null)
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            return;
        }

        await OpenElectronicPaymentAsync(result.Data);
    }

    private async Task OpenElectronicPaymentAsync(PaymentAttemptDto attempt)
    {
        _activeAttempt = attempt;
        _awaitingPaymentSaleId = attempt.SaleId;
        _electronicPaymentOpen = true;
        PendingPayment.Save(new PendingPaymentState(
            attempt.SaleId,
            attempt.Id,
            _attemptPaymentIdempotencyKey,
            CurrentUser.Session?.OrganizationId,
            _paymentMethod));
        StartCountdownTimer();
        await InvokeAsync(StateHasChanged);

        if (PaymentsUiOptions.IsTerminalAttemptStatus(attempt.Status))
        {
            await HandleTerminalAttemptAsync(attempt);
        }
    }

    private async Task RefreshAttemptAsync()
    {
        if (_activeAttempt is null || _paymentActing)
        {
            return;
        }

        _paymentActing = true;
        var result = await PaymentAttempts.GetAsync(_activeAttempt.Id);
        _paymentActing = false;

        if (!result.IsSuccess || result.Data is null)
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            return;
        }

        _activeAttempt = result.Data;
        await HandleTerminalAttemptAsync(_activeAttempt);
    }

    private async Task CancelPaymentAsync()
    {
        if (_activeAttempt is null || _paymentActing)
        {
            return;
        }

        _paymentActing = true;
        var result = await PaymentAttempts.CancelAsync(_activeAttempt.Id);
        _paymentActing = false;

        if (!result.IsSuccess || result.Data is null)
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            return;
        }

        _activeAttempt = result.Data;
        await HandleTerminalAttemptAsync(_activeAttempt);
    }

    private async Task SimulateAsync(string outcome)
    {
        if (_activeAttempt is null || _paymentActing || !_showDevSimulate)
        {
            return;
        }

        _paymentActing = true;
        var result = await PaymentAttempts.SimulateAsync(
            _activeAttempt.Id,
            new SimulatePaymentRequest(outcome));
        _paymentActing = false;

        if (!result.IsSuccess || result.Data is null)
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            return;
        }

        _activeAttempt = result.Data;
        await HandleTerminalAttemptAsync(_activeAttempt);
    }

    private async Task RetryPaymentAsync()
    {
        if (_awaitingPaymentSaleId is not Guid saleId || _paymentActing)
        {
            return;
        }

        _attemptPaymentIdempotencyKey = Guid.NewGuid().ToString("N");
        await CreateOrRestorePaymentAttemptAsync(saleId);
    }

    private Task ChangePaymentMethodAsync()
    {
        ResetElectronicPaymentState(clearPending: true);
        _paymentMethod = PosSaleOptions.CashPaymentMethod;
        _attemptSaleId = Guid.NewGuid();
        return Task.CompletedTask;
    }

    private async Task HandleTerminalAttemptAsync(PaymentAttemptDto attempt)
    {
        if (string.Equals(attempt.Status, nameof(PaymentAttemptStatus.Paid), StringComparison.Ordinal))
        {
            StopCountdownTimer();
            PendingPayment.Clear();
            _electronicPaymentOpen = false;
            _activeAttempt = null;
            _awaitingPaymentSaleId = null;
            _attemptSaleId = Guid.NewGuid();
            _attemptCreditEntryId = Guid.NewGuid();
            _attemptPaymentIdempotencyKey = Guid.NewGuid().ToString("N");
            _bypassLeaveGuard = true;
            try
            {
                Nav.NavigateTo($"/sales/{attempt.SaleId:D}/receipt?attemptId={attempt.Id:D}");
            }
            finally
            {
                _bypassLeaveGuard = false;
            }

            return;
        }

        if (CanRetryAttempt(attempt.Status))
        {
            StopCountdownTimer();
        }

        await InvokeAsync(StateHasChanged);
    }

    private static bool CanRetryAttempt(string? status) =>
        status is nameof(PaymentAttemptStatus.Failed)
            or nameof(PaymentAttemptStatus.Cancelled)
            or nameof(PaymentAttemptStatus.Expired);

    private async Task OpenSecureCheckoutAsync()
    {
        if (string.IsNullOrWhiteSpace(_activeAttempt?.CheckoutUrl))
        {
            return;
        }

        await Launcher.Default.OpenAsync(new Uri(_activeAttempt.CheckoutUrl));
    }

    private async Task OpenGCashAsync()
    {
        if (string.IsNullOrWhiteSpace(_activeAttempt?.DeepLink))
        {
            return;
        }

        await Launcher.Default.OpenAsync(new Uri(_activeAttempt.DeepLink));
    }

    private void StartCountdownTimer()
    {
        StopCountdownTimer();
        _countdownTimer = new System.Threading.Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void StopCountdownTimer()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    private void ResetElectronicPaymentState(bool clearPending)
    {
        StopCountdownTimer();
        _electronicPaymentOpen = false;
        _activeAttempt = null;
        _awaitingPaymentSaleId = null;
        if (clearPending)
        {
            PendingPayment.Clear();
        }
    }

    private static string CountdownText(DateTimeOffset expiresAtUtc)
    {
        var remaining = expiresAtUtc - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "0:00";
        }

        return remaining.TotalHours >= 1d
            ? $"{(int)remaining.TotalHours}:{remaining.Minutes:D2}:{remaining.Seconds:D2}"
            : $"{remaining.Minutes}:{remaining.Seconds:D2}";
    }

    private static BadgeTone AttemptBadgeTone(string? status) => status switch
    {
        nameof(PaymentAttemptStatus.Paid) => BadgeTone.Success,
        nameof(PaymentAttemptStatus.Failed) or nameof(PaymentAttemptStatus.Expired) => BadgeTone.Danger,
        nameof(PaymentAttemptStatus.Cancelled) => BadgeTone.Neutral,
        _ => BadgeTone.Warning
    };

    private bool HasUnfinishedSale =>
        !Cart.IsEmpty || _electronicPaymentOpen;

    private void OnBeforeLeaveSell(LocationChangingContext context)
    {
        if (_bypassLeaveGuard || !HasUnfinishedSale)
        {
            return;
        }

        if (IsCartPreservingSideTrip(context.TargetLocation))
        {
            return;
        }

        // Stay on Sell until cashier confirms discard — unfinished carts must not linger silently.
        context.PreventNavigation();
        _pendingLeaveUri = context.TargetLocation;
        _confirmLeave = true;
        _confirmReset = false;
        InvokeAsync(StateHasChanged);
    }

    private static bool IsCartPreservingSideTrip(string? targetLocation)
    {
        if (string.IsNullOrWhiteSpace(targetLocation))
        {
            return false;
        }

        var pathAndQuery = targetLocation;
        if (Uri.TryCreate(targetLocation, UriKind.Absolute, out var absolute))
        {
            pathAndQuery = absolute.PathAndQuery;
        }
        else
        {
            var q = targetLocation.IndexOf('?', StringComparison.Ordinal);
            var h = targetLocation.IndexOf('#', StringComparison.Ordinal);
            var cut = targetLocation.Length;
            if (q >= 0)
            {
                cut = Math.Min(cut, q);
            }

            if (h >= 0)
            {
                cut = Math.Min(cut, h);
            }

            pathAndQuery = targetLocation[..cut];
            if (pathAndQuery.StartsWith("./", StringComparison.Ordinal))
            {
                pathAndQuery = pathAndQuery[1..];
            }
        }

        var path = pathAndQuery;
        var queryIndex = path.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex >= 0)
        {
            path = path[..queryIndex];
        }

        return path.Equals("/customers/new", StringComparison.OrdinalIgnoreCase)
            || path.Equals("/personal/resolve-user", StringComparison.OrdinalIgnoreCase);
    }

    private void RequestResetSale()
    {
        if (Cart.IsEmpty || _electronicPaymentOpen)
        {
            return;
        }

        _confirmReset = true;
        _confirmLeave = false;
    }

    private Task OnResetDialogVisibleChanged(bool visible)
    {
        _confirmReset = visible;
        return Task.CompletedTask;
    }

    private Task OnLeaveDialogVisibleChanged(bool visible)
    {
        _confirmLeave = visible;
        if (!visible)
        {
            _pendingLeaveUri = null;
        }

        return Task.CompletedTask;
    }

    private void CancelResetSale() => _confirmReset = false;

    private void CancelLeaveSale()
    {
        _confirmLeave = false;
        _pendingLeaveUri = null;
    }

    private void ConfirmResetSale()
    {
        _confirmReset = false;
        DiscardUnfinishedSale();
    }

    private async Task ConfirmLeaveSaleAsync()
    {
        var target = _pendingLeaveUri;
        _confirmLeave = false;
        _pendingLeaveUri = null;
        DiscardUnfinishedSale();

        if (SellingMode.IsSellingMode)
        {
            SellingMode.Exit();
        }

        if (string.IsNullOrWhiteSpace(target))
        {
            return;
        }

        _bypassLeaveGuard = true;
        try
        {
            Nav.NavigateTo(target);
        }
        finally
        {
            _bypassLeaveGuard = false;
        }

        await Task.CompletedTask;
    }

    private void DiscardUnfinishedSale()
    {
        Cart.Clear();
        ClearCustomerSelection();
        _amountTendered = null;
        _gcashReference = null;
        _gcashConfirmed = false;
        _tenderError = null;
        _gcashError = null;
        _errorTitle = null;
        _errorMessage = null;
        _paymentMethod = PosSaleOptions.CashPaymentMethod;
        _paymentMethodExpanded = false;
        _customerExpanded = false;
        _attemptSaleId = Guid.NewGuid();
        _attemptCreditEntryId = Guid.NewGuid();
        _attemptPaymentIdempotencyKey = Guid.NewGuid().ToString("N");

        if (_electronicPaymentOpen)
        {
            ResetElectronicPaymentState(clearPending: true);
        }

        if (_showPayment)
        {
            ExitPaymentStep();
        }
    }

    private void GoList()
    {
        if (HasUnfinishedSale)
        {
            _pendingLeaveUri = SellingMode.IsSellingMode
                ? (SellingMode.ReturnRoute ?? "/owner")
                : "/sales";
            _confirmLeave = true;
            return;
        }

        if (SellingMode.IsSellingMode)
        {
            var returnRoute = SellingMode.ReturnRoute ?? "/owner";
            SellingMode.Exit();
            _bypassLeaveGuard = true;
            try
            {
                Nav.NavigateTo(returnRoute);
            }
            finally
            {
                _bypassLeaveGuard = false;
            }

            return;
        }

        _bypassLeaveGuard = true;
        try
        {
            Nav.NavigateTo("/sales");
        }
        finally
        {
            _bypassLeaveGuard = false;
        }
    }

    private void GoOpenShift() => Nav.NavigateTo("/shifts/open");

    public void Dispose()
    {
        if (_paymentHeaderActive)
        {
            HeaderState.ExitInner();
            _paymentHeaderActive = false;
        }

        Cart.Changed -= OnCartChanged;
        _lookupDebounceCts?.Cancel();
        _lookupDebounceCts?.Dispose();
        StopCountdownTimer();
    }
}

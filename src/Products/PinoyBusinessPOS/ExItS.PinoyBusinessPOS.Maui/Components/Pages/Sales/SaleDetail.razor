@page "/sales/{SaleId:guid}"
@implements IDisposable
@using ExItS.PinoyBusinessPOS.Application.Payments
@using ExItS.PinoyBusinessPOS.Maui.Services
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSaleClient Sales
@inject IPosSaleReturnClient SaleReturns
@inject IPosPaymentAttemptClient PaymentAttempts
@inject IPlatformAccessClient Platform
@inject MauiPendingPaymentStore PendingPayment
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject StoreHeaderState HeaderState
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Sales_Loading"]</span></Page>
}
else if (_sale is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Sales_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Sales_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
    var sale = _sale;
    var currency = sale.CurrencyCode ?? "PHP";
    var isCompleted = sale.Status == PosSaleOptions.CompletedStatus;
    var isAwaitingPayment = sale.Status == PosSaleOptions.AwaitingPaymentStatus;
    var isUtang = sale.PaymentMethod == PosSaleOptions.UtangPaymentMethod;
    var canVoid = Capabilities.IsAllowed(UtangCapability.VoidSale)
        && isCompleted
        && !_isOffline
        && (!isUtang || Capabilities.IsAllowed(UtangCapability.ReverseCredit));
    var canReturn = Capabilities.IsAllowed(UtangCapability.ProcessReturn)
        && Capabilities.IsAllowed(UtangCapability.ViewReturns)
        && isCompleted
        && !_isOffline;
    var canReceipt = isCompleted
        && (Capabilities.IsAllowed(UtangCapability.ViewGenerateReceipt)
            || Capabilities.IsAllowed(UtangCapability.ViewSales));
    var registerLabel = FirstMeaningful(sale.RegisterName, sale.RegisterCode);
    var paymentRegisterLine = BuildPaymentRegisterLine(sale.PaymentMethod, registerLabel);
<div class="pos-sale-detail">
<Page>
    <header class="pos-sale-detail__header">
        <h1 class="pos-sale-detail__title">@sale.SaleNumber</h1>
        <p class="pos-sale-detail__subtitle">@L["Sales_DetailSubtitle"]</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Sales_OfflineTitle"]" Message="@L["Sales_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Sales_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Sales_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-sale-detail__summary" aria-labelledby="sale-summary-heading">
        <h2 id="sale-summary-heading" class="pos-sale-detail__section-title">@L["Sales_DetailSection"]</h2>

        <div class="pos-sale-detail__status-block">
            <Badge Tone="@(isCompleted ? BadgeTone.Success : isAwaitingPayment ? BadgeTone.Warning : BadgeTone.Neutral)">
                @SalesUiOptions.StatusLabel(L, sale.Status)
            </Badge>
            <p class="pos-sale-detail__when">@FormatRecorded(sale.RecordedAtUtc)</p>
            @if (!string.IsNullOrWhiteSpace(paymentRegisterLine))
            {
                <p class="pos-sale-detail__context">@paymentRegisterLine</p>
            }
            @if (!string.IsNullOrWhiteSpace(sale.StoreDisplayName))
            {
                <p class="pos-sale-detail__context pos-muted">@sale.StoreDisplayName</p>
            }
            @if (!string.IsNullOrWhiteSpace(_cashierName))
            {
                <p class="pos-sale-detail__context pos-muted">
                    <span>@L["Sales_Field_Cashier"]</span>
                    <span aria-hidden="true"> · </span>
                    <span>@_cashierName</span>
                </p>
            }
        </div>

        <dl class="pos-sale-detail__totals">
            <div class="pos-sale-detail__total-row">
                <dt>@L["Sales_Field_Subtotal"]</dt>
                <dd><MoneyDisplay Amount="@sale.Subtotal" CurrencyCode="@currency" /></dd>
            </div>
            <div class="pos-sale-detail__total-row">
                <dt>@L["Sales_Field_Tax"]</dt>
                <dd><MoneyDisplay Amount="@sale.TaxAmount" CurrencyCode="@currency" /></dd>
            </div>
            <div class="pos-sale-detail__total-row pos-sale-detail__total-row--emphasis">
                <dt>@L["Sales_Col_Total"]</dt>
                <dd><MoneyDisplay Amount="@sale.Total" CurrencyCode="@currency" Emphasized="true" /></dd>
            </div>
            @if (sale.AmountTendered is not null)
            {
                <div class="pos-sale-detail__total-row">
                    <dt>@L["Sales_Field_AmountTendered"]</dt>
                    <dd><MoneyDisplay Amount="@sale.AmountTendered.Value" CurrencyCode="@currency" /></dd>
                </div>
                <div class="pos-sale-detail__total-row">
                    <dt>@L["Sales_Field_ChangeAmount"]</dt>
                    <dd><MoneyDisplay Amount="@(sale.ChangeAmount ?? 0m)" CurrencyCode="@currency" /></dd>
                </div>
            }
        </dl>
    </section>

    @if (!string.IsNullOrWhiteSpace(sale.GCashReference)
         || _paymentAttempt is not null
         || isUtang
         || !isCompleted
         || !string.IsNullOrWhiteSpace(sale.ReceiptHeader)
         || !string.IsNullOrWhiteSpace(sale.BusinessAddress)
         || !string.IsNullOrWhiteSpace(sale.ContactPhone))
    {
        <section class="pos-sale-detail__extra" aria-label="@L["Sales_DetailSection"]">
            @if (!string.IsNullOrWhiteSpace(sale.GCashReference))
            {
                <div class="pos-sale-detail__extra-block">
                    <span class="pos-muted">@L["Sales_Field_GCashReference"]</span>
                    <div class="pos-sale-detail__extra-value pos-wrap">@sale.GCashReference</div>
                    <div class="pos-muted">@L["Sales_GCash_ManualWarning"]</div>
                </div>
            }
            @if (_paymentAttempt is not null)
            {
                <div class="pos-sale-detail__extra-block">
                    <span class="pos-muted">@L["Sales_Field_PaymentStatus"]</span>
                    <div class="pos-sale-detail__extra-value">@PaymentsUiOptions.AttemptStatusLabel(L, _paymentAttempt.Status)</div>
                    @if (!string.IsNullOrWhiteSpace(_paymentAttempt.Provider))
                    {
                        <div class="pos-muted">@_paymentAttempt.Provider</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_paymentAttempt.ProviderReference))
                    {
                        <div class="pos-sale-detail__extra-value pos-wrap">@_paymentAttempt.ProviderReference</div>
                    }
                    @if (_paymentAttempt.CompletedAtUtc is DateTimeOffset paidAt)
                    {
                        <div class="pos-muted">@paidAt.ToLocalTime().ToString("g")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_paymentAttempt.CardBrand) || !string.IsNullOrWhiteSpace(_paymentAttempt.CardLastFour))
                    {
                        <div class="pos-muted">
                            @_paymentAttempt.CardBrand
                            @if (!string.IsNullOrWhiteSpace(_paymentAttempt.CardLastFour))
                            {
                                <span>· ···@_paymentAttempt.CardLastFour</span>
                            }
                        </div>
                    }
                </div>
            }
            @if (isUtang)
            {
                @if (sale.CustomerId is not null)
                {
                    <div class="pos-sale-detail__extra-block">
                        <span class="pos-muted">@L["Sales_Detail_LinkedCustomer"]</span>
                        <div class="pos-sale-detail__extra-value">
                            <a class="pos-link" href="@($"/customers/{sale.CustomerId.Value:D}")">
                                @(string.IsNullOrWhiteSpace(sale.CustomerDisplayName) ? L["Sales_Detail_CustomerFallback"] : sale.CustomerDisplayName)
                            </a>
                        </div>
                    </div>
                }
                @if (sale.CustomerId is not null && sale.LinkedCreditEntryId is not null)
                {
                    <div class="pos-sale-detail__extra-block">
                        <span class="pos-muted">@L["Sales_Detail_LinkedCredit"]</span>
                        <div class="pos-sale-detail__extra-value">
                            <a class="pos-link" href="@($"/customers/{sale.CustomerId.Value:D}/credit/{sale.LinkedCreditEntryId.Value:D}")">
                                @L["Sales_Detail_OpenCredit"]
                            </a>
                        </div>
                    </div>
                }
                <div class="pos-sale-detail__extra-block">
                    <span class="pos-muted">@L["Sales_Detail_LinkedDueDate"]</span>
                    <div class="pos-sale-detail__extra-value">@(sale.LinkedCreditDueDate?.ToString("d") ?? L["DueDate_None"])</div>
                </div>
                @if (sale.CustomerOutstandingAfter is not null)
                {
                    <div class="pos-sale-detail__extra-block">
                        <span class="pos-muted">@L["Sales_Detail_OutstandingAfter"]</span>
                        <div class="pos-sale-detail__extra-value">
                            <MoneyDisplay Amount="@sale.CustomerOutstandingAfter.Value" CurrencyCode="PHP" />
                        </div>
                    </div>
                }
            }
            @if (!isCompleted)
            {
                <div class="pos-sale-detail__extra-block">
                    <span class="pos-muted">@L["Sales_Field_VoidReason"]</span>
                    <div class="pos-sale-detail__extra-value pos-wrap">@sale.VoidReason</div>
                    <div class="pos-muted">@(sale.VoidedAtUtc?.ToLocalTime().ToString("g"))</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(sale.ReceiptHeader)
                 || !string.IsNullOrWhiteSpace(sale.BusinessAddress)
                 || !string.IsNullOrWhiteSpace(sale.ContactPhone))
            {
                <div class="pos-sale-detail__extra-block">
                    @if (!string.IsNullOrWhiteSpace(sale.ReceiptHeader))
                    {
                        <div class="pos-sale-detail__extra-value pos-wrap">@sale.ReceiptHeader</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(sale.BusinessAddress))
                    {
                        <div class="pos-muted pos-wrap">@sale.BusinessAddress</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(sale.ContactPhone))
                    {
                        <div class="pos-muted">@sale.ContactPhone</div>
                    }
                </div>
            }
        </section>
    }

    <Section Title="@L["Sales_LinesSection"]">
        <Stack Gap="2">
            @foreach (var line in sale.Lines)
            {
                <div class="pos-sale-detail__line">
                    <div class="pos-sale-detail__line-main">
                        <span class="pos-sale-detail__line-name">@line.Name</span>
                        <MoneyDisplay Amount="@line.LineTotal" CurrencyCode="PHP" />
                    </div>
                    <div class="pos-sale-detail__line-meta pos-muted">
                        <span>@SalesUiOptions.UnitOfMeasureLabel(L, line.UnitOfMeasure)</span>
                        <span aria-hidden="true"> · </span>
                        <span class="pos-tabular">@line.Quantity.ToString("0.###")</span>
                        <span aria-hidden="true"> × </span>
                        <MoneyDisplay Amount="@line.UnitPrice" CurrencyCode="PHP" />
                    </div>
                </div>
            }
        </Stack>
    </Section>

    @if (_returns.Count > 0)
    {
        <Section Title="@L["Returns_HistorySection"]">
            <Stack Gap="2">
                @foreach (var ret in _returns)
                {
                    <div class="pos-sale-detail__line">
                        <div class="pos-sale-detail__line-main">
                            <span class="pos-sale-detail__line-name">@ret.ReturnNumber</span>
                            <MoneyDisplay Amount="@ret.TotalRefundAmount" CurrencyCode="PHP" />
                        </div>
                        <div class="pos-sale-detail__line-meta pos-muted">
                            @ret.CreatedAtUtc.ToLocalTime().ToString("g")
                        </div>
                    </div>
                }
            </Stack>
        </Section>
    }

    @if (isAwaitingPayment && !_isOffline)
    {
        <FormActions>
            <Button Variant="ButtonVariant.Primary" OnClick="GoResumePayment">@L["Sales_Detail_ResumePayment"]</Button>
        </FormActions>
    }

    @if (isCompleted)
    {
        <FormActions>
            @if (canReceipt)
            {
                <Button Variant="ButtonVariant.Secondary" OnClick="GoReceipt">@L["Receipt_Open"]</Button>
            }
            @if (canReturn)
            {
                <Button Variant="ButtonVariant.Primary" OnClick="GoReturn">@L["Returns_StartReturn"]</Button>
            }
            <Button Variant="ButtonVariant.Danger" Disabled="@(!canVoid)" OnClick="() => _confirmVoid = true">@L["Sales_Void"]</Button>
        </FormActions>
    }

    <ConfirmDialog Visible="@_confirmVoid"
                   VisibleChanged="v => _confirmVoid = v"
                   Title="@L["Sales_VoidTitle"]"
                   Message="@(isUtang ? L["Sales_VoidUtangMessage"] : L["Sales_VoidMessage"])"
                   Danger="true"
                   ShowReason="true"
                   Reason="@_voidReason"
                   ReasonChanged="v => _voidReason = v"
                   ReasonLabel="@L["Sales_Field_VoidReason"]"
                   ConfirmLabel="@L["Sales_Void"]"
                   IsLoading="@_acting"
                   OnConfirm="VoidAsync" />
</Page>
</div>
}

@code {
    [Parameter] public Guid SaleId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _acting;
    private bool _confirmVoid;
    private bool _isOffline;
    private bool _headerInner;
    private PosSaleDto? _sale;
    private string? _voidReason;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;
    private string? _cashierName;
    private List<PosSaleReturnDto> _returns = [];
    private PaymentAttemptDto? _paymentAttempt;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        HeaderState.EnterInner("/sales");
        _headerInner = true;
        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _cashierName = null;

        // Sales are server-only, so an offline device cannot show a sale at all.
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _sale = null;
            _errorTitle = L["Sales_OfflineTitle"];
            _errorMessage = L["Sales_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Sales.GetSaleAsync(SaleId);
        if (result.IsSuccess && result.Data is not null)
        {
            _sale = result.Data;
            await LoadCashierNameAsync(_sale.RecordedBy);
            await LoadPaymentAttemptAsync();
            if (Capabilities.IsAllowed(UtangCapability.ViewReturns))
            {
                var returnsResult = await SaleReturns.ListReturnsAsync(saleId: SaleId);
                if (returnsResult.IsSuccess && returnsResult.Data is not null)
                {
                    _returns = returnsResult.Data.Items;
                }
            }
        }
        else
        {
            _sale = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task LoadCashierNameAsync(Guid recordedBy)
    {
        try
        {
            var userResult = await Platform.GetUserAsync(recordedBy);
            if (userResult.IsSuccess && userResult.Data is not null)
            {
                _cashierName = FirstMeaningful(userResult.Data.DisplayName, userResult.Data.Username, userResult.Data.Email);
            }
        }
        catch
        {
            _cashierName = null;
        }
    }

    private async Task LoadPaymentAttemptAsync()
    {
        _paymentAttempt = null;
        if (_sale is null || !SalesUiOptions.IsElectronicPaymentMethod(_sale.PaymentMethod))
        {
            return;
        }

        var pending = PendingPayment.Get();
        if (pending is not null && pending.SaleId == _sale.SaleId && pending.AttemptId is Guid attemptId)
        {
            var attemptResult = await PaymentAttempts.GetAsync(attemptId);
            if (attemptResult.IsSuccess && attemptResult.Data is not null)
            {
                _paymentAttempt = attemptResult.Data;
            }
        }
    }

    private void GoResumePayment()
    {
        if (_sale is null)
        {
            return;
        }

        var pending = PendingPayment.Get();
        if (pending?.SaleId != _sale.SaleId)
        {
            PendingPayment.Save(new PendingPaymentState(
                _sale.SaleId,
                null,
                Guid.NewGuid().ToString("N"),
                CurrentUser.Session?.OrganizationId,
                _sale.PaymentMethod));
        }

        Nav.NavigateTo("/sales/new");
    }

    private async Task VoidAsync()
    {
        if (string.IsNullOrWhiteSpace(_voidReason))
        {
            return;
        }

        _acting = true;
        _errorTitle = null;
        _errorMessage = null;
        var result = await Sales.VoidSaleAsync(SaleId, new VoidSaleRequest(_voidReason!));
        _acting = false;
        _confirmVoid = false;

        if (result.IsSuccess && result.Data is not null)
        {
            _sale = result.Data;
            _voidReason = null;
            _banner = L["Sales_VoidedSuccess"];
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }

    private void GoReturn() => Nav.NavigateTo($"/sales/{SaleId:D}/return");

    private void GoReceipt() => Nav.NavigateTo($"/sales/{SaleId:D}/receipt");

    private string BuildPaymentRegisterLine(string? paymentMethod, string? registerLabel)
    {
        var payment = SalesUiOptions.PaymentMethodLabel(L, paymentMethod);
        if (!string.IsNullOrWhiteSpace(payment) && !string.IsNullOrWhiteSpace(registerLabel))
        {
            return $"{payment} · {registerLabel}";
        }

        return FirstMeaningful(payment, registerLabel) ?? string.Empty;
    }

    private static string FormatRecorded(DateTimeOffset recordedAtUtc) =>
        recordedAtUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt");

    private static string? FirstMeaningful(params string?[] values)
    {
        foreach (var value in values)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                continue;
            }

            var trimmed = value.Trim();
            if (Guid.TryParse(trimmed, out _))
            {
                continue;
            }

            return trimmed;
        }

        return null;
    }

    public void Dispose()
    {
        if (_headerInner)
        {
            HeaderState.ExitInner();
            _headerInner = false;
        }
    }
}

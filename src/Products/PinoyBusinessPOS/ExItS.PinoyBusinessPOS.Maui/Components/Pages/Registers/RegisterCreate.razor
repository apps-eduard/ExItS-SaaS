@page "/registers/new"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosRegisterClient Registers
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/registers" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageRegisters);
    var blocked = !canManage || _isOffline;
<div class="pos-register-create">
<Page>
    <header class="pos-register-create__header">
        <h1 class="pos-register-create__title">@L["Registers_CreateTitle"]</h1>
        <p class="pos-register-create__subtitle">@L["Registers_CreateSubtitle"]</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Registers_OfflineTitle"]" Message="@L["Registers_OfflineMessage"]" />
    }
    else if (!canManage)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Registers_ErrorTitle"]" Message="@_formError" />
    }

    <section class="pos-register-create__panel" aria-labelledby="register-create-heading">
        <h2 id="register-create-heading" class="pos-register-create__section-title">@L["Registers_FormSection"]</h2>
        <div class="pos-register-create__form">
            <TextInput Label="@L["Registers_Name"]" Value="@_name" ValueChanged="v => _name = v" Disabled="@blocked" />
            <TextInput Label="@L["Registers_Description"]" Value="@_description" ValueChanged="v => _description = v" Disabled="@blocked" />
        </div>
    </section>

    <div class="pos-action-grid pos-action-grid--two pos-register-create__actions" role="group">
        <button type="button"
                class="pos-action-tile"
                disabled="@_saving"
                @onclick="GoBack">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
            <span class="pos-action-tile__label">@L["Registers_Cancel"]</span>
        </button>
        <button type="button"
                class="pos-action-tile pos-action-tile--primary"
                disabled="@(blocked || _saving)"
                @onclick="SaveAsync">
            @if (_saving)
            {
                <Spinner Size="SpinnerSize.Sm" />
            }
            else
            {
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
            }
            <span class="pos-action-tile__label">@L["Registers_Save"]</span>
        </button>
    </div>
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private string? _name;
    private string? _description;
    private string? _formError;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewRegisters))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        _ready = true;
    }

    private async Task SaveAsync()
    {
        if (_saving || _isOffline || !Capabilities.IsAllowed(UtangCapability.ManageRegisters))
        {
            return;
        }

        _saving = true;
        _formError = null;
        var result = await Registers.CreateAsync(new CreateRegisterRequest(_name ?? string.Empty, _description));
        _saving = false;
        if (result.IsSuccess && result.Data is not null)
        {
            Nav.NavigateTo($"/registers/{result.Data.RegisterId:D}", replace: true);
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _formError = result.Error?.Detail ?? described.Message;
    }

    private void GoBack() => Nav.NavigateTo("/registers");
}

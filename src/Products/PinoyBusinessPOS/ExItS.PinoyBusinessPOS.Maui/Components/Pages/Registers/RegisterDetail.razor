@page "/registers/{RegisterId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosRegisterClient Registers
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/registers" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_register is null)
{
    <Page>
        <header class="pos-register-detail__header">
            <h1 class="pos-register-detail__title">@L["Registers_Title"]</h1>
        </header>
        <Alert Tone="AlertTone.Danger" Title="@L["Registers_ErrorTitle"]" Message="@(_errorMessage ?? L["Registers_NotFound"])" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageRegisters);
    var blocked = !canManage || _isOffline;
    var isActive = string.Equals(_register.Status, "Active", StringComparison.OrdinalIgnoreCase);
<div class="pos-register-detail">
<Page>
    <header class="pos-register-detail__header">
        <h1 class="pos-register-detail__title">@_register.Name</h1>
        <p class="pos-register-detail__subtitle">@_register.RegisterCode</p>
        <div class="pos-register-detail__status-row">
            <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">@_register.Status</Badge>
            @if (IsMainRegister(_register))
            {
                <Badge Tone="BadgeTone.Success">@L["Registers_MainBadge"]</Badge>
            }
        </div>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Registers_OfflineTitle"]" Message="@L["Registers_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Registers_ErrorTitle"]" Message="@_actionError" />
    }

    <section class="pos-register-detail__panel" aria-labelledby="register-detail-heading">
        <h2 id="register-detail-heading" class="pos-register-detail__section-title">@L["Registers_DetailSection"]</h2>
        <dl class="pos-register-detail__facts">
            <div class="pos-register-detail__fact">
                <dt>@L["Registers_Col_Code"]</dt>
                <dd>@_register.RegisterCode</dd>
            </div>
            <div class="pos-register-detail__fact">
                <dt>@L["Registers_Col_Status"]</dt>
                <dd>@_register.Status</dd>
            </div>
            <div class="pos-register-detail__fact">
                <dt>@L["Registers_Col_OpenShift"]</dt>
                <dd>@(_register.HasOpenShift ? L["Registers_Yes"] : L["Registers_No"])</dd>
            </div>
            <div class="pos-register-detail__fact">
                <dt>@L["Registers_Description"]</dt>
                <dd class="pos-wrap">@(string.IsNullOrWhiteSpace(_register.Description) ? "—" : _register.Description)</dd>
            </div>
        </dl>
    </section>

    @if (canManage)
    {
        <div class="pos-action-grid pos-action-grid--two pos-register-detail__actions" role="group">
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@blocked"
                    @onclick="GoEdit">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("edit")</span>
                <span class="pos-action-tile__label">@L["Registers_Edit"]</span>
            </button>
            @if (isActive)
            {
                <button type="button"
                        class="pos-action-tile"
                        disabled="@(blocked || _acting)"
                        @onclick="DeactivateAsync">
                    @if (_acting)
                    {
                        <Spinner Size="SpinnerSize.Sm" />
                    }
                    else
                    {
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                    }
                    <span class="pos-action-tile__label">@L["Registers_Deactivate"]</span>
                </button>
            }
            else
            {
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@(blocked || _acting)"
                        @onclick="ActivateAsync">
                    @if (_acting)
                    {
                        <Spinner Size="SpinnerSize.Sm" />
                    }
                    else
                    {
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                    }
                    <span class="pos-action-tile__label">@L["Registers_Activate"]</span>
                </button>
            }
        </div>
    }

    <section class="pos-register-detail__panel" aria-labelledby="register-activity-heading">
        <h2 id="register-activity-heading" class="pos-register-detail__section-title">@L["Registers_ActivitySection"]</h2>
        @if (_activityLoading)
        {
            <Spinner />
        }
        else if (!string.IsNullOrEmpty(_activityError))
        {
            <Alert Tone="AlertTone.Danger" Title="@L["Registers_ErrorTitle"]" Message="@_activityError" />
        }
        else if (_activity is null)
        {
            <div class="pos-muted">—</div>
        }
        else
        {
            <dl class="pos-register-detail__facts">
                <div class="pos-register-detail__fact">
                    <dt>@L["Registers_Col_OpenShift"]</dt>
                    <dd>@_activity.OpenShiftCount</dd>
                </div>
                <div class="pos-register-detail__fact">
                    <dt>@L["Shifts_Title"]</dt>
                    <dd>@_activity.ClosedShiftCount</dd>
                </div>
                <div class="pos-register-detail__fact">
                    <dt>@L["Nav_Sales"]</dt>
                    <dd>@_activity.CompletedSaleCount</dd>
                </div>
                <div class="pos-register-detail__fact">
                    <dt>@L["Reports_Title"]</dt>
                    <dd>@_activity.GrossSalesTotal.ToString("N2")</dd>
                </div>
            </dl>
        }
    </section>
</Page>
</div>
}

@code {
    [Parameter] public Guid RegisterId { get; set; }

    private bool _ready;
    private bool _acting;
    private bool _isOffline;
    private bool _activityLoading;
    private PosRegisterDto? _register;
    private PosRegisterActivityDto? _activity;
    private string? _errorMessage;
    private string? _actionError;
    private string? _activityError;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewRegisters))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        await LoadAsync();
        _ready = true;
    }

    private async Task LoadAsync()
    {
        _actionError = null;
        _activityError = null;
        _activity = null;
        if (_isOffline)
        {
            _errorMessage = L["Registers_OfflineMessage"];
            return;
        }

        var result = await Registers.GetAsync(RegisterId);
        if (result.IsSuccess)
        {
            _register = result.Data;
            await LoadActivityAsync();
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorMessage = result.Error?.Detail ?? described.Message;
        _register = null;
    }

    private async Task LoadActivityAsync()
    {
        _activityLoading = true;
        var activity = await Registers.GetActivityAsync(RegisterId);
        _activityLoading = false;
        if (activity.IsSuccess)
        {
            _activity = activity.Data;
            return;
        }

        _activityError = activity.Error?.Detail ?? ApiLocalizer.Describe(activity.Status, activity.Error).Message;
    }

    private async Task ActivateAsync()
    {
        if (_acting || blockedAction())
        {
            return;
        }

        _acting = true;
        var result = await Registers.ActivateAsync(RegisterId);
        _acting = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _register = result.Data;
            return;
        }

        _actionError = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private async Task DeactivateAsync()
    {
        if (_acting || blockedAction())
        {
            return;
        }

        _acting = true;
        var result = await Registers.DeactivateAsync(RegisterId);
        _acting = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _register = result.Data;
            return;
        }

        _actionError = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private bool blockedAction() =>
        _isOffline || !Capabilities.IsAllowed(UtangCapability.ManageRegisters);

    private void GoEdit() => Nav.NavigateTo($"/registers/{RegisterId:D}/edit");

    private static bool IsMainRegister(PosRegisterDto register) =>
        string.Equals(register.Name, "Main Register", StringComparison.OrdinalIgnoreCase)
        || string.Equals(register.RegisterCode, "REG-000001", StringComparison.OrdinalIgnoreCase);
}

@page "/registers"
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject ICurrentUserContext CurrentUser
@inject IPosRegisterClient Registers
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageRegisters);
    var onlineActionsEnabled = !_isOffline && !_loading;
    var showEmptyAdd = canManage && !_isOffline && !HasListQuery;
<div class="pos-registers">
    <Page>
        <header class="pos-registers__header">
            <div class="pos-registers__heading">
                <h1 class="pos-registers__title">@L["Registers_Title"]</h1>
                <p class="pos-registers__subtitle">@L["Registers_Subtitle"]</p>
            </div>
            @if (canManage)
            {
                <div class="pos-registers__add">
                    <Button Variant="ButtonVariant.Primary"
                            Size="ButtonSize.Sm"
                            Disabled="@_isOffline"
                            OnClick="GoNew">
                        @L["Registers_Add"]
                    </Button>
                </div>
            }
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Registers_OfflineTitle"]" Message="@L["Registers_OfflineMessage"]" />
        }

        <div class="pos-registers__toolbar" role="search">
            <SearchBar Value="@_search"
                       ValueChanged="OnSearchInputAsync"
                       Placeholder="@L["Registers_SearchPlaceholder"]"
                       AriaLabel="@L["Registers_SearchPlaceholder"]"
                       ClearLabel="@L["Registers_ClearSearch"]"
                       Disabled="@(_loading && string.IsNullOrWhiteSpace(_search))"
                       OnClear="ClearSearchAsync" />
            <button type="button"
                    class="pos-registers__refresh"
                    title="@L["Registers_Refresh"]"
                    aria-label="@L["Registers_Refresh"]"
                    disabled="@(!onlineActionsEnabled)"
                    @onclick="ReloadWithLoadingAsync">
                @if (_loading)
                {
                    <Spinner Size="SpinnerSize.Sm" />
                }
                else
                {
                    <span aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                }
            </button>
        </div>

        <div class="pos-registers__segments"
             role="radiogroup"
             aria-label="@L["Registers_Filter_Status"]">
            @foreach (var option in StatusSegmentOptions)
            {
                var selected = string.Equals(option.Value, _statusFilter ?? string.Empty, StringComparison.Ordinal);
                <button type="button"
                        class="pos-registers__segment @(selected ? "pos-registers__segment--selected" : null)"
                        role="radio"
                        aria-checked="@selected"
                        disabled="@_isOffline"
                        @onclick="() => OnStatusFilterChanged(option.Value)">
                    @option.Label
                </button>
            }
        </div>

        <section class="pos-registers__list-section"
                 aria-labelledby="registers-list-heading"
                 aria-busy="@_loading">
            <h2 id="registers-list-heading" class="visually-hidden">@L["Registers_Title"]</h2>

            @if (_loading && _items.Count == 0 && string.IsNullOrEmpty(_errorTitle))
            {
                <div class="pos-registers__loading" role="status" aria-live="polite">
                    <Spinner />
                    <span class="pos-muted">@L["Registers_Loading"]</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorTitle))
            {
                <ErrorState Title="@_errorTitle"
                            Message="@(_errorMessage ?? L["Registers_EmptyMessage"])"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadWithLoadingAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState Title="@(HasListQuery ? L["Registers_NoMatchTitle"] : L["Registers_EmptyTitle"])"
                            Message="@(HasListQuery ? L["Registers_NoMatchMessage"] : L["Registers_EmptyMessage"])">
                    <Actions>
                        @if (showEmptyAdd)
                        {
                            <Button Variant="ButtonVariant.Primary"
                                    Size="ButtonSize.Sm"
                                    OnClick="GoNew">
                                @L["Registers_Add"]
                            </Button>
                        }
                    </Actions>
                </EmptyState>
            }
            else
            {
                <div class="pos-registers__list" role="list" aria-label="@L["Registers_Title"]">
                    @foreach (var item in _items)
                    {
                        <button type="button"
                                class="pos-registers__row"
                                role="listitem"
                                disabled="@_isOffline"
                                aria-label="@RowAriaLabel(item)"
                                @onclick="() => GoDetail(item.RegisterId)">
                            <span class="pos-registers__row-body">
                                <span class="pos-registers__row-top">
                                    <span class="pos-registers__row-name">@item.Name</span>
                                    <span class="pos-registers__badge pos-registers__badge--@StatusTone(item.Status)"
                                          aria-label="@($"{L["Registers_Col_Status"]}: {StatusLabel(item.Status)}")">
                                        @StatusLabel(item.Status)
                                    </span>
                                </span>
                                <span class="pos-registers__row-meta pos-muted">@RowMeta(item)</span>
                            </span>
                            <span class="pos-registers__chevron" aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            }
        </section>

        @if (!_loading && TotalPages > 1)
        {
            <div class="pos-registers__pager">
                <Pagination Page="@_page"
                            PageSize="@_pageSize"
                            TotalCount="@_totalCount"
                            Disabled="@_isOffline"
                            PageChanged="OnPageChanged" />
            </div>
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private string? _search;
    private string? _statusFilter;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosRegisterDto> _items = Array.Empty<PosRegisterDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    private bool HasListQuery =>
        !string.IsNullOrWhiteSpace(_search)
        || !string.IsNullOrWhiteSpace(_statusFilter);

    private IReadOnlyList<(string Value, string Label)> StatusSegmentOptions =>
    [
        (string.Empty, L["Registers_Filter_All"].Value),
        (RegisterUiOptions.ActiveStatus, L["Registers_Status_Active"].Value),
        (RegisterUiOptions.InactiveStatus, L["Registers_Status_Inactive"].Value),
    ];

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged += OnConnectivityChanged;

        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewRegisters))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        _ready = true;
        await ReloadAsync(showLoading: true);
    }

    public void Dispose()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private async void OnConnectivityChanged(object? sender, ConnectivityStatus status)
    {
        var wasOffline = _isOffline;
        _isOffline = status == ConnectivityStatus.Offline;
        await InvokeAsync(StateHasChanged);
        if (wasOffline && !_isOffline && Capabilities.IsAllowed(UtangCapability.ViewRegisters))
        {
            await InvokeAsync(() => ReloadAsync(showLoading: true));
        }
    }

    private Task ReloadWithLoadingAsync() => ReloadAsync(showLoading: true);

    private async Task OnSearchInputAsync(string? value)
    {
        _search = value;
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync(showLoading: true);
        }
        catch (OperationCanceledException)
        {
            // superseded by newer keystrokes
        }
    }

    private async Task ClearSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return;
        }

        _search = null;
        _page = 1;
        await ReloadAsync(showLoading: true);
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        var next = value ?? string.Empty;
        if (string.Equals(next, _statusFilter ?? string.Empty, StringComparison.Ordinal))
        {
            return;
        }

        _statusFilter = next;
        _page = 1;
        await ReloadAsync(showLoading: true);
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync(showLoading: true);
    }

    private async Task ReloadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _loading = true;
            _errorTitle = null;
            _errorMessage = null;
        }

        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                if (showLoading)
                {
                    _items = Array.Empty<PosRegisterDto>();
                    _totalCount = 0;
                }

                return;
            }

            var result = await Registers.ListAsync(
                name: _search,
                status: string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                page: _page,
                pageSize: _pageSize);

            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
                _totalCount = result.Data.TotalCount;
                if (_page > TotalPages)
                {
                    _page = TotalPages;
                }

                _errorTitle = null;
                _errorMessage = null;
                return;
            }

            if (showLoading || _items.Count == 0)
            {
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = result.Error?.Detail ?? described.Message;
                _items = Array.Empty<PosRegisterDto>();
                _totalCount = 0;
            }
        }
        catch
        {
            if (showLoading || _items.Count == 0)
            {
                _errorTitle = L["Registers_ErrorTitle"];
                _errorMessage = L["Registers_EmptyMessage"];
                _items = Array.Empty<PosRegisterDto>();
                _totalCount = 0;
            }
        }
        finally
        {
            if (showLoading)
            {
                _loading = false;
            }
        }
    }

    private void GoNew() => Nav.NavigateTo("/registers/new");

    private void GoDetail(Guid id) => Nav.NavigateTo($"/registers/{id:D}");

    private string StatusLabel(string? status) =>
        string.Equals(status, RegisterUiOptions.ActiveStatus, StringComparison.OrdinalIgnoreCase)
            ? L["Registers_Status_Active"]
            : string.Equals(status, RegisterUiOptions.InactiveStatus, StringComparison.OrdinalIgnoreCase)
                ? L["Registers_Status_Inactive"]
                : string.IsNullOrWhiteSpace(status) ? L["Registers_Status_Inactive"] : status;

    private static string StatusTone(string? status) =>
        string.Equals(status, RegisterUiOptions.ActiveStatus, StringComparison.OrdinalIgnoreCase) ? "active"
        : string.Equals(status, RegisterUiOptions.InactiveStatus, StringComparison.OrdinalIgnoreCase) ? "inactive"
        : "neutral";

    private string RowMeta(PosRegisterDto item)
    {
        if (item.HasOpenShift)
        {
            return $"{item.RegisterCode} · {L["Registers_OpenShiftHint"].Value}";
        }

        return item.RegisterCode;
    }

    private string RowAriaLabel(PosRegisterDto item)
    {
        var open = item.HasOpenShift ? L["Registers_OpenShiftHint"].Value : L["Registers_No"].Value;
        return $"{item.Name}, {StatusLabel(item.Status)}, {item.RegisterCode}, {L["Registers_Col_OpenShift"]}: {open}";
    }
}

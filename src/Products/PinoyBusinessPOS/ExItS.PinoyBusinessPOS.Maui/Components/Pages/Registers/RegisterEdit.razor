@page "/registers/{RegisterId:guid}/edit"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosRegisterClient Registers
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/registers" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_register is null)
{
    <Page>
        <Alert Tone="AlertTone.Danger" Title="@L["Registers_ErrorTitle"]" Message="@(_errorMessage ?? L["Registers_NotFound"])" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageRegisters);
    var blocked = !canManage || _isOffline;
<div class="pos-register-edit">
<Page>
    <header class="pos-register-edit__header">
        <h1 class="pos-register-edit__title">@L["Registers_EditTitle"]</h1>
        <p class="pos-register-edit__subtitle">@_register.RegisterCode</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Registers_OfflineTitle"]" Message="@L["Registers_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Registers_ErrorTitle"]" Message="@_formError" />
    }

    <section class="pos-register-edit__panel" aria-labelledby="register-edit-heading">
        <h2 id="register-edit-heading" class="pos-register-edit__section-title">@L["Registers_FormSection"]</h2>
        <div class="pos-register-edit__form">
            <TextInput Label="@L["Registers_Name"]" Value="@_name" ValueChanged="v => _name = v" Disabled="@blocked" />
            <TextInput Label="@L["Registers_Description"]" Value="@_description" ValueChanged="v => _description = v" Disabled="@blocked" />
        </div>
    </section>

    <div class="pos-action-grid pos-action-grid--two pos-register-edit__actions" role="group">
        <button type="button"
                class="pos-action-tile"
                disabled="@_saving"
                @onclick="GoDetail">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
            <span class="pos-action-tile__label">@L["Registers_Cancel"]</span>
        </button>
        <button type="button"
                class="pos-action-tile pos-action-tile--primary"
                disabled="@(blocked || _saving)"
                @onclick="SaveAsync">
            @if (_saving)
            {
                <Spinner Size="SpinnerSize.Sm" />
            }
            else
            {
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
            }
            <span class="pos-action-tile__label">@L["Registers_Save"]</span>
        </button>
    </div>
</Page>
</div>
}

@code {
    [Parameter] public Guid RegisterId { get; set; }

    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private PosRegisterDto? _register;
    private string? _name;
    private string? _description;
    private string? _errorMessage;
    private string? _formError;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManageRegisters))
        {
            Nav.NavigateTo($"/registers/{RegisterId:D}", replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!_isOffline)
        {
            var result = await Registers.GetAsync(RegisterId);
            if (result.IsSuccess && result.Data is not null)
            {
                _register = result.Data;
                _name = result.Data.Name;
                _description = result.Data.Description;
            }
            else
            {
                _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
            }
        }

        _ready = true;
    }

    private async Task SaveAsync()
    {
        if (_saving || _register is null || _isOffline)
        {
            return;
        }

        _saving = true;
        _formError = null;
        var result = await Registers.UpdateAsync(
            RegisterId,
            new UpdateRegisterRequest(_name ?? string.Empty, _register.UpdatedAtUtc, _description));
        _saving = false;
        if (result.IsSuccess && result.Data is not null)
        {
            Nav.NavigateTo($"/registers/{RegisterId:D}", replace: true);
            return;
        }

        _formError = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private void GoDetail() => Nav.NavigateTo($"/registers/{RegisterId:D}");
}

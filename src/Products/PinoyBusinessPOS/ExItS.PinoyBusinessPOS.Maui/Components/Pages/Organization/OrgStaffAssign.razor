@page "/org/staff/assign"
@using ExItS.DesignSystem.Components.Internal
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-assign">
    <Page>
        <header class="pos-assign__header">
            <button type="button"
                    class="pos-assign__back"
                    disabled="@_busy"
                    @onclick="GoBack">
                <span aria-hidden="true">‹</span>
                <span>@L["Common_Back"]</span>
            </button>
            <h1 class="pos-assign__title">@L["Org_AssignTitle"]</h1>
            <p class="pos-assign__subtitle">@L["Org_AssignSubtitle"]</p>
            @if (!string.IsNullOrWhiteSpace(CurrentUser.Session?.OrganizationDisplayName))
            {
                <p class="pos-assign__org pos-muted">@CurrentUser.Session!.OrganizationDisplayName</p>
            }
        </header>

        <FormValidationSummary Messages="_errors" />

        <section class="pos-assign__section" aria-labelledby="assign-user-heading">
            <h2 id="assign-user-heading" class="pos-assign__section-title">@L["Org_AssignUserSection"]</h2>

            @if (_loadingUser)
            {
                <Spinner />
            }
            else if (!string.IsNullOrEmpty(_userLoadError))
            {
                <ErrorState Title="@L["Org_ErrorTitle"]" Message="@_userLoadError" />
            }
            else if (_targetUserId is Guid)
            {
                <div class="pos-assign__user" aria-live="polite">
                    <Avatar Name="@_displayName"
                            Size="AvatarSize.Sm"
                            AriaLabel="@_displayName" />
                    <div class="pos-assign__user-body">
                        <span class="pos-assign__user-name">@_displayName</span>
                        @if (!string.IsNullOrWhiteSpace(_email))
                        {
                            <span class="pos-muted">@_email</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_publicUserId))
                        {
                            <span class="pos-muted">
                                <span class="pos-assign__id-label">@L["Personal_ExItsIdLabel"]</span>
                                @_publicUserId
                            </span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_existingRoleCode))
                {
                    <p class="pos-assign__replace-hint pos-muted">
                        @string.Format(L["Org_AssignReplaceHint"].Value, FriendlyRoleLabel(_existingRoleCode))
                    </p>
                }
            }
            else
            {
                <ErrorState Title="@L["Org_ErrorTitle"]" Message="@L["Org_AssignValidation"]" />
            }
        </section>

        <section class="pos-assign__section" aria-labelledby="assign-role-heading">
            <h2 id="assign-role-heading" class="pos-assign__section-title">@L["Org_AssignRoleSection"]</h2>
            <div class="pos-assign__roles" role="radiogroup" aria-labelledby="assign-role-heading">
                @foreach (var option in RoleOptions)
                {
                    var selected = string.Equals(_selectedRoleCode, option.Code, StringComparison.Ordinal);
                    <button type="button"
                            class="@(selected ? "pos-assign__role pos-assign__role--selected" : "pos-assign__role")"
                            role="radio"
                            aria-checked="@selected"
                            disabled="@(_busy || _targetUserId is null)"
                            @onclick="() => SelectRole(option.Code)">
                        <span class="pos-assign__role-check" aria-hidden="true">@(selected ? "✓" : "")</span>
                        <span class="pos-assign__role-copy">
                            <span class="pos-assign__role-label">@option.Label</span>
                            <span class="pos-assign__role-desc pos-muted">@option.Description</span>
                        </span>
                    </button>
                }
            </div>
        </section>

        @if (_showOwnerConfirm)
        {
            <div class="pos-assign__confirm" role="alertdialog" aria-labelledby="assign-owner-confirm-title" aria-live="assertive">
                <p id="assign-owner-confirm-title" class="pos-assign__confirm-title">@L["Org_AssignOwnerConfirmTitle"]</p>
                <p class="pos-assign__confirm-message pos-muted">@L["Org_AssignOwnerConfirmMessage"]</p>
                <div class="pos-assign__confirm-actions">
                    <Button Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="CancelOwnerConfirm">
                        @L["Catalog_Cancel"]
                    </Button>
                    <Button Variant="ButtonVariant.Primary" IsLoading="_busy" Disabled="_busy" OnClick="ConfirmOwnerAndAssignAsync">
                        @L["Org_AssignOwnerConfirmAction"]
                    </Button>
                </div>
            </div>
        }

        <div class="pos-assign__actions">
            <Button Variant="ButtonVariant.Primary"
                    IsLoading="_busy"
                    Disabled="@(!CanSubmit)"
                    OnClick="AssignAsync">
                @L["Org_AssignSubmit"]
            </Button>
        </div>
    </Page>
</div>

<style>
    .pos-assign { width: 100%; }
    .pos-assign__header { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-assign__back {
        display: inline-flex; align-items: center; gap: 0.15rem;
        margin: 0 0 0.35rem; padding: 0.15rem 0; border: 0; background: transparent;
        color: var(--exits-accent, #1f6b4a); font-size: 0.875rem; font-weight: 600; cursor: pointer;
    }
    .pos-assign__back:disabled { opacity: 0.45; cursor: not-allowed; }
    .pos-assign__title {
        margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.25;
        color: var(--exits-text, #15201a);
    }
    .pos-assign__subtitle {
        margin: 0.3rem 0 0; font-size: 0.875rem; line-height: 1.35;
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-assign__org {
        margin: 0.25rem 0 0; font-size: 0.75rem; line-height: 1.3;
    }
    .pos-assign__section { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-assign__section-title {
        margin: 0 0 0.5rem; font-size: 0.8125rem; font-weight: 700;
        letter-spacing: 0.02em; text-transform: uppercase;
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-assign__user {
        display: flex; align-items: center; gap: 0.65rem;
        padding: 0.55rem 0.65rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-assign__user-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
    .pos-assign__user-name { font-weight: 650; font-size: 0.9375rem; line-height: 1.3; }
    .pos-assign__id-label { font-weight: 600; margin-inline-end: 0.25rem; }
    .pos-assign__replace-hint {
        margin: 0.45rem 0 0; font-size: 0.75rem; line-height: 1.35;
    }
    .pos-assign__roles { display: flex; flex-direction: column; gap: 0.5rem; }
    .pos-assign__role {
        display: flex; align-items: flex-start; gap: 0.55rem; width: 100%;
        min-height: 2.75rem; padding: 0.65rem 0.7rem; text-align: start;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
        color: var(--exits-text, #15201a); cursor: pointer;
    }
    .pos-assign__role:disabled { opacity: 0.45; cursor: not-allowed; }
    .pos-assign__role--selected {
        border-color: var(--exits-accent, #1f6b4a);
        border-width: 2px;
        background: color-mix(in srgb, var(--exits-accent, #1f6b4a) 8%, white);
        box-shadow: inset 0 0 0 1px var(--exits-accent, #1f6b4a);
    }
    .pos-assign__role-check {
        flex: 0 0 1.1rem; width: 1.1rem; margin-top: 0.1rem;
        font-size: 0.875rem; font-weight: 700; color: var(--exits-accent, #1f6b4a);
    }
    .pos-assign__role-copy { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
    .pos-assign__role-label { font-size: 0.9375rem; font-weight: 650; line-height: 1.25; }
    .pos-assign__role-desc { font-size: 0.75rem; line-height: 1.35; }
    .pos-assign__confirm {
        margin: 0 0 0.85rem; padding: 0.7rem 0.75rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-assign__confirm-title { margin: 0; font-size: 0.9375rem; font-weight: 700; }
    .pos-assign__confirm-message { margin: 0.35rem 0 0.65rem; font-size: 0.75rem; line-height: 1.4; }
    .pos-assign__confirm-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .pos-assign__actions {
        position: sticky; bottom: 0; z-index: 2;
        padding: 0.65rem 0 calc(0.65rem + env(safe-area-inset-bottom, 0px));
        background: linear-gradient(to top, var(--exits-bg, #f3f6f4) 70%, transparent);
    }
    .pos-assign__actions .exds-btn { width: 100%; min-height: 2.75rem; }
</style>

@code {
    /// <summary>Platform product-local role codes (Owner / Manager / Cashier).</summary>
    private const string RoleOwner = "Owner";
    private const string RoleManager = "Manager";
    private const string RoleCashier = "Cashier";

    [SupplyParameterFromQuery] public Guid? userId { get; set; }

    [SupplyParameterFromQuery(Name = "displayName")]
    public string? DisplayNameQuery { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailQuery { get; set; }

    private bool _busy;
    private bool _loadingUser;
    private Guid? _targetUserId;
    private string _displayName = string.Empty;
    private string? _email;
    private string? _publicUserId;
    private string? _userLoadError;
    private string? _selectedRoleCode;
    private string? _existingRoleCode;
    private bool _showOwnerConfirm;
    private bool _ownerConfirmed;
    private List<string> _errors = [];

    private IReadOnlyList<RoleOption> RoleOptions =>
    [
        new(RoleOwner, L["Org_RoleOwner"], L["Org_RoleOwnerDesc"]),
        new(RoleManager, L["Org_RoleManager"], L["Org_RoleManagerDesc"]),
        new(RoleCashier, L["Org_RoleCashier"], L["Org_RoleCashierDesc"]),
    ];

    private bool CanSubmit =>
        !_busy
        && !_loadingUser
        && _targetUserId is not null
        && string.IsNullOrEmpty(_userLoadError)
        && !string.IsNullOrWhiteSpace(_selectedRoleCode)
        && !_showOwnerConfirm;

    protected override async Task OnParametersSetAsync()
    {
        if (userId is Guid id)
        {
            _targetUserId = id;
            await LoadUserAsync(id);
        }
        else
        {
            _targetUserId = null;
            _userLoadError = L["Org_AssignValidation"];
        }
    }

    private async Task LoadUserAsync(Guid id)
    {
        _loadingUser = true;
        _userLoadError = null;
        _publicUserId = null;
        _existingRoleCode = null;

        // Staff list may pass name/email. Prefer those first — GetUserAsync requires
        // Platform ManagePlatformUsers and is unavailable to org owners on mobile.
        _displayName = string.IsNullOrWhiteSpace(DisplayNameQuery)
            ? string.Empty
            : DisplayNameQuery.Trim();
        _email = string.IsNullOrWhiteSpace(EmailQuery) ? null : EmailQuery.Trim();

        try
        {
            try
            {
                var userResult = await Platform.GetUserAsync(id);
                if (userResult.IsSuccess && userResult.Data is not null)
                {
                    var user = userResult.Data;
                    if (string.IsNullOrWhiteSpace(_displayName))
                    {
                        _displayName = string.IsNullOrWhiteSpace(user.DisplayName)
                            ? (string.IsNullOrWhiteSpace(user.Username) ? string.Empty : user.Username)
                            : user.DisplayName;
                    }

                    if (string.IsNullOrWhiteSpace(_email))
                    {
                        _email = user.Email;
                    }
                }
            }
            catch
            {
                // Ignore — fall through to grant / unknown-name fallbacks.
            }

            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is Guid oid)
            {
                var grants = await Platform.GetProductLocalRolesAsync(oid, status: "Active");
                if (grants.IsSuccess && grants.Data is not null)
                {
                    var existing = grants.Data.FirstOrDefault(g => g.UserIdentityId == id);
                    if (existing is not null)
                    {
                        _existingRoleCode = existing.RoleCode;
                        if (string.IsNullOrWhiteSpace(_displayName)
                            && !string.IsNullOrWhiteSpace(existing.UserDisplayName))
                        {
                            _displayName = existing.UserDisplayName!;
                        }
                    }
                }
            }

            if (string.IsNullOrWhiteSpace(_displayName))
            {
                _displayName = L["Org_StaffUnknownName"];
            }
        }
        catch
        {
            if (string.IsNullOrWhiteSpace(_displayName))
            {
                _displayName = L["Org_StaffUnknownName"];
            }
        }
        finally
        {
            _loadingUser = false;
        }
    }

    private void SelectRole(string code)
    {
        if (_busy)
        {
            return;
        }

        _selectedRoleCode = code;
        _errors = [];
        _showOwnerConfirm = false;
        _ownerConfirmed = false;
    }

    private void CancelOwnerConfirm()
    {
        _showOwnerConfirm = false;
        _ownerConfirmed = false;
    }

    private Task ConfirmOwnerAndAssignAsync()
    {
        _ownerConfirmed = true;
        _showOwnerConfirm = false;
        return AssignAsync();
    }

    private async Task AssignAsync()
    {
        if (_busy)
        {
            return;
        }

        _errors = [];

        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null || _targetUserId is null || string.IsNullOrWhiteSpace(_selectedRoleCode))
        {
            if (string.IsNullOrWhiteSpace(_selectedRoleCode))
            {
                _errors.Add(L["Org_AssignSelectRole"]);
            }
            else
            {
                _errors.Add(L["Org_AssignValidation"]);
            }

            return;
        }

        if (string.Equals(_selectedRoleCode, RoleOwner, StringComparison.Ordinal) && !_ownerConfirmed)
        {
            _showOwnerConfirm = true;
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.AssignProductLocalRoleAsync(
                orgId.Value,
                new AssignProductLocalRoleRequest(
                    UserIdentityId: _targetUserId.Value,
                    ProductCode: PosProductCodes.PinoyBusinessPos,
                    RoleCode: _selectedRoleCode,
                    Reason: "Assigned from Mobile Org Owner essentials"));
            if (!result.IsSuccess)
            {
                var detail = result.Error?.Detail ?? result.Error?.Title;
                _errors.Add(string.IsNullOrWhiteSpace(detail) ? L["Org_AssignFailed"] : detail);
                _ownerConfirmed = false;
                return;
            }

            Nav.NavigateTo("/org/staff");
        }
        finally
        {
            _busy = false;
        }
    }

    private string FriendlyRoleLabel(string? code)
    {
        if (string.Equals(code, RoleOwner, StringComparison.OrdinalIgnoreCase)
            || string.Equals(code, "PosOwner", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_RoleOwner"];
        }

        if (string.Equals(code, RoleManager, StringComparison.OrdinalIgnoreCase)
            || string.Equals(code, "StoreManager", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_RoleManager"];
        }

        if (string.Equals(code, RoleCashier, StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_RoleCashier"];
        }

        return string.IsNullOrWhiteSpace(code) ? L["Org_NoPosRoles"] : code!;
    }

    private void GoBack() => Nav.NavigateTo("/org/staff");

    private sealed record RoleOption(string Code, string Label, string Description);
}

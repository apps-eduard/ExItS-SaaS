@page "/organization/branches"
@using ExItS.DesignSystem.Components.Internal
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<PosResources> L
@inject NavigationManager Nav

<div class="pos-branches">
    <StoreHeaderBack Href="/more" />
    <Page>
        <header class="pos-branches__header">
            <div class="pos-branches__title-row">
                <h1>@L["Branches_Title"]</h1>
                @if (!_showCreate && CanAddBranch)
                {
                    <Button Variant="ButtonVariant.Primary"
                            Size="ButtonSize.Sm"
                            Disabled="_busy"
                            OnClick="OpenCreate">@L["Branches_Add"]</Button>
                }
            </div>
            <p class="pos-muted">@L["Branches_Subtitle"]</p>
            @if (_capacity is not null)
            {
                <div class="pos-branches__capacity"
                     role="meter"
                     aria-valuemin="0"
                     aria-valuenow="@_capacity.Used"
                     aria-valuemax="@_capacity.Allowed"
                     aria-label="@L["Branches_Capacity", _capacity.Used, _capacity.Allowed]">
                    <span>@L["Branches_Capacity", _capacity.Used, _capacity.Allowed]</span>
                    <span class="pos-branches__capacity-track" aria-hidden="true">
                        <span class="pos-branches__capacity-fill @(CanAddBranch ? null : "pos-branches__capacity-fill--full")"
                              style="@CapacityFillStyle"></span>
                    </span>
                </div>
            }
            @if (!CanAddBranch)
            {
                <p class="pos-muted pos-branches__capacity-note">@L["Branches_CapacityFull"]</p>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <Alert Tone="AlertTone.Danger" Message="@_error" />
        }

        @if (_showCreate)
        {
            <section class="pos-branches__create" aria-labelledby="branch-create-heading">
                <h2 id="branch-create-heading">@L["Branches_Add"]</h2>
                <p class="pos-branches__hint">@L["Branches_CreateHint"]</p>
                <div class="pos-branches__grid">
                    <TextInput Label="@L["Branches_FieldCode"]" @bind-Value="_newCode" Required autofocus />
                    <TextInput Label="@L["Branches_FieldName"]" @bind-Value="_newName" Required />
                    <TextInput Label="@L["Branches_FieldCity"]" @bind-Value="_newCity" />
                </div>
                <div class="pos-branches__actions">
                    <Button Variant="ButtonVariant.Primary"
                            Disabled="_busy"
                            IsLoading="_busy"
                            OnClick="CreateAsync">@L["Common_Save"]</Button>
                    <Button Variant="ButtonVariant.Ghost" Disabled="_busy" OnClick="CloseCreate">@L["Common_Cancel"]</Button>
                </div>
            </section>
        }

        @if (_loading)
        {
            <div class="pos-branches__loading"><Spinner /><span>@L["Common_Loading"]</span></div>
        }
        else if (_branches.Count == 0)
        {
            @if (!_showCreate)
            {
                <EmptyState IconName="home" Title="@L["Branches_EmptyTitle"]" Message="@L["Branches_EmptyMessage"]">
                    <Actions>
                        @if (CanAddBranch)
                        {
                            <Button Variant="ButtonVariant.Primary" Disabled="_busy" OnClick="OpenCreate">@L["Branches_Add"]</Button>
                        }
                    </Actions>
                </EmptyState>
            }
        }
        else
        {
            <h2 class="pos-branches__list-title">@L["Branches_ListSection"]</h2>
            <div class="pos-branches__list" role="list">
                @foreach (var branch in _branches)
                {
                    var locationMissing = !HasLocation(branch);
                    <article class="pos-branches__item" role="listitem">
                        <button type="button"
                                class="pos-branches__card"
                                aria-label="@($"{L["Branches_Edit"]}: {branch.Name}")"
                                @onclick="() => Edit(branch.Id)">
                            <span class="pos-branches__card-icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
                            <span class="pos-branches__card-body">
                                <span class="pos-branches__card-top">
                                    <strong class="pos-branches__card-name">@branch.Name</strong>
                                    <span class="pos-branches__chips">
                                        @if (branch.IsPrimary) { <Badge Tone="BadgeTone.Info">@L["Branches_Primary"]</Badge> }
                                        <Badge Tone="@(IsActive(branch) ? BadgeTone.Success : BadgeTone.Neutral)">@StatusLabel(branch)</Badge>
                                    </span>
                                </span>
                                <span class="pos-branches__card-meta @(locationMissing ? "pos-branches__card-meta--hint" : "pos-muted")">
                                    @branch.Code · @LocationText(branch)
                                </span>
                                <span class="pos-branches__chips">
                                    @FulfillmentBadge(branch)
                                    @if (branch.PickupEnabled) { <Badge Tone="BadgeTone.Info">@L["Branches_Pickup"]</Badge> }
                                    @if (branch.DeliveryEnabled) { <Badge Tone="BadgeTone.Success">@L["Branches_Delivery"]</Badge> }
                                </span>
                            </span>
                            <span class="pos-branches__card-chevron" aria-hidden="true">@IconGlyphs.Get("back")</span>
                        </button>
                    </article>
                }
            </div>
        }
    </Page>
</div>

@code {
    private IReadOnlyList<OrganizationBranchDto> _branches = [];
    private BranchCapacityDto? _capacity;
    private bool _loading = true;
    private bool _busy;
    private bool _showCreate;
    private string? _newCode;
    private string? _newName;
    private string? _newCity;
    private string? _error;

    private bool CanAddBranch => _capacity is null || _capacity.Used < _capacity.Allowed;

    private string CapacityFillStyle
    {
        get
        {
            if (_capacity is null || _capacity.Allowed <= 0)
            {
                return "width:0%";
            }

            var percent = Math.Clamp(100.0 * _capacity.Used / _capacity.Allowed, 0, 100);
            return $"width:{percent:0.##}%";
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            Nav.NavigateTo("/organization-select", replace: true);
            return;
        }

        _loading = true;
        var branches = await Platform.GetBranchesAsync(orgId);
        var capacity = await Platform.GetBranchCapacityAsync(orgId);
        _branches = branches.IsSuccess && branches.Data is not null ? branches.Data : [];
        _capacity = capacity.IsSuccess ? capacity.Data : null;
        _error = branches.IsSuccess ? null : branches.Error?.Detail ?? L["Branches_LoadFailed"];
        _loading = false;
    }

    private void OpenCreate()
    {
        if (_busy || !CanAddBranch)
        {
            return;
        }

        _error = null;
        _showCreate = true;
    }

    private void CloseCreate()
    {
        if (_busy)
        {
            return;
        }

        _showCreate = false;
        _newCode = _newName = _newCity = null;
    }

    private void Edit(Guid id) => Nav.NavigateTo($"/organization/branches/{id:D}");
    private static bool IsActive(OrganizationBranchDto branch) =>
        string.Equals(branch.Status, "Active", StringComparison.OrdinalIgnoreCase);

    private string StatusLabel(OrganizationBranchDto branch) =>
        string.IsNullOrWhiteSpace(branch.Status)
            ? branch.Status
            : char.ToUpperInvariant(branch.Status[0]) + branch.Status[1..].ToLowerInvariant();

    private static bool HasLocation(OrganizationBranchDto branch) =>
        !string.IsNullOrWhiteSpace(branch.AddressLine1)
        || !string.IsNullOrWhiteSpace(branch.City)
        || !string.IsNullOrWhiteSpace(branch.Region);

    private string LocationText(OrganizationBranchDto branch)
    {
        var location = string.Join(
            ", ",
            new[] { branch.AddressLine1, branch.City, branch.Region }.Where(static s => !string.IsNullOrWhiteSpace(s)));
        return string.IsNullOrWhiteSpace(location) ? L["Branches_AddAddress"].Value : location;
    }

    private RenderFragment FulfillmentBadge(OrganizationBranchDto branch) => builder =>
    {
        var (label, tone) = branch.OnlineOrdersPaused
            ? (L["Branches_StatusPaused"].Value, BadgeTone.Warning)
            : branch.CustomerOrderingEnabled
                ? (L["Branches_StatusEnabled"].Value, BadgeTone.Success)
                : branch.CustomerOrderingReady
                    ? (L["Branches_StatusSetupReady"].Value, BadgeTone.Info)
                    : (L["Branches_StatusSetupRequired"].Value, BadgeTone.Neutral);
        builder.OpenComponent<Badge>(0);
        builder.AddAttribute(1, "Tone", tone);
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, label)));
        builder.CloseComponent();
    };

    private async Task CreateAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId ||
            string.IsNullOrWhiteSpace(_newCode) || string.IsNullOrWhiteSpace(_newName))
        {
            _error = L["Branches_ValidationRequired"];
            return;
        }

        _busy = true;
        var result = await Platform.CreateBranchAsync(
            orgId,
            new CreateBranchRequest(_newCode.Trim(), _newName.Trim(), City: _newCity?.Trim()));
        _busy = false;
        if (!result.IsSuccess)
        {
            _error = result.Error?.Detail ?? L["Branches_SaveFailed"];
            return;
        }

        _newCode = _newName = _newCity = null;
        _showCreate = false;
        await LoadAsync();
    }
}

@page "/org/privacy"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Privacy
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject ICurrentUserContext CurrentUser
@inject IOrganizationOwnerProbe OrganizationOwner
@inject IPosPrivacyReadinessClient Privacy
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_authorized)
{
    <Page>
        <ErrorState Title="@L["Access_DeniedTitle"]" Message="@L["Privacy_DeniedMessage"]" />
    </Page>
}
else
{
    <div class="pos-privacy">
        <StoreHeaderBack Href="/more" />
        <Page>
            <header class="pos-privacy__header">
                <h1 class="pos-privacy__title">@L["Privacy_Title"]</h1>
                <p class="pos-privacy__subtitle">@L["Privacy_Subtitle"]</p>
            </header>

            @if (_loading)
            {
                <div class="pos-privacy__loading"><Spinner /><span>@L["Common_Loading"]</span></div>
            }
            else if (_loadFailed)
            {
                <ErrorState Title="@(_errorTitle ?? L["Privacy_LoadFailed"])"
                            Message="@(_errorMessage ?? L["Privacy_LoadFailedMessage"])"
                            RetryLabel="@L["Common_Retry"]"
                            OnRetry="LoadAsync" />
            }
            else if (_dto is not null)
            {
                <section class="pos-privacy__summary" aria-label="@L["Privacy_ReadinessLabel"]">
                    <div class="pos-privacy__summary-icon" aria-hidden="true">@IconGlyphs.Get("lock")</div>
                    <div class="pos-privacy__summary-body">
                        <div class="pos-privacy__summary-top">
                            <strong class="pos-privacy__summary-label">@L["Privacy_ReadinessLabel"]</strong>
                            <Badge Tone="@StatusTone(_dto.OverallReadiness)">@StatusLabel(_dto.OverallReadiness)</Badge>
                        </div>
                        <p class="pos-privacy__summary-note">@L["Privacy_NoCertificationClaim"]</p>
                    </div>
                </section>

                <section class="pos-privacy__panel" aria-labelledby="privacy-safeguards-heading">
                    <h2 id="privacy-safeguards-heading" class="pos-privacy__section-title">@L["Privacy_SafeguardsSection"]</h2>
                    <p class="pos-privacy__section-subtitle">@L["Privacy_SafeguardsSubtitle"]</p>
                    <div class="pos-privacy__list" role="list">
                        @foreach (var item in _dto.TechnicalSafeguards)
                        {
                            <article class="pos-privacy__card" role="listitem">
                                <div class="pos-privacy__card-icon" aria-hidden="true">@IconGlyphs.Get("lock")</div>
                                <div class="pos-privacy__card-body">
                                    <div class="pos-privacy__card-top">
                                        <strong class="pos-privacy__card-name">@L[item.TitleKey]</strong>
                                        <Badge Tone="@StatusTone(item.Status)">@StatusLabel(item.Status)</Badge>
                                    </div>
                                    <p class="pos-privacy__card-meta">@ManagedByLabel(item.ManagedBy)</p>
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <section class="pos-privacy__panel" aria-labelledby="privacy-actions-heading">
                    <h2 id="privacy-actions-heading" class="pos-privacy__section-title">@L["Privacy_ActionsSection"]</h2>
                    <p class="pos-privacy__section-subtitle">@L["Privacy_ActionsSubtitle"]</p>
                    <div class="pos-privacy__list" role="list">
                        @foreach (var action in _dto.BusinessActions.Where(a => !a.OwnerOnly || _isOwner))
                        {
                            <article class="pos-privacy__card" role="listitem">
                                <div class="pos-privacy__card-icon" aria-hidden="true">@IconGlyphs.Get(action.NeedsAttention ? "warning" : "check")</div>
                                <div class="pos-privacy__card-body">
                                    <div class="pos-privacy__card-top">
                                        <strong class="pos-privacy__card-name">@L[action.TitleKey]</strong>
                                        <Badge Tone="@StatusTone(action.Status)">@StatusLabel(action.Status)</Badge>
                                    </div>
                                    <p class="pos-privacy__card-meta">@L[action.DetailKey]</p>
                                    @if (action.NeedsAttention && action.Code == "SALES_DOCUMENT_EDUCATION")
                                    {
                                        <button type="button"
                                                class="pos-action-tile pos-action-tile--primary pos-privacy__action"
                                                @onclick="GoSalesDocumentEducation">
                                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("receipt")</span>
                                            <span class="pos-action-tile__label">@L["Privacy_ReviewAction"]</span>
                                        </button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <section class="pos-privacy__panel" aria-labelledby="privacy-responsibility-heading">
                    <h2 id="privacy-responsibility-heading" class="pos-privacy__section-title">@L["Privacy_ResponsibilitySection"]</h2>
                    <p class="pos-privacy__section-subtitle">@L["Privacy_ResponsibilitySubtitle"]</p>
                    <div class="pos-privacy__list" role="list">
                        @foreach (var item in _dto.Responsibilities)
                        {
                            <article class="pos-privacy__card" role="listitem">
                                <div class="pos-privacy__card-icon" aria-hidden="true">@IconGlyphs.Get("customers")</div>
                                <div class="pos-privacy__card-body">
                                    <strong class="pos-privacy__card-name">@L[item.TitleKey]</strong>
                                    <p class="pos-privacy__card-meta">@ManagedByLabel(item.ManagedBy)</p>
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <section class="pos-privacy__panel" aria-labelledby="privacy-legal-heading">
                    <h2 id="privacy-legal-heading" class="pos-privacy__section-title">@L["Privacy_LegalSection"]</h2>
                    <p class="pos-privacy__section-subtitle">@L["Privacy_LegalSubtitle"]</p>
                    <article class="pos-privacy__card pos-privacy__card--legal">
                        <div class="pos-privacy__card-icon" aria-hidden="true">@IconGlyphs.Get("info")</div>
                        <div class="pos-privacy__card-body">
                            <div class="pos-privacy__card-top">
                                <strong class="pos-privacy__card-name">@L["Privacy_LegalStatusLabel"]</strong>
                                <Badge Tone="@StatusTone(_dto.LegalVerificationStatus)">@StatusLabel(_dto.LegalVerificationStatus)</Badge>
                            </div>
                            <p class="pos-privacy__card-meta">@L[_dto.LegalVerificationMessageKey]</p>
                            <p class="pos-privacy__card-meta">
                                @L["Privacy_NpcLabel"]: @StatusLabel(_dto.NpcVerificationStatus)
                            </p>
                        </div>
                    </article>
                </section>
            }
        </Page>
    </div>
}

@code {
    private bool _ready;
    private bool _authorized;
    private bool _isOwner;
    private bool _loading;
    private bool _loadFailed;
    private string? _errorTitle;
    private string? _errorMessage;
    private OrganizationPrivacyReadinessDto? _dto;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo("/signin", replace: true);
            return;
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _isOwner = await OrganizationOwner.IsExactOrganizationOwnerAsync(
            CurrentUser.Session,
            CurrentUser.Session.OrganizationId.Value);

        _authorized = Capabilities.IsAllowed(UtangCapability.ViewOperationalSetup) || _isOwner;
        _ready = true;
        if (_authorized)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _errorTitle = null;
        _errorMessage = null;
        _dto = null;
        try
        {
            var result = await Privacy.GetAsync();
            if (!result.IsSuccess || result.Data is null)
            {
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _loadFailed = true;
                _errorTitle = L["Privacy_LoadFailed"];
                _errorMessage = described.Message;
                return;
            }

            _dto = result.Data;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoSalesDocumentEducation() => Nav.NavigateTo("/sales-document-education");

    private string StatusLabel(string status) => status switch
    {
        OrganizationPrivacyReadinessStatuses.Implemented => L["Privacy_Status_Implemented"],
        OrganizationPrivacyReadinessStatuses.ActionNeeded => L["Privacy_Status_ActionNeeded"],
        OrganizationPrivacyReadinessStatuses.ReviewRecommended => L["Privacy_Status_ReviewRecommended"],
        OrganizationPrivacyReadinessStatuses.Complete => L["Privacy_Status_Complete"],
        OrganizationPrivacyReadinessStatuses.NotVerified => L["Privacy_Status_NotVerified"],
        OrganizationPrivacyReadinessStatuses.InProgress => L["Privacy_Status_InProgress"],
        _ => status
    };

    private static BadgeTone StatusTone(string status) => status switch
    {
        OrganizationPrivacyReadinessStatuses.Implemented => BadgeTone.Success,
        OrganizationPrivacyReadinessStatuses.Complete => BadgeTone.Success,
        OrganizationPrivacyReadinessStatuses.ActionNeeded => BadgeTone.Warning,
        OrganizationPrivacyReadinessStatuses.ReviewRecommended => BadgeTone.Warning,
        OrganizationPrivacyReadinessStatuses.InProgress => BadgeTone.Info,
        _ => BadgeTone.Neutral
    };

    private string ManagedByLabel(string managedBy) =>
        string.Equals(managedBy, OrganizationPrivacyReadinessStatuses.ManagedByPlatform, StringComparison.Ordinal)
            ? L["Privacy_ManagedBy_Platform"]
            : L["Privacy_ManagedBy_Business"];
}

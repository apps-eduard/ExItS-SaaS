@page "/org/subscription"
@using ExItS.DesignSystem.Components.Internal
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IAuthenticationService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-org-subscription">
    <StoreHeaderBack Href="/org" />
    <Page>
        <header class="pos-org-subscription__header">
            <h1 class="pos-org-subscription__title">@L["Org_SubscriptionTitle"]</h1>
            <p class="pos-org-subscription__subtitle">@L["Org_SubscriptionSubtitle"]</p>
        </header>

        <div class="pos-action-grid pos-action-grid--single pos-org-subscription__actions" role="group" aria-label="@L["Org_SubscriptionTitle"]">
            <button type="button"
                    class="pos-action-tile"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Common_Retry"]</span>
            </button>
        </div>

        @if (_loading)
        {
            <Stack Align="StackAlign.Center" Gap="2">
                <Spinner />
            </Stack>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <ErrorState Title="@L["Org_ErrorTitle"]" Message="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
        }
        else
        {
            <Section Title="@L["Org_Subscription"]">
                <div class="pos-org-subscription__facts">
                    <div class="pos-org-subscription__fact">
                        <span class="pos-muted">@L["Org_Status"]</span>
                        <span class="pos-org-subscription__value">@(_subscription?.Status ?? "—")</span>
                    </div>
                    <div class="pos-org-subscription__fact">
                        <span class="pos-muted">@L["Org_Plan"]</span>
                        <span class="pos-org-subscription__value">@(_subscription?.PlanDisplayName ?? _subscription?.PlanKey ?? "—")</span>
                    </div>
                    <div class="pos-org-subscription__fact">
                        <span class="pos-muted">@L["Org_TrialEnd"]</span>
                        <span class="pos-org-subscription__value">@Format(_subscription?.TrialEndUtc)</span>
                    </div>
                    <div class="pos-org-subscription__fact">
                        <span class="pos-muted">@L["Org_PeriodEnd"]</span>
                        <span class="pos-org-subscription__value">@Format(_subscription?.CurrentPeriodEndUtc)</span>
                    </div>
                </div>
            </Section>
            <Section Title="@L["Org_Entitlement"]">
                <div class="pos-org-subscription__facts">
                    <div class="pos-org-subscription__fact">
                        <span class="pos-muted">@L["Org_Status"]</span>
                        <span class="pos-org-subscription__value">@(_entitlement?.SubscriptionStatus ?? "—")</span>
                    </div>
                    <div class="pos-org-subscription__fact">
                        <span class="pos-muted">@L["Org_SnapshotVersion"]</span>
                        <span class="pos-org-subscription__value">@(_entitlement?.SnapshotVersion.ToString() ?? "—")</span>
                    </div>
                    <div class="pos-org-subscription__fact">
                        <span class="pos-muted">@L["Org_Plan"]</span>
                        <span class="pos-org-subscription__value">@(_entitlement?.PlanCode ?? "—")</span>
                    </div>
                </div>
            </Section>
            @if (_btEntitlement is not null)
            {
                <Section Title="@L["Org_BusinessTypesLink"]">
                    <div class="pos-org-subscription__facts">
                        <div class="pos-org-subscription__fact">
                            <span class="pos-muted">@L["BusinessTypes_CapacityLabel"]</span>
                            <span class="pos-org-subscription__value">
                                @string.Format(L["BusinessTypes_Capacity"].Value, _btEntitlement.EffectiveCount, _btEntitlement.MaxActiveBusinessTypes)
                            </span>
                        </div>
                    </div>
                    <FormActions>
                        <Button Variant="ButtonVariant.Secondary" OnClick="GoBusinessTypes">@L["BusinessTypes_ManageLink"]</Button>
                    </FormActions>
                </Section>
            }
            <Alert Tone="AlertTone.Info" Message="@L["Org_WebAdminReminder"]" />
            <Alert Tone="AlertTone.Info" Message="@L["BusinessTypes_DowngradeHint"]" />
        }
    </Page>
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private PlatformSubscriptionDto? _subscription;
    private PlatformEntitlementSnapshotDto? _entitlement;
    private OrganizationBusinessTypeEntitlementDto? _btEntitlement;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (CurrentUser.Session?.OrganizationId is null)
            {
                await Auth.RestoreSessionAsync();
            }

            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null)
            {
                _error = L["Org_MissingMessage"];
                return;
            }

            var sub = await Platform.GetCurrentSubscriptionAsync(orgId.Value, PosProductCodes.PinoyBusinessPos);
            if (sub.IsSuccess)
            {
                _subscription = sub.Data;
            }

            var ent = await Platform.GetLatestEntitlementAsync(orgId.Value, PosProductCodes.PinoyBusinessPos);
            if (ent.IsSuccess)
            {
                _entitlement = ent.Data;
            }

            var bt = await Platform.GetOrganizationBusinessTypeEntitlementsAsync(
                orgId.Value,
                PosProductCodes.PinoyBusinessPos);
            if (bt.IsSuccess)
            {
                _btEntitlement = bt.Data;
            }

            if (_subscription is null && _entitlement is null)
            {
                _error = L["Org_SubscriptionLoadFailed"];
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBusinessTypes() => Nav.NavigateTo("/org/business-types");

    private static string Format(DateTimeOffset? value) =>
        value is null ? "—" : value.Value.ToLocalTime().ToString("g");
}

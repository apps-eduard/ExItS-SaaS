@page "/organization/devices"
@page "/org/devices"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Platform
@using System.Threading
@implements IDisposable
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<PosResources> L
@inject NavigationManager Nav

<div class="pos-devices">
    <StoreHeaderBack Href="/org" />
    <Page>
        <header class="pos-devices__header">
            <h1 class="pos-devices__title">@L["Device_PosDevicesTitle"]</h1>
            <p class="pos-devices__subtitle">@L["Device_PosDevicesSubtitle"]</p>
        </header>

        <div class="pos-action-grid pos-action-grid--single pos-devices__actions" role="group" aria-label="@L["Device_PosDevicesTitle"]">
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@_busy"
                    @onclick="ShowRegistrationCodeAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                <span class="pos-action-tile__label">@L["Device_ShowRegistrationCode"]</span>
            </button>
        </div>

        @if (_registrationToken is not null)
        {
            <section class="pos-devices__panel" aria-labelledby="device-registration-heading">
                <h2 id="device-registration-heading" class="pos-devices__section-title">@L["Device_RegistrationCodeTitle"]</h2>
                @if (!string.IsNullOrWhiteSpace(_registrationQrDataUrl))
                {
                    <div class="pos-qr-panel pos-my-qr__panel">
                        <img class="pos-qr-image" src="@_registrationQrDataUrl" alt="@L["Device_RegistrationCodeTitle"]" width="220" height="220" />
                        <span class="pos-muted">@L["Device_RegistrationQrHint"]</span>
                        <p class="pos-muted" role="status">@_expiryLabel</p>
                    </div>
                }
                else
                {
                    <Alert Tone="AlertTone.Warning" Message="@L["Org_BusinessQrRenderFailed"]" />
                }
            </section>
        }

        @if (_loading)
        {
            <div class="pos-devices__loading"><Spinner /><span>@L["Common_Loading"]</span></div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <Alert Tone="AlertTone.Danger" Title="@L["Device_LoadFailedTitle"]" Message="@_error" />
        }
        else
        {
            <p class="pos-devices__capacity">@L["Device_SlotsUsed", _used, _allowed]</p>

            <section class="pos-devices__panel" aria-labelledby="device-list-heading">
                <h2 id="device-list-heading" class="pos-devices__section-title">@L["Device_RegisteredSection"]</h2>
                @if (_devices.Count == 0)
                {
                    <EmptyState IconName="qr"
                                Title="@L["Device_EmptyTitle"]"
                                Message="@L["Device_EmptyMessage"]" />
                }
                else
                {
                    <div class="pos-devices__list" role="list">
                        @foreach (var device in _devices)
                        {
                            var isActive = string.Equals(device.Status, "Active", StringComparison.OrdinalIgnoreCase);
                            <article class="pos-devices__card" role="listitem">
                                <div class="pos-devices__card-icon" aria-hidden="true">@IconGlyphs.Get("settings")</div>
                                <div class="pos-devices__card-body">
                                    <div class="pos-devices__card-top">
                                        <strong class="pos-devices__card-name">@device.FriendlyName</strong>
                                        <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">@device.Status</Badge>
                                    </div>
                                    <p class="pos-devices__card-meta">
                                        @device.Platform
                                        · @device.LastSeenAtUtc.LocalDateTime.ToString("g")
                                    </p>
                                    @if (isActive)
                                    {
                                        <button type="button"
                                                class="pos-action-tile pos-devices__revoke"
                                                disabled="@_busy"
                                                @onclick="() => AskRevoke(device)">
                                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                                            <span class="pos-action-tile__label">@L["Device_Revoke"]</span>
                                        </button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }

        <ConfirmDialog Visible="@(_revokeTarget is not null)"
                       VisibleChanged="v => { if (!v) CloseRevokeDialog(); }"
                       Title="@L["Device_RevokeTitle"]"
                       Message="@L["Device_RevokeMessage", _revokeTarget?.FriendlyName ?? string.Empty]"
                       Danger="true"
                       ShowReason="true"
                       ShowPassword="true"
                       RequireReason="true"
                       RequirePassword="true"
                       Reason="@_revokeReason"
                       ReasonChanged="v => _revokeReason = v"
                       Password="@_revokePassword"
                       PasswordChanged="v => _revokePassword = v"
                       ConfirmLabel="@L["Device_Revoke"]"
                       IsLoading="@_busy"
                       OnConfirm="ConfirmRevokeAsync"
                       OnCancel="CloseRevokeDialog" />
    </Page>
</div>

@code {
    private IReadOnlyList<PosDeviceDto> _devices = [];
    private int _used;
    private int _allowed;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private PosDeviceDto? _revokeTarget;
    private string? _revokeReason;
    private string? _revokePassword;
    private PosDeviceRegistrationTokenDto? _registrationToken;
    private string? _registrationQrDataUrl;
    private string _expiryLabel = string.Empty;
    private CancellationTokenSource? _expiryCts;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            Nav.NavigateTo("/organization-select", replace: true);
            return;
        }

        var devices = await Platform.GetPosDevicesAsync(orgId);
        var capacity = await Platform.GetPosDeviceCapacityAsync(orgId);
        if (!devices.IsSuccess || devices.Data is null || !capacity.IsSuccess || capacity.Data is null)
        {
            _error = L["Device_LoadFailedMessage"];
        }
        else
        {
            _devices = devices.Data;
            _used = capacity.Data.Used;
            _allowed = capacity.Data.Allowed;
        }

        _loading = false;
    }

    private async Task ShowRegistrationCodeAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Platform.CreatePosDeviceRegistrationTokenAsync(orgId);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = result.Error?.Detail ?? L["Device_RegistrationCreateFailed"];
                return;
            }

            _registrationToken = result.Data;
            _registrationQrDataUrl = LocalQrCodeRenderer.TryToPngDataUrl(result.Data.QrPayload, out var dataUrl)
                ? dataUrl
                : null;
            StartExpiryCountdown(result.Data.ExpiresAtUtc);
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartExpiryCountdown(DateTimeOffset expiresAtUtc)
    {
        _expiryCts?.Cancel();
        _expiryCts?.Dispose();
        _expiryCts = new CancellationTokenSource();
        var token = _expiryCts.Token;
        _ = TickExpiryAsync(expiresAtUtc, token);
    }

    private async Task TickExpiryAsync(DateTimeOffset expiresAtUtc, CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                var remaining = expiresAtUtc - DateTimeOffset.UtcNow;
                if (remaining <= TimeSpan.Zero)
                {
                    _expiryLabel = L["Device_RegistrationExpired"];
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                var minutes = (int)remaining.TotalMinutes;
                var seconds = remaining.Seconds;
                _expiryLabel = string.Format(
                    L["Device_RegistrationExpiresIn"].Value,
                    minutes > 0 ? $"{minutes} min {seconds} sec" : $"{seconds} sec");
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000, ct);
            }
        }
        catch (OperationCanceledException)
        {
            // Page disposed or new token created.
        }
    }

    private void AskRevoke(PosDeviceDto device)
    {
        _revokeTarget = device;
        _revokeReason = null;
        _revokePassword = null;
    }

    private void CloseRevokeDialog()
    {
        if (_busy) return;
        _revokeTarget = null;
        _revokeReason = null;
        _revokePassword = null;
    }

    private async Task ConfirmRevokeAsync()
    {
        if (_revokeTarget is null || CurrentUser.Session?.OrganizationId is not Guid orgId
            || string.IsNullOrWhiteSpace(_revokeReason) || string.IsNullOrWhiteSpace(_revokePassword))
        {
            return;
        }

        var deviceId = _revokeTarget.Id;
        _busy = true;
        var password = _revokePassword;
        _revokePassword = null;
        try
        {
            var stepUp = await GovernanceCriticalActionFlow.IssueStepUpTokenAsync(
                Platform,
                orgId,
                PlatformGovernanceActionCodes.PosDeviceRevoke,
                PlatformGovernanceTargetTypes.PosDevice,
                deviceId,
                password);
            if (!stepUp.IsSuccess || stepUp.Data is null)
            {
                _error = L["Device_RevokeFailed"];
                return;
            }

            var result = await Platform.RevokePosDeviceAsync(
                orgId,
                deviceId,
                new GovernanceCriticalActionRequest(_revokeReason.Trim(), stepUp.Data));
            if (!result.IsSuccess)
            {
                _error = L["Device_RevokeFailed"];
                return;
            }

            _devices = _devices.Select(x => x.Id == deviceId ? x with { Status = "Revoked" } : x).ToList();
            _used = Math.Max(0, _used - 1);
            CloseRevokeDialog();
        }
        finally
        {
            _busy = false;
            _revokePassword = null;
        }
    }

    public void Dispose()
    {
        _expiryCts?.Cancel();
        _expiryCts?.Dispose();
    }
}

@page "/organization/branches/{BranchId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<PosResources> L
@inject NavigationManager Nav

<div class="pos-branches pos-branches--edit">
    <StoreHeaderBack Href="/organization/branches" />
    <Page>
        <header class="pos-branches__heading">
            <h1>@L["Branches_Edit"]</h1>
            <p class="pos-muted">@_code</p>
        </header>
        @if (!string.IsNullOrWhiteSpace(_error)) { <Alert Tone="AlertTone.Danger" Message="@_error" /> }
        @if (!string.IsNullOrWhiteSpace(_success)) { <Alert Tone="AlertTone.Success" Message="@_success" /> }

        @if (_loading)
        {
            <div class="pos-branches__loading"><Spinner /><span>@L["Common_Loading"]</span></div>
        }
        else if (_branch is not null)
        {
            <section class="pos-branches__section" aria-labelledby="branch-setup-heading">
                <h2 id="branch-setup-heading">@L["Branches_Setup"]</h2>
                <div class="pos-branches__setup-rows">
                    <div class="pos-branches__setup-row">
                        <span>@L["Branches_Details"]</span>
                        <span class="pos-branches__chip">@L["Branches_StatusReady"]</span>
                    </div>
                    <div class="pos-branches__setup-row">
                        <span>@L["Branches_Staff"]</span>
                        <span class="pos-branches__chip">@L["Branches_StaffNotAuto"]</span>
                    </div>
                    <div class="pos-branches__setup-row">
                        <span>@L["Branches_Devices"]</span>
                        <span class="pos-branches__chip">@(_deviceCount == 0 ? L["Branches_DevicesNone"] : L["Branches_DevicesCount", _deviceCount])</span>
                        <button type="button" class="pos-link pos-branches__text-action" @onclick='() => Nav.NavigateTo("/organization/devices")'>@L["Branches_Manage"]</button>
                    </div>
                    <div class="pos-branches__setup-row">
                        <span>@L["Branches_Inventory"]</span>
                        <span class="pos-branches__chip">@L["Branches_InventoryNotCopied"]</span>
                        <button type="button" class="pos-link pos-branches__text-action" @onclick="() => _showInventoryActions = !_showInventoryActions">@L["Branches_InventorySetUp"]</button>
                    </div>
                    @if (_showInventoryActions)
                    {
                        <div class="pos-branches__setup-sub">
                            <button type="button" class="pos-link" @onclick='() => Nav.NavigateTo("/inventory")'>@L["Branches_AddOpeningStock"]</button>
                            <button type="button" class="pos-link" @onclick='() => Nav.NavigateTo("/inventory/transfers/new")'>@L["Branches_TransferStock"]</button>
                        </div>
                    }
                    <div class="pos-branches__setup-row">
                        <span>@L["Branches_OrgCatalog"]</span>
                        <span class="pos-branches__chip">@L["Branches_OrgWide"]</span>
                        <button type="button" class="pos-link pos-branches__text-action" title="@L["Branches_OrgCatalogHint"]" @onclick='() => Nav.NavigateTo("/catalog")'>@L["Branches_ViewCatalog"]</button>
                    </div>
                    <div class="pos-branches__setup-row">
                        <span>@L["Branches_OrgCustomers"]</span>
                        <span class="pos-branches__chip">@L["Branches_OrgWide"]</span>
                        <button type="button" class="pos-link pos-branches__text-action" title="@L["Branches_OrgCustomersHint"]" @onclick='() => Nav.NavigateTo("/customers")'>@L["Branches_ViewCustomers"]</button>
                    </div>
                    @if (_readiness is not null)
                    {
                        <div class="pos-branches__setup-row">
                            <span>@L["Branches_OnlineOrders"]</span>
                            <span class="pos-branches__chip">@OnlineOrdersStatus()</span>
                        </div>
                        <div class="pos-branches__setup-row">
                            <span>@L["Branches_Pickup"]</span>
                            <span class="pos-branches__chip">@PickupStatus()</span>
                        </div>
                        <div class="pos-branches__setup-row">
                            <span>@L["Branches_Delivery"]</span>
                            <span class="pos-branches__chip">@DeliveryStatus()</span>
                        </div>
                    }
                </div>
            </section>

            <details class="exds-accordion pos-branches__fold" open>
                <summary class="exds-accordion__summary pos-branches__fold-summary">@L["Branches_Details"]</summary>
                <div class="exds-accordion__body pos-branches__fold-body">
                    <div class="pos-branches__grid">
                        <TextInput Label="@L["Branches_FieldName"]" @bind-Value="_name" Required />
                        <TextInput Label="@L["Branches_ContactPhone"]" @bind-Value="_contactPhone" />
                        <TextInput Label="@L["Branches_TimeZone"]" @bind-Value="_timeZoneId" Hint="@L["Branches_TimeZoneHint"]" Placeholder="@L["Branches_TimeZoneHint"]" />
                        <label class="pos-branches__field">@L["Branches_ColStatus"]
                            <select @bind="_status" disabled="@_busy">
                                <option value="Active">@L["Branches_StatusActive"]</option>
                                <option value="Inactive">@L["Branches_StatusInactive"]</option>
                            </select>
                        </label>
                    </div>
                </div>
            </details>

            <details class="exds-accordion pos-branches__fold" open="@AddressIncomplete">
                <summary class="exds-accordion__summary pos-branches__fold-summary">
                    <span>@L["Branches_AddressLocation"]</span>
                    @if (MapIncomplete) { <span class="pos-branches__chip">@L["Branches_LocationHint"]</span> }
                </summary>
                <div class="exds-accordion__body pos-branches__fold-body">
                    <div class="pos-branches__grid">
                        <TextInput Label="@L["Branches_AddressLine1"]" @bind-Value="_address1" />
                        <TextInput Label="@L["Branches_AddressLine2"]" @bind-Value="_address2" />
                    </div>
                    <div class="pos-branches__pair">
                        <TextInput Label="@L["Branches_FieldCity"]" @bind-Value="_city" />
                        <TextInput Label="@L["Branches_Region"]" @bind-Value="_region" />
                    </div>
                    <div class="pos-branches__pair">
                        <TextInput Label="@L["Branches_PostalCode"]" @bind-Value="_postalCode" />
                        <TextInput Label="@L["Branches_CountryCode"]" @bind-Value="_countryCode" />
                    </div>
                    <p class="pos-muted pos-branches__hint">@L["Branches_MapLocation"] · @L["Branches_LocationHint"]</p>
                    <div class="pos-branches__pair">
                        <TextInput Label="@L["Branches_Latitude"]" @bind-Value="_latitude" Type="number" />
                        <TextInput Label="@L["Branches_Longitude"]" @bind-Value="_longitude" Type="number" />
                    </div>
                </div>
            </details>

            <details class="exds-accordion pos-branches__fold" open>
                <summary class="exds-accordion__summary pos-branches__fold-summary">@L["Branches_OperatingHours"]</summary>
                <div class="exds-accordion__body pos-branches__fold-body">
                    <div class="pos-branches__hours" role="list">
                        @foreach (var day in _hours)
                        {
                            <button type="button"
                                    class="pos-branches__hours-row"
                                    role="listitem"
                                    disabled="@_busy"
                                    aria-label="@($"{DayFullLabel(day.DayOfWeek)}, {DaySummary(day)}")"
                                    @onclick="() => OpenDayEditor(day)">
                                <span class="pos-branches__hours-day">@DayLabel(day.DayOfWeek)</span>
                                <span class="pos-branches__hours-summary">@DaySummary(day)</span>
                                <span class="pos-branches__hours-chevron" aria-hidden="true">@IconGlyphs.Get("back")</span>
                            </button>
                        }
                    </div>
                    @if (_showCopyPanel)
                    {
                        <div class="pos-branches__copy">
                            <p class="pos-branches__copy-title">@L["Branches_CopyHoursTo"]</p>
                            <div class="pos-branches__copy-days">
                                @foreach (var day in _hours.Where(d => !string.Equals(d.DayOfWeek, nameof(DayOfWeek.Monday), StringComparison.OrdinalIgnoreCase)))
                                {
                                    var selected = _copyTargets.Contains(day.DayOfWeek);
                                    <Checkbox Value="selected"
                                              ValueChanged="value => ToggleCopyTarget(day.DayOfWeek, value)">
                                        @DayLabel(day.DayOfWeek)
                                    </Checkbox>
                                }
                            </div>
                            <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="ApplyCopyHours">
                                @L["Branches_ApplyCopy"]
                            </Button>
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="pos-link pos-branches__hours-copy"
                                disabled="@_busy"
                                @onclick="OpenCopyPanel">@L["Branches_CopyHours"]</button>
                    }
                </div>
            </details>

            @if (_readiness is not null)
            {
                <details class="exds-accordion pos-branches__fold" open>
                    <summary class="exds-accordion__summary pos-branches__fold-summary">@L["Branches_Fulfillment"]</summary>
                    <div class="exds-accordion__body pos-branches__fold-body">
                        @if (!string.IsNullOrWhiteSpace(_readiness.StoreStatusMessage))
                        {
                            <p class="pos-muted pos-branches__hint">@_readiness.StoreStatusMessage</p>
                        }
                        <div class="pos-branches__kv-list">
                            <div class="pos-branches__kv">
                                <span class="pos-branches__kv-label">@L["Branches_OnlineOrders"]</span>
                                <span class="pos-branches__chip">@OnlineOrdersStatus()</span>
                                @if (_readiness.CanUseCustomerOrdering && !_readiness.CustomerOrderingEnabled && _readiness.CustomerOrderingReady)
                                {
                                    <button type="button" class="pos-link pos-branches__text-action" disabled="@_busy" @onclick="() => ToggleFulfillmentAsync(ordering: true)">@L["Branches_Enable"]</button>
                                }
                            </div>
                            <div class="pos-branches__kv">
                                <span class="pos-branches__kv-label">@L["Branches_Pickup"]</span>
                                <span class="pos-branches__chip">@PickupStatus()</span>
                                @if (_readiness.CanUseCustomerOrdering && _readiness.CustomerOrderingEnabled && _readiness.PickupReady && !_readiness.PickupEnabled)
                                {
                                    <button type="button" class="pos-link pos-branches__text-action" disabled="@_busy" @onclick="() => ToggleFulfillmentAsync(pickup: true)">@L["Branches_Enable"]</button>
                                }
                            </div>
                            <div class="pos-branches__kv">
                                <span class="pos-branches__kv-label">@L["Branches_Delivery"]</span>
                                <span class="pos-branches__chip">@DeliveryStatus()</span>
                                @if (DeliveryMissingCount > 0 && _readiness.CanUseDelivery)
                                {
                                    <span class="pos-muted">@L["Branches_MissingCount", DeliveryMissingCount]</span>
                                }
                                @if (_readiness.CanUseDelivery && !_readiness.DeliveryEnabled && _readiness.DeliveryReady)
                                {
                                    <button type="button" class="pos-link pos-branches__text-action" disabled="@_busy" @onclick="() => ToggleFulfillmentAsync(delivery: true)">@L["Branches_EnableDelivery"]</button>
                                }
                                else if (_readiness.DeliveryEnabled)
                                {
                                    <button type="button" class="pos-link pos-branches__text-action" disabled="@_busy" @onclick="() => ToggleFulfillmentAsync(delivery: false)">@L["Branches_DisableDelivery"]</button>
                                }
                                else if (_readiness.CanUseDelivery && !_readiness.DeliveryReady)
                                {
                                    <button type="button" class="pos-link pos-branches__text-action" @onclick="() => _showDeliverySettings = true">@L["Branches_Configure"]</button>
                                }
                            </div>
                        </div>
                        @if (_readiness.CanUseDelivery && !_readiness.DeliveryReady)
                        {
                            <ul class="pos-branches__checklist">
                                @foreach (var item in DeliveryChecks())
                                {
                                    <li class="pos-branches__check">
                                        <span class="pos-branches__check-icon @(item.Missing ? "pos-branches__check-icon--missing" : "pos-branches__check-icon--ok")" aria-hidden="true">
                                            @IconGlyphs.Get(item.Missing ? "close" : "check")
                                        </span>
                                        <span>@item.Label</span>
                                        <span class="exds-sr-only">@(item.Missing ? L["Branches_CheckMissing"] : L["Branches_CheckOk"])</span>
                                    </li>
                                }
                            </ul>
                        }
                        @if (_readiness.OnlineOrdersPaused)
                        {
                            <button type="button" class="pos-link pos-branches__text-action" disabled="@_busy" @onclick="() => PauseOrdersAsync(false)">@L["Branches_ResumeOrders"]</button>
                        }
                        else if (_readiness.CustomerOrderingEnabled)
                        {
                            <button type="button" class="pos-link pos-branches__text-action" disabled="@_busy" @onclick="() => PauseOrdersAsync(true)">@L["Branches_PauseOrders"]</button>
                        }

                        @if (_showDeliverySettings || DeliveryPricingIncomplete)
                        {
                            <h3 class="pos-branches__subhead">@L["Branches_DeliverySettings"]</h3>
                            <div class="pos-branches__pair">
                                <TextInput Label="@L["Branches_MinimumOrder"]" @bind-Value="_minimumOrder" Type="number" />
                                <TextInput Label="@L["Branches_BaseFee"]" @bind-Value="_baseFee" Type="number" />
                            </div>
                            <div class="pos-branches__pair">
                                <TextInput Label="@L["Branches_IncludedKm"]" @bind-Value="_includedKm" Type="number" />
                                <TextInput Label="@L["Branches_AdditionalPerKm"]" @bind-Value="_additionalPerKm" Type="number" />
                            </div>
                            <div class="pos-branches__pair">
                                <TextInput Label="@L["Branches_MaximumKm"]" @bind-Value="_maximumKm" Type="number" />
                                <TextInput Label="@L["Branches_FreeThreshold"]" @bind-Value="_freeThreshold" Type="number" Placeholder="@L["Branches_None"]" Hint="@L["Branches_None"]" />
                            </div>
                        }
                    </div>
                </details>
            }

            <div class="pos-branches__sticky-actions" role="region" aria-label="@L["Branches_SaveActions"]">
                <Button Variant="ButtonVariant.Ghost" Disabled="_busy" OnClick="Cancel">@L["Common_Cancel"]</Button>
                <Button Variant="ButtonVariant.Primary" Disabled="_busy" IsLoading="_busy" OnClick="SaveAsync">@L["Common_Save"]</Button>
            </div>
        }
    </Page>

    @if (_dayDraft is not null)
    {
        <div class="pos-hours-sheet" role="dialog" aria-modal="true" aria-labelledby="pos-hours-sheet-title" @onclick="CloseDayEditor">
            <div class="pos-hours-sheet__panel" @onclick:stopPropagation="true">
                <header class="pos-hours-sheet__header">
                    <h2 id="pos-hours-sheet-title" class="pos-hours-sheet__title">@DayFullLabel(_dayDraft.DayOfWeek)</h2>
                    <IconButton AriaLabel="@L["Common_Close"]" IconName="close" OnClick="CloseDayEditor" />
                </header>
                <div class="pos-hours-sheet__modes" role="radiogroup" aria-label="@L["Branches_OperatingHours"]">
                    <button type="button"
                            class="pos-hours-sheet__mode @(_dayDraft.Mode == BranchHoursScheduleUi.ModeOpen ? "pos-hours-sheet__mode--on" : null)"
                            role="radio"
                            aria-checked="@(_dayDraft.Mode == BranchHoursScheduleUi.ModeOpen)"
                            @onclick='() => _dayDraft.Mode = BranchHoursScheduleUi.ModeOpen'>@L["Branches_HoursOpen"]</button>
                    <button type="button"
                            class="pos-hours-sheet__mode @(_dayDraft.Mode == BranchHoursScheduleUi.ModeOpen24 ? "pos-hours-sheet__mode--on" : null)"
                            role="radio"
                            aria-checked="@(_dayDraft.Mode == BranchHoursScheduleUi.ModeOpen24)"
                            @onclick='() => _dayDraft.Mode = BranchHoursScheduleUi.ModeOpen24'>@L["Branches_Open24h"]</button>
                    <button type="button"
                            class="pos-hours-sheet__mode @(_dayDraft.Mode == BranchHoursScheduleUi.ModeClosed ? "pos-hours-sheet__mode--on" : null)"
                            role="radio"
                            aria-checked="@(_dayDraft.Mode == BranchHoursScheduleUi.ModeClosed)"
                            @onclick='() => _dayDraft.Mode = BranchHoursScheduleUi.ModeClosed'>@L["Branches_Closed"]</button>
                </div>
                @if (BranchHoursScheduleUi.ShowsTimes(_dayDraft.IsClosed, _dayDraft.IsOpen24Hours))
                {
                    <label class="pos-hours-sheet__field">@L["Branches_HoursStart"]
                        <input type="time"
                               class="pos-branches__time"
                               aria-label="@L["Branches_HoursStart"]"
                               value="@BranchHoursScheduleUi.FormatStoredTime(_dayDraft.OpenTime)"
                               @onchange="e => _dayDraft.OpenTime = ParseChangedTime(e.Value, _dayDraft.OpenTime)" />
                    </label>
                    <label class="pos-hours-sheet__field">@L["Branches_HoursEnd"]
                        <input type="time"
                               class="pos-branches__time"
                               aria-label="@L["Branches_HoursEnd"]"
                               value="@BranchHoursScheduleUi.FormatStoredTime(_dayDraft.CloseTime)"
                               @onchange="e => _dayDraft.CloseTime = ParseChangedTime(e.Value, _dayDraft.CloseTime)" />
                    </label>
                }
                @if (_showApplyToOtherDays)
                {
                    <div class="pos-branches__copy">
                        <p class="pos-branches__copy-title">@L["Branches_ApplyToOtherDays"]</p>
                        <div class="pos-branches__copy-days">
                            @foreach (var day in _hours.Where(d => !string.Equals(d.DayOfWeek, _dayDraft.DayOfWeek, StringComparison.OrdinalIgnoreCase)))
                            {
                                var selected = _applyTargets.Contains(day.DayOfWeek);
                                <Checkbox Value="selected"
                                          ValueChanged="value => ToggleApplyTarget(day.DayOfWeek, value)">
                                    @DayLabel(day.DayOfWeek)
                                </Checkbox>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" class="pos-link pos-branches__hours-copy" @onclick="OpenApplyToOtherDays">
                        @L["Branches_ApplyToOtherDays"]
                    </button>
                }
                <Button Variant="ButtonVariant.Primary" OnClick="DoneDayEditor">@L["Branches_HoursDone"]</Button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid BranchId { get; set; }
    private OrganizationBranchDto? _branch;
    private BranchFulfillmentReadinessDto? _readiness;
    private readonly List<BranchHoursDayDraft> _hours = [];
    private BranchHoursDayDraft? _editingDay;
    private BranchHoursDayDraft? _dayDraft;
    private bool _showCopyPanel;
    private bool _showApplyToOtherDays;
    private HashSet<string> _copyTargets = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _applyTargets = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading = true;
    private bool _busy;
    private bool _showInventoryActions;
    private bool _showDeliverySettings;
    private string? _error;
    private string? _success;
    private string? _code;
    private string? _name;
    private string? _contactPhone;
    private string? _timeZoneId;
    private string? _status;
    private string? _address1;
    private string? _address2;
    private string? _city;
    private string? _region;
    private string? _postalCode;
    private string? _countryCode;
    private string? _latitude;
    private string? _longitude;
    private string _minimumOrder = "0";
    private string _baseFee = "0";
    private string _includedKm = "0";
    private string _additionalPerKm = "0";
    private string _maximumKm = "0";
    private string? _freeThreshold;
    private int _deviceCount;

    private bool AddressIncomplete =>
        string.IsNullOrWhiteSpace(_address1) || string.IsNullOrWhiteSpace(_city);
    private bool MapIncomplete =>
        string.IsNullOrWhiteSpace(_latitude) || string.IsNullOrWhiteSpace(_longitude);
    private bool DeliveryPricingIncomplete =>
        _readiness is { CanUseDelivery: true, DeliveryReady: false } &&
        _readiness.ReasonCodes.Any(c => c is "delivery_policy_missing" or "delivery_policy_incomplete");
    private int DeliveryMissingCount => DeliveryChecks().Count(c => c.Missing);

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId) { Nav.NavigateTo("/organization-select", true); return; }
        var result = await Platform.GetBranchesAsync(orgId);
        _branch = result.Data?.FirstOrDefault(x => x.Id == BranchId);
        if (_branch is null) { _error = result.Error?.Detail ?? L["Branches_NotFound"]; _loading = false; return; }
        Map(_branch);
        await LoadFulfillmentAsync(orgId);
        var devices = await Platform.GetPosDevicesAsync(orgId);
        _deviceCount = devices.Data?.Count(d => d.BranchId == BranchId) ?? 0;
        _showDeliverySettings = DeliveryPricingIncomplete;
        _loading = false;
    }

    private async Task LoadFulfillmentAsync(Guid orgId)
    {
        var readiness = await Platform.GetBranchFulfillmentReadinessAsync(orgId, BranchId);
        if (readiness.IsSuccess) _readiness = readiness.Data;

        var hours = await Platform.GetBranchOperatingHoursAsync(orgId, BranchId);
        if (hours.IsSuccess && hours.Data is not null)
        {
            _hours.Clear();
            foreach (var day in hours.Data.OrderBy(d => DayOrder(d.DayOfWeek)))
            {
                _hours.Add(new BranchHoursDayDraft
                {
                    DayOfWeek = day.DayOfWeek,
                    IsClosed = day.IsClosed,
                    IsOpen24Hours = day.IsOpen24Hours,
                    OpenTime = BranchHoursScheduleUi.ParseTime(day.OpenTime, new TimeOnly(8, 0)),
                    CloseTime = BranchHoursScheduleUi.ParseTime(day.CloseTime, new TimeOnly(21, 0))
                });
            }
        }
        else if (_hours.Count == 0)
        {
            foreach (var day in BranchHoursScheduleUi.OrderedDays)
            {
                _hours.Add(new BranchHoursDayDraft { DayOfWeek = day, IsClosed = true });
            }
        }
    }

    private void Map(OrganizationBranchDto b)
    {
        _code = b.Code; _name = b.Name; _status = b.Status;
        _contactPhone = b.ContactPhone; _timeZoneId = b.TimeZoneId;
        _address1 = b.AddressLine1; _address2 = b.AddressLine2;
        _city = b.City; _region = b.Region; _postalCode = b.PostalCode; _countryCode = b.CountryCode;
        _latitude = b.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _longitude = b.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (b.DeliveryPolicy is { } p)
        {
            _minimumOrder = F(p.MinimumOrderAmount); _baseFee = F(p.BaseDeliveryFee); _includedKm = F(p.IncludedDistanceKm);
            _additionalPerKm = F(p.AdditionalFeePerKm); _maximumKm = F(p.MaximumDeliveryDistanceKm);
            _freeThreshold = p.FreeDeliveryThreshold is null ? null : F(p.FreeDeliveryThreshold.Value);
        }
    }

    private static string F(decimal value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static decimal D(string? value) => decimal.TryParse(value, System.Globalization.NumberStyles.Number,
        System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0m;

    private void Cancel() => Nav.NavigateTo("/organization/branches");

    private async Task SaveAsync()
    {
        if (_branch is null || CurrentUser.Session?.OrganizationId is not Guid orgId || string.IsNullOrWhiteSpace(_name)) return;
        _busy = true; _error = _success = null;
        decimal? latitude = string.IsNullOrWhiteSpace(_latitude) ? null : D(_latitude);
        decimal? longitude = string.IsNullOrWhiteSpace(_longitude) ? null : D(_longitude);
        var updated = await Platform.UpdateBranchAsync(orgId, BranchId, new UpdateBranchRequest(
            _name.Trim(), _address1?.Trim(), _address2?.Trim(), _city?.Trim(), _region?.Trim(), _postalCode?.Trim(),
            _countryCode?.Trim(), _status, latitude, longitude, latitude is null && longitude is null,
            _contactPhone?.Trim(), _timeZoneId?.Trim()));
        if (!updated.IsSuccess) { _error = updated.Error?.Detail ?? L["Branches_SaveFailed"]; _busy = false; return; }

        if (!await SaveHoursCoreAsync(orgId)) { _busy = false; return; }

        var policy = await Platform.UpsertBranchDeliveryPolicyAsync(orgId, BranchId, new UpsertBranchDeliveryPolicyRequest(
            D(_minimumOrder), D(_baseFee), D(_includedKm), D(_additionalPerKm), D(_maximumKm),
            string.IsNullOrWhiteSpace(_freeThreshold) ? null : D(_freeThreshold)));
        if (!policy.IsSuccess) { _error = policy.Error?.Detail ?? L["Branches_PolicySaveFailed"]; _busy = false; return; }

        await LoadFulfillmentAsync(orgId);
        _success = L["Branches_Saved"]; _busy = false;
    }

    private async Task<bool> SaveHoursCoreAsync(Guid orgId)
    {
        var days = _hours.Select(BranchHoursScheduleUi.ToDto).ToList();
        var result = await Platform.UpsertBranchOperatingHoursAsync(orgId, BranchId, new UpsertBranchOperatingHoursRequest(days));
        if (!result.IsSuccess) { _error = result.Error?.Detail ?? L["Branches_SaveFailed"]; return false; }
        _readiness = result.Data;
        return true;
    }

    private void OpenDayEditor(BranchHoursDayDraft day)
    {
        if (_busy)
        {
            return;
        }

        _editingDay = day;
        _dayDraft = day.Clone();
        _showApplyToOtherDays = false;
        _applyTargets = BranchHoursScheduleUi.DefaultCopyTargets(day.DayOfWeek);
    }

    private void CloseDayEditor()
    {
        _editingDay = null;
        _dayDraft = null;
        _showApplyToOtherDays = false;
    }

    private void DoneDayEditor()
    {
        if (_editingDay is null || _dayDraft is null)
        {
            return;
        }

        _editingDay.ApplyFrom(_dayDraft);
        if (_showApplyToOtherDays && _applyTargets.Count > 0)
        {
            BranchHoursScheduleUi.CopyToSelected(_hours, _dayDraft.DayOfWeek, _applyTargets);
        }

        CloseDayEditor();
    }

    private void OpenCopyPanel()
    {
        _copyTargets = BranchHoursScheduleUi.DefaultCopyTargets(nameof(DayOfWeek.Monday));
        _showCopyPanel = true;
    }

    private void ToggleCopyTarget(string day, bool selected)
    {
        if (selected) _copyTargets.Add(day);
        else _copyTargets.Remove(day);
    }

    private void ToggleApplyTarget(string day, bool selected)
    {
        if (selected) _applyTargets.Add(day);
        else _applyTargets.Remove(day);
    }

    private void ApplyCopyHours()
    {
        BranchHoursScheduleUi.CopyToSelected(_hours, nameof(DayOfWeek.Monday), _copyTargets);
        _showCopyPanel = false;
    }

    private void OpenApplyToOtherDays() => _showApplyToOtherDays = true;

    private void CopyMondayToWeekdays()
    {
        BranchHoursScheduleUi.CopyToSelected(
            _hours,
            nameof(DayOfWeek.Monday),
            BranchHoursScheduleUi.DefaultCopyTargets(nameof(DayOfWeek.Monday)));
    }

    private async Task ToggleFulfillmentAsync(bool? ordering = null, bool? pickup = null, bool? delivery = null)
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId) return;
        _busy = true; _error = null;
        var result = await Platform.UpdateBranchFulfillmentSettingsAsync(
            orgId, BranchId, new UpdateBranchFulfillmentSettingsRequest(ordering, pickup, delivery));
        if (!result.IsSuccess) _error = result.Error?.Detail ?? L["Branches_FulfillmentFailed"];
        else { _readiness = result.Data; _success = L["Branches_Saved"]; }
        _busy = false;
    }

    private async Task PauseOrdersAsync(bool paused)
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId) return;
        _busy = true; _error = null;
        var result = await Platform.SetBranchOnlineOrdersPausedAsync(
            orgId, BranchId, new SetBranchOnlineOrdersPausedRequest(paused, paused ? "TooBusy" : null));
        if (!result.IsSuccess) _error = result.Error?.Detail ?? L["Branches_FulfillmentFailed"];
        else { _readiness = result.Data; _success = L["Branches_Saved"]; }
        _busy = false;
    }

    private string OnlineOrdersStatus() => _readiness switch
    {
        { OnlineOrdersPaused: true } => L["Branches_StatusPaused"],
        { CustomerOrderingEnabled: true, CustomerOrderingOperational: true } => L["Branches_StatusReady"],
        { CustomerOrderingEnabled: true } => L["Branches_StatusOffHours"],
        { CustomerOrderingReady: true } => L["Branches_StatusSetupReady"],
        _ => L["Branches_StatusSetupRequired"]
    };

    private string PickupStatus() => _readiness switch
    {
        { PickupEnabled: true, PickupOperational: true } => L["Branches_StatusEnabled"],
        { PickupEnabled: true } => L["Branches_StatusOffHours"],
        { PickupReady: true } => L["Branches_StatusOff"],
        _ => L["Branches_StatusDisabled"]
    };

    private string DeliveryStatus() => _readiness switch
    {
        { CanUseDelivery: false } => L["Branches_StatusNotInPlan"],
        { DeliveryEnabled: true, DeliveryOperational: true } => L["Branches_StatusEnabled"],
        { DeliveryEnabled: true } => L["Branches_StatusOffHours"],
        { DeliveryReady: true } => L["Branches_StatusSetupReady"],
        _ => L["Branches_StatusSetupRequired"]
    };

    private IEnumerable<CheckItem> DeliveryChecks()
    {
        if (_readiness is null) yield break;
        var codes = _readiness.ReasonCodes.ToHashSet(StringComparer.Ordinal);
        yield return new CheckItem(codes.Contains("delivery_policy_incomplete"), L["Branches_CheckDistance"]);
        yield return new CheckItem(codes.Contains("branch_address_incomplete"), L["Branches_CheckAddress"]);
        yield return new CheckItem(codes.Contains("map_location_missing"), L["Branches_CheckLocation"]);
        yield return new CheckItem(codes.Contains("store_hours_missing"), L["Branches_CheckHours"]);
        yield return new CheckItem(codes.Contains("store_contact_missing"), L["Branches_CheckPhone"]);
        yield return new CheckItem(codes.Contains("delivery_policy_missing"), L["Branches_CheckPricing"]);
    }

    private static int DayOrder(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => 0,
        DayOfWeek.Tuesday => 1,
        DayOfWeek.Wednesday => 2,
        DayOfWeek.Thursday => 3,
        DayOfWeek.Friday => 4,
        DayOfWeek.Saturday => 5,
        _ => 6
    };

    private static int DayOrder(string day) =>
        Enum.TryParse<DayOfWeek>(day, true, out var parsed) ? DayOrder(parsed) : 99;

    private string DayLabel(string day) =>
        Enum.TryParse<DayOfWeek>(day, true, out var parsed) ? L[$"Branches_Day_{parsed}"] : day;

    private string DayFullLabel(string day) =>
        Enum.TryParse<DayOfWeek>(day, true, out var parsed) ? L[$"Branches_DayFull_{parsed}"] : day;

    private string DaySummary(BranchHoursDayDraft day) =>
        BranchHoursScheduleUi.FormatSummary(
            day.IsClosed,
            day.IsOpen24Hours,
            day.OpenTime,
            day.CloseTime,
            L["Branches_Closed"],
            L["Branches_Open24h"]);

    private static TimeOnly ParseChangedTime(object? value, TimeOnly fallback) =>
        value switch
        {
            TimeOnly time => time,
            DateTime dateTime => TimeOnly.FromDateTime(dateTime),
            string text => BranchHoursScheduleUi.ParseTime(text, fallback),
            _ => fallback
        };

    private readonly record struct CheckItem(bool Missing, string Label);
}

@page "/org"
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationGate Gate
@inject RoleHomeResolver RoleHome
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (CurrentUser.Session?.OrganizationId is null)
{
    <Page>
        <ErrorState Title="@L["Org_MissingTitle"]" Message="@L["Org_MissingMessage"]" RetryLabel="@L["OrgSelect_Title"]" OnRetry="GoSelect" />
    </Page>
}
else
{
    <Page>
        <PageHeader Title="@L["Org_SummaryTitle"]" Subtitle="@(_org?.DisplayName ?? CurrentUser.Session.OrganizationDisplayName)">
            <Actions>
                <Button Variant="ButtonVariant.Ghost" OnClick="GoPersonal">@L["Personal_BackHome"]</Button>
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrEmpty(_error))
        {
            <Alert Tone="AlertTone.Danger" Title="@L["Org_ErrorTitle"]" Message="@_error" />
        }

        <Section Title="@L["Org_StatusSection"]">
            <Stack Gap="2">
                <div><span class="pos-muted">@L["Org_Status"]</span><div class="pos-value-md">@(_org?.Status ?? "—")</div></div>
                <div><span class="pos-muted">@L["Org_Subscription"]</span><div class="pos-value-md">@(_subscription?.Status ?? L["Org_SubscriptionUnknown"])</div></div>
                <div><span class="pos-muted">@L["Org_Entitlement"]</span><div class="pos-value-md">@(_entitlement?.SubscriptionStatus ?? L["Org_EntitlementUnknown"])</div></div>
                <div><span class="pos-muted">@L["Org_PosAccess"]</span><div class="pos-value-md">@(CurrentUser.HasPosAccess ? L["Org_PosAccessYes"] : L["Org_PosAccessNo"])</div></div>
            </Stack>
        </Section>

        <Section Title="@L["Org_EssentialsSection"]">
            <Stack Gap="2">
                @if (_isOrganizationOwner)
                {
                    <Button Variant="ButtonVariant.Secondary" OnClick="GoProfile">@L["Org_ProfileLink"]</Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="GoStaff">@L["Org_StaffLink"]</Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="GoSubscription">@L["Org_SubscriptionLink"]</Button>
                }
                else
                {
                    <InlineMessage Tone="InlineMessageTone.Info">@L["Org_EssentialsOwnerOnly"]</InlineMessage>
                }
                @if (CurrentUser.HasPosAccess)
                {
                    <Button Variant="ButtonVariant.Primary" OnClick="EnterPosAsync">@L["Org_EnterPos"]</Button>
                }
            </Stack>
        </Section>

        <AccountContextSwitcher />

        <InlineMessage Tone="InlineMessageTone.Info">@L["Org_WebAdminReminder"]</InlineMessage>
    </Page>
}

@code {
    private bool _ready;
    private string? _error;
    private PlatformOrganizationDto? _org;
    private PlatformSubscriptionDto? _subscription;
    private PlatformEntitlementSnapshotDto? _entitlement;
    private bool _isOrganizationOwner;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            if (!restore.Succeeded)
            {
                Nav.NavigateTo("/signin", replace: true);
                return;
            }
        }

        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            _ready = true;
            return;
        }

        var orgResult = await Platform.GetOrganizationAsync(orgId.Value);
        if (orgResult.IsSuccess)
        {
            _org = orgResult.Data;
        }
        else
        {
            _error = L["Org_LoadFailed"];
        }

        var sub = await Platform.GetCurrentSubscriptionAsync(orgId.Value, PosProductCodes.PinoyBusinessPos);
        if (sub.IsSuccess)
        {
            _subscription = sub.Data;
        }

        var ent = await Platform.GetLatestEntitlementAsync(orgId.Value, PosProductCodes.PinoyBusinessPos);
        if (ent.IsSuccess)
        {
            _entitlement = ent.Data;
        }

        _isOrganizationOwner = await ResolveIsOrganizationOwnerAsync(orgId.Value);

        _ready = true;
    }

    private async Task<bool> ResolveIsOrganizationOwnerAsync(Guid organizationId)
    {
        var userId = CurrentUser.Session?.UserId;
        if (userId is null)
        {
            return false;
        }

        var memberships = await Platform.GetUserMembershipsAsync(userId.Value);
        if (!memberships.IsSuccess || memberships.Data is null)
        {
            return false;
        }

        return memberships.Data.Items.Any(m =>
            m.OrganizationId == organizationId
            && string.Equals(m.Status, "Active", StringComparison.OrdinalIgnoreCase)
            && string.Equals(m.Role, "OrganizationOwner", StringComparison.OrdinalIgnoreCase));
    }

    private async Task EnterPosAsync()
    {
        if (CurrentUser.Session?.OrganizationId is Guid oid && !CurrentUser.HasPosAccess)
        {
            var selected = await Auth.SelectOrganizationAsync(oid);
            if (!selected.Succeeded)
            {
                _error = L[selected.SafeMessageKey ?? "Access_Denied"];
                return;
            }
        }

        Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
    }

    private void GoProfile() => Nav.NavigateTo("/org/profile");
    private void GoStaff() => Nav.NavigateTo("/org/staff");
    private void GoSubscription() => Nav.NavigateTo("/org/subscription");
    private void GoSelect() => Nav.NavigateTo("/organization-select");

    private async Task GoPersonal()
    {
        var result = await Auth.SwitchToPersonalAsync();
        if (result.Succeeded)
        {
            Nav.NavigateTo("/personal", replace: true);
        }
    }
}

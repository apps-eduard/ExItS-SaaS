@page "/org"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Common
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IProductAccessResolver Access
@inject IPosPermissionClient Permissions
@inject IConnectivityService Connectivity
@inject NavigationGate Gate
@inject NavigationManager Nav
@inject PostSignInReturnRoute ReturnRoute
@inject ApiStatusLocalizer StatusLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_sessionExpired)
{
    <Page>
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]"
                    Message="@L["Auth_SessionExpired"]"
                    RetryLabel="@L["Auth_SignInAgain"]"
                    OnRetry="GoSignIn" />
    </Page>
}
else if (CurrentUser.Session?.OrganizationId is null)
{
    <Page>
        <ErrorState Title="@L["Org_MissingTitle"]"
                    Message="@L["Org_MissingMessage"]"
                    RetryLabel="@L["OrgSelect_Title"]"
                    OnRetry="GoSelect" />
    </Page>
}
else
{
    <div class="pos-org">
        <Page>
            <header class="pos-org__header">
                <h1 class="pos-org__title">@L["Org_SummaryTitle"]</h1>
            </header>

            @if (_isOffline)
            {
                <Alert Tone="AlertTone.Info" Title="@L["Platform_OfflineTitle"]" Message="@L["Org_OfflinePlatformHint"]" />
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <Alert Tone="AlertTone.Danger" Title="@L["Org_ErrorTitle"]" Message="@_error" />
            }

            @if (!CurrentUser.HasPosAccess && !_isOrganizationOwner)
            {
                <div class="pos-org__awaiting" role="status">
                    <Alert Tone="AlertTone.Warning"
                           Title="@L["Org_MemberAwaitingRoleTitle"]"
                           Message="@L["Org_MemberAwaitingRoleMessage"]" />
                </div>
            }

            <section class="pos-org__summary" aria-labelledby="org-access-heading">
                <h2 id="org-access-heading" class="pos-org__section-title">@L["Org_AccessSection"]</h2>
                <dl class="pos-org__status-list">
                    <div class="pos-org__status-row">
                        <dt>@L["Org_OrganizationLabel"]</dt>
                        <dd>
                            <span class="pos-org__chip pos-org__chip--@StatusTone(_org?.Status)"
                                  aria-label="@($"{L["Org_OrganizationLabel"]}: {OrganizationStatusText}")">
                                @OrganizationStatusText
                            </span>
                        </dd>
                    </div>
                    <div class="pos-org__status-row">
                        <dt>@L["Org_Subscription"]</dt>
                        <dd>
                            <span class="pos-org__chip pos-org__chip--@StatusTone(_subscription?.Status)"
                                  aria-label="@($"{L["Org_Subscription"]}: {SubscriptionStatusText}")">
                                @SubscriptionStatusText
                            </span>
                        </dd>
                    </div>
                    <div class="pos-org__status-row">
                        <dt>@L["Org_Entitlement"]</dt>
                        <dd>
                            <span class="pos-org__chip pos-org__chip--@StatusTone(_entitlement?.SubscriptionStatus)"
                                  aria-label="@($"{L["Org_Entitlement"]}: {EntitlementStatusText}")">
                                @EntitlementStatusText
                            </span>
                        </dd>
                    </div>
                    <div class="pos-org__status-row">
                        <dt>@L["Org_PosAccess"]</dt>
                        <dd>
                            <span class="pos-org__chip pos-org__chip--@(CurrentUser.HasPosAccess ? "ok" : "warn")"
                                  aria-label="@($"{L["Org_PosAccess"]}: {PosAccessStatusText}")">
                                @PosAccessStatusText
                            </span>
                        </dd>
                    </div>
                </dl>

                @if (!CurrentUser.HasPosAccess && !string.IsNullOrWhiteSpace(_posAccessHint))
                {
                    <p class="pos-org__hint pos-muted" role="status">@_posAccessHint</p>
                }
            </section>

            <div class="pos-org__primary">
                @if (CurrentUser.HasPosAccess && _posRoleMissing)
                {
                    <p class="pos-org__pos-blocked pos-muted" role="status">@L["Org_PosRoleRequired"]</p>
                }
                else if (CurrentUser.HasPosAccess)
                {
                    <Button Variant="ButtonVariant.Primary"
                            IsLoading="_enteringPos"
                            Disabled="_enteringPos || _enablingPos"
                            OnClick="EnterPosAsync">
                        @L["Org_EnterPos"]
                    </Button>
                }
                else if (_isOrganizationOwner)
                {
                    <Button Variant="ButtonVariant.Primary"
                            IsLoading="_enablingPos"
                            Disabled="_enablingPos || _enteringPos"
                            OnClick="EnablePosAsync">
                        @L["Org_EnablePos"]
                    </Button>
                }
                else if (!string.IsNullOrWhiteSpace(_posAccessHint))
                {
                    <p class="pos-org__pos-blocked pos-muted" role="status">@_posAccessHint</p>
                }
            </div>

            <section class="pos-org__essentials" aria-labelledby="org-essentials-heading">
                <h2 id="org-essentials-heading" class="pos-org__section-title">@L["Org_EssentialsSection"]</h2>

                @if (_isOrganizationOwner)
                {
                    <div class="pos-org__nav" role="list">
                        <button type="button" class="pos-org__nav-row" role="listitem" @onclick="GoProfile">
                            <span class="pos-org__nav-icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                            <span class="pos-org__nav-label">@L["Org_ProfileLink"]</span>
                            <span class="pos-org__nav-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="pos-org__nav-row" role="listitem" @onclick="GoStaff">
                            <span class="pos-org__nav-icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                            <span class="pos-org__nav-label">@L["Org_StaffLink"]</span>
                            <span class="pos-org__nav-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="pos-org__nav-row" role="listitem" @onclick="GoBusinessQr">
                            <span class="pos-org__nav-icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                            <span class="pos-org__nav-label">@L["Org_BusinessQrLink"]</span>
                            <span class="pos-org__nav-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="pos-org__nav-row" role="listitem" @onclick="GoDevices">
                            <span class="pos-org__nav-icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                            <span class="pos-org__nav-label">POS devices</span>
                            <span class="pos-org__nav-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="pos-org__nav-row" role="listitem" @onclick="GoSubscription">
                            <span class="pos-org__nav-icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                            <span class="pos-org__nav-label">@L["Org_SubscriptionLink"]</span>
                            <span class="pos-org__nav-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="pos-org__nav-row" role="listitem" @onclick="GoBusinessTypes">
                            <span class="pos-org__nav-icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                            <span class="pos-org__nav-label">@L["Org_BusinessTypesLink"]</span>
                            <span class="pos-org__nav-chevron" aria-hidden="true">›</span>
                        </button>
                        <button type="button" class="pos-org__nav-row" role="listitem" @onclick="GoCustomerLinkNotifications">
                            <span class="pos-org__nav-icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                            <span class="pos-org__nav-label">@L["OrgNotifications_Title"]</span>
                            <span class="pos-org__nav-chevron" aria-hidden="true">›</span>
                        </button>
                    </div>
                }
                else
                {
                    @* My QR stays in Personal workspace only — opening it from Org shell
                       switches to Personal tabs and traps org-locked members. *@
                    <p class="pos-org__hint pos-muted">@L["Org_EssentialsOwnerOnly"]</p>
                }
            </section>

            <p class="pos-org__footnote pos-muted">@L["Org_WebAdminReminder"]</p>
        </Page>
    </div>
}

<style>
    .pos-org { width: 100%; }
    .pos-org__header { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-org__awaiting { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-org__title {
        margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.25;
        color: var(--exits-text, #15201a);
    }
    .pos-org__subtitle {
        margin: 0.3rem 0 0; font-size: 0.875rem; line-height: 1.35;
    }
    .pos-org__section-title {
        margin: 0 0 0.5rem; font-size: 0.8125rem; font-weight: 700;
        letter-spacing: 0.02em; text-transform: uppercase;
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-org__summary { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-org__status-list {
        margin: 0; padding: 0.35rem 0.65rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-org__status-row {
        display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
        min-height: 2.5rem; padding: 0.35rem 0;
        border-top: 1px solid var(--exits-border, #c9d4cd);
    }
    .pos-org__status-row:first-child { border-top: 0; }
    .pos-org__status-row dt {
        margin: 0; font-size: 0.875rem; font-weight: 600; color: var(--exits-text, #15201a);
    }
    .pos-org__status-row dd { margin: 0; }
    .pos-org__chip {
        display: inline-flex; align-items: center; max-width: 100%;
        padding: 0.15rem 0.5rem; border-radius: 999px;
        border: 1px solid var(--exits-border, #c9d4cd);
        font-size: 0.75rem; font-weight: 650; line-height: 1.3;
        color: var(--exits-text, #15201a); background: var(--exits-bg, #f3f6f4);
    }
    .pos-org__chip--ok {
        border-color: #9cc9b0; background: #e8f5ee; color: #145a3a;
    }
    .pos-org__chip--warn {
        border-color: #e0c48a; background: #fff7e8; color: #7a5410;
    }
    .pos-org__chip--danger {
        border-color: #e3a8a2; background: #fdeeee; color: #8f1f18;
    }
    .pos-org__chip--muted {
        border-color: var(--exits-border, #c9d4cd); background: var(--exits-bg, #f3f6f4);
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-org__hint { margin: 0.55rem 0 0; font-size: 0.75rem; line-height: 1.4; }
    .pos-org__primary { margin: 0 0 var(--exits-space-3, 0.75rem); }
    .pos-org__primary .exds-btn { width: 100%; min-height: 2.75rem; }
    .pos-org__pos-blocked {
        margin: 0; padding: 0.65rem 0.7rem;
        border: 1px dashed var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        font-size: 0.8125rem; line-height: 1.4;
    }
    .pos-org__essentials { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-org__nav { display: flex; flex-direction: column; gap: 0.4rem; }
    .pos-org__nav-row {
        display: flex; align-items: center; gap: 0.65rem; width: 100%;
        min-height: 2.75rem; padding: 0.55rem 0.65rem; text-align: start;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
        color: var(--exits-text, #15201a); cursor: pointer;
    }
    .pos-org__nav-icon {
        flex: 0 0 1.25rem; width: 1.25rem; height: 1.25rem;
        color: var(--exits-accent, #1f6b4a);
    }
    .pos-org__nav-icon :deep(svg) { width: 100%; height: 100%; display: block; }
    .pos-org__nav-label { flex: 1 1 auto; font-size: 0.9375rem; font-weight: 600; line-height: 1.3; }
    .pos-org__nav-chevron {
        flex: 0 0 auto; color: var(--exits-text-muted, #5b6b62);
        font-size: 1.1rem; line-height: 1;
    }
    .pos-org__footnote {
        margin: 0.25rem 0 calc(0.5rem + env(safe-area-inset-bottom, 0px));
        font-size: 0.75rem; line-height: 1.4;
    }
</style>

@code {
    private bool _ready;
    private bool _enablingPos;
    private bool _enteringPos;
    private bool _isOffline;
    private bool _sessionExpired;
    private string? _error;
    private string? _posAccessHint;
    private bool _posRoleMissing;
    private PlatformOrganizationDto? _org;
    private PlatformSubscriptionDto? _subscription;
    private PlatformEntitlementSnapshotDto? _entitlement;
    private bool _isOrganizationOwner;

    private string OrganizationStatusText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_org?.Status))
            {
                return _org!.Status;
            }

            if (!string.IsNullOrWhiteSpace(CurrentUser.Session?.OrganizationDisplayName))
            {
                return CurrentUser.Session!.OrganizationDisplayName!;
            }

            return _isOffline ? L["Org_OfflineCachedUnknown"] : "—";
        }
    }

    private string SubscriptionStatusText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_subscription?.Status))
            {
                return _subscription!.Status;
            }

            return _isOffline ? L["Org_SubscriptionOffline"] : L["Org_SubscriptionUnknown"];
        }
    }

    private string EntitlementStatusText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_entitlement?.SubscriptionStatus))
            {
                return _entitlement!.SubscriptionStatus!;
            }

            return _isOffline ? L["Org_EntitlementOffline"] : L["Org_EntitlementUnknown"];
        }
    }

    private string PosAccessStatusText =>
        CurrentUser.HasPosAccess ? L["Org_PosAccessYes"] : L["Org_PosAccessNo"];

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            if (!restore.Succeeded)
            {
                if (restore.FailureReason is AuthFailureReason.Offline)
                {
                    _isOffline = true;
                    _ready = true;
                    return;
                }

                _sessionExpired = true;
                _ready = true;
                return;
            }
        }

        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            _ready = true;
            return;
        }

        await LoadAccessStateAsync(orgId.Value);
        _isOrganizationOwner = await ResolveIsOrganizationOwnerAsync(orgId.Value);

        _ready = true;
    }

    /// <summary>Reloads organization, subscription, entitlement, POS access and POS role state.</summary>
    private async Task LoadAccessStateAsync(Guid organizationId)
    {
        _error = null;
        _sessionExpired = false;
        _isOffline = !await Connectivity.IsConnectedAsync();

        if (_isOffline)
        {
            // Keep local session/org identity; Platform-only sections show offline copy.
            return;
        }

        var orgResult = await Platform.GetOrganizationAsync(organizationId);
        if (orgResult.IsSuccess)
        {
            _org = orgResult.Data;
        }
        else if (orgResult.Status == ApiCallStatus.Unauthorized)
        {
            _sessionExpired = true;
            return;
        }
        else if (orgResult.Status is ApiCallStatus.Offline)
        {
            _isOffline = true;
            return;
        }
        else if (orgResult.Status is ApiCallStatus.Unavailable or ApiCallStatus.Timeout)
        {
            var described = StatusLocalizer.Describe(orgResult.Status, orgResult.Error);
            _error = described.Message;
        }
        else
        {
            _error = L["Org_LoadFailed"];
        }

        var sub = await Platform.GetCurrentSubscriptionAsync(organizationId, PosProductCodes.PinoyBusinessPos);
        if (sub.IsSuccess)
        {
            _subscription = sub.Data;
        }
        else if (sub.Status == ApiCallStatus.Unauthorized)
        {
            _sessionExpired = true;
            return;
        }
        else if (sub.Status == ApiCallStatus.Offline)
        {
            _isOffline = true;
        }

        var ent = await Platform.GetLatestEntitlementAsync(organizationId, PosProductCodes.PinoyBusinessPos);
        if (ent.IsSuccess)
        {
            _entitlement = ent.Data;
        }
        else if (ent.Status == ApiCallStatus.Unauthorized)
        {
            _sessionExpired = true;
            return;
        }
        else if (ent.Status == ApiCallStatus.Offline)
        {
            _isOffline = true;
        }

        _posAccessHint = ResolvePosAccessHint();
        await RefreshPosRoleStateAsync();
    }

    /// <summary>
    /// POS access assignment and POS product role are separate concepts. With access but no active
    /// role, no dashboard is authorized, so this page explains it instead of offering Continue to POS.
    /// </summary>
    private async Task RefreshPosRoleStateAsync()
    {
        if (!CurrentUser.HasPosAccess)
        {
            _posRoleMissing = false;
            return;
        }

        var effective = await Permissions.GetEffectiveAsync();
        if (!effective.IsSuccess || effective.Data is null)
        {
            // Transport failures must not be reported as a missing role assignment.
            _posRoleMissing = false;
            return;
        }

        _posRoleMissing = !string.Equals(effective.Data.Status, "Active", StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(effective.Data.Role);
    }

    private async Task<bool> ResolveIsOrganizationOwnerAsync(Guid organizationId)
    {
        var userId = CurrentUser.Session?.UserId;
        if (userId is null)
        {
            return false;
        }

        var eligible = await Access.ListEligibleOrganizationsAsync(userId.Value);
        if (eligible.Any(o =>
                o.OrganizationId == organizationId
                && OrganizationMembershipRoles.IsOwnerRole(o.MembershipRole)))
        {
            return true;
        }

        var memberships = await Platform.GetUserMembershipsAsync(userId.Value);
        if (!memberships.IsSuccess || memberships.Data is null)
        {
            return false;
        }

        return memberships.Data.Items.Any(m =>
            m.OrganizationId == organizationId
            && string.Equals(m.Status, "Active", StringComparison.OrdinalIgnoreCase)
            && OrganizationMembershipRoles.IsOwnerRole(m.Role));
    }

    private string? ResolvePosAccessHint()
    {
        if (CurrentUser.HasPosAccess)
        {
            return null;
        }

        // Null/unknown reason usually means bind never completed or role lookup failed —
        // prefer the actionable POS-role message over a generic "access denied".
        var code = CurrentUser.Session?.AccessReasonCode;
        if (string.IsNullOrWhiteSpace(code))
        {
            return L["Access_RoleMissing"];
        }

        return L[ProductAccessResolver.MapReasonKey(code)];
    }

    private async Task EnterPosAsync()
    {
        if (_enteringPos || _enablingPos || !CurrentUser.HasPosAccess || _posRoleMissing)
        {
            return;
        }

        _enteringPos = true;
        _error = null;
        try
        {
            if (CurrentUser.Session?.OrganizationId is Guid oid && !CurrentUser.HasPosAccess)
            {
                var selected = await Auth.SelectOrganizationAsync(oid);
                if (!selected.Succeeded)
                {
                    _error = L[selected.SafeMessageKey ?? "Access_Denied"];
                    return;
                }
            }

            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
        finally
        {
            _enteringPos = false;
        }
    }

    private async Task EnablePosAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid oid || _enablingPos || _enteringPos)
        {
            return;
        }

        _enablingPos = true;
        _error = null;
        try
        {
            var selected = await Auth.SelectOrganizationAsync(oid);
            if (!selected.Succeeded)
            {
                _error = L[selected.SafeMessageKey ?? "Access_Denied"];
                _posAccessHint = ResolvePosAccessHint();
                return;
            }

            if (!CurrentUser.HasPosAccess)
            {
                _posAccessHint = ResolvePosAccessHint();
                _error = L[CurrentUser.Session?.AccessReasonCode is null
                    ? "Access_Denied"
                    : ProductAccessResolver.MapReasonKey(CurrentUser.Session.AccessReasonCode)];
                return;
            }

            // Server confirmed POS access: refresh entitlement/access/role state, then let the
            // gate decide the destination. Stay here when no POS role is assigned yet.
            await LoadAccessStateAsync(oid);
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
        finally
        {
            _enablingPos = false;
        }
    }

    private static string StatusTone(string? status)
    {
        if (string.IsNullOrWhiteSpace(status) || status == "—")
        {
            return "muted";
        }

        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Trialing", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Yes", StringComparison.OrdinalIgnoreCase))
        {
            return "ok";
        }

        if (string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "PastDue", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Past Due", StringComparison.OrdinalIgnoreCase))
        {
            return "warn";
        }

        if (string.Equals(status, "Expired", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Suspended", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Cancelled", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Canceled", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Blocked", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Revoked", StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        return "muted";
    }

    private void GoProfile() => Nav.NavigateTo("/org/profile");
    private void GoStaff() => Nav.NavigateTo("/org/staff");
    private void GoBusinessQr() => Nav.NavigateTo("/org/business-qr");
    private void GoDevices() => Nav.NavigateTo("/organization/devices");
    private void GoSubscription() => Nav.NavigateTo("/org/subscription");
    private void GoBusinessTypes() => Nav.NavigateTo("/org/business-types");
    private void GoCustomerLinkNotifications() => Nav.NavigateTo("/org/notifications");
    private void GoSelect() => Nav.NavigateTo("/organization-select");

    private void GoSignIn()
    {
        ReturnRoute.Capture("/org");
        Nav.NavigateTo("/signin", replace: true);
    }
}

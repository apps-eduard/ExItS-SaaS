@page "/org/staff"
@using ExItS.DesignSystem.Components.Internal
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IAuthenticationService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-staff">
    <StoreHeaderBack Href="/org" />
    <Page>
        <header class="pos-staff__header">
            <div class="pos-staff__heading">
                <h1 class="pos-staff__title">@L["Org_StaffTitle"]</h1>
                <p class="pos-staff__subtitle">@L["Org_StaffSubtitle"]</p>
            </div>
        </header>

        <div class="pos-action-grid pos-action-grid--single pos-staff__actions-bar" role="group" aria-label="@L["Org_StaffTitle"]">
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    @onclick="GoInvite">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span class="pos-action-tile__label">@L["Org_InviteStaff"]</span>
            </button>
        </div>

        @if (_loading)
        {
            <Stack Align="StackAlign.Center" Gap="2">
                <Spinner />
            </Stack>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <ErrorState Title="@L["Org_ErrorTitle"]" Message="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
        }
        else if (_rows.Count == 0)
        {
            <EmptyState IconName="customers"
                        Title="@L["Org_StaffEmptyTitle"]"
                        Message="@L["Org_StaffEmptyMessage"]" />
        }
        else
        {
            <div class="pos-staff__list" role="list">
                @foreach (var row in _rows)
                {
                    <article class="pos-staff__row" role="listitem">
                        <Avatar Name="@row.DisplayName"
                                Size="AvatarSize.Sm"
                                AriaLabel="@row.DisplayName" />
                        <div class="pos-staff__body">
                            <div class="pos-staff__name-row">
                                <span class="pos-staff__name">@row.DisplayName</span>
                                <span class="pos-staff__status pos-staff__status--@StatusTone(row.MembershipStatus)">
                                    @FriendlyStatus(row.MembershipStatus)
                                </span>
                            </div>
                            <div class="pos-staff__meta">
                                <span>@FriendlyMembershipRole(row.MembershipRole)</span>
                                @if (!string.IsNullOrWhiteSpace(row.Email))
                                {
                                    <span class="pos-muted">·</span>
                                    <span class="pos-muted">@row.Email</span>
                                }
                            </div>

                            <div class="pos-staff__roles" aria-label="@L["Org_PosRolesSection"]">
                                @if (row.PosGrants.Count == 0)
                                {
                                    <span class="pos-staff__roles-empty pos-muted">@L["Org_NoPosRoles"]</span>
                                }
                                else
                                {
                                    @foreach (var grant in row.PosGrants)
                                    {
                                        <span class="pos-staff__chip">
                                            <span>@FriendlyPosRole(grant.MappedPosRoleCode, grant.RoleCode, grant.RoleDisplay)</span>
                                            <button type="button"
                                                    class="pos-staff__chip-revoke"
                                                    disabled="@_busy"
                                                    title="@L["Org_RevokePosRole"]"
                                                    aria-label="@($"{L["Org_RevokePosRole"]} {FriendlyPosRole(grant.MappedPosRoleCode, grant.RoleCode, grant.RoleDisplay)}")"
                                                    @onclick="() => RevokeGrantAsync(grant.Id)">×</button>
                                        </span>
                                    }
                                }
                            </div>

                            <div class="pos-staff__branches" aria-label="@L["Org_StaffBranchesSection"]">
                                @if (row.UsesExplicitBranchAssignments)
                                {
                                    @if (row.BranchAssignments.Count == 0)
                                    {
                                        <span class="pos-staff__roles-empty pos-muted">@L["Org_StaffBranchesNone"]</span>
                                    }
                                    else
                                    {
                                        @foreach (var branch in row.BranchAssignments)
                                        {
                                            <span class="pos-staff__chip pos-staff__chip--branch">@branch.Name</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="pos-staff__roles-empty pos-muted">@L["Org_StaffBranchesAll"]</span>
                                }
                            </div>

                            <div class="pos-staff__actions">
                                <button type="button"
                                        class="pos-staff__action"
                                        disabled="@_busy"
                                        @onclick="() => GoAssign(row)">
                                    @L["Org_AssignPosRole"]
                                </button>
                                @if (row.UsesExplicitBranchAssignments)
                                {
                                    <button type="button"
                                            class="pos-staff__action"
                                            disabled="@_busy"
                                            @onclick="() => OpenBranchSheetAsync(row)">
                                        @L["Org_StaffBranchesEdit"]
                                    </button>
                                }
                                @if (string.Equals(row.MembershipStatus, "Active", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="button"
                                            class="pos-staff__action"
                                            disabled="@_busy"
                                            @onclick="() => SuspendAsync(row.MembershipId)">
                                        @L["Org_Suspend"]
                                    </button>
                                    <button type="button"
                                            class="pos-staff__action pos-staff__action--danger"
                                            disabled="@_busy"
                                            @onclick="() => RevokeAsync(row.MembershipId)">
                                        @L["Org_Remove"]
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        <p class="pos-staff__footnote pos-muted">@L["Org_WebAdminReminder"]</p>
    </Page>
</div>

@if (_branchSheetRow is not null)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["Org_StaffBranchesSheetTitle"]">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit">
            <header class="pos-denom-sheet__header">
                <div>
                    <h2 class="pos-denom-sheet__title">@L["Org_StaffBranchesSheetTitle"]</h2>
                    <p class="pos-muted">@_branchSheetRow.DisplayName</p>
                </div>
            </header>
            <div class="pos-denom-sheet__list pos-denom-sheet__list--fit pos-staff__branch-picker">
                @foreach (var branch in _orgBranches)
                {
                    var selected = _branchSheetSelection.Contains(branch.Id);
                    <label class="pos-staff__branch-option">
                        <input type="checkbox"
                               checked="@selected"
                               disabled="@_busy"
                               @onchange="e => ToggleBranchSelection(branch.Id, e)" />
                        <span>@branch.Name</span>
                        @if (branch.IsPrimary)
                        {
                            <span class="pos-staff__chip pos-staff__chip--branch">@L["Org_StaffBranchPrimary"]</span>
                        }
                    </label>
                }
            </div>
            @if (!string.IsNullOrEmpty(_branchSheetError))
            {
                <p class="pos-staff__sheet-error">@_branchSheetError</p>
            }
            <div class="pos-denom-sheet__actions">
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="SaveBranchSheetAsync">
                    @L["Org_StaffBranchesSave"]
                </button>
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="CloseBranchSheet">
                    @L["Common_Cancel"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record StaffPosGrant(Guid Id, string RoleCode, string MappedPosRoleCode, string? RoleDisplay);

    private sealed record StaffRow(
        Guid MembershipId,
        Guid UserId,
        string DisplayName,
        string Email,
        string MembershipRole,
        string MembershipStatus,
        IReadOnlyList<StaffPosGrant> PosGrants,
        bool UsesExplicitBranchAssignments,
        IReadOnlyList<MembershipBranchAssignmentDto> BranchAssignments);

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<StaffRow> _rows = [];
    private IReadOnlyList<OrganizationBranchDto> _orgBranches = [];
    private StaffRow? _branchSheetRow;
    private HashSet<Guid> _branchSheetSelection = [];
    private string? _branchSheetError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (CurrentUser.Session?.OrganizationId is null)
            {
                await Auth.RestoreSessionAsync();
            }

            var orgId = CurrentUser.Session?.OrganizationId;
            if (orgId is null)
            {
                _error = L["Org_MissingMessage"];
                return;
            }

            var members = await Platform.GetOrganizationMembersAsync(orgId.Value);
            if ((!members.IsSuccess || members.Data is null)
                && members.Status == ApiCallStatus.Unauthorized)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (restore.Succeeded && CurrentUser.Session?.OrganizationId is Guid restoredOrg)
                {
                    orgId = restoredOrg;
                    members = await Platform.GetOrganizationMembersAsync(orgId.Value);
                }
            }

            if (!members.IsSuccess || members.Data is null)
            {
                _error = L["Org_StaffLoadFailed"];
                return;
            }

            var grantsResult = await Platform.GetProductLocalRolesAsync(orgId.Value, status: "Active");
            var grants = grantsResult.IsSuccess && grantsResult.Data is not null
                ? grantsResult.Data
                : [];

            var branchesResult = await Platform.GetBranchesAsync(orgId.Value);
            _orgBranches = branchesResult.IsSuccess && branchesResult.Data is not null
                ? branchesResult.Data
                    .Where(b => string.Equals(b.Status, "Active", StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(b => b.IsPrimary)
                    .ThenBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList()
                : [];

            var rows = new List<StaffRow>();
            foreach (var member in members.Data.Items
                         .OrderBy(m => MembershipSortKey(m.Role))
                         .ThenBy(m => m.CreatedAtUtc))
            {
                var displayName = string.Empty;
                var email = member.Email ?? string.Empty;
                var grantName = grants
                    .FirstOrDefault(g => g.UserIdentityId == member.UserId)?.UserDisplayName;

                displayName = FirstMeaningful(
                    member.DisplayName,
                    grantName,
                    member.Username,
                    member.Email) ?? string.Empty;

                try
                {
                    if (string.IsNullOrWhiteSpace(displayName) || string.IsNullOrWhiteSpace(email))
                    {
                        var userResult = await Platform.GetUserAsync(member.UserId);
                        if (userResult.IsSuccess && userResult.Data is not null)
                        {
                            displayName = FirstMeaningful(
                                displayName,
                                userResult.Data.DisplayName,
                                userResult.Data.Username,
                                userResult.Data.Email) ?? string.Empty;
                            if (string.IsNullOrWhiteSpace(email))
                            {
                                email = userResult.Data.Email ?? string.Empty;
                            }
                        }
                    }
                }
                catch
                {
                    // Fall through to unknown-name fallback.
                }

                if (string.IsNullOrWhiteSpace(displayName))
                {
                    displayName = L["Org_StaffUnknownName"];
                }

                var memberGrants = grants
                    .Where(g => g.UserIdentityId == member.UserId)
                    .OrderBy(g => PosRoleSortKey(g.MappedPosRoleCode ?? g.RoleCode))
                    .Select(g => new StaffPosGrant(g.Id, g.RoleCode, g.MappedPosRoleCode, g.RoleDisplay))
                    .ToList();

                var usesExplicitBranches = UsesExplicitBranchAssignments(member.Role);
                IReadOnlyList<MembershipBranchAssignmentDto> branchAssignments = [];
                if (usesExplicitBranches)
                {
                    var assignmentResult = await Platform.GetMembershipBranchAssignmentsAsync(orgId.Value, member.Id);
                    branchAssignments = assignmentResult.IsSuccess && assignmentResult.Data is not null
                        ? assignmentResult.Data
                        : [];
                }

                rows.Add(new StaffRow(
                    member.Id,
                    member.UserId,
                    displayName,
                    email,
                    member.Role,
                    member.Status,
                    memberGrants,
                    usesExplicitBranches,
                    branchAssignments));
            }

            _rows = rows;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SuspendAsync(Guid membershipId)
    {
        _busy = true;
        try
        {
            await Platform.SuspendMembershipAsync(membershipId, new PlatformMembershipLifecycleRequest("Suspended from Mobile"));
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(Guid membershipId)
    {
        _busy = true;
        try
        {
            await Platform.RevokeMembershipAsync(membershipId, new PlatformMembershipLifecycleRequest("Removed from Mobile"));
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeGrantAsync(Guid grantId)
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Platform.RevokeProductLocalRoleAsync(orgId.Value, grantId, new RevokeProductLocalRoleRequest("Revoked from Mobile"));
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private string FriendlyMembershipRole(string? role)
    {
        if (string.Equals(role, "OrganizationOwner", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_MembershipOwner"];
        }

        if (string.Equals(role, "OrganizationAdministrator", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Administrator", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_MembershipAdmin"];
        }

        if (string.Equals(role, "OrganizationMember", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Member", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_MembershipStaff"];
        }

        return string.IsNullOrWhiteSpace(role) ? L["Org_MembershipStaff"] : role;
    }

    private string FriendlyPosRole(string? mapped, string? roleCode, string? roleDisplay)
    {
        if (!string.IsNullOrWhiteSpace(roleDisplay))
        {
            return roleDisplay!;
        }

        var code = !string.IsNullOrWhiteSpace(mapped) ? mapped! : roleCode;
        if (string.Equals(code, "Owner", StringComparison.OrdinalIgnoreCase)
            || string.Equals(code, "PosOwner", StringComparison.OrdinalIgnoreCase)
            || string.Equals(code, "POS Owner", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_RoleOwner"];
        }

        if (string.Equals(code, "StoreManager", StringComparison.OrdinalIgnoreCase)
            || string.Equals(code, "Manager", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_RoleManager"];
        }

        if (string.Equals(code, "Cashier", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_RoleCashier"];
        }

        return string.IsNullOrWhiteSpace(code) ? L["Org_NoPosRoles"] : code!;
    }

    private string FriendlyStatus(string? status)
    {
        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_StatusActive"];
        }

        if (string.Equals(status, "Suspended", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_StatusSuspended"];
        }

        if (string.Equals(status, "Removed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Revoked", StringComparison.OrdinalIgnoreCase))
        {
            return L["Org_StatusRemoved"];
        }

        return string.IsNullOrWhiteSpace(status) ? "—" : status!;
    }

    private static string StatusTone(string? status)
    {
        if (string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            return "ok";
        }

        if (string.Equals(status, "Suspended", StringComparison.OrdinalIgnoreCase))
        {
            return "warn";
        }

        return "muted";
    }

    private static int MembershipSortKey(string? role)
    {
        if (string.Equals(role, "OrganizationOwner", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        if (string.Equals(role, "OrganizationAdministrator", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        return 2;
    }

    private static int PosRoleSortKey(string? role)
    {
        if (string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "PosOwner", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        if (string.Equals(role, "StoreManager", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        if (string.Equals(role, "Cashier", StringComparison.OrdinalIgnoreCase))
        {
            return 2;
        }

        return 3;
    }

    private void GoInvite() => Nav.NavigateTo("/org/staff/invite");

    private static bool UsesExplicitBranchAssignments(string? role) =>
        string.Equals(role, "OrganizationMember", StringComparison.OrdinalIgnoreCase)
        || string.Equals(role, "Member", StringComparison.OrdinalIgnoreCase);

    private void OpenBranchSheetAsync(StaffRow row)
    {
        _branchSheetRow = row;
        _branchSheetError = null;
        _branchSheetSelection = row.BranchAssignments.Select(b => b.BranchId).ToHashSet();
    }

    private void CloseBranchSheet()
    {
        _branchSheetRow = null;
        _branchSheetError = null;
        _branchSheetSelection = [];
    }

    private void ToggleBranchSelection(Guid branchId, ChangeEventArgs e)
    {
        var selected = e.Value is bool on && on;
        if (selected)
        {
            _branchSheetSelection.Add(branchId);
        }
        else
        {
            _branchSheetSelection.Remove(branchId);
        }
    }

    private async Task SaveBranchSheetAsync()
    {
        if (_branchSheetRow is null || CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            return;
        }

        if (_branchSheetSelection.Count == 0)
        {
            _branchSheetError = L["Org_StaffBranchesRequired"];
            return;
        }

        _busy = true;
        _branchSheetError = null;
        try
        {
            var result = await Platform.SetMembershipBranchAssignmentsAsync(
                orgId,
                _branchSheetRow.MembershipId,
                new SetMembershipBranchAssignmentsRequest(_branchSheetSelection.ToList()));
            if (!result.IsSuccess)
            {
                _branchSheetError = L["Org_StaffBranchesSaveFailed"];
                return;
            }

            CloseBranchSheet();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? FirstMeaningful(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return null;
    }

    private void GoAssign(StaffRow row)
    {
        var qs = $"userId={row.UserId:D}";
        if (!string.IsNullOrWhiteSpace(row.DisplayName)
            && !string.Equals(row.DisplayName, L["Org_StaffUnknownName"].Value, StringComparison.Ordinal))
        {
            qs += $"&displayName={Uri.EscapeDataString(row.DisplayName)}";
        }

        if (!string.IsNullOrWhiteSpace(row.Email))
        {
            qs += $"&email={Uri.EscapeDataString(row.Email)}";
        }

        Nav.NavigateTo($"/org/staff/assign?{qs}");
    }
}

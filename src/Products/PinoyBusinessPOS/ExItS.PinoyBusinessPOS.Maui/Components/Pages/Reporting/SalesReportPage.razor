@page "/reports/sales"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Commercial
@using ExItS.PinoyBusinessPOS.Application.Reporting
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosReportingClient Reports
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-report">
<StoreHeaderBack Href="/reports" />
<Page>
    <PageHeader Title="@L["Reports_Sales"]" Subtitle="@L["Reports_SalesSubtitle"]" />

    <div class="pos-action-grid pos-action-grid--single pos-report__actions" role="group">
        <button type="button" class="pos-action-tile" disabled="@_loading" @onclick="ReloadAsync">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
            <span class="pos-action-tile__label">@L["Dashboard_Refresh"]</span>
        </button>
    </div>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Dashboard_OfflineTitle"]" Message="@L["Dashboard_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Dashboard_ErrorTitle"])" Message="@_errorMessage" />
    }

    <Section Title="@L["Dashboard_FiltersTitle"]">
        <div class="pos-settings__panel">
            <Stack Gap="2">
                <DateInput Label="@L["Dashboard_FromDate"]" Value="@_fromDate" ValueChanged="OnFromDateChanged" Disabled="@_loading" />
                <DateInput Label="@L["Dashboard_ToDate"]" Value="@_toDate" ValueChanged="OnToDateChanged" Disabled="@_loading" />
            </Stack>
        </div>
    </Section>

    @if (_report is not null)
    {
        <Section Title="@L["Reports_SummaryTitle"]">
            <div class="pos-dashboard__stats" role="list">
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_CompletedSales"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_report.CompletedSalesTotal" CurrencyCode="PHP" /></span>
                    <span class="pos-dashboard__stat-meta">@_report.CompletedSaleCount</span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Reports_VoidedSales"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_report.VoidedSalesTotal" CurrencyCode="PHP" /></span>
                    <span class="pos-dashboard__stat-meta">@_report.VoidedSaleCount</span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_UtangSales"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_report.UtangSalesTotal" CurrencyCode="PHP" /></span>
                    <span class="pos-dashboard__stat-meta">@_report.UtangSaleCount</span>
                </div>
            </div>
        </Section>

        <Section Title="@L["Dashboard_PaymentBreakdown"]">
            <div class="pos-dashboard__list" role="list">
                @foreach (var row in _report.ByPaymentMethod)
                {
                    <div class="pos-dashboard__row" role="listitem">
                        <span class="pos-dashboard__row-title">@row.PaymentMethod</span>
                        <span class="pos-dashboard__row-meta">@row.Count</span>
                        <span class="pos-dashboard__row-value"><MoneyDisplay Amount="@row.Amount" CurrencyCode="PHP" /></span>
                    </div>
                }
            </div>
        </Section>

        <Section Title="@L["Reports_TopProductsAmount"]">
            <div class="pos-dashboard__list" role="list">
                @foreach (var row in _report.TopProductsBySalesAmount)
                {
                    <button type="button" class="pos-dashboard__row pos-dashboard__row--action" role="listitem" @onclick="() => GoProduct(row.ProductId)">
                        <span class="pos-dashboard__row-title">@row.NameSnapshot</span>
                        <span class="pos-dashboard__row-meta">@row.Quantity @row.UnitOfMeasure</span>
                        <span class="pos-dashboard__row-value"><MoneyDisplay Amount="@row.SalesAmount" CurrencyCode="PHP" /></span>
                    </button>
                }
            </div>
        </Section>

        <Section Title="@L["Reports_ByCategory"]">
            <div class="pos-dashboard__list" role="list">
                @foreach (var row in _report.ByCategory)
                {
                    <div class="pos-dashboard__row" role="listitem">
                        <span class="pos-dashboard__row-title">@row.CategoryName</span>
                        <span class="pos-dashboard__row-meta">@row.LineCount</span>
                        <span class="pos-dashboard__row-value"><MoneyDisplay Amount="@row.SalesAmount" CurrencyCode="PHP" /></span>
                    </div>
                }
            </div>
        </Section>
    }
    else if (_loading)
    {
        <Stack Align="StackAlign.Center" Gap="2">
            <Spinner />
            <span class="pos-muted">@L["Dashboard_Loading"]</span>
        </Stack>
    }
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private string? _errorTitle;
    private string? _errorMessage;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private PosSalesReportDto? _report;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewReports))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _fromDate = today;
        _toDate = today;
        _ready = true;
        await ReloadAsync();
    }

    private async Task OnFromDateChanged(DateOnly? value) { _fromDate = value; await ReloadAsync(); }
    private async Task OnToDateChanged(DateOnly? value) { _toDate = value; await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _report = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline) { _loading = false; return; }

        var result = await Reports.GetSalesReportAsync(_fromDate, _toDate);
        if (result.IsSuccess) { _report = result.Data; }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }
        _loading = false;
    }

    private void GoProduct(Guid productId) => Nav.NavigateTo($"/catalog/products/{productId:D}");
}

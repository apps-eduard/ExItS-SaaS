@page "/reports/inventory"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Commercial
@using ExItS.PinoyBusinessPOS.Application.Reporting
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosReportingClient Reports
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-report">
<StoreHeaderBack Href="/reports" />
<Page>
    <header class="pos-report__header">
        <h1 class="pos-report__title">@L["Reports_Inventory"]</h1>
        <p class="pos-report__subtitle">@L["Reports_InventorySubtitle"]</p>
    </header>

    <div class="pos-action-grid pos-action-grid--single pos-report__actions" role="group">
        <button type="button" class="pos-action-tile" disabled="@_loading" @onclick="ReloadAsync">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
            <span class="pos-action-tile__label">@L["Dashboard_Refresh"]</span>
        </button>
    </div>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Dashboard_OfflineTitle"]" Message="@L["Dashboard_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Dashboard_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-report__panel" aria-labelledby="inventory-report-filters-heading">
        <h2 id="inventory-report-filters-heading" class="pos-report__section-title">@L["Dashboard_FiltersTitle"]</h2>
        <div class="pos-report__form">
            <DateInput Label="@L["Dashboard_FromDate"]" Value="@_fromDate" ValueChanged="OnFromDateChanged" Disabled="@_loading" />
            <DateInput Label="@L["Dashboard_ToDate"]" Value="@_toDate" ValueChanged="OnToDateChanged" Disabled="@_loading" />
        </div>
    </section>

    @if (_report is not null)
    {
        <section class="pos-report__panel" aria-labelledby="inventory-report-summary-heading">
            <h2 id="inventory-report-summary-heading" class="pos-report__section-title">@L["Reports_SummaryTitle"]</h2>
            <div class="pos-dashboard__stats" role="list">
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Reports_TrackedCount"]</span>
                    <span class="pos-dashboard__stat-value">@_report.TrackedProductCount</span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_LowStock"]</span>
                    <span class="pos-dashboard__stat-value">@_report.LowStockProductCount</span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Reports_OutOfStock"]</span>
                    <span class="pos-dashboard__stat-value">@_report.OutOfStockProductCount</span>
                </div>
            </div>
        </section>

        <section class="pos-report__panel" aria-labelledby="inventory-report-movements-heading">
            <h2 id="inventory-report-movements-heading" class="pos-report__section-title">@L["Reports_MovementsByType"]</h2>
            <div class="pos-dashboard__list" role="list">
                @foreach (var row in _report.MovementsByType)
                {
                    <div class="pos-dashboard__row" role="listitem">
                        <span class="pos-dashboard__row-title">@row.MovementType</span>
                        <span class="pos-dashboard__row-meta">@row.Count</span>
                        <span class="pos-dashboard__row-value">@row.QuantityTotal</span>
                    </div>
                }
            </div>
        </section>

        <section class="pos-report__panel" aria-labelledby="inventory-report-lowstock-heading">
            <h2 id="inventory-report-lowstock-heading" class="pos-report__section-title">@L["Reports_LowStockList"]</h2>
            <div class="pos-dashboard__list" role="list">
                @foreach (var row in _report.LowStockProducts.Take(50))
                {
                    <button type="button" class="pos-dashboard__row pos-dashboard__row--action" role="listitem" @onclick="() => GoInventory(row.CatalogProductId)">
                        <span class="pos-dashboard__row-title">@row.ProductName</span>
                        <span class="pos-dashboard__row-value">@row.OnHandQuantity</span>
                    </button>
                }
            </div>
        </section>
    }
    else if (_loading)
    {
        <Stack Align="StackAlign.Center" Gap="2">
            <Spinner />
            <span class="pos-muted">@L["Dashboard_Loading"]</span>
        </Stack>
    }
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private string? _errorTitle;
    private string? _errorMessage;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private PosInventoryReportDto? _report;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewReports))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _fromDate = today;
        _toDate = today;
        _ready = true;
        await ReloadAsync();
    }

    private async Task OnFromDateChanged(DateOnly? value) { _fromDate = value; await ReloadAsync(); }
    private async Task OnToDateChanged(DateOnly? value) { _toDate = value; await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _report = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline) { _loading = false; return; }

        var result = await Reports.GetInventoryReportAsync(_fromDate, _toDate);
        if (result.IsSuccess) { _report = result.Data; }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }
        _loading = false;
    }

    private void GoInventory(Guid productId) => Nav.NavigateTo($"/inventory/{productId:D}");
}

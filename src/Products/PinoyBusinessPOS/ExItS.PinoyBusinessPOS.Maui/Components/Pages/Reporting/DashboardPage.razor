@page "/dashboard"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Commercial
@using ExItS.PinoyBusinessPOS.Application.Reporting
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosReportingClient Reports
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-dashboard">
<Page>
    <PageHeader Title="@L["Dashboard_Title"]" Subtitle="@L["Dashboard_Subtitle"]" />

    <div class="pos-action-grid pos-action-grid--two pos-dashboard__actions" role="group" aria-label="@L["Dashboard_Title"]">
        <button type="button" class="pos-action-tile" @onclick="GoReports">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
            <span class="pos-action-tile__label">@L["Nav_Reports"]</span>
        </button>
        <button type="button" class="pos-action-tile" disabled="@_loading" @onclick="ReloadAsync">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
            <span class="pos-action-tile__label">@L["Dashboard_Refresh"]</span>
        </button>
    </div>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Dashboard_OfflineTitle"]" Message="@L["Dashboard_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Dashboard_ErrorTitle"])" Message="@_errorMessage" />
    }

    <Section Title="@L["Dashboard_FiltersTitle"]">
        <div class="pos-settings__panel">
            <Stack Gap="2">
                <DateInput Label="@L["Dashboard_FromDate"]" Value="@_fromDate" ValueChanged="OnFromDateChanged" Disabled="@_loading" />
                <DateInput Label="@L["Dashboard_ToDate"]" Value="@_toDate" ValueChanged="OnToDateChanged" Disabled="@_loading" />
            </Stack>
        </div>
    </Section>

    @if (_dashboard is not null)
    {
        <Section Title="@L["Dashboard_KpisTitle"]">
            <div class="pos-dashboard__stats" role="list">
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_CompletedSales"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_dashboard.CompletedSalesTotal" CurrencyCode="PHP" /></span>
                    <span class="pos-dashboard__stat-meta">@_dashboard.CompletedSaleCount</span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_CashSales"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_dashboard.CashSalesTotal" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_GCashSales"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_dashboard.ManualGCashSalesTotal" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_UtangSales"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_dashboard.UtangSalesTotal" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_UtangOutstanding"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_dashboard.ActiveCustomerUtangOutstanding" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_OverdueUtang"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_dashboard.OverdueUtangAmount" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_Expenses"]</span>
                    <span class="pos-dashboard__stat-value"><MoneyDisplay Amount="@_dashboard.RecordedExpenseTotal" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_LowStock"]</span>
                    <span class="pos-dashboard__stat-value">@_dashboard.LowStockProductCount</span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_VoidedSales"]</span>
                    <span class="pos-dashboard__stat-value">@_dashboard.VoidedSaleCount</span>
                </div>
                <div class="pos-dashboard__stat" role="listitem">
                    <span class="pos-dashboard__stat-label">@L["Dashboard_VoidedExpenses"]</span>
                    <span class="pos-dashboard__stat-value">@_dashboard.VoidedExpenseCount</span>
                </div>
            </div>
        </Section>

        @if (_dashboard.SalesTotalComparison is not null)
        {
            <Section Title="@L["Dashboard_ComparisonTitle"]">
                <div class="pos-settings__panel">
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Dashboard_SalesChange"]</span>
                        <span class="pos-settings__kv-value @ComparisonToneClass(_dashboard.SalesTotalComparison)">
                            <MoneyDisplay Amount="@_dashboard.SalesTotalComparison.AbsoluteChange.GetValueOrDefault()" CurrencyCode="PHP" />
                            @if (_dashboard.SalesTotalComparison.PercentageAvailable)
                            {
                                <span> (@_dashboard.SalesTotalComparison.PercentageChange!.Value.ToString("0.##")%)</span>
                            }
                            else
                            {
                                <span> (@L["Dashboard_PctNotAvailable"])</span>
                            }
                        </span>
                    </div>
                    @if (_dashboard.ExpenseTotalComparison is not null)
                    {
                        <div class="pos-settings__kv">
                            <span class="pos-settings__kv-label">@L["Dashboard_ExpenseChange"]</span>
                            <span class="pos-settings__kv-value @ComparisonToneClass(_dashboard.ExpenseTotalComparison)">
                                <MoneyDisplay Amount="@_dashboard.ExpenseTotalComparison.AbsoluteChange.GetValueOrDefault()" CurrencyCode="PHP" />
                                @if (_dashboard.ExpenseTotalComparison.PercentageAvailable)
                                {
                                    <span> (@_dashboard.ExpenseTotalComparison.PercentageChange!.Value.ToString("0.##")%)</span>
                                }
                                else
                                {
                                    <span> (@L["Dashboard_PctNotAvailable"])</span>
                                }
                            </span>
                        </div>
                    }
                </div>
            </Section>
        }

        <Section Title="@L["Dashboard_PaymentBreakdown"]">
            @if (_dashboard.PaymentMethodBreakdown.Count == 0)
            {
                <EmptyState IconName="inbox" Title="@L["Dashboard_EmptyTitle"]" Message="@L["Dashboard_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-dashboard__list" role="list">
                    @foreach (var row in _dashboard.PaymentMethodBreakdown)
                    {
                        <div class="pos-dashboard__row" role="listitem">
                            <span class="pos-dashboard__row-title">@row.PaymentMethod</span>
                            <span class="pos-dashboard__row-meta">@row.Count</span>
                            <span class="pos-dashboard__row-value"><MoneyDisplay Amount="@row.Amount" CurrencyCode="PHP" /></span>
                        </div>
                    }
                </div>
            }
        </Section>

        <Section Title="@L["Dashboard_SalesByDay"]">
            @{
                var salesDays = _dashboard.SalesByDay.Where(i => i.Count > 0 || i.Amount > 0m).Take(14).ToList();
            }
            @if (salesDays.Count == 0)
            {
                <InlineMessage Tone="InlineMessageTone.Info">@L["Dashboard_EmptyMessage"]</InlineMessage>
            }
            else
            {
                <div class="pos-dashboard__list" role="list">
                    @foreach (var row in salesDays)
                    {
                        <div class="pos-dashboard__row" role="listitem">
                            <span class="pos-dashboard__row-title">@row.Date.ToString("yyyy-MM-dd")</span>
                            <span class="pos-dashboard__row-meta">@row.Count</span>
                            <span class="pos-dashboard__row-value"><MoneyDisplay Amount="@row.Amount" CurrencyCode="PHP" /></span>
                        </div>
                    }
                </div>
            }
        </Section>

        <Section Title="@L["Dashboard_ExpensesByDay"]">
            @{
                var expenseDays = _dashboard.ExpensesByDay.Where(i => i.Count > 0 || i.Amount > 0m).Take(14).ToList();
            }
            @if (expenseDays.Count == 0)
            {
                <InlineMessage Tone="InlineMessageTone.Info">@L["Dashboard_EmptyMessage"]</InlineMessage>
            }
            else
            {
                <div class="pos-dashboard__list" role="list">
                    @foreach (var row in expenseDays)
                    {
                        <div class="pos-dashboard__row" role="listitem">
                            <span class="pos-dashboard__row-title">@row.Date.ToString("yyyy-MM-dd")</span>
                            <span class="pos-dashboard__row-meta">@row.Count</span>
                            <span class="pos-dashboard__row-value"><MoneyDisplay Amount="@row.Amount" CurrencyCode="PHP" /></span>
                        </div>
                    }
                </div>
            }
        </Section>
    }
    else if (_loading)
    {
        <Stack Align="StackAlign.Center" Gap="2">
            <Spinner />
            <span class="pos-muted">@L["Dashboard_Loading"]</span>
        </Stack>
    }
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private string? _errorTitle;
    private string? _errorMessage;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private PosDashboardDto? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewDashboard))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _fromDate = today;
        _toDate = today;
        _ready = true;
        await ReloadAsync();
    }

    private async Task OnFromDateChanged(DateOnly? value)
    {
        _fromDate = value;
        await ReloadAsync();
    }

    private async Task OnToDateChanged(DateOnly? value)
    {
        _toDate = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _dashboard = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _loading = false;
            return;
        }

        var result = await Reports.GetDashboardAsync(_fromDate, _toDate);
        if (result.IsSuccess)
        {
            _dashboard = result.Data;
        }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private static string ComparisonToneClass(ReportPeriodComparisonDto comparison)
    {
        var change = comparison.AbsoluteChange.GetValueOrDefault();
        if (change < 0m)
        {
            return "pos-dashboard__delta--down";
        }

        if (change > 0m)
        {
            return "pos-dashboard__delta--up";
        }

        return string.Empty;
    }

    private void GoReports() => Nav.NavigateTo("/reports");
}

@page "/activate"
@layout Layout.AuthShell
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["Activate_Title"]" Subtitle="@L["Activate_Subtitle"]" />

    <FormValidationSummary Messages="_errors" />
    <FormGroup Title="@L["Activate_FormTitle"]">
        <TextInput Label="@L["Activate_Token"]" @bind-Value="_token" Disabled="_busy" IsInvalid="@_invalid" />
        <TextInput Label="@L["Activate_Password"]" @bind-Value="_password" Type="password" Disabled="_busy" IsInvalid="@_invalid" />
        <TextInput Label="@L["Activate_ConfirmPassword"]" @bind-Value="_confirm" Type="password" Disabled="_busy" IsInvalid="@_invalid" />
    </FormGroup>
    <FormActions>
        <Button IsLoading="_busy" Disabled="_busy" OnClick="ActivateAsync">@L["Activate_Submit"]</Button>
        <Button Variant="ButtonVariant.Ghost" Disabled="_busy" OnClick="GoSignIn">@L["SignIn_Submit"]</Button>
    </FormActions>
</Page>

@code {
    [SupplyParameterFromQuery] public string? token { get; set; }

    private string? _token;
    private string? _password;
    private string? _confirm;
    private bool _busy;
    private bool _invalid;
    private List<string> _errors = [];

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(token) && string.IsNullOrWhiteSpace(_token))
        {
            _token = token;
        }
    }

    private async Task ActivateAsync()
    {
        _errors = [];
        _invalid = false;
        if (string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_password))
        {
            _invalid = true;
            _errors.Add(L["Activate_ValidationRequired"]);
            return;
        }

        if (!string.Equals(_password, _confirm, StringComparison.Ordinal))
        {
            _invalid = true;
            _errors.Add(L["Activate_PasswordMismatch"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.ActivatePersonalAccountAsync(
                new ActivatePersonalAccountRequest(_token.Trim(), _password));
            if (!result.IsSuccess)
            {
                _invalid = true;
                _errors.Add(L["Activate_Failed"]);
                return;
            }

            Nav.NavigateTo("/signin");
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/devices/register"
@layout Layout.AuthShell
@using ExItS.PinoyBusinessPOS.Application.Identity
@using ExItS.DesignSystem.Components.Internal
@using Microsoft.Maui.Devices
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IDeviceIdentityProvider DeviceIdentity
@inject ISessionStore SessionStore
@inject IAuthenticationService Auth
@inject IAppInfoService AppInfo
@inject IQrCodeScanService QrScan
@inject NavigationGate Gate
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-device-register">
<Page>
    <StoreHeaderBack Href="/org" />

    <header class="pos-device-register__header">
        <h1 class="pos-device-register__title">Register this POS device</h1>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <Alert Tone="AlertTone.Danger" Title="Registration failed" Message="@_error" />
    }

    <section class="pos-device-register__info" aria-label="Device information">
        <div class="pos-settings__kv">
            <span class="pos-settings__kv-label">Device</span>
            <span class="pos-settings__kv-value">@_deviceLabel</span>
        </div>
        <div class="pos-settings__kv">
            <span class="pos-settings__kv-label">Platform</span>
            <span class="pos-settings__kv-value">@_platformLabel</span>
        </div>
        <div class="pos-settings__kv">
            <span class="pos-settings__kv-label">App version</span>
            <span class="pos-settings__kv-value">@AppInfo.Version</span>
        </div>
    </section>

    @if (_loading)
    {
        <Stack Align="StackAlign.Center" Gap="2">
            <Spinner />
            <span class="pos-muted">Loading branches…</span>
        </Stack>
    }
    else if (_branches.Count == 0)
    {
        <Alert Tone="AlertTone.Warning"
               Title="No active branch"
               Message="Ask an organization owner to create or reactivate a branch." />
    }
    else
    {
        <FormGroup>
            <Select Label="Branch"
                    Value="@_branchIdText"
                    ValueChanged="OnBranchChanged"
                    Options="_branchOptions"
                    Disabled="_saving"
                    Required="true" />
            <TextInput Label="Device name"
                       Value="@_friendlyName"
                       ValueChanged="OnFriendlyNameChanged"
                       Placeholder="e.g. Counter 1"
                       Disabled="_saving"
                       Required="true"
                       maxlength="128" />
        </FormGroup>

        <p class="pos-device-register__note pos-muted">
            This device will be authorized to perform POS transactions.
        </p>

        <div class="pos-action-grid pos-action-grid--two pos-device-register__actions" role="group">
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(_saving || !CanSubmit)"
                    @onclick="ScanRegistrationCodeAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                <span class="pos-action-tile__label">@L["Device_ScanRegistrationCode"]</span>
            </button>
            <Button Variant="ButtonVariant.Primary"
                    IsLoading="_saving"
                    Disabled="_saving || !CanSubmit"
                    OnClick="RegisterAsync">
                Register device
            </Button>
        </div>
    }
</Page>
</div>

@code {
    private readonly List<OrganizationBranchDto> _branches = [];
    private IReadOnlyList<SelectOption> _branchOptions = [];
    private string? _branchIdText;
    private string _deviceLabel = "This device";
    private string _platformLabel = "Unknown";
    private string? _model;
    private string? _friendlyName;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool CanSubmit =>
        Guid.TryParse(_branchIdText, out _)
        && !string.IsNullOrWhiteSpace(_friendlyName);

    protected override void OnInitialized()
    {
        (_deviceLabel, _platformLabel, _model) = ResolveDeviceInfo();
        _friendlyName = _deviceLabel;
    }

    protected override async Task OnInitializedAsync()
    {
        var orgId = CurrentUser.Session?.OrganizationId;
        if (orgId is null)
        {
            Nav.NavigateTo("/organization-select", replace: true);
            return;
        }

        var result = await Platform.GetBranchesAsync(orgId.Value);
        if (!result.IsSuccess || result.Data is null)
        {
            _error = "Branches could not be loaded. Reconnect and try again.";
        }
        else
        {
            _branches.AddRange(result.Data.Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase)));
            _branchOptions = _branches
                .Select(b => new SelectOption(b.Id.ToString("D"), b.Name))
                .ToList();
            var selected = _branches.FirstOrDefault(x => x.IsPrimary) ?? _branches.FirstOrDefault();
            _branchIdText = selected?.Id.ToString("D");
        }

        _loading = false;
    }

    private Task OnBranchChanged(string? value)
    {
        _branchIdText = value;
        return Task.CompletedTask;
    }

    private Task OnFriendlyNameChanged(string? value)
    {
        _friendlyName = value;
        return Task.CompletedTask;
    }

    private async Task ScanRegistrationCodeAsync()
    {
        var session = CurrentUser.Session;
        if (session?.OrganizationId is not Guid orgId
            || !Guid.TryParse(_branchIdText, out var branchId)
            || branchId == Guid.Empty)
        {
            _error = "Select an active branch.";
            return;
        }

        var name = _friendlyName?.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "Enter a device name.";
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var scan = await QrScan.CaptureAsync();
            if (!scan.Succeeded)
            {
                if (!string.IsNullOrWhiteSpace(scan.ErrorKey)
                    && !string.Equals(scan.ErrorKey, "Personal_ScanCancelled", StringComparison.Ordinal))
                {
                    _error = L[scan.ErrorKey];
                }

                return;
            }

            if (!ExItsQrPurposeGuard.TryValidateOrRoute(
                    scan.Payload,
                    ExItsQrPurposeGuard.PosDeviceRegistration,
                    out _,
                    out var mismatch))
            {
                _error = mismatch ?? L["Device_QrPurposeMismatch"];
                return;
            }

            // Confirm purpose with Platform (rejects Personal/Organization envelopes).
            var resolved = await Platform.ResolveQrAsync(new ResolveExItsQrRequest(
                scan.Payload!,
                ExItsQrPurposeGuard.PosDeviceRegistration));
            if (!resolved.IsSuccess || resolved.Data is null)
            {
                var code = resolved.Error?.ErrorCode ?? string.Empty;
                var detail = resolved.Error?.Detail ?? string.Empty;
                _error = code.Contains("purpose.mismatch", StringComparison.OrdinalIgnoreCase)
                         || detail.Contains("qr_purpose_mismatch", StringComparison.OrdinalIgnoreCase)
                    ? L["Device_QrPurposeMismatch"]
                    : (string.IsNullOrWhiteSpace(detail) ? L["Device_RegistrationRedeemFailed"] : detail);
                return;
            }

            var token = resolved.Data.RegistrationToken ?? scan.Payload!;
            var installationId = await DeviceIdentity.GetOrCreateDeviceIdAsync();
            var redeem = await Platform.RedeemPosDeviceRegistrationTokenAsync(
                orgId,
                new RedeemPosDeviceRegistrationTokenRequest(
                    token,
                    branchId,
                    installationId,
                    name,
                    Platform: _platformLabel,
                    Model: _model ?? _deviceLabel,
                    AppVersion: AppInfo.Version));
            if (!redeem.IsSuccess || redeem.Data is null)
            {
                _error = string.IsNullOrWhiteSpace(redeem.Error?.Detail)
                    ? L["Device_RegistrationRedeemFailed"]
                    : redeem.Error!.Detail;
                return;
            }

            await PersistDeviceAndContinueAsync(session, redeem.Data);
        }
        catch (Exception ex)
        {
            _error = string.IsNullOrWhiteSpace(ex.Message)
                ? L["Device_RegistrationRedeemFailed"]
                : ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RegisterAsync()
    {
        var session = CurrentUser.Session;
        if (session?.OrganizationId is not Guid orgId
            || !Guid.TryParse(_branchIdText, out var branchId)
            || branchId == Guid.Empty)
        {
            _error = "Select an active branch.";
            return;
        }

        var name = _friendlyName?.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "Enter a device name.";
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var installationId = await DeviceIdentity.GetOrCreateDeviceIdAsync();
            var result = await Platform.RegisterCurrentDeviceAsync(
                orgId,
                new RegisterPosDeviceRequest(
                    branchId,
                    installationId,
                    name,
                    Platform: _platformLabel,
                    Model: _model ?? _deviceLabel,
                    AppVersion: AppInfo.Version));
            if (!result.IsSuccess || result.Data is null)
            {
                _error = string.IsNullOrWhiteSpace(result.Error?.Detail)
                    ? "The device could not be registered. Check the plan capacity and try again."
                    : result.Error!.Detail;
                return;
            }

            await PersistDeviceAndContinueAsync(session, result.Data);
        }
        catch (Exception ex)
        {
            _error = string.IsNullOrWhiteSpace(ex.Message)
                ? "The device could not be registered. Try again."
                : ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PersistDeviceAndContinueAsync(AuthSession session, PosDeviceDto device)
    {
        var updated = session with { BranchId = device.BranchId, PosDeviceId = device.Id };
        var (_, marker) = await SessionStore.LoadAsync();
        await SessionStore.SaveAsync(updated, marker ?? Guid.NewGuid().ToString("N"));
        CurrentUser.Set(updated);
        await Auth.EnsureOfflineOperateGrantAsync();

        var next = await Gate.ResolveStartRouteAsync();
        if (string.Equals(next, "/devices/register", StringComparison.OrdinalIgnoreCase)
            && CurrentUser.Session?.PosDeviceId is not null)
        {
            next = "/";
        }

        Nav.NavigateTo(next, replace: true);
    }

    private static (string DeviceLabel, string PlatformLabel, string? Model) ResolveDeviceInfo()
    {
        try
        {
            var info = DeviceInfo.Current;
            var manufacturer = info.Manufacturer?.Trim();
            var model = info.Model?.Trim();
            var name = info.Name?.Trim();

            string label;
            if (IsUsableLabel(name))
            {
                label = name!;
            }
            else if (IsUsableLabel(manufacturer) && IsUsableLabel(model))
            {
                label = $"{ToTitleCase(manufacturer!)} {model}";
            }
            else if (IsUsableLabel(model))
            {
                label = model!;
            }
            else
            {
                label = "This device";
            }

            var platform = info.Platform == DevicePlatform.Unknown
                ? FallbackPlatform()
                : info.Platform.ToString();

            return (label, platform, model ?? label);
        }
        catch
        {
            return ("This device", FallbackPlatform(), null);
        }
    }

    private static string FallbackPlatform() =>
        OperatingSystem.IsAndroid() ? "Android"
        : OperatingSystem.IsIOS() ? "iOS"
        : OperatingSystem.IsWindows() ? "Windows"
        : "MAUI";

    private static bool IsUsableLabel(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && !string.Equals(value, "localhost", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(value, "unknown", StringComparison.OrdinalIgnoreCase)
        && !value.Contains("emulator", StringComparison.OrdinalIgnoreCase);

    private static string ToTitleCase(string value) =>
        value.Length == 0
            ? value
            : char.ToUpperInvariant(value[0]) + value[1..].ToLowerInvariant();
}

@page "/welcome"
@layout Layout.AuthShell
@inject IOnboardingPreferenceStore Prefs
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-welcome">
<Page>
    <header class="pos-welcome__header">
        <h1 class="pos-welcome__title">@L["Welcome_Title"]</h1>
        <p class="pos-welcome__subtitle">@L["Welcome_Subtitle"]</p>
    </header>
    <Alert Tone="AlertTone.Info" Title="@L["Welcome_NoticeTitle"]" Message="@L["Welcome_NoticeMessage"]" />
    <FormActions>
        <Button OnClick="ContinueAsync">@L["Welcome_Continue"]</Button>
    </FormActions>
</Page>
</div>

@code {
    private async Task ContinueAsync()
    {
        await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.Language));
        Nav.NavigateTo("/onboarding/language");
    }
}

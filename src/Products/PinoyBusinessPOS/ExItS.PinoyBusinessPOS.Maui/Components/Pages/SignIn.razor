@page "/signin"
@layout Layout.AuthShell
@using ExItS.DesignSystem.Components.Primitives
@using ExItS.PinoyBusinessPOS.Application.Options
@using ExItS.PinoyBusinessPOS.Application.Platform
@using Microsoft.Extensions.Options
@inject IAuthenticationService Auth
@inject IProductAccessResolver Access
@inject IOnboardingPreferenceStore Prefs
@inject IPlatformAccessClient Platform
@inject IOptions<LocalValidationClientOptions> LocalValidationOptions
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["SignIn_Title"]" Subtitle="@L["SignIn_Subtitle"]" />

    <FormValidationSummary Messages="_errors" />

    @if (_quickLoginAvailable)
    {
        <div class="pos-quick-login">
            <FormGroup Title="@L["SignIn_QuickLoginTitle"]">
                <Select Label="@L["SignIn_QuickLoginLabel"]"
                        Hint="@(_quickLoginHint ?? L["SignIn_QuickLoginHint"].Value)"
                        Value="@_selectedQuickKey"
                        ValueChanged="OnQuickLoginSelectedAsync"
                        Options="_quickLoginOptions"
                        Disabled="_busy || _quickLoginLoading || _quickLoginOptions.Count == 0" />
            </FormGroup>
        </div>
    }

    <FormGroup Title="@L["SignIn_PasswordFormTitle"]">
        <TextInput Label="@L["SignIn_UsernameLabel"]"
                   Hint="@L["SignIn_UsernameHint"]"
                   @bind-Value="_username"
                   IsInvalid="@_invalid"
                   Disabled="_busy" />
        <TextInput Label="@L["SignIn_PasswordLabel"]"
                   Hint="@L["SignIn_PasswordHint"]"
                   @bind-Value="_password"
                   Type="password"
                   IsInvalid="@_invalid"
                   ErrorText="@(_invalid ? L["Auth_InvalidCredentials"].Value : null)"
                   Disabled="_busy" />
    </FormGroup>
    <FormActions>
        <Button IsLoading="_busy" Disabled="_busy" OnClick="SignInPasswordAsync">@L["SignIn_Submit"]</Button>
        <Button Variant="ButtonVariant.Ghost" Disabled="_busy" OnClick="GoRegister">@L["Register_Title"]</Button>
    </FormActions>
</Page>

@code {
    private string? _username;
    private string? _password;
    private bool _busy;
    private bool _invalid;
    private List<string> _errors = [];

    private bool _quickLoginAvailable;
    private bool _quickLoginLoading;
    private string? _selectedQuickKey;
    private string? _quickLoginHint;
    private List<SelectOption> _quickLoginOptions = [];
    private Dictionary<string, LocalValidationQuickLoginIdentityDto> _quickLoginByKey = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        var options = LocalValidationOptions.Value;
        _quickLoginAvailable = Auth.IsDevelopmentAuthenticationEnabled && options.IsQuickLoginAvailable;
        if (!_quickLoginAvailable)
        {
            return;
        }

        await LoadQuickLoginIdentitiesAsync();
    }

    private async Task LoadQuickLoginIdentitiesAsync()
    {
        _quickLoginLoading = true;
        _quickLoginHint = null;
        try
        {
            var result = await Platform.GetLocalValidationQuickLoginIdentitiesAsync();
            if (!result.IsSuccess || result.Data is null)
            {
                _quickLoginOptions = [];
                _quickLoginByKey = new(StringComparer.Ordinal);
                _quickLoginHint = L["SignIn_QuickLoginUnavailable"];
                return;
            }

            // One entry per user: Organization when they have an org, otherwise Personal.
            // Exclude Platform administration identities.
            var identities = result.Data
                .Where(i => !string.Equals(i.AccountClass, "Platform", StringComparison.OrdinalIgnoreCase))
                .Where(i => !string.IsNullOrWhiteSpace(i.Key)
                            && (!string.IsNullOrWhiteSpace(i.Email) || !string.IsNullOrWhiteSpace(i.Username)))
                .GroupBy(i => i.UserId)
                .Select(ChoosePreferredIdentity)
                .OrderBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(i => i.Email, StringComparer.OrdinalIgnoreCase)
                .ToList();

            _quickLoginByKey = identities.ToDictionary(i => i.Key, StringComparer.OrdinalIgnoreCase);
            _quickLoginOptions =
            [
                new SelectOption(string.Empty, L["SignIn_QuickLoginPlaceholder"]),
                .. identities.Select(i => new SelectOption(i.Key, FormatQuickLoginLabel(i)))
            ];

            if (identities.Count == 0)
            {
                _quickLoginHint = L["SignIn_QuickLoginUnavailable"];
            }
        }
        finally
        {
            _quickLoginLoading = false;
        }
    }

    private static LocalValidationQuickLoginIdentityDto ChoosePreferredIdentity(
        IGrouping<Guid, LocalValidationQuickLoginIdentityDto> group)
    {
        var org = group
            .Where(i => string.Equals(i.AccountClass, "Organization", StringComparison.OrdinalIgnoreCase))
            .OrderBy(i => i.OrganizationName, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();
        if (org is not null)
        {
            return org;
        }

        return group
            .OrderBy(i => i.AccountClass, StringComparer.OrdinalIgnoreCase)
            .First();
    }

    private static string FormatQuickLoginLabel(LocalValidationQuickLoginIdentityDto identity)
    {
        var name = string.IsNullOrWhiteSpace(identity.DisplayName)
            ? identity.Username
            : identity.DisplayName;
        if (string.Equals(identity.AccountClass, "Organization", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(identity.OrganizationName))
        {
            return $"{name} · {identity.OrganizationName}";
        }

        return name;
    }

    private async Task OnQuickLoginSelectedAsync(string? key)
    {
        _selectedQuickKey = key;
        if (string.IsNullOrWhiteSpace(key) || _busy)
        {
            return;
        }

        if (!_quickLoginByKey.TryGetValue(key, out var identity))
        {
            return;
        }

        var sharedPassword = LocalValidationOptions.Value.SharedPassword;
        var loginId = !string.IsNullOrWhiteSpace(identity.Email)
            ? identity.Email
            : identity.Username;

        _username = loginId;
        _password = sharedPassword;
        // Prefer the listed Org/Personal profile so Platform session matches the Quick Login row.
        Guid? profileId = identity.AccountProfileId == Guid.Empty ? null : identity.AccountProfileId;
        await SignInWithCredentialsAsync(loginId, sharedPassword, accountProfileId: profileId);
    }

    private async Task SignInPasswordAsync()
    {
        await SignInWithCredentialsAsync(_username, _password, accountProfileId: null);
    }

    private async Task SignInWithCredentialsAsync(
        string? username,
        string? password,
        Guid? accountProfileId)
    {
        _errors = [];
        _invalid = false;
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            _invalid = true;
            _errors.Add(L["Auth_InvalidCredentials"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.SignInAsync(new SignInRequest(
                username.Trim(),
                password,
                AccountProfileId: accountProfileId));
            if (!result.Succeeded || result.Session is null)
            {
                _invalid = true;
                _errors.Add(L[result.SafeMessageKey ?? "Auth_InvalidCredentials"]);
                return;
            }

            // POS Owner/Manager/Cashier entry requires a bearer access token (Quick Login SharedPassword).
            if (string.IsNullOrWhiteSpace(result.Session.AccessToken))
            {
                _invalid = true;
                _errors.Add(L["Auth_ApiUnavailable"]);
                return;
            }

            await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.OrganizationSelect));
            await Prefs.SetOnboardingCompletedAsync(true);
            try
            {
                await NavigateAfterSignInAsync(result.Session);
            }
            catch
            {
                Nav.NavigateTo("/personal", replace: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Owners: show org + Personal chooser (no forced bind).
    /// Staff: bind org and enter role UI directly (no Personal option).
    /// Personal-only (0 orgs): Personal home.
    /// </summary>
    private async Task NavigateAfterSignInAsync(AuthSession session)
    {
        var orgs = await Access.ListEligibleOrganizationsAsync(session.UserId);

        if (orgs.Count == 0)
        {
            Nav.NavigateTo("/personal", replace: true);
            return;
        }

        if (OrganizationMembershipRoles.HasOrganizationOwner(orgs))
        {
            // Owner chooses Personal or organization deliberately.
            Nav.NavigateTo("/organization-select", replace: true);
            return;
        }

        // Staff: enter organization/role UI with no Personal chooser.
        var last = await Prefs.GetSelectedOrganizationIdAsync();
        var targetOrgId = last is Guid lastId && orgs.Any(o => o.OrganizationId == lastId)
            ? lastId
            : orgs.Count == 1
                ? orgs[0].OrganizationId
                : (Guid?)null;

        if (targetOrgId is Guid orgId)
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            try
            {
                var selected = await Auth.SelectOrganizationAsync(orgId, cts.Token);
                if (selected.Succeeded)
                {
                    Nav.NavigateTo("/", replace: true);
                    return;
                }
            }
            catch (OperationCanceledException)
            {
                // Fall through to org list (still staff-only, no Personal).
            }
        }

        Nav.NavigateTo("/organization-select", replace: true);
    }

    private void GoRegister() => Nav.NavigateTo("/register");
}

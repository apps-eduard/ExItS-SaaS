@page "/signin"
@layout Layout.AuthShell
@implements IDisposable
@using ExItS.DesignSystem.Components.Primitives
@using ExItS.PinoyBusinessPOS.Application.Options
@using ExItS.PinoyBusinessPOS.Application.Platform
@using Microsoft.Extensions.Options
@inject IAuthenticationService Auth
@inject IProductAccessResolver Access
@inject IOnboardingPreferenceStore Prefs
@inject IPlatformAccessClient Platform
@inject IConnectivityService Connectivity
@inject IOptions<LocalValidationClientOptions> LocalValidationOptions
@inject IOptions<PosApiOptions> PosApi
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject PostSignInReturnRoute ReturnRoute
@inject IStringLocalizer<PosResources> L

<AuthExperience ActiveTab="AuthExperienceTab.SignIn">
    <ChildContent>
        <FormValidationSummary Messages="_errors" />

        @if (_showSlowPrompt)
        {
            <InlineMessage Tone="InlineMessageTone.Info">@L["SignIn_StillConnecting"]</InlineMessage>
            <div class="pos-signin__slow-actions">
                <button type="button" class="pos-signin__link" @onclick="ContinueWaitingAsync">
                    @L["SignIn_ContinueWaiting"]
                </button>
                @if (_canUsePin)
                {
                    <button type="button" class="pos-signin__forgot" @onclick="UsePinInsteadAsync">
                        @L["SignIn_UsePinInstead"]
                    </button>
                }
            </div>
        }

        <div class="pos-signin__form">
            <TextInput Label="@L["SignIn_UsernameLabel"]"
                       @bind-Value="_username"
                       IsInvalid="@_invalid"
                       Disabled="_busy"
                       autocomplete="username" />

            <div class="pos-signin__password">
                <TextInput Label="@L["SignIn_PasswordLabel"]"
                           @bind-Value="_password"
                           Type="@(_showPassword ? "text" : "password")"
                           IsInvalid="@_invalid"
                           ErrorText="@(_invalid ? L["Auth_InvalidCredentials"].Value : null)"
                           Disabled="_busy"
                           autocomplete="current-password" />
                <button type="button"
                        class="pos-signin__password-toggle"
                        disabled="@_busy"
                        aria-label="@(_showPassword ? L["SignIn_HidePassword"].Value : L["SignIn_ShowPassword"].Value)"
                        @onclick="TogglePasswordVisibility">
                    @if (_showPassword)
                    {
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
                            <path d="M3 3l18 18"/>
                            <path d="M10.6 10.6a2 2 0 002.8 2.8"/>
                            <path d="M9.9 5.1A9.8 9.8 0 0112 5c5 0 8.5 3.5 10 7-0.5 1.2-1.3 2.4-2.3 3.4"/>
                            <path d="M6.1 6.1C4.2 7.5 2.8 9.4 2 12c1.5 3.5 5 7 10 7 1.4 0 2.7-.3 3.9-.8"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    }
                </button>
            </div>

            <div class="pos-signin__meta">
                <label class="pos-signin__remember">
                    <input type="checkbox" checked="@_rememberMe" disabled="@_busy" @onchange="OnRememberChanged" />
                    <span>@L["SignIn_RememberMe"]</span>
                </label>
                <div class="pos-signin__meta-links">
                    <button type="button" class="pos-signin__forgot" disabled="@_busy" @onclick="GoForgotPassword">
                        @L["SignIn_ForgotPassword"]
                    </button>
                </div>
            </div>

            <div class="pos-signin__submit">
                <Button IsLoading="_busy" Disabled="_busy" OnClick="SignInPasswordAsync">
                    @L["SignIn_Submit"]
                </Button>
            </div>
        </div>

        <div class="pos-signin__divider" role="separator">
            <span>@L["SignIn_OrDivider"]</span>
        </div>

        <div class="pos-auth-page__social" role="group" aria-label="@L["SignIn_ProvidersLabel"]">
            <button type="button"
                    class="pos-auth-page__social-btn pos-auth-page__social-btn--facebook"
                    disabled="@_busy"
                    aria-label="@L["SignIn_ContinueFacebook"]"
                    @onclick="ContinueWithFacebookPlaceholderAsync">
                <span class="pos-auth-page__social-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
                        <path fill="currentColor" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.79-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/>
                    </svg>
                </span>
                <span class="pos-auth-page__social-text">@L["SignIn_ContinueFacebook"]</span>
            </button>

            <button type="button"
                    class="pos-auth-page__social-btn pos-auth-page__social-btn--google"
                    disabled="@_busy"
                    aria-label="@L["SignIn_ContinueGoogle"]"
                    @onclick="ContinueWithGooglePlaceholderAsync">
                <span class="pos-auth-page__social-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" focusable="false">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                </span>
                <span class="pos-auth-page__social-text">@L["SignIn_ContinueGoogle"]</span>
            </button>

            @if (_canUsePin)
            {
                <button type="button"
                        class="pos-auth-page__social-btn pos-auth-page__social-btn--pin"
                        disabled="@_busy"
                        title="@L["SignIn_WithPin"]"
                        aria-label="@L["SignIn_WithPin"]"
                        @onclick="UsePinInsteadAsync">
                    <span class="pos-auth-page__social-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20" focusable="false" fill="currentColor">
                            <circle cx="6" cy="6" r="1.7"/>
                            <circle cx="12" cy="6" r="1.7"/>
                            <circle cx="18" cy="6" r="1.7"/>
                            <circle cx="6" cy="12" r="1.7"/>
                            <circle cx="12" cy="12" r="1.7"/>
                            <circle cx="18" cy="12" r="1.7"/>
                            <circle cx="6" cy="18" r="1.7"/>
                            <circle cx="12" cy="18" r="1.7"/>
                            <circle cx="18" cy="18" r="1.7"/>
                        </svg>
                    </span>
                    <span class="pos-auth-page__social-text">@L["SignIn_WithPin"]</span>
                </button>
            }
        </div>

        @if (_canUsePin)
        {
            <p class="pos-auth-page__pin-hint">@L["SignIn_PinKeypadHint"]</p>
        }
    </ChildContent>
    <BelowCard>
        @if (_quickLoginAvailable)
        {
            <div class="pos-auth-page__quick">
                <label class="pos-auth-page__quick-label" for="pos-signin-quick-select">
                    @L["SignIn_TestUserTitle"]
                </label>
                @if (!string.IsNullOrWhiteSpace(_quickLoginHint))
                {
                    <p class="pos-auth-page__quick-hint">@_quickLoginHint</p>
                }
                else if (_quickLoginLoading)
                {
                    <p class="pos-auth-page__quick-hint">@L["Common_Loading"]</p>
                }
                <select id="pos-signin-quick-select"
                        class="pos-auth-page__quick-select"
                        disabled="@(_busy || _quickLoginLoading || _quickLoginIdentities.Count == 0)"
                        value="@_selectedQuickLoginKey"
                        @onchange="OnQuickLoginChanged">
                    <option value="">@L["SignIn_QuickLoginPlaceholder"]</option>
                    @foreach (var identity in _quickLoginIdentities)
                    {
                        <option value="@identity.Key">@FormatQuickLoginLabel(identity)</option>
                    }
                </select>
            </div>
        }
    </BelowCard>
</AuthExperience>

@code {
    private readonly OnlineLoginProgressController _progress = new();
    private string? _username;
    private string? _password;
    private bool _busy;
    private bool _invalid;
    private bool _showPassword;
    private bool _rememberMe;
    private bool _isOffline;
    private bool _canUsePin;
    private bool _showSlowPrompt;
    private List<string> _errors = [];

    private bool _quickLoginAvailable;
    private bool _quickLoginLoading;
    private string? _quickLoginHint;
    private string? _selectedQuickLoginKey;
    private List<LocalValidationQuickLoginIdentityDto> _quickLoginIdentities = [];
    private Dictionary<string, LocalValidationQuickLoginIdentityDto> _quickLoginByKey = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged += OnConnectivityChanged;

        _rememberMe = Preferences.Default.Get(PreferenceKeys.RememberMe, false);
        if (_rememberMe)
        {
            _username = Preferences.Default.Get(PreferenceKeys.RememberedUsername, string.Empty);
            if (string.IsNullOrWhiteSpace(_username))
            {
                _username = null;
            }
        }

        await RefreshOfflineStateAsync();

        var options = LocalValidationOptions.Value;
        _quickLoginAvailable = Auth.IsDevelopmentAuthenticationEnabled && options.IsQuickLoginAvailable;
        if (!_quickLoginAvailable)
        {
            return;
        }

        await LoadQuickLoginIdentitiesAsync();
    }

    private async Task RefreshOfflineStateAsync()
    {
        var apiReachableHint = await Connectivity.IsConnectedAsync();
        var noRadio = await Connectivity.HasNoNetworkInterfaceAsync();
        // Debug Local Validation treats NetworkAccess.None as connected for API attempts.
        // PIN offer must still appear when the OS reports no interface (airplane / radios off).
        _isOffline = !apiReachableHint || noRadio;

        var offer = await Auth.EvaluateOfflineColdStartOfferAsync();
        _canUsePin = offer.CanOfferPinUnlock;
    }

    private async void OnConnectivityChanged(object? sender, ConnectivityStatus status)
    {
        await InvokeAsync(async () =>
        {
            await RefreshOfflineStateAsync();
            if (_quickLoginAvailable && _quickLoginIdentities.Count == 0)
            {
                await LoadQuickLoginIdentitiesAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose() => Connectivity.ConnectivityChanged -= OnConnectivityChanged;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private void OnRememberChanged(ChangeEventArgs args)
    {
        _rememberMe = args.Value is bool b
            ? b
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        PersistRememberMe();
    }

    private void PersistRememberMe()
    {
        Preferences.Default.Set(PreferenceKeys.RememberMe, _rememberMe);
        if (_rememberMe && !string.IsNullOrWhiteSpace(_username))
        {
            Preferences.Default.Set(PreferenceKeys.RememberedUsername, _username.Trim());
        }
        else if (!_rememberMe)
        {
            Preferences.Default.Remove(PreferenceKeys.RememberedUsername);
        }
    }

    private async Task LoadQuickLoginIdentitiesAsync()
    {
        _quickLoginLoading = true;
        _quickLoginHint = null;
        try
        {
            var result = await Platform.GetLocalValidationQuickLoginIdentitiesAsync();
            if (!result.IsSuccess || result.Data is null)
            {
                _quickLoginIdentities = [];
                _quickLoginByKey = new(StringComparer.Ordinal);
                _quickLoginHint = L["SignIn_QuickLoginUnavailable"];
                return;
            }

            var identities = result.Data
                .Where(i => !string.Equals(i.AccountClass, "Platform", StringComparison.OrdinalIgnoreCase))
                .Where(i => !string.IsNullOrWhiteSpace(i.Key)
                            && (!string.IsNullOrWhiteSpace(i.Email) || !string.IsNullOrWhiteSpace(i.Username)))
                .GroupBy(i => i.UserId)
                .Select(ChoosePreferredIdentity)
                .OrderBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(i => i.Email, StringComparer.OrdinalIgnoreCase)
                .ToList();

            _quickLoginByKey = identities.ToDictionary(i => i.Key, StringComparer.OrdinalIgnoreCase);
            _quickLoginIdentities = identities;

            if (identities.Count == 0)
            {
                _quickLoginHint = L["SignIn_QuickLoginUnavailable"];
            }
        }
        finally
        {
            _quickLoginLoading = false;
        }
    }

    private static LocalValidationQuickLoginIdentityDto ChoosePreferredIdentity(
        IGrouping<Guid, LocalValidationQuickLoginIdentityDto> group)
    {
        var org = group
            .Where(i => string.Equals(i.AccountClass, "Organization", StringComparison.OrdinalIgnoreCase))
            .OrderBy(i => i.OrganizationName, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();
        if (org is not null)
        {
            return org;
        }

        return group
            .OrderBy(i => i.AccountClass, StringComparer.OrdinalIgnoreCase)
            .First();
    }

    private static string FormatQuickLoginLabel(LocalValidationQuickLoginIdentityDto identity)
    {
        if (!string.IsNullOrWhiteSpace(identity.ListLabel))
        {
            return identity.ListLabel;
        }

        var name = string.IsNullOrWhiteSpace(identity.DisplayName)
            ? identity.Username
            : identity.DisplayName;
        if (string.Equals(identity.AccountClass, "Organization", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(identity.OrganizationName))
        {
            var login = string.IsNullOrWhiteSpace(identity.Email) ? identity.Username : identity.Email;
            return string.IsNullOrWhiteSpace(login)
                ? $"{name} — {identity.OrganizationName}"
                : $"{name} — {identity.OrganizationName} · {login}";
        }

        return name;
    }

    private void OnQuickLoginChanged(ChangeEventArgs args)
    {
        var key = args.Value?.ToString();
        _selectedQuickLoginKey = string.IsNullOrWhiteSpace(key) ? null : key;
        if (!string.IsNullOrWhiteSpace(key))
        {
            OnTestUserSelected(key);
        }
    }

    private void OnTestUserSelected(string? key)
    {
        if (string.IsNullOrWhiteSpace(key) || _busy)
        {
            return;
        }

        if (!_quickLoginByKey.TryGetValue(key, out var identity))
        {
            return;
        }

        // Username convenience only — fills username; user enters password and taps Sign in.
        // Email carries loginDisplay from API (real email or org staff <local>@ORG######).
        var loginId = !string.IsNullOrWhiteSpace(identity.Email)
            ? identity.Email
            : identity.Username;

        _username = loginId;
        _password = null;
        _invalid = false;
        _errors = [];
    }

    /// <summary>
    /// Placeholder only — real Google OAuth is deferred. Isolated for later wiring.
    /// </summary>
    private Task ContinueWithGooglePlaceholderAsync() => ShowProviderPlaceholderAsync();

    /// <summary>
    /// Placeholder only — real Facebook OAuth is deferred. Isolated for later wiring.
    /// </summary>
    private Task ContinueWithFacebookPlaceholderAsync() => ShowProviderPlaceholderAsync();

    private Task ShowProviderPlaceholderAsync()
    {
        _errors = [];
        _invalid = false;
        _errors.Add(_isOffline
            ? L["SignIn_InternetRequired"].Value
            : L["SignIn_ProviderPlaceholder"].Value);
        return Task.CompletedTask;
    }

    private void RecordUnreachableSignInOutcome()
    {
        // Unreachable / timeout — not an access denial. Do not surface this merely because the
        // page loaded offline; only after a real sign-in attempt.
        if (_canUsePin)
        {
            _errors = [L["SignIn_ServerUnreachablePinHint"].Value];
            return;
        }

        _errors = [L["SignIn_OfflineNoPinMessage"].Value];
    }

    private void ContinueWaitingAsync() => _progress.ContinueWaiting();

    private void UsePinInsteadAsync()
    {
        if (!_canUsePin)
        {
            return;
        }

        _progress.ChoosePinInstead();
        Nav.NavigateTo("/offline-pin", replace: true);
    }

    private async Task SignInPasswordAsync()
    {
        await RefreshOfflineStateAsync();
        // Do not hard-block on OS NetworkAccess alone. Local Validation (especially PhysicalDevice
        // / Tailscale) can report None while platform-api is reachable — that falsely shows
        // "Server is unreachable" for password sign-in while an already-open session still works.
        PersistRememberMe();
        await SignInWithCredentialsAsync(_username, _password, accountProfileId: null);
    }

    private async Task SignInWithCredentialsAsync(
        string? username,
        string? password,
        Guid? accountProfileId)
    {
        _errors = [];
        _invalid = false;
        _showSlowPrompt = false;
        await RefreshOfflineStateAsync();

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            _invalid = true;
            _errors.Add(L["SignIn_CredentialsRequired"]);
            return;
        }

        _busy = true;
        try
        {
            var hardSeconds = Math.Clamp(PosApi.Value.TimeoutSeconds, 10, 30);
            _progress.BeginOnlineAttempt(TimeSpan.FromSeconds(hardSeconds));

            var progress = await _progress.RunAsync(
                ct => Auth.SignInAsync(
                    new SignInRequest(username.Trim(), password, AccountProfileId: accountProfileId),
                    ct),
                onSoftPrompt: () =>
                {
                    _showSlowPrompt = true;
                    _ = InvokeAsync(StateHasChanged);
                });

            if (progress.Outcome == OnlineLoginProgressOutcome.PinSelected)
            {
                // Online result discarded — PIN unlock owns the flow.
                return;
            }

            if (progress.Outcome == OnlineLoginProgressOutcome.HardTimedOut)
            {
                _showSlowPrompt = false;
                await RefreshOfflineStateAsync();
                RecordUnreachableSignInOutcome();
                return;
            }

            if (progress.Outcome != OnlineLoginProgressOutcome.Completed || progress.Value is null)
            {
                return;
            }

            var result = progress.Value;
            if (!result.Succeeded || result.Session is null)
            {
                _showSlowPrompt = false;
                // Explicit denial / invalid credentials — do not treat as offline PIN fallback.
                // Cancelled usually means the hard-timeout CTS fired and the API client swallowed
                // it as Cancelled (not a user-initiated cancel on this screen).
                if (result.FailureReason is AuthFailureReason.Offline
                    or AuthFailureReason.Timeout
                    or AuthFailureReason.ApiUnavailable
                    or AuthFailureReason.Cancelled)
                {
                    await RefreshOfflineStateAsync();
                    RecordUnreachableSignInOutcome();
                    return;
                }

                _invalid = result.FailureReason is AuthFailureReason.InvalidCredentials;
                _errors.Add(L[result.SafeMessageKey ?? "Auth_InvalidCredentials"]);
                return;
            }

            if (_rememberMe)
            {
                Preferences.Default.Set(PreferenceKeys.RememberedUsername, username.Trim());
            }

            await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.OrganizationSelect));
            await Prefs.SetOnboardingCompletedAsync(true);
            try
            {
                await NavigateAfterSignInAsync(result.Session);
            }
            catch
            {
                Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            }
        }
        finally
        {
            _busy = false;
            _showSlowPrompt = false;
            _progress.CancelOnlineAttempt();
        }
    }

    private async Task NavigateAfterSignInAsync(AuthSession session)
    {
        var pending = ReturnRoute.Take();

        // Do not call the post-boot start-route resolver here — it re-runs session restore
        // (introspect + org context + grants) and eligible-org listing while the login spinner
        // is still up. That repeats GET /auth/organizations (memberships + org) and looks like
        // a request loop.
        if (await RequiresOfflinePinEnrollmentAsync(session).ConfigureAwait(false))
        {
            const string pinSetup = "/offline-pin-setup";
            Nav.NavigateTo(
                NavigationGate.IsOfflinePinSetupRoute(pinSetup)
                    ? AppendReturnRoute(pinSetup, pending)
                    : pinSetup,
                replace: true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(pending))
        {
            Nav.NavigateTo(pending, replace: true);
            return;
        }

        var orgs = await Access.ListEligibleOrganizationsAsync(session.UserId);

        // No org membership → Personal workspace (PIN enrollment already handled above).
        if (orgs.Count == 0)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        // One or more memberships → organization-select. Single-org auto-enter happens there
        // once; the eligible-org list is cached so this page and org-select share one HTTP call.
        Nav.NavigateTo("/organization-select", replace: true);
    }

    private async Task<bool> RequiresOfflinePinEnrollmentAsync(AuthSession session)
    {
        var canEnroll = session.HasPosAccess
                        || AuthSessionWorkspace.IsPersonalDefault(session)
                        || session.OrganizationId is null;
        if (!canEnroll)
        {
            return false;
        }

        if (session.HasPosAccess && (session.PosDeviceId is null || session.BranchId is null))
        {
            return false;
        }

        var readiness = await Auth.EvaluateCurrentUserOfflinePinReadinessAsync();
        return readiness.RequiresPinEnrollment && !readiness.CanOfferPinUnlock;
    }

    private static string AppendReturnRoute(string setupRoute, string? pending)
    {
        if (string.IsNullOrWhiteSpace(pending) || !PostSignInReturnRoute.IsSafeInternalRoute(pending))
        {
            return setupRoute;
        }

        var separator = setupRoute.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return $"{setupRoute}{separator}return={Uri.EscapeDataString(pending)}";
    }

    private void GoForgotPassword()
    {
        Nav.NavigateTo("/forgot-password");
    }
}

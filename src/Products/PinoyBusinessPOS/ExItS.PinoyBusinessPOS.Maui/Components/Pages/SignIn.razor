@page "/signin"
@layout Layout.AuthShell
@inject IAuthenticationService Auth
@inject IProductAccessResolver Access
@inject IOnboardingPreferenceStore Prefs
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["SignIn_Title"]" Subtitle="@L["SignIn_Subtitle"]" />

    <FormValidationSummary Messages="_errors" />
    <FormGroup Title="@L["SignIn_PasswordFormTitle"]">
        <TextInput Label="@L["SignIn_UsernameLabel"]"
                   Hint="@L["SignIn_UsernameHint"]"
                   @bind-Value="_username"
                   IsInvalid="@_invalid"
                   Disabled="_busy" />
        <TextInput Label="@L["SignIn_PasswordLabel"]"
                   Hint="@L["SignIn_PasswordHint"]"
                   @bind-Value="_password"
                   Type="password"
                   IsInvalid="@_invalid"
                   ErrorText="@(_invalid ? L["Auth_InvalidCredentials"].Value : null)"
                   Disabled="_busy" />
    </FormGroup>
    <FormActions>
        <Button IsLoading="_busy" Disabled="_busy" OnClick="SignInPasswordAsync">@L["SignIn_Submit"]</Button>
        <Button Variant="ButtonVariant.Ghost" Disabled="_busy" OnClick="GoRegister">@L["Register_Title"]</Button>
    </FormActions>

    @if (Auth.IsDevelopmentAuthenticationEnabled)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["SignIn_DevTitle"]" Message="@L["SignIn_DevMessage"]" />
        <FormGroup Title="@L["SignIn_FormTitle"]">
            <TextInput Label="@L["SignIn_UserIdLabel"]"
                       Hint="@L["SignIn_UserIdHint"]"
                       @bind-Value="_userIdText"
                       Disabled="_busy" />
        </FormGroup>
        <FormActions>
            <Button IsLoading="_busy" Disabled="_busy" OnClick="SignInDevAsync" Variant="ButtonVariant.Secondary">@L["SignIn_DevSubmit"]</Button>
        </FormActions>
    }
</Page>

@code {
    private string? _username;
    private string? _password;
    private string? _userIdText;
    private bool _busy;
    private bool _invalid;
    private List<string> _errors = [];

    private async Task SignInPasswordAsync()
    {
        _errors = [];
        _invalid = false;
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            _invalid = true;
            _errors.Add(L["Auth_InvalidCredentials"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.SignInAsync(new SignInRequest(_username.Trim(), _password));
            if (!result.Succeeded || result.Session is null)
            {
                _invalid = true;
                _errors.Add(L[result.SafeMessageKey ?? "Auth_InvalidCredentials"]);
                return;
            }

            await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.OrganizationSelect));
            await Prefs.SetOnboardingCompletedAsync(true);
            try
            {
                await NavigateAfterSignInAsync(result.Session);
            }
            catch
            {
                Nav.NavigateTo("/personal", replace: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignInDevAsync()
    {
        _errors = [];
        _invalid = false;
        if (!Guid.TryParse(_userIdText?.Trim(), out var userId))
        {
            _invalid = true;
            _errors.Add(L["Auth_InvalidCredentials"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.SignInAsync(new SignInRequest(null, null, userId));
            if (!result.Succeeded || result.Session is null)
            {
                _invalid = true;
                _errors.Add(L[result.SafeMessageKey ?? "Auth_InvalidCredentials"]);
                return;
            }

            await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.OrganizationSelect));
            await Prefs.SetOnboardingCompletedAsync(true);
            try
            {
                await NavigateAfterSignInAsync(result.Session);
            }
            catch
            {
                Nav.NavigateTo("/personal", replace: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Preferred post-login routing: restore last valid org when safe; otherwise Personal (0),
    /// auto-bind single org, or multi-org chooser. Never blocks with Personal-vs-Org every time.
    /// </summary>
    private async Task NavigateAfterSignInAsync(AuthSession session)
    {
        var orgs = await Access.ListEligibleOrganizationsAsync(session.UserId);
        var last = await Prefs.GetSelectedOrganizationIdAsync();

        if (last is Guid lastId && orgs.Any(o => o.OrganizationId == lastId))
        {
            var restored = await Auth.SelectOrganizationAsync(lastId);
            if (restored.Succeeded)
            {
                Nav.NavigateTo("/", replace: true);
                return;
            }
        }

        if (orgs.Count == 0)
        {
            Nav.NavigateTo("/personal", replace: true);
            return;
        }

        if (orgs.Count == 1)
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            try
            {
                var selected = await Auth.SelectOrganizationAsync(orgs[0].OrganizationId, cts.Token);
                if (selected.Succeeded)
                {
                    Nav.NavigateTo("/", replace: true);
                    return;
                }
            }
            catch (OperationCanceledException)
            {
                // Fall through to organization chooser rather than leaving Sign in stuck Loading.
            }
        }

        Nav.NavigateTo("/organization-select", replace: true);
    }

    private void GoRegister() => Nav.NavigateTo("/register");
}

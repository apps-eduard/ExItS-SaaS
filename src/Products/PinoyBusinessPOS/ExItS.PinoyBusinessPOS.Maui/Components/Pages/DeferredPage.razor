@page "/more"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@FeatureName" Subtitle="@L["Deferred_Title"]" />

    @if (IsMore)
    {
        <Section Title="@L["Overdue_Title"]">
            <Stack Gap="3">
                <div class="pos-muted">@L["Overdue_Subtitle"]</div>
                <Button Variant="ButtonVariant.Primary" OnClick="GoOverdue">@L["Overdue_OpenOrg"]</Button>
            </Stack>
        </Section>
        <Section Title="@L["Inventory_Title"]">
            <Stack Gap="3">
                <div class="pos-muted">@L["Inventory_Subtitle"]</div>
                <Button Variant="ButtonVariant.Primary" OnClick="GoInventory">@L["Nav_Inventory"]</Button>
            </Stack>
        </Section>
        <Section Title="@L["Expenses_Title"]">
            <Stack Gap="3">
                <div class="pos-muted">@L["Expenses_Subtitle"]</div>
                <Button Variant="ButtonVariant.Primary" OnClick="GoExpenses">@L["Nav_Expenses"]</Button>
            </Stack>
        </Section>
        <Section Title="@L["Suppliers_Title"]">
            <Stack Gap="3">
                <div class="pos-muted">@L["Suppliers_Subtitle"]</div>
                <Button Variant="ButtonVariant.Primary" OnClick="GoSuppliers">@L["Nav_Suppliers"]</Button>
            </Stack>
        </Section>
        <Section Title="@L["Purchasing_Title"]">
            <Stack Gap="3">
                <div class="pos-muted">@L["Purchasing_Subtitle"]</div>
                <Button Variant="ButtonVariant.Primary" OnClick="GoPurchasing">@L["Nav_Purchasing"]</Button>
            </Stack>
        </Section>
        <Section Title="@L["Dashboard_Title"]">
            <Stack Gap="3">
                <div class="pos-muted">@L["Dashboard_Subtitle"]</div>
                <Button Variant="ButtonVariant.Primary" OnClick="GoDashboard">@L["Nav_Dashboard"]</Button>
            </Stack>
        </Section>
        <Section Title="@L["Reports_Title"]">
            <Stack Gap="3">
                <div class="pos-muted">@L["Reports_Subtitle"]</div>
                <Button Variant="ButtonVariant.Primary" OnClick="GoReports">@L["Nav_Reports"]</Button>
            </Stack>
        </Section>
    }

    <EmptyState IconName="@IconName" Title="@L["Deferred_Title"]" Message="@string.Format(L["Deferred_Message"], FeatureName)">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoHome">@L["Deferred_BackToHome"]</Button>
        </Actions>
    </EmptyState>
</Page>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
    }

    private string RelativePath => Nav.ToBaseRelativePath(Nav.Uri).Trim('/');

    private bool IsMore => string.Equals(RelativePath, "more", StringComparison.OrdinalIgnoreCase);

    private string FeatureName => RelativePath switch
    {
        "more" => L["Nav_More"],
        _ => string.Empty,
    };

    private string IconName => RelativePath switch
    {
        "more" => "more",
        _ => "inbox",
    };

    private void GoHome() => Nav.NavigateTo("/home");
    private void GoOverdue() => Nav.NavigateTo("/overdue");
    private void GoInventory() => Nav.NavigateTo("/inventory");
    private void GoExpenses() => Nav.NavigateTo("/expenses");
    private void GoSuppliers() => Nav.NavigateTo("/suppliers");
    private void GoPurchasing() => Nav.NavigateTo("/purchasing");
    private void GoDashboard() => Nav.NavigateTo("/dashboard");
    private void GoReports() => Nav.NavigateTo("/reports");
}

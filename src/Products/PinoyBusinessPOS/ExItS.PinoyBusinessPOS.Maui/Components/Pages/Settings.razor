@page "/settings"
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject PosStatusState Status
@inject IAppInfoService AppInfo
@inject IOptions<PosApiOptions> ApiOptions
@inject ApiStatusLocalizer ApiLocalizer
@inject ICurrentUserContext CurrentUser
@inject IAuthenticationService Auth
@inject NavigationGate Gate
@inject NavigationManager Nav
@inject OnlineRequiredGuard OnlineRequired
@inject IUtangCapabilityEvaluator Capabilities
@inject ISupportDiagnosticsService SupportDiagnostics
@inject IStringLocalizer<PosResources> L
@using ExItS.PinoyBusinessPOS.Application.Support

<div class="pos-dash pos-settings">
    <Page>
        <header class="pos-settings__header">
            <h1 class="pos-settings__title">@L["Settings_Title"]</h1>
            <p class="pos-settings__subtitle">@L["Settings_Subtitle"]</p>
        </header>

        <div class="pos-settings__notice" role="note">
            <span class="pos-settings__notice-title">@L["Settings_DevNoticeTitle"]</span>
            <span class="pos-settings__notice-body">@L["Settings_DevNoticeMessage"]</span>
        </div>

        @if (CurrentUser.Session is not null)
        {
            <Section Title="@L["Settings_SessionSectionTitle"]">
                <div class="pos-settings__panel">
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["AccessConfirm_UserLabel"]</span>
                        <span class="pos-settings__kv-value">@CurrentUser.Session.DisplayName</span>
                    </div>
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["AccessConfirm_OrgLabel"]</span>
                        <span class="pos-settings__kv-value">@CurrentUser.Session.OrganizationDisplayName</span>
                    </div>
                    @if (CurrentUser.Session?.OrganizationContextLocked != true)
                    {
                        <button type="button" class="pos-settings__nav" @onclick="GoSwitchOrg">
                            <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                            <span class="pos-settings__nav-label">@L["Settings_SwitchOrganization"]</span>
                            <span class="pos-settings__chevron" aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            </Section>

            @if (CurrentUser.HasPosAccess)
            {
                <Section Title="@L["Offline_PinSetupTitle"]">
                    <div class="pos-settings__panel">
                        <p class="pos-muted">@L["Offline_PinSetupHint"]</p>
                        @if (_pinConfigured)
                        {
                            <p class="pos-muted">@L["Offline_PinSetupSaved"]</p>
                        }
                        <input type="password"
                               inputmode="numeric"
                               maxlength="12"
                               class="pos-offline-pin__input"
                               disabled="@_pinBusy"
                               @bind="_offlinePin"
                               @bind:event="oninput"
                               aria-label="@L["Offline_PinLabel"]" />
                        <div class="pos-settings__actions">
                            <Button Variant="ButtonVariant.Secondary"
                                    IsLoading="_pinBusy"
                                    Disabled="_pinBusy"
                                    OnClick="SaveOfflinePinAsync">
                                @L["Offline_PinSetupSave"]
                            </Button>
                        </div>
                        @if (!string.IsNullOrEmpty(_pinMessage))
                        {
                            <Alert Tone="@(_pinSucceeded ? AlertTone.Success : AlertTone.Danger)" Message="@_pinMessage" />
                        }
                    </div>
                </Section>
            }
        }

        @if (_preferenceError is not null)
        {
            <Alert Tone="AlertTone.Danger" Message="@_preferenceError" />
        }

        <Section Title="@L["Settings_AppearanceSectionTitle"]">
            <div class="pos-settings__panel">
                <Stack Gap="2">
                    <Select Label="@L["Settings_ThemeLabel"]" Value="@ThemeCtl.Current.ToString()" ValueChanged="OnThemeChangedAsync" Options="ThemeOptions" />
                    <Select Label="@L["Settings_DensityLabel"]" Value="@DensityCtl.Current.ToString()" ValueChanged="OnDensityChangedAsync" Options="DensityOptions" />
                    <Select Label="@L["Settings_LanguageLabel"]" Value="@CultureCtl.Current" ValueChanged="OnCultureChangedAsync" Options="CultureOptions" />
                </Stack>
            </div>
        </Section>

        <Section Title="@L["Settings_ApiSectionTitle"]">
            <div class="pos-settings__panel">
                <div class="pos-settings__kv">
                    <span class="pos-settings__kv-label">@L["Settings_ApiHostLabel"]</span>
                    <span class="pos-settings__kv-value">@ApiHost</span>
                </div>
                <div class="pos-settings__kv">
                    <span class="pos-settings__kv-label">@L["Api_Environment"]</span>
                    <Badge Tone="@(IsDevelopment ? BadgeTone.Warning : BadgeTone.Neutral)">@EnvironmentLabel</Badge>
                </div>
                <div class="pos-settings__actions">
                    <Button Variant="ButtonVariant.Secondary" IsLoading="Status.IsCheckingApi" OnClick="TestConnectionAsync">
                        @L["Api_TestConnection"]
                    </Button>
                </div>
                @if (_testResultMessage is not null)
                {
                    <Alert Tone="@(_testSucceeded ? AlertTone.Success : AlertTone.Danger)" Message="@_testResultMessage" />
                }
            </div>
        </Section>

        @if (Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup))
        {
            <Section Title="@L["Setup_Title"]">
                <button type="button" class="pos-settings__nav pos-settings__nav--block" @onclick="GoSetup">
                    <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                    <span class="pos-settings__nav-body">
                        <span class="pos-settings__nav-label">@L["Nav_Setup"]</span>
                        <span class="pos-settings__nav-meta">@L["Setup_Subtitle"]</span>
                    </span>
                    <span class="pos-settings__chevron" aria-hidden="true">›</span>
                </button>
            </Section>
        }

        @if (_canViewSupportDiagnostics)
        {
            <Section Title="@L["Support_SectionTitle"]">
                <button type="button" class="pos-settings__nav pos-settings__nav--block" @onclick="GoSupportDiagnostics">
                    <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
                    <span class="pos-settings__nav-body">
                        <span class="pos-settings__nav-label">@L["Support_DiagnosticsLink"]</span>
                        <span class="pos-settings__nav-meta">@L["Support_DiagnosticsLinkHint"]</span>
                    </span>
                    <span class="pos-settings__chevron" aria-hidden="true">›</span>
                </button>
            </Section>
        }

        <Section Title="@L["Settings_AboutSectionTitle"]">
            <div class="pos-settings__panel">
                <div class="pos-settings__kv">
                    <span class="pos-settings__kv-label">@L["Settings_AppVersionLabel"]</span>
                    <span class="pos-settings__kv-value">@AppInfo.Version</span>
                </div>
                <div class="pos-settings__kv">
                    <span class="pos-settings__kv-label">@L["Home_EnvironmentLabel"]</span>
                    <span class="pos-settings__kv-value">@EnvironmentLabel</span>
                </div>
                @if (IsDevOrTesting)
                {
                    <button type="button" class="pos-settings__nav" @onclick="GoDevOffline">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                        <span class="pos-settings__nav-label">@L["Settings_DevOfflineLink"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                }
            </div>
        </Section>
    </Page>
</div>

@code {
    private bool _testSucceeded;
    private string? _testResultMessage;
    private string? _preferenceError;
    private string _offlinePin = string.Empty;
    private bool _pinBusy;
    private bool _pinConfigured;
    private bool _pinSucceeded;
    private string? _pinMessage;
    private bool _canViewSupportDiagnostics;

    private IReadOnlyList<SelectOption> ThemeOptions =>
    [
        new(nameof(ThemePreference.System), L["Settings_Theme_System"]),
        new(nameof(ThemePreference.Light), L["Settings_Theme_Light"]),
        new(nameof(ThemePreference.Dark), L["Settings_Theme_Dark"]),
    ];

    private IReadOnlyList<SelectOption> DensityOptions =>
    [
        new(nameof(DensityMode.Compact), L["Settings_Density_Compact"]),
        new(nameof(DensityMode.Comfortable), L["Settings_Density_Comfortable"]),
    ];

    private IReadOnlyList<SelectOption> CultureOptions =>
    [
        new(MauiCulturePreferenceStore.English, L["Settings_Language_English"]),
        new(MauiCulturePreferenceStore.Filipino, L["Settings_Language_Filipino"]),
    ];

    private bool IsDevelopment => string.Equals(AppInfo.EnvironmentName, "Development", StringComparison.OrdinalIgnoreCase);

    private bool IsDevOrTesting =>
        IsDevelopment
        || string.Equals(AppInfo.EnvironmentName, "Testing", StringComparison.OrdinalIgnoreCase);

    private string EnvironmentLabel => IsDevelopment ? L["Env_Development"] : L["Env_Production"];

    private string ApiHost
    {
        get
        {
            var baseUrl = ApiOptions.Value.BaseUrl;
            return Uri.TryCreate(baseUrl, UriKind.Absolute, out var uri) ? uri.Authority : baseUrl;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Status.Changed += OnChangedAsync;
        if (!Gate.CanEnterProtectedShell)
        {
            // Personal sessions use Personal settings, not the POS protected shell.
            if (CurrentUser.IsAuthenticated && CurrentUser.Session?.OrganizationId is null)
            {
                Nav.NavigateTo("/personal/settings", replace: true);
                return;
            }

            // Org membership without POS operate access (Org essentials): allow appearance /
            // session settings — do not bounce back to /org.
            if (CurrentUser.IsAuthenticated && CurrentUser.Session?.OrganizationId is not null)
            {
                // Stay on /settings.
            }
            else
            {
                var route = await Gate.ResolveStartRouteAsync();
                if (!string.Equals(route, "/settings", StringComparison.OrdinalIgnoreCase))
                {
                    Nav.NavigateTo(route, replace: true);
                    return;
                }
            }
        }

        _pinConfigured = await Auth.HasOfflinePinConfiguredAsync();
        _canViewSupportDiagnostics = await SupportDiagnostics.EvaluateAccessForCurrentSessionAsync()
            == SupportDiagnosticsAccessKind.Allowed;
    }

    private void GoSupportDiagnostics() => Nav.NavigateTo("/settings/support/diagnostics");

    private async Task SaveOfflinePinAsync()
    {
        if (_pinBusy)
        {
            return;
        }

        _pinBusy = true;
        _pinMessage = null;
        try
        {
            var result = await Auth.SetOfflinePinAsync(_offlinePin);
            _pinSucceeded = result.Succeeded;
            _pinMessage = result.Succeeded
                ? L["Offline_PinSetupSaved"]
                : L[result.SafeMessageKey ?? "Offline_PinInvalidFormat"];
            if (result.Succeeded)
            {
                _pinConfigured = true;
                _offlinePin = string.Empty;
            }
        }
        finally
        {
            _pinBusy = false;
        }
    }

    private async Task GoSwitchOrg()
    {
        var orgName = CurrentUser.Session?.OrganizationDisplayName;
        if (!await OnlineRequired.EnsureOnlineForActionAsync(
                PosOfflineActionKeys.SwitchOrganization,
                orgName))
        {
            return;
        }

        Nav.NavigateTo("/organization-select");
    }

    private void GoDevOffline() => Nav.NavigateTo("/dev/offline-foundation");

    private void GoSetup() => Nav.NavigateTo("/setup");

    private async Task OnThemeChangedAsync(string? value)
    {
        _preferenceError = null;
        if (Enum.TryParse<ThemePreference>(value, out var preference))
        {
            if (!await ThemeCtl.SetThemeAsync(preference))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task OnDensityChangedAsync(string? value)
    {
        _preferenceError = null;
        if (Enum.TryParse<DensityMode>(value, out var density))
        {
            if (!await DensityCtl.SetDensityAsync(density))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task OnCultureChangedAsync(string? value)
    {
        _preferenceError = null;
        if (!string.IsNullOrEmpty(value))
        {
            if (!await CultureCtl.SetCultureAsync(value))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task TestConnectionAsync()
    {
        _testResultMessage = null;
        await Status.RefreshApiHealthAsync();
        _testSucceeded = Status.ApiStatus == ApiCallStatus.Success;
        if (_testSucceeded)
        {
            var health = string.IsNullOrWhiteSpace(Status.ApiHealthText)
                ? L["Common_Success"].Value
                : Status.ApiHealthText;
            _testResultMessage = string.Format(L["Api_TestSuccess"], health);
        }
        else if (Status.ApiStatus is { } status)
        {
            var described = ApiLocalizer.Describe(status, Status.LastApiError);
            _testResultMessage = described.Message;
        }
        else
        {
            _testResultMessage = L["Api_TestFailure"];
        }
    }

    private async Task OnChangedAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= OnChangedAsync;
}

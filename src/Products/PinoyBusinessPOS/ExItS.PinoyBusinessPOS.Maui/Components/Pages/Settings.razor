@page "/settings"
@implements IDisposable
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject PosStatusState Status
@inject IAppInfoService AppInfo
@inject IOptions<PosApiOptions> ApiOptions
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["Settings_Title"]" Subtitle="@L["Settings_Subtitle"]" />

    <Alert Tone="AlertTone.Warning" Title="@L["Settings_DevNoticeTitle"]" Message="@L["Settings_DevNoticeMessage"]" />

    @if (_preferenceError is not null)
    {
        <Alert Tone="AlertTone.Danger" Message="@_preferenceError" />
    }

    <Section Title="@L["Settings_AppearanceSectionTitle"]">
        <Card>
            <Stack Gap="5">
                <Select Label="@L["Settings_ThemeLabel"]" Value="@ThemeCtl.Current.ToString()" ValueChanged="OnThemeChangedAsync" Options="ThemeOptions" />
                <Select Label="@L["Settings_DensityLabel"]" Value="@DensityCtl.Current.ToString()" ValueChanged="OnDensityChangedAsync" Options="DensityOptions" />
                <Select Label="@L["Settings_LanguageLabel"]" Value="@CultureCtl.Current" ValueChanged="OnCultureChangedAsync" Options="CultureOptions" />
            </Stack>
        </Card>
    </Section>

    <Section Title="@L["Settings_ApiSectionTitle"]">
        <Card>
            <Stack Gap="3">
                <Stack Direction="StackDirection.Row" Justify="StackJustify.Between" Align="StackAlign.Center" Wrap="true" Gap="2">
                    <span>@L["Settings_ApiHostLabel"]</span>
                    <span class="pos-muted pos-wrap">@ApiHost</span>
                </Stack>
                <Stack Direction="StackDirection.Row" Justify="StackJustify.Between" Align="StackAlign.Center" Wrap="true" Gap="2">
                    <span>@L["Api_Environment"]</span>
                    <Badge Tone="@(IsDevelopment ? BadgeTone.Warning : BadgeTone.Neutral)">@EnvironmentLabel</Badge>
                </Stack>
                <Button Variant="ButtonVariant.Secondary" IsLoading="Status.IsCheckingApi" OnClick="TestConnectionAsync">
                    @L["Api_TestConnection"]
                </Button>
                @if (_testResultMessage is not null)
                {
                    <Alert Tone="@(_testSucceeded ? AlertTone.Success : AlertTone.Danger)" Message="@_testResultMessage" />
                }
            </Stack>
        </Card>
    </Section>

    <Section Title="@L["Settings_AboutSectionTitle"]">
        <Card>
            <Stack Gap="3">
                <Stack Direction="StackDirection.Row" Justify="StackJustify.Between" Align="StackAlign.Center" Wrap="true" Gap="2">
                    <span>@L["Settings_AppVersionLabel"]</span>
                    <span class="pos-muted">@AppInfo.Version</span>
                </Stack>
                <Stack Direction="StackDirection.Row" Justify="StackJustify.Between" Align="StackAlign.Center" Wrap="true" Gap="2">
                    <span>@L["Home_EnvironmentLabel"]</span>
                    <span class="pos-muted">@EnvironmentLabel</span>
                </Stack>
            </Stack>
        </Card>
    </Section>
</Page>

@code {
    private bool _testSucceeded;
    private string? _testResultMessage;
    private string? _preferenceError;

    private IReadOnlyList<SelectOption> ThemeOptions =>
    [
        new(nameof(ThemePreference.System), L["Settings_Theme_System"]),
        new(nameof(ThemePreference.Light), L["Settings_Theme_Light"]),
        new(nameof(ThemePreference.Dark), L["Settings_Theme_Dark"]),
    ];

    private IReadOnlyList<SelectOption> DensityOptions =>
    [
        new(nameof(DensityMode.Compact), L["Settings_Density_Compact"]),
        new(nameof(DensityMode.Comfortable), L["Settings_Density_Comfortable"]),
    ];

    private IReadOnlyList<SelectOption> CultureOptions =>
    [
        new(MauiCulturePreferenceStore.English, L["Settings_Language_English"]),
        new(MauiCulturePreferenceStore.Filipino, L["Settings_Language_Filipino"]),
    ];

    private bool IsDevelopment => string.Equals(AppInfo.EnvironmentName, "Development", StringComparison.OrdinalIgnoreCase);

    private string EnvironmentLabel => IsDevelopment ? L["Env_Development"] : L["Env_Production"];

    private string ApiHost
    {
        get
        {
            var baseUrl = ApiOptions.Value.BaseUrl;
            return Uri.TryCreate(baseUrl, UriKind.Absolute, out var uri) ? uri.Authority : baseUrl;
        }
    }

    protected override void OnInitialized()
    {
        Status.Changed += OnChangedAsync;
    }

    private async Task OnThemeChangedAsync(string? value)
    {
        _preferenceError = null;
        if (Enum.TryParse<ThemePreference>(value, out var preference))
        {
            if (!await ThemeCtl.SetThemeAsync(preference))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task OnDensityChangedAsync(string? value)
    {
        _preferenceError = null;
        if (Enum.TryParse<DensityMode>(value, out var density))
        {
            if (!await DensityCtl.SetDensityAsync(density))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task OnCultureChangedAsync(string? value)
    {
        _preferenceError = null;
        if (!string.IsNullOrEmpty(value))
        {
            if (!await CultureCtl.SetCultureAsync(value))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task TestConnectionAsync()
    {
        _testResultMessage = null;
        await Status.RefreshApiHealthAsync();
        _testSucceeded = Status.ApiStatus == ApiCallStatus.Success;
        if (_testSucceeded)
        {
            var health = string.IsNullOrWhiteSpace(Status.ApiHealthText)
                ? L["Common_Success"].Value
                : Status.ApiHealthText;
            _testResultMessage = string.Format(L["Api_TestSuccess"], health);
        }
        else if (Status.ApiStatus is { } status)
        {
            var described = ApiLocalizer.Describe(status, Status.LastApiError);
            _testResultMessage = described.Message;
        }
        else
        {
            _testResultMessage = L["Api_TestFailure"];
        }
    }

    private async Task OnChangedAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= OnChangedAsync;
}

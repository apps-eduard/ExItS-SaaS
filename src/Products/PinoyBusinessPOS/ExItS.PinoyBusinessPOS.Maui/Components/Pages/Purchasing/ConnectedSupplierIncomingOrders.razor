@page "/connected-suppliers/incoming"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/purchasing" />
<div class="pos-incoming-orders">
<Page>
    <header class="pos-incoming-orders__header">
        <h1>@L["ConnectedSuppliers_IncomingOrders"]</h1>
        <p class="pos-muted">@L["ConnectedSuppliers_IncomingOrdersHelp"]</p>
    </header>
    <div class="pos-incoming-orders__filters" role="group" aria-label="@L["Purchasing_FilterStatus"]">
        @foreach (var filter in Filters)
        {
            <button type="button"
                    class="pos-incoming-orders__filter @(_filter == filter.Value ? "pos-incoming-orders__filter--active" : null)"
                    aria-pressed="@(_filter == filter.Value)"
                    disabled="@_loading"
                    @onclick="() => ChangeFilterAsync(filter.Value)">
                @L[filter.LabelKey]
            </button>
        }
    </div>
    @if (_loading)
    {
        <Spinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["ConnectedSuppliers_Error"]" Message="@_error" />
    }
    else if (_orders.Count == 0)
    {
        <EmptyState IconName="orders" Title="@L["ConnectedSuppliers_NoIncomingOrders"]" Message="@L["ConnectedSuppliers_NoIncomingOrdersHelp"]" />
    }
    else
    {
        @foreach (var order in _orders)
        {
            <a class="pos-incoming-orders__card"
               href="@($"/connected-suppliers/incoming/{order.ConnectedPurchaseOrderId:D}")">
                <span class="pos-incoming-orders__card-top">
                    <strong>@(string.IsNullOrWhiteSpace(order.BuyerDisplayName) ? L["ConnectedSuppliers_Buyer"] : order.BuyerDisplayName)</strong>
                    <Badge Tone="@StatusTone(EffectiveStatus(order))">@StatusLabel(order)</Badge>
                </span>
                <span class="pos-incoming-orders__po">@(order.BuyerPoNumber ?? L["ConnectedSuppliers_PurchaseOrder"])</span>
                <span class="pos-incoming-orders__meta">
                    @order.OrderDate.ToString("d") · @L["Purchasing_LinesCount", order.Lines.Count]
                </span>
                <span class="pos-incoming-orders__total"><MoneyDisplay Amount="@order.TotalAmount" CurrencyCode="PHP" Emphasized="true" /></span>
            </a>
        }
    }
</Page>
</div>

@code {
    private bool _loading = true;
    private bool _offline;
    private string? _error;
    private IReadOnlyList<ConnectedPurchaseOrderDto> _orders = [];
    private string _filter = "ActionNeeded";

    private static IReadOnlyList<OrderFilter> Filters =>
    [
        new("ActionNeeded", "ConnectedSuppliers_Filter_ActionNeeded"),
        new("New", "ConnectedSuppliers_Filter_New"),
        new("Accepted", "ConnectedSuppliers_Filter_Accepted"),
        new("Preparing", "ConnectedSuppliers_Filter_Preparing"),
        new("Fulfilled", "ConnectedSuppliers_Filter_Fulfilled"),
        new("Declined", "ConnectedSuppliers_Filter_Declined"),
        new("Withdrawn", "ConnectedSuppliers_Filter_Withdrawn"),
        new("All", "ConnectedSuppliers_Filter_All")
    ];

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }
        if (!Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }
        _offline = !await Connectivity.IsConnectedAsync();
        if (_offline)
        {
            _loading = false;
            _error = L["Purchasing_OfflineMessage"];
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await ConnectedSuppliers.ListIncomingOrdersAsync(_filter);
        _loading = false;
        _orders = result.IsSuccess && result.Data is not null ? result.Data : [];
        _error = result.IsSuccess ? null : result.Error?.Detail ?? L["ConnectedSuppliers_LoadIncomingFailed"];
    }

    private async Task ChangeFilterAsync(string filter)
    {
        _filter = filter;
        await LoadAsync();
    }

    private string StatusLabel(ConnectedPurchaseOrderDto order)
    {
        var status = EffectiveStatus(order);
        return L[$"ConnectedSuppliers_OrderStatus_{status.Replace(" ", string.Empty, StringComparison.Ordinal)}"];
    }

    private static string EffectiveStatus(ConnectedPurchaseOrderDto order) =>
        string.IsNullOrWhiteSpace(order.DisplayStatus) ? order.Status : order.DisplayStatus;

    private static BadgeTone StatusTone(string status) =>
        status switch
        {
            "New" => BadgeTone.Primary,
            "Accepted" => BadgeTone.Info,
            "Preparing" => BadgeTone.Warning,
            "Fulfilled" or "Received" => BadgeTone.Success,
            "Declined" => BadgeTone.Danger,
            _ => BadgeTone.Neutral
        };

    private sealed record OrderFilter(string Value, string LabelKey);
}

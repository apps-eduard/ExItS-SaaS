@page "/purchasing/{PurchaseOrderId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosPurchaseOrderClient Purchasing
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    <StoreHeaderBack Href="/purchasing" />
    @if (_loading)
    {
        <Page><Spinner /></Page>
    }
    else if (_po is null)
    {
        <Page>
            <ErrorState Title="@(_errorTitle ?? L["Purchasing_NotFoundTitle"])"
                        Message="@(_errorMessage ?? L["Purchasing_NotFoundMessage"])"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="LoadAsync" />
        </Page>
    }
    else
    {
        var canManage = Capabilities.IsAllowed(UtangCapability.ManagePurchasing);
        var canSubmit = canManage && !_isOffline && _po.Status == "Draft";
        var canCancel = canManage && !_isOffline && (_po.Status == "Draft" || _po.CanWithdrawConnected);
        var canReceive = canManage && !_isOffline && _po.CanReceiveConnected
            && (_po.Status == "Ordered" || _po.Status == "PartiallyReceived")
            && _po.Lines.Any(line => line.OutstandingQty > 0m);
        var actionCount = (canSubmit ? 1 : 0) + (canReceive ? 1 : 0) + (canCancel ? 1 : 0);
<div class="pos-purchasing-detail">
        <Page>
            <header class="pos-purchasing-detail__header">
                <h1 class="pos-purchasing-detail__title">@(_po.PoNumber ?? L["Purchasing_DetailTitle"])</h1>
                <p class="pos-purchasing-detail__subtitle">@L["Purchasing_DetailSubtitle"]</p>
                <div class="pos-purchasing-detail__status-row">
                    <Badge Tone="@StatusTone(DisplayStatus(_po))">@StatusLabel(DisplayStatus(_po))</Badge>
                </div>
            </header>

            @if (_isOffline)
            {
                <Alert Tone="AlertTone.Warning" Title="@L["Purchasing_OfflineTitle"]" Message="@L["Purchasing_OfflineMessage"]" />
            }

            @if (!string.IsNullOrEmpty(_banner))
            {
                <Alert Tone="AlertTone.Success" Title="@L["Purchasing_SuccessTitle"]" Message="@_banner" />
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Purchasing_ErrorTitle"])" Message="@_errorMessage" />
            }

            @if (string.Equals(_po.ConnectedStatus, "Declined", StringComparison.OrdinalIgnoreCase))
            {
                <Alert Tone="AlertTone.Danger"
                       Title="@L["Purchasing_SupplierDeclined"]"
                       Message="@DeclineMessage(_po)" />
            }

            @if (_po.ConnectedPurchaseOrderId is not null)
            {
                <section class="pos-purchasing-detail__panel" aria-labelledby="purchasing-timeline-heading">
                    <h2 id="purchasing-timeline-heading" class="pos-purchasing-detail__section-title">@L["Purchasing_Timeline"]</h2>
                    <ol class="pos-purchasing-detail__timeline">
                        @foreach (var step in Timeline(_po))
                        {
                            <li class="pos-purchasing-detail__timeline-step @(step.Completed ? "pos-purchasing-detail__timeline-step--done" : null)">
                                <span class="pos-purchasing-detail__timeline-marker" aria-hidden="true">@(step.Completed ? "✓" : "○")</span>
                                <span>
                                    <strong>@step.Label</strong>
                                    @if (step.AtUtc is { } at)
                                    {
                                        <small>@at.ToLocalTime().ToString("g")</small>
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                </section>
            }

            <section class="pos-purchasing-detail__panel" aria-labelledby="purchasing-detail-heading">
                <h2 id="purchasing-detail-heading" class="pos-purchasing-detail__section-title">@L["Purchasing_DetailsSection"]</h2>
                <dl class="pos-purchasing-detail__facts">
                    <div class="pos-purchasing-detail__fact">
                        <dt>@L["Purchasing_Field_Status"]</dt>
                        <dd>@StatusLabel(DisplayStatus(_po))</dd>
                    </div>
                    <div class="pos-purchasing-detail__fact">
                        <dt>@L["Purchasing_Field_OrderDate"]</dt>
                        <dd>@_po.OrderDate.ToString("d")</dd>
                    </div>
                    <div class="pos-purchasing-detail__fact">
                        <dt>@L["Purchasing_Field_Supplier"]</dt>
                        <dd class="pos-wrap">@_po.SupplierId</dd>
                    </div>
                    @if (_po.ExpectedDeliveryDate is { } expected)
                    {
                        <div class="pos-purchasing-detail__fact">
                            <dt>@L["Purchasing_Field_ExpectedDelivery"]</dt>
                            <dd>@expected.ToString("d")</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_po.SupplierReference))
                    {
                        <div class="pos-purchasing-detail__fact">
                            <dt>@L["Purchasing_Field_SupplierReference"]</dt>
                            <dd class="pos-wrap">@_po.SupplierReference</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_po.Notes))
                    {
                        <div class="pos-purchasing-detail__fact">
                            <dt>@L["Purchasing_Field_Notes"]</dt>
                            <dd class="pos-wrap">@_po.Notes</dd>
                        </div>
                    }
                </dl>
            </section>

            <section class="pos-purchasing-detail__panel" aria-labelledby="purchasing-lines-heading">
                <h2 id="purchasing-lines-heading" class="pos-purchasing-detail__section-title">@L["Purchasing_LinesSection"]</h2>
                @if (_po.Lines.Count == 0)
                {
                    <p class="pos-purchasing-detail__empty">—</p>
                }
                else
                {
                    <div class="pos-purchasing-detail__list" role="list">
                        @foreach (var line in _po.Lines.OrderBy(l => l.LineNumber))
                        {
                            <div class="pos-purchasing-detail__entry" role="listitem">
                                <div class="pos-purchasing-detail__entry-top">
                                    <span class="pos-purchasing-detail__entry-name">@(line.NameSnapshot ?? line.ProductId.ToString("D"))</span>
                                </div>
                                <p class="pos-purchasing-detail__entry-meta">
                                    @L["Purchasing_LineSummary", line.OrderedQty, line.ReceivedQty, line.OutstandingQty, line.UnitPurchaseCost]
                                </p>
                            </div>
                        }
                    </div>
                }
            </section>

            @if (actionCount > 0)
            {
                <div class="pos-action-grid @(actionCount == 1 ? "pos-action-grid--single" : actionCount == 2 ? "pos-action-grid--two" : "pos-action-grid--three") pos-purchasing-detail__actions"
                     role="group">
                    @if (canSubmit)
                    {
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@_busy"
                                @onclick="SubmitAsync">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                            <span class="pos-action-tile__label">@L["Purchasing_Submit"]</span>
                        </button>
                    }
                    @if (canReceive)
                    {
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@_busy"
                                @onclick="GoReceive">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                            <span class="pos-action-tile__label">@L["Purchasing_Receive"]</span>
                        </button>
                    }
                    @if (canCancel)
                    {
                        <button type="button"
                                class="pos-action-tile"
                                disabled="@_busy"
                                @onclick="CancelAsync">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                            <span class="pos-action-tile__label">@(_po.Status == "Draft" ? L["Purchasing_Cancel"] : L["Purchasing_Withdraw"])</span>
                        </button>
                    }
                </div>
            }
        </Page>
</div>
    }
}

@code {
    [Parameter] public Guid PurchaseOrderId { get; set; }

    private bool _ready;
    private bool _loading;
    private bool _busy;
    private bool _isOffline;
    private PosPurchaseOrderDto? _po;
    private string? _banner;
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private static string DisplayStatus(PosPurchaseOrderDto po) =>
        string.IsNullOrWhiteSpace(po.DisplayStatus) ? po.Status : po.DisplayStatus;

    private string StatusLabel(string status) =>
        L[$"Purchasing_Status_{status.Replace(" ", string.Empty, StringComparison.Ordinal)}"];

    private static BadgeTone StatusTone(string status) =>
        status switch
        {
            "WaitingForSupplier" or "SupplierAccepted" => BadgeTone.Info,
            "Preparing" or "Ready" or "PartiallyReceived" => BadgeTone.Warning,
            "Received" => BadgeTone.Success,
            "SupplierDeclined" or "ReceivedWithIssues" => BadgeTone.Danger,
            _ => BadgeTone.Neutral
        };

    private string DeclineMessage(PosPurchaseOrderDto po)
    {
        var reason = string.IsNullOrWhiteSpace(po.DeclineReason)
            ? L["Purchasing_DeclineReasonNotProvided"].Value
            : L[$"Purchasing_DeclineReason_{po.DeclineReason}"].Value;
        return string.IsNullOrWhiteSpace(po.DeclineNote) ? reason : $"{reason} — {po.DeclineNote}";
    }

    private IReadOnlyList<TimelineStep> Timeline(PosPurchaseOrderDto po)
    {
        var declined = string.Equals(po.ConnectedStatus, "Declined", StringComparison.OrdinalIgnoreCase);
        var received = po.Lines.Any(line => line.ReceivedQty > 0m || line.ClosedShortQty > 0m);
        var steps = new List<TimelineStep>
        {
            new(L["Purchasing_TimelineCreated"].Value, po.CreatedAtUtc, true),
            new(L["Purchasing_TimelineSent"].Value, po.OrderedAtUtc, po.OrderedAtUtc is not null),
            new(declined ? L["Purchasing_TimelineDeclined"].Value : L["Purchasing_TimelineAccepted"].Value,
                declined ? po.SupplierDeclinedAtUtc : po.SupplierAcceptedAtUtc,
                declined ? po.SupplierDeclinedAtUtc is not null : po.SupplierAcceptedAtUtc is not null)
        };
        if (!declined)
        {
            steps.Add(new(L["Purchasing_TimelinePreparing"].Value, po.SupplierPreparingAtUtc, po.SupplierPreparingAtUtc is not null));
            steps.Add(new(L["Purchasing_TimelineReady"].Value, po.SupplierFulfilledAtUtc, po.SupplierFulfilledAtUtc is not null));
            steps.Add(new(L["Purchasing_TimelineReceiving"].Value, received ? po.UpdatedAtUtc : null, received));
        }
        return steps;
    }

    private sealed record TimelineStep(string Label, DateTimeOffset? AtUtc, bool Completed);

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _po = null;
            _loading = false;
            return;
        }

        var result = await Purchasing.GetAsync(PurchaseOrderId);
        if (result.IsSuccess)
        {
            _po = result.Data;
        }
        else
        {
            _po = null;
            _errorTitle = L["Purchasing_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        if (_po is null || _isOffline || _busy)
        {
            return;
        }

        _busy = true;
        _banner = null;
        _errorMessage = null;
        var result = await Purchasing.SubmitAsync(_po.PurchaseOrderId);
        if (result.IsSuccess && result.Data is not null)
        {
            _po = result.Data;
            _banner = L["Purchasing_SubmitSuccess"];
        }
        else
        {
            _errorTitle = L["Purchasing_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }

        _busy = false;
    }

    private async Task CancelAsync()
    {
        if (_po is null || _isOffline || _busy)
        {
            return;
        }

        _busy = true;
        _banner = null;
        _errorMessage = null;
        var result = await Purchasing.CancelAsync(_po.PurchaseOrderId);
        if (result.IsSuccess && result.Data is not null)
        {
            _po = result.Data;
            _banner = L["Purchasing_CancelSuccess"];
        }
        else
        {
            _errorTitle = L["Purchasing_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }

        _busy = false;
    }

    private void GoReceive() => Nav.NavigateTo($"/purchasing/{PurchaseOrderId:D}/receive");
}

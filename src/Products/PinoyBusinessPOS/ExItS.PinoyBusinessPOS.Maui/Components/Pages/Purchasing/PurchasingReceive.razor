@page "/purchasing/{PurchaseOrderId:guid}/receive"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosPurchaseOrderClient Purchasing
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    <StoreHeaderBack Href="@($"/purchasing/{PurchaseOrderId:D}")" />
    @if (_loading)
    {
        <Page><Spinner /></Page>
    }
    else if (_po is null)
    {
        <Page>
            <ErrorState Title="@(_errorTitle ?? L["Purchasing_NotFoundTitle"])"
                        Message="@(_errorMessage ?? L["Purchasing_NotFoundMessage"])"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="LoadAsync" />
        </Page>
    }
    else
    {
        var canManage = Capabilities.IsAllowed(UtangCapability.ManagePurchasing);
        var canReceive = canManage && !_isOffline
            && _po.CanReceiveConnected
            && (_po.Status == "Ordered" || _po.Status == "PartiallyReceived")
            && _lines.Any(l => l.OutstandingQty > 0m);
<div class="pos-purchasing-receive">
        <Page>
            <header class="pos-purchasing-receive__header">
                <h1 class="pos-purchasing-receive__title">@L["Purchasing_ReceiveAgainstPoTitle"]</h1>
                <p class="pos-purchasing-receive__subtitle">@(_po.PoNumber ?? L["Purchasing_ReceiveSubtitle"])</p>
                <p class="pos-muted">@L["Purchasing_GoodsReceiptsStockNote"]</p>
            </header>

            @if (_isOffline)
            {
                <Alert Tone="AlertTone.Warning" Title="@L["Purchasing_OfflineTitle"]" Message="@L["Purchasing_OfflineMessage"]" />
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Purchasing_ErrorTitle"])" Message="@_errorMessage" />
            }

            <section class="pos-purchasing-receive__panel" aria-labelledby="purchasing-receive-heading">
                <h2 id="purchasing-receive-heading" class="pos-purchasing-receive__section-title">
                    @(_reviewing ? L["Purchasing_ReviewReceipt"] : L["Purchasing_ReceiveLinesSection"])
                </h2>
                <div class="pos-purchasing-receive__list" role="list">
                    @foreach (var line in _lines)
                    {
                        <div class="pos-purchasing-receive__entry" role="listitem">
                            <div class="pos-purchasing-receive__entry-top">
                                <span class="pos-purchasing-receive__entry-name">@(line.NameSnapshot ?? line.ProductId.ToString("D"))</span>
                            </div>
                            <p class="pos-purchasing-receive__entry-meta">@L["Purchasing_Outstanding", line.OutstandingQty, line.UomSnapshot ?? ""]</p>
                            @if (_reviewing)
                            {
                                <dl class="pos-purchasing-receive__review">
                                    <div><dt>@L["Purchasing_GoodReceived"]</dt><dd>@line.GoodQty</dd></div>
                                    <div><dt>@L["Purchasing_Damaged"]</dt><dd>@line.DamagedQty</dd></div>
                                    <div><dt>@L["Purchasing_OutstandingLabel"]</dt><dd>@line.RemainingQty</dd></div>
                                    <div><dt>@L["Purchasing_CloseAsShort"]</dt><dd>@(line.CloseRemaining ? L["Common_Yes"] : L["Common_No"])</dd></div>
                                </dl>
                            }
                            else if (canReceive && line.OutstandingQty > 0m)
                            {
                                <div class="pos-purchasing-receive__entry-fields">
                                    <TextInput Label="@L["Purchasing_GoodReceived"]"
                                               Value="@line.GoodQtyText"
                                               ValueChanged="v => line.GoodQtyText = v" />
                                    <TextInput Label="@L["Purchasing_Damaged"]"
                                               Value="@line.DamagedQtyText"
                                               ValueChanged="v => line.DamagedQtyText = v" />
                                </div>
                                <label class="pos-purchasing-receive__short-toggle">
                                    <input type="checkbox" checked="@line.CloseRemaining" @onchange="e => line.CloseRemaining = e.Value is true" />
                                    <span>
                                        <strong>@L["Purchasing_CloseAsShort"]</strong>
                                        <small>@L["Purchasing_CloseRemainingHelp"]</small>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>
                @if (canReceive && !_reviewing)
                {
                    <div class="pos-purchasing-receive__form">
                        <TextInput Label="@L["Purchasing_DeliveryReference"]" Value="@_deliveryReference" ValueChanged="v => _deliveryReference = v" />
                        <TextInput Label="@L["Purchasing_ReceiveNotes"]" Value="@_notes" ValueChanged="v => _notes = v" />
                    </div>
                }
            </section>

            <FormActions>
                @if (_reviewing)
                {
                    <Button Disabled="@_busy" OnClick="() => _reviewing = false">@L["Purchasing_BackToReceipt"]</Button>
                    <Button Variant="ButtonVariant.Primary"
                            Disabled="@(!canReceive || _busy)"
                            IsLoading="@_busy"
                            OnClick="ReceiveAsync">@L["Purchasing_ConfirmGoodsReceipt"]</Button>
                }
                else
                {
                    <Button Variant="ButtonVariant.Primary"
                            Disabled="@(!canReceive || _busy)"
                            OnClick="ReviewAsync">@L["Purchasing_ReviewReceipt"]</Button>
                }
            </FormActions>
        </Page>
</div>
    }
}

@code {
    [Parameter] public Guid PurchaseOrderId { get; set; }

    private bool _ready;
    private bool _loading;
    private bool _busy;
    private bool _isOffline;
    private bool _reviewing;
    private PosPurchaseOrderDto? _po;
    private List<ReceiveLineEdit> _lines = [];
    private string _deliveryReference = string.Empty;
    private string _notes = string.Empty;
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _po = null;
            _lines = [];
            _loading = false;
            return;
        }

        var result = await Purchasing.GetAsync(PurchaseOrderId);
        if (result.IsSuccess && result.Data is not null)
        {
            _po = result.Data;
            _lines = result.Data.Lines
                .OrderBy(l => l.LineNumber)
                .Select(l => new ReceiveLineEdit(l))
                .ToList();
        }
        else
        {
            _po = null;
            _lines = [];
            _errorTitle = L["Purchasing_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }

        _loading = false;
    }

    private Task ReviewAsync()
    {
        if (!TryBuildReceiveLines(out _))
        {
            return Task.CompletedTask;
        }
        _reviewing = true;
        return Task.CompletedTask;
    }

    private async Task ReceiveAsync()
    {
        if (_po is null || _isOffline || _busy)
        {
            return;
        }

        _busy = true;
        _errorMessage = null;

        if (!TryBuildReceiveLines(out var receiveLines))
        {
            _busy = false;
            return;
        }

        var result = await Purchasing.ReceiveAsync(
            PurchaseOrderId,
            new ReceivePurchaseOrderRequest(
                receiveLines,
                Guid.NewGuid(),
                DeliveryReference: string.IsNullOrWhiteSpace(_deliveryReference) ? null : _deliveryReference.Trim(),
                Notes: string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));

        if (result.IsSuccess)
        {
            Nav.NavigateTo($"/purchasing/{PurchaseOrderId:D}", replace: true);
            return;
        }

        _errorTitle = L["Purchasing_ErrorTitle"];
        _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        _busy = false;
    }

    private bool TryBuildReceiveLines(out List<ReceivePurchaseOrderLineRequest> receiveLines)
    {
        receiveLines = [];
        _errorMessage = null;
        foreach (var line in _lines)
        {
            if (!TryQty(line.GoodQtyText, out var good) || !TryQty(line.DamagedQtyText, out var damaged))
            {
                _errorTitle = L["Purchasing_ErrorTitle"];
                _errorMessage = L["Purchasing_InvalidReceiveQty"];
                return false;
            }

            if (good + damaged > line.OutstandingQty)
            {
                _errorTitle = L["Purchasing_ErrorTitle"];
                _errorMessage = L["Purchasing_OverReceiveQty"];
                return false;
            }

            var remaining = line.OutstandingQty - good - damaged;
            var shortClosed = line.CloseRemaining ? remaining : 0m;
            line.GoodQty = good;
            line.DamagedQty = damaged;
            line.RemainingQty = remaining;
            if (good + damaged + shortClosed <= 0m)
            {
                continue;
            }

            var kind = damaged > 0m ? "Damaged" : shortClosed > 0m ? "Short" : null;
            receiveLines.Add(new ReceivePurchaseOrderLineRequest(
                line.ProductId,
                good,
                DamagedQty: damaged,
                ShortClosedQty: shortClosed,
                DiscrepancyKind: kind,
                DiscrepancyNote: kind is null || string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));
        }

        if (receiveLines.Count == 0)
        {
            _errorTitle = L["Purchasing_ErrorTitle"];
            _errorMessage = L["Purchasing_ReceiveRequiresLines"];
            return false;
        }

        return true;
    }

    private static bool TryQty(string value, out decimal qty)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            qty = 0m;
            return true;
        }
        return decimal.TryParse(value.Trim(), out qty) && qty >= 0m;
    }

    private sealed class ReceiveLineEdit
    {
        public ReceiveLineEdit(PosPurchaseOrderLineDto line)
        {
            ProductId = line.ProductId;
            NameSnapshot = line.NameSnapshot;
            UomSnapshot = line.UomSnapshot;
            OutstandingQty = line.OutstandingQty;
            GoodQtyText = line.OutstandingQty > 0m ? line.OutstandingQty.ToString("0.###") : string.Empty;
            DamagedQtyText = string.Empty;
        }

        public Guid ProductId { get; }
        public string? NameSnapshot { get; }
        public string? UomSnapshot { get; }
        public decimal OutstandingQty { get; }
        public string GoodQtyText { get; set; }
        public string DamagedQtyText { get; set; }
        public bool CloseRemaining { get; set; }
        public decimal GoodQty { get; set; }
        public decimal DamagedQty { get; set; }
        public decimal RemainingQty { get; set; }
    }
}

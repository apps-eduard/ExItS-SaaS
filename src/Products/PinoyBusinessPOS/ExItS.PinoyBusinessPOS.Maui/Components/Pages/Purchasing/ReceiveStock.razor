@page "/purchasing/receive-stock"
@using System.Globalization
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_allowed)
{
    <Page>
        <StoreHeaderBack Href="/purchasing" />
        <EmptyState IconName="lock"
                    Title="@L["Purchasing_ReceiveStock"]"
                    Message="@L["Access_RestrictedMessage"]" />
    </Page>
}
else
{
<div class="pos-purchasing pos-receive-stock">
    <StoreHeaderBack Href="/purchasing" />
    <Page>
        <header class="pos-purchasing__header">
            <div class="pos-purchasing__heading">
                <h1 class="pos-purchasing__title">@L["Purchasing_ReceiveStock"]</h1>
                <p class="pos-purchasing__subtitle">@L["Purchasing_ReceiveStockDescription"]</p>
                <p class="pos-receive-stock__tip">
                    @L["Purchasing_ReceiveStockHelper"]
                    <button type="button" class="pos-receive-stock__link" @onclick="GoOrders">@L["Purchasing_Orders"]</button>
                </p>
            </div>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
        }

        <div class="pos-receive-stock__toolbar">
            <div class="pos-receive-stock__search" role="search">
                <span class="pos-receive-stock__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                <label class="visually-hidden" for="receive-stock-search">@L["Purchasing_ReceiveStockSearchPlaceholder"]</label>
                <input id="receive-stock-search"
                       class="pos-receive-stock__search-input"
                       type="search"
                       value="@_search"
                       placeholder="@L["Purchasing_ReceiveStockSearchPlaceholder"]"
                       disabled="@(_loading || _isOffline)"
                       @oninput="OnSearchInput" />
            </div>
        </div>

        <section class="pos-purchasing__panel" aria-labelledby="receive-stock-list-heading">
            <h2 id="receive-stock-list-heading" class="pos-purchasing__section-title">@L["Purchasing_ReceiveStockPickProduct"]</h2>
            @if (_loading)
            {
                <div class="pos-purchasing__loading"><Spinner /><span>@L["Inventory_Loading"]</span></div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Purchasing_ReceiveStock"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (TrackedItems.Count == 0)
            {
                <EmptyState IconName="products"
                            Title="@(HasSearch ? L["Purchasing_ReceiveStockNoMatchTitle"] : L["Purchasing_ReceiveStockEmptyTitle"])"
                            Message="@(HasSearch ? L["Purchasing_ReceiveStockNoMatchMessage"] : L["Purchasing_ReceiveStockEmptyMessage"])" />
            }
            else
            {
                <div class="pos-purchasing__list pos-receive-stock__list" role="list" aria-label="@L["Purchasing_ReceiveStock"]">
                    @foreach (var item in TrackedItems)
                    {
                        <a class="pos-purchasing__row pos-receive-stock__row"
                           role="listitem"
                           href="@($"/inventory/{item.ProductId:D}/adjust?intent=receive")">
                            <div class="pos-purchasing__row-main">
                                <div class="pos-purchasing__row-top">
                                    <span class="pos-purchasing__row-name">@item.Name</span>
                                </div>
                                <span class="pos-purchasing__row-meta">
                                    @item.UnitOfMeasure
                                    · @L["Inventory_OnHand"] @item.OnHandQuantity.ToString("0.###", CultureInfo.InvariantCulture)
                                </span>
                            </div>
                            <span class="pos-receive-stock__row-action">
                                <span class="pos-receive-stock__row-action-icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                                <span>@L["Purchasing_ReceiveStockAction"]</span>
                            </span>
                        </a>
                    }
                </div>
            }
        </section>
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _allowed;
    private bool _loading;
    private bool _isOffline;
    private string _search = string.Empty;
    private IReadOnlyList<PosInventoryAccountDto> _items = Array.Empty<PosInventoryAccountDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    private IReadOnlyList<PosInventoryAccountDto> TrackedItems =>
        _items.Where(x => x.IsTracked).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _allowed = Capabilities.IsAllowed(UtangCapability.ManageInventory);
        _ready = true;
        if (_allowed)
        {
            await ReloadAsync();
        }
    }

    private void GoOrders() => Nav.NavigateTo("/purchasing/orders");

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(300, token);
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosInventoryAccountDto>();
            _loading = false;
            return;
        }

        var result = await Inventory.ListAsync(
            search: string.IsNullOrWhiteSpace(_search) ? null : _search,
            page: 1,
            pageSize: 50);
        if (result.Status == ApiCallStatus.Success && result.Data is not null)
        {
            _items = result.Data.Items;
        }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            _items = Array.Empty<PosInventoryAccountDto>();
        }

        _loading = false;
    }
}

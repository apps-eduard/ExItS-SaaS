@page "/purchasing/new"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Domain.Purchasing
@using System.Text.Json
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosPurchaseOrderClient Purchasing
@inject IPosSupplierClient Suppliers
@inject IPosCatalogClient Catalog
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject ILinkedSupplierProductStore LinkedProducts
@inject IConnectedPurchaseOrderDraftStore ConnectedDrafts
@inject ILocalConnectedSupplierStore LocalConnectedSuppliers
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManagePurchasing);
    var blocked = !canManage || (_isOffline && !IsConnectedSupplier);
    var hasDraft = HasUnsavedDraft;
    var eligibleProducts = EligibleProducts;
    var categoryChips = CategoryChips;
    var isEditing = _editingProductId is not null;
<div class="pos-purchasing-create">
<StoreHeaderBack Href="/purchasing" />
<Page>
    <header class="pos-purchasing-create__header">
        <div class="pos-purchasing-create__heading">
            <h1 class="pos-purchasing-create__title">@L["Purchasing_CreateTitle"]</h1>
            <p class="pos-purchasing-create__subtitle">@L["Purchasing_CreateSubtitle"]</p>
            <p class="pos-muted">@L["Purchasing_OrdersNoStockNote"]</p>
        </div>
        <button type="button"
                class="pos-purchasing-create__reset"
                disabled="@(_saving || !hasDraft)"
                title="@L["Purchasing_Reset"]"
                aria-label="@L["Purchasing_Reset"]"
                @onclick="RequestReset">
            <span aria-hidden="true">@IconGlyphs.Get("refresh")</span>
        </button>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Purchasing_OfflineTitle"]" Message="@L["Purchasing_OfflineMessage"]" />
    }
    else if (!canManage)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Purchasing_ErrorTitle"])" Message="@_errorMessage" />
    }

    @if (!_isOffline && canManage && _suppliers.Count == 0 && !_loadingLookups)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Purchasing_NoSuppliersTitle"]" Message="@L["Purchasing_NoSuppliersMessage"]" />
        <div class="pos-action-grid pos-action-grid--single pos-purchasing-create__toolbar" role="group">
            <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="GoCreateSupplier">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span class="pos-action-tile__label">@L["Purchasing_CreateSupplier"]</span>
            </button>
        </div>
    }

    <section class="pos-purchasing-create__panel" aria-labelledby="purchasing-details-heading">
        <h2 id="purchasing-details-heading" class="pos-purchasing-create__section-title">@L["Purchasing_DetailsSection"]</h2>
        <div class="pos-purchasing-create__form pos-settings__panel">
                <Select Label="@L["Purchasing_Field_Supplier"]"
                        Value="@_supplierId"
                        ValueChanged="OnSupplierChangedAsync"
                        Options="@SupplierOptions"
                        Required="true"
                        IsInvalid="@(!string.IsNullOrEmpty(_supplierError))"
                        ErrorText="@_supplierError"
                        Disabled="@(!canManage || _saving || _loadingLookups || _suppliers.Count == 0)" />
                <DateInput Label="@L["Purchasing_Field_OrderDate"]"
                           Value="@_orderDate"
                           ValueChanged="v => _orderDate = v"
                           Required="true"
                           IsInvalid="@(!string.IsNullOrEmpty(_orderDateError))"
                           ErrorText="@_orderDateError"
                           Disabled="@(blocked || _saving)" />
                <DateInput Label="@L["Purchasing_Field_ExpectedDelivery"]"
                           Value="@_expectedDeliveryDate"
                           ValueChanged="v => _expectedDeliveryDate = v"
                           Disabled="@(blocked || _saving)" />
                <TextInput Label="@L["Purchasing_Field_SupplierReference"]"
                           Value="@_supplierReference"
                           ValueChanged="v => _supplierReference = v"
                           Disabled="@(blocked || _saving)" />
                <TextInput Label="@L["Purchasing_Field_Notes"]"
                           Value="@_notes"
                           ValueChanged="v => _notes = v"
                           Disabled="@(blocked || _saving)" />
        </div>
    </section>

    <section class="pos-purchasing-create__panel" aria-labelledby="purchasing-lines-heading">
        <h2 id="purchasing-lines-heading" class="pos-purchasing-create__section-title">@L["Purchasing_LinesSection"]</h2>
        <div class="pos-purchasing-create__form pos-settings__panel">
                <div class="pos-purchasing-create__picker" role="search" aria-label="@L["Purchasing_Field_Product"]">
                    <label class="pos-purchasing-create__search-label" for="purchasing-product-search">@L["Purchasing_SearchProducts"]</label>
                    <div class="pos-purchasing-create__search">
                        <span class="pos-purchasing-create__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                        <input id="purchasing-product-search"
                               class="pos-purchasing-create__search-input"
                               type="search"
                               value="@_productSearch"
                               placeholder="@L["Purchasing_SearchProducts"]"
                               aria-label="@L["Purchasing_SearchProducts"]"
                               disabled="@(blocked || _saving || _loadingLookups || _products.Count == 0 || isEditing)"
                               autocomplete="off"
                               @oninput="OnProductSearchInputAsync" />
                    </div>

                    @if (!IsConnectedSupplier)
                    {
                    <aside class="pos-sell-categories pos-purchasing-create__categories" aria-label="@L["Purchasing_CategoryFilter"]">
                        <button type="button"
                                class="@($"pos-category-chip{(_categoryFilterId is null ? " pos-category-chip--selected" : string.Empty)}")"
                                disabled="@(blocked || _saving || _loadingLookups || _products.Count == 0 || isEditing)"
                                aria-pressed="@(_categoryFilterId is null)"
                                @onclick="() => SetCategoryFilter(null)">
                            @L["Purchasing_AllCategories"]
                        </button>
                        @foreach (var category in categoryChips)
                        {
                            var selected = _categoryFilterId == category.CategoryId;
                            <button type="button"
                                    class="@($"pos-category-chip{(selected ? " pos-category-chip--selected" : string.Empty)}")"
                                    disabled="@(blocked || _saving || _loadingLookups || isEditing)"
                                    aria-pressed="@selected"
                                    @onclick="() => SetCategoryFilter(category.CategoryId)">
                                @category.Name
                            </button>
                        }
                    </aside>
                    }

                    @if (isEditing)
                    {
                        <div class="pos-purchasing-create__selected-product" aria-live="polite">
                            <span class="pos-purchasing-create__selected-label">@L["Purchasing_Field_Product"]</span>
                            <strong class="pos-purchasing-create__selected-name">@_editingProductName</strong>
                        </div>
                    }
                    else if (!IsConnectedSupplier && _products.Count == 0 && !_loadingLookups)
                    {
                        <InlineMessage Tone="InlineMessageTone.Info">@L["Purchasing_NoProductsAvailable"]</InlineMessage>
                    }
                    else if (IsConnectedSupplier && _connectedProducts.Count == 0 && _supplierCatalogProducts.Count == 0)
                    {
                        <InlineMessage Tone="InlineMessageTone.Info">@L["ConnectedSuppliers_NoOfflineResult"]</InlineMessage>
                    }
                    else if (!IsConnectedSupplier && eligibleProducts.Count == 0)
                    {
                        <InlineMessage Tone="InlineMessageTone.Info">@L["Purchasing_NoProductsMatch"]</InlineMessage>
                    }
                    else
                    {
                        <div class="pos-purchasing-create__product-list" role="listbox" aria-label="@L["Purchasing_Field_Product"]">
                            @if (IsConnectedSupplier)
                            {
                            @foreach (var product in _connectedProducts)
                            {
                                var selected = string.Equals(_selectedProductId, product.BuyerProductId.ToString("D"), StringComparison.Ordinal);
                                <button type="button" role="option" aria-selected="@selected"
                                        class="@($"pos-purchasing-create__hit{(selected ? " pos-purchasing-create__hit--selected" : string.Empty)}")"
                                        disabled="@(blocked || _saving)" @onclick="() => SelectConnectedProduct(product)">
                                    <span class="pos-purchasing-create__hit-name">@product.ProductName</span>
                                    <span class="pos-purchasing-create__hit-meta pos-muted">
                                        @(product.SupplierSku ?? L["ConnectedSuppliers_NoSku"])
                                        <text> · </text>@product.UnitOfMeasure
                                        <text> · </text><MoneyDisplay Amount="@product.LastKnownOrderPrice" CurrencyCode="PHP" />
                                    </span>
                                    <span class="pos-purchasing-create__hit-meta pos-muted">
                                        @L["ConnectedSuppliers_LastUpdated", product.SupplierUpdatedAtUtc.ToLocalTime().ToString("g")]
                                    </span>
                                </button>
                            }
                            @foreach (var exposure in _supplierCatalogProducts)
                            {
                                <article class="pos-purchasing-create__hit pos-purchasing-create__hit--action" role="option">
                                    <div class="pos-purchasing-create__hit-body">
                                        <span class="pos-purchasing-create__hit-name">@exposure.NameSnapshot</span>
                                        <span class="pos-purchasing-create__hit-meta pos-muted">
                                            @(exposure.SkuSnapshot ?? L["ConnectedSuppliers_NoSku"])
                                            <text> · </text>@exposure.UnitOfMeasureCode
                                            <text> · </text><MoneyDisplay Amount="@exposure.SupplierOrderPrice" CurrencyCode="PHP" />
                                        </span>
                                    </div>
                                    <button type="button"
                                            class="pos-purchasing-create__hit-cta"
                                            disabled="@(_isOffline || _saving)"
                                            @onclick="() => BeginLinkProduct(exposure)">
                                        @L["ConnectedSuppliers_UseProduct"]
                                    </button>
                                </article>
                            }
                            }
                            else
                            {
                            @foreach (var product in eligibleProducts)
                            {
                                var selected = string.Equals(_selectedProductId, product.ProductId.ToString("D"), StringComparison.Ordinal);
                                <button type="button"
                                        role="option"
                                        aria-selected="@selected"
                                        class="@($"pos-purchasing-create__hit{(selected ? " pos-purchasing-create__hit--selected" : string.Empty)}")"
                                        disabled="@(blocked || _saving)"
                                        @onclick="() => SelectProduct(product)">
                                    <span class="pos-purchasing-create__hit-name">@product.Name</span>
                                    @if (product.CategoryId is { } categoryId
                                         && _categoryNames.TryGetValue(categoryId, out var categoryName))
                                    {
                                        <span class="pos-purchasing-create__hit-meta pos-muted">@categoryName</span>
                                    }
                                </button>
                            }
                            }
                        </div>
                    }
                    @if (_pendingExposure is not null)
                    {
                        <div class="pos-purchasing-create__link-panel" role="region" aria-label="@L["ConnectedSuppliers_LinkProductTitle", _pendingExposure.NameSnapshot]">
                            <p class="pos-purchasing-create__link-title">
                                @L["ConnectedSuppliers_LinkProductTitle", _pendingExposure.NameSnapshot]
                            </p>
                            <Select Label="@L["ConnectedSuppliers_BuyerProduct"]"
                                    Value="@_buyerProductForLink"
                                    ValueChanged="v => _buyerProductForLink = v"
                                    Options="@BuyerCatalogChoices" />
                            <div class="pos-purchasing-create__link-actions">
                                <button type="button" class="pos-action-tile" disabled="@_saving" @onclick="CancelLinkProduct">
                                    <span class="pos-action-tile__label">@L["Purchasing_CancelEdit"]</span>
                                </button>
                                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_saving" @onclick="ConfirmLinkProductAsync">
                                    <span class="pos-action-tile__label">@L["ConnectedSuppliers_LinkAndUse"]</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <TextInput Label="@L["Purchasing_Field_OrderedQty"]"
                           Value="@_draftQtyText"
                           ValueChanged="v => _draftQtyText = v"
                           Required="true"
                           IsInvalid="@(!string.IsNullOrEmpty(_draftQtyError))"
                           ErrorText="@_draftQtyError"
                           Disabled="@(blocked || _saving || string.IsNullOrEmpty(_selectedProductId))" />
                <CurrencyInput Label="@L["Purchasing_Field_UnitCost"]"
                               Value="@_draftUnitCost"
                               ValueChanged="v => _draftUnitCost = v"
                               CurrencyCode="PHP"
                               Required="true"
                               Hint="@L["Purchasing_UnitCostHint"]"
                               IsInvalid="@(!string.IsNullOrEmpty(_draftCostError))"
                               ErrorText="@_draftCostError"
                               Disabled="@(blocked || _saving || string.IsNullOrEmpty(_selectedProductId))" />
                <div class="@($"pos-action-grid {(isEditing ? "pos-action-grid--two" : "pos-action-grid--single")} pos-purchasing-create__line-actions")" role="group">
                    @if (isEditing)
                    {
                        <button type="button"
                                class="pos-action-tile"
                                disabled="@(blocked || _saving)"
                                @onclick="CancelEdit">
                            <span class="pos-action-tile__label">@L["Purchasing_CancelEdit"]</span>
                        </button>
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@(blocked || _saving || string.IsNullOrEmpty(_selectedProductId))"
                                @onclick="SaveLineChanges">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                            <span class="pos-action-tile__label">@L["Purchasing_SaveChanges"]</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@(blocked || _saving || string.IsNullOrEmpty(_selectedProductId))"
                                @onclick="AddLine">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                            <span class="pos-action-tile__label">@L["Purchasing_AddLine"]</span>
                        </button>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_linesError))
                {
                    <Alert Tone="AlertTone.Danger" Title="@L["Purchasing_ErrorTitle"]" Message="@_linesError" />
                }

                @if (_lines.Count == 0)
                {
                    <InlineMessage Tone="InlineMessageTone.Info">@L["Purchasing_LinesEmptyHint"]</InlineMessage>
                }
                else
                {
                    <div class="pos-purchasing-create__lines-summary pos-muted">
                        @L["Purchasing_LinesCount", _lines.Count]
                        · @L["Purchasing_LinesTotal"]
                        <MoneyDisplay Amount="@LinesTotal" CurrencyCode="PHP" />
                    </div>
                    <div class="pos-purchasing-create__lines" role="list">
                        @foreach (var line in _lines)
                        {
                            var lineTotal = PurchaseOrderCreateUi.LineTotal(line.OrderedQty, line.UnitPurchaseCost);
                            <div class="pos-po-line" role="listitem">
                                <div class="pos-po-line__main">
                                    <div class="pos-po-line__title">@line.Name</div>
                                    <div class="pos-po-line__meta pos-muted">
                                        <span>@L["Purchasing_LineQtyPrefix", FormatQty(line.OrderedQty)]</span>
                                        <span aria-hidden="true"> × </span>
                                        <MoneyDisplay Amount="@line.UnitPurchaseCost" CurrencyCode="PHP" />
                                    </div>
                                    <div class="pos-po-line__total">
                                        <span class="pos-muted">@L["Purchasing_LineTotalLabel"]</span>
                                        <MoneyDisplay Amount="@lineTotal" CurrencyCode="PHP" Emphasized="true" />
                                    </div>
                                </div>
                                <div class="pos-po-line__actions">
                                    <button type="button"
                                            class="pos-po-line__action"
                                            disabled="@(blocked || _saving)"
                                            aria-label="@L["Purchasing_EditLine"]"
                                            title="@L["Purchasing_EditLine"]"
                                            @onclick="() => BeginEditLine(line)">
                                        <span aria-hidden="true">@IconGlyphs.Get("edit")</span>
                                        <span class="pos-po-line__action-label">@L["Purchasing_EditLine"]</span>
                                    </button>
                                    <button type="button"
                                            class="pos-po-line__action pos-po-line__action--danger"
                                            disabled="@(blocked || _saving)"
                                            aria-label="@L["Purchasing_DeleteLine"]"
                                            title="@L["Purchasing_DeleteLine"]"
                                            @onclick="() => RequestDeleteLine(line.ProductId)">
                                        <span aria-hidden="true">@IconGlyphs.Get("trash")</span>
                                        <span class="pos-po-line__action-label">@L["Purchasing_DeleteLine"]</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
        </div>
    </section>

    @if (_draftReview is not null && _draftReview.OverallStatus != ConnectedPoDraftReviewStatus.Unchanged)
    {
        <section class="pos-purchasing-create__panel">
            <h2>@L["ConnectedSuppliers_ReviewChanges"]</h2>
            <p>@L["ConnectedSuppliers_ReviewChangesHelp"]</p>
            @foreach (var item in _draftReview.Items.Where(x => x.Status != ConnectedPoDraftReviewStatus.Unchanged))
            {
                <div>@item.Status · @item.SubmittedPrice → @(item.CurrentPrice?.ToString("C") ?? L["ConnectedSuppliers_Unavailable"])</div>
            }
            <button type="button" @onclick="UpdateAndContinueAsync">@L["ConnectedSuppliers_UpdateAndContinue"]</button>
            <button type="button" @onclick="() => _draftReview = null">@L["ConnectedSuppliers_ReviewOrder"]</button>
            <button type="button" @onclick="RemoveUnavailableItems">@L["ConnectedSuppliers_RemoveItem"]</button>
        </section>
    }

    <div class="pos-action-grid pos-action-grid--two pos-purchasing-create__footer" role="group" aria-label="@L["Purchasing_Create"]">
        <button type="button" class="pos-action-tile" disabled="@(_saving || !hasDraft)" @onclick="RequestReset">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
            <span class="pos-action-tile__label">@L["Purchasing_Reset"]</span>
        </button>
        <button type="button"
                class="pos-action-tile pos-action-tile--primary"
                disabled="@(blocked || _saving || _loadingLookups || _suppliers.Count == 0)"
                @onclick="SaveAsync">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
            <span class="pos-action-tile__label">@L[_isOffline && IsConnectedSupplier ? "ConnectedSuppliers_SaveOnDevice" : "Purchasing_Create"]</span>
        </button>
    </div>

    <ConfirmDialog Visible="@_confirmReset"
                   VisibleChanged="v => _confirmReset = v"
                   Title="@L["Purchasing_ResetTitle"]"
                   Message="@L["Purchasing_ResetMessage"]"
                   ConfirmLabel="@L["Purchasing_Reset"]"
                   Danger="true"
                   OnConfirm="ConfirmReset"
                   OnCancel="() => _confirmReset = false" />

    <ConfirmDialog Visible="@_confirmDelete"
                   VisibleChanged="v => _confirmDelete = v"
                   Title="@L["Purchasing_DeleteLineTitle"]"
                   Message="@L["Purchasing_DeleteLineMessage"]"
                   ConfirmLabel="@L["Purchasing_DeleteLine"]"
                   Danger="true"
                   OnConfirm="ConfirmDeleteLine"
                   OnCancel="CancelDeleteLine" />
</Page>
</div>
}

@code {
    private sealed record LineEntry(Guid ProductId, string Name, decimal OrderedQty, decimal UnitPurchaseCost, Guid? SupplierProductId = null);

    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private bool _loadingLookups;
    private bool _confirmReset;
    private bool _confirmDelete;
    private Guid? _pendingDeleteProductId;
    private Guid? _editingProductId;
    private string? _editingProductName;
    private string? _supplierId;
    private DateOnly? _orderDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _expectedDeliveryDate;
    private string? _supplierReference;
    private string? _notes;
    private string _selectedProductId = string.Empty;
    private string _draftQtyText = "1";
    private decimal? _draftUnitCost;
    private string _productSearch = string.Empty;
    private Guid? _categoryFilterId;
    private List<LineEntry> _lines = [];
    private List<PosSupplierDto> _suppliers = [];
    private List<PosCatalogProductDto> _products = [];
    private List<LocalLinkedSupplierProduct> _connectedProducts = [];
    private List<SupplierProductExposureDto> _supplierCatalogProducts = [];
    private Dictionary<Guid, string> _categoryNames = new();
    private string? _supplierError;
    private string? _orderDateError;
    private string? _draftQtyError;
    private string? _draftCostError;
    private string? _linesError;
    private string? _errorTitle;
    private string? _errorMessage;
    private ConnectedPoDraftReviewDto? _draftReview;
    private bool _revalidationAccepted;
    private Guid _localDraftId = Guid.NewGuid();
    private SupplierProductExposureDto? _pendingExposure;
    private string? _buyerProductForLink;

    private PosSupplierDto? SelectedSupplier =>
        Guid.TryParse(_supplierId, out var id) ? _suppliers.FirstOrDefault(s => s.SupplierId == id) : null;
    private bool IsConnectedSupplier =>
        string.Equals(SelectedSupplier?.ConnectionType, "ConnectedOrganization", StringComparison.OrdinalIgnoreCase)
        && SelectedSupplier?.ConnectedRelationshipId is not null;

    private IReadOnlyList<SelectOption> SupplierOptions =>
        _suppliers.Select(s => new SelectOption(s.SupplierId.ToString("D"), s.Name)).ToList();
    private IReadOnlyList<SelectOption> BuyerCatalogChoices =>
        _products.Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase))
            .Select(x => new SelectOption(x.ProductId.ToString("D"), x.Name)).ToList();

    private IReadOnlyList<(Guid CategoryId, string Name)> CategoryChips =>
        PurchaseOrderCreateUi.RelevantCategories(
            _products.Select(p => (
                p.CategoryId,
                p.CategoryId is { } id && _categoryNames.TryGetValue(id, out var name) ? name : null)),
            L["Purchasing_Uncategorized"].Value);

    private IReadOnlyList<PosCatalogProductDto> EligibleProducts
    {
        get
        {
            var excluded = _lines.Select(l => l.ProductId).ToHashSet();
            return PurchaseOrderCreateUi.FilterEligibleProducts(
                _products,
                p => p.ProductId,
                p => p.Name,
                p => p.CategoryId,
                excluded,
                _editingProductId,
                _productSearch,
                _categoryFilterId);
        }
    }

    private decimal LinesTotal =>
        PurchaseOrderCreateUi.OrderTotal(_lines.Select(l => (l.OrderedQty, l.UnitPurchaseCost)));

    private bool HasUnsavedDraft =>
        !string.IsNullOrWhiteSpace(_supplierId)
        || _expectedDeliveryDate is not null
        || !string.IsNullOrWhiteSpace(_supplierReference)
        || !string.IsNullOrWhiteSpace(_notes)
        || !string.IsNullOrWhiteSpace(_selectedProductId)
        || _draftUnitCost is not null
        || _editingProductId is not null
        || _lines.Count > 0
        || !string.IsNullOrWhiteSpace(_productSearch)
        || _categoryFilterId is not null
        || (!string.IsNullOrWhiteSpace(_draftQtyText) && _draftQtyText != "1")
        || (_orderDate is not null && _orderDate != DateOnly.FromDateTime(DateTime.Today));

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        _ready = true;

        if (!_isOffline && Capabilities.IsAllowed(UtangCapability.ManagePurchasing))
        {
            await LoadLookupsAsync();
        }
        else if (_isOffline && Capabilities.IsAllowed(UtangCapability.ManagePurchasing))
        {
            await LoadOfflineConnectedSuppliersAsync();
        }
    }

    private async Task LoadLookupsAsync()
    {
        _loadingLookups = true;
        _errorTitle = null;
        _errorMessage = null;

        var suppliersTask = Suppliers.ListAsync(status: "Active", page: 1, pageSize: 200);
        var productsTask = Catalog.ListProductsAsync(pageSize: 200);
        var categoriesTask = Catalog.ListCategoriesAsync(
            status: PosCatalogOptions.ActiveStatus,
            page: 1,
            pageSize: 100);
        await Task.WhenAll(suppliersTask, productsTask, categoriesTask);

        var suppliers = await suppliersTask;
        if (suppliers.IsSuccess && suppliers.Data is not null)
        {
            _suppliers = suppliers.Data.Items
                .Where(s => string.Equals(s.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            var relationships = await ConnectedSuppliers.ListRelationshipsAsync();
            if (relationships.IsSuccess && relationships.Data is not null)
            {
                var relationshipById = relationships.Data.ToDictionary(x => x.RelationshipId);
                var localSuppliers = _suppliers
                    .Where(x => x.ConnectedRelationshipId is Guid id && relationshipById.ContainsKey(id))
                    .Select(x =>
                    {
                        var relationship = relationshipById[x.ConnectedRelationshipId!.Value];
                        return new LocalConnectedSupplier(
                            relationship.RelationshipId,
                            relationship.SupplierOrganizationId,
                            x.SupplierId,
                            x.Name,
                            relationship.Status,
                            DateTimeOffset.UtcNow);
                    }).ToList();
                await LocalConnectedSuppliers.UpsertConnectedSuppliersAsync(localSuppliers);
            }
        }
        else
        {
            var described = ApiLocalizer.Describe(suppliers.Status, suppliers.Error);
            _errorTitle = L["Purchasing_ErrorTitle"];
            _errorMessage = suppliers.Error?.Detail ?? described.Message;
        }

        var products = await productsTask;
        if (products.IsSuccess && products.Data is not null)
        {
            _products = products.Data.Items
                .Where(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else if (string.IsNullOrEmpty(_errorMessage))
        {
            var described = ApiLocalizer.Describe(products.Status, products.Error);
            _errorTitle = L["Purchasing_ErrorTitle"];
            _errorMessage = products.Error?.Detail ?? described.Message;
        }

        var categories = await categoriesTask;
        if (categories.IsSuccess && categories.Data is not null)
        {
            _categoryNames = categories.Data.Items
                .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(c => c.CategoryId, c => c.Name);
        }

        _loadingLookups = false;
    }

    private async Task LoadOfflineConnectedSuppliersAsync()
    {
        var now = DateTimeOffset.UtcNow;
        _suppliers = (await LocalConnectedSuppliers.ListConnectedSuppliersAsync())
            .Where(x => x.BuyerSupplierId is not null)
            .Select(x => new PosSupplierDto(
                x.BuyerSupplierId!.Value,
                Guid.Empty,
                string.Empty,
                x.DisplayName,
                null, null, null, null, null, null, null, null, null, null, null,
                "Active",
                "ConnectedOrganization",
                x.RelationshipId,
                x.LastSyncedUtc ?? now,
                x.LastSyncedUtc ?? now))
            .ToList();
    }

    private async Task OnProductSearchInputAsync(ChangeEventArgs args)
    {
        _productSearch = args.Value?.ToString() ?? string.Empty;
        if (IsConnectedSupplier) await SearchConnectedProductsAsync();
    }

    private async Task OnSupplierChangedAsync(string? value)
    {
        _supplierId = value;
        _connectedProducts = [];
        _supplierCatalogProducts = [];
        ClearDraftEditor();
        if (IsConnectedSupplier) await SearchConnectedProductsAsync();
    }

    private async Task SearchConnectedProductsAsync()
    {
        if (SelectedSupplier?.ConnectedRelationshipId is not Guid relationshipId) return;
        if (_isOffline)
        {
            _connectedProducts = (await LinkedProducts.SearchLocalAsync(relationshipId, _productSearch, 50)).ToList();
            _supplierCatalogProducts = [];
            return;
        }

        var local = await LinkedProducts.SearchLocalAsync(relationshipId, _productSearch, 50);
        _connectedProducts = local.ToList();
        var catalog = await ConnectedSuppliers.SearchCatalogAsync(relationshipId, _productSearch, page: 1, pageSize: 25);
        if (catalog.IsSuccess && catalog.Data is not null)
        {
            var links = await ConnectedSuppliers.ListLinksAsync(relationshipId);
            var bySupplierProduct = links.Data?.Where(x => x.IsActive).ToDictionary(x => x.SupplierProductId) ?? [];
            _connectedProducts = catalog.Data.Items
                .Where(x => bySupplierProduct.ContainsKey(x.ProductId))
                .Select(x =>
                {
                    var link = bySupplierProduct[x.ProductId];
                    return new LocalLinkedSupplierProduct(link.LinkId, relationshipId, link.SupplierOrganizationId,
                        link.BuyerProductId, x.ProductId, x.SkuSnapshot, x.NameSnapshot, x.UnitOfMeasureCode,
                        x.SupplierOrderPrice, x.IsOrderable, x.IsExposed, x.SyncVersion, x.UpdatedAtUtc, DateTimeOffset.UtcNow,
                        link.MultiplierToBase, link.PackageLabel);
                }).ToList();
            _supplierCatalogProducts = catalog.Data.Items
                .Where(x => !bySupplierProduct.ContainsKey(x.ProductId))
                .ToList();
        }
    }

    private void BeginLinkProduct(SupplierProductExposureDto exposure)
    {
        _pendingExposure = exposure;
        _buyerProductForLink = _products.FirstOrDefault(x =>
            (!string.IsNullOrWhiteSpace(exposure.SkuSnapshot)
             && string.Equals(x.Sku, exposure.SkuSnapshot, StringComparison.OrdinalIgnoreCase))
            || string.Equals(x.Name, exposure.NameSnapshot, StringComparison.OrdinalIgnoreCase))
            ?.ProductId.ToString("D");
    }

    private void CancelLinkProduct()
    {
        _pendingExposure = null;
        _buyerProductForLink = null;
    }

    private async Task ConfirmLinkProductAsync()
    {
        if (_pendingExposure is null
            || SelectedSupplier?.ConnectedRelationshipId is not Guid relationshipId
            || !Guid.TryParse(_buyerProductForLink, out var buyerProductId))
        {
            _linesError = L["ConnectedSuppliers_BuyerProductRequired"];
            return;
        }
        var result = await ConnectedSuppliers.LinkProductAsync(
            relationshipId,
            new LinkProductRequest(buyerProductId, _pendingExposure.ExposureId));
        if (!result.IsSuccess)
        {
            _linesError = result.Error?.Detail ?? L["ConnectedSuppliers_LinkFailed"];
            return;
        }
        CancelLinkProduct();
        await SearchConnectedProductsAsync();
        var linked = _connectedProducts.FirstOrDefault(x => x.SupplierProductId == result.Data?.SupplierProductId);
        if (linked is not null) SelectConnectedProduct(linked);
    }


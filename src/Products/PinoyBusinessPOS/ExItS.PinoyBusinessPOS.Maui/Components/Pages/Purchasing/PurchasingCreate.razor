    private void SelectConnectedProduct(LocalLinkedSupplierProduct product)
    {
        _selectedProductId = product.BuyerProductId.ToString("D");
        _draftUnitCost = product.LastKnownOrderPrice;
        _draftCostError = null;
        _draftQtyError = null;
        _linesError = null;
    }

    private bool TryValidateDraft(out Guid productId, out decimal qty, out decimal unitCost)
    {
        productId = Guid.Empty;
        qty = 0m;
        unitCost = 0m;
        _draftQtyError = null;
        _draftCostError = null;
        _linesError = null;

        if (!Guid.TryParse(_selectedProductId, out productId))
        {
            _linesError = L["Purchasing_ProductRequired"];
            return false;
        }

        if (!decimal.TryParse(_draftQtyText.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out qty)
            || qty <= 0m)
        {
            _draftQtyError = L["Purchasing_InvalidOrderedQty"];
            return false;
        }

        if (_draftUnitCost is null || _draftUnitCost.Value <= 0m)
        {
            _draftCostError = L["Purchasing_UnitCostRequired"];
            return false;
        }

        if (_draftUnitCost.Value > PurchaseOrderLine.MaxUnitPurchaseCost)
        {
            _draftCostError = L["Purchasing_InvalidUnitCost"];
            return false;
        }

        unitCost = PosSaleOptions.RoundMoney(_draftUnitCost.Value);
        return true;
    }

    private void AddLine()
    {
        if (!TryValidateDraft(out var productId, out var qty, out var unitCost))
        {
            return;
        }

        if (_lines.Any(l => l.ProductId == productId))
        {
            return;
        }

        var connectedProduct = IsConnectedSupplier
            ? _connectedProducts.FirstOrDefault(p => p.BuyerProductId == productId)
            : null;
        var product = _products.FirstOrDefault(p => p.ProductId == productId);
        if (product is null && connectedProduct is null)
        {
            return;
        }

        var next = PurchaseOrderCreateUi.UpsertLine(
            _lines,
            l => l.ProductId,
            new LineEntry(productId, connectedProduct?.ProductName ?? product!.Name, qty, unitCost, connectedProduct?.SupplierProductId),
            replaceExisting: false);
        _lines = next.ToList();
        ClearDraftEditor();
    }

    private void SaveLineChanges()
    {
        if (_editingProductId is null)
        {
            return;
        }

        if (!TryValidateDraft(out var productId, out var qty, out var unitCost))
        {
            return;
        }

        if (productId != _editingProductId.Value)
        {
            _linesError = L["Purchasing_ProductRequired"];
            return;
        }

        var existing = _lines.FirstOrDefault(l => l.ProductId == productId);
        if (existing is null)
        {
            return;
        }

        var next = PurchaseOrderCreateUi.UpsertLine(
            _lines,
            l => l.ProductId,
            existing with { OrderedQty = qty, UnitPurchaseCost = unitCost },
            replaceExisting: true);
        _lines = next.ToList();
        ClearDraftEditor();
    }


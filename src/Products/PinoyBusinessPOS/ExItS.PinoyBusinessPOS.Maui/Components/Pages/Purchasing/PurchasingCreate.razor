    {
        _supplierId = null;
        _orderDate = DateOnly.FromDateTime(DateTime.Today);
        _expectedDeliveryDate = null;
        _supplierReference = null;
        _notes = null;
        _paymentTerm = "Cash";
        _productSearch = string.Empty;
        _categoryFilterId = null;
        ClearDraftEditor();
        _lines = [];
        _supplierError = null;
        _orderDateError = null;
        _confirmDelete = false;
        _pendingDeleteProductId = null;
        _errorTitle = null;
        _errorMessage = null;
    }

    private async Task SaveAsync()
    {
        if (_saving || !Capabilities.IsAllowed(UtangCapability.ManagePurchasing))
        {
            return;
        }

        _supplierError = null;
        _orderDateError = null;
        _linesError = null;
        _errorTitle = null;
        _errorMessage = null;

        var valid = true;
        if (!Guid.TryParse(_supplierId, out var supplierId))
        {
            _supplierError = L["Purchasing_SupplierRequired"];
            valid = false;
        }

        if (_orderDate is null)
        {
            _orderDateError = L["Purchasing_OrderDateRequired"];
            valid = false;
        }

        if (_lines.Count == 0)
        {
            _linesError = L["Purchasing_LinesRequired"];
            valid = false;
        }
        else if (_lines.Any(l => l.UnitPurchaseCost <= 0m))
        {
            _linesError = L["Purchasing_UnitCostRequired"];
            valid = false;
        }

        if (!valid)
        {
            return;
        }

        if (_isOffline)
        {
            if (!IsConnectedSupplier || SelectedSupplier?.ConnectedRelationshipId is not Guid offlineRelationshipId) return;
            var payload = JsonSerializer.Serialize(new
            {
                SupplierId = supplierId,
                OrderDate = _orderDate,
                ExpectedDeliveryDate = _expectedDeliveryDate,
                SupplierReference = _supplierReference,
                Notes = _notes,
                Lines = _lines
            });
            await ConnectedDrafts.SaveAsync(new(
                _localDraftId,
                offlineRelationshipId,
                supplierId,
                payload,
                LocalEntitySyncState.PendingCreate,
                DateTimeOffset.UtcNow));
            _errorTitle = L["ConnectedSuppliers_SavedOnDevice"];
            _errorMessage = L["ConnectedSuppliers_WaitingToSync"];
            return;
        }

        if (IsConnectedSupplier && !_revalidationAccepted && SelectedSupplier?.ConnectedRelationshipId is Guid relationshipId)
        {
            var review = await ConnectedSuppliers.RevalidateDraftAsync(
                relationshipId,
                new(_lines.Where(x => x.SupplierProductId is not null)
                    .Select(x => new DraftReviewLineRequest(x.SupplierProductId!.Value, x.UnitPurchaseCost)).ToList()));
            if (!review.IsSuccess || review.Data is null)
            {
                _errorTitle = L["ConnectedSuppliers_ReviewChanges"];
                _errorMessage = review.Error?.Detail ?? L["ConnectedSuppliers_RevalidateFailed"];
                return;
            }
            if (review.Data.OverallStatus != ConnectedPoDraftReviewStatus.Unchanged)
            {
                _draftReview = review.Data;
                return;
            }
        }

        _saving = true;
        var request = new CreatePurchaseOrderRequest(
            supplierId,
            _orderDate!.Value,
            _lines.Select(l => new CreatePurchaseOrderLineRequest(l.ProductId, l.OrderedQty, l.UnitPurchaseCost)).ToList(),
            ExpectedDeliveryDate: _expectedDeliveryDate,
            SupplierReference: string.IsNullOrWhiteSpace(_supplierReference) ? null : _supplierReference.Trim(),
            Notes: string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            PaymentTerm: IsConnectedSupplier ? _paymentTerm : null);

        var result = await Purchasing.CreateAsync(request);
        _saving = false;

        if (result.IsSuccess && result.Data is not null)
        {
            DraftSession.Clear();
            Nav.NavigateTo($"/purchasing/{result.Data.PurchaseOrderId:D}", replace: true);
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = L["Purchasing_ErrorTitle"];
        _errorMessage = result.Error?.Detail ?? described.Message;
    }

    private async Task UpdateAndContinueAsync()
    {
        if (_draftReview is null) return;
        foreach (var reviewItem in _draftReview.Items.Where(x => x.Status == ConnectedPoDraftReviewStatus.PriceChanged && x.CurrentPrice is not null))
        {
            var index = _lines.FindIndex(x => x.SupplierProductId == reviewItem.SupplierProductId);
            if (index >= 0 && reviewItem.CurrentPrice is decimal currentPrice)
                _lines[index] = _lines[index] with { UnitPurchaseCost = currentPrice };
        }
        RemoveUnavailableItems();
        _revalidationAccepted = true;
        _draftReview = null;
        await SaveAsync();
        _revalidationAccepted = false;
    }

    private void RemoveUnavailableItems()
    {
        if (_draftReview is null) return;
        var unavailable = _draftReview.Items
            .Where(x => x.Status is ConnectedPoDraftReviewStatus.Unavailable or ConnectedPoDraftReviewStatus.RelationshipInactive)
            .Select(x => x.SupplierProductId)
            .ToHashSet();
        _lines.RemoveAll(x => x.SupplierProductId is Guid id && unavailable.Contains(id));
    }

    private void GoCreateSupplier() => Nav.NavigateTo("/suppliers/new");

    private static string FormatQty(decimal qty) =>
        qty.ToString("0.###", CultureInfo.InvariantCulture);
}

        if (_qtyBusy || _saving)
        {
            return;
        }

        _lines = PurchaseOrderCreateUi.RemoveLine(_lines, l => l.ProductId, productId).ToList();
        _linesError = null;
    }

    private void CancelDeleteLine()
    {
        _confirmDelete = false;
        _pendingDeleteProductId = null;
    }

    private void ConfirmDeleteLine()
    {
        if (_pendingDeleteProductId is { } productId)
        {
            if (_editingProductId == productId)
            {
                ClearDraftEditor();
            }

            _lines = PurchaseOrderCreateUi.RemoveLine(_lines, l => l.ProductId, productId).ToList();
        }

        _confirmDelete = false;
        _pendingDeleteProductId = null;
    }

    private void RequestReset()
    {
        if (!HasUnsavedDraft)
        {
            return;
        }

        _confirmReset = true;
    }


    private void AdjustConnectedQty(LocalLinkedSupplierProduct product, int delta)
    {
        if (_qtyBusy || _saving)
        {
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManagePurchasing))
        {
            return;
        }

        _qtyBusy = true;
        try
        {
            if (!HasSupplierSelected)
            {
                _linesError = L["Purchasing_SelectSupplierFirst"];
                return;
            }

            if (delta > 0
                && !_lines.Any(l => l.ProductId == product.BuyerProductId)
                && product.LastKnownOrderPrice <= 0m)
            {
                _linesError = L["Purchasing_UnitCostRequired"];
                return;
            }

            var unitCost = PosSaleOptions.RoundMoney(product.LastKnownOrderPrice);
            _lines = PurchaseOrderCreateUi.ApplyConnectedQuantityDelta(
                _lines,
                l => l.ProductId,
                l => l.OrderedQty,
                (l, qty) => l with { OrderedQty = qty },
                () => new LineEntry(
                    product.BuyerProductId,
                    product.ProductName,
                    1m,
                    unitCost,
                    product.SupplierProductId),
                product.BuyerProductId,
                delta).ToList();
            _linesError = null;
            _draftCostError = null;
        }
        finally
        {
            _qtyBusy = false;
        }
    }

    private bool TryValidateDraft(out Guid productId, out decimal qty, out decimal unitCost)
    {
        productId = Guid.Empty;
        qty = 0m;
        unitCost = 0m;
        _draftQtyError = null;
        _draftCostError = null;
        _linesError = null;

        if (!Guid.TryParse(_selectedProductId, out productId))
        {
            _linesError = L["Purchasing_ProductRequired"];
            return false;
        }

        if (!decimal.TryParse(_draftQtyText.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out qty)
            || qty <= 0m)
        {
            _draftQtyError = L["Purchasing_InvalidOrderedQty"];
            return false;
        }

        if (IsConnectedSupplier)
        {
            var selectedBuyerProductId = productId;
            var connected = _connectedReadyAll.FirstOrDefault(p => p.BuyerProductId == selectedBuyerProductId);
            if (connected is null || connected.LastKnownOrderPrice <= 0m)
            {
                _draftCostError = L["Purchasing_UnitCostRequired"];
                return false;
            }

            _draftUnitCost = connected.LastKnownOrderPrice;
            unitCost = PosSaleOptions.RoundMoney(connected.LastKnownOrderPrice);
            return true;
        }

        if (_draftUnitCost is null || _draftUnitCost.Value <= 0m)
        {
            _draftCostError = L["Purchasing_UnitCostRequired"];
            return false;
        }

        if (_draftUnitCost.Value > PurchaseOrderLine.MaxUnitPurchaseCost)
        {
            _draftCostError = L["Purchasing_InvalidUnitCost"];
            return false;
        }

        unitCost = PosSaleOptions.RoundMoney(_draftUnitCost.Value);
        return true;
    }

    private void AddLine()
    {
        if (!HasSupplierSelected)
        {
            _linesError = L["Purchasing_SelectSupplierFirst"];
            return;
        }

        if (!TryValidateDraft(out var productId, out var qty, out var unitCost))
        {
            return;
        }

        if (_lines.Any(l => l.ProductId == productId))
        {
            return;
        }

        var connectedProduct = IsConnectedSupplier
            ? _connectedReadyAll.FirstOrDefault(p => p.BuyerProductId == productId)
            : null;
        var product = _products.FirstOrDefault(p => p.ProductId == productId);
        if (product is null && connectedProduct is null)
        {
            return;
        }

        var next = PurchaseOrderCreateUi.UpsertLine(
            _lines,
            l => l.ProductId,
            new LineEntry(productId, connectedProduct?.ProductName ?? product!.Name, qty, unitCost, connectedProduct?.SupplierProductId),
            replaceExisting: false);
        _lines = next.ToList();
        ClearDraftEditor();
    }

    private void SaveLineChanges()
    {
        if (_editingProductId is null)
        {
            return;
        }

        if (!TryValidateDraft(out var productId, out var qty, out var unitCost))
        {
            return;
        }

        if (productId != _editingProductId.Value)
        {
            _linesError = L["Purchasing_ProductRequired"];
            return;
        }

        var existing = _lines.FirstOrDefault(l => l.ProductId == productId);
        if (existing is null)
        {
            return;
        }

        var next = PurchaseOrderCreateUi.UpsertLine(
            _lines,
            l => l.ProductId,
            existing with { OrderedQty = qty, UnitPurchaseCost = unitCost },
            replaceExisting: true);
        _lines = next.ToList();
        ClearDraftEditor();
    }


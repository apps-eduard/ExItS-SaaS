            .Select(x => new PosSupplierDto(
                x.BuyerSupplierId!.Value,
                Guid.Empty,
                string.Empty,
                x.DisplayName,
                null, null, null, null, null, null, null, null, null, null, null,
                "Active",
                "ConnectedOrganization",
                x.RelationshipId,
                x.LastSyncedUtc ?? now,
                x.LastSyncedUtc ?? now))
            .ToList();
    }

    private void OnProductSearchInputAsync(ChangeEventArgs args)
    {
        _productSearch = args.Value?.ToString() ?? string.Empty;
    }

    private async Task OnSupplierChangedAsync(string? value)
    {
        if (PurchaseOrderCreateUi.RequiresSupplierChangeConfirmation(_supplierId, value, _lines.Count))
        {
            var oldName = SelectedSupplier?.Name ?? L["Purchasing_Field_Supplier"];
            _pendingSupplierId = value;
            _supplierChangeMessage = L["Purchasing_ChangeSupplierMessage", _lines.Count, oldName];
            _confirmSupplierChange = true;
            return;
        }

        await ApplySupplierChangeAsync(value);
    }

    private async Task ApplySupplierChangeAsync(string? value)
    {
        _supplierId = value;
        ClearSupplierDependentDraftState();
        if (IsConnectedSupplier)
        {
            await SearchConnectedProductsAsync();
            await LoadReadinessAsync();
        }
    }

    private async Task ConfirmSupplierChangeAsync()
    {
        var next = _pendingSupplierId;
        _pendingSupplierId = null;
        _confirmSupplierChange = false;
        _supplierChangeMessage = string.Empty;
        await ApplySupplierChangeAsync(next);
    }

    private void CancelSupplierChange()
    {
        _pendingSupplierId = null;
        _confirmSupplierChange = false;
        _supplierChangeMessage = string.Empty;
    }

    private void ClearSupplierDependentDraftState()
    {
        _lines = [];
        _connectedReadyAll = [];
        _readinessReady = 0;
        _readinessNew = 0;
        _readinessReview = 0;
        _readinessConflict = 0;
        _productSearch = string.Empty;
        _categoryFilterId = null;
        _draftReview = null;
        _revalidationAccepted = false;
        ClearDraftEditor();
        _linesError = null;
    }

    private async Task LoadReadinessAsync()
    {
        _readinessReady = 0;
        _readinessNew = 0;
        _readinessReview = 0;
        _readinessConflict = 0;
        if (_isOffline || SelectedSupplier?.ConnectedRelationshipId is not Guid relationshipId)
        {
            return;
        }

        _loadingReadiness = true;
        try
        {
            var readiness = await ConnectedSuppliers.ClassifyCatalogReadinessAsync(relationshipId);
            if (readiness.IsSuccess && readiness.Data is not null)
            {
                _readinessReady = readiness.Data.Ready;
                _readinessNew = readiness.Data.New;
                _readinessReview = readiness.Data.Review;
                _readinessConflict = readiness.Data.Conflict;
            }
        }
        finally
        {
            _loadingReadiness = false;
        }
    }

    private async Task SearchConnectedProductsAsync()
    {
        if (SelectedSupplier?.ConnectedRelationshipId is not Guid relationshipId)
        {
            return;
        }

        var local = await LinkedProducts.ListByRelationshipAsync(relationshipId);
        var localSnapshots = local.Select(ToReadySnapshot).ToList();
        if (_isOffline)
        {
            _connectedReadyAll = PurchaseOrderCreateUi.FilterOfflineReadyProducts(localSnapshots)
                .Select(s => ApplyBuyerCatalog(ToLocalProduct(relationshipId, s, local)))
                .ToList();
            return;
        }

        var links = await ConnectedSuppliers.ListLinksAsync(relationshipId);
        if (!links.IsSuccess || links.Data is null)
        {
            _connectedReadyAll = PurchaseOrderCreateUi.FilterOfflineReadyProducts(localSnapshots)
                .Select(s => ApplyBuyerCatalog(ToLocalProduct(relationshipId, s, local)))
                .ToList();
            return;
        }

        var serverSnapshots = links.Data
            .Where(x => x.IsActive)
            .Select(ToReadySnapshot)
            .ToList();
        _connectedReadyAll = PurchaseOrderCreateUi.ReconcileOnlineReadyProducts(serverSnapshots, localSnapshots)
            .Select(s => ApplyBuyerCatalog(ToLocalProduct(relationshipId, s, local)))
            .ToList();
    }

    private static PurchaseOrderCreateUi.LinkedReadyProduct ToReadySnapshot(LocalLinkedSupplierProduct product) =>
        new(
            product.LinkId,
            product.BuyerProductId,
            product.SupplierProductId,
            product.ProductName,
            product.UnitOfMeasure,
            product.LastKnownOrderPrice,
            product.IsOrderable,
            product.IsActive,
            product.SupplierSku);

    private static PurchaseOrderCreateUi.LinkedReadyProduct ToReadySnapshot(BuyerSupplierProductLinkDto link) =>
        new(
            link.LinkId,
            link.BuyerProductId,
            link.SupplierProductId,
            link.SupplierNameSnapshot,
            link.UnitOfMeasureCode,
            link.LastKnownOrderPrice,
            IsOrderable: link.IsActive && link.LastKnownOrderPrice > 0m,
            link.IsActive,
            link.SupplierSkuSnapshot);

    private static LocalLinkedSupplierProduct ToLocalProduct(
        Guid relationshipId,
        PurchaseOrderCreateUi.LinkedReadyProduct ready,
        IReadOnlyList<LocalLinkedSupplierProduct> local)
    {
        var match = local.FirstOrDefault(x => x.BuyerProductId == ready.BuyerProductId);
        return new LocalLinkedSupplierProduct(
            ready.LinkId,
            relationshipId,
            match?.SupplierOrganizationId ?? Guid.Empty,
            ready.BuyerProductId,
            ready.SupplierProductId,
            ready.SupplierSku,
            ready.ProductName,
            ready.UnitOfMeasure,
            ready.LastKnownOrderPrice,
            ready.IsOrderable,
            ready.IsActive,
            match?.SyncVersion ?? 0,
            match?.SupplierUpdatedAtUtc ?? DateTimeOffset.UtcNow,
            match?.SyncedAtUtc ?? DateTimeOffset.UtcNow,
            match?.MultiplierToBase ?? 1m,
            match?.PackageLabel);
    }

    private LocalLinkedSupplierProduct ApplyBuyerCatalog(LocalLinkedSupplierProduct product)
    {
        var buyer = _products.FirstOrDefault(p => p.ProductId == product.BuyerProductId);
        if (buyer is null)
        {
            return product;
        }

        var name = string.IsNullOrWhiteSpace(buyer.Name) ? product.ProductName : buyer.Name;
        var unit = string.IsNullOrWhiteSpace(buyer.UnitOfMeasure) ? product.UnitOfMeasure : buyer.UnitOfMeasure;
        return product with { ProductName = name, UnitOfMeasure = unit };
    }

    private Guid? BuyerCategoryId(Guid buyerProductId) =>
        _products.FirstOrDefault(p => p.ProductId == buyerProductId)?.CategoryId;

    private IEnumerable<string?> ConnectedSearchTokens(LocalLinkedSupplierProduct product)
    {
        var buyer = _products.FirstOrDefault(p => p.ProductId == product.BuyerProductId);
        return [product.SupplierSku, buyer?.Sku, buyer?.Barcode];
    }

    private string? ResolveLineUnit(LineEntry line)
    {
        var connected = _connectedReadyAll.FirstOrDefault(p => p.BuyerProductId == line.ProductId);
        if (!string.IsNullOrWhiteSpace(connected?.UnitOfMeasure))
        {
            return connected.UnitOfMeasure;
        }

        return _products.FirstOrDefault(p => p.ProductId == line.ProductId)?.UnitOfMeasure;
    }

    private void GoManageSupplierProducts(string? filter)
    {
        if (SelectedSupplier?.ConnectedRelationshipId is not Guid relationshipId)
        {
            return;
        }

        PersistDraftSession();
        var returnUrl = Uri.EscapeDataString("/purchasing/new");
        var filterPart = string.IsNullOrWhiteSpace(filter) ? string.Empty : $"&filter={Uri.EscapeDataString(filter)}";
        Nav.NavigateTo(
            $"/suppliers/{SelectedSupplier.SupplierId:D}/connected-catalog?relationshipId={relationshipId:D}{filterPart}&returnUrl={returnUrl}");
    }


@page "/customers/{CustomerId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject OfflineAwareNavigation OfflineNav
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync
@inject ILocalCustomerCreditStore LocalStore
@inject IConnectivityService Connectivity
@inject ILocalContextManager LocalContext
@inject IPlatformAccessClient Platform

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<StoreHeaderBack Href="/customers" />
@if (_loading)
{
    <Page><Spinner /><span>@L["Customers_Loading"]</span></Page>
}
else if (_customer is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Customers_NotFoundTitle"])" Message="@(_errorMessage ?? L["Customers_NotFoundMessage"])" RetryLabel="@L["Api_Retry"]" OnRetry="LoadAsync" />
    </Page>
}
else
{
    var customer = _customer;
    var canEdit = Capabilities.IsAllowed(UtangCapability.EditCustomer);
    var canCreateCredit = Capabilities.IsAllowed(UtangCapability.CreateCredit);
    var canReverseCredit = Capabilities.IsAllowed(UtangCapability.ReverseCredit);
    var canStatement = Capabilities.IsAllowed(UtangCapability.ViewGenerateStatement);
    var canRepay = Capabilities.IsAllowed(UtangCapability.RecordRepayment);
    var outstanding = _utang?.OutstandingAmount ?? _localBalance?.ProjectedOutstanding ?? 0m;
    var canRecordPayment = (!_isOffline || Sync.CanMutateOffline)
        && (_utang is not null || _showLocalBalance)
        && outstanding > 0m
        && canRepay;
    var isActive = customer.Status == "Active";
<div class="pos-customer-detail">
<Page>
    <header class="pos-customer-detail__header">
        <div class="pos-customer-detail__title-row">
            <h1 class="pos-customer-detail__title">@customer.DisplayName</h1>
            @if (isActive)
            {
                <button type="button"
                        class="pos-customer-detail__edit"
                        disabled="@(!canEdit)"
                        aria-label="@L["Customers_Edit"]"
                        @onclick="GoEdit">
                    <span class="pos-customer-detail__edit-icon" aria-hidden="true">@IconGlyphs.Get("edit")</span>
                    <span>@L["Customers_Edit"]</span>
                </button>
            }
        </div>
        <p class="pos-customer-detail__subtitle">@L["Customers_DetailSubtitle"]</p>
        <div class="pos-customer-detail__status-row">
            <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">@customer.Status</Badge>
            @if (_entityState is { } state && OfflineCustomerCreditUiHelpers.EntityBadge(state) is { } badge)
            {
                <Badge Tone="@badge.Tone">@L[badge.LabelKey]</Badge>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_pendingLinkBanner))
    {
        <Alert Tone="AlertTone.Info" Title="@L["CustomerLink_PendingTitle"]" Message="@_pendingLinkBanner" />
    }

    @if (_showRecoveryBanner)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Offline_RecoveryRequired"]" Message="@L["Offline_ConflictMessage"]" />
    }

    @if (_entityState == LocalEntitySyncState.Conflict)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Offline_ConflictTitle"]" Message="@L["Offline_ConflictMessage"]" />
        <div class="pos-action-grid pos-action-grid--single pos-customer-detail__conflict">
            <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="GoEdit">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("edit")</span>
                <span class="pos-action-tile__label">@L["Customers_Edit"]</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Customers_ErrorTitle"])" Message="@_errorMessage" />
    }

    @if (!canEdit || !canCreateCredit || !canReverseCredit || !canStatement)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    <p class="pos-customer-detail__note">@L["Utang_DeferredMessage"]</p>

    <section class="pos-customer-detail__panel" aria-labelledby="customer-profile-heading">
        <h2 id="customer-profile-heading" class="pos-customer-detail__section-title">@L["Customers_ProfileSection"]</h2>
        <dl class="pos-customer-detail__facts">
            <div class="pos-customer-detail__fact">
                <dt>@L["Customers_Field_DisplayName"]</dt>
                <dd>@customer.DisplayName</dd>
            </div>
            <div class="pos-customer-detail__fact">
                <dt>@L["Personal_ExItsIdLabel"]</dt>
                <dd class="pos-wrap">@(string.IsNullOrWhiteSpace(_exItsId) ? L["Customers_NoExItsId"] : _exItsId)</dd>
            </div>
            <div class="pos-customer-detail__fact">
                <dt>@L["CustomerLink_StatusLabel"]</dt>
                <dd>@_linkStatusLabel</dd>
            </div>
            <div class="pos-customer-detail__fact">
                <dt>@L["Customers_Field_Mobile"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(customer.MobileNumber) ? L["Customers_NoMobile"] : customer.MobileNumber)</dd>
            </div>
            <div class="pos-customer-detail__fact">
                <dt>@L["Customers_Field_Address"]</dt>
                <dd class="pos-wrap">@(string.IsNullOrWhiteSpace(customer.Address) ? L["Customers_NoValue"] : customer.Address)</dd>
            </div>
            <div class="pos-customer-detail__fact">
                <dt>@L["Customers_Field_Notes"]</dt>
                <dd class="pos-wrap">@(string.IsNullOrWhiteSpace(_notesDisplay) ? L["Customers_NoValue"] : _notesDisplay)</dd>
            </div>
        </dl>
    </section>

    <section class="pos-customer-detail__panel" aria-labelledby="customer-utang-heading">
        <h2 id="customer-utang-heading" class="pos-customer-detail__section-title">@L["Utang_SectionTitle"]</h2>

        @if (_showLocalBalance && _localBalance is not null)
        {
            <div class="pos-customer-detail__balance">
                <span class="pos-customer-detail__balance-label">@L["Offline_ProjectedOutstanding"]</span>
                <div class="pos-customer-detail__balance-value">
                    <MoneyDisplay Amount="@_localBalance.ProjectedOutstanding" CurrencyCode="PHP" Emphasized="true" />
                </div>
            </div>
            <div class="pos-customer-detail__stats" role="list">
                <div class="pos-customer-detail__stat" role="listitem">
                    <span class="pos-customer-detail__stat-label">@L["Offline_ConfirmedOutstanding"]</span>
                    <span class="pos-customer-detail__stat-value"><MoneyDisplay Amount="@_localBalance.ConfirmedOutstanding" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-customer-detail__stat" role="listitem">
                    <span class="pos-customer-detail__stat-label">@L["Offline_PendingCredit"]</span>
                    <span class="pos-customer-detail__stat-value"><MoneyDisplay Amount="@_localBalance.PendingCredit" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-customer-detail__stat" role="listitem">
                    <span class="pos-customer-detail__stat-label">@L["Offline_PendingRepayment"]</span>
                    <span class="pos-customer-detail__stat-value"><MoneyDisplay Amount="@_localBalance.PendingRepayment" CurrencyCode="PHP" /></span>
                </div>
            </div>
        }
        else
        {
            <div class="pos-customer-detail__balance">
                <span class="pos-customer-detail__balance-label">@L["Credit_Outstanding"]</span>
                <div class="pos-customer-detail__balance-value">
                    @if (_utang is null)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <MoneyDisplay Amount="@_utang.OutstandingAmount" CurrencyCode="PHP" Emphasized="true" />
                    }
                </div>
            </div>
            @if (_utang is not null)
            {
                <div class="pos-customer-detail__stats" role="list">
                    <div class="pos-customer-detail__stat" role="listitem">
                        <span class="pos-customer-detail__stat-label">@L["Utang_CreditsTotal"]</span>
                        <span class="pos-customer-detail__stat-value"><MoneyDisplay Amount="@_utang.ActiveCreditTotal" CurrencyCode="PHP" /></span>
                    </div>
                    <div class="pos-customer-detail__stat" role="listitem">
                        <span class="pos-customer-detail__stat-label">@L["Utang_PaymentsTotal"]</span>
                        <span class="pos-customer-detail__stat-value"><MoneyDisplay Amount="@_utang.ActiveRepaymentTotal" CurrencyCode="PHP" /></span>
                    </div>
                    <div class="pos-customer-detail__stat" role="listitem">
                        <span class="pos-customer-detail__stat-label">@L["Overdue_Amount"]</span>
                        <span class="pos-customer-detail__stat-value"><MoneyDisplay Amount="@_utang.OverdueAmount" CurrencyCode="PHP" /></span>
                    </div>
                    <div class="pos-customer-detail__stat" role="listitem">
                        <span class="pos-customer-detail__stat-label">@L["Overdue_Count"]</span>
                        <span class="pos-customer-detail__stat-value">@_utang.OverdueCreditCount</span>
                    </div>
                    <div class="pos-customer-detail__stat" role="listitem">
                        <span class="pos-customer-detail__stat-label">@L["Overdue_Earliest"]</span>
                        <span class="pos-customer-detail__stat-value">@(_utang.EarliestOverdueDate?.ToString("d") ?? L["Customers_NoValue"])</span>
                    </div>
                    <div class="pos-customer-detail__stat" role="listitem">
                        <span class="pos-customer-detail__stat-label">@L["Overdue_NextDue"]</span>
                        <span class="pos-customer-detail__stat-value">@(_utang.NextUpcomingDueDate?.ToString("d") ?? L["Customers_NoValue"])</span>
                    </div>
                </div>
            }
        }

        <div class="pos-action-grid pos-action-grid--two pos-customer-detail__actions" role="group" aria-label="@L["Utang_SectionTitle"]">
            @if (isActive)
            {
                <button type="button" class="pos-action-tile" disabled="@(!canCreateCredit)" @onclick="GoAddCredit">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                    <span class="pos-action-tile__label">@L["Credit_Add"]</span>
                </button>
            }
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(!canRecordPayment)"
                    @onclick="GoAddPayment">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                <span class="pos-action-tile__label">@L["Payment_Record"]</span>
            </button>
            <button type="button" class="pos-action-tile" disabled="@_isOffline" @onclick="GoLedger">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                <span class="pos-action-tile__label">@L["Ledger_Open"]</span>
            </button>
            <button type="button" class="pos-action-tile" disabled="@_isOffline" @onclick="GoOverdue">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                <span class="pos-action-tile__label">@L["Overdue_OpenDetail"]</span>
            </button>
            <button type="button" class="pos-action-tile" disabled="@(!canStatement || _isOffline)" @onclick="GoStatement">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                <span class="pos-action-tile__label">@L["Statement_Open"]</span>
            </button>
        </div>

        @if (_isOffline && !Sync.CanMutateOffline)
        {
            <Alert Tone="AlertTone.Info" Title="@L["SyncStatus_Offline"]" Message="@L["Offline_MutationsUnavailable"]" />
        }
        @if (!isActive)
        {
            <Alert Tone="AlertTone.Info" Title="@L["Payment_InactiveAllowedTitle"]" Message="@L["Payment_InactiveAllowedMessage"]" />
        }
    </section>

    <section class="pos-customer-detail__panel" aria-labelledby="customer-credit-heading">
        <h2 id="customer-credit-heading" class="pos-customer-detail__section-title">@L["Credit_HistoryTitle"]</h2>
        @if (_entriesLoading)
        {
            <div class="pos-customer-detail__loading"><Spinner /><span>@L["Credit_HistoryLoading"]</span></div>
        }
        else if (_entries.Count == 0 && _localCreditEntries.Count == 0)
        {
            <EmptyState Title="@L["Credit_HistoryEmptyTitle"]" Message="@L["Credit_HistoryEmptyMessage"]" />
        }
        else if (_isOffline || _fromLocalCredits)
        {
            <div class="pos-customer-detail__list" role="list">
                @foreach (var entry in _localCreditEntries)
                {
                    <article class="pos-customer-detail__entry" role="listitem">
                        <div class="pos-customer-detail__entry-top">
                            <span class="pos-customer-detail__entry-amount"><MoneyDisplay Amount="@entry.Amount" CurrencyCode="PHP" /></span>
                            <div class="pos-customer-detail__entry-badges">
                                <Badge Tone="@(entry.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@entry.Status</Badge>
                                @if (OfflineCustomerCreditUiHelpers.EntityBadge(entry.EntityState) is { } entryBadge)
                                {
                                    <Badge Tone="@entryBadge.Tone">@L[entryBadge.LabelKey]</Badge>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                        {
                            <p class="pos-customer-detail__entry-remarks pos-wrap">@entry.Remarks</p>
                        }
                        <p class="pos-customer-detail__entry-meta">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                        @if (entry.Status == "Active")
                        {
                            <div class="pos-customer-detail__entry-actions">
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoCreditDetail(entry.CreditEntryId)">@L["DueDate_OpenCredit"]</Button>
                            </div>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="pos-customer-detail__list" role="list">
                @foreach (var entry in _entries)
                {
                    <article class="pos-customer-detail__entry" role="listitem">
                        <div class="pos-customer-detail__entry-top">
                            <span class="pos-customer-detail__entry-amount"><MoneyDisplay Amount="@entry.Amount" CurrencyCode="PHP" /></span>
                            <div class="pos-customer-detail__entry-badges">
                                <Badge Tone="@(entry.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@entry.Status</Badge>
                                @if (entry.CurrentDueDate is null)
                                {
                                    <Badge Tone="BadgeTone.Neutral">@L["DueDate_Badge_NoDueDate"]</Badge>
                                }
                                else
                                {
                                    <Badge Tone="BadgeTone.Warning">@L["DueDate_Current"]: @entry.CurrentDueDate.Value.ToString("d")</Badge>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                        {
                            <p class="pos-customer-detail__entry-remarks pos-wrap">@entry.Remarks</p>
                        }
                        <p class="pos-customer-detail__entry-meta">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                        @if (entry.SourceSaleId is not null)
                        {
                            <p class="pos-customer-detail__entry-meta">
                                <a class="pos-link" href="@($"/sales/{entry.SourceSaleId.Value:D}")">@L["Credit_LinkedSale"]</a>
                            </p>
                        }
                        @if (entry.Status == "Reversed")
                        {
                            <p class="pos-customer-detail__entry-meta pos-wrap">@L["Credit_ReversalReason"]: @entry.ReversalReason</p>
                        }
                        else
                        {
                            <div class="pos-customer-detail__entry-actions">
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoCreditDetail(entry.CreditEntryId)">@L["DueDate_OpenCredit"]</Button>
                                @if (entry.SourceSaleId is null)
                                {
                                    <Button Variant="ButtonVariant.Danger" Disabled="@(!canReverseCredit)" OnClick="() => BeginReverseCredit(entry)">@L["Credit_Reverse"]</Button>
                                }
                            </div>
                            @if (entry.SourceSaleId is not null)
                            {
                                <p class="pos-customer-detail__entry-hint">@L["Credit_ReverseViaSaleVoid"]</p>
                            }
                        }
                    </article>
                }
            </div>
        }
    </section>

    @if (_isOffline || _localRepayments.Count > 0)
    {
        <section class="pos-customer-detail__panel" aria-labelledby="customer-payments-heading">
            <h2 id="customer-payments-heading" class="pos-customer-detail__section-title">@L["Utang_PaymentsTotal"]</h2>
            @if (_repaymentsLoading)
            {
                <div class="pos-customer-detail__loading"><Spinner /><span>@L["Payment_Loading"]</span></div>
            }
            else if (_localRepayments.Count == 0)
            {
                <EmptyState Title="@L["Payment_NotFoundTitle"]" Message="@L["Payment_NotFoundMessage"]" />
            }
            else
            {
                <div class="pos-customer-detail__list" role="list">
                    @foreach (var repayment in _localRepayments)
                    {
                        <article class="pos-customer-detail__entry" role="listitem">
                            <div class="pos-customer-detail__entry-top">
                                <span class="pos-customer-detail__entry-amount"><MoneyDisplay Amount="@repayment.Amount" CurrencyCode="PHP" /></span>
                                <div class="pos-customer-detail__entry-badges">
                                    <Badge Tone="@(repayment.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@repayment.Status</Badge>
                                    @if (OfflineCustomerCreditUiHelpers.EntityBadge(repayment.EntityState) is { } repaymentBadge)
                                    {
                                        <Badge Tone="@repaymentBadge.Tone">@L[repaymentBadge.LabelKey]</Badge>
                                    }
                                </div>
                            </div>
                            <p class="pos-customer-detail__entry-remarks pos-wrap">@(string.IsNullOrWhiteSpace(repayment.Remarks) ? L["Customers_NoValue"] : repayment.Remarks)</p>
                            <p class="pos-customer-detail__entry-meta">@repayment.RecordedAtUtc.ToLocalTime().ToString("g")</p>
                            <div class="pos-customer-detail__entry-actions">
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoRepaymentDetail(repayment.RepaymentId)">@L["Payment_View"]</Button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }

    <section class="pos-customer-detail__panel" aria-labelledby="customer-account-heading">
        <h2 id="customer-account-heading" class="pos-customer-detail__section-title">@L["Customers_AccountSection"]</h2>
        <div class="pos-customer-detail__account">
            @if (isActive)
            {
                <Button Variant="ButtonVariant.Danger" Disabled="@_isOffline" OnClick="() => _confirmDeactivate = true">@L["Customers_Deactivate"]</Button>
            }
            else
            {
                <Button Variant="ButtonVariant.Primary" Disabled="@_isOffline" OnClick="() => _confirmReactivate = true">@L["Customers_Reactivate"]</Button>
            }
        </div>
    </section>

    @if (_isOffline && !Sync.CanMutateOffline)
    {
        <Alert Tone="AlertTone.Info" Title="@L["SyncStatus_Offline"]" Message="@L["Offline_MutationsUnavailable"]" />
    }

    <ConfirmDialog Visible="@_confirmDeactivate"
                   VisibleChanged="v => _confirmDeactivate = v"
                   Title="@L["Customers_DeactivateTitle"]"
                   Message="@L["Customers_DeactivateMessage"]"
                   Danger="true"
                   ConfirmLabel="@L["Customers_Deactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="DeactivateAsync" />

    <ConfirmDialog Visible="@_confirmReactivate"
                   VisibleChanged="v => _confirmReactivate = v"
                   Title="@L["Customers_ReactivateTitle"]"
                   Message="@L["Customers_ReactivateMessage"]"
                   ConfirmLabel="@L["Customers_Reactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="ReactivateAsync" />

    <ConfirmDialog Visible="@_confirmReverseCredit"
                   VisibleChanged="OnReverseCreditVisibleChanged"
                   Title="@L["Credit_ReverseTitle"]"
                   Message="@L["Credit_ReverseMessage"]"
                   Danger="true"
                   ShowReason="true"
                   Reason="@_creditReversalReason"
                   ReasonChanged="v => _creditReversalReason = v"
                   ReasonLabel="@L["Credit_Field_ReversalReason"]"
                   ConfirmLabel="@L["Credit_Reverse"]"
                   IsLoading="@_acting"
                   OnConfirm="ReverseCreditAsync" />
</Page>
</div>
}
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "pending")]
    public int? Pending { get; set; }

    [SupplyParameterFromQuery(Name = "pendingLink")]
    public int? PendingLink { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _entriesLoading;
    private bool _repaymentsLoading;
    private bool _acting;
    private bool _confirmDeactivate;
    private bool _confirmReactivate;
    private bool _confirmReverseCredit;
    private bool _isOffline;
    private bool _showLocalBalance;
    private bool _fromLocalCredits;
    private bool _showRecoveryBanner;
    private PosCustomerDetailDto? _customer;
    private LocalEntitySyncState? _entityState;
    private PosCustomerUtangSummaryDto? _utang;
    private LocalCustomerBalanceProjection? _localBalance;
    private List<PosCreditEntryDto> _entries = [];
    private List<LocalCreditProjection> _localCreditEntries = [];
    private List<LocalRepaymentProjection> _localRepayments = [];
    private PosCreditEntryDto? _reverseCreditTarget;
    private string? _creditReversalReason;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;
    private string? _pendingLinkBanner;
    private string? _exItsId;
    private string? _notesDisplay;
    private string _linkStatusLabel = "—";
    private string? _linkStatusCode;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (Pending == 1)
        {
            _banner = L["Offline_SavedPendingSync"];
        }

        if (PendingLink == 1)
        {
            _pendingLinkBanner = L["CustomerLink_PendingMessage"];
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _utang = null;
        _localBalance = null;
        _showLocalBalance = false;
        _fromLocalCredits = false;
        _localCreditEntries = [];
        _localRepayments = [];
        _showRecoveryBanner = false;
        _entries = [];
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!_isOffline)
        {
            var result = await Customers.GetAsync(CustomerId);
            if (result.IsSuccess && result.Data is not null)
            {
                _customer = result.Data;
                ApplyProfileNotes(result.Data.Notes);
                if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                {
                    var local = await LocalStore.GetCustomerAsync(CustomerId);
                    _entityState = local?.EntityState;
                }

                await LoadUtangAsync();
                await LoadLinkStatusAsync();
            }
            else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
            {
                await LoadFromLocalAsync();
            }
            else
            {
                _customer = null;
                ClearProfileNotes();
                ClearLinkStatus();
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            await LoadFromLocalAsync();
        }
        else
        {
            _customer = null;
            ClearProfileNotes();
            ClearLinkStatus();
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Api_Offline"];
        }

        _loading = false;
    }

    private async Task LoadLinkStatusAsync()
    {
        ClearLinkStatus();
        if (_customer?.PlatformBusinessCustomerId is not Guid platformCustomerId
            || CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            _linkStatusLabel = L["CustomerLink_Status_NotLinked"];
            return;
        }

        var statusResult = await Platform.GetCustomerLinkStatusAsync(orgId, platformCustomerId);
        if (!statusResult.IsSuccess || statusResult.Data is null)
        {
            _linkStatusLabel = L["CustomerLink_StatusUnavailable"];
            return;
        }

        _linkStatusCode = statusResult.Data.Status;
        _linkStatusLabel = MapLinkStatusLabel(statusResult.Data.Status);
        if (string.Equals(_linkStatusCode, "Pending", StringComparison.OrdinalIgnoreCase)
            && string.IsNullOrEmpty(_pendingLinkBanner))
        {
            _pendingLinkBanner = L["CustomerLink_PendingWaiting"];
        }
    }

    private void ClearLinkStatus()
    {
        _linkStatusCode = null;
        _linkStatusLabel = "—";
    }

    private string MapLinkStatusLabel(string? status) =>
        status?.Trim() switch
        {
            "NotLinked" => L["CustomerLink_Status_NotLinked"],
            "Pending" => L["CustomerLink_Status_Pending"],
            "Linked" or "Active" => L["CustomerLink_Status_Linked"],
            "Declined" => L["CustomerLink_Status_Declined"],
            "Expired" => L["CustomerLink_Status_Expired"],
            "Revoked" => L["CustomerLink_Status_Revoked"],
            _ => L["CustomerLink_StatusUnavailable"]
        };

    private async Task LoadFromLocalAsync()
    {
        var local = await LocalStore.GetCustomerAsync(CustomerId);
        if (local is null)
        {
            _customer = null;
            ClearProfileNotes();
            _errorTitle = L["Customers_NotFoundTitle"];
            _errorMessage = L["Customers_NotFoundMessage"];
            return;
        }

        _customer = OfflineCustomerCreditUiHelpers.ToDetail(local);
        ApplyProfileNotes(local.Notes);
        ClearLinkStatus();
        _entityState = local.EntityState;
        _localBalance = await LocalStore.GetBalanceAsync(CustomerId);
        _showLocalBalance = true;
        _localCreditEntries = (await LocalStore.ListCreditsAsync(CustomerId)).ToList();
        _localRepayments = (await LocalStore.ListRepaymentsAsync(CustomerId)).ToList();
        _fromLocalCredits = true;
        _showRecoveryBanner = CountRecoveryStates(_localCreditEntries) + CountRecoveryStates(_localRepayments) > 0;
        _entriesLoading = false;
        _repaymentsLoading = false;
    }

    private static int CountRecoveryStates(IEnumerable<LocalCreditProjection> items) =>
        items.Count(i => i.EntityState is LocalEntitySyncState.Conflict or LocalEntitySyncState.Rejected or LocalEntitySyncState.BlockedByAccess);

    private static int CountRecoveryStates(IEnumerable<LocalRepaymentProjection> items) =>
        items.Count(i => i.EntityState is LocalEntitySyncState.Conflict or LocalEntitySyncState.Rejected or LocalEntitySyncState.BlockedByAccess);

    private async Task LoadUtangAsync()
    {
        _entriesLoading = true;
        var summaryResult = await Customers.GetUtangSummaryAsync(CustomerId);
        if (summaryResult.IsSuccess)
        {
            _utang = summaryResult.Data;
            _showLocalBalance = false;
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            _localBalance = await LocalStore.GetBalanceAsync(CustomerId);
            _showLocalBalance = true;
        }

        if (!_isOffline)
        {
            var entriesResult = await Customers.ListCreditEntriesAsync(CustomerId, page: 1, pageSize: 50);
            if (entriesResult.IsSuccess && entriesResult.Data is not null)
            {
                _entries = entriesResult.Data.Items;
            }
            else if (!entriesResult.IsSuccess)
            {
                _errorTitle = L["Credit_ErrorTitle"];
                _errorMessage = entriesResult.Error?.Detail ?? ApiLocalizer.Describe(entriesResult.Status, entriesResult.Error).Message;
                if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                {
                    _localCreditEntries = (await LocalStore.ListCreditsAsync(CustomerId)).ToList();
                    _fromLocalCredits = _localCreditEntries.Count > 0;
                }
            }
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            _localRepayments = (await LocalStore.ListRepaymentsAsync(CustomerId)).ToList();
            _showRecoveryBanner = CountRecoveryStates(_localCreditEntries) + CountRecoveryStates(_localRepayments) > 0;
        }

        _entriesLoading = false;
        _repaymentsLoading = false;
    }

    private async Task DeactivateAsync()
    {
        if (_isOffline)
        {
            return;
        }

        _acting = true;
        var result = await Customers.DeactivateAsync(CustomerId);
        _acting = false;
        _confirmDeactivate = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _customer = result.Data;
            ApplyProfileNotes(result.Data.Notes);
            _banner = L["Customers_DeactivatedSuccess"];
        }
        else
        {
            _errorTitle = L["Customers_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private async Task ReactivateAsync()
    {
        if (_isOffline)
        {
            return;
        }

        _acting = true;
        var result = await Customers.ReactivateAsync(CustomerId);
        _acting = false;
        _confirmReactivate = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _customer = result.Data;
            ApplyProfileNotes(result.Data.Notes);
            _banner = L["Customers_ReactivatedSuccess"];
        }
        else if (result.Status == ApiCallStatus.Conflict)
        {
            _errorTitle = L["Customers_ConflictTitle"];
            _errorMessage = L["Customers_ConflictMessage"];
        }
        else
        {
            _errorTitle = L["Customers_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private void BeginReverseCredit(PosCreditEntryDto entry)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ReverseCredit))
        {
            return;
        }

        _reverseCreditTarget = entry;
        _creditReversalReason = null;
        _confirmReverseCredit = true;
    }

    private void OnReverseCreditVisibleChanged(bool visible)
    {
        _confirmReverseCredit = visible;
        if (!visible)
        {
            _reverseCreditTarget = null;
            _creditReversalReason = null;
        }
    }

    private async Task ReverseCreditAsync()
    {
        if (_reverseCreditTarget is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_creditReversalReason))
        {
            return;
        }

        _acting = true;
        var result = await Customers.ReverseCreditEntryAsync(
            CustomerId,
            _reverseCreditTarget.CreditEntryId,
            new ReversePosCreditEntryRequest(_creditReversalReason!));
        _acting = false;
        _confirmReverseCredit = false;
        _reverseCreditTarget = null;
        _creditReversalReason = null;

        if (result.IsSuccess)
        {
            _banner = L["Credit_ReversedSuccess"];
            await LoadUtangAsync();
        }
        else
        {
            _errorTitle = L["Credit_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private void ApplyProfileNotes(string? notes)
    {
        SplitExItsIdFromNotes(notes, out _exItsId, out _notesDisplay);
    }

    private void ClearProfileNotes()
    {
        _exItsId = null;
        _notesDisplay = null;
    }

    /// <summary>
    /// Customer create stores <c>exits-id:EX-####-####</c> in notes — surface it as its own field.
    /// </summary>
    internal static void SplitExItsIdFromNotes(string? notes, out string? exItsId, out string? cleanedNotes)
    {
        exItsId = null;
        cleanedNotes = null;
        if (string.IsNullOrWhiteSpace(notes))
        {
            return;
        }

        var kept = new List<string>();
        foreach (var raw in notes.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n'))
        {
            var line = raw.Trim();
            if (line.StartsWith("exits-id:", StringComparison.OrdinalIgnoreCase))
            {
                var id = line["exits-id:".Length..].Trim();
                if (!string.IsNullOrWhiteSpace(id))
                {
                    exItsId = id.ToUpperInvariant();
                }

                continue;
            }

            if (!string.IsNullOrWhiteSpace(line))
            {
                kept.Add(line);
            }
        }

        cleanedNotes = kept.Count == 0 ? null : string.Join('\n', kept);
    }


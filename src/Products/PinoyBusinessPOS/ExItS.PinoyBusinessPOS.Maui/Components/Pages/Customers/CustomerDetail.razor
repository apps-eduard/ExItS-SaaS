@page "/customers/{CustomerId:guid}"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Customers_Loading"]</span></Page>
}
else if (_customer is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Customers_NotFoundTitle"])" Message="@(_errorMessage ?? L["Customers_NotFoundMessage"])" RetryLabel="@L["Api_Retry"]" OnRetry="LoadAsync" />
        <Button Variant="ButtonVariant.Secondary" OnClick="GoList">@L["Customers_BackToList"]</Button>
    </Page>
}
else
{
    var customer = _customer;
<Page>
    <PageHeader Title="@customer.DisplayName" Subtitle="@L["Customers_DetailSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoList">@L["Customers_BackToList"]</Button>
            @if (customer.Status == "Active")
            {
                <Button Variant="ButtonVariant.Primary" OnClick="GoEdit">@L["Customers_Edit"]</Button>
            }
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Customers_ErrorTitle"])" Message="@_errorMessage" />
    }

    <Alert Tone="AlertTone.Info" Title="@L["Utang_DeferredTitle"]" Message="@L["Utang_DeferredMessage"]" />

    <Section Title="@L["Customers_ProfileSection"]">
        <Stack Gap="3">
            <div>
                <span class="pos-muted">@L["Customers_Field_DisplayName"]</span>
                <div class="pos-value-md">@customer.DisplayName</div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Mobile"]</span>
                <div class="pos-value-md">@(string.IsNullOrWhiteSpace(customer.MobileNumber) ? L["Customers_NoMobile"] : customer.MobileNumber)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Address"]</span>
                <div class="pos-value-md pos-wrap">@(string.IsNullOrWhiteSpace(customer.Address) ? L["Customers_NoValue"] : customer.Address)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Notes"]</span>
                <div class="pos-value-md pos-wrap">@(string.IsNullOrWhiteSpace(customer.Notes) ? L["Customers_NoValue"] : customer.Notes)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Status"]</span>
                <Badge Tone="@(customer.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@customer.Status</Badge>
            </div>
        </Stack>
    </Section>

    <Section Title="@L["Utang_SectionTitle"]">
        <Stack Gap="3">
            <div>
                <span class="pos-muted">@L["Credit_Outstanding"]</span>
                <div class="pos-value-md">
                    @if (_utang is null)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <MoneyDisplay Amount="@_utang.OutstandingAmount" CurrencyCode="PHP" />
                    }
                </div>
            </div>
            @if (_utang is not null)
            {
                <div class="pos-muted">
                    @L["Utang_CreditsTotal"] <MoneyDisplay Amount="@_utang.ActiveCreditTotal" CurrencyCode="PHP" />
                    · @L["Utang_PaymentsTotal"] <MoneyDisplay Amount="@_utang.ActiveRepaymentTotal" CurrencyCode="PHP" />
                </div>
                <div class="pos-muted">
                    @L["Overdue_Amount"]: <MoneyDisplay Amount="@_utang.OverdueAmount" CurrencyCode="PHP" />
                    · @L["Overdue_Count"]: @_utang.OverdueCreditCount
                    · @L["Overdue_NoDueDateCount"]: @_utang.CreditsWithoutDueDateCount
                </div>
                <div class="pos-muted">
                    @L["Overdue_Earliest"]: @(_utang.EarliestOverdueDate?.ToString("d") ?? L["Customers_NoValue"])
                    · @L["Overdue_NextDue"]: @(_utang.NextUpcomingDueDate?.ToString("d") ?? L["Customers_NoValue"])
                </div>
            }
            <FormActions>
                @if (customer.Status == "Active")
                {
                    <Button Variant="ButtonVariant.Secondary" OnClick="GoAddCredit">@L["Credit_Add"]</Button>
                }
                <Button Variant="ButtonVariant.Primary"
                        Disabled="@(_utang is null || _utang.OutstandingAmount <= 0m)"
                        OnClick="GoAddPayment">@L["Payment_Record"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoLedger">@L["Ledger_Open"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoOverdue">@L["Overdue_OpenDetail"]</Button>
            </FormActions>
            @if (customer.Status != "Active")
            {
                <Alert Tone="AlertTone.Info" Title="@L["Payment_InactiveAllowedTitle"]" Message="@L["Payment_InactiveAllowedMessage"]" />
            }
        </Stack>
    </Section>

    <Section Title="@L["Credit_HistoryTitle"]">
        @if (_entriesLoading)
        {
            <Spinner /><span>@L["Credit_HistoryLoading"]</span>
        }
        else if (_entries.Count == 0)
        {
            <EmptyState Title="@L["Credit_HistoryEmptyTitle"]" Message="@L["Credit_HistoryEmptyMessage"]" />
        }
        else
        {
            <Stack Gap="3">
                @foreach (var entry in _entries)
                {
                    <div class="pos-credit-entry">
                        <div class="pos-value-md">
                            <MoneyDisplay Amount="@entry.Amount" CurrencyCode="PHP" />
                            <Badge Tone="@(entry.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@entry.Status</Badge>
                            @if (entry.CurrentDueDate is null)
                            {
                                <Badge Tone="BadgeTone.Neutral">@L["DueDate_Badge_NoDueDate"]</Badge>
                            }
                            else
                            {
                                <Badge Tone="BadgeTone.Warning">@L["DueDate_Current"]: @entry.CurrentDueDate.Value.ToString("d")</Badge>
                            }
                        </div>
                        <div class="pos-wrap">@entry.Remarks</div>
                        <div class="pos-muted">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                        @if (entry.Status == "Reversed")
                        {
                            <div class="pos-muted pos-wrap">@L["Credit_ReversalReason"]: @entry.ReversalReason</div>
                        }
                        else
                        {
                            <FormActions>
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoCreditDetail(entry.CreditEntryId)">@L["DueDate_OpenCredit"]</Button>
                                <Button Variant="ButtonVariant.Danger" OnClick="() => BeginReverseCredit(entry)">@L["Credit_Reverse"]</Button>
                            </FormActions>
                        }
                    </div>
                }
            </Stack>
        }
    </Section>

    <FormActions>
        @if (customer.Status == "Active")
        {
            <Button Variant="ButtonVariant.Danger" OnClick="() => _confirmDeactivate = true">@L["Customers_Deactivate"]</Button>
        }
        else
        {
            <Button Variant="ButtonVariant.Primary" OnClick="() => _confirmReactivate = true">@L["Customers_Reactivate"]</Button>
        }
    </FormActions>

    <ConfirmDialog Visible="@_confirmDeactivate"
                   VisibleChanged="v => _confirmDeactivate = v"
                   Title="@L["Customers_DeactivateTitle"]"
                   Message="@L["Customers_DeactivateMessage"]"
                   Danger="true"
                   ConfirmLabel="@L["Customers_Deactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="DeactivateAsync" />

    <ConfirmDialog Visible="@_confirmReactivate"
                   VisibleChanged="v => _confirmReactivate = v"
                   Title="@L["Customers_ReactivateTitle"]"
                   Message="@L["Customers_ReactivateMessage"]"
                   ConfirmLabel="@L["Customers_Reactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="ReactivateAsync" />

    <ConfirmDialog Visible="@_confirmReverseCredit"
                   VisibleChanged="OnReverseCreditVisibleChanged"
                   Title="@L["Credit_ReverseTitle"]"
                   Message="@L["Credit_ReverseMessage"]"
                   Danger="true"
                   ShowReason="true"
                   Reason="@_creditReversalReason"
                   ReasonChanged="v => _creditReversalReason = v"
                   ReasonLabel="@L["Credit_Field_ReversalReason"]"
                   ConfirmLabel="@L["Credit_Reverse"]"
                   IsLoading="@_acting"
                   OnConfirm="ReverseCreditAsync" />
</Page>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _entriesLoading;
    private bool _acting;
    private bool _confirmDeactivate;
    private bool _confirmReactivate;
    private bool _confirmReverseCredit;
    private PosCustomerDetailDto? _customer;
    private PosCustomerUtangSummaryDto? _utang;
    private List<PosCreditEntryDto> _entries = [];
    private PosCreditEntryDto? _reverseCreditTarget;
    private string? _creditReversalReason;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        var result = await Customers.GetAsync(CustomerId);
        if (result.IsSuccess)
        {
            _customer = result.Data;
            await LoadUtangAsync();
        }
        else
        {
            _customer = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task LoadUtangAsync()
    {
        _entriesLoading = true;
        var summaryResult = await Customers.GetUtangSummaryAsync(CustomerId);
        if (summaryResult.IsSuccess)
        {
            _utang = summaryResult.Data;
        }

        var entriesResult = await Customers.ListCreditEntriesAsync(CustomerId, page: 1, pageSize: 50);
        if (entriesResult.IsSuccess && entriesResult.Data is not null)
        {
            _entries = entriesResult.Data.Items;
        }
        else if (!entriesResult.IsSuccess)
        {
            _errorTitle = L["Credit_ErrorTitle"];
            _errorMessage = entriesResult.Error?.Detail ?? ApiLocalizer.Describe(entriesResult.Status, entriesResult.Error).Message;
        }

        _entriesLoading = false;
    }

    private async Task DeactivateAsync()
    {
        _acting = true;
        var result = await Customers.DeactivateAsync(CustomerId);
        _acting = false;
        _confirmDeactivate = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _customer = result.Data;
            _banner = L["Customers_DeactivatedSuccess"];
        }
        else
        {
            _errorTitle = L["Customers_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private async Task ReactivateAsync()
    {
        _acting = true;
        var result = await Customers.ReactivateAsync(CustomerId);
        _acting = false;
        _confirmReactivate = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _customer = result.Data;
            _banner = L["Customers_ReactivatedSuccess"];
        }
        else if (result.Status == ApiCallStatus.Conflict)
        {
            _errorTitle = L["Customers_ConflictTitle"];
            _errorMessage = L["Customers_ConflictMessage"];
        }
        else
        {
            _errorTitle = L["Customers_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private void BeginReverseCredit(PosCreditEntryDto entry)
    {
        _reverseCreditTarget = entry;
        _creditReversalReason = null;
        _confirmReverseCredit = true;
    }

    private void OnReverseCreditVisibleChanged(bool visible)
    {
        _confirmReverseCredit = visible;
        if (!visible)
        {
            _reverseCreditTarget = null;
            _creditReversalReason = null;
        }
    }

    private async Task ReverseCreditAsync()
    {
        if (_reverseCreditTarget is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_creditReversalReason))
        {
            return;
        }

        _acting = true;
        var result = await Customers.ReverseCreditEntryAsync(
            CustomerId,
            _reverseCreditTarget.CreditEntryId,
            new ReversePosCreditEntryRequest(_creditReversalReason!));
        _acting = false;
        _confirmReverseCredit = false;
        _reverseCreditTarget = null;
        _creditReversalReason = null;

        if (result.IsSuccess)
        {
            _banner = L["Credit_ReversedSuccess"];
            await LoadUtangAsync();
        }
        else
        {
            _errorTitle = L["Credit_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private void GoList() => Nav.NavigateTo("/customers");
    private void GoEdit() => Nav.NavigateTo($"/customers/{CustomerId:D}/edit");
    private void GoAddCredit() => Nav.NavigateTo($"/customers/{CustomerId:D}/credit/new");
    private void GoAddPayment() => Nav.NavigateTo($"/customers/{CustomerId:D}/repayments/new");
    private void GoLedger() => Nav.NavigateTo($"/customers/{CustomerId:D}/ledger");
    private void GoOverdue() => Nav.NavigateTo($"/customers/{CustomerId:D}/overdue");
    private void GoCreditDetail(Guid entryId) => Nav.NavigateTo($"/customers/{CustomerId:D}/credit/{entryId:D}");
}

@page "/customers/{CustomerId:guid}"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync
@inject ILocalCustomerCreditStore LocalStore
@inject IConnectivityService Connectivity
@inject ILocalContextManager LocalContext

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Customers_Loading"]</span></Page>
}
else if (_customer is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Customers_NotFoundTitle"])" Message="@(_errorMessage ?? L["Customers_NotFoundMessage"])" RetryLabel="@L["Api_Retry"]" OnRetry="LoadAsync" />
        <Button Variant="ButtonVariant.Secondary" OnClick="GoList">@L["Customers_BackToList"]</Button>
    </Page>
}
else
{
    var customer = _customer;
    var canEdit = Capabilities.IsAllowed(UtangCapability.EditCustomer);
    var canCreateCredit = Capabilities.IsAllowed(UtangCapability.CreateCredit);
    var canReverseCredit = Capabilities.IsAllowed(UtangCapability.ReverseCredit);
    var canStatement = Capabilities.IsAllowed(UtangCapability.ViewGenerateStatement);
<Page>
    <PageHeader Title="@customer.DisplayName" Subtitle="@L["Customers_DetailSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoList">@L["Customers_BackToList"]</Button>
            @if (customer.Status == "Active")
            {
                <Button Variant="ButtonVariant.Primary" Disabled="@(!canEdit)" OnClick="GoEdit">@L["Customers_Edit"]</Button>
            }
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_banner" />
    }

    @if (_showRecoveryBanner)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Offline_RecoveryRequired"]" Message="@L["Offline_ConflictMessage"]" />
    }

    @if (_entityState == LocalEntitySyncState.Conflict)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Offline_ConflictTitle"]" Message="@L["Offline_ConflictMessage"]" />
        <FormActions>
            <Button Variant="ButtonVariant.Primary" OnClick="GoEdit">@L["Customers_Edit"]</Button>
        </FormActions>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Customers_ErrorTitle"])" Message="@_errorMessage" />
    }

    @if (!canEdit || !canCreateCredit || !canReverseCredit || !canStatement)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    <Alert Tone="AlertTone.Info" Title="@L["Utang_DeferredTitle"]" Message="@L["Utang_DeferredMessage"]" />

    <Section Title="@L["Customers_ProfileSection"]">
        <Stack Gap="3">
            <div>
                <span class="pos-muted">@L["Customers_Field_DisplayName"]</span>
                <div class="pos-value-md">
                    @customer.DisplayName
                    @if (_entityState is { } state && OfflineCustomerCreditUiHelpers.EntityBadge(state) is { } badge)
                    {
                        <Badge Tone="@badge.Tone">@L[badge.LabelKey]</Badge>
                    }
                </div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Mobile"]</span>
                <div class="pos-value-md">@(string.IsNullOrWhiteSpace(customer.MobileNumber) ? L["Customers_NoMobile"] : customer.MobileNumber)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Address"]</span>
                <div class="pos-value-md pos-wrap">@(string.IsNullOrWhiteSpace(customer.Address) ? L["Customers_NoValue"] : customer.Address)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Notes"]</span>
                <div class="pos-value-md pos-wrap">@(string.IsNullOrWhiteSpace(customer.Notes) ? L["Customers_NoValue"] : customer.Notes)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Status"]</span>
                <Badge Tone="@(customer.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@customer.Status</Badge>
            </div>
        </Stack>
    </Section>

    <Section Title="@L["Utang_SectionTitle"]">
        <Stack Gap="3">
            @if (_showLocalBalance && _localBalance is not null)
            {
                <div>
                    <span class="pos-muted">@L["Offline_ConfirmedOutstanding"]</span>
                    <div class="pos-value-md">
                        <MoneyDisplay Amount="@_localBalance.ConfirmedOutstanding" CurrencyCode="PHP" />
                    </div>
                </div>
                <div>
                    <span class="pos-muted">@L["Offline_PendingCredit"]</span>
                    <div class="pos-value-md">
                        <MoneyDisplay Amount="@_localBalance.PendingCredit" CurrencyCode="PHP" />
                    </div>
                </div>
                <div>
                    <span class="pos-muted">@L["Offline_PendingRepayment"]</span>
                    <div class="pos-value-md">
                        <MoneyDisplay Amount="@_localBalance.PendingRepayment" CurrencyCode="PHP" />
                    </div>
                </div>
                <div>
                    <span class="pos-muted">@L["Offline_ProjectedOutstanding"]</span>
                    <div class="pos-value-md">
                        <MoneyDisplay Amount="@_localBalance.ProjectedOutstanding" CurrencyCode="PHP" />
                    </div>
                </div>
            }
            else
            {
                <div>
                    <span class="pos-muted">@L["Credit_Outstanding"]</span>
                    <div class="pos-value-md">
                        @if (_utang is null)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <MoneyDisplay Amount="@_utang.OutstandingAmount" CurrencyCode="PHP" />
                        }
                    </div>
                </div>
                @if (_utang is not null)
                {
                    <div class="pos-muted">
                        @L["Utang_CreditsTotal"] <MoneyDisplay Amount="@_utang.ActiveCreditTotal" CurrencyCode="PHP" />
                        · @L["Utang_PaymentsTotal"] <MoneyDisplay Amount="@_utang.ActiveRepaymentTotal" CurrencyCode="PHP" />
                    </div>
                    <div class="pos-muted">
                        @L["Overdue_Amount"]: <MoneyDisplay Amount="@_utang.OverdueAmount" CurrencyCode="PHP" />
                        · @L["Overdue_Count"]: @_utang.OverdueCreditCount
                        · @L["Overdue_NoDueDateCount"]: @_utang.CreditsWithoutDueDateCount
                    </div>
                    <div class="pos-muted">
                        @L["Overdue_Earliest"]: @(_utang.EarliestOverdueDate?.ToString("d") ?? L["Customers_NoValue"])
                        · @L["Overdue_NextDue"]: @(_utang.NextUpcomingDueDate?.ToString("d") ?? L["Customers_NoValue"])
                    </div>
                }
            }
            <FormActions>
                @if (customer.Status == "Active")
                {
                    <Button Variant="ButtonVariant.Secondary" Disabled="@(!canCreateCredit)" OnClick="GoAddCredit">@L["Credit_Add"]</Button>
                }
                <Button Variant="ButtonVariant.Primary"
                        Disabled="@((!Sync.CanMutateOffline && _isOffline) || (_utang is null && !_showLocalBalance) || (_utang?.OutstandingAmount ?? _localBalance?.ProjectedOutstanding ?? 0m) <= 0m || !Capabilities.IsAllowed(UtangCapability.RecordRepayment))"
                        OnClick="GoAddPayment">@L["Payment_Record"]</Button>
                <Button Variant="ButtonVariant.Secondary" Disabled="@_isOffline" OnClick="GoLedger">@L["Ledger_Open"]</Button>
                <Button Variant="ButtonVariant.Secondary" Disabled="@_isOffline" OnClick="GoOverdue">@L["Overdue_OpenDetail"]</Button>
                <Button Variant="ButtonVariant.Secondary" Disabled="@(!canStatement || _isOffline)" OnClick="GoStatement">@L["Statement_Open"]</Button>
            </FormActions>
            @if (_isOffline && !Sync.CanMutateOffline)
            {
                <Alert Tone="AlertTone.Info" Title="@L["SyncStatus_Offline"]" Message="@L["Offline_MutationsUnavailable"]" />
            }
            @if (customer.Status != "Active")
            {
                <Alert Tone="AlertTone.Info" Title="@L["Payment_InactiveAllowedTitle"]" Message="@L["Payment_InactiveAllowedMessage"]" />
            }
        </Stack>
    </Section>

    <Section Title="@L["Credit_HistoryTitle"]">
        @if (_entriesLoading)
        {
            <Spinner /><span>@L["Credit_HistoryLoading"]</span>
        }
        else if (_entries.Count == 0 && _localCreditEntries.Count == 0)
        {
            <EmptyState Title="@L["Credit_HistoryEmptyTitle"]" Message="@L["Credit_HistoryEmptyMessage"]" />
        }
        else if (_isOffline || _fromLocalCredits)
        {
            <Stack Gap="3">
                @foreach (var entry in _localCreditEntries)
                {
                    <div class="pos-credit-entry">
                        <div class="pos-value-md">
                            <MoneyDisplay Amount="@entry.Amount" CurrencyCode="PHP" />
                            <Badge Tone="@(entry.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@entry.Status</Badge>
                            @if (OfflineCustomerCreditUiHelpers.EntityBadge(entry.EntityState) is { } badge)
                            {
                                <Badge Tone="@badge.Tone">@L[badge.LabelKey]</Badge>
                            }
                        </div>
                        <div class="pos-wrap">@entry.Remarks</div>
                        <div class="pos-muted">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                        @if (entry.Status == "Active")
                        {
                            <FormActions>
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoCreditDetail(entry.CreditEntryId)">@L["DueDate_OpenCredit"]</Button>
                            </FormActions>
                        }
                    </div>
                }
            </Stack>
        }
        else
        {
            <Stack Gap="3">
                @foreach (var entry in _entries)
                {
                    <div class="pos-credit-entry">
                        <div class="pos-value-md">
                            <MoneyDisplay Amount="@entry.Amount" CurrencyCode="PHP" />
                            <Badge Tone="@(entry.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@entry.Status</Badge>
                            @if (entry.CurrentDueDate is null)
                            {
                                <Badge Tone="BadgeTone.Neutral">@L["DueDate_Badge_NoDueDate"]</Badge>
                            }
                            else
                            {
                                <Badge Tone="BadgeTone.Warning">@L["DueDate_Current"]: @entry.CurrentDueDate.Value.ToString("d")</Badge>
                            }
                        </div>
                        <div class="pos-wrap">@entry.Remarks</div>
                        <div class="pos-muted">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                        @if (entry.SourceSaleId is not null)
                        {
                            <div class="pos-muted">
                                @L["Credit_LinkedSale"]:
                                <a class="pos-link" href="@($"/sales/{entry.SourceSaleId.Value:D}")">@entry.SourceSaleId.Value.ToString("D")</a>
                            </div>
                        }
                        @if (entry.Status == "Reversed")
                        {
                            <div class="pos-muted pos-wrap">@L["Credit_ReversalReason"]: @entry.ReversalReason</div>
                        }
                        else
                        {
                            <FormActions>
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoCreditDetail(entry.CreditEntryId)">@L["DueDate_OpenCredit"]</Button>
                                @if (entry.SourceSaleId is null)
                                {
                                    <Button Variant="ButtonVariant.Danger" Disabled="@(!canReverseCredit)" OnClick="() => BeginReverseCredit(entry)">@L["Credit_Reverse"]</Button>
                                }
                            </FormActions>
                            @if (entry.SourceSaleId is not null)
                            {
                                <Alert Tone="AlertTone.Info" Title="@L["Credit_Reverse"]" Message="@L["Credit_ReverseViaSaleVoid"]" />
                            }
                        }
                    </div>
                }
            </Stack>
        }
    </Section>

    @if (_isOffline || _localRepayments.Count > 0)
    {
        <Section Title="@L["Utang_PaymentsTotal"]">
            @if (_repaymentsLoading)
            {
                <Spinner /><span>@L["Payment_Loading"]</span>
            }
            else if (_localRepayments.Count == 0)
            {
                <EmptyState Title="@L["Payment_NotFoundTitle"]" Message="@L["Payment_NotFoundMessage"]" />
            }
            else
            {
                <Stack Gap="3">
                    @foreach (var repayment in _localRepayments)
                    {
                        <div class="pos-credit-entry">
                            <div class="pos-value-md">
                                <MoneyDisplay Amount="@repayment.Amount" CurrencyCode="PHP" />
                                <Badge Tone="@(repayment.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@repayment.Status</Badge>
                                @if (OfflineCustomerCreditUiHelpers.EntityBadge(repayment.EntityState) is { } badge)
                                {
                                    <Badge Tone="@badge.Tone">@L[badge.LabelKey]</Badge>
                                }
                            </div>
                            <div class="pos-wrap">@(string.IsNullOrWhiteSpace(repayment.Remarks) ? L["Customers_NoValue"] : repayment.Remarks)</div>
                            <div class="pos-muted">@repayment.RecordedAtUtc.ToLocalTime().ToString("g")</div>
                            <FormActions>
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoRepaymentDetail(repayment.RepaymentId)">@L["Payment_View"]</Button>
                            </FormActions>
                        </div>
                    }
                </Stack>
            }
        </Section>
    }

    <FormActions>
        @if (customer.Status == "Active")
        {
            <Button Variant="ButtonVariant.Danger" Disabled="@_isOffline" OnClick="() => _confirmDeactivate = true">@L["Customers_Deactivate"]</Button>
        }
        else
        {
            <Button Variant="ButtonVariant.Primary" Disabled="@_isOffline" OnClick="() => _confirmReactivate = true">@L["Customers_Reactivate"]</Button>
        }
    </FormActions>

    @if (_isOffline && !Sync.CanMutateOffline)
    {
        <Alert Tone="AlertTone.Info" Title="@L["SyncStatus_Offline"]" Message="@L["Offline_MutationsUnavailable"]" />
    }

    <ConfirmDialog Visible="@_confirmDeactivate"
                   VisibleChanged="v => _confirmDeactivate = v"
                   Title="@L["Customers_DeactivateTitle"]"
                   Message="@L["Customers_DeactivateMessage"]"
                   Danger="true"
                   ConfirmLabel="@L["Customers_Deactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="DeactivateAsync" />

    <ConfirmDialog Visible="@_confirmReactivate"
                   VisibleChanged="v => _confirmReactivate = v"
                   Title="@L["Customers_ReactivateTitle"]"
                   Message="@L["Customers_ReactivateMessage"]"
                   ConfirmLabel="@L["Customers_Reactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="ReactivateAsync" />

    <ConfirmDialog Visible="@_confirmReverseCredit"
                   VisibleChanged="OnReverseCreditVisibleChanged"
                   Title="@L["Credit_ReverseTitle"]"
                   Message="@L["Credit_ReverseMessage"]"
                   Danger="true"
                   ShowReason="true"
                   Reason="@_creditReversalReason"
                   ReasonChanged="v => _creditReversalReason = v"
                   ReasonLabel="@L["Credit_Field_ReversalReason"]"
                   ConfirmLabel="@L["Credit_Reverse"]"
                   IsLoading="@_acting"
                   OnConfirm="ReverseCreditAsync" />
</Page>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "pending")]
    public int? Pending { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _entriesLoading;
    private bool _repaymentsLoading;
    private bool _acting;
    private bool _confirmDeactivate;
    private bool _confirmReactivate;
    private bool _confirmReverseCredit;
    private bool _isOffline;
    private bool _showLocalBalance;
    private bool _fromLocalCredits;
    private bool _showRecoveryBanner;
    private PosCustomerDetailDto? _customer;
    private LocalEntitySyncState? _entityState;
    private PosCustomerUtangSummaryDto? _utang;
    private LocalCustomerBalanceProjection? _localBalance;
    private List<PosCreditEntryDto> _entries = [];
    private List<LocalCreditProjection> _localCreditEntries = [];
    private List<LocalRepaymentProjection> _localRepayments = [];
    private PosCreditEntryDto? _reverseCreditTarget;
    private string? _creditReversalReason;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (Pending == 1)
        {
            _banner = L["Offline_SavedPendingSync"];
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _utang = null;
        _localBalance = null;
        _showLocalBalance = false;
        _fromLocalCredits = false;
        _localCreditEntries = [];
        _localRepayments = [];
        _showRecoveryBanner = false;
        _entries = [];
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!_isOffline)
        {
            var result = await Customers.GetAsync(CustomerId);
            if (result.IsSuccess && result.Data is not null)
            {
                _customer = result.Data;
                if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                {
                    var local = await LocalStore.GetCustomerAsync(CustomerId);
                    _entityState = local?.EntityState;
                }

                await LoadUtangAsync();
            }
            else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
            {
                await LoadFromLocalAsync();
            }
            else
            {
                _customer = null;
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            await LoadFromLocalAsync();
        }
        else
        {
            _customer = null;
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Api_Offline"];
        }

        _loading = false;
    }

    private async Task LoadFromLocalAsync()
    {
        var local = await LocalStore.GetCustomerAsync(CustomerId);
        if (local is null)
        {
            _customer = null;
            _errorTitle = L["Customers_NotFoundTitle"];
            _errorMessage = L["Customers_NotFoundMessage"];
            return;
        }

        _customer = OfflineCustomerCreditUiHelpers.ToDetail(local);
        _entityState = local.EntityState;
        _localBalance = await LocalStore.GetBalanceAsync(CustomerId);
        _showLocalBalance = true;
        _localCreditEntries = (await LocalStore.ListCreditsAsync(CustomerId)).ToList();
        _localRepayments = (await LocalStore.ListRepaymentsAsync(CustomerId)).ToList();
        _fromLocalCredits = true;
        _showRecoveryBanner = CountRecoveryStates(_localCreditEntries) + CountRecoveryStates(_localRepayments) > 0;
        _entriesLoading = false;
        _repaymentsLoading = false;
    }

    private static int CountRecoveryStates(IEnumerable<LocalCreditProjection> items) =>
        items.Count(i => i.EntityState is LocalEntitySyncState.Conflict or LocalEntitySyncState.Rejected or LocalEntitySyncState.BlockedByAccess);

    private static int CountRecoveryStates(IEnumerable<LocalRepaymentProjection> items) =>
        items.Count(i => i.EntityState is LocalEntitySyncState.Conflict or LocalEntitySyncState.Rejected or LocalEntitySyncState.BlockedByAccess);

    private async Task LoadUtangAsync()
    {
        _entriesLoading = true;
        var summaryResult = await Customers.GetUtangSummaryAsync(CustomerId);
        if (summaryResult.IsSuccess)
        {
            _utang = summaryResult.Data;
            _showLocalBalance = false;
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            _localBalance = await LocalStore.GetBalanceAsync(CustomerId);
            _showLocalBalance = true;
        }

        if (!_isOffline)
        {
            var entriesResult = await Customers.ListCreditEntriesAsync(CustomerId, page: 1, pageSize: 50);
            if (entriesResult.IsSuccess && entriesResult.Data is not null)
            {
                _entries = entriesResult.Data.Items;
            }
            else if (!entriesResult.IsSuccess)
            {
                _errorTitle = L["Credit_ErrorTitle"];
                _errorMessage = entriesResult.Error?.Detail ?? ApiLocalizer.Describe(entriesResult.Status, entriesResult.Error).Message;
                if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                {
                    _localCreditEntries = (await LocalStore.ListCreditsAsync(CustomerId)).ToList();
                    _fromLocalCredits = _localCreditEntries.Count > 0;
                }
            }
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            _localRepayments = (await LocalStore.ListRepaymentsAsync(CustomerId)).ToList();
            _showRecoveryBanner = CountRecoveryStates(_localCreditEntries) + CountRecoveryStates(_localRepayments) > 0;
        }

        _entriesLoading = false;
        _repaymentsLoading = false;
    }

    private async Task DeactivateAsync()
    {
        if (_isOffline)
        {
            return;
        }

        _acting = true;
        var result = await Customers.DeactivateAsync(CustomerId);
        _acting = false;
        _confirmDeactivate = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _customer = result.Data;
            _banner = L["Customers_DeactivatedSuccess"];
        }
        else
        {
            _errorTitle = L["Customers_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private async Task ReactivateAsync()
    {
        if (_isOffline)
        {
            return;
        }

        _acting = true;
        var result = await Customers.ReactivateAsync(CustomerId);
        _acting = false;
        _confirmReactivate = false;
        if (result.IsSuccess && result.Data is not null)
        {
            _customer = result.Data;
            _banner = L["Customers_ReactivatedSuccess"];
        }
        else if (result.Status == ApiCallStatus.Conflict)
        {
            _errorTitle = L["Customers_ConflictTitle"];
            _errorMessage = L["Customers_ConflictMessage"];
        }
        else
        {
            _errorTitle = L["Customers_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private void BeginReverseCredit(PosCreditEntryDto entry)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ReverseCredit))
        {
            return;
        }

        _reverseCreditTarget = entry;
        _creditReversalReason = null;
        _confirmReverseCredit = true;
    }

    private void OnReverseCreditVisibleChanged(bool visible)
    {
        _confirmReverseCredit = visible;
        if (!visible)
        {
            _reverseCreditTarget = null;
            _creditReversalReason = null;
        }
    }

    private async Task ReverseCreditAsync()
    {
        if (_reverseCreditTarget is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_creditReversalReason))
        {
            return;
        }

        _acting = true;
        var result = await Customers.ReverseCreditEntryAsync(
            CustomerId,
            _reverseCreditTarget.CreditEntryId,
            new ReversePosCreditEntryRequest(_creditReversalReason!));
        _acting = false;
        _confirmReverseCredit = false;
        _reverseCreditTarget = null;
        _creditReversalReason = null;

        if (result.IsSuccess)
        {
            _banner = L["Credit_ReversedSuccess"];
            await LoadUtangAsync();
        }
        else
        {
            _errorTitle = L["Credit_ErrorTitle"];
            _errorMessage = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
    }

    private void GoList() => Nav.NavigateTo("/customers");
    private void GoEdit() => Nav.NavigateTo($"/customers/{CustomerId:D}/edit");
    private void GoAddCredit() => Nav.NavigateTo($"/customers/{CustomerId:D}/credit/new");
    private void GoAddPayment() => Nav.NavigateTo($"/customers/{CustomerId:D}/repayments/new");
    private void GoLedger() => Nav.NavigateTo($"/customers/{CustomerId:D}/ledger");
    private void GoOverdue() => Nav.NavigateTo($"/customers/{CustomerId:D}/overdue");
    private void GoStatement() => Nav.NavigateTo($"/customers/{CustomerId:D}/statement");
    private void GoCreditDetail(Guid entryId) => Nav.NavigateTo($"/customers/{CustomerId:D}/credit/{entryId:D}");
    private void GoRepaymentDetail(Guid repaymentId) => Nav.NavigateTo($"/customers/{CustomerId:D}/repayments/{repaymentId:D}");
}

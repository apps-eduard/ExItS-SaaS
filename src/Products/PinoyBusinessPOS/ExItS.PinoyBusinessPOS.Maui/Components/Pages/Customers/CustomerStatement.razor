@page "/customers/{CustomerId:guid}/statement"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject IDocumentHandoffService Handoff
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<StoreHeaderBack Href="@($"/customers/{CustomerId:D}")" />
@if (!_canView)
{
    <Page>
        <header class="pos-statement__header">
            <h1 class="pos-statement__title">@L["Statement_Title"]</h1>
            <p class="pos-statement__subtitle">@L["Statement_Subtitle"]</p>
        </header>
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    </Page>
}
else
{
<div class="pos-statement">
<Page>
    <header class="pos-statement__header">
        <h1 class="pos-statement__title">@L["Statement_Title"]</h1>
        <p class="pos-statement__subtitle">@L["Statement_Subtitle"]</p>
    </header>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Statement_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-statement__panel" aria-labelledby="statement-period-heading">
        <h2 id="statement-period-heading" class="pos-statement__section-title">@L["Statement_PeriodTitle"]</h2>
        <div class="pos-statement__form">
            <DateInput Label="@L["Statement_PeriodStart"]"
                       Value="@_periodStart"
                       ValueChanged="v => _periodStart = v"
                       Required="true" />
            <DateInput Label="@L["Statement_PeriodEnd"]"
                       Value="@_periodEnd"
                       ValueChanged="v => _periodEnd = v"
                       Required="true" />
        </div>
        <div class="pos-action-grid pos-action-grid--two pos-statement__actions" role="group" aria-label="@L["Statement_PeriodTitle"]">
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@_loading"
                    @onclick="LoadStatementAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                <span class="pos-action-tile__label">@L["Statement_Generate"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(_statement is null || _sharing)"
                    @onclick="ShareAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("share")</span>
                <span class="pos-action-tile__label">@L["Statement_Share"]</span>
            </button>
        </div>
    </section>

    @if (_loading)
    {
        <div class="pos-statement__loading"><Spinner /><span>@L["Statement_Loading"]</span></div>
    }
    else if (_statement is not null)
    {
        var statement = _statement;
        <section class="pos-statement__panel" aria-labelledby="statement-summary-heading">
            <h2 id="statement-summary-heading" class="pos-statement__section-title">@L["Statement_SummaryTitle"]</h2>
            <div class="pos-statement__balance">
                <span class="pos-statement__balance-label">@L["Credit_Outstanding"]</span>
                <div class="pos-statement__balance-value">
                    <MoneyDisplay Amount="@statement.OutstandingBalance" CurrencyCode="@statement.CurrencyCode" Emphasized="true" />
                </div>
            </div>
            <dl class="pos-statement__facts">
                <div class="pos-statement__fact">
                    <dt>@L["Statement_Customer"]</dt>
                    <dd>@statement.CustomerDisplayName</dd>
                </div>
                <div class="pos-statement__fact">
                    <dt>@L["Statement_OpeningBalance"]</dt>
                    <dd><MoneyDisplay Amount="@statement.OpeningBalance" CurrencyCode="@statement.CurrencyCode" /></dd>
                </div>
                <div class="pos-statement__fact">
                    <dt>@L["Statement_ClosingBalance"]</dt>
                    <dd><MoneyDisplay Amount="@statement.ClosingBalance" CurrencyCode="@statement.CurrencyCode" /></dd>
                </div>
            </dl>
            <div class="pos-statement__stats" role="list">
                <div class="pos-statement__stat" role="listitem">
                    <span class="pos-statement__stat-label">@L["Statement_PeriodCredits"]</span>
                    <span class="pos-statement__stat-value"><MoneyDisplay Amount="@statement.PeriodCreditTotal" CurrencyCode="@statement.CurrencyCode" /></span>
                </div>
                <div class="pos-statement__stat" role="listitem">
                    <span class="pos-statement__stat-label">@L["Statement_PeriodRepayments"]</span>
                    <span class="pos-statement__stat-value"><MoneyDisplay Amount="@statement.PeriodRepaymentTotal" CurrencyCode="@statement.CurrencyCode" /></span>
                </div>
            </div>
        </section>

        <section class="pos-statement__panel" aria-labelledby="statement-lines-heading">
            <h2 id="statement-lines-heading" class="pos-statement__section-title">@L["Statement_LinesTitle"]</h2>
            @if (statement.Lines.Count == 0)
            {
                <EmptyState Title="@L["Statement_EmptyTitle"]" Message="@L["Statement_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-statement__list" role="list">
                    @foreach (var line in statement.Lines)
                    {
                        <article class="pos-statement__entry" role="listitem">
                            <div class="pos-statement__entry-top">
                                <span class="pos-statement__entry-amount">
                                    <MoneyDisplay Amount="@line.Amount" CurrencyCode="@statement.CurrencyCode" />
                                </span>
                                <div class="pos-statement__entry-badges">
                                    <Badge Tone="@(line.IsReversed ? BadgeTone.Neutral : BadgeTone.Success)">@line.EntryType</Badge>
                                    @if (line.IsReversed)
                                    {
                                        <Badge Tone="BadgeTone.Neutral">@line.Status</Badge>
                                    }
                                </div>
                            </div>
                            <p class="pos-statement__entry-remarks pos-wrap">@(string.IsNullOrWhiteSpace(line.Remarks) ? L["Customers_NoValue"] : line.Remarks)</p>
                            <p class="pos-statement__entry-meta">
                                @line.RecordedAtUtc.ToLocalTime().ToString("g")
                                · @L["Ledger_RunningBalance"] <MoneyDisplay Amount="@line.RunningBalance" CurrencyCode="@statement.CurrencyCode" />
                            </p>
                        </article>
                    }
                </div>
            }
        </section>
    }
</Page>
</div>
}
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool _ready;
    private bool _canView;
    private bool _loading;
    private bool _sharing;
    private DateOnly? _periodStart;
    private DateOnly? _periodEnd;
    private PosCustomerStatementDto? _statement;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _canView = Capabilities.IsAllowed(UtangCapability.ViewGenerateStatement);
        var today = DateOnly.FromDateTime(DateTime.Today);
        _periodEnd = today;
        _periodStart = today.AddMonths(-1);
        _ready = true;
    }

    private async Task LoadStatementAsync()
    {
        _banner = null;
        _errorTitle = null;
        _errorMessage = null;

        if (_periodStart is null || _periodEnd is null)
        {
            _errorTitle = L["Statement_ErrorTitle"];
            _errorMessage = L["Statement_PeriodRequired"];
            return;
        }

        if (_periodEnd < _periodStart)
        {
            _errorTitle = L["Statement_ErrorTitle"];
            _errorMessage = L["Statement_PeriodInvalid"];
            return;
        }

        _loading = true;
        StateHasChanged();

        var result = await Customers.GetStatementAsync(
            CustomerId,
            _periodStart.Value,
            _periodEnd.Value,
            CurrentUser.Session?.OrganizationDisplayName,
            "PHP",
            CultureInfo.CurrentUICulture.Name);

        if (result.IsSuccess && result.Data is not null)
        {
            _statement = result.Data;
        }
        else
        {
            _statement = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task ShareAsync()
    {
        if (_statement is null)
        {
            return;
        }

        _sharing = true;
        _banner = null;
        _errorMessage = null;
        var text = FormatShareText(_statement);
        var result = await Handoff.ShareTextAsync(L["Statement_Title"], text);
        _banner = L[result.MessageKey];
        if (!result.Initiated)
        {
            _errorTitle = L["Statement_ErrorTitle"];
            _errorMessage = L[result.MessageKey];
            _banner = null;
        }

        _sharing = false;
    }

    private string FormatShareText(PosCustomerStatementDto statement)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(statement.CustomerDisplayName);
        sb.AppendLine($"{statement.PeriodStart:yyyy-MM-dd} – {statement.PeriodEnd:yyyy-MM-dd}");
        sb.AppendLine($"{L["Statement_Share_Opening"]}: {statement.OpeningBalance:0.00} {statement.CurrencyCode}");
        sb.AppendLine($"{L["Statement_Share_Closing"]}: {statement.ClosingBalance:0.00} {statement.CurrencyCode}");
        sb.AppendLine($"{L["Statement_Share_Outstanding"]}: {statement.OutstandingBalance:0.00} {statement.CurrencyCode}");
        sb.AppendLine();
        foreach (var line in statement.Lines)
        {
            sb.AppendLine($"{line.RecordedAtUtc:u} | {line.EntryType} | {line.Amount:0.00} | {line.Status} | {L["Statement_Share_Balance"]} {line.RunningBalance:0.00}");
            if (!string.IsNullOrWhiteSpace(line.Remarks))
            {
                sb.AppendLine(line.Remarks);
            }
        }

        return sb.ToString();
    }

}

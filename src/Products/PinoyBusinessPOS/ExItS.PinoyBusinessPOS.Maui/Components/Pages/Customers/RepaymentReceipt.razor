@page "/customers/{CustomerId:guid}/repayments/{RepaymentId:guid}/receipt"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject IDocumentHandoffService Handoff
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<StoreHeaderBack Href="@($"/customers/{CustomerId:D}")" />
@if (!_canView)
{
    <Page>
        <header class="pos-receipt__header">
            <h1 class="pos-receipt__title">@L["Receipt_Title"]</h1>
            <p class="pos-receipt__subtitle">@L["Receipt_Subtitle"]</p>
        </header>
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    </Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Receipt_Loading"]</span></Page>
}
else if (_receipt is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Receipt_NotFoundTitle"])" Message="@(_errorMessage ?? L["Receipt_NotFoundMessage"])" RetryLabel="@L["Api_Retry"]" OnRetry="LoadAsync" />
    </Page>
}
else
{
    var receipt = _receipt;
<div class="pos-receipt">
<Page>
    <header class="pos-receipt__header">
        <div class="pos-receipt__title-row">
            <h1 class="pos-receipt__title">@L["Receipt_Title"]</h1>
            <button type="button"
                    class="pos-receipt__header-btn"
                    @onclick="GoPayment">
                <span class="pos-receipt__header-icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                <span>@L["Payment_View"]</span>
            </button>
        </div>
        <p class="pos-receipt__subtitle">@L["Receipt_Subtitle"]</p>
        <div class="pos-receipt__status-row">
            <Badge Tone="@(receipt.IsReversed ? BadgeTone.Warning : BadgeTone.Success)">@receipt.Status</Badge>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Receipt_ErrorTitle"])" Message="@_errorMessage" />
    }

    @if (receipt.IsReversed)
    {
        <p class="pos-receipt__note">@L["Receipt_ReversedMessage"]</p>
    }

    <section class="pos-receipt__panel" aria-labelledby="receipt-preview-heading">
        <h2 id="receipt-preview-heading" class="pos-receipt__section-title">@L["Receipt_PreviewTitle"]</h2>
        <div class="pos-receipt__amount">
            <span class="pos-receipt__amount-label">@L["Payment_Field_Amount"]</span>
            <div class="pos-receipt__amount-value">
                <MoneyDisplay Amount="@receipt.Amount" CurrencyCode="@receipt.CurrencyCode" Emphasized="true" />
            </div>
        </div>
        <dl class="pos-receipt__facts">
            <div class="pos-receipt__fact">
                <dt>@L["Receipt_Reference"]</dt>
                <dd>@receipt.ReceiptReference</dd>
            </div>
            <div class="pos-receipt__fact">
                <dt>@L["Statement_Customer"]</dt>
                <dd>@receipt.CustomerDisplayName</dd>
            </div>
            <div class="pos-receipt__fact">
                <dt>@L["Payment_RecordedAt"]</dt>
                <dd>@receipt.RecordedAtUtc.ToLocalTime().ToString("g")</dd>
            </div>
            <div class="pos-receipt__fact">
                <dt>@L["Payment_Field_Remarks"]</dt>
                <dd class="pos-wrap">@(string.IsNullOrWhiteSpace(receipt.Remarks) ? L["Customers_NoValue"] : receipt.Remarks)</dd>
            </div>
            @if (receipt.OutstandingAfterRepayment is decimal after)
            {
                <div class="pos-receipt__fact">
                    <dt>@L["Receipt_OutstandingAfter"]</dt>
                    <dd><MoneyDisplay Amount="@after" CurrencyCode="@receipt.CurrencyCode" /></dd>
                </div>
            }
            @if (receipt.IsReversed)
            {
                <div class="pos-receipt__fact">
                    <dt>@L["Credit_ReversalReason"]</dt>
                    <dd class="pos-wrap">@(receipt.ReversalReason ?? L["Customers_NoValue"])</dd>
                </div>
            }
        </dl>
        <p class="pos-receipt__disclaimer">@L["Receipt_Disclaimer"]: @L["Receipt_DisclaimerBody"]</p>
    </section>

    <div class="pos-action-grid pos-action-grid--single pos-receipt__actions" role="group">
        <button type="button"
                class="pos-action-tile pos-action-tile--primary"
                disabled="@_sharing"
                @onclick="ShareAsync">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("share")</span>
            <span class="pos-action-tile__label">@L["Receipt_Share"]</span>
        </button>
    </div>
</Page>
</div>
}
}

@code {
    [Parameter] public Guid CustomerId { get; set; }
    [Parameter] public Guid RepaymentId { get; set; }

    private bool _ready;
    private bool _canView;
    private bool _loading = true;
    private bool _sharing;
    private PosRepaymentReceiptDto? _receipt;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _canView = Capabilities.IsAllowed(UtangCapability.ViewGenerateReceipt);
        _ready = true;
        if (_canView)
        {
            await LoadAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        var result = await Customers.GetRepaymentReceiptAsync(
            RepaymentId,
            CurrentUser.Session?.OrganizationDisplayName,
            "PHP",
            CultureInfo.CurrentUICulture.Name);

        if (result.IsSuccess && result.Data is not null && result.Data.CustomerId == CustomerId)
        {
            _receipt = result.Data;
        }
        else
        {
            _receipt = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task ShareAsync()
    {
        if (_receipt is null)
        {
            return;
        }

        _sharing = true;
        _banner = null;
        _errorMessage = null;
        var text = FormatShareText(_receipt);
        var result = await Handoff.ShareTextAsync(L["Receipt_Title"], text);
        if (result.Initiated)
        {
            _banner = L[result.MessageKey];
        }
        else
        {
            _errorTitle = L["Receipt_ErrorTitle"];
            _errorMessage = L[result.MessageKey];
        }

        _sharing = false;
    }

    private string FormatShareText(PosRepaymentReceiptDto receipt)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(receipt.ReceiptReference);
        sb.AppendLine(receipt.CustomerDisplayName);
        sb.AppendLine($"{receipt.Amount:0.00} {receipt.CurrencyCode}");
        sb.AppendLine(receipt.Status);
        sb.AppendLine(receipt.RecordedAtUtc.ToString("u"));
        if (!string.IsNullOrWhiteSpace(receipt.Remarks))
        {
            sb.AppendLine(receipt.Remarks);
        }

        if (receipt.IsReversed)
        {
            sb.AppendLine($"{L["Receipt_Share_Reversed"]}: {receipt.ReversalReason}");
        }

        sb.AppendLine(L["Receipt_DisclaimerBody"]);
        return sb.ToString();
    }

    private void GoPayment() => Nav.NavigateTo($"/customers/{CustomerId:D}/repayments/{RepaymentId:D}");
}

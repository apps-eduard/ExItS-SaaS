@page "/customers/new"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canCreate = Capabilities.IsAllowed(UtangCapability.CreateCustomer);
<Page>
    <PageHeader Title="@L["Customers_CreateTitle"]" Subtitle="@L["Customers_CreateSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoBack">@L["Customers_Cancel"]</Button>
        </Actions>
    </PageHeader>

    <Alert Tone="AlertTone.Info" Title="@L["Customers_RepaymentDeferredTitle"]" Message="@L["Customers_RepaymentDeferredMessage"]" />

    @if (!canCreate)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Customers_ErrorTitle"]" Message="@_formError" />
    }

    @if (!string.IsNullOrEmpty(_pendingMessage))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_pendingMessage" />
    }

    <CustomerForm DisplayName="@_displayName"
                  DisplayNameChanged="v => _displayName = v"
                  MobileNumber="@_mobile"
                  MobileNumberChanged="v => _mobile = v"
                  Address="@_address"
                  AddressChanged="v => _address = v"
                  Notes="@_notes"
                  NotesChanged="v => _notes = v"
                  DisplayNameError="@_displayNameError"
                  MobileError="@_mobileError"
                  IsSaving="@_saving"
                  Disabled="@(!canCreate)"
                  SaveLabel="@L["Customers_Create"]"
                  OnSave="SaveAsync"
                  OnCancel="GoBack" />
</Page>
}

@code {
    private bool _ready;
    private bool _saving;
    private string? _displayName;
    private string? _mobile;
    private string? _address;
    private string? _notes;
    private string? _displayNameError;
    private string? _mobileError;
    private string? _formError;
    private string? _pendingMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
    }

    private async Task SaveAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.CreateCustomer))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _displayNameError = null;
        _mobileError = null;
        _formError = null;
        _pendingMessage = null;

        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _displayNameError = L["Customers_DisplayNameRequired"];
            return;
        }

        _saving = true;
        var result = await Sync.CreateCustomerAsync(
            _displayName.Trim(),
            string.IsNullOrWhiteSpace(_mobile) ? null : _mobile,
            string.IsNullOrWhiteSpace(_address) ? null : _address,
            string.IsNullOrWhiteSpace(_notes) ? null : _notes);

        if (result.Succeeded && result.Customer is not null)
        {
            var route = result.PendingLocal
                ? $"/customers/{result.Customer.CustomerId:D}?pending=1"
                : $"/customers/{result.Customer.CustomerId:D}";
            Nav.NavigateTo(route, replace: true);
            return;
        }

        if (string.Equals(result.ErrorCode, ApplicationErrorCodes.MobileConflict, StringComparison.Ordinal))
        {
            _formError = L["Customers_ConflictMessage"];
            _mobileError = L["Customers_ConflictMessage"];
        }
        else if (string.Equals(result.ErrorCode, "offline_mutations_unavailable", StringComparison.Ordinal))
        {
            _formError = L["Offline_MutationsUnavailable"];
        }
        else
        {
            _formError = result.ErrorMessage ?? L["Customers_ErrorTitle"];
        }

        _saving = false;
    }

    private void GoBack() => Nav.NavigateTo("/customers");
}

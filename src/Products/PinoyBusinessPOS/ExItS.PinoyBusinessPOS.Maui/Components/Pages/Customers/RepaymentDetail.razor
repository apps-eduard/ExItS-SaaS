@page "/customers/{CustomerId:guid}/repayments/{RepaymentId:guid}"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync
@inject ILocalCustomerCreditStore Store
@inject IConnectivityService Connectivity
@inject ILocalContextManager LocalContext

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<StoreHeaderBack Href="@($"/customers/{CustomerId:D}")" />
@if (_loading)
{
    <Page><Spinner /><span>@L["Payment_Loading"]</span></Page>
}
else if (_repayment is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Payment_NotFoundTitle"])" Message="@(_errorMessage ?? L["Payment_NotFoundMessage"])" RetryLabel="@L["Api_Retry"]" OnRetry="LoadAsync" />
        <Button Variant="ButtonVariant.Secondary" OnClick="GoLedger">@L["Ledger_Open"]</Button>
    </Page>
}
else
{
    var repayment = _repayment;
    var canReverse = Capabilities.IsAllowed(UtangCapability.ReverseRepayment)
        && Sync.CanMutateOffline
        && _entityState == LocalEntitySyncState.ServerConfirmed;
    var canReceipt = Capabilities.IsAllowed(UtangCapability.ViewGenerateReceipt) && !_fromLocal;
<Page>
    <PageHeader Title="@L["Payment_DetailTitle"]" Subtitle="@L["Payment_DetailSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoLedger">@L["Ledger_Open"]</Button>
            <Button Variant="ButtonVariant.Secondary" Disabled="@(!canReceipt)" OnClick="GoReceipt">@L["Receipt_Open"]</Button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Payment_ErrorTitle"])" Message="@_errorMessage" />
    }

    @if (!Capabilities.IsAllowed(UtangCapability.ReverseRepayment) || !Capabilities.IsAllowed(UtangCapability.ViewGenerateReceipt))
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    <Section Title="@L["Payment_EntrySection"]">
        <Stack Gap="3">
            <div>
                <span class="pos-muted">@L["Payment_Field_Amount"]</span>
                <div class="pos-value-md">
                    <MoneyDisplay Amount="@repayment.Amount" CurrencyCode="PHP" />
                    @if (_entityState is { } state && OfflineCustomerCreditUiHelpers.EntityBadge(state) is { } badge)
                    {
                        <Badge Tone="@badge.Tone">@L[badge.LabelKey]</Badge>
                    }
                </div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Status"]</span>
                <Badge Tone="@(repayment.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@repayment.Status</Badge>
            </div>
            <div>
                <span class="pos-muted">@L["Payment_Field_Remarks"]</span>
                <div class="pos-value-md pos-wrap">@(string.IsNullOrWhiteSpace(repayment.Remarks) ? L["Customers_NoValue"] : repayment.Remarks)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Payment_RecordedAt"]</span>
                <div class="pos-value-md">@repayment.RecordedAtUtc.ToLocalTime().ToString("g")</div>
            </div>
            @if (repayment.Status == "Reversed")
            {
                <div>
                    <span class="pos-muted">@L["Credit_ReversalReason"]</span>
                    <div class="pos-value-md pos-wrap">@repayment.ReversalReason</div>
                </div>
            }
        </Stack>
    </Section>

    @if (repayment.Status == "Active")
    {
        <FormActions>
            <Button Variant="ButtonVariant.Danger" Disabled="@(!canReverse)" OnClick="() => _confirmReverse = true">@L["Payment_Reverse"]</Button>
        </FormActions>
    }

    <ConfirmDialog Visible="@_confirmReverse"
                   VisibleChanged="v => _confirmReverse = v"
                   Title="@L["Payment_ReverseTitle"]"
                   Message="@L["Payment_ReverseMessage"]"
                   Danger="true"
                   ShowReason="true"
                   Reason="@_reversalReason"
                   ReasonChanged="v => _reversalReason = v"
                   ReasonLabel="@L["Credit_Field_ReversalReason"]"
                   ConfirmLabel="@L["Payment_Reverse"]"
                   IsLoading="@_acting"
                   OnConfirm="ReverseAsync" />
</Page>
}
}

@code {
    [Parameter] public Guid CustomerId { get; set; }
    [Parameter] public Guid RepaymentId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _acting;
    private bool _confirmReverse;
    private bool _fromLocal;
    private PosRepaymentDto? _repayment;
    private LocalEntitySyncState? _entityState;
    private string? _reversalReason;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _fromLocal = false;
        _entityState = null;

        var online = await Connectivity.IsConnectedAsync();
        if (online)
        {
            var result = await Customers.GetRepaymentAsync(RepaymentId);
            if (result.IsSuccess && result.Data is not null && result.Data.CustomerId == CustomerId)
            {
                _repayment = result.Data;
                _errorTitle = null;
                _errorMessage = null;
                if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                {
                    var local = await Store.GetRepaymentAsync(RepaymentId);
                    _entityState = local?.EntityState ?? LocalEntitySyncState.ServerConfirmed;
                }
                else
                {
                    _entityState = LocalEntitySyncState.ServerConfirmed;
                }
            }
            else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
            {
                await LoadFromLocalAsync();
            }
            else
            {
                _repayment = null;
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            await LoadFromLocalAsync();
        }
        else
        {
            _repayment = null;
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Api_Offline"];
        }

        _loading = false;
    }

    private async Task LoadFromLocalAsync()
    {
        var local = await Store.GetRepaymentAsync(RepaymentId);
        if (local is null || local.CustomerId != CustomerId)
        {
            _repayment = null;
            _errorTitle = L["Payment_NotFoundTitle"];
            _errorMessage = L["Payment_NotFoundMessage"];
            return;
        }

        _repayment = OfflineCustomerCreditUiHelpers.ToRepayment(local);
        _entityState = local.EntityState;
        _fromLocal = true;
        _errorTitle = null;
        _errorMessage = null;
    }

    private async Task ReverseAsync()
    {
        if (string.IsNullOrWhiteSpace(_reversalReason))
        {
            return;
        }

        _acting = true;
        var result = await Sync.ReverseRepaymentAsync(RepaymentId, _reversalReason!);
        _acting = false;
        _confirmReverse = false;

        if (result.Succeeded && result.Repayment is not null)
        {
            _repayment = OfflineCustomerCreditUiHelpers.ToRepayment(result.Repayment);
            _entityState = result.Repayment.EntityState;
            _banner = result.PendingLocal ? L["Offline_SavedPendingSync"] : L["Payment_ReversedSuccess"];
            _reversalReason = null;
        }
        else if (string.Equals(result.ErrorCode, "offline_mutations_unavailable", StringComparison.Ordinal))
        {
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Offline_MutationsUnavailable"];
        }
        else if (string.Equals(result.ErrorCode, "repayment_not_confirmed", StringComparison.Ordinal)
            || string.Equals(result.ErrorCode, "reversal_already_pending", StringComparison.Ordinal))
        {
            _errorTitle = L["Payment_ErrorTitle"];
            _errorMessage = result.ErrorMessage ?? L["Payment_ReverseMessage"];
            await LoadAsync();
        }
        else
        {
            _errorTitle = L["Payment_ErrorTitle"];
            _errorMessage = result.ErrorMessage ?? L["Payment_ReverseMessage"];
        }
    }

    private void GoLedger() => Nav.NavigateTo($"/customers/{CustomerId:D}/ledger");
    private void GoReceipt() => Nav.NavigateTo($"/customers/{CustomerId:D}/repayments/{RepaymentId:D}/receipt");
}

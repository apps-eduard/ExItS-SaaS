@page "/customers/{CustomerId:guid}/overdue"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<StoreHeaderBack Href="@($"/customers/{CustomerId:D}")" />
@if (_loading)
{
    <Page><Spinner /><span>@L["Overdue_Loading"]</span></Page>
}
else if (_summary is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Customers_NotFoundTitle"])" Message="@(_errorMessage ?? L["Customers_NotFoundMessage"])" RetryLabel="@L["Api_Retry"]" OnRetry="LoadAsync" />
    </Page>
}
else
{
    var summary = _summary;
<div class="pos-customer-overdue">
<Page>
    <header class="pos-customer-overdue__header">
        <h1 class="pos-customer-overdue__title">@L["Overdue_CustomerTitle"]</h1>
        <p class="pos-customer-overdue__subtitle">@L["Overdue_CustomerSubtitle"]</p>
        <button type="button"
                class="pos-customer-overdue__org"
                aria-label="@L["Overdue_OpenOrg"]"
                @onclick="GoOrgOverdue">
            <span class="pos-customer-overdue__org-icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
            <span class="pos-customer-overdue__org-label">@L["Overdue_OpenOrg"]</span>
        </button>
    </header>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Overdue_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-customer-overdue__panel" aria-labelledby="overdue-summary-heading">
        <h2 id="overdue-summary-heading" class="pos-customer-overdue__section-title">@L["Overdue_SummaryTitle"]</h2>
        <div class="pos-customer-overdue__balance">
            <span class="pos-customer-overdue__balance-label">@L["Overdue_Amount"]</span>
            <div class="pos-customer-overdue__balance-value">
                <MoneyDisplay Amount="@summary.OverdueAmount" CurrencyCode="PHP" Emphasized="true" />
            </div>
        </div>
        <div class="pos-customer-overdue__stats" role="list">
            <div class="pos-customer-overdue__stat" role="listitem">
                <span class="pos-customer-overdue__stat-label">@L["Credit_Outstanding"]</span>
                <span class="pos-customer-overdue__stat-value"><MoneyDisplay Amount="@summary.OutstandingAmount" CurrencyCode="PHP" /></span>
            </div>
            <div class="pos-customer-overdue__stat" role="listitem">
                <span class="pos-customer-overdue__stat-label">@L["Overdue_Count"]</span>
                <span class="pos-customer-overdue__stat-value">@summary.OverdueCreditCount</span>
            </div>
            <div class="pos-customer-overdue__stat" role="listitem">
                <span class="pos-customer-overdue__stat-label">@L["Overdue_Earliest"]</span>
                <span class="pos-customer-overdue__stat-value">@(summary.EarliestOverdueDate?.ToString("d") ?? L["Customers_NoValue"])</span>
            </div>
            <div class="pos-customer-overdue__stat" role="listitem">
                <span class="pos-customer-overdue__stat-label">@L["Overdue_NextDue"]</span>
                <span class="pos-customer-overdue__stat-value">@(summary.NextUpcomingDueDate?.ToString("d") ?? L["Customers_NoValue"])</span>
            </div>
        </div>
    </section>

    <section class="pos-customer-overdue__panel" aria-labelledby="overdue-filter-heading">
        <h2 id="overdue-filter-heading" class="pos-customer-overdue__section-title">@L["Overdue_FilterTitle"]</h2>
        <div class="pos-customer-overdue__filters" role="group" aria-label="@L["Overdue_FilterTitle"]">
            <button type="button" class="@FilterClass("all")" @onclick="SetFilterAllAsync">@L["Overdue_Filter_All"]</button>
            <button type="button" class="@FilterClass("overdue")" @onclick="SetFilterOverdueAsync">@L["Overdue_Filter_Overdue"]</button>
            <button type="button" class="@FilterClass("duesoon")" @onclick="SetFilterDueSoonAsync">@L["Overdue_Filter_DueSoon"]</button>
            <button type="button" class="@FilterClass("noduedate")" @onclick="SetFilterNoDueDateAsync">@L["Overdue_Filter_NoDueDate"]</button>
        </div>
    </section>

    <section class="pos-customer-overdue__panel" aria-labelledby="overdue-credits-heading">
        <h2 id="overdue-credits-heading" class="pos-customer-overdue__section-title">@L["Overdue_CreditsTitle"]</h2>
        @if (_creditsLoading)
        {
            <div class="pos-customer-overdue__loading"><Spinner /><span>@L["Overdue_Loading"]</span></div>
        }
        else if (_credits.Count == 0)
        {
            <EmptyState Title="@L["Overdue_EmptyCreditsTitle"]" Message="@L["Overdue_EmptyFilterMessage"]" />
        }
        else
        {
            <div class="pos-customer-overdue__list" role="list">
                @foreach (var credit in _credits)
                {
                    <article class="pos-customer-overdue__entry" role="listitem">
                        <div class="pos-customer-overdue__entry-top">
                            <span class="pos-customer-overdue__entry-amount">
                                <MoneyDisplay Amount="@credit.RemainingUnpaidAmount" CurrencyCode="PHP" />
                            </span>
                            <Badge Tone="@DueStatusTone(credit.DueStatus)">@DueStatusLabel(credit.DueStatus)</Badge>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(credit.Remarks))
                        {
                            <p class="pos-customer-overdue__entry-remarks pos-wrap">@credit.Remarks</p>
                        }
                        <p class="pos-customer-overdue__entry-meta">
                            @L["DueDate_Current"]: @(credit.CurrentDueDate?.ToString("d") ?? L["DueDate_None"])
                        </p>
                        <div class="pos-customer-overdue__entry-actions">
                            <Button Variant="ButtonVariant.Secondary" OnClick="() => GoCredit(credit.CreditEntryId)">@L["DueDate_OpenCredit"]</Button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</Page>
</div>
}
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _creditsLoading;
    private string _filter = "all";
    private PosCustomerOverdueSummaryDto? _summary;
    private List<PosAgedCreditDto> _credits = [];
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        var summary = await Customers.GetOverdueSummaryAsync(CustomerId);
        if (summary.IsSuccess)
        {
            _summary = summary.Data;
            await LoadCreditsAsync();
        }
        else
        {
            _summary = null;
            var described = ApiLocalizer.Describe(summary.Status, summary.Error);
            _errorTitle = described.Title;
            _errorMessage = summary.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task SetFilterAllAsync() => await SetFilterAsync("all");
    private async Task SetFilterOverdueAsync() => await SetFilterAsync("overdue");
    private async Task SetFilterDueSoonAsync() => await SetFilterAsync("duesoon");
    private async Task SetFilterNoDueDateAsync() => await SetFilterAsync("noduedate");

    private async Task SetFilterAsync(string filter)
    {
        _filter = filter;
        await LoadCreditsAsync();
    }

    private async Task LoadCreditsAsync()
    {
        _creditsLoading = true;
        var credits = await Customers.ListAgedCreditsAsync(CustomerId, filter: _filter, page: 1, pageSize: 100);
        if (credits.IsSuccess && credits.Data is not null)
        {
            _credits = credits.Data.Items;
        }
        else if (!credits.IsSuccess)
        {
            _errorTitle = L["Overdue_ErrorTitle"];
            _errorMessage = credits.Error?.Detail ?? ApiLocalizer.Describe(credits.Status, credits.Error).Message;
            _credits = [];
        }

        _creditsLoading = false;
    }

    private string FilterClass(string filter) =>
        string.Equals(_filter, filter, StringComparison.OrdinalIgnoreCase)
            ? "pos-customer-overdue__chip pos-customer-overdue__chip--active"
            : "pos-customer-overdue__chip";

    private string DueStatusLabel(string status) => status switch
    {
        "Overdue" => L["DueDate_Badge_Overdue"],
        "DueToday" => L["DueDate_Badge_DueToday"],
        "DueSoon" => L["DueDate_Badge_DueSoon"],
        "Upcoming" => L["DueDate_Badge_Upcoming"],
        "Paid" => L["DueDate_Badge_Paid"],
        "Reversed" => L["DueDate_Badge_Reversed"],
        _ => L["DueDate_Badge_NoDueDate"]
    };

    private static BadgeTone DueStatusTone(string status) => status switch
    {
        "Overdue" => BadgeTone.Danger,
        "DueToday" => BadgeTone.Warning,
        "DueSoon" => BadgeTone.Warning,
        "Paid" => BadgeTone.Success,
        "Reversed" => BadgeTone.Neutral,
        _ => BadgeTone.Neutral
    };

    private void GoOrgOverdue() => Nav.NavigateTo("/overdue");
    private void GoCredit(Guid creditId) => Nav.NavigateTo($"/customers/{CustomerId:D}/credit/{creditId:D}");
}

@page "/customers/{CustomerId:guid}/edit"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync
@inject ILocalCustomerCreditStore LocalStore
@inject IConnectivityService Connectivity
@inject ILocalContextManager LocalContext

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<StoreHeaderBack Href="@($"/customers/{CustomerId:D}")" />
@if (_loading)
{
    <Page><Spinner /></Page>
}
else if (_customer is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Customers_NotFoundTitle"])" Message="@(_errorMessage ?? L["Customers_NotFoundMessage"])" />
    </Page>
}
else
{
    var canEdit = Capabilities.IsAllowed(UtangCapability.EditCustomer);
<div class="pos-customer-edit">
<Page>
    <header class="pos-customer-edit__header">
        <h1 class="pos-customer-edit__title">@L["Customers_EditTitle"]</h1>
        <p class="pos-customer-edit__subtitle">@_customer.DisplayName</p>
    </header>

    @if (_entityState == LocalEntitySyncState.Conflict || _showConflictAlert)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Offline_ConflictTitle"]" Message="@L["Offline_ConflictMessage"]" />
        <FormActions>
            <Button Variant="ButtonVariant.Danger" IsLoading="@_discarding" OnClick="DiscardConflictAsync">@L["Offline_DiscardLocal"]</Button>
        </FormActions>
    }

    @if (!canEdit)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Customers_ErrorTitle"]" Message="@_formError" />
    }

    <section class="pos-customer-edit__panel" aria-label="@L["Customers_EditTitle"]">
        <CustomerForm DisplayName="@_displayName"
                      DisplayNameChanged="v => _displayName = v"
                      MobileNumber="@_mobile"
                      MobileNumberChanged="v => _mobile = v"
                      Address="@_address"
                      AddressChanged="v => _address = v"
                      Notes="@_notes"
                      NotesChanged="v => _notes = v"
                      DisplayNameError="@_displayNameError"
                      MobileError="@_mobileError"
                      IsSaving="@_saving"
                      Disabled="@(!canEdit)"
                      SaveLabel="@L["Customers_Save"]"
                      FormActionsClass="pos-customer-create__footer"
                      OnSave="SaveAsync"
                      OnCancel="GoDetail" />
    </section>
</Page>
</div>
}
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _saving;
    private bool _discarding;
    private bool _showConflictAlert;
    private PosCustomerDetailDto? _customer;
    private LocalEntitySyncState? _entityState;
    private string? _displayName;
    private string? _mobile;
    private string? _address;
    private string? _notes;
    private string? _displayNameError;
    private string? _mobileError;
    private string? _formError;
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _showConflictAlert = false;
        _entityState = null;

        var online = await Connectivity.IsConnectedAsync();
        if (online)
        {
            var result = await Customers.GetAsync(CustomerId);
            if (result.IsSuccess && result.Data is not null)
            {
                await ApplyCustomerAsync(result.Data);
                if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                {
                    var projection = MapToProjection(result.Data, LocalEntitySyncState.ServerConfirmed);
                    await Sync.ApplyServerCustomerAfterSuccessAsync(CustomerId, projection);
                }

                _loading = false;
                return;
            }

            if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
            {
                var local = await LocalStore.GetCustomerAsync(CustomerId);
                if (local is not null)
                {
                    await ApplyLocalCustomerAsync(local);
                    _loading = false;
                    return;
                }
            }

            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            var local = await LocalStore.GetCustomerAsync(CustomerId);
            if (local is not null)
            {
                await ApplyLocalCustomerAsync(local);
            }
            else
            {
                _errorTitle = L["SyncStatus_Offline"];
                _errorMessage = L["Customers_NotFoundMessage"];
            }
        }
        else
        {
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Api_Offline"];
        }

        _loading = false;
    }

    private async Task ApplyCustomerAsync(PosCustomerDetailDto data)
    {
        _customer = data;
        _displayName = data.DisplayName;
        _mobile = data.MobileNumber;
        _address = data.Address;
        _notes = data.Notes;
        if (data.Status != "Active")
        {
            Nav.NavigateTo($"/customers/{CustomerId:D}", replace: true);
        }

        await Task.CompletedTask;
    }

    private async Task ApplyLocalCustomerAsync(LocalCustomerProjection local)
    {
        _entityState = local.EntityState;
        _customer = OfflineCustomerCreditUiHelpers.ToDetail(local);
        _displayName = local.DisplayName;
        _mobile = local.MobileNumber;
        _address = local.Address;
        _notes = local.Notes;
        if (local.Status != "Active")
        {
            Nav.NavigateTo($"/customers/{CustomerId:D}", replace: true);
        }

        await Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.EditCustomer))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _displayNameError = null;
        _mobileError = null;
        _formError = null;
        _showConflictAlert = false;

        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _displayNameError = L["Customers_DisplayNameRequired"];
            return;
        }

        _saving = true;
        var result = await Sync.UpdateCustomerAsync(
            CustomerId,
            _displayName.Trim(),
            string.IsNullOrWhiteSpace(_mobile) ? null : _mobile,
            string.IsNullOrWhiteSpace(_address) ? null : _address,
            string.IsNullOrWhiteSpace(_notes) ? null : _notes);

        if (result.Succeeded)
        {
            var route = result.PendingLocal
                ? $"/customers/{CustomerId:D}?pending=1"
                : $"/customers/{CustomerId:D}";
            Nav.NavigateTo(route, replace: true);
            return;
        }

        if (string.Equals(result.ErrorCode, ApplicationErrorCodes.CustomerConcurrencyConflict, StringComparison.Ordinal))
        {
            _showConflictAlert = true;
            _entityState = LocalEntitySyncState.Conflict;
            _formError = L["Offline_ConflictMessage"];
        }
        else if (string.Equals(result.ErrorCode, ApplicationErrorCodes.MobileConflict, StringComparison.Ordinal))
        {
            _formError = L["Customers_ConflictMessage"];
            _mobileError = L["Customers_ConflictMessage"];
        }
        else if (string.Equals(result.ErrorCode, "offline_mutations_unavailable", StringComparison.Ordinal))
        {
            _formError = L["Offline_MutationsUnavailable"];
        }
        else
        {
            _formError = result.ErrorMessage ?? L["Customers_ErrorTitle"];
        }

        _saving = false;
    }

    private async Task DiscardConflictAsync()
    {
        _discarding = true;
        try
        {
            await Sync.DiscardCustomerConflictAsync(CustomerId);
            await LoadAsync();
        }
        finally
        {
            _discarding = false;
        }
    }

    private static LocalCustomerProjection MapToProjection(PosCustomerDetailDto dto, LocalEntitySyncState state) =>
        new(
            dto.CustomerId,
            dto.OrganizationId,
            dto.DisplayName,
            dto.MobileNumber,
            dto.Address,
            dto.Notes,
            dto.Status,
            dto.CreatedAtUtc,
            dto.UpdatedAtUtc,
            state,
            null,
            dto.UpdatedAtUtc.UtcDateTime.ToString("O", System.Globalization.CultureInfo.InvariantCulture),
            null,
            null);

    private void GoDetail() => Nav.NavigateTo($"/customers/{CustomerId:D}");
}

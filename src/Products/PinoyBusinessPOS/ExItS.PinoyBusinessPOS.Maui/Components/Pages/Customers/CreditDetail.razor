@page "/customers/{CustomerId:guid}/credit/{CreditEntryId:guid}"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync
@inject ILocalCustomerCreditStore Store
@inject IConnectivityService Connectivity
@inject ILocalContextManager LocalContext

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["DueDate_Loading"]</span></Page>
}
else if (_entry is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Credit_NotFoundTitle"])" Message="@(_errorMessage ?? L["Credit_NotFoundMessage"])" RetryLabel="@L["Api_Retry"]" OnRetry="LoadAsync" />
        <Button Variant="ButtonVariant.Secondary" OnClick="GoBack">@L["Customers_BackToDetail"]</Button>
    </Page>
}
else
{
    var entry = _entry;
    var canMutateDueDate = Capabilities.IsAllowed(UtangCapability.MutateDueDate) && Sync.CanMutateOffline;
    var canReverseCredit = Capabilities.IsAllowed(UtangCapability.ReverseCredit) && Sync.CanMutateOffline;
<Page>
    <PageHeader Title="@L["Credit_DetailTitle"]" Subtitle="@L["Credit_DetailSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoBack">@L["Customers_BackToDetail"]</Button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Customers_SuccessTitle"]" Message="@_banner" />
    }

    @if (_entityState == LocalEntitySyncState.Conflict)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Offline_DueDateConflictTitle"]" Message="@L["Offline_DueDateConflictMessage"]" />
        <FormActions>
            <Button Variant="ButtonVariant.Primary" IsLoading="@_refreshing" OnClick="RefreshFromServerAsync">@L["Offline_RefreshFromServer"]</Button>
            <Button Variant="ButtonVariant.Danger" IsLoading="@_discarding" OnClick="DiscardLocalDueDateAsync">@L["Offline_DiscardLocalRequest"]</Button>
        </FormActions>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Credit_ErrorTitle"])" Message="@_errorMessage" />
    }

    @if (!Capabilities.IsAllowed(UtangCapability.MutateDueDate) || !Capabilities.IsAllowed(UtangCapability.ReverseCredit))
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    <Section Title="@L["Credit_EntrySection"]">
        <Stack Gap="3">
            <div>
                <span class="pos-muted">@L["Credit_Field_Amount"]</span>
                <div class="pos-value-md">
                    <MoneyDisplay Amount="@entry.Amount" CurrencyCode="PHP" />
                    @if (_entityState is { } state && OfflineCustomerCreditUiHelpers.EntityBadge(state) is { } badge)
                    {
                        <Badge Tone="@badge.Tone">@L[badge.LabelKey]</Badge>
                    }
                </div>
            </div>
            <div>
                <span class="pos-muted">@L["Customers_Field_Status"]</span>
                <Badge Tone="@(entry.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@entry.Status</Badge>
            </div>
            <div>
                <span class="pos-muted">@L["DueDate_Status"]</span>
                <Badge Tone="@DueStatusTone(_dueStatus)">@_dueStatusLabel</Badge>
            </div>
            <div>
                <span class="pos-muted">@L["DueDate_Current"]</span>
                <div class="pos-value-md">@(entry.CurrentDueDate is null ? L["DueDate_None"] : FormatDate(entry.CurrentDueDate.Value))</div>
            </div>
            @if (_hasPendingDueDateChange)
            {
                <div>
                    <span class="pos-muted">@L["Offline_EntityPending"]</span>
                    <div class="pos-value-md">
                        @if (_pendingDueDateClear)
                        {
                            @L["DueDate_Clear"]
                        }
                        else if (_pendingDueDate is not null)
                        {
                            @FormatDate(_pendingDueDate.Value)
                        }
                    </div>
                </div>
            }
            <div>
                <span class="pos-muted">@L["Credit_Field_Remarks"]</span>
                <div class="pos-value-md pos-wrap">@entry.Remarks</div>
            </div>
            @if (entry.SourceSaleId is not null)
            {
                <div>
                    <span class="pos-muted">@L["Credit_LinkedSale"]</span>
                    <div class="pos-value-md">
                        <a class="pos-link" href="@($"/sales/{entry.SourceSaleId.Value:D}")">@entry.SourceSaleId.Value.ToString("D")</a>
                    </div>
                </div>
            }
            <div>
                <span class="pos-muted">@L["Payment_RecordedAt"]</span>
                <div class="pos-value-md">@entry.CreatedAtUtc.ToLocalTime().ToString("g")</div>
            </div>
        </Stack>
    </Section>

    @if (entry.SourceSaleId is not null && entry.Status == "Active")
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Credit_Reverse"]" Message="@L["Credit_ReverseViaSaleVoid"]" />
    }

    @if (entry.Status == "Active" && _entityState != LocalEntitySyncState.PendingReversal)
    {
        <Section Title="@L["DueDate_ActionsTitle"]">
            <Stack Gap="3">
                <DateInput Label="@L["DueDate_Field_Date"]"
                           Value="@_dueDate"
                           ValueChanged="v => _dueDate = v"
                           Hint="@L["DueDate_DateHint"]"
                           Disabled="@(!canMutateDueDate || _acting)" />
                <TextArea Label="@L["DueDate_Field_Reason"]"
                          Value="@_reason"
                          ValueChanged="v => _reason = v"
                          Required="true"
                          Hint="@L["DueDate_ReasonHint"]"
                          Rows="3"
                          Disabled="@(!canMutateDueDate || _acting)" />
                <FormActions>
                    <Button Variant="ButtonVariant.Primary" Disabled="@(!canMutateDueDate || _acting)" OnClick="() => _confirmSet = true">@L["DueDate_Set"]</Button>
                    @if (entry.CurrentDueDate is not null)
                    {
                        <Button Variant="ButtonVariant.Secondary" Disabled="@(!canMutateDueDate || _acting)" OnClick="() => _confirmClear = true">@L["DueDate_Clear"]</Button>
                    }
                    @if (entry.SourceSaleId is null)
                    {
                        <Button Variant="ButtonVariant.Danger" Disabled="@(!canReverseCredit || _acting)" OnClick="() => _confirmReverse = true">@L["Credit_Reverse"]</Button>
                    }
                </FormActions>
            </Stack>
        </Section>
    }

    @if (!_fromLocal)
    {
        <Section Title="@L["DueDate_HistoryTitle"]">
            @if (_historyLoading)
            {
                <Spinner /><span>@L["DueDate_HistoryLoading"]</span>
            }
            else if (_history.Count == 0)
            {
                <EmptyState Title="@L["DueDate_HistoryEmptyTitle"]" Message="@L["DueDate_HistoryEmptyMessage"]" />
            }
            else
            {
                <Stack Gap="3">
                    @foreach (var change in _history)
                    {
                        <div class="pos-credit-entry">
                            <div class="pos-value-md">
                                @(change.PreviousDueDate is null ? L["DueDate_None"] : FormatDate(change.PreviousDueDate.Value))
                                →
                                @(change.NewDueDate is null ? L["DueDate_None"] : FormatDate(change.NewDueDate.Value))
                            </div>
                            <div class="pos-wrap">@change.Reason</div>
                            <div class="pos-muted">@change.ChangedAtUtc.ToLocalTime().ToString("g")</div>
                        </div>
                    }
                </Stack>
            }
        </Section>
    }

    <ConfirmDialog Visible="@_confirmSet"
                   VisibleChanged="v => _confirmSet = v"
                   Title="@L["DueDate_ConfirmSetTitle"]"
                   Message="@L["DueDate_ConfirmSetMessage"]"
                   ConfirmLabel="@L["DueDate_Set"]"
                   IsLoading="@_acting"
                   OnConfirm="SetDueDateAsync" />

    <ConfirmDialog Visible="@_confirmClear"
                   VisibleChanged="v => _confirmClear = v"
                   Title="@L["DueDate_ConfirmClearTitle"]"
                   Message="@L["DueDate_ConfirmClearMessage"]"
                   Danger="true"
                   ConfirmLabel="@L["DueDate_Clear"]"
                   IsLoading="@_acting"
                   OnConfirm="ClearDueDateAsync" />

    <ConfirmDialog Visible="@_confirmReverse"
                   VisibleChanged="v => _confirmReverse = v"
                   Title="@L["Credit_ReverseTitle"]"
                   Message="@L["Credit_ReverseMessage"]"
                   Danger="true"
                   ShowReason="true"
                   Reason="@_reversalReason"
                   ReasonChanged="v => _reversalReason = v"
                   ReasonLabel="@L["Credit_Field_ReversalReason"]"
                   ConfirmLabel="@L["Credit_Reverse"]"
                   IsLoading="@_acting"
                   OnConfirm="ReverseCreditAsync" />
</Page>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }
    [Parameter] public Guid CreditEntryId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _historyLoading;
    private bool _acting;
    private bool _refreshing;
    private bool _discarding;
    private bool _confirmSet;
    private bool _confirmClear;
    private bool _confirmReverse;
    private bool _fromLocal;
    private bool _hasPendingDueDateChange;
    private bool _pendingDueDateClear;
    private PosCreditEntryDto? _entry;
    private LocalEntitySyncState? _entityState;
    private List<PosCreditDueDateChangeDto> _history = [];
    private DateOnly? _dueDate;
    private DateOnly? _pendingDueDate;
    private string? _reason;
    private string? _reversalReason;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;
    private string _dueStatus = "NoDueDate";
    private string _dueStatusLabel = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _fromLocal = false;
        _hasPendingDueDateChange = false;
        _pendingDueDateClear = false;
        _pendingDueDate = null;
        StateHasChanged();

        var online = await Connectivity.IsConnectedAsync();
        if (online)
        {
            var aged = await Customers.ListAgedCreditsAsync(CustomerId, filter: "all", page: 1, pageSize: 200);
            if (aged.IsSuccess && aged.Data is not null)
            {
                var item = aged.Data.Items.FirstOrDefault(i => i.CreditEntryId == CreditEntryId);
                if (item is not null)
                {
                    ApplyAgedCredit(item);
                    await EnrichSourceSaleIdAsync();
                    if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                    {
                        await MergeLocalStateAsync();
                    }

                    _entityState ??= LocalEntitySyncState.ServerConfirmed;
                }
                else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
                {
                    await LoadFromLocalAsync();
                }
                else
                {
                    _entry = null;
                    _errorTitle = L["Credit_NotFoundTitle"];
                    _errorMessage = L["Credit_NotFoundMessage"];
                }
            }
            else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
            {
                await LoadFromLocalAsync();
            }
            else
            {
                _entry = null;
                var described = ApiLocalizer.Describe(aged.Status, aged.Error);
                _errorTitle = described.Title;
                _errorMessage = aged.Error?.Detail ?? described.Message;
            }

            if (!_fromLocal && _entry is not null)
            {
                await LoadHistoryAsync();
            }
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            await LoadFromLocalAsync();
        }
        else
        {
            _entry = null;
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Api_Offline"];
        }

        _loading = false;
    }

    private async Task LoadFromLocalAsync()
    {
        var local = await Store.GetCreditAsync(CreditEntryId);
        if (local is null || local.CustomerId != CustomerId)
        {
            _entry = null;
            _errorTitle = L["Credit_NotFoundTitle"];
            _errorMessage = L["Credit_NotFoundMessage"];
            return;
        }

        _entry = OfflineCustomerCreditUiHelpers.ToCreditEntry(local);
        _entityState = local.EntityState;
        _dueDate = local.PendingDueDate ?? local.CurrentDueDate;
        _dueStatus = ResolveDueStatus(local);
        _dueStatusLabel = DueStatusLabel(_dueStatus);
        ApplyPendingDueDate(local);
        _fromLocal = true;
    }

    private async Task MergeLocalStateAsync()
    {
        var local = await Store.GetCreditAsync(CreditEntryId);
        if (local is null)
        {
            _entityState = LocalEntitySyncState.ServerConfirmed;
            return;
        }

        _entityState = local.EntityState;
        ApplyPendingDueDate(local);
        if (local.EntityState is LocalEntitySyncState.PendingUpdate or LocalEntitySyncState.Conflict)
        {
            _dueDate = local.PendingDueDate ?? _entry?.CurrentDueDate;
        }
    }

    private void ApplyPendingDueDate(LocalCreditProjection local)
    {
        _hasPendingDueDateChange = local.EntityState == LocalEntitySyncState.PendingUpdate
            && (local.PendingDueDate is not null || local.PendingDueDateClear);
        _pendingDueDateClear = local.PendingDueDateClear;
        _pendingDueDate = local.PendingDueDate;
    }

    private void ApplyAgedCredit(PosAgedCreditDto aged)
    {
        _entry = new PosCreditEntryDto(
            aged.CreditEntryId,
            aged.OrganizationId,
            aged.CustomerId,
            aged.Amount,
            aged.Remarks,
            aged.Status,
            aged.CreatedAtUtc,
            null,
            null,
            aged.CurrentDueDate,
            SourceSaleId: null);
        _dueStatus = aged.DueStatus;
        _dueStatusLabel = DueStatusLabel(aged.DueStatus);
        _dueDate = aged.CurrentDueDate;
    }

    private async Task EnrichSourceSaleIdAsync()
    {
        if (_entry is null)
        {
            return;
        }

        var entries = await Customers.ListCreditEntriesAsync(CustomerId, page: 1, pageSize: 200);
        if (!entries.IsSuccess || entries.Data is null)
        {
            return;
        }

        var match = entries.Data.Items.FirstOrDefault(i => i.CreditEntryId == CreditEntryId);
        if (match is null)
        {
            return;
        }

        _entry = match with
        {
            CurrentDueDate = _entry.CurrentDueDate ?? match.CurrentDueDate
        };
    }

    private async Task LoadHistoryAsync()
    {
        _historyLoading = true;
        var history = await Customers.ListCreditDueDateHistoryAsync(CreditEntryId, page: 1, pageSize: 50);
        if (history.IsSuccess && history.Data is not null)
        {
            _history = history.Data.Items;
        }
        else if (!history.IsSuccess && history.Status != ApiCallStatus.NotFound)
        {
            _errorTitle = L["DueDate_ErrorTitle"];
            _errorMessage = history.Error?.Detail ?? ApiLocalizer.Describe(history.Status, history.Error).Message;
        }

        _historyLoading = false;
    }

    private async Task SetDueDateAsync()
    {
        if (string.IsNullOrWhiteSpace(_reason))
        {
            _errorTitle = L["DueDate_ErrorTitle"];
            _errorMessage = L["DueDate_ReasonRequired"];
            _confirmSet = false;
            return;
        }

        if (_dueDate is null)
        {
            _errorTitle = L["DueDate_ErrorTitle"];
            _errorMessage = L["DueDate_DateInvalid"];
            _confirmSet = false;
            return;
        }

        await ApplyDueDateChangeAsync(_dueDate);
    }

    private async Task ClearDueDateAsync()
    {
        if (string.IsNullOrWhiteSpace(_reason))
        {
            _errorTitle = L["DueDate_ErrorTitle"];
            _errorMessage = L["DueDate_ReasonRequired"];
            _confirmClear = false;
            return;
        }

        await ApplyDueDateChangeAsync(null);
    }

    private async Task ApplyDueDateChangeAsync(DateOnly? dueDate)
    {
        _acting = true;
        var result = await Sync.SetCreditDueDateAsync(CreditEntryId, dueDate, _reason!);
        _acting = false;
        _confirmSet = false;
        _confirmClear = false;

        if (result.Succeeded && result.Credit is not null)
        {
            _banner = result.PendingLocal ? L["Offline_SavedPendingSync"] : (dueDate is null ? L["DueDate_ClearedSuccess"] : L["DueDate_SavedSuccess"]);
            _reason = null;
            await LoadAsync();
            return;
        }

        if (string.Equals(result.ErrorCode, ApplicationErrorCodes.ConcurrencyConflict, StringComparison.Ordinal))
        {
            _errorTitle = L["Offline_DueDateConflictTitle"];
            _errorMessage = result.ErrorMessage ?? L["Offline_DueDateConflictMessage"];
            await LoadAsync();
        }
        else if (string.Equals(result.ErrorCode, "offline_mutations_unavailable", StringComparison.Ordinal))
        {
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Offline_MutationsUnavailable"];
        }
        else
        {
            _errorTitle = L["DueDate_ErrorTitle"];
            _errorMessage = result.ErrorMessage ?? L["DueDate_ReasonRequired"];
        }
    }

    private async Task ReverseCreditAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.ReverseCredit) || string.IsNullOrWhiteSpace(_reversalReason))
        {
            return;
        }

        _acting = true;
        var result = await Sync.ReverseCreditAsync(CustomerId, CreditEntryId, _reversalReason!);
        _acting = false;
        _confirmReverse = false;

        if (result.Succeeded)
        {
            _banner = result.PendingLocal ? L["Offline_SavedPendingSync"] : L["Credit_ReversedSuccess"];
            _reversalReason = null;
            await LoadAsync();
        }
        else if (string.Equals(result.ErrorCode, "offline_mutations_unavailable", StringComparison.Ordinal))
        {
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Offline_MutationsUnavailable"];
        }
        else
        {
            _errorTitle = L["Credit_ErrorTitle"];
            _errorMessage = result.ErrorMessage ?? L["Credit_ReverseMessage"];
        }
    }

    private async Task RefreshFromServerAsync()
    {
        _refreshing = true;
        try
        {
            await Sync.RefreshCustomerFinancialsFromServerAsync(CustomerId);
            _banner = L["Offline_RefreshFromServer"];
            await LoadAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task DiscardLocalDueDateAsync()
    {
        _discarding = true;
        try
        {
            await Store.DiscardLocalPendingCreditDueDateAsync(CreditEntryId);
            _banner = L["Offline_DiscardLocalRequest"];
            await LoadAsync();
        }
        finally
        {
            _discarding = false;
        }
    }

    private static string FormatDate(DateOnly date) => date.ToString("d");

    private static string ResolveDueStatus(LocalCreditProjection credit)
    {
        if (credit.Status == "Reversed")
        {
            return "Reversed";
        }

        if (credit.CurrentDueDate is null)
        {
            return "NoDueDate";
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (credit.CurrentDueDate < today)
        {
            return "Overdue";
        }

        if (credit.CurrentDueDate == today)
        {
            return "DueToday";
        }

        return credit.CurrentDueDate <= today.AddDays(7) ? "DueSoon" : "Upcoming";
    }

    private string DueStatusLabel(string status) => status switch
    {
        "Overdue" => L["DueDate_Badge_Overdue"],
        "DueToday" => L["DueDate_Badge_DueToday"],
        "DueSoon" => L["DueDate_Badge_DueSoon"],
        "Upcoming" => L["DueDate_Badge_Upcoming"],
        "Paid" => L["DueDate_Badge_Paid"],
        "Reversed" => L["DueDate_Badge_Reversed"],
        _ => L["DueDate_Badge_NoDueDate"]
    };

    private static BadgeTone DueStatusTone(string status) => status switch
    {
        "Overdue" => BadgeTone.Danger,
        "DueToday" => BadgeTone.Warning,
        "DueSoon" => BadgeTone.Warning,
        "Paid" => BadgeTone.Success,
        "Reversed" => BadgeTone.Neutral,
        _ => BadgeTone.Neutral
    };

    private void GoBack() => Nav.NavigateTo($"/customers/{CustomerId:D}");
}

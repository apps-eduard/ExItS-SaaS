@page "/customers"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync
@inject ILocalCustomerCreditStore LocalStore
@inject IConnectivityService Connectivity
@inject ILocalContextManager LocalContext

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canCreate = Capabilities.IsAllowed(UtangCapability.CreateCustomer);
<Page>
    <PageHeader Title="@L["Customers_Title"]" Subtitle="@L["Customers_Subtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Primary" Disabled="@(!canCreate)" OnClick="GoNew">@L["Customers_Add"]</Button>
        </Actions>
    </PageHeader>

    <Alert Tone="AlertTone.Info" Title="@L["Customers_CreditDeferredTitle"]" Message="@L["Customers_CreditDeferredMessage"]" />

    @if (_fromLocal)
    {
        <Alert Tone="AlertTone.Info" Title="@L["SyncStatus_Offline"]" Message="@L["SyncStatus_OfflineDetail"]" />
    }

    @if (!canCreate)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }
    <SearchToolbar SearchText="@_search" SearchTextChanged="OnSearchChanged" Placeholder="@L["Customers_SearchPlaceholder"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" IsLoading="@_loading" OnClick="ReloadAsync">@L["Customers_Refresh"]</Button>
        </Actions>
    </SearchToolbar>

    <ResponsiveDataList TItem="PosCustomerListItemDto"
                        Items="@_items"
                        Columns="@Columns"
                        CellTemplate="@CellTemplate"
                        IsLoading="@_loading"
                        LoadingLabel="@L["Customers_Loading"]"
                        EmptyTitle="@L["Customers_EmptyTitle"]"
                        EmptyMessage="@L["Customers_EmptyMessage"]"
                        ErrorTitle="@_errorTitle"
                        ErrorMessage="@_errorMessage"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="ReloadAsync"
                        AriaLabel="@L["Customers_Title"]" />

    @if (!_loading && _totalCount > 0)
    {
        <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
    }
</Page>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _fromLocal;
    private string? _search;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosCustomerListItemDto> _items = Array.Empty<PosCustomerListItemDto>();
    private Dictionary<Guid, LocalEntitySyncState> _entityStates = new();
    private string? _errorTitle;
    private string? _errorMessage;

    private IReadOnlyList<DataColumnDefinition> Columns =>
    [
        new("name", L["Customers_Col_Name"], Primary: true, Width: "32%"),
        new("mobile", L["Customers_Col_Mobile"], Width: "24%"),
        new("status", L["Customers_Col_Status"], Width: "16%"),
        new("actions", L["Customers_Col_Actions"], Width: "28%"),
    ];

    private RenderFragment<(PosCustomerListItemDto Item, DataColumnDefinition Column)> CellTemplate => context => builder =>
    {
        switch (context.Column.Key)
        {
            case "name":
                builder.OpenElement(0, "a");
                builder.AddAttribute(1, "class", "pos-link");
                builder.AddAttribute(2, "href", $"/customers/{context.Item.CustomerId:D}");
                builder.AddContent(3, context.Item.DisplayName);
                builder.CloseElement();
                break;
            case "mobile":
                builder.AddContent(0, string.IsNullOrWhiteSpace(context.Item.MobileNumber)
                    ? L["Customers_NoMobile"].Value
                    : context.Item.MobileNumber);
                break;
            case "status":
                builder.OpenComponent<Badge>(0);
                builder.AddAttribute(1, "Tone", context.Item.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral);
                builder.AddAttribute(2, "ChildContent", (RenderFragment)(b => b.AddContent(0, context.Item.Status)));
                builder.CloseComponent();
                if (_fromLocal
                    && _entityStates.TryGetValue(context.Item.CustomerId, out var state)
                    && OfflineCustomerCreditUiHelpers.EntityBadge(state) is { } badge)
                {
                    builder.OpenComponent<Badge>(3);
                    builder.AddAttribute(4, "Tone", badge.Tone);
                    builder.AddAttribute(5, "ChildContent", (RenderFragment)(b => b.AddContent(0, L[badge.LabelKey].Value)));
                    builder.CloseComponent();
                }
                break;
            default:
                builder.OpenComponent<Button>(0);
                builder.AddAttribute(1, "Variant", ButtonVariant.Ghost);
                builder.AddAttribute(2, "Size", ButtonSize.Sm);
                builder.AddAttribute(3, "OnClick", EventCallback.Factory.Create(this, () => GoDetail(context.Item.CustomerId)));
                builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, L["Customers_View"].Value)));
                builder.CloseComponent();
                break;
        }
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _fromLocal = false;
        _entityStates.Clear();
        StateHasChanged();

        var online = await Connectivity.IsConnectedAsync();
        if (online)
        {
            try
            {
                await Sync.DownloadIncrementalAsync();
            }
            catch
            {
                // Best effort incremental download.
            }

            var result = await Customers.ListAsync(_search, page: _page, pageSize: _pageSize);
            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
                _totalCount = result.Data.TotalCount;
                _loading = false;
                return;
            }

            if (CanUseLocalFallback(result.Status))
            {
                await LoadFromLocalAsync();
                _loading = false;
                return;
            }

            _items = Array.Empty<PosCustomerListItemDto>();
            _totalCount = 0;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            await LoadFromLocalAsync();
        }
        else
        {
            _items = Array.Empty<PosCustomerListItemDto>();
            _totalCount = 0;
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Api_Offline"];
        }

        _loading = false;
    }

    private bool CanUseLocalFallback(ApiCallStatus status) =>
        status is ApiCallStatus.Offline or ApiCallStatus.Timeout or ApiCallStatus.Unavailable
        && OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext);

    private async Task LoadFromLocalAsync()
    {
        var skip = (_page - 1) * _pageSize;
        var locals = await LocalStore.ListCustomersAsync(_search, skip, _pageSize);
        _totalCount = await LocalStore.CountCustomersAsync(_search);
        _items = locals.Select(OfflineCustomerCreditUiHelpers.ToListItem).ToList();
        _entityStates = locals.ToDictionary(c => c.CustomerId, c => c.EntityState);
        _fromLocal = true;
        _errorTitle = null;
        _errorMessage = null;
    }

    private void GoNew() => Nav.NavigateTo("/customers/new");
    private void GoDetail(Guid id) => Nav.NavigateTo($"/customers/{id:D}");
}

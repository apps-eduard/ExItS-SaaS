@page "/customers"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L
@inject ICustomerCreditOfflineSyncService Sync
@inject ILocalCustomerCreditStore LocalStore
@inject IConnectivityService Connectivity
@inject ILocalContextManager LocalContext

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canCreate = Capabilities.IsAllowed(UtangCapability.CreateCustomer);
<div class="pos-customers">
    <Page>
        <PageHeader Title="@L["Customers_Title"]" Subtitle="@L["Customers_Subtitle"]" />

        <div class="pos-action-grid pos-action-grid--three pos-customers__actions" role="group" aria-label="@L["Customers_Title"]">
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(!canCreate)"
                    @onclick="GoResolveExItsId">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                <span class="pos-action-tile__label">@L["Personal_AddByExItsId"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(!canCreate)"
                    @onclick="GoNew">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span class="pos-action-tile__label">@L["Customers_Add"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@_loading"
                    @onclick="ReloadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Customers_Refresh"]</span>
            </button>
        </div>

        <Alert Tone="AlertTone.Info" Title="@L["Customers_CreditDeferredTitle"]" Message="@L["Customers_CreditDeferredMessage"]" />

        @if (_fromLocal)
        {
            <Alert Tone="AlertTone.Info" Title="@L["SyncStatus_Offline"]" Message="@L["SyncStatus_OfflineDetail"]" />
        }

        <div class="pos-customers__toolbar">
            <div class="pos-customers__search">
                <span class="pos-customers__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                <input class="pos-customers__search-input"
                       type="search"
                       value="@_search"
                       placeholder="@L["Customers_SearchPlaceholder"]"
                       disabled="@_loading"
                       @oninput="OnSearchInputAsync" />
            </div>
        </div>

        <Section Title="@L["Customers_ListSection"]">
            @if (_loading)
            {
                <Stack Align="StackAlign.Center" Gap="2">
                    <Spinner />
                    <span class="pos-muted">@L["Customers_Loading"]</span>
                </Stack>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Customers_Title"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="customers"
                            Title="@L["Customers_EmptyTitle"]"
                            Message="@L["Customers_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-customers__list" role="list" aria-label="@L["Customers_Title"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-customers__row"
                           role="listitem"
                           href="@($"/customers/{item.CustomerId:D}")">
                            <div class="pos-customers__row-main">
                                <span class="pos-customers__row-name">@item.DisplayName</span>
                                <span class="pos-customers__row-meta">
                                    @(string.IsNullOrWhiteSpace(item.MobileNumber) ? L["Customers_NoMobile"] : item.MobileNumber)
                                </span>
                                <div class="pos-customers__row-badges">
                                    <Badge Tone="@(item.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">
                                        @item.Status
                                    </Badge>
                                    @if (_fromLocal
                                        && _entityStates.TryGetValue(item.CustomerId, out var state)
                                        && OfflineCustomerCreditUiHelpers.EntityBadge(state) is { } badge)
                                    {
                                        <Badge Tone="@badge.Tone">@L[badge.LabelKey]</Badge>
                                    }
                                </div>
                            </div>
                            <div class="pos-customers__row-side">
                                <span class="pos-customers__view">@L["Customers_View"]</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </Section>

        @if (!_loading && _totalCount > 0)
        {
            <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _fromLocal;
    private string? _search;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosCustomerListItemDto> _items = Array.Empty<PosCustomerListItemDto>();
    private Dictionary<Guid, LocalEntitySyncState> _entityStates = new();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewCustomersAndHistory))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString();
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
            // Newer keystroke superseded this search.
        }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _fromLocal = false;
        _entityStates.Clear();
        StateHasChanged();

        var online = await Connectivity.IsConnectedAsync();
        if (online)
        {
            try
            {
                await Sync.DownloadIncrementalAsync();
            }
            catch
            {
                // Best effort incremental download.
            }

            var result = await Customers.ListAsync(_search, page: _page, pageSize: _pageSize);
            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
                _totalCount = result.Data.TotalCount;
                _loading = false;
                return;
            }

            if (CanUseLocalFallback(result.Status))
            {
                await LoadFromLocalAsync();
                _loading = false;
                return;
            }

            _items = Array.Empty<PosCustomerListItemDto>();
            _totalCount = 0;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }
        else if (OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext))
        {
            await LoadFromLocalAsync();
        }
        else
        {
            _items = Array.Empty<PosCustomerListItemDto>();
            _totalCount = 0;
            _errorTitle = L["SyncStatus_Offline"];
            _errorMessage = L["Api_Offline"];
        }

        _loading = false;
    }

    private bool CanUseLocalFallback(ApiCallStatus status) =>
        status is ApiCallStatus.Offline or ApiCallStatus.Timeout or ApiCallStatus.Unavailable
        && OfflineCustomerCreditUiHelpers.IsLocalContextReady(LocalContext);

    private async Task LoadFromLocalAsync()
    {
        var skip = (_page - 1) * _pageSize;
        var locals = await LocalStore.ListCustomersAsync(_search, skip, _pageSize);
        _totalCount = await LocalStore.CountCustomersAsync(_search);
        _items = locals.Select(OfflineCustomerCreditUiHelpers.ToListItem).ToList();
        _entityStates = locals.ToDictionary(c => c.CustomerId, c => c.EntityState);
        _fromLocal = true;
        _errorTitle = null;
        _errorMessage = null;
    }

    private void GoNew() => Nav.NavigateTo("/customers/new");
    private void GoResolveExItsId() =>
        Nav.NavigateTo("/personal/resolve-user?purpose=customer&return=/customers/new");
}

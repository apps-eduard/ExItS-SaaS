@page "/customers/{CustomerId:guid}/ledger"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canRecordPayment = _utang is not null && _utang.OutstandingAmount > 0m;
<StoreHeaderBack Href="@($"/customers/{CustomerId:D}")" />
<div class="pos-ledger">
<Page>
    <header class="pos-ledger__header">
        <div class="pos-ledger__title-row">
            <h1 class="pos-ledger__title">@L["Ledger_Title"]</h1>
            <button type="button"
                    class="pos-ledger__pay"
                    disabled="@(!canRecordPayment)"
                    aria-label="@L["Payment_Record"]"
                    @onclick="GoAddPayment">
                <span class="pos-ledger__pay-icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                <span>@L["Payment_Record"]</span>
            </button>
        </div>
        <p class="pos-ledger__subtitle">@L["Ledger_Subtitle"]</p>
    </header>

    <p class="pos-ledger__note">@L["Utang_DeferredMessage"]</p>

    @if (_utang is not null)
    {
        <section class="pos-ledger__panel" aria-labelledby="ledger-outstanding-heading">
            <h2 id="ledger-outstanding-heading" class="pos-ledger__section-title">@L["Credit_Outstanding"]</h2>
            <div class="pos-ledger__balance">
                <span class="pos-ledger__balance-label">@L["Credit_Outstanding"]</span>
                <div class="pos-ledger__balance-value">
                    <MoneyDisplay Amount="@_utang.OutstandingAmount" CurrencyCode="PHP" Emphasized="true" />
                </div>
            </div>
        </section>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Ledger_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-ledger__panel" aria-labelledby="ledger-history-heading">
        <h2 id="ledger-history-heading" class="pos-ledger__section-title">@L["Ledger_HistoryTitle"]</h2>
        @if (_loading)
        {
            <div class="pos-ledger__loading"><Spinner /><span>@L["Ledger_Loading"]</span></div>
        }
        else if (_entries.Count == 0)
        {
            <EmptyState Title="@L["Ledger_EmptyTitle"]" Message="@L["Ledger_EmptyMessage"]" />
        }
        else
        {
            <div class="pos-ledger__list" role="list">
                @foreach (var entry in _entries)
                {
                    <article class="pos-ledger__entry" role="listitem">
                        <div class="pos-ledger__entry-top">
                            <span class="pos-ledger__entry-amount"><MoneyDisplay Amount="@entry.Amount" CurrencyCode="PHP" /></span>
                            <div class="pos-ledger__entry-badges">
                                <Badge Tone="@(entry.EntryType == "Credit" ? BadgeTone.Info : BadgeTone.Success)">
                                    @(entry.EntryType == "Credit" ? L["Ledger_TypeCredit"] : L["Ledger_TypePayment"])
                                </Badge>
                                <Badge Tone="@(entry.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">@entry.Status</Badge>
                            </div>
                        </div>
                        <p class="pos-ledger__entry-remarks pos-wrap">@(string.IsNullOrWhiteSpace(entry.Remarks) ? L["Customers_NoValue"] : entry.Remarks)</p>
                        <p class="pos-ledger__entry-meta">@entry.RecordedAtUtc.ToLocalTime().ToString("g")</p>
                        @if (entry.RunningBalance is not null)
                        {
                            <p class="pos-ledger__entry-meta">
                                @L["Ledger_RunningBalance"]:
                                <MoneyDisplay Amount="@entry.RunningBalance.Value" CurrencyCode="PHP" />
                            </p>
                        }
                        @if (entry.Status == "Reversed")
                        {
                            <p class="pos-ledger__entry-meta pos-wrap">@L["Credit_ReversalReason"]: @entry.ReversalReason</p>
                        }
                        else if (entry.EntryType == "Repayment")
                        {
                            <div class="pos-ledger__entry-actions">
                                <Button Variant="ButtonVariant.Secondary" OnClick="() => GoRepayment(entry.EntryId)">@L["Payment_View"]</Button>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
</Page>
</div>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private PosCustomerUtangSummaryDto? _utang;
    private List<PosLedgerEntryDto> _entries = [];
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var summary = await Customers.GetUtangSummaryAsync(CustomerId);
        if (summary.IsSuccess)
        {
            _utang = summary.Data;
        }

        var ledger = await Customers.ListLedgerAsync(CustomerId, page: 1, pageSize: 100);
        if (ledger.IsSuccess && ledger.Data is not null)
        {
            _entries = ledger.Data.Items;
        }
        else if (!ledger.IsSuccess)
        {
            _errorTitle = L["Ledger_ErrorTitle"];
            _errorMessage = ledger.Error?.Detail ?? ApiLocalizer.Describe(ledger.Status, ledger.Error).Message;
        }

        _loading = false;
    }

    private void GoAddPayment() => Nav.NavigateTo($"/customers/{CustomerId:D}/repayments/new");
    private void GoRepayment(Guid repaymentId) => Nav.NavigateTo($"/customers/{CustomerId:D}/repayments/{repaymentId:D}");
}

@page "/overdue"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCustomerClient Customers
@inject ICurrentUserContext CurrentUser
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-overdue">
    <Page>
        <PageHeader Title="@L["Overdue_Title"]" Subtitle="@L["Overdue_Subtitle"]" />

        <div class="pos-action-grid pos-action-grid--two pos-overdue__actions" role="group" aria-label="@L["Overdue_Title"]">
            <button type="button"
                    class="pos-action-tile"
                    @onclick="GoCustomers">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                <span class="pos-action-tile__label">@L["Customers_Title"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(_loading || _creditsLoading)"
                    @onclick="ReloadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Overdue_Refresh"]</span>
            </button>
        </div>

        <Alert Tone="AlertTone.Info" Title="@L["Overdue_PolicyTitle"]" Message="@L["Overdue_PolicyMessage"]" />

        <Section Title="@L["Overdue_CustomersTitle"]">
            @if (_loading)
            {
                <Stack Align="StackAlign.Center" Gap="2">
                    <Spinner />
                    <span class="pos-muted">@L["Overdue_Loading"]</span>
                </Stack>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Overdue_ErrorTitle"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_customers.Count == 0)
            {
                <EmptyState IconName="customers"
                            Title="@L["Overdue_EmptyCustomersTitle"]"
                            Message="@L["Overdue_EmptyCustomersMessage"]" />
            }
            else
            {
                <div class="pos-overdue__list" role="list" aria-label="@L["Overdue_CustomersTitle"]">
                    @foreach (var item in _customers)
                    {
                        <button type="button"
                                class="pos-overdue__row"
                                role="listitem"
                                @onclick="() => GoCustomerOverdue(item.CustomerId)">
                            <div class="pos-overdue__row-main">
                                <span class="pos-overdue__row-name">@item.DisplayName</span>
                                <span class="pos-overdue__row-meta">
                                    @L["Overdue_Amount"]: <MoneyDisplay Amount="@item.OverdueAmount" CurrencyCode="PHP" />
                                    · @L["Overdue_Count"]: @item.OverdueCreditCount
                                    @if (item.EarliestOverdueDate is not null)
                                    {
                                        <text> · @L["Overdue_Earliest"]: @item.EarliestOverdueDate.Value.ToString("d")</text>
                                    }
                                </span>
                                <div class="pos-overdue__row-badges">
                                    <Badge Tone="BadgeTone.Danger">@L["DueDate_Badge_Overdue"]</Badge>
                                </div>
                            </div>
                            <div class="pos-overdue__row-side">
                                <span class="pos-overdue__view">@L["Overdue_OpenDetail"]</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </Section>

        <Section Title="@L["Overdue_CreditsTitle"]">
            @if (_creditsLoading)
            {
                <Stack Align="StackAlign.Center" Gap="2">
                    <Spinner />
                    <span class="pos-muted">@L["Overdue_Loading"]</span>
                </Stack>
            }
            else if (_credits.Count == 0)
            {
                <EmptyState IconName="warning"
                            Title="@L["Overdue_EmptyCreditsTitle"]"
                            Message="@L["Overdue_EmptyCreditsMessage"]" />
            }
            else
            {
                <div class="pos-overdue__list" role="list" aria-label="@L["Overdue_CreditsTitle"]">
                    @foreach (var credit in _credits)
                    {
                        <button type="button"
                                class="pos-overdue__row"
                                role="listitem"
                                @onclick="() => GoCredit(credit.CustomerId, credit.CreditEntryId)">
                            <div class="pos-overdue__row-main">
                                <span class="pos-overdue__row-name">
                                    <MoneyDisplay Amount="@credit.RemainingUnpaidAmount" CurrencyCode="PHP" />
                                </span>
                                @if (!string.IsNullOrWhiteSpace(credit.Remarks))
                                {
                                    <span class="pos-overdue__row-meta">@credit.Remarks</span>
                                }
                                <span class="pos-overdue__row-meta">
                                    @L["DueDate_Current"]: @(credit.CurrentDueDate?.ToString("d") ?? L["DueDate_None"])
                                </span>
                                <div class="pos-overdue__row-badges">
                                    <Badge Tone="BadgeTone.Danger">@L["DueDate_Badge_Overdue"]</Badge>
                                </div>
                            </div>
                            <div class="pos-overdue__row-side">
                                <span class="pos-overdue__view">@L["Customers_View"]</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </Section>
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading = true;
    private bool _creditsLoading;
    private List<PosOverdueCustomerListItemDto> _customers = [];
    private List<PosAgedCreditDto> _credits = [];
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _creditsLoading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        var customers = await Customers.ListOverdueCustomersAsync(page: 1, pageSize: 50);
        if (customers.IsSuccess && customers.Data is not null)
        {
            _customers = customers.Data.Items;
        }
        else
        {
            _customers = [];
            var described = ApiLocalizer.Describe(customers.Status, customers.Error);
            _errorTitle = described.Title;
            _errorMessage = customers.Error?.Detail ?? described.Message;
        }

        _loading = false;

        var credits = await Customers.ListOverdueCreditsAsync(page: 1, pageSize: 50);
        if (credits.IsSuccess && credits.Data is not null)
        {
            _credits = credits.Data.Items;
        }
        else
        {
            _credits = [];
        }

        _creditsLoading = false;
    }

    private void GoCustomers() => Nav.NavigateTo("/customers");
    private void GoCustomerOverdue(Guid id) => Nav.NavigateTo($"/customers/{id:D}/overdue");
    private void GoCredit(Guid customerId, Guid creditId) => Nav.NavigateTo($"/customers/{customerId:D}/credit/{creditId:D}");
}

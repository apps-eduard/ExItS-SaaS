@page "/offline-pin"
@layout Layout.AuthShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject RoleHomeResolver RoleHome
@inject IPosSyncStatusService SyncStatus
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-offline-pin">
    <Page>
        <header class="pos-offline-pin__header">
            <div class="pos-offline-pin__badge" aria-hidden="true">@IconGlyphs.Get("lock")</div>
            <h1 class="pos-offline-pin__title">@L["Offline_PinTitle"]</h1>
            <p class="pos-offline-pin__subtitle">@L["Offline_PinSubtitle"]</p>
            <p class="pos-offline-pin__status" role="status">@L["Offline_Banner"]</p>
        </header>

        @if (!string.IsNullOrEmpty(_error))
        {
            <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
        }

        <div class="pos-offline-pin__field">
            <label class="pos-offline-pin__label" for="offline-pin">@L["Offline_PinLabel"]</label>
            <div class="pos-offline-pin__input-wrap">
                <input id="offline-pin"
                       type="@(_showPin ? "text" : "password")"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="one-time-code"
                       maxlength="12"
                       class="pos-offline-pin__input"
                       disabled="@_busy"
                       aria-invalid="@(!string.IsNullOrEmpty(_error))"
                       @bind="_pin"
                       @bind:event="oninput"
                       @onkeydown="OnPinKeyDownAsync" />
                <button type="button"
                        class="pos-offline-pin__toggle"
                        disabled="@_busy"
                        aria-pressed="@_showPin"
                        aria-label="@(_showPin ? L["Offline_PinHide"] : L["Offline_PinShow"])"
                        @onclick="TogglePinVisibility">
                    @(_showPin ? L["Offline_PinHide"] : L["Offline_PinShow"])
                </button>
            </div>
        </div>

        <div class="pos-offline-pin__actions" role="group" aria-label="@L["Offline_PinTitle"]">
            <Button Variant="ButtonVariant.Primary"
                    IsLoading="_busy"
                    Disabled="_busy || string.IsNullOrWhiteSpace(_pin)"
                    OnClick="UnlockAsync">
                @L["Offline_PinUnlock"]
            </Button>
            <Button Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="GoReconnectAsync">
                @L["SyncStatus_ReconnectShort"]
            </Button>
            <button type="button"
                    class="pos-offline-pin__signout"
                    disabled="@_busy"
                    @onclick="SignOutAsync">
                @L["Auth_Logout"]
            </button>
        </div>
    </Page>
</div>

@code {
    private string _pin = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _showPin;

    private void TogglePinVisibility() => _showPin = !_showPin;

    private async Task OnPinKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            await UnlockAsync();
        }
    }

    private async Task UnlockAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_pin))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.UnlockOfflineWithPinAsync(_pin);
            if (!result.Succeeded)
            {
                _error = L[result.SafeMessageKey ?? "Offline_PinWrong"];
                _pin = string.Empty;
                return;
            }

            SyncStatus.SetReconnectRequired(false);
            SyncStatus.Refresh();
            // Do not call ResolveStartRouteAsync — it would RestoreSession and re-hit introspect offline.
            // Prefer grant-snapshot home so unlock never waits on permissions HTTP while unreachable.
            Nav.NavigateTo(RoleHome.ResolveFromOfflineGrantSnapshot(), replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoReconnectAsync() => Nav.NavigateTo("/reconnect", replace: true);

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        SyncStatus.SetReconnectRequired(false);
        Nav.NavigateTo("/signin", replace: true);
    }
}

@page "/offline-pin"
@layout Layout.AuthShell
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Offline
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject RoleHomeResolver RoleHome
@inject IPosSyncStatusService SyncStatus
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

@if (_ineligible)
{
}
else
{
<div class="pos-offline-pin">
    <Page>
        <header class="pos-offline-pin__header">
            <div class="pos-offline-pin__badge" aria-hidden="true">@IconGlyphs.Get("lock")</div>
            <h1 class="pos-offline-pin__title">@L["Offline_PinTitle"]</h1>
            <p class="pos-offline-pin__subtitle">
                @(_needsAccountPick ? L["Offline_SelectAccountSubtitle"] : L["Offline_PinSubtitle"])
            </p>
            <p class="pos-offline-pin__status" role="status">@L["Offline_Banner"]</p>
        </header>

        @if (!string.IsNullOrEmpty(_error))
        {
            <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
        }
        @if (!string.IsNullOrEmpty(_forgotHint))
        {
            <InlineMessage Tone="InlineMessageTone.Info">@_forgotHint</InlineMessage>
        }

        @if (_needsAccountPick)
        {
            <p class="pos-offline-pin__hint">@L["Offline_SelectAccountHint"]</p>
            <div class="pos-offline-pin__accounts" role="list">
                @foreach (var user in _candidates)
                {
                    <button type="button"
                            class="pos-offline-pin__account"
                            role="listitem"
                            disabled="@_busy"
                            @onclick="() => SelectAccountAsync(user)">
                        <span class="pos-offline-pin__account-name">@user.DisplayName</span>
                        @if (!string.IsNullOrWhiteSpace(user.OrganizationDisplayName))
                        {
                            <span class="pos-offline-pin__account-meta">@user.OrganizationDisplayName</span>
                        }
                    </button>
                }
            </div>
        }
        else
        {
            @if (_selected is not null)
            {
                <p class="pos-offline-pin__selected" role="status">
                    @L["Offline_UnlockingAs", _selected.DisplayName]
                    @if (_candidates.Count > 1)
                    {
                        <button type="button"
                                class="pos-offline-pin__change-user"
                                disabled="@_busy"
                                @onclick="ClearSelection">
                            @L["Offline_ChangeAccount"]
                        </button>
                    }
                </p>
            }

            <div class="pos-offline-pin__field">
                <label class="pos-offline-pin__label" for="offline-pin">@L["Offline_PinLabel"]</label>
                <div class="pos-offline-pin__input-wrap">
                    <input id="offline-pin"
                           type="@(_showPin ? "text" : "password")"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           autocomplete="one-time-code"
                           maxlength="12"
                           class="pos-offline-pin__input"
                           disabled="@_busy"
                           aria-invalid="@(!string.IsNullOrEmpty(_error))"
                           @bind="_pin"
                           @bind:event="oninput"
                           @onkeydown="OnPinKeyDownAsync" />
                    <button type="button"
                            class="pos-offline-pin__toggle"
                            disabled="@_busy"
                            aria-pressed="@_showPin"
                            aria-label="@(_showPin ? L["Offline_PinHide"] : L["Offline_PinShow"])"
                            @onclick="TogglePinVisibility">
                        @(_showPin ? L["Offline_PinHide"] : L["Offline_PinShow"])
                    </button>
                </div>
            </div>

            <div class="pos-offline-pin__actions" role="group" aria-label="@L["Offline_PinTitle"]">
                <Button Variant="ButtonVariant.Primary"
                        IsLoading="_busy"
                        Disabled="_busy || string.IsNullOrWhiteSpace(_pin) || _selected is null"
                        OnClick="UnlockAsync">
                    @L["Offline_PinUnlock"]
                </Button>
                <Button Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="GoReconnectAsync">
                    @L["SyncStatus_ReconnectShort"]
                </Button>
                <button type="button"
                        class="pos-offline-pin__signout"
                        disabled="@_busy"
                        @onclick="ShowForgotPin">
                    @L["Offline_PinForgotAction"]
                </button>
                <button type="button"
                        class="pos-offline-pin__signout"
                        disabled="@_busy"
                        @onclick="SignOutAsync">
                    @L["Auth_Logout"]
                </button>
            </div>
        }
    </Page>
</div>
}

@code {
    private string _pin = string.Empty;
    private string? _error;
    private string? _forgotHint;
    private bool _busy;
    private bool _showPin;
    private bool _ineligible;
    private IReadOnlyList<OfflineEnrolledUserSummary> _candidates = Array.Empty<OfflineEnrolledUserSummary>();
    private OfflineEnrolledUserSummary? _selected;

    private bool _needsAccountPick => _selected is null && _candidates.Count > 1;

    private void TogglePinVisibility() => _showPin = !_showPin;

    protected override async Task OnInitializedAsync()
    {
        var offer = await Auth.EvaluateOfflineColdStartOfferAsync();
        if (!offer.CanOfferPinUnlock)
        {
            // First-time / incomplete setup: never show a PIN field or "Invalid PIN".
            _ineligible = true;
            Nav.NavigateTo("/signin", replace: true);
            return;
        }

        _candidates = offer.UnlockCandidates?
            .Where(c => c.HasPinConfigured)
            .ToArray()
            ?? Array.Empty<OfflineEnrolledUserSummary>();

        if (_candidates.Count == 0)
        {
            _ineligible = true;
            Nav.NavigateTo("/signin", replace: true);
            return;
        }

        if (_candidates.Count == 1)
        {
            _selected = _candidates[0];
        }
    }

    private Task SelectAccountAsync(OfflineEnrolledUserSummary user)
    {
        _selected = user;
        _error = null;
        _forgotHint = null;
        _pin = string.Empty;
        return Task.CompletedTask;
    }

    private void ClearSelection()
    {
        if (_candidates.Count <= 1)
        {
            return;
        }

        _selected = null;
        _pin = string.Empty;
        _error = null;
        _forgotHint = null;
    }

    private async Task OnPinKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            await UnlockAsync();
        }
    }

    private async Task UnlockAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_pin) || _selected is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _forgotHint = null;
        try
        {
            var result = await Auth.UnlockOfflineWithPinAsync(_selected.UserId, _pin);
            if (!result.Succeeded)
            {
                _error = L[result.SafeMessageKey ?? "Offline_PinWrong"];
                _pin = string.Empty;
                return;
            }

            SyncStatus.SetReconnectRequired(false);
            SyncStatus.NotifyApiReachability(false);
            SyncStatus.Refresh();
            Nav.NavigateTo(RoleHome.ResolveFromOfflineGrantSnapshot(), replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowForgotPin()
    {
        _error = null;
        _forgotHint = L["Offline_PinForgotOfflineMessage"];
    }

    private void GoReconnectAsync() => Nav.NavigateTo("/reconnect", replace: true);

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        SyncStatus.SetReconnectRequired(false);
        Nav.NavigateTo("/signin", replace: true);
    }
}

@page "/catalog/products/{ProductId:guid}/edit"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject IPosInventoryClient Inventory
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/catalog/products/{ProductId:D}")" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Catalog_Loading"]</span></Page>
}
else if (_product is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Catalog_Product_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Catalog_Product_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
    var canTrackStock = Capabilities.IsAllowed(UtangCapability.ManageInventory);
<div class="pos-catalog-product-edit">
<Page>
    <header class="pos-catalog-product-edit__header">
        <h1 class="pos-catalog-product-edit__title">@L["Catalog_Product_EditTitle"]</h1>
        <p class="pos-catalog-product-edit__subtitle">@_product.Name</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
    }
    else if (!canManage)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Catalog_ErrorTitle"]" Message="@_formError" />
    }

    <section class="pos-catalog-product-edit__panel" aria-label="@L["Catalog_Product_EditTitle"]">
        <div class="pos-catalog-product-edit__form">
            <CatalogProductForm Name="@_name"
                                NameChanged="v => _name = v"
                                Description="@_description"
                                DescriptionChanged="v => _description = v"
                                Sku="@_sku"
                                SkuChanged="v => _sku = v"
                                Barcode="@_barcode"
                                BarcodeChanged="v => _barcode = v"
                                CategoryId="@_categoryId"
                                CategoryIdChanged="v => _categoryId = v"
                                UnitOfMeasure="@_unitOfMeasure"
                                UnitOfMeasureChanged="v => _unitOfMeasure = v"
                                UsagePreset="@_usagePreset"
                                UsagePresetChanged="OnUsagePresetChanged"
                                IngredientAlsoSellable="@_ingredientAlsoSellable"
                                IngredientAlsoSellableChanged="v => _ingredientAlsoSellable = v"
                                ShowAdvancedUnits="@ShowAdvancedUnits"
                                SetPackages="@_setPackages"
                                SetPackagesChanged="OnSetPackagesChanged"
                                ShowIngredientSellable="@(_usagePreset == "Ingredient")"
                                PurchaseUnits="@_purchaseUnits"
                                SellUnits="@_sellUnits"
                                SellingMode="@_sellingMode"
                                SellingModeChanged="v => _sellingMode = v"
                                SellingPrice="@_sellingPrice"
                                SellingPriceChanged="v => _sellingPrice = v"
                                Categories="@_categories"
                                NameError="@_nameError"
                                SkuError="@_skuError"
                                BarcodeError="@_barcodeError"
                                SellingPriceError="@_priceError"
                                IsSaving="@_saving"
                                Disabled="@(!canManage || _isOffline)"
                                ShowStockTracking="@(canTrackStock && !_isOffline)"
                                TrackStock="@_trackStock"
                                TrackStockChanged="v => _trackStock = v"
                                TracksExpiration="@_tracksExpiration"
                                TracksExpirationChanged="v => _tracksExpiration = v"
                                ExpirationWarningDaysText="@_warningDaysText"
                                ExpirationWarningDaysTextChanged="v => _warningDaysText = v"
                                SaveLabel="@L["Catalog_Save"]"
                                OnSave="SaveAsync"
                                OnCancel="GoDetail" />
            <section class="pos-settings__panel pos-catalog-connected" aria-labelledby="catalog-connected-buyers-heading">
                <h2 id="catalog-connected-buyers-heading">@L["Catalog_ConnectedBuyers_Section"]</h2>
                <label class="pos-catalog-connected__toggle">
                    <input type="checkbox"
                           checked="@_isBlockedFromConnectedBuyers"
                           disabled="@(!canManage || _isOffline || _saving)"
                           @onchange="OnBlockedFromConnectedBuyersChanged" />
                    @L["Catalog_ConnectedBuyers_Block"]
                </label>
                <p class="pos-catalog-connected__help pos-muted">@L["Catalog_ConnectedBuyers_VisibilityHelp"]</p>
                <div class="pos-catalog-connected__price">
                    <CurrencyInput Label="@L["Catalog_ConnectedBuyers_DefaultPoPrice"]"
                                   Value="@_defaultConnectedPoPrice"
                                   ValueChanged="v => _defaultConnectedPoPrice = v"
                                   CurrencyCode="PHP"
                                   Hint="@L["Catalog_ConnectedBuyers_DefaultPoHelp"]"
                                   Disabled="@(!canManage || _isOffline || _saving)" />
                </div>
            </section>
        </div>
    </section>
</Page>
</div>
}

@code {
    [Parameter] public Guid ProductId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _saving;
    private bool _isOffline;
    private PosCatalogProductDto? _product;
    private string? _name;
    private string? _description;
    private string? _sku;
    private string? _barcode;
    private string? _categoryId;
    private string? _unitOfMeasure;
    private string? _usagePreset = "BuyAndSell";
    private bool _ingredientAlsoSellable;
    private bool _setPackages;
    private readonly List<ProductUnitDraft> _purchaseUnits = [];
    private readonly List<ProductUnitDraft> _sellUnits = [];
    private string? _sellingMode = PosCatalogOptions.DefaultSellingModeCode;
    private decimal? _sellingPrice;
    private bool _isBlockedFromConnectedBuyers;
    private decimal? _defaultConnectedPoPrice;
    private bool _trackStock;
    private bool _initialTrackStock;
    private decimal _onHandQuantity;
    private bool _tracksExpiration;
    private string? _warningDaysText = "7";
    private IReadOnlyList<PosProductCategoryDto> _categories = Array.Empty<PosProductCategoryDto>();
    private string? _nameError;
    private string? _skuError;
    private string? _barcodeError;
    private string? _priceError;
    private string? _formError;
    private string? _errorTitle;
    private string? _errorMessage;

    private bool ShowAdvancedUnits =>
        string.Equals(_usagePreset, "Bulk", StringComparison.Ordinal) || _setPackages;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _formError = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _product = null;
            _errorTitle = L["Catalog_OfflineTitle"];
            _formError = L["Catalog_OfflineMessage"];
            _errorMessage = L["Catalog_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Catalog.GetProductAsync(ProductId);
        if (result.IsSuccess && result.Data is not null)
        {
            _product = result.Data;
            _name = _product.Name;
            _description = _product.Description;
            _sku = _product.Sku;
            _barcode = _product.Barcode;
            _categoryId = _product.CategoryId?.ToString("D");
            _unitOfMeasure = _product.UnitOfMeasure;
            _usagePreset = string.IsNullOrWhiteSpace(_product.UsagePreset) ? "BuyAndSell" : _product.UsagePreset;
            _ingredientAlsoSellable = _usagePreset == "IngredientAndSellable"
                || (_product.CanBeUsedAsIngredient && _product.CanBeSold);
            _sellingMode = string.IsNullOrWhiteSpace(_product.SellingMode)
                ? PosCatalogOptions.DefaultSellingModeCode
                : _product.SellingMode;
            _sellingPrice = _product.SellingPrice;
            _isBlockedFromConnectedBuyers = !_product.CanExposeToConnectedBuyers;
            _defaultConnectedPoPrice = _product.DefaultConnectedPoPrice;
            _trackStock = _product.IsTracked;
            _initialTrackStock = _product.IsTracked;
            _onHandQuantity = _product.OnHandQuantity;
            _tracksExpiration = _product.TracksExpiration;
            _warningDaysText = (_product.ExpirationWarningDays ?? 7).ToString();

            HydrateUnitDrafts(_product.Units);

            var categories = await Catalog.ListCategoriesAsync(
                status: PosCatalogOptions.ActiveStatus,
                page: 1,
                pageSize: 100);
            if (categories.IsSuccess && categories.Data is not null)
            {
                _categories = categories.Data.Items;
            }

            if (_product.CategoryId is { } assigned && _categories.All(c => c.CategoryId != assigned))
            {
                var current = await Catalog.GetCategoryAsync(assigned);
                if (current.IsSuccess && current.Data is not null)
                {
                    _categories = _categories.Append(current.Data).ToList();
                }
            }
        }
        else
        {
            _product = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private void HydrateUnitDrafts(IReadOnlyList<PosCatalogProductUnitDto>? units)
    {
        _purchaseUnits.Clear();
        _sellUnits.Clear();
        if (units is not null)
        {
            foreach (var unit in units.Where(u => u.IsActive).OrderBy(u => u.SortOrder).ThenBy(u => u.DisplayName))
            {
                if (string.Equals(unit.Kind, "Purchase", StringComparison.OrdinalIgnoreCase))
                {
                    _purchaseUnits.Add(ProductUnitDraft.FromDto(unit));
                }
                else if (string.Equals(unit.Kind, "Sell", StringComparison.OrdinalIgnoreCase))
                {
                    _sellUnits.Add(ProductUnitDraft.FromDto(unit));
                }
            }
        }

        _setPackages = string.Equals(_usagePreset, "Bulk", StringComparison.Ordinal)
            || ProductUnitDraft.SuggestsAdvancedPackages(units)
            || _purchaseUnits.Count > 1
            || _sellUnits.Count > 1;

        if (ShowAdvancedUnits)
        {
            ProductUnitDraft.EnsureDefaults(_purchaseUnits, _sellUnits, _unitOfMeasure, _sellingPrice);
        }
    }

    private async Task SaveAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog) || _product is null)
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _nameError = null;
        _skuError = null;
        _barcodeError = null;
        _priceError = null;
        _formError = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _nameError = L["Catalog_NameRequired"];
            return;
        }

        if (ShowAdvancedUnits && _sellUnits.Count > 0 && _sellUnits[0].SellingPrice is decimal sellPrice)
        {
            _sellingPrice = sellPrice;
        }

        if (_sellingPrice is null || _sellingPrice < 0m)
        {
            _priceError = L["Catalog_PriceRequired"];
            return;
        }

        var trackingChanged = _trackStock != _initialTrackStock;
        if (trackingChanged && !Capabilities.IsAllowed(UtangCapability.ManageInventory))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        if (trackingChanged && !_trackStock && _onHandQuantity != 0m)
        {
            _formError = L["Catalog_TrackStockDisableRequiresZero"];
            return;
        }

        _saving = true;
        try
        {
            IReadOnlyList<PosCatalogProductUnitInput>? units = null;
            if (ShowAdvancedUnits)
            {
                ProductUnitDraft.EnsureDefaults(_purchaseUnits, _sellUnits, _unitOfMeasure, _sellingPrice);
                units = ProductUnitDraft.ToInputs(_purchaseUnits, _sellUnits);
            }

            var result = await Catalog.UpdateProductAsync(ProductId, new UpdatePosCatalogProductRequest(
                _name.Trim(),
                _unitOfMeasure ?? PosCatalogOptions.DefaultUnitOfMeasureCode,
                _sellingPrice.Value,
                string.IsNullOrWhiteSpace(_description) ? null : _description,
                string.IsNullOrWhiteSpace(_sku) ? null : _sku,
                string.IsNullOrWhiteSpace(_barcode) ? null : _barcode,
                Guid.TryParse(_categoryId, out var categoryId) ? categoryId : null,
                _product.UpdatedAtUtc,
                SellingMode: _sellingMode ?? PosCatalogOptions.DefaultSellingModeCode,
                TracksExpiration: _tracksExpiration,
                ExpirationWarningDays: _tracksExpiration && int.TryParse(_warningDaysText, out var days) ? days : null,
                UsagePreset: ResolveUsagePresetForSave(),
                Units: units,
                CanExposeToConnectedBuyers: !_isBlockedFromConnectedBuyers,
                DefaultConnectedPoPrice: _defaultConnectedPoPrice));

            if (!result.IsSuccess || result.Data is null)
            {
                var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
                _nameError = mapped.Name;
                _skuError = mapped.Sku;
                _barcodeError = mapped.Barcode;
                _formError = mapped.Form
                    ?? result.Error?.Detail
                    ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            _product = result.Data;

            if (trackingChanged)
            {
                var trackingResult = _trackStock
                    ? await Inventory.EnableAsync(ProductId, new EnableInventoryTrackingRequest())
                    : await Inventory.DisableAsync(ProductId);

                if (!trackingResult.IsSuccess)
                {
                    _formError = trackingResult.Error?.Detail
                        ?? ApiLocalizer.Describe(trackingResult.Status, trackingResult.Error).Message
                        ?? L["Catalog_TrackStockFailed"];
                    _initialTrackStock = !_trackStock;
                    return;
                }

                _initialTrackStock = _trackStock;
                if (trackingResult.Data is not null)
                {
                    _onHandQuantity = trackingResult.Data.OnHandQuantity;
                }
            }

            Nav.NavigateTo($"/catalog/products/{ProductId:D}", replace: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoDetail() => Nav.NavigateTo($"/catalog/products/{ProductId:D}");

    private void OnBlockedFromConnectedBuyersChanged(ChangeEventArgs args)
    {
        _isBlockedFromConnectedBuyers = args.Value is true
            || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    }

    private Task OnUsagePresetChanged(string? value)
    {
        _usagePreset = value ?? "BuyAndSell";
        if (_usagePreset != "Ingredient")
        {
            _ingredientAlsoSellable = _usagePreset == "IngredientAndSellable";
        }

        if (string.Equals(_usagePreset, "Bulk", StringComparison.Ordinal))
        {
            ProductUnitDraft.EnsureDefaults(_purchaseUnits, _sellUnits, _unitOfMeasure, _sellingPrice);
        }

        return Task.CompletedTask;
    }

    private Task OnSetPackagesChanged(bool value)
    {
        _setPackages = value;
        if (value)
        {
            ProductUnitDraft.EnsureDefaults(_purchaseUnits, _sellUnits, _unitOfMeasure, _sellingPrice);
        }

        return Task.CompletedTask;
    }

    private string ResolveUsagePresetForSave()
    {
        if (_usagePreset == "Ingredient" && _ingredientAlsoSellable)
        {
            return "IngredientAndSellable";
        }

        return string.IsNullOrWhiteSpace(_usagePreset) ? "BuyAndSell" : _usagePreset;
    }
}

@page "/catalog/products/new"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject IPosInventoryClient Inventory
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IProductImagePicker ProductImages
@inject ICatalogProductOfflineSyncService OfflineCreate
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/catalog" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
    var canTrackStock = Capabilities.IsAllowed(UtangCapability.ManageInventory);
<Page>
    <div class="pos-product-form-page">
        <header class="pos-product-form-page__header">
            <h1 class="pos-product-form-page__title">@L["Catalog_Product_CreateTitle"]</h1>
            <p class="pos-product-form-page__subtitle">@L["Catalog_Product_CreateSubtitle"]</p>
        </header>

        @if (_isOffline && !_queuedOffline)
        {
            <Alert Tone="AlertTone.Info" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_Product_OfflineQueueHint"]" />
        }
        else if (!canManage)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        }

        @if (!string.IsNullOrEmpty(_formError))
        {
            <Alert Tone="AlertTone.Danger" Title="@L["Catalog_ErrorTitle"]" Message="@_formError" />
        }

        @if (_queuedOffline)
        {
            <Alert Tone="AlertTone.Info" Title="@L["Catalog_Product_QueuedTitle"]" Message="@L["Catalog_Product_QueuedMessage"]" />
            <div class="pos-product-form__actions">
                <Button Variant="ButtonVariant.Primary" OnClick="GoBack">@L["Catalog_BackToList"]</Button>
            </div>
        }
        else if (_createdProductId is { } created)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_Product_CreatedTitle"]" Message="@L["Catalog_TrackStockFailed"]" />
            <div class="pos-product-form__actions">
                <Button Variant="ButtonVariant.Primary" OnClick="() => GoProduct(created)">@L["Catalog_Product_View"]</Button>
            </div>
        }
        else
        {
            <CatalogProductImageEditor PreviewDataUrl="@_imagePreviewUrl"
                                       HasServerImage="false"
                                       Disabled="@(!canManage || _saving)"
                                       Error="@_imageError"
                                       OnChoose="() => PickImageAsync(false)"
                                       OnCapture="() => PickImageAsync(true)"
                                       OnRemove="ClearPendingImage" />
            <CatalogProductForm Name="@_name"
                                NameChanged="v => _name = v"
                                Description="@_description"
                                DescriptionChanged="v => _description = v"
                                Sku="@_sku"
                                SkuChanged="v => _sku = v"
                                Barcode="@_barcode"
                                BarcodeChanged="v => _barcode = v"
                                CategoryId="@_categoryId"
                                CategoryIdChanged="v => _categoryId = v"
                                UnitOfMeasure="@_unitOfMeasure"
                                UnitOfMeasureChanged="v => _unitOfMeasure = v"
                                UsagePreset="@_usagePreset"
                                UsagePresetChanged="OnUsagePresetChanged"
                                IngredientAlsoSellable="@_ingredientAlsoSellable"
                                IngredientAlsoSellableChanged="v => _ingredientAlsoSellable = v"
                                ShowAdvancedUnits="@ShowAdvancedUnits"
                                SetPackages="@_setPackages"
                                SetPackagesChanged="OnSetPackagesChanged"
                                ShowIngredientSellable="@(_usagePreset == "Ingredient")"
                                PurchaseUnits="@_purchaseUnits"
                                SellUnits="@_sellUnits"
                                SellingMode="@_sellingMode"
                                SellingModeChanged="v => _sellingMode = v"
                                SellingPrice="@_sellingPrice"
                                SellingPriceChanged="OnSellingPriceChanged"
                                Categories="@_categories"
                                NameError="@_nameError"
                                SkuError="@_skuError"
                                BarcodeError="@_barcodeError"
                                SellingPriceError="@_priceError"
                                IsSaving="@_saving"
                                Disabled="@(!canManage || _saving)"
                                ShowStockTracking="@(canTrackStock && !_isOffline)"
                                TrackStock="@_trackStock"
                                TrackStockChanged="v => _trackStock = v"
                                TracksExpiration="@_tracksExpiration"
                                TracksExpirationChanged="v => _tracksExpiration = v"
                                ExpirationWarningDaysText="@_warningDaysText"
                                ExpirationWarningDaysTextChanged="v => _warningDaysText = v"
                                SaveLabel="@L["Catalog_Product_Create"]"
                                OnSave="SaveAsync"
                                OnCancel="GoBack" />
            <section class="pos-settings__panel pos-catalog-connected" aria-labelledby="catalog-connected-buyers-heading">
                <h2 id="catalog-connected-buyers-heading">@L["Catalog_ConnectedBuyers_Section"]</h2>
                <label class="pos-catalog-connected__toggle">
                    <input type="checkbox"
                           checked="@_isBlockedFromConnectedBuyers"
                           disabled="@(!canManage || _saving)"
                           @onchange="OnBlockedFromConnectedBuyersChanged" />
                    @L["Catalog_ConnectedBuyers_Block"]
                </label>
                <p class="pos-catalog-connected__help pos-muted">@L["Catalog_ConnectedBuyers_VisibilityHelp"]</p>
                <div class="pos-catalog-connected__price">
                    <CurrencyInput Label="@L["Catalog_ConnectedBuyers_DefaultPoPrice"]"
                                   Value="@_defaultConnectedPoPrice"
                                   ValueChanged="OnDefaultPoPriceChanged"
                                   CurrencyCode="PHP"
                                   Hint="@L["Catalog_ConnectedBuyers_DefaultPoHelp"]"
                                   Disabled="@(!canManage || _saving)" />
                </div>
            </section>
        }
    </div>
</Page>
}

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "preferTrack")]
    public bool PreferTrack { get; set; }

    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private bool _queuedOffline;
    private string? _name;
    private string? _description;
    private string? _sku;
    private string? _barcode;
    private string? _categoryId;
    private string? _unitOfMeasure = PosCatalogOptions.DefaultUnitOfMeasureCode;
    private string? _usagePreset = "BuyAndSell";
    private bool _ingredientAlsoSellable;
    private bool _setPackages;
    private readonly List<ProductUnitDraft> _purchaseUnits = [];
    private readonly List<ProductUnitDraft> _sellUnits = [];
    private string? _sellingMode = PosCatalogOptions.DefaultSellingModeCode;
    private decimal? _sellingPrice;
    private bool _isBlockedFromConnectedBuyers;
    private decimal? _defaultConnectedPoPrice;
    private bool _defaultPoFollowsRetail = true;
    private bool _trackStock;
    private bool _tracksExpiration;
    private string? _warningDaysText = "7";
    private Guid? _createdProductId;
    private IReadOnlyList<PosProductCategoryDto> _categories = Array.Empty<PosProductCategoryDto>();
    private string? _nameError;
    private string? _skuError;
    private string? _barcodeError;
    private string? _priceError;
    private string? _formError;
    private string? _imageError;
    private byte[]? _pendingImageBytes;
    private string? _pendingImageFileName;
    private string? _imagePreviewUrl;

    private bool ShowAdvancedUnits =>
        string.Equals(_usagePreset, "Bulk", StringComparison.Ordinal) || _setPackages;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (PreferTrack && Capabilities.IsAllowed(UtangCapability.ManageInventory))
        {
            _trackStock = true;
        }

        if (!_isOffline)
        {
            var categories = await Catalog.ListCategoriesAsync(
                status: PosCatalogOptions.ActiveStatus,
                page: 1,
                pageSize: 100);
            if (categories.IsSuccess && categories.Data is not null)
            {
                _categories = categories.Data.Items;
            }
        }
    }

    private async Task SaveAsync()
    {
        if (_saving || _createdProductId is not null)
        {
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _nameError = null;
        _skuError = null;
        _barcodeError = null;
        _priceError = null;
        _formError = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _nameError = L["Catalog_NameRequired"];
            return;
        }

        if (ShowAdvancedUnits && _sellUnits.Count > 0 && _sellUnits[0].SellingPrice is decimal sellPrice)
        {
            OnSellingPriceChanged(sellPrice);
        }

        if (_sellingPrice is null || _sellingPrice < 0m)
        {
            _priceError = L["Catalog_PriceRequired"];
            return;
        }

        _saving = true;
        try
        {
            IReadOnlyList<PosCatalogProductUnitInput>? units = null;
            if (ShowAdvancedUnits)
            {
                ProductUnitDraft.EnsureDefaults(_purchaseUnits, _sellUnits, _unitOfMeasure, _sellingPrice);
                units = ProductUnitDraft.ToInputs(_purchaseUnits, _sellUnits);
            }

            var request = new CreatePosCatalogProductRequest(
                _name.Trim(),
                _unitOfMeasure ?? PosCatalogOptions.DefaultUnitOfMeasureCode,
                _sellingPrice.Value,
                string.IsNullOrWhiteSpace(_description) ? null : _description,
                string.IsNullOrWhiteSpace(_sku) ? null : _sku,
                string.IsNullOrWhiteSpace(_barcode) ? null : _barcode,
                Guid.TryParse(_categoryId, out var categoryId) ? categoryId : null,
                SellingMode: _sellingMode ?? PosCatalogOptions.DefaultSellingModeCode,
                TracksExpiration: _tracksExpiration,
                ExpirationWarningDays: ParseWarningDays(),
                UsagePreset: ResolveUsagePresetForSave(),
                Units: units,
                CanExposeToConnectedBuyers: !_isBlockedFromConnectedBuyers,
                DefaultConnectedPoPrice: _defaultConnectedPoPrice ?? _sellingPrice);

            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                var queued = await OfflineCreate.QueueCreateAsync(request, _pendingImageBytes);
                if (!queued.IsSuccess)
                {
                    _formError = string.Equals(queued.ErrorCode, "offline_mutations_unavailable", StringComparison.Ordinal)
                        ? L["Offline_MutationsUnavailable"]
                        : queued.ErrorMessage ?? L["Catalog_ErrorTitle"];
                    return;
                }

                _queuedOffline = true;
                return;
            }

            var result = await Catalog.CreateProductAsync(request);

            if (!result.IsSuccess || result.Data is null)
            {
                var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
                _nameError = mapped.Name;
                _skuError = mapped.Sku;
                _barcodeError = mapped.Barcode;
                _formError = mapped.Form
                    ?? result.Error?.Detail
                    ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            var productId = result.Data.ProductId;
            if (_pendingImageBytes is { Length: > 0 })
            {
                var uploaded = await Catalog.UploadProductImageAsync(
                    productId,
                    _pendingImageBytes,
                    _pendingImageFileName ?? "image.jpg");
                if (!uploaded.IsSuccess)
                {
                    _createdProductId = productId;
                    _formError = uploaded.Error?.Detail
                        ?? ApiLocalizer.Describe(uploaded.Status, uploaded.Error).Message
                        ?? L["Catalog_Image_SaveFailed"];
                    return;
                }
            }

            if (_trackStock
                && Capabilities.IsAllowed(UtangCapability.ManageInventory)
                && !await EnableStockTrackingAsync(productId))
            {
                // The product exists; keep the user here so the tracking failure is not lost.
                _createdProductId = productId;
                return;
            }

            NavigateAfterCreate(productId);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<bool> EnableStockTrackingAsync(Guid productId)
    {
        var result = await Inventory.EnableAsync(productId, new EnableInventoryTrackingRequest());
        return result.IsSuccess;
    }

    private int? ParseWarningDays() =>
        _tracksExpiration && int.TryParse(_warningDaysText, out var days) ? days : null;

    private void NavigateAfterCreate(Guid productId)
    {
        if (TryBuildReturnNavigation(ReturnUrl, productId, out var target))
        {
            Nav.NavigateTo(target, replace: true);
            return;
        }

        GoProduct(productId);
    }

    private async Task PickImageAsync(bool capture)
    {
        _imageError = null;
        var picked = capture
            ? await ProductImages.CaptureAsync()
            : await ProductImages.PickAsync();
        if (!picked.Succeeded)
        {
            if (!string.IsNullOrWhiteSpace(picked.ErrorKey) && picked.ErrorKey != "Catalog_Image_Cancelled")
            {
                _imageError = L[picked.ErrorKey];
            }

            return;
        }

        _pendingImageBytes = picked.Bytes;
        _pendingImageFileName = picked.FileName;
        _imagePreviewUrl = picked.Bytes is null ? null : ProductImagePreview.ToDataUrl(picked.Bytes);
    }

    private void ClearPendingImage()
    {
        _pendingImageBytes = null;
        _pendingImageFileName = null;
        _imagePreviewUrl = null;
        _imageError = null;
    }

    private static bool TryBuildReturnNavigation(string? returnUrl, Guid productId, out string target)
    {
        target = string.Empty;
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return false;
        }

        var decoded = Uri.UnescapeDataString(returnUrl.Trim());
        if (!decoded.StartsWith('/')
            || decoded.StartsWith("//", StringComparison.Ordinal)
            || decoded.Contains("://", StringComparison.Ordinal))
        {
            return false;
        }

        var separator = decoded.Contains('?', StringComparison.Ordinal) ? '&' : '?';
        target = $"{decoded}{separator}addedProductId={productId:D}";
        return true;
    }

    private void GoProduct(Guid productId) => Nav.NavigateTo($"/catalog/products/{productId:D}", replace: true);

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            var decoded = Uri.UnescapeDataString(ReturnUrl.Trim());
            if (decoded.StartsWith('/')
                && !decoded.StartsWith("//", StringComparison.Ordinal)
                && !decoded.Contains("://", StringComparison.Ordinal))
            {
                Nav.NavigateTo(decoded);
                return;
            }
        }

        Nav.NavigateTo("/catalog");
    }

    private void OnSellingPriceChanged(decimal? value)
    {
        _sellingPrice = value;
        if (_defaultPoFollowsRetail)
        {
            _defaultConnectedPoPrice = value;
        }
    }

    private void OnDefaultPoPriceChanged(decimal? value)
    {
        _defaultConnectedPoPrice = value;
        _defaultPoFollowsRetail = value is null
            || (_sellingPrice is decimal retail && value == retail);
    }

    private void OnBlockedFromConnectedBuyersChanged(ChangeEventArgs args)
    {
        _isBlockedFromConnectedBuyers = args.Value is true
            || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    }

    private Task OnUsagePresetChanged(string? value)
    {
        _usagePreset = value ?? "BuyAndSell";
        if (_usagePreset != "Ingredient")
        {
            _ingredientAlsoSellable = _usagePreset == "IngredientAndSellable";
        }

        if (string.Equals(_usagePreset, "Bulk", StringComparison.Ordinal))
        {
            ProductUnitDraft.EnsureDefaults(_purchaseUnits, _sellUnits, _unitOfMeasure, _sellingPrice);
        }

        return Task.CompletedTask;
    }

    private Task OnSetPackagesChanged(bool value)
    {
        _setPackages = value;
        if (value)
        {
            ProductUnitDraft.EnsureDefaults(_purchaseUnits, _sellUnits, _unitOfMeasure, _sellingPrice);
        }

        return Task.CompletedTask;
    }

    private string ResolveUsagePresetForSave()
    {
        if (_usagePreset == "Ingredient" && _ingredientAlsoSellable)
        {
            return "IngredientAndSellable";
        }

        return string.IsNullOrWhiteSpace(_usagePreset) ? "BuyAndSell" : _usagePreset;
    }
}

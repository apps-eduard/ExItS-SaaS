@page "/catalog/import"
@layout Layout.AuthShell
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IMerchantCatalogDiscoveryClient Discovery
@inject IPosCatalogImportClient Imports
@inject ICurrentUserContext CurrentUser
@inject IOnboardingPreferenceStore Prefs
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject OnlineRequiredGuard OnlineRequired
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_canManage && !_isOnboarding)
{
<div class="pos-catalog-import">
    <Page>
        <header class="pos-catalog-import__header">
            <h1 class="pos-catalog-import__title">@L["Catalog_Import_Title"]</h1>
            <p class="pos-catalog-import__subtitle">@L["Catalog_Import_Subtitle"]</p>
        </header>
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        <div class="pos-action-grid pos-action-grid--single pos-catalog-import__actions">
            <button type="button" class="pos-action-tile" @onclick="GoCatalog">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["Catalog_Title"]</span>
            </button>
        </div>
    </Page>
</div>
}
else
{
<div class="pos-catalog-import">
    <Page>
        <header class="pos-catalog-import__header">
            <h1 class="pos-catalog-import__title">@L["Catalog_Import_Title"]</h1>
            <p class="pos-catalog-import__subtitle">@(_isOnboarding ? L["Catalog_Import_OnboardingSubtitle"] : L["Catalog_Import_Subtitle"])</p>
        </header>

        @if (_isOnboarding)
        {
            <div class="pos-action-grid pos-action-grid--single pos-catalog-import__actions" role="group" aria-label="@L["Catalog_Import_Title"]">
                <button type="button"
                        class="pos-action-tile"
                        disabled="@_busy"
                        @onclick="SkipOnboardingAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Import_Skip"]</span>
                </button>
            </div>
        }
        else
        {
            <div class="pos-action-grid pos-action-grid--two pos-catalog-import__actions" role="group" aria-label="@L["Catalog_Import_Title"]">
                <button type="button"
                        class="pos-action-tile"
                        @onclick="GoCatalog">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Title"]</span>
                </button>
                <button type="button"
                        class="pos-action-tile"
                        disabled="@_isOffline"
                        @onclick="GoGlobal">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Global_Browse"]</span>
                </button>
            </div>
        }

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_Import_OfflineMessage"]" />
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Catalog_ErrorTitle"])" Message="@_errorMessage" />
        }

        <Section Title="@L["Catalog_Import_StepsTitle"]">
            <ol class="pos-catalog-import__steps" aria-label="@L["Catalog_Import_StepsTitle"]">
                <li class="pos-catalog-import__step @StepClass(WizardStep.Choose)">
                    <span class="pos-catalog-import__step-num" aria-hidden="true">1</span>
                    <span class="pos-catalog-import__step-label">@L["Catalog_Import_Step_Choose"]</span>
                </li>
                <li class="pos-catalog-import__step @StepClass(WizardStep.Preview)">
                    <span class="pos-catalog-import__step-num" aria-hidden="true">2</span>
                    <span class="pos-catalog-import__step-label">@L["Catalog_Import_Step_Preview"]</span>
                </li>
                <li class="pos-catalog-import__step @StepClass(WizardStep.Confirm)">
                    <span class="pos-catalog-import__step-num" aria-hidden="true">3</span>
                    <span class="pos-catalog-import__step-label">@L["Catalog_Import_Step_Confirm"]</span>
                </li>
            </ol>
        </Section>

        @if (_step == WizardStep.Choose)
        {
            <Section Title="@L["Catalog_Import_ChooseTitle"]">
                <div class="pos-catalog-import__toolbar">
                    <div class="pos-catalog-import__search">
                        <span class="pos-catalog-import__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                        <input class="pos-catalog-import__search-input"
                               type="search"
                               value="@_search"
                               placeholder="@L["Catalog_Import_SearchTemplates"]"
                               disabled="@(_loading || _isOffline || _busy)"
                               @oninput="OnSearchInputAsync" />
                    </div>
                    <button type="button"
                            class="pos-action-tile pos-catalog-import__refresh"
                            disabled="@(_loading || _isOffline || _busy)"
                            @onclick="ReloadTemplatesAsync">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                        <span class="pos-action-tile__label">@L["Catalog_Refresh"]</span>
                    </button>
                </div>

                @if (_loading)
                {
                    <Stack Align="StackAlign.Center" Gap="2">
                        <Spinner />
                        <span class="pos-muted">@L["Common_Loading"]</span>
                    </Stack>
                }
                else if (_templates.Count == 0)
                {
                    <EmptyState IconName="inbox" Title="@L["Catalog_Import_EmptyTitle"]" Message="@L["Catalog_Import_EmptyMessage"]" />
                }
                else
                {
                    <div class="pos-catalog-import__list" role="list" aria-label="@L["Catalog_Import_ChooseTitle"]">
                        @foreach (var template in _templates)
                        {
                            var selected = _selectedTemplateId == template.Id;
                            var status = StatusFor(template.Id);
                            var fullyImported = IsFullyImported(status);
                            var nextBatchReady = status?.CanImportNextBatch == true;
                            var selectDisabled = _isOffline || _busy || fullyImported;
                            <div class="pos-catalog-import__template @(selected ? "pos-row--selected" : null) @(fullyImported ? "pos-catalog-import__template--done" : null)"
                                 role="listitem">
                                <div class="pos-catalog-import__template-main">
                                    <div class="pos-catalog-import__template-name">
                                        <span class="pos-catalog-import__template-title">@template.Name</span>
                                        @if (fullyImported)
                                        {
                                            <Badge Tone="BadgeTone.Success">@L["Catalog_Import_AlreadyImported"]</Badge>
                                        }
                                        else if (nextBatchReady)
                                        {
                                            <Badge Tone="BadgeTone.Info">@L["Catalog_Import_NextBatchReady"]</Badge>
                                        }
                                        else if (selected)
                                        {
                                            <Badge Tone="BadgeTone.Info">@L["Catalog_Import_Selected"]</Badge>
                                        }
                                    </div>
                                    <span class="pos-catalog-import__template-meta">
                                        @template.PrimaryBusinessType · @string.Format(L["Catalog_Import_FirstBatchCount"].Value, template.FirstBatchCount)
                                        @if (template.ProductCount > template.FirstBatchCount)
                                        {
                                            <text> · @string.Format(L["Catalog_Import_MoreBatchesCount"].Value, template.ProductCount - template.FirstBatchCount)</text>
                                        }
                                    </span>
                                    @if (nextBatchReady && status is not null)
                                    {
                                        <span class="pos-catalog-import__template-batch-hint">
                                            @string.Format(L["Catalog_Import_NextBatchHint"].Value, status.NextBatchSizeEstimate, status.SubsequentRemainingCount)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(template.Description))
                                    {
                                        <span class="pos-catalog-import__template-desc">@template.Description</span>
                                    }
                                </div>
                                <button type="button"
                                        class="pos-action-tile pos-action-tile--primary pos-catalog-import__select"
                                        disabled="@selectDisabled"
                                        title="@(fullyImported ? L["Catalog_Import_AlreadyImportedHint"].Value : null)"
                                        @onclick="() => SelectTemplateAsync(template.Id)">
                                    @if (_busy && selected)
                                    {
                                        <Spinner />
                                    }
                                    else
                                    {
                                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get(nextBatchReady ? "plus" : "check")</span>
                                    }
                                    <span class="pos-action-tile__label">@(nextBatchReady ? L["Catalog_Import_LoadNextBatch"] : L["Catalog_Import_Select"])</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </Section>
        }
        else if (_step == WizardStep.Preview && _selected is not null)
        {
            <Section Title="@L["Catalog_Import_PreviewTitle"]">
                <Stack Gap="3">
                    <Alert Tone="AlertTone.Info" Title="@L["Catalog_Import_OwnershipTitle"]" Message="@L["Catalog_Import_OwnershipMessage"]" />
                    <div class="pos-catalog-import__facts">
                        <div class="pos-catalog-import__fact">
                            <span class="pos-muted">@L["Catalog_Import_TemplateName"]</span>
                            <span class="pos-catalog-import__fact-value">@_selected.Name</span>
                        </div>
                        <div class="pos-catalog-import__fact">
                            <span class="pos-muted">@L["Catalog_Import_BusinessType"]</span>
                            <span class="pos-catalog-import__fact-value">@_selected.PrimaryBusinessType</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_selected.Description))
                        {
                            <div class="pos-catalog-import__fact">
                                <span class="pos-muted">@L["Catalog_Import_Description"]</span>
                                <span class="pos-catalog-import__fact-value pos-wrap">@_selected.Description</span>
                            </div>
                        }
                        <div class="pos-catalog-import__fact">
                            <span class="pos-muted">@(_importingNextBatch ? L["Catalog_Import_NextBatchLabel"] : L["Catalog_Import_FirstBatchLabel"])</span>
                            <span class="pos-catalog-import__fact-value">@_previewProducts.Count</span>
                        </div>
                        <div class="pos-catalog-import__fact">
                            <span class="pos-muted">@L["Catalog_Import_TotalProducts"]</span>
                            <span class="pos-catalog-import__fact-value">@_selected.ProductCount</span>
                        </div>
                    </div>

                    @if (_unavailableCount > 0)
                    {
                        <Alert Tone="AlertTone.Warning"
                               Title="@L["Catalog_Import_UnavailableProduct"]"
                               Message="@string.Format(L["Catalog_Import_UnavailableProductCount"].Value, _unavailableCount)" />
                    }

                    <Section Title="@L["Catalog_Import_SampleProducts"]">
                        @if (_previewProducts.Count == 0)
                        {
                            <EmptyState IconName="inbox" Title="@L["Catalog_Import_NoSamplesTitle"]" Message="@L["Catalog_Import_NoSamplesMessage"]" />
                        }
                        else
                        {
                            <div class="pos-catalog-import__toolbar">
                                <div class="pos-catalog-import__search">
                                    <span class="pos-catalog-import__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                                    <input class="pos-catalog-import__search-input"
                                           type="search"
                                           value="@_previewSearch"
                                           placeholder="@L["Catalog_Import_PreviewSearch"]"
                                           @oninput="OnPreviewSearchInputAsync" />
                                </div>
                            </div>
                            @if (FilteredPreviewProducts.Count == 0)
                            {
                                <EmptyState IconName="search" Title="@L["Catalog_Global_NoMatchTitle"]" Message="@L["Catalog_Global_NoMatchMessage"]" />
                            }
                            else
                            {
                                <div class="pos-catalog-import__list" role="list">
                                    @foreach (var product in FilteredPreviewProducts)
                                    {
                                        var name = DisplayName(product);
                                        var unavailable = IsUnavailable(product);
                                        <div class="pos-catalog-import__product" role="listitem">
                                            <div class="pos-catalog-import__template-main">
                                                <span class="pos-catalog-import__template-name">@name</span>
                                                @if (!string.IsNullOrWhiteSpace(product.Brand))
                                                {
                                                    <span class="pos-catalog-import__template-meta">@L["Catalog_Import_Brand"]: @product.Brand</span>
                                                }
                                                <span class="pos-catalog-import__template-meta">@BuildIdentity(product)</span>
                                                @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                                {
                                                    <span class="pos-catalog-import__template-meta">@L["Catalog_Import_Category"]: @product.CategoryName</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(product.Unit))
                                                {
                                                    <span class="pos-catalog-import__template-meta">@L["Catalog_Import_Unit"]: @product.Unit</span>
                                                }
                                                @if (unavailable)
                                                {
                                                    <Badge Tone="BadgeTone.Warning">@L["Catalog_Import_UnavailableProduct"]</Badge>
                                                }
                                                else if (_previewImportedIds.Contains(product.GlobalProductId))
                                                {
                                                    <Badge Tone="BadgeTone.Success">@L["Catalog_Global_AlreadyAdded"]</Badge>
                                                }
                                            </div>
                                            <div class="pos-catalog-import__prices">
                                                @if (product.CostPrice is decimal cost)
                                                {
                                                    <span class="pos-muted">@L["Catalog_Import_CostPrice"]</span>
                                                    <MoneyDisplay Amount="@cost" CurrencyCode="PHP" />
                                                }
                                                @if (product.SellingPrice is decimal selling)
                                                {
                                                    <span class="pos-muted">@L["Catalog_Import_SellingPrice"]</span>
                                                    <MoneyDisplay Amount="@selling" CurrencyCode="PHP" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </Section>

                    <div class="pos-action-grid pos-action-grid--two pos-catalog-import__footer" role="group">
                        <button type="button" class="pos-action-tile" @onclick="BackToChoose">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("back")</span>
                            <span class="pos-action-tile__label">@L["Catalog_Import_Back"]</span>
                        </button>
                        <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="GoConfirm">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                            <span class="pos-action-tile__label">@L["Catalog_Import_Continue"]</span>
                        </button>
                    </div>
                </Stack>
            </Section>
        }
        else if (_step == WizardStep.Confirm && _selected is not null)
        {
            <Section Title="@L["Catalog_Import_ConfirmTitle"]">
                <Stack Gap="3">
                    <Alert Tone="AlertTone.Info" Title="@L["Catalog_Import_ConfirmDefaultsTitle"]" Message="@L["Catalog_Import_ConfirmDefaultsMessage"]" />
                    <div class="pos-catalog-import__facts">
                        <div class="pos-catalog-import__fact">
                            <span class="pos-muted">@L["Catalog_Import_TemplateName"]</span>
                            <span class="pos-catalog-import__fact-value">@_selected.Name</span>
                        </div>
                        <div class="pos-catalog-import__fact">
                            <span class="pos-muted">@(_importingNextBatch ? L["Catalog_Import_NextBatchLabel"] : L["Catalog_Import_FirstBatchLabel"])</span>
                            <span class="pos-catalog-import__fact-value">@_previewProducts.Count</span>
                        </div>
                    </div>
                    <Checkbox Value="@_confirmAcknowledged"
                              ValueChanged="OnConfirmAcknowledgedChanged"
                              Disabled="@_busy"
                              IsInvalid="@(!string.IsNullOrEmpty(_confirmError))"
                              ErrorText="@_confirmError">@L["Catalog_Import_ConfirmAcknowledge"]</Checkbox>
                    <div class="pos-action-grid pos-action-grid--two pos-catalog-import__footer" role="group">
                        <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="BackToPreview">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("back")</span>
                            <span class="pos-action-tile__label">@L["Catalog_Import_Back"]</span>
                        </button>
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@(_isOffline || _busy)"
                                @onclick="ConfirmImportAsync">
                            @if (_busy)
                            {
                                <Spinner />
                            }
                            else
                            {
                                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                            }
                            <span class="pos-action-tile__label">@L["Catalog_Import_Start"]</span>
                        </button>
                    </div>
                </Stack>
            </Section>
        }
    </Page>
</div>
}

@code {
    private enum WizardStep { Choose, Preview, Confirm }

    private bool _ready;
    private bool _canManage;
    private bool _isOnboarding;
    private bool _loading;
    private bool _busy;
    private bool _isOffline;
    private bool _confirmAcknowledged;
    private string? _confirmError;
    private WizardStep _step = WizardStep.Choose;
    private string? _search;
    private string? _previewSearch;
    private Guid? _selectedTemplateId;
    private string? _confirmIdempotencyKey;
    private bool _importingNextBatch;
    private IReadOnlyList<PlatformMerchantCatalogTemplateSummaryDto> _templates = Array.Empty<PlatformMerchantCatalogTemplateSummaryDto>();
    private readonly Dictionary<Guid, PosTemplateImportStatusDto> _statuses = new();
    private PlatformMerchantCatalogTemplateDto? _selected;
    private IReadOnlyList<PlatformMerchantCatalogTemplateProductDto> _previewProducts = Array.Empty<PlatformMerchantCatalogTemplateProductDto>();
    private HashSet<Guid> _previewImportedIds = [];
    private int _unavailableCount;
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private IReadOnlyList<PlatformMerchantCatalogTemplateProductDto> FilteredPreviewProducts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_previewSearch))
            {
                return _previewProducts;
            }

            var term = _previewSearch.Trim();
            return _previewProducts
                .Where(p =>
                    Contains(p.ProductName, term)
                    || Contains(p.Sku, term)
                    || Contains(p.Barcode, term)
                    || Contains(p.Brand, term))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _isOnboarding = IsOnboardingQuery(Nav.ToAbsoluteUri(Nav.Uri));
        _canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
        // First-run template prompt must remain visible even when ManageCatalog feature codes
        // have not hydrated yet — user can skip; import API still enforces manage rights.
        if (!_isOnboarding && !_canManage)
        {
            _ready = true;
            return;
        }

        _ready = true;

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!_isOffline && (_canManage || _isOnboarding))
        {
            await ReloadTemplatesAsync();
        }
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        _ = DebouncedReloadTemplatesAsync(token);
        return Task.CompletedTask;
    }

    private Task OnSearchInputAsync(ChangeEventArgs e)
    {
        return OnSearchChanged(e.Value?.ToString());
    }

    private Task OnPreviewSearchChanged(string? value)
    {
        _previewSearch = value;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnPreviewSearchInputAsync(ChangeEventArgs e)
    {
        return OnPreviewSearchChanged(e.Value?.ToString());
    }

    private string? StepClass(WizardStep step)
    {
        if (_step == step)
        {
            return "pos-catalog-import__step--active";
        }

        return _step > step ? "pos-catalog-import__step--done" : null;
    }

    private Task OnConfirmAcknowledgedChanged(bool value)
    {
        _confirmAcknowledged = value;
        if (value)
        {
            _confirmError = null;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void BackToPreview()
    {
        _confirmError = null;
        _errorTitle = null;
        _errorMessage = null;
        _step = WizardStep.Preview;
    }

    private async Task DebouncedReloadTemplatesAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(300, token);
            await ReloadTemplatesAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task ReloadTemplatesAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        try
        {
            if (!await OnlineRequired.EnsureOnlineForActionAsync(PosOfflineActionKeys.CatalogImport))
            {
                _isOffline = true;
                return;
            }

            _isOffline = false;

            var result = await Discovery.ListPublishedTemplatesAsync(search: _search, page: 1, pageSize: 50);
            if (result.IsSuccess && result.Data is not null)
            {
                _templates = result.Data.Items;
                await RefreshStatusesAsync(_templates.Select(t => t.Id).ToList());
            }
            else
            {
                _templates = Array.Empty<PlatformMerchantCatalogTemplateSummaryDto>();
                _statuses.Clear();
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = described.Message;
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshStatusesAsync(IReadOnlyList<Guid> templateIds)
    {
        _statuses.Clear();
        if (templateIds.Count == 0)
        {
            return;
        }

        var tasks = templateIds.Select(async id =>
        {
            var status = await Imports.GetTemplateImportStatusAsync(id);
            return (id, status);
        });
        var results = await Task.WhenAll(tasks);
        foreach (var (id, status) in results)
        {
            if (status.IsSuccess && status.Data is not null)
            {
                _statuses[id] = status.Data;
            }
        }
    }

    private PosTemplateImportStatusDto? StatusFor(Guid templateId) =>
        _statuses.TryGetValue(templateId, out var status) ? status : null;

    private static bool IsFullyImported(PosTemplateImportStatusDto? status) =>
        status is { FirstBatchComplete: true, CanImportNextBatch: false }
        && (status.FirstBatchTotal > 0 || status.SubsequentTotal > 0);

    private async Task SelectTemplateAsync(Guid templateId)
    {
        if (_busy)
        {
            return;
        }

        var existingStatus = StatusFor(templateId);
        if (IsFullyImported(existingStatus))
        {
            return;
        }

        _busy = true;
        _selectedTemplateId = templateId;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                return;
            }

            var statusResult = await Imports.GetTemplateImportStatusAsync(templateId);
            if (statusResult.IsSuccess && statusResult.Data is not null)
            {
                _statuses[templateId] = statusResult.Data;
                if (IsFullyImported(statusResult.Data))
                {
                    return;
                }
            }

            var result = await Discovery.GetPublishedTemplateAsync(templateId);
            if (!result.IsSuccess || result.Data is null)
            {
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = described.Message;
                return;
            }

            _selected = result.Data;
            var status = StatusFor(templateId);
            _importingNextBatch = status?.CanImportNextBatch == true;
            var batchSize = Math.Max(1, status?.DefaultBatchSize ?? result.Data.DefaultBatchSize);
            var ordered = result.Data.Products
                .Where(p => p.GlobalProductId != Guid.Empty)
                .OrderBy(p => p.SortOrder)
                .ToList();
            var flaggedFirst = ordered.Where(p => p.IsFirstBatch).ToList();
            if (_importingNextBatch)
            {
                var take = batchSize;
                _previewProducts = flaggedFirst.Count > 0
                    ? ordered.Where(p => !p.IsFirstBatch).Take(take).ToList()
                    : ordered.Skip(batchSize).Take(take).ToList();
            }
            else if (flaggedFirst.Count > 0)
            {
                _previewProducts = flaggedFirst;
            }
            else
            {
                // CSV→template links often omit IsFirstBatch; still preview a usable first window.
                _previewProducts = ordered.Take(batchSize).ToList();
            }

            _unavailableCount = _previewProducts.Count(IsUnavailable);
            _previewSearch = null;
            await ResolvePreviewImportedAsync();
            _step = WizardStep.Preview;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ResolvePreviewImportedAsync()
    {
        _previewImportedIds = [];
        if (_previewProducts.Count == 0)
        {
            return;
        }

        var result = await Imports
            .ListImportedGlobalProductsAsync(_previewProducts.Select(p => p.GlobalProductId).ToList())
            .ConfigureAwait(false);
        if (result.IsSuccess && result.Data is not null)
        {
            _previewImportedIds = result.Data.ImportedIds.ToHashSet();
        }
    }

    private void BackToChoose()
    {
        _selected = null;
        _selectedTemplateId = null;
        _previewProducts = Array.Empty<PlatformMerchantCatalogTemplateProductDto>();
        _previewImportedIds = [];
        _previewSearch = null;
        _unavailableCount = 0;
        _confirmAcknowledged = false;
        _confirmError = null;
        _confirmIdempotencyKey = null;
        _importingNextBatch = false;
        _step = WizardStep.Choose;
    }

    private void GoConfirm()
    {
        _confirmAcknowledged = false;
        _confirmError = null;
        _errorTitle = null;
        _errorMessage = null;
        _confirmIdempotencyKey ??= Guid.NewGuid().ToString("N");
        _step = WizardStep.Confirm;
    }

    private async Task ConfirmImportAsync()
    {
        if (_selected is null || _busy)
        {
            return;
        }

        if (!_confirmAcknowledged)
        {
            _confirmError = L["Catalog_Import_ConfirmRequired"];
            _errorTitle = null;
            _errorMessage = null;
            StateHasChanged();
            return;
        }

        _confirmError = null;
        _busy = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                return;
            }

            _confirmIdempotencyKey ??= Guid.NewGuid().ToString("N");
            ApiResult<PosCatalogImportJobDto> result;
            if (_importingNextBatch)
            {
                result = await Imports.ImportTemplateNextBatchAsync(
                    _selected.Id,
                    new ImportTemplateBatchRequest(
                        _selected.Id,
                        BatchNumber: 2,
                        IdempotencyKey: _confirmIdempotencyKey));
            }
            else
            {
                var request = new ImportTemplateBatchRequest(
                    _selected.Id,
                    BatchNumber: 1,
                    IdempotencyKey: _confirmIdempotencyKey);
                result = await Imports.ImportTemplateBatchAsync(request);
            }

            if (!result.IsSuccess || result.Data is null)
            {
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = described.Message;
                // Keep confirmation and selected template after recoverable API errors.
                return;
            }

            await ClearTemplatePromptAsync();
            Nav.NavigateTo($"/catalog/import/jobs/{result.Data.JobId:D}");
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SkipOnboardingAsync()
    {
        if (_busy || !_isOnboarding)
        {
            return;
        }

        _busy = true;
        try
        {
            await ClearTemplatePromptAsync();
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearTemplatePromptAsync()
    {
        if (CurrentUser.Session?.OrganizationId is Guid organizationId)
        {
            await Prefs.SetBusinessTemplatePromptPendingAsync(organizationId, pending: false);
        }
    }

    private static bool IsOnboardingQuery(Uri uri)
    {
        var query = uri.Query;
        if (string.IsNullOrEmpty(query) || query.Length < 2)
        {
            return false;
        }

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            var rawKey = eq >= 0 ? part[..eq] : part;
            if (!string.Equals(Uri.UnescapeDataString(rawKey), "onboarding", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = eq >= 0
                ? Uri.UnescapeDataString(part[(eq + 1)..].Replace('+', ' '))
                : "1";
            return string.Equals(value, "1", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private static bool IsUnavailable(PlatformMerchantCatalogTemplateProductDto product) =>
        string.IsNullOrWhiteSpace(product.ProductName)
        || string.Equals(product.ProductName, "Unavailable product", StringComparison.OrdinalIgnoreCase);

    private string DisplayName(PlatformMerchantCatalogTemplateProductDto product) =>
        IsUnavailable(product) ? L["Catalog_Import_UnavailableProduct"] : product.ProductName!;

    private static string BuildIdentity(PlatformMerchantCatalogTemplateProductDto product)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(product.Sku))
        {
            parts.Add(product.Sku);
        }

        if (!string.IsNullOrWhiteSpace(product.Barcode))
        {
            parts.Add(product.Barcode);
        }

        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private void GoCatalog() => Nav.NavigateTo("/catalog");
    private void GoGlobal() => Nav.NavigateTo("/catalog/global");
}

@page "/catalog"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
<div class="pos-catalog">
    <Page>
        <header class="pos-catalog__header">
            <h1 class="pos-catalog__title">@L["Catalog_Title"]</h1>
            <p class="pos-catalog__subtitle">@L["Catalog_Subtitle"]</p>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
        }
        else if (!canManage)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        }

        <div class="pos-action-grid pos-catalog__actions" role="group" aria-label="@L["Catalog_QuickActionsSection"]">
            @if (canManage)
            {
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_isOffline" @onclick="GoNew">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Product_Add"]</span>
                </button>
            }
            <button type="button" class="pos-action-tile" @onclick="GoCategories">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("menu")</span>
                <span class="pos-action-tile__label">@L["Catalog_Categories"]</span>
            </button>
            <button type="button" class="pos-action-tile" @onclick="GoBarcodeLookup">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                <span class="pos-action-tile__label">@L["Catalog_Quick_Barcode"]</span>
            </button>
            @if (canManage)
            {
                <button type="button" class="pos-action-tile" disabled="@_isOffline" @onclick="GoGlobal">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Quick_Global"]</span>
                </button>
                <button type="button" class="pos-action-tile" disabled="@_isOffline" @onclick="GoImport">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Quick_Template"]</span>
                </button>
                <button type="button" class="pos-action-tile" disabled="@_isOffline" @onclick="GoTodaysPrices">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("edit")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Quick_TodaysPrices"]</span>
                </button>
                <button type="button" class="pos-action-tile" disabled="@_isOffline" @onclick="GoConnectedAvailability">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Quick_ConnectedAvailability"]</span>
                </button>
            }
        </div>

        <div class="pos-catalog__toolbar">
            <SearchBar Value="@_search"
                       ValueChanged="OnSearchInputAsync"
                       Placeholder="@L["Catalog_SearchShort"]"
                       Disabled="@_loading"
                       ShowFilterButton="true"
                       ActiveFilterCount="@ActiveFilterCount"
                       FiltersExpanded="@_filtersOpen"
                       FiltersControlsId="catalog-filters"
                       FilterLabel="@L["Catalog_FiltersTitle"]"
                       OnFilterClick="ToggleFilters">
                <FilterChips>
                    @if (HasAppliedFilters)
                    {
                        <div aria-label="@L["Catalog_AppliedFilters"]">
                            @foreach (var chip in AppliedFilterChips)
                            {
                                <span class="pos-catalog__chip">@chip</span>
                            }
                        </div>
                    }
                </FilterChips>
            </SearchBar>
        </div>

        @if (_filtersOpen)
        {
            <section class="pos-catalog__panel" id="catalog-filters" aria-labelledby="catalog-filters-heading">
                <h2 id="catalog-filters-heading" class="pos-catalog__section-title">@L["Catalog_FiltersTitle"]</h2>
                <div class="pos-catalog__form">
                    <Select Label="@L["Catalog_Filter_Status"]"
                            Value="@_statusFilter"
                            ValueChanged="OnStatusFilterChanged"
                            Options="@CatalogUiOptions.StatusFilters(L)" />
                    <Select Label="@L["Catalog_Filter_Category"]"
                            Value="@_categoryFilter"
                            ValueChanged="OnCategoryFilterChanged"
                            Options="@CatalogUiOptions.CategoryFilters(L, _categories)" />
                    <Select Label="@L["Catalog_Filter_Unit"]"
                            Value="@_unitFilter"
                            ValueChanged="OnUnitFilterChanged"
                            Options="@CatalogUiOptions.UnitOfMeasureFilters(L)" />
                    <FormActions>
                        <Button Variant="ButtonVariant.Ghost" IsLoading="@_loading" OnClick="ReloadAsync">@L["Catalog_Refresh"]</Button>
                    </FormActions>
                </div>
            </section>
        }

        <section class="pos-catalog__panel" aria-labelledby="catalog-list-heading">
            <h2 id="catalog-list-heading" class="pos-catalog__section-title">@L["Catalog_ProductListSection"]</h2>
            @if (_loading)
            {
                <div class="pos-catalog__loading" role="status" aria-live="polite">
                    <Spinner />
                    <span>@L["Catalog_Loading"]</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Catalog_OfflineTitle"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState Title="@L["Catalog_EmptyTitle"]" Message="@L["Catalog_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-catalog__list" role="list" aria-label="@L["Catalog_Title"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-catalog__row"
                           role="listitem"
                           href="@($"/catalog/products/{item.ProductId:D}")">
                            <div class="pos-catalog__row-main">
                                <span class="pos-catalog__row-name">@item.Name</span>
                                <span class="pos-catalog__row-meta">
                                    @(string.IsNullOrWhiteSpace(item.Sku) ? L["Catalog_NoValue"] : item.Sku)
                                    ·
                                    @CatalogUiOptions.UnitOfMeasureLabel(L, item.UnitOfMeasure)
                                    @if (!string.IsNullOrWhiteSpace(CategoryName(item.CategoryId)))
                                    {
                                        <text> · @CategoryName(item.CategoryId)</text>
                                    }
                                </span>
                            </div>
                            <div class="pos-catalog__row-side">
                                <MoneyDisplay Amount="@item.SellingPrice" CurrencyCode="PHP" />
                                <Badge Tone="@(item.Status == PosCatalogOptions.ActiveStatus ? BadgeTone.Success : BadgeTone.Neutral)">
                                    @CatalogUiOptions.StatusLabel(L, item.Status)
                                </Badge>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>

        @if (!_loading && _totalCount > 0)
        {
            <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private bool _filtersOpen;
    private string? _search;
    private string? _statusFilter = PosCatalogOptions.ActiveStatus;
    private string? _categoryFilter;
    private string? _unitFilter;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosCatalogProductDto> _items = Array.Empty<PosCatalogProductDto>();
    private IReadOnlyList<PosProductCategoryDto> _categories = Array.Empty<PosProductCategoryDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private bool HasAppliedFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || (!string.IsNullOrWhiteSpace(_statusFilter) && _statusFilter != PosCatalogOptions.ActiveStatus)
        || !string.IsNullOrWhiteSpace(_categoryFilter)
        || !string.IsNullOrWhiteSpace(_unitFilter)
        || string.IsNullOrWhiteSpace(_statusFilter);

    private IEnumerable<string> AppliedFilterChips
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_search))
            {
                yield return $"{L["Catalog_SearchShort"]}: {_search}";
            }

            if (string.IsNullOrWhiteSpace(_statusFilter))
            {
                yield return L["Catalog_Filter_AllStatuses"];
            }
            else if (_statusFilter != PosCatalogOptions.ActiveStatus)
            {
                yield return CatalogUiOptions.StatusLabel(L, _statusFilter);
            }

            if (!string.IsNullOrWhiteSpace(_categoryFilter)
                && Guid.TryParse(_categoryFilter, out var categoryId))
            {
                var name = CategoryName(categoryId);
                yield return string.IsNullOrWhiteSpace(name) ? L["Catalog_Filter_Category"] : name!;
            }

            if (!string.IsNullOrWhiteSpace(_unitFilter))
            {
                yield return CatalogUiOptions.UnitOfMeasureLabel(L, _unitFilter);
            }
        }
    }

    private string? CategoryName(Guid? categoryId)
    {
        if (categoryId is null)
        {
            return null;
        }

        return _categories.FirstOrDefault(c => c.CategoryId == categoryId)?.Name;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private int ActiveFilterCount
    {
        get
        {
            var count = 0;
            if (string.IsNullOrWhiteSpace(_statusFilter))
            {
                count++;
            }
            else if (_statusFilter != PosCatalogOptions.ActiveStatus)
            {
                count++;
            }

            if (!string.IsNullOrWhiteSpace(_categoryFilter))
            {
                count++;
            }

            if (!string.IsNullOrWhiteSpace(_unitFilter))
            {
                count++;
            }

            return count;
        }
    }

    private Task ToggleFilters()
    {
        _filtersOpen = !_filtersOpen;
        return Task.CompletedTask;
    }

    private async Task OnSearchInputAsync(string? value)
    {
        _search = value;
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            // superseded by newer keystrokes
        }
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnCategoryFilterChanged(string? value)
    {
        _categoryFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnUnitFilterChanged(string? value)
    {
        _unitFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosCatalogProductDto>();
            _totalCount = 0;
            _errorTitle = L["Catalog_OfflineTitle"];
            _errorMessage = L["Catalog_OfflineMessage"];
            _loading = false;
            return;
        }

        await LoadCategoriesAsync();

        Guid? categoryId = Guid.TryParse(_categoryFilter, out var parsedCategory) ? parsedCategory : null;
        var result = await Catalog.ListProductsAsync(
            _search,
            string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
            categoryId,
            string.IsNullOrWhiteSpace(_unitFilter) ? null : _unitFilter,
            _page,
            _pageSize);

        if (result.IsSuccess && result.Data is not null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else if (result.Status is ApiCallStatus.Offline or ApiCallStatus.Timeout or ApiCallStatus.Unavailable)
        {
            _items = Array.Empty<PosCatalogProductDto>();
            _totalCount = 0;
            _isOffline = true;
            _errorTitle = L["Catalog_OfflineTitle"];
            _errorMessage = L["Catalog_OfflineMessage"];
        }
        else
        {
            _items = Array.Empty<PosCatalogProductDto>();
            _totalCount = 0;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = described.Message;
        }

        _loading = false;
    }

    private async Task LoadCategoriesAsync()
    {
        var result = await Catalog.ListCategoriesAsync(
            status: PosCatalogOptions.ActiveStatus,
            page: 1,
            pageSize: 100);
        _categories = result.IsSuccess && result.Data is not null
            ? result.Data.Items
            : Array.Empty<PosProductCategoryDto>();
    }

    private void GoNew() => Nav.NavigateTo("/catalog/products/new");
    private void GoCategories() => Nav.NavigateTo("/catalog/categories");
    private void GoBarcodeLookup() => Nav.NavigateTo("/catalog/barcode-lookup");
    private void GoImport() => Nav.NavigateTo("/catalog/import");
    private void GoGlobal() => Nav.NavigateTo("/catalog/global");
    private void GoTodaysPrices() => Nav.NavigateTo("/catalog/todays-prices");
    private void GoConnectedAvailability() => Nav.NavigateTo("/catalog/connected-buyer-availability");
}

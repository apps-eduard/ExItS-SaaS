@page "/catalog/import/jobs/{JobId:guid}/review"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogImportClient Imports
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_canManage)
{
<div class="pos-catalog-import-review">
    <Page>
        <header class="pos-catalog-import-review__header">
            <h1 class="pos-catalog-import-review__title">@L["Catalog_Import_ReviewTitle"]</h1>
            <p class="pos-catalog-import-review__subtitle">@L["Catalog_Import_ReviewSubtitle"]</p>
        </header>
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        <div class="pos-action-grid pos-action-grid--single pos-catalog-import-review__actions">
            <button type="button" class="pos-action-tile" @onclick="GoCatalog">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["Catalog_Title"]</span>
            </button>
        </div>
    </Page>
</div>
}
else
{
<div class="pos-catalog-import-review">
    <Page>
        <header class="pos-catalog-import-review__header">
            <h1 class="pos-catalog-import-review__title">@L["Catalog_Import_ReviewTitle"]</h1>
            <p class="pos-catalog-import-review__subtitle">@L["Catalog_Import_ReviewSubtitle"]</p>
        </header>

        <div class="pos-action-grid pos-action-grid--two pos-catalog-import-review__actions" role="group" aria-label="@L["Catalog_Import_ReviewTitle"]">
            <button type="button" class="pos-action-tile" @onclick="GoProgress">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Catalog_Import_ProgressTitle"]</span>
            </button>
            <button type="button" class="pos-action-tile" @onclick="GoCatalog">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["Catalog_Title"]</span>
            </button>
        </div>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_Import_OfflineMessage"]" />
        }

        <Alert Tone="AlertTone.Info" Title="@L["Catalog_Import_OpeningStockTitle"]" Message="@L["Catalog_Import_OpeningStockMessage"]" />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Catalog_ErrorTitle"])" Message="@_errorMessage" />
        }

        <section class="pos-catalog-import-review__panel" aria-labelledby="catalog-import-review-filters">
            <h2 id="catalog-import-review-filters" class="pos-catalog-import-review__section-title">@L["Catalog_FiltersTitle"]</h2>
            <div class="pos-catalog-import-review__form">
                <Select Label="@L["Catalog_Filter_Status"]"
                        Value="@_statusFilter"
                        ValueChanged="OnStatusFilterChanged"
                        Options="@StatusOptions" />
            </div>
        </section>

        @if (_loading)
        {
            <div class="pos-catalog-import-review__loading"><Spinner /><span>@L["Common_Loading"]</span></div>
        }
        else if (_items.Count == 0)
        {
            <EmptyState IconName="inbox" Title="@L["Catalog_Import_ReviewEmptyTitle"]" Message="@L["Catalog_Import_ReviewEmptyMessage"]" />
        }
        else
        {
            <div class="pos-catalog-import-review__list" role="list" aria-label="@L["Catalog_Import_ReviewTitle"]">
                @foreach (var item in _items)
                {
                    <div class="pos-catalog-import-review__row" role="listitem">
                        <div class="pos-catalog-import-review__row-main">
                            <div class="pos-catalog-import-review__row-top">
                                <span class="pos-catalog-import-review__row-name">@item.Name</span>
                                <Badge Tone="@ItemTone(item.Status)">@item.Status</Badge>
                            </div>
                            <span class="pos-catalog-import-review__row-meta">
                                @(string.IsNullOrWhiteSpace(item.Sku) ? L["Catalog_NoValue"] : item.Sku)
                                ·
                                @(string.IsNullOrWhiteSpace(item.Barcode) ? L["Catalog_NoValue"] : item.Barcode)
                            </span>
                            <div class="pos-catalog-import-review__row-price">
                                <MoneyDisplay Amount="@item.SuggestedPrice" CurrencyCode="PHP" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                            {
                                <span class="pos-catalog-import-review__row-error">@item.ErrorMessage</span>
                            }
                        </div>
                        @if (item.LocalProductId is Guid localId)
                        {
                            <div class="pos-action-grid pos-action-grid--two pos-catalog-import-review__row-actions" role="group">
                                <button type="button"
                                        class="pos-action-tile"
                                        @onclick="() => GoEdit(localId)">
                                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                                    <span class="pos-action-tile__label">@L["Catalog_Product_Edit"]</span>
                                </button>
                                <button type="button"
                                        class="pos-action-tile pos-action-tile--primary"
                                        @onclick="() => GoOpeningStock(localId)">
                                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                                    <span class="pos-action-tile__label">@L["Catalog_Import_OpeningStockAction"]</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_totalCount > 0)
            {
                <div class="pos-catalog-import-review__pager">
                    <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
                </div>
            }
        }
    </Page>
</div>
}

@code {
    [Parameter] public Guid JobId { get; set; }

    private bool _ready;
    private bool _canManage;
    private bool _loading;
    private bool _isOffline;
    private string? _statusFilter = "Imported";
    private int _page = 1;
    private const int _pageSize = 50;
    private int _totalCount;
    private IReadOnlyList<PosCatalogImportItemDto> _items = Array.Empty<PosCatalogImportItemDto>();
    private string? _errorTitle;
    private string? _errorMessage;

    private IReadOnlyList<SelectOption> StatusOptions =>
    [
        new(string.Empty, L["Catalog_Filter_AllStatuses"]),
        new("Imported", L["Catalog_Import_Item_Imported"]),
        new("Skipped", L["Catalog_Import_Item_Skipped"]),
        new("Failed", L["Catalog_Import_Item_Failed"]),
        new("Pending", L["Catalog_Import_Item_Pending"])
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync().ConfigureAwait(false), replace: true);
            return;
        }

        _canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
        _ready = true;
        if (!_canManage)
        {
            return;
        }

        await ReloadAsync().ConfigureAwait(false);
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
        await ReloadAsync().ConfigureAwait(false);
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync().ConfigureAwait(false);
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync().ConfigureAwait(false);
        if (_isOffline)
        {
            _loading = false;
            return;
        }

        var result = await Imports.GetJobItemsAsync(
            JobId,
            status: string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
            page: _page,
            pageSize: _pageSize).ConfigureAwait(false);

        if (result.IsSuccess && result.Data is not null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            _items = Array.Empty<PosCatalogImportItemDto>();
            _totalCount = 0;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = described.Message;
        }

        _loading = false;
    }

    private static BadgeTone ItemTone(string status) => status switch
    {
        "Imported" => BadgeTone.Success,
        "Skipped" => BadgeTone.Warning,
        "Failed" => BadgeTone.Danger,
        _ => BadgeTone.Neutral
    };

    private void GoCatalog() => Nav.NavigateTo("/catalog");
    private void GoProgress() => Nav.NavigateTo($"/catalog/import/jobs/{JobId:D}");
    private void GoEdit(Guid productId) => Nav.NavigateTo($"/catalog/products/{productId:D}/edit");
    private void GoOpeningStock(Guid productId) => Nav.NavigateTo($"/inventory/{productId:D}/adjust");
}

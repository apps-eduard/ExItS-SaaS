@page "/catalog/connected-buyer-availability"
@using ExItS.PinoyBusinessPOS.Application.Catalog
@using ExItS.PinoyBusinessPOS.Maui.Services
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/catalog" />

<div class="pos-manage-share @(_selectedCount > 0 || _selectAllMatching ? "pos-manage-share--has-selection" : null)">
<Page>
    <header class="pos-manage-share__header">
        <h1 class="pos-manage-share__title">@L["Catalog_ConnectedAvailability_Title"]</h1>
        <p class="pos-manage-share__intro pos-muted">@L["Catalog_ConnectedAvailability_Intro"]</p>
        @if (!_loading && string.IsNullOrWhiteSpace(_error))
        {
            <p class="pos-manage-share__summary pos-muted">
                @L["Catalog_ConnectedAvailability_Summary", _availableCount, _notAvailableCount]
            </p>
        }
    </header>

    @if (_loading && _items.Count == 0)
    {
        <Spinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <ErrorState Title="@L["Catalog_OfflineTitle"]"
                    Message="@_error"
                    RetryLabel="@L["Common_Retry"]"
                    OnRetry="() => ReloadAsync(resetPage: true)" />
    }
    else
    {
        <div class="pos-manage-share__search" role="search">
            <span class="pos-manage-share__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
            <input class="pos-manage-share__search-input"
                   type="search"
                   value="@_query"
                   placeholder="@L["ConnectedBuyers_SearchProducts"]"
                   disabled="@_busy"
                   @oninput="OnSearchInput" />
            @if (!string.IsNullOrWhiteSpace(_query))
            {
                <button type="button" class="pos-manage-share__search-clear" @onclick="ClearSearch">@L["Common_Clear"]</button>
            }
        </div>

        <div class="pos-manage-share__filters" role="tablist" aria-label="@L["Catalog_ConnectedAvailability_Title"]">
            @foreach (var filter in AvailabilityFilters)
            {
                <button type="button"
                        class="pos-category-chip @(_availabilityFilter == filter.Value ? "pos-category-chip--selected" : null)"
                        role="tab"
                        aria-selected="@(_availabilityFilter == filter.Value)"
                        disabled="@_busy"
                        @onclick="() => SetAvailabilityFilterAsync(filter.Value)">
                    @filter.Label
                </button>
            }
        </div>

        <div class="pos-manage-share__category-row">
            <button type="button"
                    class="pos-manage-share__category-btn"
                    disabled="@_busy"
                    @onclick="() => _categorySheetOpen = true">
                @CategoryButtonLabel
            </button>
        </div>

        @if (_selectAllMatching)
        {
            <p class="pos-manage-share__select-banner" role="status">
                @L["ConnectedBuyers_AllMatchingSelected", _matchingCount]
                <button type="button" class="pos-link-button" disabled="@_busy" @onclick="ClearSelection">@L["ConnectedBuyers_ClearSelection"]</button>
            </p>
        }
        else if (_matchingCount > _items.Count && _pageSelected.Count == _items.Count && _items.Count > 0)
        {
            <p class="pos-manage-share__select-banner" role="status">
                @L["ConnectedBuyers_PageSelectedCount", _pageSelected.Count]
                <button type="button" class="pos-link-button" disabled="@_busy" @onclick="SelectAllMatching">
                    @L["ConnectedBuyers_SelectAllMatching", _matchingCount]
                </button>
            </p>
        }

        @if (_items.Count == 0)
        {
            <EmptyState IconName="products"
                        Title="@EmptyStateTitle"
                        Message="@EmptyStateMessage" />
        }
        else
        {
            <div class="pos-manage-share__list" role="list">
                <label class="pos-manage-share__select-all">
                    <input type="checkbox"
                           checked="@PageAllSelected"
                           disabled="@(_busy || !CanManage)"
                           aria-label="@L["ConnectedBuyers_SelectVisible", _items.Count]"
                           @onchange="OnTogglePageSelect" />
                    <span>@L["ConnectedBuyers_SelectVisible", _items.Count]</span>
                </label>
                @foreach (var product in _items)
                {
                    var selected = _selectAllMatching || _pageSelected.Contains(product.ProductId);
                    <article class="pos-manage-share__row @(selected ? "pos-manage-share__row--selected" : null)" role="listitem">
                        <label class="pos-manage-share__check">
                            <input type="checkbox"
                                   checked="@selected"
                                   disabled="@(_busy || !CanManage || _selectAllMatching)"
                                   aria-label="@L["ConnectedBuyers_SelectProduct", product.Name]"
                                   @onchange="args => ToggleOne(product.ProductId, args)" />
                        </label>
                        <div class="pos-manage-share__body">
                            <span class="pos-manage-share__name">@product.Name</span>
                            <span class="pos-manage-share__meta pos-muted">
                                @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                {
                                    @product.CategoryName
                                }
                                else
                                {
                                    @L["ConnectedBuyers_FilterUncategorized"]
                                }
                                @if (!string.IsNullOrWhiteSpace(product.Sku))
                                {
                                    <text> · @product.Sku</text>
                                }
                            </span>
                            <div class="pos-manage-share__price-grid" aria-label="@L["Catalog_ConnectedAvailability_PriceSummary"]">
                                <div class="pos-manage-share__price-cell">
                                    <span class="pos-manage-share__price-label">@L["ConnectedBuyers_RetailShort"]</span>
                                    <MoneyDisplay Amount="@product.SellingPrice" CurrencyCode="PHP" />
                                </div>
                                <div class="pos-manage-share__price-cell">
                                    <span class="pos-manage-share__price-label">@L["ConnectedBuyers_DefaultPoShort"]</span>
                                    @if (product.DefaultConnectedPoPrice is decimal po)
                                    {
                                        <MoneyDisplay Amount="@po" CurrencyCode="PHP" />
                                    }
                                    else
                                    {
                                        <span class="pos-muted">@L["Catalog_ConnectedAvailability_DefaultPoNotSet"]</span>
                                    }
                                </div>
                            </div>
                            <span class="pos-manage-share__state @(product.CanExposeToConnectedBuyers ? "pos-manage-share__state--shared" : null)">
                                @(product.CanExposeToConnectedBuyers
                                    ? L["Catalog_ConnectedAvailability_Available"]
                                    : L["Catalog_ConnectedAvailability_NotAvailable"])
                            </span>
                        </div>
                    </article>
                }
            </div>

            @if (_hasMore)
            {
                <div class="pos-manage-share__more">
                    <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="LoadMoreAsync">
                        <span class="pos-action-tile__label">@L["Common_LoadMore"]</span>
                    </button>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_banner))
        {
            <p class="pos-manage-share__banner" role="status">@_banner</p>
        }
    }
</Page>

@if (CanManage && (_selectedCount > 0 || _selectAllMatching))
{
    <div class="pos-manage-share__sticky" role="region" aria-label="@L["ConnectedBuyers_BulkActions"]">
        <div class="pos-manage-share__sticky-meta" aria-live="polite">
            @SelectionSummaryLabel
        </div>
        <p class="pos-manage-share__sticky-hint pos-muted">@L["Catalog_ConnectedAvailability_BulkHint"]</p>
        <div class="pos-manage-share__sticky-actions">
            <button type="button" class="pos-manage-share__action" disabled="@_busy" @onclick="() => BulkAvailabilityAsync(true)">@L["Catalog_ConnectedAvailability_Enable"]</button>
            <button type="button" class="pos-manage-share__action pos-manage-share__action--danger" disabled="@_busy" @onclick="() => BulkAvailabilityAsync(false)">@L["Catalog_ConnectedAvailability_Disable"]</button>
            <button type="button" class="pos-manage-share__action pos-manage-share__action--primary" disabled="@_busy" @onclick="OpenPriceSheet">@L["Catalog_ConnectedAvailability_PoPrice"]</button>
        </div>
        <button type="button" class="pos-manage-share__clear" disabled="@_busy" @onclick="ClearSelection">@L["ConnectedBuyers_ClearSelection"]</button>
    </div>
}

@if (_categorySheetOpen)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_FilterCategory"]">
        <div class="pos-denom-sheet__panel">
            <header class="pos-denom-sheet__header">
                <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_FilterCategory"]</h2>
            </header>
            <div class="pos-denom-sheet__list">
                <button type="button" class="pos-denom-sheet__item @(_categoryId is null ? "pos-denom-sheet__item--active" : null)"
                        @onclick="SelectAllCategoriesAsync">
                    <span>@L["ConnectedBuyers_FilterAllCategories"]</span>
                    <span class="pos-muted">@_matchingCount</span>
                </button>
                @foreach (var facet in _categories)
                {
                    var isUncategorized = facet.CategoryId is null;
                    var selected = isUncategorized
                        ? _categoryUncategorized
                        : _categoryId == facet.CategoryId;
                    var label = isUncategorized
                        ? L["ConnectedBuyers_FilterUncategorized"].Value
                        : (facet.CategoryName ?? facet.CategoryId!.Value.ToString("D"));
                    <button type="button" class="pos-denom-sheet__item @(selected ? "pos-denom-sheet__item--active" : null)"
                            @onclick="() => SetCategoryAsync(facet.CategoryId, isUncategorized)">
                        <span>@label</span>
                        <span class="pos-muted">@facet.Count</span>
                    </button>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" @onclick="() => _categorySheetOpen = false">
                    <span class="pos-action-tile__label">@L["Common_Close"]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_priceSheetOpen)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["Catalog_ConnectedAvailability_SetPoPriceTitle"]">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit">
            <header class="pos-denom-sheet__header pos-manage-share__sheet-header">
                <div>
                    <h2 class="pos-denom-sheet__title">@L["Catalog_ConnectedAvailability_SetPoPriceTitle"]</h2>
                    <p class="pos-manage-share__sheet-count" aria-live="polite">@SelectionProductsLabel</p>
                    <p class="pos-denom-sheet__hint">@L["Catalog_ConnectedAvailability_PriceRuleHelp"]</p>
                </div>
            </header>
            <div class="pos-denom-sheet__list pos-denom-sheet__list--fit">
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="avail-price-mode" checked="@(_priceMode == "SetFromRetail")" @onchange="SetFromRetailMode" />
                    <span>
                        <strong>@L["Catalog_ConnectedAvailability_SetFromRetail"]</strong>
                        <span class="pos-manage-share__option-help">@L["Catalog_ConnectedAvailability_SetFromRetailHelp"]</span>
                    </span>
                </label>
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="avail-price-mode" checked="@(_priceMode == "DiscountFromRetailPercent")" @onchange="SetDiscountMode" />
                    <span>
                        <strong>@L["Catalog_ConnectedAvailability_DiscountFromRetail"]</strong>
                        <span class="pos-manage-share__option-help">@L["Catalog_ConnectedAvailability_DiscountFromRetailHelp"]</span>
                    </span>
                </label>
                @if (_priceMode == "DiscountFromRetailPercent")
                {
                    <label class="pos-manage-share__field">
                        <span class="pos-manage-share__field-label">@L["Catalog_ConnectedAvailability_DiscountLabel"]</span>
                        <span class="pos-manage-share__field-control">
                            <input class="pos-manage-share__price-input"
                                   type="number"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   inputmode="decimal"
                                   aria-label="@L["Catalog_ConnectedAvailability_DiscountLabel"]"
                                   @bind="_percentText" />
                            <span class="pos-manage-share__unit" aria-hidden="true">%</span>
                        </span>
                    </label>
                }
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="avail-price-mode" checked="@(_priceMode == "AdjustFromRetailAmount")" @onchange="SetAdjustMode" />
                    <span>
                        <strong>@L["Catalog_ConnectedAvailability_AdjustRetail"]</strong>
                        <span class="pos-manage-share__option-help">@L["Catalog_ConnectedAvailability_AdjustRetailHelp"]</span>
                    </span>
                </label>
                @if (_priceMode == "AdjustFromRetailAmount")
                {
                    <label class="pos-manage-share__field">
                        <span class="pos-manage-share__field-label">@L["Catalog_ConnectedAvailability_AdjustmentLabel"]</span>
                        <span class="pos-manage-share__field-control">
                            <span class="pos-manage-share__unit" aria-hidden="true">PHP</span>
                            <input class="pos-manage-share__price-input"
                                   type="number"
                                   step="0.01"
                                   inputmode="decimal"
                                   aria-label="@L["Catalog_ConnectedAvailability_AdjustmentLabel"]"
                                   @bind="_amountText" />
                        </span>
                        <span class="pos-manage-share__field-hint pos-muted">@L["Catalog_ConnectedAvailability_AdjustmentHint"]</span>
                    </label>
                }
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="avail-price-mode" checked="@(_priceMode == "FixedPrice")" @onchange="SetFixedMode" />
                    <span>
                        <strong>@L["Catalog_ConnectedAvailability_SetSamePrice"]</strong>
                        <span class="pos-manage-share__option-help">@L["Catalog_ConnectedAvailability_SetSamePriceHelp"]</span>
                    </span>
                </label>
                @if (_priceMode == "FixedPrice")
                {
                    <label class="pos-manage-share__field">
                        <span class="pos-manage-share__field-label">@L["Catalog_ConnectedAvailability_OnePriceLabel"]</span>
                        <span class="pos-manage-share__field-control">
                            <span class="pos-manage-share__unit" aria-hidden="true">PHP</span>
                            <input class="pos-manage-share__price-input"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   inputmode="decimal"
                                   aria-label="@L["Catalog_ConnectedAvailability_OnePriceLabel"]"
                                   @bind="_fixedPriceText" />
                        </span>
                    </label>
                }
                @if (!string.IsNullOrWhiteSpace(_priceError))
                {
                    <p class="pos-manage-share__banner" role="alert">@_priceError</p>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="() => _priceSheetOpen = false">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="PreviewPriceAsync">
                    <span class="pos-action-tile__label">@L["Catalog_ConnectedAvailability_ReviewPrices"]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_preview is not null)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["Catalog_ConnectedAvailability_ReviewTitle"]">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit">
            <header class="pos-denom-sheet__header pos-manage-share__sheet-header">
                <div>
                    <h2 class="pos-denom-sheet__title">@L["Catalog_ConnectedAvailability_ReviewTitle"]</h2>
                    <p class="pos-manage-share__sheet-count">@L["ConnectedBuyers_PricePreviewCount", _preview.AffectedCount]</p>
                </div>
            </header>
            <div class="pos-denom-sheet__list pos-denom-sheet__list--fit">
                @foreach (var item in _preview.Items)
                {
                    <div class="pos-manage-share__preview-card">
                        <div class="pos-manage-share__preview-title">
                            <strong>@item.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Sku))
                            {
                                <span class="pos-muted">@item.Sku</span>
                            }
                        </div>
                        <div class="pos-manage-share__preview-grid">
                            <span class="pos-manage-share__price-label">@L["ConnectedBuyers_RetailShort"]</span>
                            <MoneyDisplay Amount="@item.SellingPrice" CurrencyCode="PHP" />
                            <span class="pos-manage-share__price-label">@L["Catalog_ConnectedAvailability_CurrentDefaultPo"]</span>
                            @if (item.CurrentDefaultPoPrice is decimal current)
                            {
                                <MoneyDisplay Amount="@current" CurrencyCode="PHP" />
                            }
                            else
                            {
                                <span class="pos-muted">@L["Catalog_ConnectedAvailability_DefaultPoNotSet"]</span>
                            }
                            <span class="pos-manage-share__price-label pos-manage-share__price-label--new">@L["Catalog_ConnectedAvailability_NewDefaultPo"]</span>
                            <span class="pos-manage-share__new-price">
                                <MoneyDisplay Amount="@item.ProposedDefaultPoPrice" CurrencyCode="PHP" Emphasized="true" />
                            </span>
                        </div>
                    </div>
                }
                @if (_preview.Truncated)
                {
                    <p class="pos-muted">@L["ConnectedBuyers_PricePreviewTruncated"]</p>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="BackToPriceSheet">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="ApplyPriceAsync">
                    <span class="pos-action-tile__label">@L["ConnectedBuyers_ApplyToCount", _preview.AffectedCount]</span>
                </button>
            </div>
        </div>
    </div>
}
</div>

<style>
    .pos-manage-share { width: 100%; padding-bottom: 0.5rem; }
    .pos-manage-share--has-selection { padding-bottom: 8.5rem; }
    .pos-manage-share__header { margin-bottom: 0.55rem; }
    .pos-manage-share__title { margin: 0; font-size: 1.2rem; font-weight: 700; line-height: 1.2; color: var(--exits-text, #15201a); }
    .pos-manage-share__intro { margin: 0.3rem 0 0; font-size: 0.8125rem; line-height: 1.35; }
    .pos-manage-share__summary { margin: 0.25rem 0 0; font-size: 0.8125rem; }
    .pos-manage-share__search {
        display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.55rem;
        padding: 0.45rem 0.55rem; border: 1px solid var(--exits-border, #c9d4cd); border-radius: 0.55rem;
        background: var(--exits-surface, #fff);
    }
    .pos-manage-share__search-input {
        flex: 1; border: 0; outline: none; background: transparent; font: inherit; font-size: 0.95rem;
    }
    .pos-manage-share__search-clear { appearance: none; border: 0; background: transparent; font: inherit; font-size: 0.75rem; font-weight: 650; color: var(--exits-primary, #1b7a3d); }
    .pos-manage-share__filters {
        display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0 0 0.55rem;
    }
    .pos-manage-share__category-row { margin: 0 0 0.55rem; }
    .pos-manage-share__category-btn {
        appearance: none; width: 100%; text-align: left; font: inherit; font-size: 0.875rem; font-weight: 650;
        min-height: 2.75rem; padding: 0.55rem 0.7rem; border-radius: 0.55rem; border: 1px solid var(--exits-border, #c9d4cd);
        background: var(--exits-surface, #fff); color: var(--exits-text, #15201a);
    }
    .pos-manage-share__select-banner {
        margin: 0 0 0.55rem; padding: 0.45rem 0.55rem; border-radius: 0.45rem;
        background: rgba(27, 122, 61, 0.08); font-size: 0.8125rem;
    }
    .pos-manage-share__list {
        border: 1px solid var(--exits-border, #c9d4cd); border-radius: 0.65rem; overflow: hidden;
        background: var(--exits-surface, #fff);
    }
    .pos-manage-share__select-all {
        display: flex; align-items: center; gap: 0.55rem; padding: 0.55rem 0.7rem;
        border-bottom: 1px solid var(--pos-border-subtle, #d7e0da); font-size: 0.8125rem; font-weight: 650;
        min-height: 2.75rem;
    }
    .pos-manage-share__row {
        display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; padding: 0.6rem 0.7rem; align-items: start;
    }
    .pos-manage-share__row + .pos-manage-share__row { border-top: 1px solid var(--pos-border-subtle, #d7e0da); }
    .pos-manage-share__row--selected { background: rgba(27, 122, 61, 0.06); }
    .pos-manage-share__check {
        display: flex; align-items: center; justify-content: center;
        margin: 0.05rem 0 0; min-width: 2.75rem; min-height: 2.75rem;
    }
    .pos-manage-share__body {
        display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; text-align: left;
        appearance: none; border: 0; background: transparent; padding: 0; font: inherit;
    }
    .pos-manage-share__name { font-size: 0.95rem; font-weight: 650; line-height: 1.25; color: var(--exits-text, #15201a); }
    .pos-manage-share__meta { font-size: 0.75rem; line-height: 1.3; }
    .pos-manage-share__price-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 0.75rem; margin-top: 0.1rem;
    }
    .pos-manage-share__price-cell {
        display: flex; flex-direction: column; gap: 0.05rem; min-width: 0;
    }
    .pos-manage-share__price-label {
        font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.01em;
        color: var(--exits-text-muted, #5b6b62); text-transform: none;
    }
    .pos-manage-share__price-label--new { color: var(--exits-text, #15201a); }
    .pos-manage-share__state { font-size: 0.75rem; font-weight: 700; color: var(--exits-text-muted, #5b6b62); }
    .pos-manage-share__state--shared { color: var(--exits-primary, #1b7a3d); }
    .pos-manage-share__more { margin-top: 0.65rem; }
    .pos-manage-share__banner { margin: 0.55rem 0 0; font-size: 0.8125rem; color: var(--exits-text, #15201a); }
    .pos-manage-share__sticky {
        position: sticky; bottom: 0; z-index: 20; margin-top: 0.75rem;
        padding: 0.65rem 0.75rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--exits-border, #c9d4cd); background: var(--exits-surface, #fff);
        box-shadow: 0 -6px 18px rgba(21, 32, 26, 0.08);
    }
    .pos-manage-share__sticky-meta { font-size: 0.875rem; font-weight: 700; margin-bottom: 0.15rem; }
    .pos-manage-share__sticky-hint { margin: 0 0 0.45rem; font-size: 0.75rem; line-height: 1.3; }
    .pos-manage-share__sticky-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .pos-manage-share__action {
        appearance: none; border: 1px solid var(--exits-border, #c9d4cd); background: #fff;
        border-radius: 0.55rem; min-height: 2.75rem; padding: 0.5rem 0.85rem; font: inherit;
        font-size: 0.8125rem; font-weight: 700; color: var(--exits-primary, #1b7a3d);
        flex: 1 1 auto;
    }
    .pos-manage-share__action--primary {
        color: #fff; background: var(--exits-primary, #1b7a3d); border-color: var(--exits-primary, #1b7a3d);
    }
    .pos-manage-share__action--danger { color: #8a1f1f; border-color: #e0b4b4; }
    .pos-manage-share__clear {
        appearance: none; border: 0; background: transparent; width: 100%; margin-top: 0.35rem;
        min-height: 2.75rem; font: inherit; font-size: 0.8125rem; font-weight: 650;
        color: var(--exits-text-muted, #5b6b62); text-decoration: underline;
    }
    .pos-manage-share__sheet-header { width: 100%; }
    .pos-manage-share__sheet-count { margin: 0.2rem 0 0; font-size: 0.8125rem; font-weight: 700; color: var(--exits-text, #15201a); }
    .pos-manage-share__price-option {
        display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; align-items: start;

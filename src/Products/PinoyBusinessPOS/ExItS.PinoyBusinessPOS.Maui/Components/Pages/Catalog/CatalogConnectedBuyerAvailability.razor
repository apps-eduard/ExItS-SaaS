@code {
    private readonly List<ConnectedBuyerAvailabilityItemDto> _items = [];
    private readonly HashSet<Guid> _pageSelected = [];
    private IReadOnlyList<ConnectedBuyerAvailabilityCategoryFacetDto> _categories = [];
    private bool _loading = true;
    private bool _busy;
    private bool _hasMore;
    private bool _selectAllMatching;
    private bool _categorySheetOpen;
    private bool _priceSheetOpen;
    private bool _categoryUncategorized;
    private string? _error;
    private string? _banner;
    private string? _priceError;
    private string _query = "";
    private string _availabilityFilter = "all";
    private string _priceMode = "SetFromRetail";
    private string _percentText = "5";
    private string _amountText = "-5";
    private string _fixedPriceText = "";
    private Guid? _categoryId;
    private int _page = 1;
    private int _matchingCount;
    private int _availableCount;
    private int _notAvailableCount;
    private CancellationTokenSource? _searchCts;
    private BulkDefaultConnectedPoPricingPreviewDto? _preview;
    private BulkDefaultConnectedPoPricingRequest? _pendingPriceRequest;

    private bool CanManage => Capabilities.IsAllowed(UtangCapability.ManageCatalog);
    private bool PageAllSelected => _items.Count > 0 && _items.All(x => _pageSelected.Contains(x.ProductId));
    private int _selectedCount => _pageSelected.Count;
    private int EffectiveSelectionCount => _selectAllMatching ? _matchingCount : _pageSelected.Count;

    private string SelectionSummaryLabel =>
        _selectAllMatching
            ? L["ConnectedBuyers_AllMatchingSelected", _matchingCount]
            : L["ConnectedBuyers_SelectedCount", EffectiveSelectionCount];

    private string SelectionProductsLabel =>
        L["Catalog_ConnectedAvailability_SelectedProducts", EffectiveSelectionCount];

    private string EmptyStateTitle =>
        !string.IsNullOrWhiteSpace(_query)
            ? L["Catalog_ConnectedAvailability_EmptySearchTitle"]
            : _availabilityFilter switch
            {
                "available" => L["Catalog_ConnectedAvailability_EmptyAvailableTitle"],
                "notavailable" => L["Catalog_ConnectedAvailability_EmptyUnavailableTitle"],
                _ => L["Catalog_ConnectedAvailability_EmptyTitle"]
            };

    private string EmptyStateMessage =>
        !string.IsNullOrWhiteSpace(_query)
            ? L["Catalog_ConnectedAvailability_EmptySearchMessage"]
            : _availabilityFilter switch
            {
                "available" => L["Catalog_ConnectedAvailability_EmptyAvailableMessage"],
                "notavailable" => L["Catalog_ConnectedAvailability_EmptyUnavailableMessage"],
                _ => L["Catalog_ConnectedAvailability_EmptyMessage"]
            };

    private IReadOnlyList<(string Value, string Label)> AvailabilityFilters =>
    [
        ("all", L["Catalog_ConnectedAvailability_FilterAll"]),
        ("available", L["Catalog_ConnectedAvailability_FilterAvailable"]),
        ("notavailable", L["Catalog_ConnectedAvailability_FilterNotAvailable"])
    ];

    private string CategoryButtonLabel
    {
        get
        {
            if (_categoryUncategorized)
            {
                return L["ConnectedBuyers_FilterUncategorized"];
            }

            if (_categoryId is null)
            {
                return L["ConnectedBuyers_FilterAllCategories"];
            }

            var match = _categories.FirstOrDefault(c => c.CategoryId == _categoryId);
            return match?.CategoryName ?? _categoryId.Value.ToString("D");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewCatalog)
            && !Capabilities.IsAllowed(UtangCapability.ManageCatalog))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        await ReloadAsync(resetPage: true);
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(280, token);
            await ReloadAsync(resetPage: true);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private Task ClearSearch()
    {
        _query = "";
        return ReloadAsync(resetPage: true);
    }

    private Task SetAvailabilityFilterAsync(string value)
    {
        _availabilityFilter = value;
        ClearSelection();
        return ReloadAsync(resetPage: true);
    }

    private Task SelectAllCategoriesAsync()
    {
        _categoryId = null;
        _categoryUncategorized = false;
        _categorySheetOpen = false;
        ClearSelection();
        return ReloadAsync(resetPage: true);
    }

    private Task SetCategoryAsync(Guid? categoryId, bool uncategorized)
    {
        _categoryUncategorized = uncategorized;
        _categoryId = uncategorized ? null : categoryId;
        _categorySheetOpen = false;
        ClearSelection();
        return ReloadAsync(resetPage: true);
    }

    private async Task ReloadAsync(bool resetPage)
    {
        if (resetPage)
        {
            _page = 1;
            _items.Clear();
            if (!_selectAllMatching)
            {
                _pageSelected.Clear();
            }
        }

        _loading = _items.Count == 0;
        _error = null;
        if (!await Connectivity.IsConnectedAsync())
        {
            _error = L["Catalog_ConnectedAvailability_OfflineMessage"];
            _loading = false;
            return;
        }

        var availability = _availabilityFilter is "all" ? null : _availabilityFilter;
        var result = await Catalog.QueryConnectedBuyerAvailabilityAsync(
            _query, _categoryId, availability, _page, 25, _categoryUncategorized);
        _loading = false;
        if (!result.IsSuccess || result.Data is null)
        {
            _error = result.Error?.Detail ?? L["Catalog_ConnectedAvailability_LoadFailed"];
            return;
        }

        var data = result.Data;
        _matchingCount = data.MatchingCount;
        _availableCount = data.AvailableCount;
        _notAvailableCount = data.NotAvailableCount;
        _categories = data.Categories;
        _hasMore = data.Items.Count + ((_page - 1) * data.PageSize) < data.MatchingCount;
        if (resetPage)
        {
            _items.Clear();
        }

        _items.AddRange(data.Items);
    }

    private async Task LoadMoreAsync()
    {
        if (_busy || !_hasMore) return;
        _busy = true;
        try
        {
            _page += 1;
            await ReloadAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnTogglePageSelect(ChangeEventArgs args)
    {
        if (_selectAllMatching) return;
        if (Checked(args))
        {
            foreach (var item in _items)
            {
                _pageSelected.Add(item.ProductId);
            }
        }
        else
        {
            foreach (var item in _items)
            {
                _pageSelected.Remove(item.ProductId);
            }
        }
    }

    private void ToggleOne(Guid productId, ChangeEventArgs args)
    {
        if (_selectAllMatching) return;
        if (Checked(args)) _pageSelected.Add(productId);
        else _pageSelected.Remove(productId);
    }

    private void SelectAllMatching()
    {
        _selectAllMatching = true;
        _pageSelected.Clear();
    }

    private void ClearSelection()
    {
        _selectAllMatching = false;
        _pageSelected.Clear();
    }

    private async Task BulkAvailabilityAsync(bool enable)
    {
        if (_busy || !CanManage) return;
        if (!await Connectivity.IsConnectedAsync())
        {
            _banner = L["Catalog_ConnectedAvailability_OfflineMessage"];
            return;
        }

        _busy = true;
        _banner = null;
        try
        {
            var request = BuildMutationRequest(enable ? "Enable" : "Disable");
            var result = await Catalog.BulkMutateConnectedBuyerAvailabilityAsync(request);
            if (!result.IsSuccess)
            {
                _banner = result.Error?.Detail ?? L["Catalog_ConnectedAvailability_LoadFailed"];
                return;
            }

            _banner = enable
                ? L["Catalog_ConnectedAvailability_EnableSucceeded", result.Data?.AffectedCount ?? 0]
                : L["Catalog_ConnectedAvailability_DisableSucceeded", result.Data?.AffectedCount ?? 0];
            ClearSelection();
            await ReloadAsync(resetPage: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private BulkConnectedBuyerAvailabilityMutationRequest BuildMutationRequest(string operation) =>
        _selectAllMatching
            ? new(operation, SelectAllMatching: true, Query: _query, CategoryId: _categoryId, AvailabilityFilter: AvailabilityOrNull(), UncategorizedOnly: _categoryUncategorized)
            : new(operation, ProductIds: _pageSelected.ToList());

    private BulkDefaultConnectedPoPricingRequest BuildPricingRequest()
    {
        decimal? percent = null;
        decimal? amount = null;
        decimal? fixedPrice = null;
        if (_priceMode == "DiscountFromRetailPercent" && decimal.TryParse(_percentText, out var p)) percent = p;
        if (_priceMode == "AdjustFromRetailAmount" && decimal.TryParse(_amountText, out var a)) amount = a;
        if (_priceMode == "FixedPrice" && decimal.TryParse(_fixedPriceText, out var f)) fixedPrice = f;

        return _selectAllMatching
            ? new(_priceMode, SelectAllMatching: true, Query: _query, CategoryId: _categoryId, AvailabilityFilter: AvailabilityOrNull(), UncategorizedOnly: _categoryUncategorized, Percent: percent, Amount: amount, FixedPrice: fixedPrice)
            : new(_priceMode, ProductIds: _pageSelected.ToList(), Percent: percent, Amount: amount, FixedPrice: fixedPrice);
    }

    private string? AvailabilityOrNull() => _availabilityFilter is "all" ? null : _availabilityFilter;

    private void SetFromRetailMode() => _priceMode = "SetFromRetail";
    private void SetDiscountMode() => _priceMode = "DiscountFromRetailPercent";
    private void SetAdjustMode() => _priceMode = "AdjustFromRetailAmount";
    private void SetFixedMode() => _priceMode = "FixedPrice";

    private void OpenPriceSheet()
    {
        _priceError = null;
        _priceSheetOpen = true;
        _preview = null;
        _pendingPriceRequest = null;
    }

    private void BackToPriceSheet()
    {
        _preview = null;
        _pendingPriceRequest = null;
        _priceSheetOpen = true;
    }

    private async Task PreviewPriceAsync()
    {
        if (_busy || !CanManage) return;
        if (!await Connectivity.IsConnectedAsync())
        {
            _priceError = L["Catalog_ConnectedAvailability_OfflineMessage"];
            return;
        }

        _busy = true;
        _priceError = null;
        try
        {
            var request = BuildPricingRequest();
            var result = await Catalog.PreviewDefaultConnectedPoPricingAsync(request);
            if (!result.IsSuccess || result.Data is null)
            {
                _priceError = result.Error?.Detail ?? L["Catalog_ConnectedAvailability_LoadFailed"];
                return;
            }

            _pendingPriceRequest = request;
            _preview = result.Data;
            _priceSheetOpen = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyPriceAsync()
    {
        if (_busy || !CanManage || _pendingPriceRequest is null) return;
        if (!await Connectivity.IsConnectedAsync())
        {
            _banner = L["Catalog_ConnectedAvailability_OfflineMessage"];
            return;
        }

        _busy = true;
        try
        {
            var result = await Catalog.ApplyDefaultConnectedPoPricingAsync(_pendingPriceRequest);
            if (!result.IsSuccess)
            {
                _banner = result.Error?.Detail ?? L["Catalog_ConnectedAvailability_LoadFailed"];
                return;
            }

            _banner = L["Catalog_ConnectedAvailability_PriceSucceeded", result.Data?.AffectedCount ?? 0];
            _preview = null;
            _pendingPriceRequest = null;
            ClearSelection();
            await ReloadAsync(resetPage: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool Checked(ChangeEventArgs args) =>
        args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
}

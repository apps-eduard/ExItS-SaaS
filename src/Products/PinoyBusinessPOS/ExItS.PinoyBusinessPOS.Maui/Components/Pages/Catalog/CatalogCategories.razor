@page "/catalog/categories"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
<Page>
    <PageHeader Title="@L["Catalog_Category_Title"]" Subtitle="@L["Catalog_Category_Subtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoCatalog">@L["Catalog_BackToList"]</Button>
        </Actions>
    </PageHeader>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
    }
    else if (!canManage)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Catalog_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Catalog_ErrorTitle"]" Message="@_formError" />
    }

    <Section Title="@(_editingId is null ? L["Catalog_Category_AddTitle"] : L["Catalog_Category_EditTitle"])">
        <Stack Gap="3">
            <TextInput Label="@L["Catalog_Category_Field_Name"]"
                       Value="@_name"
                       ValueChanged="v => _name = v"
                       Required="true"
                       IsInvalid="@(!string.IsNullOrEmpty(_nameError))"
                       ErrorText="@_nameError"
                       Disabled="@(!canManage || _isOffline || _saving)" />
            <FormActions>
                @if (_editingId is not null)
                {
                    <Button Variant="ButtonVariant.Secondary" Disabled="@_saving" OnClick="CancelEdit">@L["Catalog_Cancel"]</Button>
                }
                <Button Variant="ButtonVariant.Primary"
                        Disabled="@(!canManage || _isOffline)"
                        IsLoading="@_saving"
                        OnClick="SaveAsync">@(_editingId is null ? L["Catalog_Category_Add"] : L["Catalog_Save"])</Button>
            </FormActions>
        </Stack>
    </Section>

    <SearchToolbar SearchText="@_search" SearchTextChanged="OnSearchChanged" Placeholder="@L["Catalog_Category_SearchPlaceholder"]">
        <Actions>
            <Select Value="@_statusFilter"
                    ValueChanged="OnStatusFilterChanged"
                    Options="@CatalogUiOptions.StatusFilters(L)"
                    aria-label="@L["Catalog_Filter_Status"]" />
            <Button Variant="ButtonVariant.Secondary" IsLoading="@_loading" OnClick="ReloadWithLoadingAsync">@L["Catalog_Refresh"]</Button>
        </Actions>
    </SearchToolbar>

    <ResponsiveDataList TItem="PosProductCategoryDto"
                        Items="@_items"
                        Columns="@Columns"
                        CellTemplate="@CellTemplate"
                        IsLoading="@_loading"
                        LoadingLabel="@L["Catalog_Loading"]"
                        EmptyTitle="@L["Catalog_Category_EmptyTitle"]"
                        EmptyMessage="@L["Catalog_Category_EmptyMessage"]"
                        ErrorTitle="@_errorTitle"
                        ErrorMessage="@_errorMessage"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="ReloadWithLoadingAsync"
                        AriaLabel="@L["Catalog_Category_Title"]" />

    @if (!_loading && _totalCount > 0)
    {
        <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
    }
</Page>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _saving;
    private bool _isOffline;
    private string? _search;
    private string? _statusFilter = PosCatalogOptions.ActiveStatus;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosProductCategoryDto> _items = Array.Empty<PosProductCategoryDto>();
    private Guid? _editingId;
    private DateTimeOffset? _editingUpdatedAtUtc;
    private string? _name;
    private string? _nameError;
    private string? _formError;
    private string? _banner;
    private string? _errorTitle;
    private string? _errorMessage;

    private IReadOnlyList<DataColumnDefinition> Columns =>
    [
        new("name", L["Catalog_Category_Field_Name"], Primary: true, Width: "48%"),
        new("status", L["Catalog_Col_Status"], Width: "22%"),
        new("actions", L["Catalog_Col_Actions"], Width: "30%"),
    ];

    private RenderFragment<(PosProductCategoryDto Item, DataColumnDefinition Column)> CellTemplate => context => builder =>
    {
        switch (context.Column.Key)
        {
            case "name":
                builder.AddContent(0, context.Item.Name);
                break;
            case "status":
                builder.OpenComponent<Badge>(0);
                builder.AddAttribute(1, "Tone", context.Item.Status == PosCatalogOptions.ActiveStatus
                    ? BadgeTone.Success
                    : BadgeTone.Neutral);
                builder.AddAttribute(2, "ChildContent", (RenderFragment)(b =>
                    b.AddContent(0, CatalogUiOptions.StatusLabel(L, context.Item.Status))));
                builder.CloseComponent();
                break;
            default:
                var item = context.Item;
                builder.OpenComponent<Button>(0);
                builder.AddAttribute(1, "Variant", ButtonVariant.Ghost);
                builder.AddAttribute(2, "Size", ButtonSize.Sm);
                builder.AddAttribute(3, "OnClick", EventCallback.Factory.Create(this, () => BeginEdit(item)));
                builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, L["Catalog_Category_Rename"].Value)));
                builder.CloseComponent();

                var isActive = item.Status == PosCatalogOptions.ActiveStatus;
                builder.OpenComponent<Button>(5);
                builder.AddAttribute(6, "Variant", isActive ? ButtonVariant.Danger : ButtonVariant.Secondary);
                builder.AddAttribute(7, "Size", ButtonSize.Sm);
                builder.AddAttribute(8, "OnClick", EventCallback.Factory.Create(this, () => ToggleStatusAsync(item)));
                builder.AddAttribute(9, "ChildContent", (RenderFragment)(b => b.AddContent(
                    0,
                    isActive ? L["Catalog_Deactivate"].Value : L["Catalog_Reactivate"].Value)));
                builder.CloseComponent();
                break;
        }
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadWithLoadingAsync();
    }

    private Task ReloadWithLoadingAsync() => ReloadAsync(showLoading: true);

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _loading = true;
            _errorTitle = null;
            _errorMessage = null;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                if (showLoading)
                {
                    _items = Array.Empty<PosProductCategoryDto>();
                    _totalCount = 0;
                }

                _errorTitle = L["Catalog_OfflineTitle"];
                _errorMessage = L["Catalog_OfflineMessage"];
                return;
            }

            var result = await Catalog.ListCategoriesAsync(
                _search,
                string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                _page,
                _pageSize);

            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
                _totalCount = result.Data.TotalCount;
                _errorTitle = null;
                _errorMessage = null;
            }
            else if (showLoading || _items.Count == 0)
            {
                _items = Array.Empty<PosProductCategoryDto>();
                _totalCount = 0;
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
        }
        catch (Exception ex)
        {
            if (showLoading || _items.Count == 0)
            {
                _items = Array.Empty<PosProductCategoryDto>();
                _totalCount = 0;
                _errorTitle = L["Catalog_ErrorTitle"];
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BeginEdit(PosProductCategoryDto category)
    {
        _editingId = category.CategoryId;
        _editingUpdatedAtUtc = category.UpdatedAtUtc;
        _name = category.Name;
        _nameError = null;
        _formError = null;
        _banner = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editingUpdatedAtUtc = null;
        _name = null;
        _nameError = null;
    }

    private async Task SaveAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _nameError = null;
        _formError = null;
        _banner = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _nameError = L["Catalog_Category_NameRequired"];
            return;
        }

        _saving = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var editingId = _editingId;
            var result = editingId is { } id
                ? await Catalog.UpdateCategoryAsync(id, new UpdatePosProductCategoryRequest(_name.Trim(), _editingUpdatedAtUtc))
                : await Catalog.CreateCategoryAsync(new CreatePosProductCategoryRequest(_name.Trim()));

            if (result.IsSuccess && result.Data is not null)
            {
                _banner = editingId is null
                    ? L["Catalog_Category_CreatedSuccess"]
                    : L["Catalog_Category_UpdatedSuccess"];
                CancelEdit();
                UpsertLocalCategory(result.Data);
                // Clear save spinner before refresh so the UI never looks stuck on Add.
                _saving = false;
                await InvokeAsync(StateHasChanged);
                // Quiet refresh: keep the new row visible (don't replace the list with a spinner).
                await ReloadAsync(showLoading: false);
                return;
            }

            var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
            _nameError = mapped.Name;
            _formError = mapped.Form
                ?? result.Error?.Detail
                ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void UpsertLocalCategory(PosProductCategoryDto category)
    {
        var list = _items.ToList();
        var index = list.FindIndex(c => c.CategoryId == category.CategoryId);
        var matchesFilter = string.IsNullOrWhiteSpace(_statusFilter)
            || string.Equals(_statusFilter, category.Status, StringComparison.OrdinalIgnoreCase);

        if (index >= 0)
        {
            if (matchesFilter)
            {
                list[index] = category;
            }
            else
            {
                list.RemoveAt(index);
                _totalCount = Math.Max(0, _totalCount - 1);
            }
        }
        else if (matchesFilter)
        {
            list.Insert(0, category);
            _totalCount += 1;
        }

        _items = list;
        _errorTitle = null;
        _errorMessage = null;
    }

    private async Task ToggleStatusAsync(PosProductCategoryDto category)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog) || _isOffline)
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _formError = null;
        _banner = null;

        var result = category.Status == PosCatalogOptions.ActiveStatus
            ? await Catalog.DeactivateCategoryAsync(category.CategoryId)
            : await Catalog.ReactivateCategoryAsync(category.CategoryId);

        if (result.IsSuccess)
        {
            _banner = category.Status == PosCatalogOptions.ActiveStatus
                ? L["Catalog_Category_DeactivatedSuccess"]
                : L["Catalog_Category_ReactivatedSuccess"];
            if (result.Data is not null)
            {
                UpsertLocalCategory(result.Data);
            }

            await ReloadAsync(showLoading: false);
            return;
        }

        var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
        _formError = mapped.Form
            ?? result.Error?.Detail
            ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private void GoCatalog() => Nav.NavigateTo("/catalog");
}

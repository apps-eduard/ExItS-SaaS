@page "/catalog/categories"
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
    var canView = Capabilities.IsAllowed(UtangCapability.ViewCatalog);
    var onlineActionsEnabled = !_isOffline && !_loading;
    var showEmptyAdd = canManage && !_isOffline && string.IsNullOrWhiteSpace(_search);
<div class="pos-categories">
    <Page>
        <header class="pos-categories__header">
            <div class="pos-categories__heading">
                <h1 class="pos-categories__title">@L["Catalog_Category_Title"]</h1>
                <p class="pos-categories__subtitle">@L["Catalog_Category_Subtitle"]</p>
            </div>
            @if (canManage)
            {
                <div class="pos-categories__add">
                    <Button Variant="ButtonVariant.Primary"
                            Size="ButtonSize.Sm"
                            Disabled="@(_isOffline || _saving || _formOpen)"
                            OnClick="BeginCreate">
                        @L["Catalog_Category_Add"]
                    </Button>
                </div>
            }
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
        }
        else if (!canManage)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        }

        @if (!string.IsNullOrEmpty(_banner))
        {
            <Alert Tone="AlertTone.Success" Title="@L["Catalog_SuccessTitle"]" Message="@_banner" />
        }

        @if (!string.IsNullOrEmpty(_formError))
        {
            <Alert Tone="AlertTone.Danger" Title="@L["Catalog_ErrorTitle"]" Message="@_formError" />
        }

        @if (_formOpen)
        {
            <section class="pos-categories__form"
                     aria-labelledby="categories-form-heading"
                     aria-busy="@_saving">
                <h2 id="categories-form-heading" class="pos-categories__form-title">
                    @(_editingId is null ? L["Catalog_Category_AddTitle"] : L["Catalog_Category_EditTitle"])
                </h2>
                <Stack Gap="2">
                    <TextInput Label="@L["Catalog_Category_Field_Name"]"
                               Value="@_name"
                               ValueChanged="OnNameChanged"
                               Required="true"
                               IsInvalid="@(!string.IsNullOrEmpty(_nameError))"
                               ErrorText="@_nameError"
                               Disabled="@(!canManage || _isOffline || _saving)" />
                    <FormActions>
                        <Button Variant="ButtonVariant.Secondary"
                                Disabled="@_saving"
                                OnClick="CancelForm">@L["Catalog_Cancel"]</Button>
                        <Button Variant="ButtonVariant.Primary"
                                Disabled="@(!canManage || _isOffline)"
                                IsLoading="@_saving"
                                OnClick="SaveAsync">
                            @(_editingId is null ? L["Catalog_Category_Add"] : L["Catalog_Save"])
                        </Button>
                    </FormActions>
                </Stack>
            </section>
        }

        <div class="pos-categories__toolbar" role="search">
            <SearchBar Value="@_search"
                       ValueChanged="OnSearchInputAsync"
                       Placeholder="@L["Catalog_Category_SearchPlaceholder"]"
                       AriaLabel="@L["Catalog_Category_SearchPlaceholder"]"
                       ClearLabel="@L["Catalog_Category_ClearSearch"]"
                       Disabled="@(!canView || (_loading && string.IsNullOrWhiteSpace(_search)))"
                       OnClear="ClearSearchAsync" />
            <button type="button"
                    class="pos-categories__refresh"
                    title="@L["Catalog_Refresh"]"
                    aria-label="@L["Catalog_Refresh"]"
                    disabled="@(!onlineActionsEnabled || !canView)"
                    @onclick="ReloadWithLoadingAsync">
                @if (_loading)
                {
                    <Spinner Size="SpinnerSize.Sm" />
                }
                else
                {
                    <span aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                }
            </button>
        </div>

        <div class="pos-categories__segments"
             role="radiogroup"
             aria-label="@L["Catalog_Filter_Status"]">
            @foreach (var option in StatusSegmentOptions)
            {
                var selected = string.Equals(option.Value, _statusFilter ?? string.Empty, StringComparison.Ordinal);
                <button type="button"
                        class="pos-categories__segment @(selected ? "pos-categories__segment--selected" : null)"
                        role="radio"
                        aria-checked="@selected"
                        disabled="@(_isOffline || !canView)"
                        @onclick="() => OnStatusFilterChanged(option.Value)">
                    @option.Label
                </button>
            }
        </div>

        <section class="pos-categories__list-section"
                 aria-labelledby="categories-list-heading"
                 aria-busy="@_loading">
            <h2 id="categories-list-heading" class="visually-hidden">@L["Catalog_Category_Title"]</h2>

            @if (_loading && _items.Count == 0 && string.IsNullOrEmpty(_errorTitle))
            {
                <div class="pos-categories__loading" role="status" aria-live="polite">
                    <Spinner />
                    <span class="pos-muted">@L["Catalog_Loading"]</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorTitle))
            {
                <ErrorState Title="@_errorTitle"
                            Message="@(_errorMessage ?? L["Catalog_Category_EmptyMessage"])"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadWithLoadingAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState Title="@(HasListQuery ? L["Catalog_Category_NoMatchTitle"] : L["Catalog_Category_EmptyTitle"])"
                            Message="@(HasListQuery ? L["Catalog_Category_NoMatchMessage"] : L["Catalog_Category_EmptyMessage"])">
                    <Actions>
                        @if (showEmptyAdd)
                        {
                            <Button Variant="ButtonVariant.Primary"
                                    Size="ButtonSize.Sm"
                                    Disabled="@(_saving || _formOpen)"
                                    OnClick="BeginCreate">
                                @L["Catalog_Category_Add"]
                            </Button>
                        }
                    </Actions>
                </EmptyState>
            }
            else
            {
                @if (_menuCategoryId is not null)
                {
                    <NavigationLock OnBeforeInternalNavigation="OnMenuBackNavigation" />
                    <div class="pos-categories__menu-backdrop"
                         role="presentation"
                         aria-hidden="true"
                         @onclick="CloseMenu"
                         @onkeydown="OnMenuKeyDown"></div>
                }
                <div class="pos-categories__list" role="list" aria-label="@L["Catalog_Category_Title"]">
                    @foreach (var item in _items)
                    {
                        var isActive = item.Status == PosCatalogOptions.ActiveStatus;
                        var menuOpen = _menuCategoryId == item.CategoryId;
                        var rowBusy = _busyCategoryId == item.CategoryId;
                        <article class="pos-categories__row" role="listitem" aria-label="@RowAriaLabel(item)">
                            <div class="pos-categories__row-body">
                                <div class="pos-categories__row-top">
                                    <span class="pos-categories__row-name">@item.Name</span>
                                    <span class="pos-categories__badge pos-categories__badge--@(isActive ? "active" : "inactive")"
                                          aria-label="@($"{L["Catalog_Filter_Status"]}: {CatalogUiOptions.StatusLabel(L, item.Status)}")">
                                        @CatalogUiOptions.StatusLabel(L, item.Status)
                                    </span>
                                </div>
                            </div>
                            @if (canManage)
                            {
                                <div class="pos-categories__menu @(menuOpen ? "pos-categories__menu--open" : null)"
                                     @onclick:stopPropagation="true">
                                    <button type="button"
                                            class="pos-categories__menu-trigger"
                                            aria-label="@L["Catalog_Category_MoreActions"]"
                                            aria-haspopup="menu"
                                            aria-expanded="@menuOpen"
                                            disabled="@(_isOffline || _saving || rowBusy)"
                                            @onclick="() => ToggleMenu(item.CategoryId)">
                                        @if (rowBusy)
                                        {
                                            <Spinner Size="SpinnerSize.Sm" />
                                        }
                                        else
                                        {
                                            <span aria-hidden="true">@IconGlyphs.Get("more")</span>
                                        }
                                    </button>
                                    @if (menuOpen)
                                    {
                                        <div class="pos-categories__menu-panel" role="menu">
                                            <button type="button"
                                                    class="pos-categories__menu-item"
                                                    role="menuitem"
                                                    disabled="@(_isOffline || _saving || rowBusy)"
                                                    @onclick="() => BeginRename(item)">
                                                @L["Catalog_Category_Rename"]
                                            </button>
                                            @if (isActive)
                                            {
                                                <button type="button"
                                                        class="pos-categories__menu-item pos-categories__menu-item--danger"
                                                        role="menuitem"
                                                        disabled="@(_isOffline || _saving || rowBusy)"
                                                        @onclick="() => RequestDeactivate(item)">
                                                    @L["Catalog_Deactivate"]
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="pos-categories__menu-item"
                                                        role="menuitem"
                                                        disabled="@(_isOffline || _saving || rowBusy)"
                                                        @onclick="() => ToggleStatusAsync(item)">
                                                    @L["Catalog_Reactivate"]
                                                </button>
                                            }
                                            <button type="button"
                                                    class="pos-categories__menu-item pos-categories__menu-item--cancel"
                                                    role="menuitem"
                                                    @onclick="CloseMenu">
                                                @L["Catalog_Cancel"]
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        @if (!_loading && TotalPages > 1)
        {
            <Pagination Page="@_page"
                        PageSize="@_pageSize"
                        TotalCount="@_totalCount"
                        Disabled="@_isOffline"
                        PageChanged="OnPageChanged" />
        }

        <ConfirmDialog @bind-Visible="_deactivateOpen"
                       Title="@L["Catalog_Category_ConfirmDeactivateTitle"]"
                       Message="@_deactivateMessage"
                       Danger="true"
                       ConfirmLabel="@L["Catalog_Deactivate"]"
                       CancelLabel="@L["Catalog_Cancel"]"
                       IsLoading="@(_busyCategoryId is not null)"
                       OnConfirm="ConfirmDeactivateAsync"
                       OnCancel="CancelDeactivate" />
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _initialLoadStarted;
    private bool _saving;
    private bool _isOffline;
    private bool _formOpen;
    private bool _deactivateOpen;
    private string? _search;
    private string? _statusFilter = PosCatalogOptions.ActiveStatus;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosProductCategoryDto> _items = Array.Empty<PosProductCategoryDto>();
    private Guid? _editingId;
    private DateTimeOffset? _editingUpdatedAtUtc;
    private Guid? _menuCategoryId;
    private Guid? _busyCategoryId;
    private Guid? _pendingDeactivateId;
    private string? _deactivateMessage;
    private string? _name;
    private string? _nameError;
    private string? _formError;
    private string? _banner;
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    private bool HasListQuery => !string.IsNullOrWhiteSpace(_search);

    private IReadOnlyList<(string Value, string Label)> StatusSegmentOptions =>
    [
        (string.Empty, L["Catalog_Category_Filter_All"].Value),
        (PosCatalogOptions.ActiveStatus, L["Catalog_Status_Active"].Value),
        (PosCatalogOptions.InactiveStatus, L["Catalog_Status_Inactive"].Value),
    ];

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged += OnConnectivityChanged;

        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewCatalog))
        {
            _errorTitle = L["Access_RestrictedTitle"];
            _errorMessage = L["Access_RestrictedMessage"];
        }

        // Paint the page first; load after first render so MAUI Blazor does not stall
        // inside OnInitializedAsync with IsLoading stuck on.
        _ready = true;
        _loading = Capabilities.IsAllowed(UtangCapability.ViewCatalog);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadStarted || !_loading || !string.IsNullOrEmpty(_errorTitle))
        {
            return;
        }

        _initialLoadStarted = true;
        await ReloadAsync(showLoading: true);
    }

    public void Dispose()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private async void OnConnectivityChanged(object? sender, ConnectivityStatus status)
    {
        var wasOffline = _isOffline;
        _isOffline = status == ConnectivityStatus.Offline;
        await InvokeAsync(StateHasChanged);
        if (wasOffline && !_isOffline && Capabilities.IsAllowed(UtangCapability.ViewCatalog))
        {
            await InvokeAsync(() => ReloadAsync(showLoading: true));
        }
    }

    private Task ReloadWithLoadingAsync() => ReloadAsync(showLoading: true);

    private void OnNameChanged(string? value)
    {
        _name = value;
        _nameError = null;
    }

    private async Task OnSearchInputAsync(string? value)
    {
        _search = value;
        _page = 1;
        _menuCategoryId = null;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync(showLoading: true);
        }
        catch (OperationCanceledException)
        {
            // superseded by newer keystrokes
        }
    }

    private async Task ClearSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return;
        }

        _search = null;
        _page = 1;
        _menuCategoryId = null;
        await ReloadAsync(showLoading: true);
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        var next = value ?? string.Empty;
        if (string.Equals(next, _statusFilter ?? string.Empty, StringComparison.Ordinal))
        {
            return;
        }

        _statusFilter = next;
        _page = 1;
        _menuCategoryId = null;
        await ReloadAsync(showLoading: true);
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        _menuCategoryId = null;
        await ReloadAsync(showLoading: true);
    }

    private async Task ReloadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _loading = true;
            _errorTitle = null;
            _errorMessage = null;
        }

        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                if (showLoading)
                {
                    _items = Array.Empty<PosProductCategoryDto>();
                    _totalCount = 0;
                }

                _errorTitle = L["Catalog_OfflineTitle"];
                _errorMessage = L["Catalog_OfflineMessage"];
                return;
            }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(12));
            var result = await Catalog.ListCategoriesAsync(
                _search,
                string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                _page,
                _pageSize,
                cts.Token);

            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
                _totalCount = result.Data.TotalCount;
                if (_page > TotalPages)
                {
                    _page = TotalPages;
                }

                _errorTitle = null;
                _errorMessage = null;
            }
            else if (showLoading || _items.Count == 0)
            {
                _items = Array.Empty<PosProductCategoryDto>();
                _totalCount = 0;
                if (result.Status is ApiCallStatus.Timeout or ApiCallStatus.Cancelled)
                {
                    _errorTitle = L["Catalog_ErrorTitle"];
                    _errorMessage = L["Status_Timeout"];
                }
                else
                {
                    var described = ApiLocalizer.Describe(result.Status, result.Error);
                    _errorTitle = described.Title;
                    _errorMessage = result.Error?.Detail ?? described.Message;
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (showLoading || _items.Count == 0)
            {
                _items = Array.Empty<PosProductCategoryDto>();
                _totalCount = 0;
                _errorTitle = L["Catalog_ErrorTitle"];
                _errorMessage = L["Status_Timeout"];
            }
        }
        catch
        {
            if (showLoading || _items.Count == 0)
            {
                _items = Array.Empty<PosProductCategoryDto>();
                _totalCount = 0;
                _errorTitle = L["Catalog_ErrorTitle"];
                _errorMessage = L["Api_Unavailable"];
            }
        }
        finally
        {
            _loading = false;
            // Queue a follow-up render. Do not await InvokeAsync here — that deadlocks
            // when Reload runs from OnAfterRenderAsync on MAUI Blazor.
            StateHasChanged();
        }
    }

    private void BeginCreate()
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog) || _isOffline || _saving)
        {
            return;
        }

        _editingId = null;
        _editingUpdatedAtUtc = null;
        _name = null;
        _nameError = null;
        _formError = null;
        _banner = null;
        _menuCategoryId = null;
        _formOpen = true;
    }

    private void BeginRename(PosProductCategoryDto category)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog) || _isOffline || _saving)
        {
            return;
        }

        _editingId = category.CategoryId;
        _editingUpdatedAtUtc = category.UpdatedAtUtc;
        _name = category.Name;
        _nameError = null;
        _formError = null;
        _banner = null;
        _menuCategoryId = null;
        _formOpen = true;
    }

    private void CancelForm()
    {
        _formOpen = false;
        _editingId = null;
        _editingUpdatedAtUtc = null;
        _name = null;
        _nameError = null;
    }

    private void ToggleMenu(Guid categoryId)
    {
        _menuCategoryId = _menuCategoryId == categoryId ? null : categoryId;
    }

    private void CloseMenu() => _menuCategoryId = null;

    private void OnMenuKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            CloseMenu();
        }
    }

    private void OnMenuBackNavigation(LocationChangingContext context)
    {
        if (_menuCategoryId is null)
        {
            return;
        }

        context.PreventNavigation();
        CloseMenu();
    }

    private void RequestDeactivate(PosProductCategoryDto category)
    {
        _menuCategoryId = null;
        _pendingDeactivateId = category.CategoryId;
        _deactivateMessage = string.Format(L["Catalog_Category_ConfirmDeactivateMessage"].Value, category.Name);
        _deactivateOpen = true;
    }

    private void CancelDeactivate()
    {
        _deactivateOpen = false;
        _pendingDeactivateId = null;
        _deactivateMessage = null;
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_pendingDeactivateId is not { } id)
        {
            CancelDeactivate();
            return;
        }

        var item = _items.FirstOrDefault(c => c.CategoryId == id);
        CancelDeactivate();
        if (item is null)
        {
            return;
        }

        await ToggleStatusAsync(item);
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        if (_isOffline)
        {
            _formError = L["Catalog_OfflineMessage"];
            return;
        }

        _nameError = null;
        _formError = null;
        _banner = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _nameError = L["Catalog_Category_NameRequired"];
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            var editingId = _editingId;
            var trimmed = _name.Trim();
            var result = editingId is { } id
                ? await Catalog.UpdateCategoryAsync(id, new UpdatePosProductCategoryRequest(trimmed, _editingUpdatedAtUtc))
                : await Catalog.CreateCategoryAsync(new CreatePosProductCategoryRequest(trimmed));

            if (result.IsSuccess && result.Data is not null)
            {
                _banner = editingId is null
                    ? L["Catalog_Category_CreatedSuccess"]
                    : L["Catalog_Category_UpdatedSuccess"];
                CancelForm();
                UpsertLocalCategory(result.Data);
                // Clear save spinner before refresh so the UI never looks stuck on Add.
                _saving = false;
                StateHasChanged();
                // Quiet refresh: keep the new row visible (don't replace the list with a spinner).
                await ReloadAsync(showLoading: false);
                return;
            }

            var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
            _nameError = mapped.Name;
            _formError = mapped.Form
                ?? result.Error?.Detail
                ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
        catch
        {
            _formError = L["Api_Unavailable"];
        }
        finally
        {
            _saving = false;
        }
    }

    private void UpsertLocalCategory(PosProductCategoryDto category)
    {
        var list = _items.ToList();
        var index = list.FindIndex(c => c.CategoryId == category.CategoryId);
        var matchesFilter = string.IsNullOrWhiteSpace(_statusFilter)
            || string.Equals(_statusFilter, category.Status, StringComparison.OrdinalIgnoreCase);

        if (index >= 0)
        {
            if (matchesFilter)
            {
                list[index] = category;
            }
            else
            {
                list.RemoveAt(index);
                _totalCount = Math.Max(0, _totalCount - 1);
            }
        }
        else if (matchesFilter)
        {
            list.Insert(0, category);
            _totalCount += 1;
        }

        _items = list;
        _errorTitle = null;
        _errorMessage = null;
    }

    private async Task ToggleStatusAsync(PosProductCategoryDto category)
    {
        if (_busyCategoryId is not null || _saving)
        {
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog) || _isOffline)
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _menuCategoryId = null;
        _formError = null;
        _banner = null;
        _busyCategoryId = category.CategoryId;
        StateHasChanged();

        try
        {
            var result = category.Status == PosCatalogOptions.ActiveStatus
                ? await Catalog.DeactivateCategoryAsync(category.CategoryId)
                : await Catalog.ReactivateCategoryAsync(category.CategoryId);

            if (result.IsSuccess)
            {
                _banner = category.Status == PosCatalogOptions.ActiveStatus
                    ? L["Catalog_Category_DeactivatedSuccess"]
                    : L["Catalog_Category_ReactivatedSuccess"];
                if (result.Data is not null)
                {
                    UpsertLocalCategory(result.Data);
                }

                await ReloadAsync(showLoading: false);
                return;
            }

            var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
            _formError = mapped.Form
                ?? result.Error?.Detail
                ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
        catch
        {
            _formError = L["Api_Unavailable"];
        }
        finally
        {
            _busyCategoryId = null;
        }
    }

    private string RowAriaLabel(PosProductCategoryDto item) =>
        $"{item.Name}, {CatalogUiOptions.StatusLabel(L, item.Status)}";
}

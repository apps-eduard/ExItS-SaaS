@page "/catalog/products/{ProductId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/catalog" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Catalog_Loading"]</span></Page>
}
else if (_product is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Catalog_Product_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Catalog_Product_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
    var product = _product;
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
    var isActive = product.Status == PosCatalogOptions.ActiveStatus;
    var manageOnline = canManage && !_isOffline;
<div class="pos-catalog-product-detail">
<Page>
    <header class="pos-catalog-product-detail__header">
        <h1 class="pos-catalog-product-detail__title">@product.Name</h1>
        <p class="pos-catalog-product-detail__subtitle">@L["Catalog_Product_DetailSubtitle"]</p>
        <div class="pos-catalog-product-detail__status-row">
            <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">@CatalogUiOptions.StatusLabel(L, product.Status)</Badge>
        </div>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Catalog_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Catalog_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-catalog-product-detail__panel" aria-labelledby="catalog-product-detail-heading">
        <h2 id="catalog-product-detail-heading" class="pos-catalog-product-detail__section-title">@L["Catalog_Product_DetailsSection"]</h2>
        <div class="pos-catalog-product-detail__amount">
            <span class="pos-catalog-product-detail__amount-label">@L["Catalog_Field_SellingPrice"]</span>
            <div class="pos-catalog-product-detail__amount-value">
                <MoneyDisplay Amount="@product.SellingPrice" CurrencyCode="PHP" Emphasized="true" />
            </div>
        </div>
        <dl class="pos-catalog-product-detail__facts">
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_Name"]</dt>
                <dd>@product.Name</dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_Description"]</dt>
                <dd class="pos-wrap">@(string.IsNullOrWhiteSpace(product.Description) ? L["Catalog_NoValue"] : product.Description)</dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_Sku"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(product.Sku) ? L["Catalog_NoValue"] : product.Sku)</dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_Barcode"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(product.Barcode) ? L["Catalog_NoValue"] : product.Barcode)</dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_Category"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(_categoryName) ? L["Catalog_Product_NoCategory"] : _categoryName)</dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_Unit"]</dt>
                <dd>@CatalogUiOptions.UnitOfMeasureLabel(L, product.UnitOfMeasure)</dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_SellingMode"]</dt>
                <dd>@CatalogUiOptions.SellingModeLabel(L, product.SellingMode)</dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_Field_Status"]</dt>
                <dd>
                    <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">@CatalogUiOptions.StatusLabel(L, product.Status)</Badge>
                </dd>
            </div>
            <div class="pos-catalog-product-detail__fact">
                <dt>@L["Catalog_ConnectedBuyers_Section"]</dt>
                <dd>
                    @(product.CanExposeToConnectedBuyers
                        ? L["Catalog_ConnectedBuyers_Available"]
                        : L["ConnectedBuyers_BlockedForConnectedBuyers"])
                </dd>
            </div>
            @if (product.DefaultConnectedPoPrice is decimal connectedPoPrice)
            {
                <div class="pos-catalog-product-detail__fact">
                    <dt>@L["Catalog_ConnectedBuyers_DefaultPoPrice"]</dt>
                    <dd><MoneyDisplay Amount="@connectedPoPrice" CurrencyCode="PHP" /></dd>
                </div>
            }
            else
            {
                <div class="pos-catalog-product-detail__fact">
                    <dt>@L["Catalog_ConnectedBuyers_DefaultPoPrice"]</dt>
                    <dd class="pos-muted">@L["ConnectedBuyers_DefaultPoNotSet"]</dd>
                </div>
            }
            <div class="pos-catalog-product-detail__fact">
                <dt></dt>
                <dd class="pos-muted">@L["Catalog_ConnectedBuyers_VisibilityHelp"]</dd>
            </div>
        </dl>
    </section>

    <div class="pos-action-grid pos-action-grid--two pos-catalog-product-detail__actions" role="group">
        <button type="button"
                class="pos-action-tile pos-action-tile--primary"
                disabled="@(!manageOnline)"
                @onclick="GoEdit">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("edit")</span>
            <span class="pos-action-tile__label">@L["Catalog_Product_Edit"]</span>
        </button>
        @if (isActive)
        {
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(!manageOnline)"
                    @onclick="() => _confirmDeactivate = true">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                <span class="pos-action-tile__label">@L["Catalog_Deactivate"]</span>
            </button>
        }
        else
        {
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(!manageOnline)"
                    @onclick="() => _confirmReactivate = true">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                <span class="pos-action-tile__label">@L["Catalog_Reactivate"]</span>
            </button>
        }
    </div>

    <ConfirmDialog Visible="@_confirmDeactivate"
                   VisibleChanged="v => _confirmDeactivate = v"
                   Title="@L["Catalog_Product_DeactivateTitle"]"
                   Message="@L["Catalog_Product_DeactivateMessage"]"
                   Danger="true"
                   ConfirmLabel="@L["Catalog_Deactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="DeactivateAsync" />

    <ConfirmDialog Visible="@_confirmReactivate"
                   VisibleChanged="v => _confirmReactivate = v"
                   Title="@L["Catalog_Product_ReactivateTitle"]"
                   Message="@L["Catalog_Product_ReactivateMessage"]"
                   ConfirmLabel="@L["Catalog_Reactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="ReactivateAsync" />
</Page>
</div>
}

@code {
    [Parameter] public Guid ProductId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _acting;
    private bool _isOffline;
    private bool _confirmDeactivate;
    private bool _confirmReactivate;
    private PosCatalogProductDto? _product;
    private string? _categoryName;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _categoryName = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _product = null;
            _errorTitle = L["Catalog_OfflineTitle"];
            _errorMessage = L["Catalog_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Catalog.GetProductAsync(ProductId);
        if (result.IsSuccess && result.Data is not null)
        {
            _product = result.Data;
            if (_product.CategoryId is { } categoryId)
            {
                var category = await Catalog.GetCategoryAsync(categoryId);
                _categoryName = category.IsSuccess ? category.Data?.Name : null;
            }
        }
        else
        {
            _product = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task DeactivateAsync()
    {
        _acting = true;
        var result = await Catalog.DeactivateProductAsync(ProductId);
        _acting = false;
        _confirmDeactivate = false;
        ApplyMutation(result, L["Catalog_Product_DeactivatedSuccess"]);
    }

    private async Task ReactivateAsync()
    {
        _acting = true;
        var result = await Catalog.ReactivateProductAsync(ProductId);
        _acting = false;
        _confirmReactivate = false;
        ApplyMutation(result, L["Catalog_Product_ReactivatedSuccess"]);
    }

    private void ApplyMutation(ApiResult<PosCatalogProductDto> result, string successMessage)
    {
        if (result.IsSuccess && result.Data is not null)
        {
            _product = result.Data;
            _banner = successMessage;
            _errorTitle = null;
            _errorMessage = null;
            return;
        }

        _banner = null;
        _errorTitle = L["Catalog_ErrorTitle"];
        var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
        _errorMessage = mapped.Form
            ?? result.Error?.Detail
            ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private void GoEdit() => Nav.NavigateTo($"/catalog/products/{ProductId:D}/edit");
}

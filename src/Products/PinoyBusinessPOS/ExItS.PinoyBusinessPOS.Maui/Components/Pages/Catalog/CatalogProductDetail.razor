@page "/catalog/products/{ProductId:guid}"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Catalog_Loading"]</span></Page>
}
else if (_product is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Catalog_Product_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Catalog_Product_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
        <Button Variant="ButtonVariant.Secondary" OnClick="GoList">@L["Catalog_BackToList"]</Button>
    </Page>
}
else
{
    var product = _product;
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
    var isActive = product.Status == PosCatalogOptions.ActiveStatus;
<Page>
    <PageHeader Title="@product.Name" Subtitle="@L["Catalog_Product_DetailSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoList">@L["Catalog_BackToList"]</Button>
            <Button Variant="ButtonVariant.Primary" Disabled="@(!canManage || _isOffline)" OnClick="GoEdit">@L["Catalog_Product_Edit"]</Button>
        </Actions>
    </PageHeader>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Catalog_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Catalog_ErrorTitle"])" Message="@_errorMessage" />
    }

    <Section Title="@L["Catalog_Product_DetailsSection"]">
        <Stack Gap="3">
            <div>
                <span class="pos-muted">@L["Catalog_Field_Name"]</span>
                <div class="pos-value-md">@product.Name</div>
            </div>
            <div>
                <span class="pos-muted">@L["Catalog_Field_Description"]</span>
                <div class="pos-value-md pos-wrap">@(string.IsNullOrWhiteSpace(product.Description) ? L["Catalog_NoValue"] : product.Description)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Catalog_Field_Sku"]</span>
                <div class="pos-value-md">@(string.IsNullOrWhiteSpace(product.Sku) ? L["Catalog_NoValue"] : product.Sku)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Catalog_Field_Barcode"]</span>
                <div class="pos-value-md">@(string.IsNullOrWhiteSpace(product.Barcode) ? L["Catalog_NoValue"] : product.Barcode)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Catalog_Field_Category"]</span>
                <div class="pos-value-md">@(string.IsNullOrWhiteSpace(_categoryName) ? L["Catalog_Product_NoCategory"] : _categoryName)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Catalog_Field_Unit"]</span>
                <div class="pos-value-md">@CatalogUiOptions.UnitOfMeasureLabel(L, product.UnitOfMeasure)</div>
            </div>
            <div>
                <span class="pos-muted">@L["Catalog_Field_SellingPrice"]</span>
                <div class="pos-value-md">
                    <MoneyDisplay Amount="@product.SellingPrice" CurrencyCode="PHP" />
                </div>
            </div>
            <div>
                <span class="pos-muted">@L["Catalog_Field_Status"]</span>
                <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">@CatalogUiOptions.StatusLabel(L, product.Status)</Badge>
            </div>
        </Stack>
    </Section>

    <FormActions>
        @if (isActive)
        {
            <Button Variant="ButtonVariant.Danger" Disabled="@(!canManage || _isOffline)" OnClick="() => _confirmDeactivate = true">@L["Catalog_Deactivate"]</Button>
        }
        else
        {
            <Button Variant="ButtonVariant.Primary" Disabled="@(!canManage || _isOffline)" OnClick="() => _confirmReactivate = true">@L["Catalog_Reactivate"]</Button>
        }
    </FormActions>

    <ConfirmDialog Visible="@_confirmDeactivate"
                   VisibleChanged="v => _confirmDeactivate = v"
                   Title="@L["Catalog_Product_DeactivateTitle"]"
                   Message="@L["Catalog_Product_DeactivateMessage"]"
                   Danger="true"
                   ConfirmLabel="@L["Catalog_Deactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="DeactivateAsync" />

    <ConfirmDialog Visible="@_confirmReactivate"
                   VisibleChanged="v => _confirmReactivate = v"
                   Title="@L["Catalog_Product_ReactivateTitle"]"
                   Message="@L["Catalog_Product_ReactivateMessage"]"
                   ConfirmLabel="@L["Catalog_Reactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="ReactivateAsync" />
</Page>
}

@code {
    [Parameter] public Guid ProductId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _acting;
    private bool _isOffline;
    private bool _confirmDeactivate;
    private bool _confirmReactivate;
    private PosCatalogProductDto? _product;
    private string? _categoryName;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _categoryName = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _product = null;
            _errorTitle = L["Catalog_OfflineTitle"];
            _errorMessage = L["Catalog_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Catalog.GetProductAsync(ProductId);
        if (result.IsSuccess && result.Data is not null)
        {
            _product = result.Data;
            if (_product.CategoryId is { } categoryId)
            {
                var category = await Catalog.GetCategoryAsync(categoryId);
                _categoryName = category.IsSuccess ? category.Data?.Name : null;
            }
        }
        else
        {
            _product = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task DeactivateAsync()
    {
        _acting = true;
        var result = await Catalog.DeactivateProductAsync(ProductId);
        _acting = false;
        _confirmDeactivate = false;
        ApplyMutation(result, L["Catalog_Product_DeactivatedSuccess"]);
    }

    private async Task ReactivateAsync()
    {
        _acting = true;
        var result = await Catalog.ReactivateProductAsync(ProductId);
        _acting = false;
        _confirmReactivate = false;
        ApplyMutation(result, L["Catalog_Product_ReactivatedSuccess"]);
    }

    private void ApplyMutation(ApiResult<PosCatalogProductDto> result, string successMessage)
    {
        if (result.IsSuccess && result.Data is not null)
        {
            _product = result.Data;
            _banner = successMessage;
            _errorTitle = null;
            _errorMessage = null;
            return;
        }

        _banner = null;
        _errorTitle = L["Catalog_ErrorTitle"];
        var mapped = CatalogErrorPresenter.Describe(result.Error?.ErrorCode, L);
        _errorMessage = mapped.Form
            ?? result.Error?.Detail
            ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private void GoList() => Nav.NavigateTo("/catalog");
    private void GoEdit() => Nav.NavigateTo($"/catalog/products/{ProductId:D}/edit");
}

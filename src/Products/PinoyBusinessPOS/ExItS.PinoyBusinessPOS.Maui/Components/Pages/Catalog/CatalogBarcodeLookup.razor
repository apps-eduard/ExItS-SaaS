@page "/catalog/barcode-lookup"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject ICurrentUserContext CurrentUser
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/catalog" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-catalog-lookup">
    <Page>
        <header class="pos-catalog-lookup__header">
            <h1 class="pos-catalog-lookup__title">@L["Catalog_Lookup_Title"]</h1>
            <p class="pos-catalog-lookup__subtitle">@L["Catalog_Lookup_Subtitle"]</p>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
        }

        <section class="pos-catalog-lookup__panel" aria-labelledby="catalog-lookup-form-heading">
            <h2 id="catalog-lookup-form-heading" class="pos-catalog-lookup__section-title">@L["Catalog_Lookup_FormTitle"]</h2>
            <div class="pos-catalog-lookup__form">
                <TextInput Label="@L["Catalog_Lookup_Barcode"]"
                           Value="@_barcode"
                           ValueChanged="v => _barcode = v"
                           Hint="@L["Catalog_BarcodeHint"]"
                           Disabled="@(_searching || _isOffline)" />
                <TextInput Label="@L["Catalog_Lookup_Sku"]"
                           Value="@_sku"
                           ValueChanged="v => _sku = v"
                           Hint="@L["Catalog_SkuHint"]"
                           Disabled="@(_searching || _isOffline)" />
                <Checkbox Value="@_includeInactive"
                          ValueChanged="v => _includeInactive = v"
                          Disabled="@(_searching || _isOffline)">
                    @L["Catalog_Lookup_IncludeInactive"]
                </Checkbox>
            </div>

            <div class="pos-action-grid pos-action-grid--two pos-catalog-lookup__actions" role="group" aria-label="@L["Catalog_Lookup_FormTitle"]">
                <button type="button"
                        class="pos-action-tile"
                        disabled="@_searching"
                        @onclick="Clear">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                    <span class="pos-action-tile__label">@L["Catalog_Lookup_Clear"]</span>
                </button>
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@(_isOffline || _searching)"
                        @onclick="SearchAsync">
                    @if (_searching)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                    }
                    <span class="pos-action-tile__label">@L["Catalog_Lookup_Search"]</span>
                </button>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(_message))
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_Lookup_NoMatchTitle"]" Message="@_message" />
        }

        @if (_product is not null)
        {
            <section class="pos-catalog-lookup__panel" aria-labelledby="catalog-lookup-result-heading">
                <h2 id="catalog-lookup-result-heading" class="pos-catalog-lookup__section-title">@L["Catalog_Lookup_ResultTitle"]</h2>
                <dl class="pos-catalog-lookup__facts">
                    <div class="pos-catalog-lookup__fact">
                        <dt>@L["Catalog_Field_Name"]</dt>
                        <dd>@_product.Name</dd>
                    </div>
                    <div class="pos-catalog-lookup__fact">
                        <dt>@L["Catalog_Field_Sku"]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_product.Sku) ? L["Catalog_NoValue"] : _product.Sku)</dd>
                    </div>
                    <div class="pos-catalog-lookup__fact">
                        <dt>@L["Catalog_Field_Barcode"]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_product.Barcode) ? L["Catalog_NoValue"] : _product.Barcode)</dd>
                    </div>
                    <div class="pos-catalog-lookup__fact">
                        <dt>@L["Catalog_Field_Unit"]</dt>
                        <dd>@CatalogUiOptions.UnitOfMeasureLabel(L, _product.UnitOfMeasure)</dd>
                    </div>
                    <div class="pos-catalog-lookup__fact">
                        <dt>@L["Catalog_Field_SellingPrice"]</dt>
                        <dd>
                            <MoneyDisplay Amount="@_product.SellingPrice" CurrencyCode="PHP" />
                        </dd>
                    </div>
                    <div class="pos-catalog-lookup__fact">
                        <dt>@L["Catalog_Field_Status"]</dt>
                        <dd>
                            <Badge Tone="@(_product.Status == PosCatalogOptions.ActiveStatus ? BadgeTone.Success : BadgeTone.Neutral)">
                                @CatalogUiOptions.StatusLabel(L, _product.Status)
                            </Badge>
                        </dd>
                    </div>
                </dl>

                <div class="pos-action-grid pos-action-grid--single pos-catalog-lookup__open" role="group">
                    <button type="button"
                            class="pos-action-tile pos-action-tile--primary"
                            @onclick="GoProduct">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                        <span class="pos-action-tile__label">@L["Catalog_Lookup_OpenProduct"]</span>
                    </button>
                </div>
            </section>
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _searching;
    private bool _isOffline;
    private bool _includeInactive;
    private string? _barcode;
    private string? _sku;
    private PosCatalogProductDto? _product;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        _isOffline = !await Connectivity.IsConnectedAsync();
    }

    private void Clear()
    {
        _barcode = null;
        _sku = null;
        _product = null;
        _message = null;
    }

    private async Task SearchAsync()
    {
        _product = null;
        _message = null;

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _message = L["Catalog_OfflineMessage"];
            return;
        }

        var hasBarcode = !string.IsNullOrWhiteSpace(_barcode);
        var hasSku = !string.IsNullOrWhiteSpace(_sku);
        if (!hasBarcode && !hasSku)
        {
            _message = L["Catalog_Lookup_InputRequired"];
            return;
        }

        _searching = true;
        try
        {
            var result = hasBarcode
                ? await Catalog.LookupByBarcodeAsync(_barcode!.Trim(), _includeInactive)
                : await Catalog.LookupBySkuAsync(_sku!.Trim(), _includeInactive);

            if (result.IsSuccess && result.Data is not null)
            {
                _product = result.Data;
                return;
            }

            _message = result.Status == ApiCallStatus.NotFound
                ? L["Catalog_Lookup_NoMatchMessage"]
                : result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
        finally
        {
            _searching = false;
        }
    }

    private void GoProduct()
    {
        if (_product is not null)
        {
            Nav.NavigateTo($"/catalog/products/{_product.ProductId:D}");
        }
    }
}

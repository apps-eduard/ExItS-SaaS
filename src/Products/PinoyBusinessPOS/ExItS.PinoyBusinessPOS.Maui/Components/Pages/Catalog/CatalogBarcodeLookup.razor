@page "/catalog/barcode-lookup"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogClient Catalog
@inject ICurrentUserContext CurrentUser
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<Page>
    <PageHeader Title="@L["Catalog_Lookup_Title"]" Subtitle="@L["Catalog_Lookup_Subtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoCatalog">@L["Catalog_BackToList"]</Button>
        </Actions>
    </PageHeader>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_OfflineMessage"]" />
    }

    <Section Title="@L["Catalog_Lookup_FormTitle"]">
        <Stack Gap="3">
            <TextInput Label="@L["Catalog_Lookup_Barcode"]"
                       Value="@_barcode"
                       ValueChanged="v => _barcode = v"
                       Hint="@L["Catalog_BarcodeHint"]"
                       Disabled="@(_searching || _isOffline)" />
            <TextInput Label="@L["Catalog_Lookup_Sku"]"
                       Value="@_sku"
                       ValueChanged="v => _sku = v"
                       Hint="@L["Catalog_SkuHint"]"
                       Disabled="@(_searching || _isOffline)" />
            <Checkbox Value="@_includeInactive"
                      ValueChanged="v => _includeInactive = v"
                      Disabled="@(_searching || _isOffline)">
                @L["Catalog_Lookup_IncludeInactive"]
            </Checkbox>
            <FormActions>
                <Button Variant="ButtonVariant.Secondary" Disabled="@_searching" OnClick="Clear">@L["Catalog_Lookup_Clear"]</Button>
                <Button Variant="ButtonVariant.Primary" Disabled="@_isOffline" IsLoading="@_searching" OnClick="SearchAsync">@L["Catalog_Lookup_Search"]</Button>
            </FormActions>
        </Stack>
    </Section>

    @if (!string.IsNullOrEmpty(_message))
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Catalog_Lookup_NoMatchTitle"]" Message="@_message" />
    }

    @if (_product is not null)
    {
        <Section Title="@L["Catalog_Lookup_ResultTitle"]">
            <Stack Gap="3">
                <div>
                    <span class="pos-muted">@L["Catalog_Field_Name"]</span>
                    <div class="pos-value-md">@_product.Name</div>
                </div>
                <div>
                    <span class="pos-muted">@L["Catalog_Field_Sku"]</span>
                    <div class="pos-value-md">@(string.IsNullOrWhiteSpace(_product.Sku) ? L["Catalog_NoValue"] : _product.Sku)</div>
                </div>
                <div>
                    <span class="pos-muted">@L["Catalog_Field_Barcode"]</span>
                    <div class="pos-value-md">@(string.IsNullOrWhiteSpace(_product.Barcode) ? L["Catalog_NoValue"] : _product.Barcode)</div>
                </div>
                <div>
                    <span class="pos-muted">@L["Catalog_Field_Unit"]</span>
                    <div class="pos-value-md">@CatalogUiOptions.UnitOfMeasureLabel(L, _product.UnitOfMeasure)</div>
                </div>
                <div>
                    <span class="pos-muted">@L["Catalog_Field_SellingPrice"]</span>
                    <div class="pos-value-md">
                        <MoneyDisplay Amount="@_product.SellingPrice" CurrencyCode="PHP" />
                    </div>
                </div>
                <div>
                    <span class="pos-muted">@L["Catalog_Field_Status"]</span>
                    <Badge Tone="@(_product.Status == PosCatalogOptions.ActiveStatus ? BadgeTone.Success : BadgeTone.Neutral)">
                        @CatalogUiOptions.StatusLabel(L, _product.Status)
                    </Badge>
                </div>
                <FormActions>
                    <Button Variant="ButtonVariant.Primary" OnClick="GoProduct">@L["Catalog_Lookup_OpenProduct"]</Button>
                </FormActions>
            </Stack>
        </Section>
    }
</Page>
}

@code {
    private bool _ready;
    private bool _searching;
    private bool _isOffline;
    private bool _includeInactive;
    private string? _barcode;
    private string? _sku;
    private PosCatalogProductDto? _product;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        _isOffline = !await Connectivity.IsConnectedAsync();
    }

    private void Clear()
    {
        _barcode = null;
        _sku = null;
        _product = null;
        _message = null;
    }

    private async Task SearchAsync()
    {
        _product = null;
        _message = null;

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _message = L["Catalog_OfflineMessage"];
            return;
        }

        var hasBarcode = !string.IsNullOrWhiteSpace(_barcode);
        var hasSku = !string.IsNullOrWhiteSpace(_sku);
        if (!hasBarcode && !hasSku)
        {
            _message = L["Catalog_Lookup_InputRequired"];
            return;
        }

        _searching = true;
        var result = hasBarcode
            ? await Catalog.LookupByBarcodeAsync(_barcode!.Trim(), _includeInactive)
            : await Catalog.LookupBySkuAsync(_sku!.Trim(), _includeInactive);
        _searching = false;

        if (result.IsSuccess && result.Data is not null)
        {
            _product = result.Data;
            return;
        }

        _message = result.Status == ApiCallStatus.NotFound
            ? L["Catalog_Lookup_NoMatchMessage"]
            : result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private void GoCatalog() => Nav.NavigateTo("/catalog");

    private void GoProduct()
    {
        if (_product is not null)
        {
            Nav.NavigateTo($"/catalog/products/{_product.ProductId:D}");
        }
    }
}

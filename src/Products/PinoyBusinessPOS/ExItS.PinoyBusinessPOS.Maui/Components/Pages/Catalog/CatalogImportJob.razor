@page "/catalog/import/jobs/{JobId:guid}"
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCatalogImportClient Imports
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_canManage)
{
<div class="pos-catalog-import-job">
    <Page>
        <header class="pos-catalog-import-job__header">
            <h1 class="pos-catalog-import-job__title">@L["Catalog_Import_ProgressTitle"]</h1>
            <p class="pos-catalog-import-job__subtitle">@L["Catalog_Import_ProgressSubtitle"]</p>
        </header>
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        <div class="pos-action-grid pos-action-grid--single pos-catalog-import-job__actions">
            <button type="button" class="pos-action-tile" @onclick="GoCatalog">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["Catalog_Title"]</span>
            </button>
        </div>
    </Page>
</div>
}
else
{
<div class="pos-catalog-import-job">
    <Page>
        <header class="pos-catalog-import-job__header">
            <h1 class="pos-catalog-import-job__title">@L["Catalog_Import_ProgressTitle"]</h1>
            <p class="pos-catalog-import-job__subtitle">@L["Catalog_Import_ProgressSubtitle"]</p>
        </header>

        <div class="pos-action-grid pos-action-grid--single pos-catalog-import-job__actions" role="group" aria-label="@L["Catalog_Import_ProgressTitle"]">
            <button type="button" class="pos-action-tile" @onclick="GoCatalog">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["Catalog_Title"]</span>
            </button>
        </div>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Catalog_OfflineTitle"]" Message="@L["Catalog_Import_OfflineMessage"]" />
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Catalog_ErrorTitle"])" Message="@_errorMessage" />
        }

        @if (_job is null && !_loading)
        {
            <ErrorState Title="@L["Catalog_Import_JobNotFoundTitle"]"
                        Message="@L["Catalog_Import_JobNotFoundMessage"]"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="LoadAsync" />
        }
        else if (_job is not null)
        {
            var terminal = IsTerminal(_job.Status);
            var successTerminal = IsSuccessTerminal(_job.Status);
            <section class="pos-catalog-import-job__panel" aria-labelledby="catalog-import-job-heading">
                <h2 id="catalog-import-job-heading" class="pos-catalog-import-job__section-title">@L["Catalog_Import_StatusSection"]</h2>
                <div class="pos-catalog-import-job__status-row">
                    <Badge Tone="@StatusTone(_job.Status)">@StatusLabel(_job.Status)</Badge>
                </div>
                @if (!string.IsNullOrWhiteSpace(_job.CurrentStage))
                {
                    <p class="pos-catalog-import-job__stage">@_job.CurrentStage</p>
                }
                <dl class="pos-catalog-import-job__facts">
                    <div class="pos-catalog-import-job__fact">
                        <dt>@L["Catalog_Import_Processed"]</dt>
                        <dd>@_job.ProcessedCount / @_job.TotalCount</dd>
                    </div>
                    <div class="pos-catalog-import-job__fact">
                        <dt>@L["Catalog_Import_Imported"]</dt>
                        <dd>@_job.ImportedCount</dd>
                    </div>
                    <div class="pos-catalog-import-job__fact">
                        <dt>@L["Catalog_Import_Skipped"]</dt>
                        <dd>@_job.SkippedCount</dd>
                    </div>
                    <div class="pos-catalog-import-job__fact">
                        <dt>@L["Catalog_Import_Failed"]</dt>
                        <dd>@_job.FailedCount</dd>
                    </div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_job.ErrorSummary))
                {
                    <Alert Tone="AlertTone.Warning" Title="@L["Catalog_Import_WarningsTitle"]" Message="@_job.ErrorSummary" />
                }
                @if (!terminal)
                {
                    <div class="pos-catalog-import-job__polling">
                        <Spinner />
                        <span class="pos-muted">@L["Catalog_Import_Polling"]</span>
                    </div>
                }
                @{
                    var actionCount = 1 + (terminal ? 1 : 0) + (terminal && successTerminal ? 1 : 0);
                    var actionGridClass = actionCount >= 3
                        ? "pos-action-grid pos-action-grid--three"
                        : actionCount == 2
                            ? "pos-action-grid pos-action-grid--two"
                            : "pos-action-grid pos-action-grid--single";
                }
                <div class="@actionGridClass pos-catalog-import-job__footer" role="group">
                    <button type="button"
                            class="pos-action-tile"
                            disabled="@_loading"
                            @onclick="LoadAsync">
                        @if (_loading)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                        }
                        <span class="pos-action-tile__label">@L["Catalog_Refresh"]</span>
                    </button>
                    @if (terminal)
                    {
                        @if (successTerminal)
                        {
                            <button type="button"
                                    class="pos-action-tile pos-action-tile--primary"
                                    @onclick="GoCatalog">
                                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                                <span class="pos-action-tile__label">@L["Catalog_Import_GoToProducts"]</span>
                            </button>
                        }
                        <button type="button"
                                class="@(successTerminal ? "pos-action-tile" : "pos-action-tile pos-action-tile--primary")"
                                @onclick="GoReview">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                            <span class="pos-action-tile__label">@L["Catalog_Import_Review"]</span>
                        </button>
                    }
                </div>
            </section>
        }
        else
        {
            <Spinner />
        }
    </Page>
</div>
}

@code {
    [Parameter] public Guid JobId { get; set; }

    private bool _ready;
    private bool _canManage;
    private bool _loading;
    private bool _isOffline;
    private bool _autoNavigateScheduled;
    private PosCatalogImportJobDto? _job;
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _pollCts;
    private CancellationTokenSource? _autoNavigateCts;

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _canManage = Capabilities.IsAllowed(UtangCapability.ManageCatalog);
        _ready = true;
        if (!_canManage)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                return;
            }

            var result = await Imports.GetJobAsync(JobId);
            if (result.IsSuccess && result.Data is not null)
            {
                _job = result.Data;
                SchedulePollIfNeeded();
                ScheduleAutoNavigateIfNeeded();
            }
            else
            {
                _job = null;
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = described.Message;
                StopPolling();
            }
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void SchedulePollIfNeeded()
    {
        if (_job is null || IsTerminal(_job.Status))
        {
            StopPolling();
            return;
        }

        StopPolling();
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;
        _ = PollLoopAsync(token);
    }

    private void ScheduleAutoNavigateIfNeeded()
    {
        if (_job is null || !IsSuccessTerminal(_job.Status) || _autoNavigateScheduled)
        {
            return;
        }

        _autoNavigateScheduled = true;
        _autoNavigateCts?.Cancel();
        _autoNavigateCts = new CancellationTokenSource();
        var token = _autoNavigateCts.Token;
        _ = AutoNavigateAfterDelayAsync(token);
    }

    private async Task AutoNavigateAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(1500, token);
            await InvokeAsync(() => Nav.NavigateTo("/catalog"));
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(2000, token);
                var result = await Imports.GetJobAsync(JobId, token);
                if (!result.IsSuccess || result.Data is null)
                {
                    continue;
                }

                await InvokeAsync(() =>
                {
                    _job = result.Data;
                    ScheduleAutoNavigateIfNeeded();
                    StateHasChanged();
                });

                if (IsTerminal(result.Data.Status))
                {
                    break;
                }
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private static bool IsTerminal(string status) =>
        status is "Completed" or "CompletedWithWarnings" or "Failed" or "Cancelled";

    private static bool IsSuccessTerminal(string status) =>
        status is "Completed" or "CompletedWithWarnings";

    private string StatusLabel(string status) => status switch
    {
        "Queued" => L["Catalog_Import_Status_Queued"],
        "Processing" => L["Catalog_Import_Status_Processing"],
        "Completed" => L["Catalog_Import_Status_Completed"],
        "CompletedWithWarnings" => L["Catalog_Import_Status_CompletedWithWarnings"],
        "Failed" => L["Catalog_Import_Status_Failed"],
        "Cancelled" => L["Catalog_Import_Status_Cancelled"],
        _ => status
    };

    private static BadgeTone StatusTone(string status) => status switch
    {
        "Completed" => BadgeTone.Success,
        "CompletedWithWarnings" => BadgeTone.Warning,
        "Failed" or "Cancelled" => BadgeTone.Danger,
        "Processing" => BadgeTone.Info,
        _ => BadgeTone.Neutral
    };

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
    }

    private void GoCatalog() => Nav.NavigateTo("/catalog");
    private void GoReview() => Nav.NavigateTo($"/catalog/import/jobs/{JobId:D}/review");

    public void Dispose()
    {
        StopPolling();
        _autoNavigateCts?.Cancel();
        _autoNavigateCts?.Dispose();
    }
}

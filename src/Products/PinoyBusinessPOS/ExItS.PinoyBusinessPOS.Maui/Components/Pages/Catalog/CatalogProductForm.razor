@inject IStringLocalizer<PosResources> L

<div class="pos-product-form">
    <section class="pos-product-form__group" aria-labelledby="@_detailsId">
        <h2 class="pos-product-form__group-title" id="@_detailsId">@L["Catalog_Product_DetailsSection"]</h2>
        <div class="pos-product-form__fields">
            <TextInput Label="@L["Catalog_Field_Name"]"
                       Value="@Name"
                       ValueChanged="NameChanged"
                       Required="true"
                       IsInvalid="@(!string.IsNullOrEmpty(NameError))"
                       ErrorText="@NameError"
                       Disabled="@(IsSaving || Disabled)" />

            <TextArea Label="@L["Catalog_Field_Description"]"
                      Value="@Description"
                      ValueChanged="DescriptionChanged"
                      Hint="@L["Catalog_DescriptionHint"]"
                      Rows="2"
                      Disabled="@(IsSaving || Disabled)" />
        </div>
    </section>

    <section class="pos-product-form__group" aria-labelledby="@_codesId">
        <h2 class="pos-product-form__group-title" id="@_codesId">@L["Catalog_Product_CodesSection"]</h2>
        <div class="pos-product-form__fields">
            <TextInput Label="@L["Catalog_Field_Sku"]"
                       Value="@Sku"
                       ValueChanged="SkuChanged"
                       Hint="@L["Catalog_SkuHint"]"
                       IsInvalid="@(!string.IsNullOrEmpty(SkuError))"
                       ErrorText="@SkuError"
                       Disabled="@(IsSaving || Disabled)" />

            <TextInput Label="@L["Catalog_Field_Barcode"]"
                       Value="@Barcode"
                       ValueChanged="BarcodeChanged"
                       Hint="@L["Catalog_BarcodeHint"]"
                       IsInvalid="@(!string.IsNullOrEmpty(BarcodeError))"
                       ErrorText="@BarcodeError"
                       Disabled="@(IsSaving || Disabled)" />
        </div>
    </section>

    <section class="pos-product-form__group" aria-labelledby="@_pricingId">
        <h2 class="pos-product-form__group-title" id="@_pricingId">@L["Catalog_Product_PricingSection"]</h2>
        <div class="pos-product-form__fields">
            <Select Label="@L["Catalog_Field_Category"]"
                    Value="@CategoryId"
                    ValueChanged="CategoryIdChanged"
                    Options="@CatalogUiOptions.CategoryChoices(L, Categories)"
                    Disabled="@(IsSaving || Disabled)" />

            <Select Label="@L["Catalog_StockCountedIn"]"
                    Value="@UnitOfMeasure"
                    ValueChanged="UnitOfMeasureChanged"
                    Options="@CatalogUiOptions.UnitOfMeasures(L)"
                    Required="true"
                    Disabled="@(IsSaving || Disabled)" />

            <Select Label="@L["Catalog_HowUsed"]"
                    Value="@UsagePreset"
                    ValueChanged="UsagePresetChanged"
                    Options="@UsagePresetOptions"
                    Required="true"
                    Disabled="@(IsSaving || Disabled)" />

            @if (string.Equals(UsagePreset, "IngredientAndSellable", StringComparison.Ordinal)
                 || ShowIngredientSellable)
            {
                <Switch Checked="@IngredientAlsoSellable"
                        CheckedChanged="IngredientAlsoSellableChanged"
                        Label="@L["Catalog_IngredientAlsoSellable"]"
                        Disabled="@(IsSaving || Disabled)" />
            }

            @if (!IsBulkPreset)
            {
                <Switch Checked="@SetPackages"
                        CheckedChanged="OnSetPackagesChanged"
                        Label="@L["Catalog_SetPackages"]"
                        Disabled="@(IsSaving || Disabled)" />
            }

            @if (ShowUnitsEditor)
            {
                <div class="pos-product-form__units" aria-label="@L["Catalog_BuyingUnits"]">
                    <h3 class="pos-product-form__units-title">@L["Catalog_BuyingUnits"]</h3>
                    <p class="pos-product-form__note">@L["Catalog_BuyingUnitsHint"]</p>
                    @for (var i = 0; i < PurchaseUnits.Count; i++)
                    {
                        var index = i;
                        var draft = PurchaseUnits[index];
                        <div class="pos-product-form__unit-row">
                            <TextInput Label="@L["Catalog_UnitName"]"
                                       Value="@draft.DisplayName"
                                       ValueChanged="v => OnPurchaseNameChanged(index, v)"
                                       Required="true"
                                       Disabled="@(IsSaving || Disabled)" />
                            <TextInput Label="@L["Catalog_UnitShortLabel"]"
                                       Value="@draft.ShortLabel"
                                       ValueChanged="v => OnPurchaseShortLabelChanged(index, v)"
                                       Hint="@L["Catalog_UnitShortLabelHint"]"
                                       Disabled="@(IsSaving || Disabled)" />
                            <div class="pos-product-form__unit-contains">
                                <span class="pos-product-form__unit-contains-text">
                                    @string.Format(
                                        L["Catalog_UnitContains"].Value,
                                        string.IsNullOrWhiteSpace(draft.DisplayName) ? "—" : draft.DisplayName.Trim())
                                </span>
                                <NumberInput Label="@L["Catalog_UnitAmount"]"
                                             Value="@draft.ContainsAmount"
                                             ValueChanged="v => OnPurchaseContainsChanged(index, v)"
                                             DecimalPlaces="3"
                                             Required="true"
                                             Disabled="@(IsSaving || Disabled)" />
                                <span class="pos-product-form__unit-contains-text">@StockUnitLabel</span>
                            </div>
                            @if (PurchaseUnits.Count > 1)
                            {
                                <Button Variant="ButtonVariant.Ghost"
                                        Disabled="@(IsSaving || Disabled)"
                                        OnClick="() => RemovePurchaseUnit(index)">@L["Catalog_RemoveUnit"]</Button>
                            }
                        </div>
                    }
                    <Button Variant="ButtonVariant.Ghost"
                            Disabled="@(IsSaving || Disabled)"
                            OnClick="AddPurchaseUnit">@L["Catalog_AddBuyingUnit"]</Button>
                </div>

                <div class="pos-product-form__units" aria-label="@L["Catalog_SellingOptions"]">
                    <h3 class="pos-product-form__units-title">@L["Catalog_SellingOptions"]</h3>
                    <p class="pos-product-form__note">@L["Catalog_SellingOptionsHint"]</p>
                    @for (var i = 0; i < SellUnits.Count; i++)
                    {
                        var index = i;
                        var draft = SellUnits[index];
                        <div class="pos-product-form__unit-row">
                            <TextInput Label="@L["Catalog_UnitName"]"
                                       Value="@draft.DisplayName"
                                       ValueChanged="v => OnSellNameChanged(index, v)"
                                       Required="true"
                                       Disabled="@(IsSaving || Disabled)" />
                            <div class="pos-product-form__unit-contains">
                                <span class="pos-product-form__unit-contains-text">@L["Catalog_SellContains"]</span>
                                <NumberInput Label="@L["Catalog_UnitAmount"]"
                                             Value="@draft.ContainsAmount"
                                             ValueChanged="v => OnSellContainsChanged(index, v)"
                                             DecimalPlaces="3"
                                             Required="true"
                                             Disabled="@(IsSaving || Disabled)" />
                                <span class="pos-product-form__unit-contains-text">@StockUnitLabel</span>
                            </div>
                            <CurrencyInput Label="@L["Catalog_PriceForThisOption"]"
                                           Value="@draft.SellingPrice"
                                           ValueChanged="v => OnSellPriceChanged(index, v)"
                                           CurrencyCode="PHP"
                                           Required="true"
                                           Disabled="@(IsSaving || Disabled)" />
                            <Switch Checked="@draft.AllowsCustomQuantity"
                                    CheckedChanged="v => OnSellCustomChanged(index, v)"
                                    Label="@L["Catalog_CustomAmount"]"
                                    Disabled="@(IsSaving || Disabled)" />
                            @if (SellUnits.Count > 1)
                            {
                                <Button Variant="ButtonVariant.Ghost"
                                        Disabled="@(IsSaving || Disabled)"
                                        OnClick="() => RemoveSellUnit(index)">@L["Catalog_RemoveUnit"]</Button>
                            }
                        </div>
                    }
                    <Button Variant="ButtonVariant.Ghost"
                            Disabled="@(IsSaving || Disabled)"
                            OnClick="AddSellUnit">@L["Catalog_AddSellingOption"]</Button>
                </div>
            }

            <Select Label="@L["Catalog_Field_SellingMode"]"
                    Value="@SellingMode"
                    ValueChanged="SellingModeChanged"
                    Options="@CatalogUiOptions.SellingModes(L)"
                    Required="true"
                    Disabled="@(IsSaving || Disabled)" />

            <CurrencyInput Label="@L["Catalog_Field_SellingPrice"]"
                           Value="@SellingPrice"
                           ValueChanged="OnTopLevelPriceChanged"
                           CurrencyCode="PHP"
                           Required="true"
                           Hint="@L["Catalog_PriceHint"]"
                           IsInvalid="@(!string.IsNullOrEmpty(SellingPriceError))"
                           ErrorText="@SellingPriceError"
                           Disabled="@(IsSaving || Disabled)" />
        </div>
    </section>

    @if (ShowStockTracking)
    {
        <section class="pos-product-form__group" aria-labelledby="@_stockId">
            <h2 class="pos-product-form__group-title" id="@_stockId">@L["Catalog_Product_StockSection"]</h2>
            <div class="pos-product-form__fields">
                <Switch Checked="@TrackStock"
                        CheckedChanged="TrackStockChanged"
                        Label="@L["Catalog_TrackStock"]"
                        Disabled="@(IsSaving || Disabled)" />
                <p class="pos-product-form__note">
                    @(TrackStock ? L["Catalog_TrackStockOnHint"] : L["Catalog_TrackStockOffHint"])
                </p>
            </div>
        </section>
    }

    <section class="pos-product-form__group" aria-labelledby="@_expiryId">
        <h2 class="pos-product-form__group-title" id="@_expiryId">@L["Catalog_TrackExpiration"]</h2>
        <div class="pos-product-form__fields">
            <Switch Checked="@TracksExpiration"
                    CheckedChanged="TracksExpirationChanged"
                    Label="@L["Catalog_TrackExpiration"]"
                    Disabled="@(IsSaving || Disabled)" />
            @if (TracksExpiration)
            {
                <p class="pos-product-form__note">@L["Catalog_TrackExpirationHint"]</p>
                <TextInput Label="@L["Catalog_ExpirationWarningDays"]"
                           Value="@ExpirationWarningDaysText"
                           ValueChanged="ExpirationWarningDaysTextChanged"
                           Hint="@L["Catalog_ExpirationWarningDaysHint"]"
                           Disabled="@(IsSaving || Disabled)" />
            }
        </div>
    </section>

    <div class="pos-product-form__actions">
        <Button Variant="ButtonVariant.Secondary" Disabled="@(IsSaving || Disabled)" OnClick="OnCancel">@L["Catalog_Cancel"]</Button>
        <Button Variant="ButtonVariant.Primary" Disabled="@Disabled" IsLoading="@IsSaving" OnClick="OnSave">@SaveLabel</Button>
    </div>
</div>

@code {
    private readonly string _detailsId = $"pos-product-form-details-{Guid.NewGuid():N}";
    private readonly string _codesId = $"pos-product-form-codes-{Guid.NewGuid():N}";
    private readonly string _pricingId = $"pos-product-form-pricing-{Guid.NewGuid():N}";
    private readonly string _stockId = $"pos-product-form-stock-{Guid.NewGuid():N}";
    private readonly string _expiryId = $"pos-product-form-expiry-{Guid.NewGuid():N}";

    [Parameter] public string? Name { get; set; }
    [Parameter] public EventCallback<string?> NameChanged { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public EventCallback<string?> DescriptionChanged { get; set; }
    [Parameter] public string? Sku { get; set; }
    [Parameter] public EventCallback<string?> SkuChanged { get; set; }
    [Parameter] public string? Barcode { get; set; }
    [Parameter] public EventCallback<string?> BarcodeChanged { get; set; }
    [Parameter] public string? CategoryId { get; set; }
    [Parameter] public EventCallback<string?> CategoryIdChanged { get; set; }
    [Parameter] public string? UnitOfMeasure { get; set; }
    [Parameter] public EventCallback<string?> UnitOfMeasureChanged { get; set; }
    [Parameter] public string? UsagePreset { get; set; } = "BuyAndSell";
    [Parameter] public EventCallback<string?> UsagePresetChanged { get; set; }
    [Parameter] public bool IngredientAlsoSellable { get; set; }
    [Parameter] public EventCallback<bool> IngredientAlsoSellableChanged { get; set; }
    [Parameter] public bool ShowAdvancedUnits { get; set; }
    [Parameter] public bool SetPackages { get; set; }
    [Parameter] public EventCallback<bool> SetPackagesChanged { get; set; }
    [Parameter] public bool ShowIngredientSellable { get; set; }
    [Parameter] public IList<ProductUnitDraft> PurchaseUnits { get; set; } = new List<ProductUnitDraft>();
    [Parameter] public IList<ProductUnitDraft> SellUnits { get; set; } = new List<ProductUnitDraft>();
    [Parameter] public string? SellingMode { get; set; }
    [Parameter] public EventCallback<string?> SellingModeChanged { get; set; }
    [Parameter] public decimal? SellingPrice { get; set; }
    [Parameter] public EventCallback<decimal?> SellingPriceChanged { get; set; }
    [Parameter] public IReadOnlyList<PosProductCategoryDto> Categories { get; set; } = Array.Empty<PosProductCategoryDto>();
    [Parameter] public string? NameError { get; set; }
    [Parameter] public string? SkuError { get; set; }
    [Parameter] public string? BarcodeError { get; set; }
    [Parameter] public string? SellingPriceError { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowStockTracking { get; set; }
    [Parameter] public bool TrackStock { get; set; }
    [Parameter] public EventCallback<bool> TrackStockChanged { get; set; }
    [Parameter] public bool TracksExpiration { get; set; }
    [Parameter] public EventCallback<bool> TracksExpirationChanged { get; set; }
    [Parameter] public string? ExpirationWarningDaysText { get; set; }
    [Parameter] public EventCallback<string?> ExpirationWarningDaysTextChanged { get; set; }
    [Parameter] public string? SaveLabel { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool IsBulkPreset =>
        string.Equals(UsagePreset, "Bulk", StringComparison.Ordinal);

    private bool ShowUnitsEditor =>
        ShowAdvancedUnits || IsBulkPreset || SetPackages;

    private string StockUnitLabel =>
        CatalogUiOptions.UnitOfMeasureLabel(L, UnitOfMeasure);

    private IReadOnlyList<SelectOption> UsagePresetOptions =>
    [
        new("BuyAndSell", L["Catalog_Usage_BuyAndSell"]),
        new("Bulk", L["Catalog_Usage_Bulk"]),
        new("Ingredient", L["Catalog_Usage_Ingredient"]),
        new("MadeProduct", L["Catalog_Usage_MadeProduct"]),
        new("IngredientAndSellable", L["Catalog_Usage_IngredientAndSellable"])
    ];

    protected override void OnParametersSet()
    {
        if (ShowUnitsEditor)
        {
            ProductUnitDraft.EnsureDefaults(PurchaseUnits, SellUnits, UnitOfMeasure, SellingPrice);
        }
    }

    private async Task OnSetPackagesChanged(bool value)
    {
        if (value)
        {
            ProductUnitDraft.EnsureDefaults(PurchaseUnits, SellUnits, UnitOfMeasure, SellingPrice);
        }

        if (SetPackagesChanged.HasDelegate)
        {
            await SetPackagesChanged.InvokeAsync(value);
        }
    }

    private async Task OnTopLevelPriceChanged(decimal? value)
    {
        if (SellingPriceChanged.HasDelegate)
        {
            await SellingPriceChanged.InvokeAsync(value);
        }

        if (ShowUnitsEditor && SellUnits.Count > 0)
        {
            SellUnits[0].SellingPrice = value;
        }
    }

    private void AddPurchaseUnit()
    {
        PurchaseUnits.Add(new ProductUnitDraft { DisplayName = string.Empty, ContainsAmount = 1m });
    }

    private void RemovePurchaseUnit(int index)
    {
        if (index < 0 || index >= PurchaseUnits.Count || PurchaseUnits.Count <= 1)
        {
            return;
        }

        PurchaseUnits.RemoveAt(index);
    }

    private void AddSellUnit()
    {
        SellUnits.Add(new ProductUnitDraft
        {
            DisplayName = string.Empty,
            ContainsAmount = 1m,
            SellingPrice = SellingPrice
        });
    }

    private void RemoveSellUnit(int index)
    {
        if (index < 0 || index >= SellUnits.Count || SellUnits.Count <= 1)
        {
            return;
        }

        SellUnits.RemoveAt(index);
    }

    private void OnPurchaseNameChanged(int index, string? value)
    {
        if (index < 0 || index >= PurchaseUnits.Count)
        {
            return;
        }

        PurchaseUnits[index].DisplayName = value ?? string.Empty;
    }

    private void OnPurchaseShortLabelChanged(int index, string? value)
    {
        if (index < 0 || index >= PurchaseUnits.Count)
        {
            return;
        }

        PurchaseUnits[index].ShortLabel = value ?? string.Empty;
    }

    private void OnPurchaseContainsChanged(int index, decimal? value)
    {
        if (index < 0 || index >= PurchaseUnits.Count)
        {
            return;
        }

        PurchaseUnits[index].ContainsAmount = value;
    }

    private void OnSellNameChanged(int index, string? value)
    {
        if (index < 0 || index >= SellUnits.Count)
        {
            return;
        }

        SellUnits[index].DisplayName = value ?? string.Empty;
    }

    private void OnSellContainsChanged(int index, decimal? value)
    {
        if (index < 0 || index >= SellUnits.Count)
        {
            return;
        }

        SellUnits[index].ContainsAmount = value;
    }

    private async Task OnSellPriceChanged(int index, decimal? value)
    {
        if (index < 0 || index >= SellUnits.Count)
        {
            return;
        }

        SellUnits[index].SellingPrice = value;
        if (index == 0 && SellingPriceChanged.HasDelegate)
        {
            await SellingPriceChanged.InvokeAsync(value);
        }
    }

    private void OnSellCustomChanged(int index, bool value)
    {
        if (index < 0 || index >= SellUnits.Count)
        {
            return;
        }

        SellUnits[index].AllowsCustomQuantity = value;
    }
}

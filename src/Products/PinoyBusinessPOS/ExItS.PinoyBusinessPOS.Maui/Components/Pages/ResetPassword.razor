@page "/reset-password"
@layout Layout.AuthShell
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<AuthExperience Title="@L["ForgotPassword_Title"]" Lede="@L["Activate_Subtitle"]">
    <FormValidationSummary Messages="_errors" />
    <LocalValidationMailpitHint />

    <div class="pos-signin__form">
        <TextInput Label="@L["Activate_Token"]" @bind-Value="_token" Disabled="_busy" IsInvalid="@_invalid" />
        <TextInput Label="@L["Activate_Password"]" @bind-Value="_password" Type="password" Disabled="_busy" IsInvalid="@_invalid" autocomplete="new-password" />
        <TextInput Label="@L["Activate_ConfirmPassword"]" @bind-Value="_confirm" Type="password" Disabled="_busy" IsInvalid="@_invalid" autocomplete="new-password" />

        <div class="pos-signin__submit">
            <Button IsLoading="_busy" Disabled="_busy" OnClick="ResetAsync">@L["Activate_Submit"]</Button>
        </div>
        <p class="pos-signin__create">
            <button type="button" class="pos-signin__link" disabled="@_busy" @onclick="GoSignIn">
                @L["ForgotPassword_Back"]
            </button>
        </p>
    </div>
</AuthExperience>

@code {
    [SupplyParameterFromQuery] public string? token { get; set; }

    private string? _token;
    private string? _password;
    private string? _confirm;
    private bool _busy;
    private bool _invalid;
    private List<string> _errors = [];

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(token) && string.IsNullOrWhiteSpace(_token))
        {
            _token = token;
        }
    }

    private async Task ResetAsync()
    {
        _errors = [];
        _invalid = false;
        if (string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_password))
        {
            _invalid = true;
            _errors.Add(L["Activate_ValidationRequired"]);
            return;
        }

        if (!string.Equals(_password, _confirm, StringComparison.Ordinal))
        {
            _invalid = true;
            _errors.Add(L["Activate_PasswordMismatch"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.ResetPasswordAsync(
                new ResetPasswordRequest(_token.Trim(), _password));
            if (!result.IsSuccess)
            {
                _invalid = true;
                _errors.Add(result.Error?.Detail ?? L["ForgotPassword_Failed"]);
                return;
            }

            Nav.NavigateTo("/signin");
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

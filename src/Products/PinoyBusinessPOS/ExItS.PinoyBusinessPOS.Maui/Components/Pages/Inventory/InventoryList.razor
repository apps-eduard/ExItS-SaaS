@page "/inventory"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject ICurrentUserContext CurrentUser
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_allowed)
{
    <Page>
        <ErrorState Title="@L["Access_RestrictedTitle"]"
                    Message="@L["Access_RestrictedMessage"]"
                    RetryLabel="@L["Nav_Home"]"
                    OnRetry="GoHomeAsync" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageInventory);
<div class="pos-inventory">
    <Page>
        <header class="pos-inventory__header">
            <h1 class="pos-inventory__title">@L["Inventory_Title"]</h1>
            <p class="pos-inventory__subtitle">@L["Inventory_Subtitle"]</p>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
        }

        <div class="pos-action-grid pos-action-grid--three pos-inventory__actions" role="group" aria-label="@L["Inventory_Title"]">
            <button type="button"
                    class="pos-action-tile"
                    disabled="@_isOffline"
                    @onclick="GoLowStock">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                <span class="pos-action-tile__label">@L["Inventory_OpenLowStock"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(!canManage || _isOffline)"
                    @onclick="GoCounts">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                <span class="pos-action-tile__label">@L["Inventory_OpenCounts"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(_loading || _isOffline)"
                    @onclick="ReloadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Inventory_Refresh"]</span>
            </button>
        </div>

        <div class="pos-inventory__toolbar">
            <div class="pos-inventory__search">
                <span class="pos-inventory__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                <input class="pos-inventory__search-input"
                       type="search"
                       value="@_search"
                       placeholder="@L["Inventory_SearchPlaceholder"]"
                       disabled="@(_loading || _isOffline)"
                       @oninput="OnSearchInputAsync" />
            </div>
        </div>

        <section class="pos-inventory__panel" aria-labelledby="inventory-list-heading">
            <h2 id="inventory-list-heading" class="pos-inventory__section-title">@L["Inventory_ListSection"]</h2>
            @if (_loading)
            {
                <div class="pos-inventory__loading"><Spinner /><span>@L["Inventory_Loading"]</span></div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Inventory_Title"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="products"
                            Title="@L["Inventory_EmptyTitle"]"
                            Message="@L["Inventory_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-inventory__list" role="list" aria-label="@L["Inventory_Title"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-inventory__row @(item.IsLowStock ? "pos-inventory__row--low" : null)"
                           role="listitem"
                           href="@($"/inventory/{item.ProductId:D}")">
                            <div class="pos-inventory__row-main">
                                <div class="pos-inventory__row-top">
                                    <span class="pos-inventory__row-name">@item.Name</span>
                                    <div class="pos-inventory__row-badges">
                                        <Badge Tone="@(item.ProductStatus == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">
                                            @item.ProductStatus
                                        </Badge>
                                        @if (item.IsTracked)
                                        {
                                            <Badge Tone="@StockBadgeTone(item)">@StockStatusLabel(item)</Badge>
                                        }
                                    </div>
                                </div>
                                <span class="pos-inventory__row-meta">
                                    @item.UnitOfMeasure
                                    ·
                                    @(item.IsTracked ? L["Inventory_Tracked"] : L["Inventory_NotTracked"])
                                    @if (item.IsTracked && item.ReorderLevel is not null)
                                    {
                                        <text> · @L["Inventory_ReorderLevel"] @item.ReorderLevel.Value.ToString("0.###", CultureInfo.InvariantCulture)</text>
                                    }
                                </span>
                            </div>
                            <div class="pos-inventory__row-side">
                                <span class="pos-inventory__on-hand">@item.OnHandQuantity.ToString("0.###", CultureInfo.InvariantCulture)</span>
                                <span class="pos-inventory__on-hand-label">@L["Inventory_OnHand"]</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>

        @if (!_loading && _totalCount > 0)
        {
            <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _allowed;
    private bool _loading;
    private bool _isOffline;
    private string _search = string.Empty;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosInventoryAccountDto> _items = Array.Empty<PosInventoryAccountDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _allowed = Capabilities.IsAllowed(UtangCapability.ViewInventory);
        _ready = true;
        if (_allowed)
        {
            await ReloadAsync();
        }
    }

    private async Task GoHomeAsync() => Nav.NavigateTo(await Gate.ResolveStartRouteAsync());

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosInventoryAccountDto>();
            _totalCount = 0;
            _loading = false;
            return;
        }

        var result = await Inventory.ListAsync(
            search: string.IsNullOrWhiteSpace(_search) ? null : _search,
            page: _page,
            pageSize: _pageSize);
        if (result.Status == ApiCallStatus.Success && result.Data is not null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            _items = Array.Empty<PosInventoryAccountDto>();
            _totalCount = 0;
        }

        _loading = false;
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
            // Newer keystroke superseded this search.
        }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private void GoLowStock() => Nav.NavigateTo("/inventory/low-stock");
    private void GoCounts() => Nav.NavigateTo("/inventory/counts");

    private static BadgeTone StockBadgeTone(PosInventoryAccountDto item) =>
        item.StockStatus switch
        {
            "OutOfStock" => BadgeTone.Danger,
            "LowStock" => BadgeTone.Warning,
            _ => BadgeTone.Success
        };

    private string StockStatusLabel(PosInventoryAccountDto item) =>
        item.StockStatus switch
        {
            "OutOfStock" => L["Inventory_StockStatus_OutOfStock"],
            "LowStock" => L["Inventory_StockStatus_LowStock"],
            _ => L["Inventory_StockStatus_InStock"]
        };
}

@page "/inventory"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject ICurrentUserContext CurrentUser
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageInventory);
<Page>
    <PageHeader Title="@L["Inventory_Title"]" Subtitle="@L["Inventory_Subtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoLowStock">@L["Inventory_OpenLowStock"]</Button>
            @if (canManage)
            {
                <Button Variant="ButtonVariant.Secondary" OnClick="GoCounts">@L["Inventory_OpenCounts"]</Button>
            }
            <Button Variant="ButtonVariant.Secondary" IsLoading="@_loading" OnClick="ReloadAsync">@L["Inventory_Refresh"]</Button>
        </Actions>
    </PageHeader>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
    }

    <SearchToolbar SearchText="@_search" SearchTextChanged="OnSearchChanged" Placeholder="@L["Inventory_SearchPlaceholder"]" />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Inventory_Title"])" Message="@_errorMessage" />
    }

    <ResponsiveDataList TItem="PosInventoryAccountDto"
                        Items="@_items"
                        Columns="@Columns"
                        CellTemplate="@CellTemplate"
                        IsLoading="@_loading"
                        LoadingLabel="@L["Inventory_Loading"]"
                        EmptyTitle="@L["Inventory_EmptyTitle"]"
                        EmptyMessage="@L["Inventory_EmptyMessage"]"
                        ErrorTitle="@_errorTitle"
                        ErrorMessage="@_errorMessage"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="ReloadAsync"
                        AriaLabel="@L["Inventory_Title"]" />

    @if (!_loading && _totalCount > 0)
    {
        <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
    }
</Page>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private string _search = string.Empty;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosInventoryAccountDto> _items = Array.Empty<PosInventoryAccountDto>();
    private string? _errorTitle;
    private string? _errorMessage;

    private IReadOnlyList<DataColumnDefinition> Columns =>
    [
        new("name", L["Catalog_Col_Name"], Primary: true, Width: "36%"),
        new("onHand", L["Inventory_OnHand"], Width: "22%"),
        new("tracked", L["Inventory_Tracked"], Width: "22%"),
        new("status", L["Catalog_Filter_Status"], Width: "20%")
    ];

    private RenderFragment<(PosInventoryAccountDto Item, DataColumnDefinition Column)> CellTemplate => context => builder =>
    {
        switch (context.Column.Key)
        {
            case "name":
                builder.OpenElement(0, "a");
                builder.AddAttribute(1, "class", "pos-link");
                builder.AddAttribute(2, "href", $"/inventory/{context.Item.ProductId:D}");
                builder.AddContent(3, context.Item.Name);
                builder.CloseElement();
                break;
            case "onHand":
                builder.AddContent(0, context.Item.OnHandQuantity.ToString("0.###", CultureInfo.InvariantCulture));
                break;
            case "tracked":
                builder.AddContent(0, context.Item.IsTracked ? L["Inventory_Tracked"].Value : L["Inventory_NotTracked"].Value);
                break;
            default:
                builder.AddContent(0, context.Item.ProductStatus);
                break;
        }
    };

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewInventory))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosInventoryAccountDto>();
            _totalCount = 0;
            _loading = false;
            return;
        }

        var result = await Inventory.ListAsync(
            search: string.IsNullOrWhiteSpace(_search) ? null : _search,
            page: _page,
            pageSize: _pageSize);
        if (result.Status == ApiCallStatus.Success && result.Data is not null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            _items = Array.Empty<PosInventoryAccountDto>();
            _totalCount = 0;
        }

        _loading = false;
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private void GoLowStock() => Nav.NavigateTo("/inventory/low-stock");
    private void GoCounts() => Nav.NavigateTo("/inventory/counts");
}

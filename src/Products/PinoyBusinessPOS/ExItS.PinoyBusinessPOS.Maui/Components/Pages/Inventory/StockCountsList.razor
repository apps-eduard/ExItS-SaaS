@page "/inventory/counts"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageInventory);
<div class="pos-stock-counts">
    <Page>
        <PageHeader Title="@L["Inventory_CountsTitle"]" Subtitle="@L["Inventory_CountsSubtitle"]" />

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
        }

        <div class="pos-action-grid pos-action-grid--three pos-stock-counts__actions" role="group" aria-label="@L["Inventory_CountsTitle"]">
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(!canManage || _isOffline)"
                    @onclick="GoNew">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span class="pos-action-tile__label">@L["Inventory_CountsAdd"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    @onclick="GoInventory">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["Inventory_Title"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(_loading || _isOffline)"
                    @onclick="ReloadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Inventory_Refresh"]</span>
            </button>
        </div>

        <Section Title="@L["Inventory_CountsTitle"]">
            @if (_loading)
            {
                <Stack Align="StackAlign.Center" Gap="2">
                    <Spinner />
                    <span class="pos-muted">@L["Inventory_Loading"]</span>
                </Stack>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Inventory_CountsTitle"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="check"
                            Title="@L["Inventory_CountsEmptyTitle"]"
                            Message="@L["Inventory_CountsEmptyMessage"]" />
            }
            else
            {
                <div class="pos-stock-counts__list" role="list" aria-label="@L["Inventory_CountsTitle"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-stock-counts__row"
                           role="listitem"
                           href="@($"/inventory/counts/{item.StockCountId:D}")">
                            <div class="pos-stock-counts__row-main">
                                <span class="pos-stock-counts__row-name">
                                    @(item.CountNumber ?? L["Inventory_CountsDraft"])
                                </span>
                                <span class="pos-stock-counts__row-meta">
                                    @item.Status
                                    · @item.UpdatedAtUtc.UtcDateTime.ToString("u")
                                </span>
                            </div>
                            <div class="pos-stock-counts__row-side">
                                <span class="pos-stock-counts__view">@L["Customers_View"]</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </Section>
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private string? _errorTitle;
    private string? _errorMessage;
    private IReadOnlyList<PosStockCountDto> _items = Array.Empty<PosStockCountDto>();

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewInventory))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        _ready = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _errorTitle = null;
        _errorMessage = null;

        if (_isOffline)
        {
            _items = Array.Empty<PosStockCountDto>();
            return;
        }

        _loading = true;
        try
        {
            var result = await Inventory.ListStockCountsAsync();
            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
            }
            else
            {
                _items = Array.Empty<PosStockCountDto>();
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoNew() => Nav.NavigateTo("/inventory/counts/new");
    private void GoInventory() => Nav.NavigateTo("/inventory");
}

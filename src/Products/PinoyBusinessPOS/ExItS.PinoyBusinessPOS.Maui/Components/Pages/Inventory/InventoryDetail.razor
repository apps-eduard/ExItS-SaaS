@page "/inventory/{ProductId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/inventory" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_account is null)
{
    <Page>
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Inventory_DetailTitle"])" Message="@(_errorMessage ?? L["NotFound_Message"])" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageInventory);
    var manageOnline = canManage && !_isOffline;
<div class="pos-inventory-detail">
<Page>
    <header class="pos-inventory-detail__header">
        <h1 class="pos-inventory-detail__title">@_account.Name</h1>
        <p class="pos-inventory-detail__subtitle">@L["Inventory_DetailTitle"]</p>
        <div class="pos-inventory-detail__status-row">
            <Badge Tone="@StatusTone(_account)">@StatusLabel(_account)</Badge>
            <Badge Tone="@(_account.IsTracked ? BadgeTone.Success : BadgeTone.Neutral)">
                @(_account.IsTracked ? L["Inventory_Tracked"] : L["Inventory_NotTracked"])
            </Badge>
        </div>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Inventory_DetailTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-inventory-detail__panel" aria-labelledby="inventory-detail-heading">
        <h2 id="inventory-detail-heading" class="pos-inventory-detail__section-title">@L["Inventory_DetailTitle"]</h2>
        <div class="pos-inventory-detail__amount">
            <span class="pos-inventory-detail__amount-label">@L["Inventory_OnHand"]</span>
            <div class="pos-inventory-detail__amount-value">
                @_account.OnHandQuantity.ToString("0.###") @_account.UnitOfMeasure
            </div>
        </div>
        <dl class="pos-inventory-detail__facts">
            <div class="pos-inventory-detail__fact">
                <dt>@L["Inventory_ReorderLevel"]</dt>
                <dd>@(_account.ReorderLevel?.ToString("0.###") ?? "—")</dd>
            </div>
            <div class="pos-inventory-detail__fact">
                <dt>@L["Inventory_ReorderQuantity"]</dt>
                <dd>@(_account.ReorderQuantity?.ToString("0.###") ?? "—")</dd>
            </div>
            <div class="pos-inventory-detail__fact">
                <dt>@L["Inventory_StockStatus"]</dt>
                <dd>@StatusLabel(_account)</dd>
            </div>
        </dl>
        @if (_account.IsLowStock)
        {
            <p class="pos-inventory-detail__note">@L["Inventory_LowStockSubtitle"]</p>
        }
    </section>

    @if (manageOnline)
    {
        @if (!_account.IsTracked)
        {
            <div class="pos-action-grid pos-action-grid--single pos-inventory-detail__actions" role="group">
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@_busy"
                        @onclick="EnableAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                    <span class="pos-action-tile__label">@L["Inventory_Enable"]</span>
                </button>
            </div>
        }
        else
        {
            <div class="pos-action-grid pos-action-grid--three pos-inventory-detail__actions" role="group">
                <button type="button"
                        class="pos-action-tile"
                        disabled="@_busy"
                        @onclick="GoAdjust">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("edit")</span>
                    <span class="pos-action-tile__label">@L["Inventory_Adjust"]</span>
                </button>
                <button type="button"
                        class="pos-action-tile"
                        disabled="@_busy"
                        @onclick="GoReorder">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                    <span class="pos-action-tile__label">@L["Inventory_ReorderTitle"]</span>
                </button>
                <button type="button"
                        class="pos-action-tile"
                        disabled="@_busy"
                        @onclick="DisableAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                    <span class="pos-action-tile__label">@L["Inventory_Disable"]</span>
                </button>
            </div>
        }
    }

    <section class="pos-inventory-detail__panel" aria-labelledby="inventory-movements-heading">
        <h2 id="inventory-movements-heading" class="pos-inventory-detail__section-title">@L["Inventory_Movements"]</h2>
        @if (_movements.Count == 0)
        {
            <p class="pos-inventory-detail__empty">—</p>
        }
        else
        {
            <div class="pos-inventory-detail__list" role="list">
                @foreach (var m in _movements)
                {
                    <div class="pos-inventory-detail__entry" role="listitem">
                        <div class="pos-inventory-detail__entry-top">
                            <span class="pos-inventory-detail__entry-name">@m.MovementType</span>
                            <span class="pos-inventory-detail__entry-amount">@m.QuantityEffect.ToString("+0.###;-0.###")</span>
                        </div>
                        <p class="pos-inventory-detail__entry-meta">
                            @m.RecordedAtUtc.UtcDateTime.ToString("u")
                            @if (!string.IsNullOrWhiteSpace(m.Reason))
                            {
                                <text> · @m.Reason</text>
                            }
                        </p>
                    </div>
                }
            </div>
        }
    </section>
</Page>
</div>
}

@code {
    [Parameter] public Guid ProductId { get; set; }

    private bool _ready;
    private bool _busy;
    private bool _isOffline;
    private PosInventoryAccountDto? _account;
    private List<PosStockMovementDto> _movements = [];
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewInventory))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private static BadgeTone StatusTone(PosInventoryAccountDto account) =>
        account.StockStatus switch
        {
            "OutOfStock" => BadgeTone.Danger,
            "LowStock" => BadgeTone.Warning,
            _ => BadgeTone.Success
        };

    private string StatusLabel(PosInventoryAccountDto account) =>
        account.StockStatus switch
        {
            "OutOfStock" => L["Inventory_StockStatus_OutOfStock"],
            "LowStock" => L["Inventory_StockStatus_LowStock"],
            _ => L["Inventory_StockStatus_InStock"]
        };

    private async Task ReloadAsync()
    {
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _account = null;
            return;
        }

        var result = await Inventory.GetAsync(ProductId);
        if (result.Status == ApiCallStatus.Success)
        {
            _account = result.Data;
        }
        else
        {
            _account = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            return;
        }

        var movements = await Inventory.ListMovementsAsync(ProductId);
        _movements = movements.Status == ApiCallStatus.Success && movements.Data is not null
            ? movements.Data.Items
            : [];
    }

    private async Task EnableAsync()
    {
        _busy = true;
        var result = await Inventory.EnableAsync(ProductId, new EnableInventoryTrackingRequest());
        _busy = false;
        if (result.Status == ApiCallStatus.Success)
        {
            await ReloadAsync();
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }

    private async Task DisableAsync()
    {
        _busy = true;
        var result = await Inventory.DisableAsync(ProductId);
        _busy = false;
        if (result.Status == ApiCallStatus.Success)
        {
            await ReloadAsync();
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }

    private void GoAdjust() => Nav.NavigateTo($"/inventory/{ProductId:D}/adjust");
    private void GoReorder() => Nav.NavigateTo($"/inventory/{ProductId:D}/reorder");
}

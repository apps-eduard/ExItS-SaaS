@page "/inventory/low-stock"
@using System.Globalization
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-low-stock">
    <Page>
        <PageHeader Title="@L["Inventory_LowStockTitle"]" Subtitle="@L["Inventory_LowStockSubtitle"]" />

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
        }

        <div class="pos-action-grid pos-action-grid--two pos-low-stock__actions" role="group" aria-label="@L["Inventory_LowStockTitle"]">
            <button type="button"
                    class="pos-action-tile"
                    @onclick="GoInventory">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["Inventory_Title"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(_loading || _isOffline)"
                    @onclick="ReloadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Inventory_Refresh"]</span>
            </button>
        </div>

        <Section Title="@L["Inventory_LowStockTitle"]">
            @if (_loading)
            {
                <Stack Align="StackAlign.Center" Gap="2">
                    <Spinner />
                    <span class="pos-muted">@L["Inventory_Loading"]</span>
                </Stack>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Inventory_LowStockTitle"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="warning"
                            Title="@L["Inventory_LowStockEmptyTitle"]"
                            Message="@L["Inventory_LowStockEmptyMessage"]" />
            }
            else
            {
                <div class="pos-low-stock__list" role="list" aria-label="@L["Inventory_LowStockTitle"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-inventory__row pos-inventory__row--low"
                           role="listitem"
                           href="@($"/inventory/{item.ProductId:D}")">
                            <div class="pos-inventory__row-main">
                                <span class="pos-inventory__row-name">@item.Name</span>
                                <span class="pos-inventory__row-meta">
                                    @item.UnitOfMeasure
                                    · @L["Inventory_ReorderLevel"]
                                    @(item.ReorderLevel?.ToString("0.###", CultureInfo.InvariantCulture) ?? "—")
                                </span>
                                <div class="pos-inventory__row-badges">
                                    <Badge Tone="BadgeTone.Warning">@L["Inventory_StockStatus_LowStock"]</Badge>
                                </div>
                            </div>
                            <div class="pos-inventory__row-side">
                                <span class="pos-inventory__on-hand">@item.OnHandQuantity.ToString("0.###", CultureInfo.InvariantCulture)</span>
                                <span class="pos-inventory__on-hand-label">@L["Inventory_OnHand"]</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </Section>
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private IReadOnlyList<PosInventoryAccountDto> _items = Array.Empty<PosInventoryAccountDto>();
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewInventory))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosInventoryAccountDto>();
            _loading = false;
            return;
        }

        var result = await Inventory.ListLowStockAsync();
        if (result.Status == ApiCallStatus.Success && result.Data is not null)
        {
            _items = result.Data.Items;
        }
        else
        {
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            _items = Array.Empty<PosInventoryAccountDto>();
        }

        _loading = false;
    }

    private void GoInventory() => Nav.NavigateTo("/inventory");
}

@page "/inventory/counts/new"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/inventory/counts" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var blocked = _isOffline || _busy;
    var hasDraft = HasUnsavedDraft;
    var eligible = EligibleProducts;
<div class="pos-stock-count-create">
    <Page>
        <header class="pos-stock-count-create__header">
            <div class="pos-stock-count-create__heading">
                <h1 class="pos-stock-count-create__title">@L["Inventory_CountsCreateTitle"]</h1>
                <p class="pos-stock-count-create__subtitle">@L["Inventory_CountsSubtitle"]</p>
            </div>
            <button type="button"
                    class="pos-stock-count-create__reset"
                    disabled="@(_busy || !hasDraft)"
                    title="@L["Inventory_CountsReset"]"
                    aria-label="@L["Inventory_CountsReset"]"
                    @onclick="RequestReset">
                <span aria-hidden="true">@IconGlyphs.Get("refresh")</span>
            </button>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Inventory_CountsCreateTitle"])" Message="@_errorMessage" />
        }

        <section class="pos-stock-count-create__panel" aria-labelledby="stock-count-title-heading">
            <h2 id="stock-count-title-heading" class="pos-stock-count-create__section-title">@L["Inventory_CountsTitleField"]</h2>
            <div class="pos-stock-count-create__form">
                <Select Label="@L["Inventory_CountsTitleField"]"
                        Value="@_titlePreset"
                        ValueChanged="OnTitlePresetChanged"
                        Options="@TitlePresetOptions"
                        Required="true"
                        Disabled="@blocked" />
                @if (IsCustomTitle)
                {
                    <TextInput Label="@L["Inventory_CountsCustomTitle"]"
                               Value="@_customTitle"
                               ValueChanged="v => _customTitle = v"
                               Disabled="@blocked"
                               Required="true"
                               Hint="@L["Inventory_CountsCustomTitleHint"]" />
                }
            </div>
        </section>

        <section class="pos-stock-count-create__panel" aria-labelledby="stock-count-product-heading">
            <h2 id="stock-count-product-heading" class="pos-stock-count-create__section-title">@L["Inventory_CountsProducts"]</h2>
            @if (eligible.Count == 0 && string.IsNullOrEmpty(_errorMessage) && !_isOffline)
            {
                <InlineMessage Tone="InlineMessageTone.Warning">@L["Inventory_CountsNoTrackedMessage"]</InlineMessage>
                <button type="button"
                        class="pos-stock-count-create__inventory-link"
                        disabled="@blocked"
                        @onclick="GoInventory">
                    @L["Inventory_CountsOpenInventory"]
                </button>
            }
            else
            {
                <p class="pos-stock-count-create__hint">@L["Inventory_CountsTrackedOnlyHint"]</p>
                <div class="pos-stock-count-create__bulk" role="group" aria-label="@L["Inventory_CountsProducts"]">
                    <Button Variant="ButtonVariant.Secondary"
                            Disabled="@(blocked || eligible.Count == 0)"
                            OnClick="SelectAll">
                        @L["Inventory_CountsSelectAll"]
                    </Button>
                    <Button Variant="ButtonVariant.Ghost"
                            Disabled="@(blocked || _selectedProductIds.Count == 0)"
                            OnClick="ClearAll">
                        @L["Inventory_CountsClearAll"]
                    </Button>
                </div>
                <div class="pos-stock-count-create__summary pos-muted">
                    @L["Inventory_CountsSelectedCount", _selectedProductIds.Count]
                </div>
                <div class="pos-stock-count-create__products" role="list">
                    @foreach (var product in eligible)
                    {
                        var selected = _selectedProductIds.Contains(product.ProductId);
                        <div class="pos-stock-count-create__product" role="listitem">
                            <Checkbox Value="@selected"
                                      ValueChanged="v => SetProductSelected(product.ProductId, v)"
                                      Disabled="@blocked">
                                @product.Name
                            </Checkbox>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="pos-stock-count-create__panel" aria-labelledby="stock-count-notes-heading">
            <h2 id="stock-count-notes-heading" class="pos-stock-count-create__section-title">@L["Inventory_CountsNotes"]</h2>
            <div class="pos-stock-count-create__form">
                <TextInput Value="@_notes"
                           ValueChanged="v => _notes = v"
                           Disabled="@blocked"
                           Hint="@L["Inventory_CountsNotesHint"]" />
            </div>
        </section>

        <FormActions class="pos-stock-count-create__footer">
            <Button Variant="ButtonVariant.Ghost" Disabled="@(_busy || !hasDraft)" OnClick="RequestReset">
                <span class="pos-btn-icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                @L["Inventory_CountsReset"]
            </Button>
            <Button Variant="ButtonVariant.Primary"
                    IsLoading="@_busy"
                    Disabled="@(blocked || _selectedProductIds.Count == 0 || !HasResolvedTitle)"
                    OnClick="CreateAsync">
                <span class="pos-btn-icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                @L["Inventory_CountsCreate"]
            </Button>
        </FormActions>

        <ConfirmDialog Visible="@_confirmReset"
                       VisibleChanged="v => _confirmReset = v"
                       Title="@L["Inventory_CountsResetTitle"]"
                       Message="@L["Inventory_CountsResetMessage"]"
                       ConfirmLabel="@L["Inventory_CountsReset"]"
                       Danger="true"
                       OnConfirm="ConfirmReset"
                       OnCancel="() => _confirmReset = false" />
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _busy;
    private bool _isOffline;
    private bool _confirmReset;
    private string _titlePreset = StockCountDisplay.PresetTitles[0];
    private string _customTitle = string.Empty;
    private string _notes = string.Empty;
    private readonly HashSet<Guid> _selectedProductIds = [];
    private List<PosInventoryAccountDto> _products = [];
    private string? _errorTitle;
    private string? _errorMessage;

    private bool IsCustomTitle =>
        string.Equals(_titlePreset, StockCountDisplay.CustomPresetValue, StringComparison.Ordinal);

    private bool HasResolvedTitle =>
        !string.IsNullOrWhiteSpace(ResolveTitle());

    private IReadOnlyList<SelectOption> TitlePresetOptions =>
        InventoryUiOptions.StockCountTitleOptions(L);

    private IReadOnlyList<PosInventoryAccountDto> EligibleProducts =>
        _products
            .Where(p => p.IsTracked)
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool HasUnsavedDraft =>
        _selectedProductIds.Count > 0
        || !string.IsNullOrWhiteSpace(_notes)
        || !string.Equals(_titlePreset, StockCountDisplay.PresetTitles[0], StringComparison.Ordinal)
        || !string.IsNullOrWhiteSpace(_customTitle);

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ManageInventory))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            return;
        }

        var products = await Inventory.ListAsync(
            tracked: true,
            productStatus: "Active",
            page: 1,
            pageSize: 200);
        if (products.IsSuccess && products.Data is not null)
        {
            _products = products.Data.Items
                .Where(p => p.IsTracked)
                .ToList();
        }
        else
        {
            var described = ApiLocalizer.Describe(products.Status, products.Error);
            _errorTitle = described.Title;
            _errorMessage = products.Error?.Detail ?? described.Message;
        }
    }

    private void OnTitlePresetChanged(string? value) =>
        _titlePreset = string.IsNullOrWhiteSpace(value)
            ? StockCountDisplay.PresetTitles[0]
            : value;

    private void SetProductSelected(Guid productId, bool selected)
    {
        if (selected)
        {
            _selectedProductIds.Add(productId);
        }
        else
        {
            _selectedProductIds.Remove(productId);
        }
    }

    private void SelectAll()
    {
        foreach (var product in EligibleProducts)
        {
            _selectedProductIds.Add(product.ProductId);
        }
    }

    private void ClearAll() => _selectedProductIds.Clear();

    private void GoInventory() => Nav.NavigateTo("/inventory");

    private void RequestReset()
    {
        if (!HasUnsavedDraft)
        {
            return;
        }

        _confirmReset = true;
    }

    private void ConfirmReset()
    {
        _confirmReset = false;
        _titlePreset = StockCountDisplay.PresetTitles[0];
        _customTitle = string.Empty;
        _notes = string.Empty;
        _selectedProductIds.Clear();
        _errorTitle = null;
        _errorMessage = null;
    }

    private string? ResolveTitle()
    {
        if (IsCustomTitle)
        {
            return string.IsNullOrWhiteSpace(_customTitle) ? null : _customTitle.Trim();
        }

        return _titlePreset.Trim();
    }

    private async Task CreateAsync()
    {
        if (_busy || _isOffline || _selectedProductIds.Count == 0)
        {
            return;
        }

        var title = ResolveTitle();
        if (string.IsNullOrWhiteSpace(title))
        {
            _errorTitle = L["Inventory_CountsCreateTitle"];
            _errorMessage = L["Inventory_CountsTitleRequired"];
            return;
        }

        _busy = true;
        _errorTitle = null;
        _errorMessage = null;

        // Distinct Guids prevent duplicate count lines even if selection state is corrupted.
        var productIds = _selectedProductIds.Distinct().ToList();
        var request = new CreateStockCountRequest(
            productIds.Select(id => new CreateStockCountLineRequest(id)).ToList(),
            title,
            Notes: string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim());
        var result = await Inventory.CreateStockCountAsync(request);
        _busy = false;
        if (result.Status == ApiCallStatus.Success && result.Data is not null)
        {
            Nav.NavigateTo($"/inventory/counts/{result.Data.StockCountId:D}");
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }
}

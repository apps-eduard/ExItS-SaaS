@page "/inventory/counts/{StockCountId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosInventoryClient Inventory
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/inventory/counts" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_count is null)
{
    <Page>
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Inventory_CountsTitle"])" Message="@(_errorMessage ?? L["NotFound_Message"])" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageInventory);
    var inProgress = string.Equals(_count.Status, "InProgress", StringComparison.OrdinalIgnoreCase);
    var draft = string.Equals(_count.Status, "Draft", StringComparison.OrdinalIgnoreCase);
    var manageOnline = canManage && !_isOffline;
<div class="pos-stock-count-detail">
<Page>
    <header class="pos-stock-count-detail__header">
        <h1 class="pos-stock-count-detail__title">@(_count.CountNumber ?? L["Inventory_CountsDraft"])</h1>
        <p class="pos-stock-count-detail__subtitle">@L["Inventory_CountsTitle"]</p>
        <div class="pos-stock-count-detail__status-row">
            <Badge Tone="@StatusTone(_count.Status)">@_count.Status</Badge>
        </div>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Inventory_CountsTitle"])" Message="@_errorMessage" />
    }

    @if (manageOnline && (draft || inProgress))
    {
        <div class="pos-action-grid pos-action-grid--two pos-stock-count-detail__actions"
             role="group">
            @if (draft)
            {
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@_busy"
                        @onclick="StartAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                    <span class="pos-action-tile__label">@L["Inventory_CountsStart"]</span>
                </button>
            }
            @if (inProgress)
            {
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@_busy"
                        @onclick="CompleteAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                    <span class="pos-action-tile__label">@L["Inventory_CountsComplete"]</span>
                </button>
            }
            <button type="button"
                    class="pos-action-tile"
                    disabled="@_busy"
                    @onclick="CancelAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                <span class="pos-action-tile__label">@L["Inventory_CountsCancel"]</span>
            </button>
        </div>
    }

    <section class="pos-stock-count-detail__panel" aria-labelledby="stock-count-lines-heading">
        <h2 id="stock-count-lines-heading" class="pos-stock-count-detail__section-title">@L["Inventory_CountsLines"]</h2>
        @if (_count.Lines.Count == 0)
        {
            <p class="pos-stock-count-detail__empty">—</p>
        }
        else
        {
            <div class="pos-stock-count-detail__list" role="list">
                @foreach (var line in _count.Lines)
                {
                    <div class="pos-stock-count-detail__entry" role="listitem">
                        <div class="pos-stock-count-detail__entry-top">
                            <span class="pos-stock-count-detail__entry-name">@line.ProductName</span>
                        </div>
                        <p class="pos-stock-count-detail__entry-meta">
                            @L["Inventory_OnHand"]: @(line.SystemOnHandSnapshot?.ToString("0.###") ?? "—")
                            @if (!inProgress && line.CountedQuantity is not null)
                            {
                                <text>
                                    · @L["Inventory_CountsCounted"]: @line.CountedQuantity.Value.ToString("0.###")
                                    · @L["Inventory_CountsVariance"]: @(line.Variance?.ToString("+0.###;-0.###") ?? "—")
                                </text>
                            }
                        </p>
                        @if (inProgress && canManage)
                        {
                            <div class="pos-stock-count-detail__line-form">
                                <TextInput Label="@L["Inventory_CountsCounted"]"
                                           Value="@GetCountedText(line.LineId)"
                                           ValueChanged="v => SetCountedText(line.LineId, v)"
                                           Disabled="@(_isOffline || _busy)" />
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (inProgress && canManage)
        {
            <div class="pos-stock-count-detail__save">
                <Button Variant="ButtonVariant.Secondary"
                        Disabled="@(_isOffline || _busy)"
                        IsLoading="@_busy"
                        OnClick="SaveLinesAsync">@L["Inventory_CountsSaveLines"]</Button>
            </div>
        }
    </section>
</Page>
</div>
}

@code {
    [Parameter] public Guid StockCountId { get; set; }

    private bool _ready;
    private bool _busy;
    private bool _isOffline;
    private PosStockCountDto? _count;
    private readonly Dictionary<Guid, string> _countedByLine = new();
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ViewInventory))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private static BadgeTone StatusTone(string status) =>
        status switch
        {
            "Completed" => BadgeTone.Success,
            "Cancelled" => BadgeTone.Neutral,
            "InProgress" => BadgeTone.Warning,
            _ => BadgeTone.Neutral
        };

    private async Task ReloadAsync()
    {
        _errorTitle = null;
        _errorMessage = null;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _count = null;
            return;
        }

        var result = await Inventory.GetStockCountAsync(StockCountId);
        if (result.Status == ApiCallStatus.Success)
        {
            _count = result.Data;
            foreach (var line in _count!.Lines)
            {
                _countedByLine[line.LineId] = line.CountedQuantity?.ToString("0.###") ?? string.Empty;
            }
        }
        else
        {
            _count = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }
    }

    private string GetCountedText(Guid lineId) =>
        _countedByLine.TryGetValue(lineId, out var text) ? text : string.Empty;

    private void SetCountedText(Guid lineId, string value) => _countedByLine[lineId] = value;

    private async Task StartAsync()
    {
        _busy = true;
        var result = await Inventory.StartStockCountAsync(StockCountId);
        _busy = false;
        if (result.Status == ApiCallStatus.Success)
        {
            await ReloadAsync();
            return;
        }

        ShowError(result);
    }

    private async Task SaveLinesAsync()
    {
        if (_count is null)
        {
            return;
        }

        _busy = true;
        var lines = _count.Lines.Select(line =>
        {
            decimal? counted = null;
            if (_countedByLine.TryGetValue(line.LineId, out var text) && decimal.TryParse(text, out var parsed))
            {
                counted = parsed;
            }

            return new CreateStockCountLineRequest(line.ProductId, counted);
        }).ToList();

        var result = await Inventory.UpdateStockCountAsync(StockCountId, new UpdateStockCountRequest(lines));
        _busy = false;
        if (result.Status == ApiCallStatus.Success)
        {
            await ReloadAsync();
            return;
        }

        ShowError(result);
    }

    private async Task CompleteAsync()
    {
        await SaveLinesAsync();
        _busy = true;
        var result = await Inventory.CompleteStockCountAsync(StockCountId);
        _busy = false;
        if (result.Status == ApiCallStatus.Success)
        {
            await ReloadAsync();
            return;
        }

        ShowError(result);
    }

    private async Task CancelAsync()
    {
        _busy = true;
        var result = await Inventory.CancelStockCountAsync(StockCountId);
        _busy = false;
        if (result.Status == ApiCallStatus.Success)
        {
            await ReloadAsync();
            return;
        }

        ShowError(result);
    }

    private void ShowError<T>(ApiResult<T> result)
    {
        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }
}

@page "/inventory/{ProductId:guid}/adjust"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosInventoryClient Inventory
@inject IPosCatalogClient Catalog
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/inventory/{ProductId:D}")" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var expiryOn = _trackExpiration;
    var canToggleExpiry = !_productAlreadyTracksExpiration;
<div class="pos-inventory-adjust">
<Page>
    <header class="pos-inventory-adjust__header">
        <h1 class="pos-inventory-adjust__title">@L["Inventory_AdjustTitle"]</h1>
        <p class="pos-inventory-adjust__subtitle">@(_account?.Name ?? L["Inventory_Title"])</p>
        <p class="pos-inventory-adjust__intro">@L["Inventory_AdjustIntro"]</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Inventory_OfflineTitle"]" Message="@L["Inventory_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Inventory_AdjustTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-inventory-adjust__panel" aria-labelledby="inventory-adjust-heading">
        <h2 id="inventory-adjust-heading" class="pos-inventory-adjust__section-title">@L["Inventory_AdjustDetails"]</h2>
        <div class="pos-inventory-adjust__form">
            <Select Label="@L["Inventory_Direction"]"
                    Value="@_direction"
                    ValueChanged="OnDirectionChanged"
                    Options="@DirectionOptions"
                    Disabled="@(_isOffline || _busy)" />
            <TextInput Label="@L["Inventory_Quantity"]"
                       Value="@_quantityText"
                       ValueChanged="v => _quantityText = v"
                       Disabled="@(_isOffline || _busy)"
                       AdditionalAttributes="@DecimalFieldAttributes" />
            <TextInput Label="@L["Inventory_Remarks"]"
                       Value="@_reason"
                       ValueChanged="v => _reason = v"
                       Hint="@L["Inventory_RemarksHint"]"
                       Required="true"
                       Disabled="@(_isOffline || _busy)" />
        </div>
    </section>

    <section class="pos-inventory-adjust__panel pos-inventory-adjust__panel--expiry" aria-labelledby="inventory-adjust-expiry-heading">
        <h2 id="inventory-adjust-expiry-heading" class="pos-inventory-adjust__section-title">@L["Catalog_TrackExpiration"]</h2>
        <div class="pos-inventory-adjust__form">
            <Switch Checked="@_trackExpiration"
                    CheckedChanged="OnTrackExpirationChanged"
                    Label="@L["Catalog_TrackExpiration"]"
                    Disabled="@(_isOffline || _busy || !canToggleExpiry)" />
            <p class="pos-inventory-adjust__hint">
                @(canToggleExpiry
                    ? L["Inventory_AdjustExpiryToggleHint"]
                    : L["Inventory_AdjustExpiryLockedHint"])
            </p>

            @if (expiryOn)
            {
                @if (_direction == "In")
                {
                    <DateInput Label="@L["Inventory_ExpirationDate"]"
                               Value="@_expirationDate"
                               ValueChanged="v => _expirationDate = v"
                               Required="true"
                               Disabled="@(_isOffline || _busy)" />
                    <TextInput Label="@L["Inventory_LotNumber"]"
                               Value="@_lotNumber"
                               ValueChanged="v => _lotNumber = v"
                               Disabled="@(_isOffline || _busy)" />
                    <p class="pos-inventory-adjust__hint">@L["Inventory_LotNumberOptionalHint"]</p>
                }
                else
                {
                    @if (_lots.Count > 0)
                    {
                        <Select Label="@L["Inventory_Lots"]"
                                Value="@_selectedLotId"
                                ValueChanged="v => _selectedLotId = v"
                                Options="@LotOptions"
                                Required="true"
                                Disabled="@(_isOffline || _busy)" />
                    }
                    else
                    {
                        <DateInput Label="@L["Inventory_ExpirationDate"]"
                                   Value="@_expirationDate"
                                   ValueChanged="v => _expirationDate = v"
                                   Required="true"
                                   Disabled="@(_isOffline || _busy)" />
                        <TextInput Label="@L["Inventory_LotNumber"]"
                                   Value="@_lotNumber"
                                   ValueChanged="v => _lotNumber = v"
                                   Disabled="@(_isOffline || _busy)" />
                    }
                    <p class="pos-inventory-adjust__hint">@L["Inventory_AdjustOutExpiryHint"]</p>
                }
            }
        </div>
    </section>

    <FormActions>
        <Button Variant="ButtonVariant.Secondary"
                Disabled="@_busy"
                OnClick="Cancel">@L["Common_Cancel"]</Button>
        <Button Variant="ButtonVariant.Primary"
                Disabled="@(_isOffline || _busy)"
                IsLoading="@_busy"
                OnClick="SaveAsync">@L["Inventory_SaveAdjustment"]</Button>
    </FormActions>
</Page>
</div>
}
}

@code {
    private static readonly IReadOnlyDictionary<string, object> DecimalFieldAttributes =
        new Dictionary<string, object>(StringComparer.Ordinal)
        {
            ["inputmode"] = "decimal",
            ["autocomplete"] = "off"
        };

    [Parameter] public Guid ProductId { get; set; }

    private bool _ready;
    private bool _busy;
    private bool _isOffline;
    private PosInventoryAccountDto? _account;
    private PosCatalogProductDto? _product;
    private bool _productAlreadyTracksExpiration;
    private bool _trackExpiration;
    private string _direction = "In";
    private string _quantityText = "1";
    private string _reason = string.Empty;
    private DateOnly? _expirationDate;
    private string? _lotNumber;
    private string? _selectedLotId;
    private List<PosInventoryLotDto> _lots = [];
    private string? _errorTitle;
    private string? _errorMessage;

    private IReadOnlyList<SelectOption> LotOptions =>
        _lots.Select(l => new SelectOption(
            l.LotId.ToString("D"),
            $"{l.ExpirationDate:yyyy-MM-dd} · {l.QuantityOnHand.ToString("0.###")}{(string.IsNullOrEmpty(l.LotNumber) ? "" : " · " + l.LotNumber)}"))
            .ToList();

    private IReadOnlyList<SelectOption> DirectionOptions =>
    [
        new("In", L["Inventory_DirectionIn"]),
        new("Out", L["Inventory_DirectionOut"])
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!Gate.CanEnterProtectedShell || !Capabilities.IsAllowed(UtangCapability.ManageInventory))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            return;
        }

        var result = await Inventory.GetAsync(ProductId);
        _account = result.Data;
        if (result.Status != ApiCallStatus.Success || _account is null || !_account.IsTracked)
        {
            Nav.NavigateTo($"/inventory/{ProductId:D}", replace: true);
            return;
        }

        _productAlreadyTracksExpiration = _account.TracksExpiration;
        _trackExpiration = _account.TracksExpiration;

        var productResult = await Catalog.GetProductAsync(ProductId);
        if (productResult.IsSuccess && productResult.Data is not null)
        {
            _product = productResult.Data;
            _productAlreadyTracksExpiration = _product.TracksExpiration;
            _trackExpiration = _product.TracksExpiration;
        }

        if (_trackExpiration)
        {
            await LoadLotsAsync();
        }
    }

    private async Task OnTrackExpirationChanged(bool value)
    {
        if (_productAlreadyTracksExpiration)
        {
            _trackExpiration = true;
            return;
        }

        _trackExpiration = value;
        if (!value)
        {
            _expirationDate = null;
            _lotNumber = null;
            _selectedLotId = null;
            return;
        }

        await LoadLotsAsync();
    }

    private async Task OnDirectionChanged(string value)
    {
        _direction = value;
        _selectedLotId = null;
        if (_trackExpiration && _direction == "Out" && _lots.Count == 0)
        {
            await LoadLotsAsync();
        }
    }

    private async Task LoadLotsAsync()
    {
        var lots = await Inventory.ListLotsAsync(ProductId, includeDepleted: false, pageSize: 50);
        _lots = lots.Data?.Items.ToList() ?? [];
    }

    private void Cancel() => Nav.NavigateTo($"/inventory/{ProductId:D}");

    private async Task SaveAsync()
    {
        _busy = true;
        _errorTitle = null;
        _errorMessage = null;

        if (!decimal.TryParse(_quantityText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var qty)
            || qty <= 0)
        {
            _errorTitle = L["Inventory_AdjustTitle"];
            _errorMessage = L["Sales_Checkout_QuantityPrecision"];
            _busy = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_reason))
        {
            _errorTitle = L["Inventory_AdjustTitle"];
            _errorMessage = L["Inventory_RemarksRequired"];
            _busy = false;
            return;
        }

        if (_trackExpiration && _direction == "In" && _expirationDate is null)
        {
            _errorTitle = L["Inventory_AdjustTitle"];
            _errorMessage = L["Inventory_ExpirationDateRequired"];
            _busy = false;
            return;
        }

        if (_trackExpiration && _direction == "Out"
            && _lots.Count > 0
            && string.IsNullOrWhiteSpace(_selectedLotId))
        {
            _errorTitle = L["Inventory_AdjustTitle"];
            _errorMessage = L["Inventory_LotRequired"];
            _busy = false;
            return;
        }

        if (_trackExpiration && _direction == "Out"
            && _lots.Count == 0
            && _expirationDate is null)
        {
            _errorTitle = L["Inventory_AdjustTitle"];
            _errorMessage = L["Inventory_ExpirationDateRequired"];
            _busy = false;
            return;
        }

        try
        {
            if (_trackExpiration && !_productAlreadyTracksExpiration)
            {
                if (!Capabilities.IsAllowed(UtangCapability.ManageCatalog) || _product is null)
                {
                    _errorTitle = L["Inventory_AdjustTitle"];
                    _errorMessage = L["Inventory_EnableExpiryNeedsCatalog"];
                    return;
                }

                var enable = await Catalog.UpdateProductAsync(
                    ProductId,
                    new UpdatePosCatalogProductRequest(
                        _product.Name,
                        _product.UnitOfMeasure,
                        _product.SellingPrice,
                        _product.Description,
                        _product.Sku,
                        _product.Barcode,
                        _product.CategoryId,
                        SellingMode: _product.SellingMode,
                        TracksExpiration: true,
                        ExpirationWarningDays: _product.ExpirationWarningDays ?? 7));
                if (!enable.IsSuccess)
                {
                    var describedEnable = ApiLocalizer.Describe(enable.Status, enable.Error);
                    _errorTitle = describedEnable.Title;
                    _errorMessage = enable.Error?.Detail ?? describedEnable.Message;
                    return;
                }

                _productAlreadyTracksExpiration = true;
                _product = enable.Data ?? _product;
            }

            Guid? lotId = Guid.TryParse(_selectedLotId, out var parsedLot) ? parsedLot : null;
            var result = await Inventory.AdjustAsync(
                ProductId,
                new AdjustInventoryRequest(
                    _direction,
                    qty,
                    _reason.Trim(),
                    ExpirationDate: _trackExpiration ? _expirationDate : null,
                    LotNumber: _trackExpiration && !string.IsNullOrWhiteSpace(_lotNumber) ? _lotNumber.Trim() : null,
                    LotId: _trackExpiration ? lotId : null));

            if (result.Status == ApiCallStatus.Success)
            {
                Nav.NavigateTo($"/inventory/{ProductId:D}");
                return;
            }

            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}

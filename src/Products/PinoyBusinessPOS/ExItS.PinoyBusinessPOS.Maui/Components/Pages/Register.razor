@page "/register"
@layout Layout.AuthShell
@using ExItS.PinoyBusinessPOS.Application.Options
@using Microsoft.Extensions.Options
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IOptions<LocalValidationClientOptions> LocalValidationOptions
@inject IStringLocalizer<PosResources> L

<AuthExperience ActiveTab="AuthExperienceTab.SignUp">
    <FormValidationSummary Messages="_errors" />

    <LocalValidationMailpitHint />

    <div class="pos-signin__form">
        <TextInput Label="@L["Register_DisplayName"]"
                   @bind-Value="_displayName"
                   Disabled="_busy"
                   IsInvalid="@_invalid"
                   autocomplete="name" />
        <TextInput Label="@L["Register_Email"]"
                   @bind-Value="_email"
                   Type="email"
                   Disabled="_busy"
                   IsInvalid="@_invalid"
                   autocomplete="email" />

        <div class="pos-signin__submit">
            <Button IsLoading="_busy" Disabled="_busy" OnClick="RegisterAsync">
                @L["Register_Submit"]
            </Button>
        </div>
    </div>

    @if (_registered)
    {
        <Alert Tone="AlertTone.Info" Title="@L["Register_ActivationReadyTitle"]" Message="@L["Register_ActivationReadyMessage"]" />
        @if (!string.IsNullOrWhiteSpace(_ackMessage))
        {
            <InlineMessage Tone="InlineMessageTone.Info">@_ackMessage</InlineMessage>
        }
        <LocalValidationMailpitHint />
        <div class="pos-signin__submit">
            <Button Variant="ButtonVariant.Primary" OnClick="GoActivate">@L["Activate_Continue"]</Button>
        </div>
    }
</AuthExperience>

@code {
    private string? _displayName;
    private string? _email;
    private string? _debugToken;
    private string? _ackMessage;
    private bool _registered;
    private bool _busy;
    private bool _invalid;
    private List<string> _errors = [];

    private async Task RegisterAsync()
    {
        _errors = [];
        _invalid = false;
        _debugToken = null;
        _registered = false;
        if (string.IsNullOrWhiteSpace(_displayName) || string.IsNullOrWhiteSpace(_email))
        {
            _invalid = true;
            _errors.Add(L["Register_ValidationRequired"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.RegisterPersonalAccountAsync(
                new RegisterPersonalAccountRequest(_displayName.Trim(), _email.Trim()));
            if (!result.IsSuccess || result.Data is null)
            {
                _invalid = true;
                var detail = result.Error?.Detail ?? result.Error?.Title;
                _errors.Add(string.IsNullOrWhiteSpace(detail) ? L["Register_Failed"] : detail);
                return;
            }

            _ackMessage = result.Data.Message;
            _debugToken = result.Data.DebugToken;
            _registered = true;

            // Local Validation: keep the user here so they open MAUI Mailpit :8125 (not React :8025).
            if (!LocalValidationOptions.Value.Enabled && string.IsNullOrWhiteSpace(_debugToken))
            {
                Nav.NavigateTo("/activate");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoActivate() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(_debugToken)
            ? "/activate"
            : $"/activate?token={Uri.EscapeDataString(_debugToken)}");
}

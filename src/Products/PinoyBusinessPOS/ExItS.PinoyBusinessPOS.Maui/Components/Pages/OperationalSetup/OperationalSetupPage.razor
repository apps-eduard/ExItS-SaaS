@page "/setup"
@layout Layout.AuthShell
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject ICurrentUserContext CurrentUser
@inject IPosOperationalSetupClient SetupClient
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup);
    var readOnly = !canManage || _isOffline;
    var isFirstRun = _setup is not { IsCompleted: true };
<div class="pos-setup @(isFirstRun ? "pos-setup--first-run" : null)">
<Page>
    <header class="pos-setup__header">
        <div class="pos-setup__badge" aria-hidden="true">@IconGlyphs.Get("settings")</div>
        <div class="pos-setup__heading">
            <h1 class="pos-setup__title">@L["Setup_Title"]</h1>
            <p class="pos-setup__subtitle">@L["Setup_Subtitle"]</p>
            @if (isFirstRun)
            {
                <p class="pos-setup__progress" role="status">@L["Setup_FirstRunHint"]</p>
            }
        </div>
        @if (!isFirstRun)
        {
            <button type="button"
                    class="pos-setup__home"
                    @onclick="GoHome">
                @L["Setup_BackToHome"]
            </button>
        }
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Setup_OfflineTitle"]" Message="@L["Setup_OfflineMessage"]" />
    }
    else if (!canManage)
    {
        <Alert Tone="AlertTone.Info" Title="@L["Setup_ReadOnlyTitle"]" Message="@L["Setup_ReadOnlyMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Setup_ErrorTitle"]" Message="@_formError" />
    }

    <div class="pos-setup__panel">
        <div class="pos-setup__panel-head">
            <h2 class="pos-setup__panel-title">@L["Setup_StoreSection"]</h2>
            <p class="pos-setup__panel-hint">@L["Setup_StoreSectionHint"]</p>
        </div>
        <div class="pos-setup__fields">
            <TextInput Label="@L["Setup_StoreDisplayName"]"
                       Value="@_storeDisplayName"
                       ValueChanged="v => _storeDisplayName = v"
                       Disabled="@readOnly" />
            <div class="pos-setup__row">
                <TextInput Label="@L["Setup_CurrencyCode"]"
                           Value="@_currencyCode"
                           ValueChanged="v => _currencyCode = v"
                           Disabled="@readOnly" />
                <TextInput Label="@L["Setup_TaxRatePercent"]"
                           Value="@_taxRatePercentText"
                           ValueChanged="v => _taxRatePercentText = v"
                           Disabled="@readOnly" />
            </div>
            <Select Label="@L["Setup_TaxPricingMode"]"
                    Value="@_taxPricingMode"
                    ValueChanged="v => _taxPricingMode = v ?? TaxExclusive"
                    Options="TaxModeOptions"
                    Disabled="@readOnly" />
        </div>
    </div>

    <div class="pos-setup__panel">
        <div class="pos-setup__panel-head">
            <h2 class="pos-setup__panel-title">@L["Setup_ReceiptSection"]</h2>
            <p class="pos-setup__panel-hint">@L["Setup_ReceiptSectionHint"]</p>
        </div>
        <div class="pos-setup__fields">
            <TextInput Label="@L["Setup_ReceiptHeader"]"
                       Value="@_receiptHeader"
                       ValueChanged="v => _receiptHeader = v"
                       Disabled="@readOnly" />
            <TextInput Label="@L["Setup_ReceiptFooter"]"
                       Value="@_receiptFooter"
                       ValueChanged="v => _receiptFooter = v"
                       Disabled="@readOnly" />
            <TextInput Label="@L["Setup_BusinessAddress"]"
                       Value="@_businessAddress"
                       ValueChanged="v => _businessAddress = v"
                       Disabled="@readOnly" />
            <TextInput Label="@L["Setup_ContactPhone"]"
                       Value="@_contactPhone"
                       ValueChanged="v => _contactPhone = v"
                       Disabled="@readOnly" />
        </div>
    </div>

    <div class="pos-setup__panel">
        <div class="pos-setup__panel-head">
            <h2 class="pos-setup__panel-title">@L["Setup_CashHandlingSection"]</h2>
            <p class="pos-setup__panel-hint">@L["Setup_CashHandlingHint"]</p>
        </div>
        <div class="pos-setup__fields">
            <div class="pos-setup__policy" role="radiogroup" aria-label="@L["Setup_CashCount"]">
                <button type="button"
                        class="pos-setup__policy-card @(_cashCountMode == CashCountRequired ? "pos-setup__policy-card--selected" : null)"
                        role="radio"
                        aria-checked="@(_cashCountMode == CashCountRequired)"
                        disabled="@readOnly"
                        @onclick="() => SetCashCountMode(CashCountRequired)">
                    <span class="pos-setup__policy-kicker">
                        <span class="pos-setup__policy-title">@L["Setup_CashCountRequiredTitle"]</span>
                        <span class="pos-setup__policy-badge">@L["Setup_CashCountRecommended"]</span>
                    </span>
                    <span class="pos-setup__policy-copy">@L["Setup_CashCountHelpRequired"]</span>
                </button>
                <button type="button"
                        class="pos-setup__policy-card @(_cashCountMode == CashCountOptional ? "pos-setup__policy-card--selected" : null)"
                        role="radio"
                        aria-checked="@(_cashCountMode == CashCountOptional)"
                        disabled="@readOnly"
                        @onclick="() => SetCashCountMode(CashCountOptional)">
                    <span class="pos-setup__policy-kicker">
                        <span class="pos-setup__policy-title">@L["Setup_CashCountOptional"]</span>
                    </span>
                    <span class="pos-setup__policy-copy">@L["Setup_CashCountHelpOptional"]</span>
                </button>
            </div>
            <p class="pos-setup__callout">@L["Setup_CashCountSnapshotHint"]</p>
        </div>
        @if (_denominations.Count > 0 || canManage)
        {
            <div class="pos-setup__denoms">
                <div class="pos-setup__denoms-head">
                    <h3 class="pos-setup__panel-title">@L["Setup_Denominations"]</h3>
                    @if (_denominations.Count > 0)
                    {
                        <p class="pos-setup__denoms-count">@L["Setup_DenominationsShown", EnabledDenominationCount]</p>
                    }
                </div>
                <p class="pos-setup__panel-hint">@L["Setup_DenominationsHint"]</p>
                @if (_denominations.Count > 0)
                {
                    <div class="pos-setup__denom-grid" role="group" aria-label="@L["Setup_Denominations"]">
                        @foreach (var denom in _denominations)
                        {
                            var on = denom.IsEnabled;
                            <button type="button"
                                    class="pos-setup__denom-chip @(on ? "pos-setup__denom-chip--on" : "pos-setup__denom-chip--off")"
                                    aria-pressed="@on"
                                    aria-label="@DenominationAriaLabel(denom)"
                                    disabled="@(readOnly || _denomBusy)"
                                    @onclick="() => ToggleDenominationAsync(denom)">
                                @if (on)
                                {
                                    <span class="pos-setup__denom-check" aria-hidden="true">@IconGlyphs.Get("check")</span>
                                }
                                <span class="pos-setup__denom-value">@FormatDenominationValue(denom.Value)</span>
                            </button>
                        }
                    </div>
                }
                @if (canManage)
                {
                    <div class="pos-setup__composer">
                        <CurrencyInput Label="@L["Setup_AddDenomination"]"
                                       CurrencyCode="@CurrencyCode"
                                       Placeholder="@L["Setup_AddDenominationPlaceholder"]"
                                       Hint="@L["Setup_AddDenominationHint"]"
                                       Value="@_newDenominationValue"
                                       ValueChanged="v => _newDenominationValue = v"
                                       Disabled="@(readOnly || _denomBusy)"
                                       IsInvalid="@_newDenominationInvalid"
                                       ErrorText="@(_newDenominationInvalid ? L["Setup_InvalidDenomination"] : null)"
                                       @onkeydown="HandleAddDenominationKey" />
                        <Button Variant="ButtonVariant.Secondary"
                                Size="ButtonSize.Sm"
                                Disabled="@(readOnly || _denomBusy)"
                                IsLoading="@_denomBusy"
                                OnClick="AddDenominationAsync">@L["Setup_AddDenominationShort"]</Button>
                    </div>
                }
            </div>
        }
    </div>

    @if (canManage)
    {
        <div class="pos-setup__footer" role="group" aria-label="@L["Setup_Title"]">
            <Button Variant="ButtonVariant.Primary"
                    IsLoading="@_saving"
                    Disabled="@readOnly"
                    OnClick="SaveAsync">
                @(isFirstRun ? L["Setup_Complete"] : L["Setup_SaveChanges"])
            </Button>
        </div>
    }
</Page>
</div>
}

@code {
    private const string TaxExclusive = "TaxExclusive";
    private const string TaxInclusive = "TaxInclusive";
    private const string CashCountOptional = "Optional";
    private const string CashCountRequired = "Required";

    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private PosOperationalSetupDto? _setup;
    private string? _storeDisplayName;
    private string? _currencyCode = "PHP";
    private string _taxPricingMode = TaxExclusive;
    private string? _taxRatePercentText = "0";
    private string? _receiptHeader;
    private string? _receiptFooter;
    private string? _businessAddress;
    private string? _contactPhone;
    private string _cashCountMode = CashCountRequired;
    private decimal? _newDenominationValue;
    private bool _newDenominationInvalid;
    private bool _denomBusy;
    private List<OrganizationCashDenominationDto> _denominations = [];
    private string? _formError;

    private IReadOnlyList<SelectOption> TaxModeOptions =>
    [
        new(TaxExclusive, L["Setup_TaxExclusive"].Value),
        new(TaxInclusive, L["Setup_TaxInclusive"].Value)
    ];

    private string CurrencyCode =>
        string.IsNullOrWhiteSpace(_currencyCode) ? "PHP" : _currencyCode.Trim().ToUpperInvariant();

    private int EnabledDenominationCount => _denominations.Count(d => d.IsEnabled);

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        // Defense-in-depth: do not stay on setup if first-run PIN / template still required.
        var start = await Gate.ResolveStartRouteAsync();
        if (!string.Equals(start, "/setup", StringComparison.OrdinalIgnoreCase)
            && !start.StartsWith("/setup?", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(start, replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewOperationalSetup))
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        await LoadAsync();
        SeedDefaultsFromSession();
        _ready = true;
    }

    private void SeedDefaultsFromSession()
    {
        if (!string.IsNullOrWhiteSpace(_storeDisplayName))
        {
            return;
        }

        var orgName = CurrentUser.Session?.OrganizationDisplayName;
        if (!string.IsNullOrWhiteSpace(orgName))
        {
            _storeDisplayName = orgName;
        }

        if (string.IsNullOrWhiteSpace(_receiptHeader) && !string.IsNullOrWhiteSpace(_storeDisplayName))
        {
            _receiptHeader = _storeDisplayName;
        }
    }

    private async Task LoadAsync()
    {
        var result = await SetupClient.GetAsync();
        if (!result.IsSuccess || result.Data is null)
        {
            _formError = ApiLocalizer.Describe(result.Status, result.Error).Message;
            return;
        }

        ApplySetup(result.Data);
        await LoadDenominationsAsync();
    }

    private void ApplySetup(PosOperationalSetupDto setup)
    {
        _setup = setup;
        _storeDisplayName = setup.StoreDisplayName;
        _currencyCode = setup.CurrencyCode;
        _taxPricingMode = setup.TaxPricingMode;
        _taxRatePercentText = setup.TaxRatePercent.ToString("0.##");
        _receiptHeader = setup.ReceiptHeader;
        _receiptFooter = setup.ReceiptFooter;
        _businessAddress = setup.BusinessAddress;
        _contactPhone = setup.ContactPhone;
        _cashCountMode = string.Equals(setup.CashCountMode, "Off", StringComparison.OrdinalIgnoreCase)
            ? CashCountOptional
            : string.IsNullOrWhiteSpace(setup.CashCountMode) ? CashCountRequired : setup.CashCountMode;
    }

    private async Task LoadDenominationsAsync()
    {
        var result = await SetupClient.ListCashDenominationsAsync();
        if (result.IsSuccess && result.Data is not null)
        {
            _denominations = result.Data.OrderBy(d => d.SortOrder).ThenBy(d => d.Value).ToList();
        }
    }

    private void SetCashCountMode(string mode)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup) || _isOffline)
        {
            return;
        }

        _cashCountMode = mode;
    }

    private async Task ToggleDenominationAsync(OrganizationCashDenominationDto denom)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup) || _isOffline || _denomBusy)
        {
            return;
        }

        var items = _denominations
            .Select(d => new CashDenominationWriteDto(
                d.Value,
                d.DenominationId == denom.DenominationId ? !d.IsEnabled : d.IsEnabled,
                d.SortOrder,
                d.DisplayLabel,
                d.DenominationId))
            .ToList();
        await SaveDenominationsAsync(items);
    }

    private Task HandleAddDenominationKey(KeyboardEventArgs e) =>
        e.Key is "Enter" ? AddDenominationAsync() : Task.CompletedTask;

    private async Task AddDenominationAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup) || _isOffline || _denomBusy)
        {
            return;
        }

        if (_newDenominationValue is not > 0)
        {
            _newDenominationInvalid = true;
            return;
        }

        _newDenominationInvalid = false;
        var items = _denominations
            .Select(d => new CashDenominationWriteDto(d.Value, d.IsEnabled, d.SortOrder, d.DisplayLabel, d.DenominationId))
            .ToList();
        items.Add(new CashDenominationWriteDto(_newDenominationValue.Value, true, items.Count));
        await SaveDenominationsAsync(items);
        _newDenominationValue = null;
    }

    private async Task SaveDenominationsAsync(IReadOnlyList<CashDenominationWriteDto> items)
    {
        _denomBusy = true;
        try
        {
            var result = await SetupClient.ReplaceCashDenominationsAsync(new ReplaceCashDenominationsRequest(items));
            if (!result.IsSuccess || result.Data is null)
            {
                _formError = ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            _denominations = result.Data.OrderBy(d => d.SortOrder).ThenBy(d => d.Value).ToList();
            _formError = null;
        }
        finally
        {
            _denomBusy = false;
        }
    }

    private string FormatDenominationValue(decimal value) =>
        value == decimal.Truncate(value)
            ? value.ToString("N0", CultureInfo.CurrentCulture)
            : value.ToString("N2", CultureInfo.CurrentCulture);

    private string DenominationAriaLabel(OrganizationCashDenominationDto denom)
    {
        var state = denom.IsEnabled ? L["Setup_DenominationShown"] : L["Setup_DenominationHidden"];
        return $"{CurrencyCode} {FormatDenominationValue(denom.Value)}, {state}";
    }

    private async Task SaveAsync()
    {
        if (_saving || _isOffline || !Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup))
        {
            return;
        }

        _formError = null;
        if (!decimal.TryParse(_taxRatePercentText, out var taxRate))
        {
            _formError = L["Setup_InvalidTaxRate"];
            return;
        }

        _saving = true;
        try
        {
            var completeRequest = new CompleteOperationalSetupRequest(
                _storeDisplayName ?? string.Empty,
                _currencyCode ?? "PHP",
                _taxPricingMode,
                taxRate,
                _receiptHeader,
                _receiptFooter,
                _businessAddress,
                _contactPhone,
                _cashCountMode);

            var result = _setup?.IsCompleted == true
                ? await SetupClient.UpdateAsync(new UpdateOperationalSetupRequest(
                    completeRequest.StoreDisplayName,
                    completeRequest.CurrencyCode,
                    completeRequest.TaxPricingMode,
                    completeRequest.TaxRatePercent,
                    _setup.UpdatedAtUtc,
                    completeRequest.ReceiptHeader,
                    completeRequest.ReceiptFooter,
                    completeRequest.BusinessAddress,
                    completeRequest.ContactPhone,
                    _cashCountMode))
                : await SetupClient.CompleteAsync(completeRequest);

            if (!result.IsSuccess || result.Data is null)
            {
                _formError = ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            ApplySetup(result.Data);
            if (result.Data.IsCompleted)
            {
                // Continue first-run chain (optional business template) instead of hard-landing home.
                Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task GoHome() => Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
}

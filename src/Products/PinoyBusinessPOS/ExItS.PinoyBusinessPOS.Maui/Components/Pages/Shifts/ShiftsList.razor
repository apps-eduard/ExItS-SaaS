@page "/shifts"
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject ICurrentUserContext CurrentUser
@inject IPosCashierShiftClient Shifts
@inject IPlatformAccessClient Platform
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_allowed)
{
    <Page>
        <ErrorState Title="@L["Access_RestrictedTitle"]"
                    Message="@L["Access_RestrictedMessage"]"
                    RetryLabel="@L["Nav_Home"]"
                    OnRetry="GoHomeAsync" />
    </Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageShifts);
    var hasOpenShift = _current is not null;
    var onlineActionsEnabled = !_isOffline && !_loading;
<div class="pos-shifts">
    <Page>
        <header class="pos-shifts__header">
            <div class="pos-shifts__heading">
                <h1 class="pos-shifts__title">@L["Shifts_Title"]</h1>
                <p class="pos-shifts__subtitle">@L["Shifts_Subtitle"]</p>
            </div>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Shifts_OfflineTitle"]" Message="@L["Shifts_OfflineMessage"]" />
        }

        @if (canManage && !hasOpenShift)
        {
            <div class="pos-shifts__open-action">
                <Button Variant="ButtonVariant.Primary"
                        Disabled="@(_isOffline || _openingNav)"
                        IsLoading="@_openingNav"
                        OnClick="GoOpenAsync">
                    @L["Shifts_Open"]
                </Button>
            </div>
        }

        @if (_current is not null)
        {
            <section class="pos-shifts__current" aria-labelledby="shifts-current-heading">
                <h2 id="shifts-current-heading" class="pos-shifts__current-label">@L["Shifts_CurrentSection"]</h2>
                <div class="pos-shifts__current-top">
                    <p class="pos-shifts__current-number">@_current.ShiftNumber</p>
                    <span class="pos-shifts__badge pos-shifts__badge--open" aria-label="@($"{L["Shifts_Status"]}: {StatusLabel(_current.Status)}")">
                        @StatusLabel(_current.Status)
                    </span>
                </div>
                <p class="pos-shifts__current-register">@RegisterCashierLine(_current)</p>
                <p class="pos-shifts__current-opened pos-muted">
                    @RowOpenCloseLine(_current)
                </p>
                <div class="pos-shifts__current-action">
                    <Button Variant="ButtonVariant.Primary"
                            Disabled="@_isOffline"
                            OnClick="GoCurrent">
                        @L["Shifts_OpenCurrent"]
                    </Button>
                </div>
            </section>
        }

        <div class="pos-shifts__toolbar" role="search">
            <SearchBar Value="@_search"
                       ValueChanged="OnSearchInputAsync"
                       Placeholder="@L["Shifts_SearchPlaceholder"]"
                       AriaLabel="@L["Shifts_SearchPlaceholder"]"
                       ClearLabel="@L["Shifts_ClearSearch"]"
                       Disabled="@(_loading && string.IsNullOrWhiteSpace(_search))"
                       OnClear="ClearSearchAsync" />
            <Select Value="@_statusFilter"
                    ValueChanged="OnStatusFilterChanged"
                    Options="@ShiftStatusFilters"
                    Disabled="@_isOffline"
                    aria-label="@L["Shifts_Filter_Status"]" />
            <button type="button"
                    class="pos-shifts__refresh"
                    title="@L["Shifts_Refresh"]"
                    aria-label="@L["Shifts_Refresh"]"
                    disabled="@(!onlineActionsEnabled)"
                    @onclick="ReloadAsync">
                @if (_loading)
                {
                    <Spinner Size="SpinnerSize.Sm" />
                }
                else
                {
                    <span aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                }
            </button>
        </div>

        <section class="pos-shifts__history" aria-labelledby="shifts-history-heading" aria-busy="@_loading">
            <h2 id="shifts-history-heading" class="pos-shifts__section-title">@L["Shifts_HistorySection"]</h2>

            @if (_loading && _items.Count == 0 && string.IsNullOrEmpty(_errorTitle))
            {
                <div class="pos-shifts__loading" role="status" aria-live="polite">
                    <Spinner />
                    <span class="pos-muted">@L["Shifts_Loading"]</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorTitle))
            {
                <ErrorState Title="@_errorTitle"
                            Message="@(_errorMessage ?? L["Shifts_EmptyMessage"])"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState Title="@L["Shifts_EmptyTitle"]" Message="@L["Shifts_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-shifts__list" role="list" aria-label="@L["Shifts_HistorySection"]">
                    @foreach (var item in _items)
                    {
                        <button type="button"
                                class="pos-shifts__row"
                                role="listitem"
                                disabled="@_isOffline"
                                aria-label="@RowAriaLabel(item)"
                                @onclick="() => GoDetail(item.ShiftId)">
                            <span class="pos-shifts__row-body">
                                <span class="pos-shifts__row-top">
                                    <span class="pos-shifts__row-number">@item.ShiftNumber</span>
                                    <span class="pos-shifts__badge pos-shifts__badge--@StatusTone(item.Status)"
                                          aria-label="@($"{L["Shifts_Status"]}: {StatusLabel(item.Status)}")">
                                        @StatusLabel(item.Status)
                                    </span>
                                </span>
                                <span class="pos-shifts__row-register">@RegisterCashierLine(item)</span>
                                <span class="pos-shifts__row-time pos-muted">@RowOpenCloseLine(item)</span>
                            </span>
                            <span class="pos-shifts__chevron" aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            }
        </section>

        @if (!_loading && _totalCount > 0)
        {
            <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _allowed;
    private bool _loading;
    private bool _openingNav;
    private bool _isOffline;
    private string? _search;
    private string? _statusFilter;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private PosCashierShiftDto? _current;
    private IReadOnlyList<PosCashierShiftDto> _items = Array.Empty<PosCashierShiftDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;
    private readonly Dictionary<Guid, string> _nameById = new();

    private IReadOnlyList<SelectOption> ShiftStatusFilters =>
    [
        new(string.Empty, L["Shifts_Filter_All"]),
        new("Open", L["Shifts_Status_Open"]),
        new("Closed", L["Shifts_Status_Closed"]),
        new("Cancelled", L["Shifts_Status_Cancelled"]),
    ];

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged += OnConnectivityChanged;

        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _allowed = Capabilities.IsAllowed(UtangCapability.ViewShifts);
        _isOffline = !await Connectivity.IsConnectedAsync();
        _ready = true;
        if (_allowed)
        {
            await ReloadAsync();
        }
    }

    private async void OnConnectivityChanged(object? sender, ConnectivityStatus status)
    {
        var wasOffline = _isOffline;
        _isOffline = status == ConnectivityStatus.Offline;
        await InvokeAsync(StateHasChanged);
        if (wasOffline && !_isOffline && _allowed)
        {
            await InvokeAsync(ReloadAsync);
        }
    }

    private async Task GoHomeAsync() => Nav.NavigateTo(await Gate.ResolveStartRouteAsync());

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                _items = Array.Empty<PosCashierShiftDto>();
                _totalCount = 0;
                _current = null;
                return;
            }

            var current = await Shifts.GetCurrentAsync();
            if (current.IsSuccess
                && current.Data is not null
                && string.Equals(current.Data.Status, "Open", StringComparison.OrdinalIgnoreCase))
            {
                _current = current.Data;
            }
            else
            {
                _current = null;
            }

            var result = await Shifts.ListAsync(
                status: string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                shiftNumber: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                page: _page,
                pageSize: _pageSize);

            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
                _totalCount = result.Data.TotalCount;
                await ResolveCashierNamesAsync();
                return;
            }

            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
            _items = Array.Empty<PosCashierShiftDto>();
            _totalCount = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveCashierNamesAsync()
    {
        var ids = new HashSet<Guid>();
        if (_current is not null)
        {
            ids.Add(_current.OpenedBy);
        }

        foreach (var item in _items)
        {
            ids.Add(item.OpenedBy);
        }

        var session = CurrentUser.Session;
        if (session is not null
            && !string.IsNullOrWhiteSpace(session.DisplayName)
            && ids.Contains(session.UserId))
        {
            _nameById.TryAdd(session.UserId, session.DisplayName.Trim());
        }

        var missing = ids.Where(id => !_nameById.ContainsKey(id)).ToHashSet();
        if (missing.Count == 0)
        {
            return;
        }

        var orgId = session?.OrganizationId
            ?? _current?.OrganizationId
            ?? _items.FirstOrDefault()?.OrganizationId
            ?? Guid.Empty;
        if (orgId == Guid.Empty)
        {
            return;
        }

        // Org owners cannot use GetUserAsync; resolve from membership directory first.
        try
        {
            var members = await Platform.GetOrganizationMembersAsync(orgId, page: 1, pageSize: 100);
            if (members.IsSuccess && members.Data is not null)
            {
                foreach (var member in members.Data.Items)
                {
                    if (!missing.Contains(member.UserId) || _nameById.ContainsKey(member.UserId))
                    {
                        continue;
                    }

                    var name = FirstMeaningful(member.DisplayName, member.Username, member.Email);
                    if (!string.IsNullOrWhiteSpace(name))
                    {
                        _nameById[member.UserId] = name;
                    }
                }
            }
        }
        catch
        {
            // Best-effort.
        }

        missing = ids.Where(id => !_nameById.ContainsKey(id)).ToHashSet();
        if (missing.Count == 0)
        {
            return;
        }

        try
        {
            var grants = await Platform.GetProductLocalRolesAsync(orgId, status: "Active");
            if (grants.IsSuccess && grants.Data is not null)
            {
                foreach (var grant in grants.Data)
                {
                    if (!missing.Contains(grant.UserIdentityId)
                        || _nameById.ContainsKey(grant.UserIdentityId)
                        || string.IsNullOrWhiteSpace(grant.UserDisplayName))
                    {
                        continue;
                    }

                    _nameById[grant.UserIdentityId] = grant.UserDisplayName.Trim();
                }
            }
        }
        catch
        {
            // Best-effort.
        }

        foreach (var id in ids.Where(x => !_nameById.ContainsKey(x)))
        {
            try
            {
                var userResult = await Platform.GetUserAsync(id);
                if (userResult.IsSuccess && userResult.Data is not null)
                {
                    var name = FirstMeaningful(
                        userResult.Data.DisplayName,
                        userResult.Data.Username,
                        userResult.Data.Email);
                    if (!string.IsNullOrWhiteSpace(name))
                    {
                        _nameById[id] = name;
                    }
                }
            }
            catch
            {
                // Keep register-only label when identity lookup fails.
            }
        }
    }

    private static string? FirstMeaningful(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return null;
    }

    private async Task OnSearchInputAsync(string? value)
    {
        _search = value;
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            // superseded by newer keystrokes
        }
    }

    private async Task ClearSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return;
        }

        _search = null;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        if (string.Equals(value, _statusFilter, StringComparison.Ordinal))
        {
            return;
        }

        _statusFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task GoOpenAsync()
    {
        if (_openingNav || _isOffline || _current is not null
            || !Capabilities.IsAllowed(UtangCapability.ManageShifts))
        {
            return;
        }

        _openingNav = true;
        try
        {
            // Re-check before navigating to block duplicate open attempts.
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                return;
            }

            var current = await Shifts.GetCurrentAsync();
            if (current.IsSuccess
                && current.Data is not null
                && string.Equals(current.Data.Status, "Open", StringComparison.OrdinalIgnoreCase))
            {
                _current = current.Data;
                return;
            }

            Nav.NavigateTo("/shifts/open");
        }
        finally
        {
            _openingNav = false;
        }
    }

    private void GoCurrent()
    {
        if (_current is null || _isOffline)
        {
            return;
        }

        Nav.NavigateTo($"/shifts/{_current.ShiftId:D}");
    }

    private void GoDetail(Guid shiftId)
    {
        if (_isOffline || shiftId == Guid.Empty)
        {
            return;
        }

        Nav.NavigateTo($"/shifts/{shiftId:D}");
    }

    private string StatusLabel(string? status) => status switch
    {
        "Open" => L["Shifts_Status_Open"],
        "Closed" => L["Shifts_Status_Closed"],
        "Cancelled" => L["Shifts_Status_Cancelled"],
        _ => status ?? L["Shifts_Filter_All"]
    };

    private static string StatusTone(string? status) => status switch
    {
        "Open" => "open",
        "Closed" => "closed",
        "Cancelled" => "cancelled",
        _ => "neutral"
    };

    private string? CurrentCashierName
    {
        get
        {
            if (_current is null)
            {
                return null;
            }

            if (_nameById.TryGetValue(_current.OpenedBy, out var resolved))
            {
                return resolved;
            }

            var session = CurrentUser.Session;
            if (session is null || string.IsNullOrWhiteSpace(session.DisplayName))
            {
                return null;
            }

            if (session.UserId != _current.ActorId && session.UserId != _current.OpenedBy)
            {
                return null;
            }

            return session.DisplayName.Trim();
        }
    }

    private string RegisterCashierLine(PosCashierShiftDto item)
    {
        var register = RegisterLabel(item);
        var cashier = ResolveCashierName(item);
        return string.IsNullOrWhiteSpace(cashier)
            ? register
            : string.Format(L["Shifts_RegisterCashierFormat"].Value, register, cashier);
    }

    private string? ResolveCashierName(PosCashierShiftDto item)
    {
        if (_nameById.TryGetValue(item.OpenedBy, out var resolved))
        {
            return resolved;
        }

        if (_current is not null
            && item.ShiftId == _current.ShiftId
            && !string.IsNullOrWhiteSpace(CurrentCashierName))
        {
            return CurrentCashierName;
        }

        return null;
    }

    private static string RegisterLabel(PosCashierShiftDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.RegisterName))
        {
            return item.RegisterName;
        }

        if (!string.IsNullOrWhiteSpace(item.RegisterCode))
        {
            return item.RegisterCode;
        }

        return "—";
    }

    private static string FormatDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("M/d/yy h:mm tt");

    private string RowOpenCloseLine(PosCashierShiftDto item)
    {
        var openedLocal = item.OpenedAtUtc.ToLocalTime();
        var openedAt = FormatDateTime(item.OpenedAtUtc);
        if (string.Equals(item.Status, "Closed", StringComparison.OrdinalIgnoreCase)
            && item.ClosedAtUtc is { } closed)
        {
            var closedLocal = closed.ToLocalTime();
            var closedAt = openedLocal.Date == closedLocal.Date
                ? closedLocal.ToString("h:mm tt")
                : FormatDateTime(closed);
            return string.Format(L["Shifts_OpenCloseFormat"].Value, openedAt, closedAt);
        }

        if (string.Equals(item.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
            && item.CancelledAtUtc is { } cancelled)
        {
            var cancelledLocal = cancelled.ToLocalTime();
            var cancelledAt = openedLocal.Date == cancelledLocal.Date
                ? cancelledLocal.ToString("h:mm tt")
                : FormatDateTime(cancelled);
            return string.Format(L["Shifts_OpenCancelledFormat"].Value, openedAt, cancelledAt);
        }

        return string.Format(L["Shifts_OpenedFormat"].Value, openedAt);
    }

    private string RowAriaLabel(PosCashierShiftDto item) =>
        $"{item.ShiftNumber}, {StatusLabel(item.Status)}, {RegisterCashierLine(item)}, {RowOpenCloseLine(item)}";

    public void Dispose()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}

@page "/shifts/open"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCashierShiftClient Shifts
@inject IPosRegisterClient Registers
@inject IPosOperationalSetupClient SetupClient
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/shifts" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var blocked = _isOffline || !Capabilities.IsAllowed(UtangCapability.ManageShifts);
    var startBlocked = blocked || _selectedRegisterGuid == Guid.Empty || _available.Count == 0 || !string.IsNullOrEmpty(_errorMessage);
<div class="pos-shift-open">
<Page>
    <header class="pos-shift-open__header">
        <h1 class="pos-shift-open__title">@L["Shifts_OpenTitle"]</h1>
        <p class="pos-shift-open__subtitle">@L["Shifts_OpenSubtitle"]</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Shifts_OfflineTitle"]" Message="@L["Shifts_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Shifts_ErrorTitle"]" Message="@_errorMessage" />
        <FormActions class="pos-customer-create__footer">
            <Button Variant="ButtonVariant.Secondary" IsLoading="@_loadingRegisters" OnClick="ReloadRegistersAsync">@L["Api_Retry"]</Button>
        </FormActions>
    }

    <section class="pos-shift-open__panel" aria-labelledby="shift-register-heading">
        <h2 id="shift-register-heading" class="pos-shift-open__section-title">@L["Shifts_RegisterSection"]</h2>
        @if (_loadingRegisters)
        {
            <div class="pos-shift-open__loading"><Spinner /></div>
        }
        else if (_available.Count == 0 && string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Shifts_NoRegisterTitle"]" Message="@L["Shifts_NoRegisterMessage"]" />
        }
        else if (_available.Count == 1)
        {
            var register = _available[0];
            <div class="pos-shift-open__register" role="status">
                <span class="pos-shift-open__register-code">@register.RegisterCode</span>
                <span class="pos-shift-open__register-name">@register.Name</span>
            </div>
        }
        else if (_available.Count > 1)
        {
            <Select Label="@L["Shifts_RegisterLabel"]"
                    Value="@_selectedRegisterId"
                    ValueChanged="OnRegisterChanged"
                    Options="@_registerOptions"
                    Disabled="@(blocked || _loadingRegisters)" />
        }
    </section>

    @if (showOpeningCash)
    {
        <section class="pos-shift-open__panel pos-shift-open__panel--cash" aria-labelledby="shift-cash-heading">
            <h2 id="shift-cash-heading" class="pos-shift-open__section-title">@L["Shifts_OpeningCashSection"]</h2>
            <p class="pos-shift-open__help">@(openingCashRequired ? L["Shifts_OpeningCashHelpRequired"] : L["Shifts_OpeningCashHelpOptional"])</p>
            <div class="pos-shift-open__cash">
                <CurrencyInput Label="@L["Shifts_CashOnHand"]"
                               CurrencyCode="@_currencyCode"
                               Placeholder="0.00"
                               Value="@_openingCash"
                               ValueChanged="OnOpeningCashChanged"
                               Required="@openingCashRequired"
                               Disabled="@blocked"
                               IsInvalid="@(!string.IsNullOrEmpty(_openingCashError))"
                               ErrorText="@_openingCashError" />
                @if (_denominations.Count > 0)
                {
                    <button type="button"
                            class="pos-shift-open__denom-action"
                            disabled="@blocked"
                            @onclick="() => _showDenominationHelper = true">
                        <span class="pos-shift-open__denom-icon" aria-hidden="true">@IconGlyphs.Get("cash")</span>
                        <span>@L["Shifts_CountByDenomination"]</span>
                    </button>
                }
                @if (_openingLines is { Count: > 0 } && _openingCash is not null)
                {
                    <p class="pos-shift-open__counted" role="status">
                        <span class="pos-shift-open__counted-icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                        <span>@L["Shifts_CountedByDenomination"]</span>
                    </p>
                }
            </div>
        </section>
    }

    <div class="pos-shift-open__footer" role="group" aria-label="@L["Shifts_OpenTitle"]">
        @if (showOpeningCash && openingCashOptional)
        {
            <Button Variant="ButtonVariant.Ghost"
                    Disabled="@startBlocked"
                    OnClick="() => OpenAsync(skipOpeningCash: true)">@L["Shifts_SkipOpeningCash"]</Button>
        }
        <Button Variant="ButtonVariant.Primary"
                IsLoading="@_saving"
                Disabled="@startBlocked"
                OnClick="() => OpenAsync(skipOpeningCash: !showOpeningCash)">@L["Shifts_OpenConfirm"]</Button>
    </div>
    <DenominationCountSheet Visible="@_showDenominationHelper"
                            VisibleChanged="v => _showDenominationHelper = v"
                            Denominations="@_denominations"
                            OnUseTotal="OnOpeningDenominationTotal" />
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private bool _loadingRegisters;
    private decimal? _openingCash;
    private string? _openingCashError;
    private string _cashCountMode = "Required";
    private string _currencyCode = "PHP";
    private string? _errorMessage;
    private string? _selectedRegisterId;
    private Guid _selectedRegisterGuid;
    private bool _showDenominationHelper;
    private IReadOnlyList<PosRegisterSummaryDto> _available = Array.Empty<PosRegisterSummaryDto>();
    private IReadOnlyList<SelectOption> _registerOptions = Array.Empty<SelectOption>();
    private IReadOnlyList<OrganizationCashDenominationDto> _denominations = Array.Empty<OrganizationCashDenominationDto>();
    private IReadOnlyList<CashCountDenominationLineDto>? _openingLines;

    private bool showOpeningCash => true;
    private bool openingCashRequired => string.Equals(_cashCountMode, "Required", StringComparison.OrdinalIgnoreCase);
    private bool openingCashOptional => !openingCashRequired;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewShifts)
            || !Capabilities.IsAllowed(UtangCapability.ManageShifts))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!_isOffline)
        {
            var current = await Shifts.GetCurrentAsync();
            if (current.IsSuccess
                && current.Data is not null
                && string.Equals(current.Data.Status, "Open", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo($"/shifts/{current.Data.ShiftId:D}", replace: true);
                return;
            }

            await LoadAvailableRegistersAsync();
            await LoadCashCountModeAsync();
            await LoadDenominationsAsync();
        }

        _ready = true;
    }

    private async Task LoadCashCountModeAsync()
    {
        var setup = await SetupClient.GetAsync();
        if (setup.IsSuccess && setup.Data is not null)
        {
            if (!string.IsNullOrWhiteSpace(setup.Data.CurrencyCode))
            {
                _currencyCode = setup.Data.CurrencyCode.Trim().ToUpperInvariant();
            }

            if (!string.IsNullOrWhiteSpace(setup.Data.CashCountMode)
                && !string.Equals(setup.Data.CashCountMode, "Off", StringComparison.OrdinalIgnoreCase))
            {
                _cashCountMode = setup.Data.CashCountMode;
            }
            else if (string.Equals(setup.Data.CashCountMode, "Off", StringComparison.OrdinalIgnoreCase))
            {
                _cashCountMode = "Optional";
            }
        }
    }

    private async Task LoadDenominationsAsync()
    {
        var result = await SetupClient.ListCashDenominationsAsync();
        if (result.IsSuccess && result.Data is not null)
        {
            _denominations = result.Data.Where(d => d.IsEnabled).OrderByDescending(d => d.Value).ToList();
        }
    }

    private void OnOpeningCashChanged(decimal? value)
    {
        _openingCash = value;
        if (_openingLines is { Count: > 0 }
            && (value is null || _openingLines.Sum(l => l.DenominationValue * l.Quantity) != value.Value))
        {
            _openingLines = null;
        }
    }

    private void OnOpeningDenominationTotal((decimal Total, IReadOnlyList<CashCountDenominationLineDto> Lines) result)
    {
        _openingCash = result.Total;
        _openingLines = result.Lines;
        _openingCashError = null;
    }

    private Task ReloadRegistersAsync() => LoadAvailableRegistersAsync();

    private async Task LoadAvailableRegistersAsync()
    {
        _loadingRegisters = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await Registers.ListAvailableForShiftAsync();
            if (result.IsSuccess && result.Data is { Count: > 0 })
            {
                ApplyAvailable(result.Data);
                return;
            }

            // Fallback: list Active registers without an open shift (covers empty available payload
            // after a commercial/auth mismatch was cleared, or deserialize edge cases).
            var listed = await Registers.ListAsync(
                status: PosCatalogOptions.ActiveStatus,
                hasOpenShift: false,
                page: 1,
                pageSize: 50);
            if (listed.IsSuccess && listed.Data is { Items.Count: > 0 })
            {
                ApplyAvailable(listed.Data.Items
                    .Select(r => new PosRegisterSummaryDto(r.RegisterId, r.RegisterCode, r.Name, r.Status))
                    .ToList());
                return;
            }

            _available = Array.Empty<PosRegisterSummaryDto>();
            _registerOptions = Array.Empty<SelectOption>();
            _selectedRegisterGuid = Guid.Empty;
            _selectedRegisterId = null;

            if (!result.IsSuccess)
            {
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
            else if (!listed.IsSuccess)
            {
                var described = ApiLocalizer.Describe(listed.Status, listed.Error);
                _errorMessage = listed.Error?.Detail ?? described.Message;
            }
        }
        catch (Exception ex)
        {
            _available = Array.Empty<PosRegisterSummaryDto>();
            _registerOptions = Array.Empty<SelectOption>();
            _selectedRegisterGuid = Guid.Empty;
            _selectedRegisterId = null;
            _errorMessage = ex.Message;
        }
        finally
        {
            _loadingRegisters = false;
        }
    }

    private void ApplyAvailable(IReadOnlyList<PosRegisterSummaryDto> items)
    {
        _available = items;
        _registerOptions = items
            .Select(r => new SelectOption(r.RegisterId.ToString("D"), $"{r.RegisterCode} — {r.Name}"))
            .ToList();
        _errorMessage = null;

        if (_available.Count == 1)
        {
            _selectedRegisterGuid = _available[0].RegisterId;
            _selectedRegisterId = _selectedRegisterGuid.ToString("D");
        }
        else if (_selectedRegisterGuid != Guid.Empty
                 && _available.All(r => r.RegisterId != _selectedRegisterGuid))
        {
            _selectedRegisterGuid = Guid.Empty;
            _selectedRegisterId = null;
        }
    }

    private void OnRegisterChanged(string? value)
    {
        if (string.Equals(value, _selectedRegisterId, StringComparison.Ordinal))
        {
            return;
        }

        _selectedRegisterId = value;
        _selectedRegisterGuid = Guid.TryParse(value, out var id) ? id : Guid.Empty;
    }

    private async Task OpenAsync(bool skipOpeningCash = false)
    {
        if (_saving || _isOffline || _selectedRegisterGuid == Guid.Empty
            || !Capabilities.IsAllowed(UtangCapability.ManageShifts))
        {
            return;
        }

        _openingCashError = null;
        if (openingCashRequired && (skipOpeningCash || _openingCash is null))
        {
            _openingCashError = L["Shifts_OpeningCashRequired"];
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            // Block duplicate open when an open shift already exists for this cashier.
            var current = await Shifts.GetCurrentAsync();
            if (current.IsSuccess
                && current.Data is not null
                && string.Equals(current.Data.Status, "Open", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo($"/shifts/{current.Data.ShiftId:D}");
                return;
            }

            var opening = skipOpeningCash || !showOpeningCash ? null : _openingCash;
            var lines = skipOpeningCash || opening is null ? null : _openingLines;
            var result = await Shifts.OpenAsync(new OpenCashierShiftRequest(_selectedRegisterGuid, opening, DenominationLines: lines));
            if (result.IsSuccess && result.Data is not null)
            {
                Nav.NavigateTo($"/shifts/{result.Data.ShiftId:D}");
                return;
            }

            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorMessage = result.Error?.Detail ?? described.Message;
            if (!_isOffline)
            {
                await LoadAvailableRegistersAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }
}

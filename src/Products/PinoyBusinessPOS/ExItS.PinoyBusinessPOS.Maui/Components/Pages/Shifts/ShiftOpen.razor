@page "/shifts/open"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosCashierShiftClient Shifts
@inject IPosRegisterClient Registers
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var blocked = _isOffline || !Capabilities.IsAllowed(UtangCapability.ManageShifts);
<Page>
    <PageHeader Title="@L["Shifts_OpenTitle"]" Subtitle="@L["Shifts_OpenSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoList">@L["Shifts_BackToList"]</Button>
        </Actions>
    </PageHeader>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Shifts_OfflineTitle"]" Message="@L["Shifts_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Shifts_ErrorTitle"]" Message="@_errorMessage" />
        <FormActions>
            <Button Variant="ButtonVariant.Secondary" IsLoading="@_loadingRegisters" OnClick="ReloadRegistersAsync">@L["Api_Retry"]</Button>
        </FormActions>
    }

    <Section Title="@L["Shifts_RegisterSection"]">
        @if (_loadingRegisters)
        {
            <Spinner />
        }
        else if (_available.Count == 0 && string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Shifts_NoRegisterTitle"]" Message="@L["Shifts_NoRegisterMessage"]" />
        }
        else if (_available.Count > 0)
        {
            <Select Label="@L["Shifts_RegisterLabel"]"
                    Value="@_selectedRegisterId"
                    ValueChanged="OnRegisterChanged"
                    Options="@_registerOptions"
                    Disabled="@(blocked || _loadingRegisters)" />
        }
    </Section>

    <Section Title="@L["Shifts_OpeningCashSection"]">
        <NumberInput Label="@L["Shifts_OpeningCashLabel"]"
                     Value="@_openingCash"
                     ValueChanged="v => _openingCash = v ?? 0m"
                     DecimalPlaces="2"
                     Disabled="@blocked" />
        <FormActions>
            <Button Variant="ButtonVariant.Primary"
                    IsLoading="@_saving"
                    Disabled="@(blocked || _selectedRegisterGuid == Guid.Empty || _available.Count == 0 || !string.IsNullOrEmpty(_errorMessage))"
                    OnClick="OpenAsync">@L["Shifts_OpenConfirm"]</Button>
        </FormActions>
    </Section>
</Page>
}

@code {
    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private bool _loadingRegisters;
    private decimal _openingCash;
    private string? _errorMessage;
    private string? _selectedRegisterId;
    private Guid _selectedRegisterGuid;
    private IReadOnlyList<PosRegisterSummaryDto> _available = Array.Empty<PosRegisterSummaryDto>();
    private IReadOnlyList<SelectOption> _registerOptions = Array.Empty<SelectOption>();

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewShifts)
            || !Capabilities.IsAllowed(UtangCapability.ManageShifts))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!_isOffline)
        {
            var current = await Shifts.GetCurrentAsync();
            if (current.IsSuccess
                && current.Data is not null
                && string.Equals(current.Data.Status, "Open", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo($"/shifts/{current.Data.ShiftId:D}", replace: true);
                return;
            }

            await LoadAvailableRegistersAsync();
        }

        _ready = true;
    }

    private Task ReloadRegistersAsync() => LoadAvailableRegistersAsync();

    private async Task LoadAvailableRegistersAsync()
    {
        _loadingRegisters = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await Registers.ListAvailableForShiftAsync();
            if (result.IsSuccess && result.Data is { Count: > 0 })
            {
                ApplyAvailable(result.Data);
                return;
            }

            // Fallback: list Active registers without an open shift (covers empty available payload
            // after a commercial/auth mismatch was cleared, or deserialize edge cases).
            var listed = await Registers.ListAsync(
                status: PosCatalogOptions.ActiveStatus,
                hasOpenShift: false,
                page: 1,
                pageSize: 50);
            if (listed.IsSuccess && listed.Data is { Items.Count: > 0 })
            {
                ApplyAvailable(listed.Data.Items
                    .Select(r => new PosRegisterSummaryDto(r.RegisterId, r.RegisterCode, r.Name, r.Status))
                    .ToList());
                return;
            }

            _available = Array.Empty<PosRegisterSummaryDto>();
            _registerOptions = Array.Empty<SelectOption>();
            _selectedRegisterGuid = Guid.Empty;
            _selectedRegisterId = null;

            if (!result.IsSuccess)
            {
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
            else if (!listed.IsSuccess)
            {
                var described = ApiLocalizer.Describe(listed.Status, listed.Error);
                _errorMessage = listed.Error?.Detail ?? described.Message;
            }
        }
        catch (Exception ex)
        {
            _available = Array.Empty<PosRegisterSummaryDto>();
            _registerOptions = Array.Empty<SelectOption>();
            _selectedRegisterGuid = Guid.Empty;
            _selectedRegisterId = null;
            _errorMessage = ex.Message;
        }
        finally
        {
            _loadingRegisters = false;
        }
    }

    private void ApplyAvailable(IReadOnlyList<PosRegisterSummaryDto> items)
    {
        _available = items;
        _registerOptions = items
            .Select(r => new SelectOption(r.RegisterId.ToString("D"), $"{r.RegisterCode} — {r.Name}"))
            .ToList();
        _errorMessage = null;

        if (_available.Count == 1)
        {
            _selectedRegisterGuid = _available[0].RegisterId;
            _selectedRegisterId = _selectedRegisterGuid.ToString("D");
        }
        else if (_selectedRegisterGuid != Guid.Empty
                 && _available.All(r => r.RegisterId != _selectedRegisterGuid))
        {
            _selectedRegisterGuid = Guid.Empty;
            _selectedRegisterId = null;
        }
    }

    private void OnRegisterChanged(string? value)
    {
        if (string.Equals(value, _selectedRegisterId, StringComparison.Ordinal))
        {
            return;
        }

        _selectedRegisterId = value;
        _selectedRegisterGuid = Guid.TryParse(value, out var id) ? id : Guid.Empty;
    }

    private async Task OpenAsync()
    {
        if (_saving || _isOffline || _selectedRegisterGuid == Guid.Empty
            || !Capabilities.IsAllowed(UtangCapability.ManageShifts))
        {
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            // Block duplicate open when an open shift already exists for this cashier.
            var current = await Shifts.GetCurrentAsync();
            if (current.IsSuccess
                && current.Data is not null
                && string.Equals(current.Data.Status, "Open", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo($"/shifts/{current.Data.ShiftId:D}");
                return;
            }

            var result = await Shifts.OpenAsync(new OpenCashierShiftRequest(_selectedRegisterGuid, _openingCash));
            if (result.IsSuccess && result.Data is not null)
            {
                Nav.NavigateTo($"/shifts/{result.Data.ShiftId:D}");
                return;
            }

            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorMessage = result.Error?.Detail ?? described.Message;
            if (!_isOffline)
            {
                await LoadAvailableRegistersAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoList() => Nav.NavigateTo("/shifts");
}

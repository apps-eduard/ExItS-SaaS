@page "/suppliers/connected/buyers/{RelationshipId:guid}/shared-products"
@using System.Globalization
@using ExItS.PinoyBusinessPOS.Application.ConnectedSuppliers
@using ExItS.PinoyBusinessPOS.Maui.Services
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject BuyerShareDraftState Draft
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/suppliers/connected/buyers/{RelationshipId:D}")" />

<div class="pos-manage-share @(_selectedCount > 0 || _selectAllMatching ? "pos-manage-share--has-selection" : null)">
<Page>
    <header class="pos-manage-share__header">
        <h1 class="pos-manage-share__title">@L["ConnectedBuyers_ManageProductsTitle"]</h1>
        @if (!string.IsNullOrWhiteSpace(_buyerDisplayName))
        {
            <p class="pos-manage-share__buyer">@_buyerDisplayName</p>
        }
        @if (!_loading && string.IsNullOrWhiteSpace(_error))
        {
            <p class="pos-manage-share__summary pos-muted">
                @L["ConnectedBuyers_ShareSummary", _sharedCount, _eligibleCount]
            </p>
            <p class="pos-manage-share__subtitle pos-muted">@L["ConnectedBuyers_ManageProductsSubtitle"]</p>
        }
    </header>

    @if (_loading && _items.Count == 0)
    {
        <Spinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                    Message="@_error"
                    RetryLabel="@L["Common_Retry"]"
                    OnRetry="() => ReloadAsync(resetPage: true)" />
    }
    else
    {
        <SearchBar Value="@_query"
                   ValueChanged="OnSearchInput"
                   Placeholder="@L["ConnectedBuyers_SearchProducts"]"
                   Disabled="@_busy"
                   OnClear="ClearSearch" />

        <div class="pos-manage-share__filters" role="tablist" aria-label="@L["ConnectedBuyers_ManageProductsTitle"]">
            @foreach (var filter in ShareFilters)
            {
                <button type="button"
                        class="pos-category-chip @(_shareFilter == filter.Value ? "pos-category-chip--selected" : null)"
                        role="tab"
                        aria-selected="@(_shareFilter == filter.Value)"
                        disabled="@_busy"
                        @onclick="() => SetShareFilterAsync(filter.Value)">
                    @filter.Label
                </button>
            }
        </div>

        <div class="pos-manage-share__category-row">
            <button type="button"
                    class="pos-manage-share__category-btn"
                    disabled="@_busy"
                    @onclick="() => _categorySheetOpen = true">
                @L["ConnectedBuyers_CategoryControl", CategoryButtonLabel]
            </button>
        </div>

        @if (_selectAllMatching)
        {
            <p class="pos-manage-share__select-banner" role="status">
                @L["ConnectedBuyers_AllMatchingSelected", _matchingCount]
                <button type="button" class="pos-link-button" disabled="@_busy" @onclick="ClearSelection">@L["ConnectedBuyers_ClearSelection"]</button>
            </p>
        }
        else if (_matchingCount > _items.Count && _pageSelected.Count == _items.Count && _items.Count > 0)
        {
            <p class="pos-manage-share__select-banner" role="status">
                @L["ConnectedBuyers_PageSelectedCount", _pageSelected.Count]
                <button type="button" class="pos-link-button" disabled="@_busy" @onclick="SelectAllMatching">
                    @L["ConnectedBuyers_SelectAllMatching", _matchingCount]
                </button>
            </p>
        }

        @if (_items.Count == 0)
        {
            <EmptyState IconName="products"
                        Title="@EmptyStateTitle"
                        Message="@EmptyStateMessage" />
        }
        else
        {
            <div class="pos-manage-share__list" role="list">
                <label class="pos-manage-share__select-all">
                    <input type="checkbox"
                           checked="@PageAllSelected"
                           disabled="@(_busy || !CanManage)"
                           @onchange="OnTogglePageSelect" />
                    <span>@L["ConnectedBuyers_SelectVisible", _items.Count]</span>
                </label>
                @foreach (var product in _items)
                {
                    var selected = _selectAllMatching || _pageSelected.Contains(product.SupplierProductId);
                    var effective = product.EffectiveBuyerPrice;
                    var rowDisabled = product.IsBlocked;
                    <article class="pos-manage-share__row @(selected ? "pos-manage-share__row--selected" : null) @(rowDisabled ? "pos-manage-share__row--disabled" : null)"
                             role="listitem"
                             aria-selected="@selected"
                             aria-disabled="@rowDisabled">
                        <label class="pos-manage-share__check">
                            <input type="checkbox"
                                   checked="@selected"
                                   disabled="@(_busy || !CanManage || _selectAllMatching || rowDisabled)"
                                   aria-label="@L["ConnectedBuyers_SelectProduct", product.Name]"
                                   @onchange="args => ToggleOne(product.SupplierProductId, args)" />
                        </label>
                        <button type="button"
                                class="pos-manage-share__body"
                                disabled="@(_busy || rowDisabled)"
                                @onclick="() => OpenDetail(product)">
                            <span class="pos-manage-share__name">@product.Name</span>
                            <span class="pos-manage-share__meta pos-muted">
                                @if (!string.IsNullOrWhiteSpace(product.Sku))
                                {
                                    @product.Sku
                                    <text> · </text>
                                }
                                @(string.IsNullOrWhiteSpace(product.Category)
                                    ? L["ConnectedBuyers_FilterUncategorized"]
                                    : product.Category)
                            </span>
                            <span class="pos-manage-share__line3">
                                @if (product.IsBlocked)
                                {
                                    <span class="pos-manage-share__state">@L["ConnectedBuyers_BlockedForConnectedBuyers"]</span>
                                }
                                else
                                {
                                    <span class="pos-manage-share__buyer-price">
                                        <span class="pos-manage-share__price-label">@L["ConnectedBuyers_BuyerPrice"]</span>
                                        @if (effective is decimal buyerPay)
                                        {
                                            <MoneyDisplay Amount="@buyerPay" CurrencyCode="PHP" />
                                        }
                                        else if (product.DefaultPoPrice is null)
                                        {
                                            <span class="pos-muted">@L["ConnectedBuyers_DefaultPoNotSet"]</span>
                                        }
                                        else
                                        {
                                            <span class="pos-muted">—</span>
                                        }
                                    </span>
                                    <span class="pos-muted" aria-hidden="true">·</span>
                                    <span class="pos-manage-share__price-note pos-muted">
                                        @if (product.DefaultPoPrice is null)
                                        {
                                            @L["ConnectedBuyers_DefaultPoNotSet"]
                                        }
                                        else if (product.HasCustomPrice)
                                        {
                                            @L["ConnectedBuyers_DefaultPoShort"]
                                            <text> </text>
                                            <MoneyDisplay Amount="@(product.DefaultPoPrice ?? 0m)" CurrencyCode="PHP" />
                                        }
                                        else
                                        {
                                            @L["ConnectedBuyers_UsesDefaultPo"]
                                        }
                                    </span>
                                    <span class="pos-muted" aria-hidden="true">·</span>
                                    <span class="pos-manage-share__state @(product.IsShared ? "pos-manage-share__state--shared" : null)">
                                        @(product.IsShared ? L["ConnectedBuyers_FilterShared"] : L["ConnectedBuyers_FilterNotShared"])
                                        @if (product.IsShared && product.HasCustomPrice)
                                        {
                                            <text> · @L["ConnectedBuyers_FilterCustomPrice"]</text>
                                        }
                                    </span>
                                }
                            </span>
                        </button>
                    </article>
                }
            </div>

            @if (_hasMore)
            {
                <div class="pos-manage-share__more">
                    <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="LoadMoreAsync">
                        <span class="pos-action-tile__label">@L["Common_LoadMore"]</span>
                    </button>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_banner))
        {
            <p class="pos-manage-share__banner" role="status">@_banner</p>
        }
    }
</Page>

@if (CanManage && (_selectedCount > 0 || _selectAllMatching))
{
    <div class="pos-manage-share__sticky" role="region" aria-label="@L["ConnectedBuyers_BulkActions"]">
        <div class="pos-manage-share__sticky-meta" aria-live="polite">
            @(_selectAllMatching
                ? L["ConnectedBuyers_AllMatchingSelected", _matchingCount]
                : L["ConnectedBuyers_SelectedCount", _selectedCount])
        </div>
        <div class="pos-manage-share__sticky-actions">
            <button type="button" class="pos-manage-share__action" disabled="@_busy" @onclick="() => BulkShareAsync(true)">@L["ConnectedBuyers_BulkShare"]</button>
            <button type="button" class="pos-manage-share__action pos-manage-share__action--danger" disabled="@_busy" @onclick="() => BulkShareAsync(false)">@L["ConnectedBuyers_BulkUnshare"]</button>
            <button type="button" class="pos-manage-share__action pos-manage-share__action--primary" disabled="@_busy" @onclick="OpenPriceSheet">@L["ConnectedBuyers_BulkPrice"]</button>
        </div>
        <button type="button" class="pos-manage-share__clear" disabled="@_busy" @onclick="ClearSelection">@L["ConnectedBuyers_ClearSelection"]</button>
    </div>
}

@if (_categorySheetOpen)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_FilterCategory"]">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit">
            <header class="pos-denom-sheet__header">
                <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_FilterCategory"]</h2>
            </header>
            <div class="pos-denom-sheet__list pos-denom-sheet__list--fit">
                <button type="button" class="pos-denom-sheet__item @(_categoryFilter == "all" ? "pos-denom-sheet__item--active" : null)"
                        @onclick="SelectAllCategoriesAsync">
                    <span>@L["ConnectedBuyers_FilterAllCategories"]</span>
                    <span class="pos-muted">@_eligibleCount</span>
                </button>
                @foreach (var facet in _categories)
                {
                    var value = string.IsNullOrWhiteSpace(facet.CategoryName) ? "__uncategorized__" : facet.CategoryName!;
                    var label = string.IsNullOrWhiteSpace(facet.CategoryName) ? L["ConnectedBuyers_FilterUncategorized"].Value : facet.CategoryName!;
                    <button type="button" class="pos-denom-sheet__item @(_categoryFilter == value ? "pos-denom-sheet__item--active" : null)"
                            @onclick="() => SetCategoryAsync(value)">
                        <span>@label</span>
                        <span class="pos-muted">@facet.Count</span>
                    </button>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" @onclick="() => _categorySheetOpen = false">
                    <span class="pos-action-tile__label">@L["Common_Close"]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_priceSheetOpen)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_SetBuyerPriceTitle"]">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit pos-manage-share__price-panel">
            <header class="pos-denom-sheet__header pos-manage-share__sheet-header">
                <div>
                    <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_SetBuyerPriceTitle"]</h2>
                    <p class="pos-manage-share__sheet-count" aria-live="polite">@SelectionProductsLabel</p>
                    <p class="pos-denom-sheet__hint">@L["ConnectedBuyers_PriceRuleBaseline"]</p>
                </div>
            </header>
            <div class="pos-manage-share__sheet-body" role="radiogroup" aria-label="@L["ConnectedBuyers_SetBuyerPriceTitle"]">
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="price-mode" checked="@(_priceMode == "UseDefault")" @onchange="SetUseDefaultMode" />
                    <span>
                        <strong>@L["ConnectedBuyers_UseDefaultPoPrice"]</strong>
                        <span class="pos-manage-share__option-help">@L["ConnectedBuyers_UseDefaultPoHelp"]</span>
                    </span>
                </label>
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="price-mode" checked="@(_priceMode == "DiscountPercent")" @onchange="SetDiscountMode" />
                    <span>
                        <strong>@L["ConnectedBuyers_DiscountByPercent"]</strong>
                        <span class="pos-manage-share__option-help">@L["ConnectedBuyers_CalculatedSeparately"]</span>
                    </span>
                </label>
                @if (_priceMode == "DiscountPercent")
                {
                    <label class="pos-manage-share__field">
                        <span class="pos-manage-share__field-label">@L["ConnectedBuyers_DiscountLabel"]</span>
                        <span class="pos-manage-share__field-control">
                            <input class="pos-manage-share__price-input"
                                   type="number"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   inputmode="decimal"
                                   aria-label="@L["ConnectedBuyers_DiscountLabel"]"
                                   @bind="_percentText"
                                   @bind:event="oninput" />
                            <span class="pos-manage-share__unit" aria-hidden="true">%</span>
                        </span>
                    </label>
                }
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="price-mode" checked="@(_priceMode == "AdjustAmount")" @onchange="SetAdjustMode" />
                    <span>
                        <strong>@L["ConnectedBuyers_AdjustByAmount"]</strong>
                        <span class="pos-manage-share__option-help">@L["ConnectedBuyers_AdjustSeparately"]</span>
                    </span>
                </label>
                @if (_priceMode == "AdjustAmount")
                {
                    <label class="pos-manage-share__field">
                        <span class="pos-manage-share__field-label">@L["ConnectedBuyers_AdjustmentLabel"]</span>
                        <span class="pos-manage-share__field-control">
                            <span class="pos-manage-share__unit" aria-hidden="true">PHP</span>
                            <input class="pos-manage-share__price-input"
                                   type="number"
                                   step="0.01"
                                   inputmode="decimal"
                                   aria-label="@L["ConnectedBuyers_AdjustmentLabel"]"
                                   @bind="_amountText"
                                   @bind:event="oninput" />
                        </span>
                    </label>
                }
                @if (!string.IsNullOrWhiteSpace(_priceError))
                {
                    <p class="pos-manage-share__banner" role="alert">@_priceError</p>
                }
            </div>
            <div class="pos-denom-sheet__bar pos-manage-share__sheet-bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="() => _priceSheetOpen = false">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="PreviewPriceAsync">
                    <span class="pos-action-tile__label">@L["ConnectedBuyers_PricePreview"]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_preview is not null)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_ReviewPricesTitle"]">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit pos-manage-share__price-panel">
            <header class="pos-denom-sheet__header pos-manage-share__sheet-header">
                <div>
                    <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_ReviewPricesTitle"]</h2>
                    <p class="pos-manage-share__sheet-count">@L["ConnectedBuyers_PricePreviewCount", _preview.AffectedCount]</p>
                </div>
            </header>
            <div class="pos-manage-share__sheet-body">
                @foreach (var item in _preview.Items)
                {
                    var useDefault = item.ProposedBuyerPrice is null;
                    <div class="pos-manage-share__preview-card">
                        <div class="pos-manage-share__preview-title">
                            <strong>@item.Name</strong>
                        </div>
                        <div class="pos-manage-share__preview-grid">
                            @if (useDefault)
                            {
                                <span class="pos-manage-share__price-label">@L["ConnectedBuyers_CurrentBuyerPrice"]</span>
                                @if (item.CurrentBuyerPrice is decimal current)
                                {
                                    <MoneyDisplay Amount="@current" CurrencyCode="PHP" />
                                }
                                else
                                {
                                    <MoneyDisplay Amount="@item.DefaultPoPrice" CurrencyCode="PHP" />
                                }
                                <span class="pos-manage-share__price-label pos-manage-share__price-label--new">@L["ConnectedBuyers_NewBuyerPrice"]</span>
                                <span class="pos-manage-share__new-price">
                                    <MoneyDisplay Amount="@item.ProposedEffectivePrice" CurrencyCode="PHP" />
                                </span>
                                <span class="pos-manage-share__price-label">@L["ConnectedBuyers_UsesDefaultPo"]</span>
                                <span></span>
                            }
                            else
                            {
                                <span class="pos-manage-share__price-label">@L["ConnectedBuyers_DefaultPoShort"]</span>
                                <MoneyDisplay Amount="@item.DefaultPoPrice" CurrencyCode="PHP" />
                                <span class="pos-manage-share__price-label pos-manage-share__price-label--new">@L["ConnectedBuyers_BuyerPrice"]</span>
                                <span class="pos-manage-share__new-price">
                                    <MoneyDisplay Amount="@item.ProposedEffectivePrice" CurrencyCode="PHP" />
                                </span>
                            }
                        </div>
                    </div>
                }
                @if (_preview.Truncated)
                {
                    <p class="pos-muted">@L["ConnectedBuyers_PricePreviewTruncated"]</p>
                }
            </div>
            <div class="pos-denom-sheet__bar pos-manage-share__sheet-bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="BackToPriceSheet">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="ApplyPriceAsync">
                    <span class="pos-action-tile__label">@L["ConnectedBuyers_ApplyToCount", _preview.AffectedCount]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_detail is not null)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@_detail.Name">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit pos-manage-share__price-panel">
            <header class="pos-denom-sheet__header pos-manage-share__sheet-header">
                <div>
                    <h2 class="pos-denom-sheet__title">@_detail.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(_detail.Sku))
                    {
                        <p class="pos-manage-share__sheet-count pos-muted">@_detail.Sku</p>
                    }
                    @if (_detail.NeedsEstablishDefaultPo)
                    {
                        <p class="pos-denom-sheet__hint">@L["ConnectedBuyers_EstablishDefaultPoHelp"]</p>
                    }
                </div>
            </header>
            <div class="pos-manage-share__sheet-body">
                <div class="pos-manage-share__detail-block">
                    <span class="pos-manage-share__price-label">@L["ConnectedBuyers_DefaultPoShort"]</span>
                    @if (_detail.NeedsEstablishDefaultPo)
                    {
                        <p class="pos-muted">@L["ConnectedBuyers_RetailReference", _detail.SellingPrice]</p>
                        <CurrencyInput Label="@L["Catalog_ConnectedBuyers_DefaultPoPrice"]"
                                       Value="@_detail.EstablishDefaultPoPrice"
                                       ValueChanged="v => _detail.EstablishDefaultPoPrice = v"
                                       CurrencyCode="PHP"
                                       Disabled="@(_busy || !CanManage)" />
                    }
                    else if (_detail.DefaultPoPrice is decimal existingPo)
                    {
                        <span class="pos-manage-share__detail-value">
                            <MoneyDisplay Amount="@existingPo" CurrencyCode="PHP" />
                        </span>
                    }
                    else
                    {
                        <span class="pos-muted">@L["ConnectedBuyers_DefaultPoNotSet"]</span>
                    }
                </div>

                <div class="pos-manage-share__detail-block">
                    <span class="pos-manage-share__price-label">@L["ConnectedBuyers_AvailabilityForBuyer"]</span>
                    <label class="pos-manage-share__toggle">
                        <input type="checkbox"
                               checked="@_detail.IsShared"
                               disabled="@(_busy || !CanManage)"
                               @onchange="args => _detail.IsShared = Checked(args)" />
                        <span>@(_detail.IsShared ? L["ConnectedBuyers_FilterShared"] : L["ConnectedBuyers_FilterNotShared"])</span>
                    </label>
                </div>

                @if (!_detail.NeedsEstablishDefaultPo)
                {
                    <div class="pos-manage-share__detail-block">
                        <span class="pos-manage-share__price-label">@L["ConnectedBuyers_BuyerPrice"]</span>
                        <label class="pos-manage-share__price-option">
                            <input type="radio" name="detail-price" checked="@(!_detail.UseOverride)" @onchange="() => _detail.UseOverride = false" />
                            <span>
                                <strong>@L["ConnectedBuyers_UseDefaultPoPrice"]</strong>
                                @if (_detail.DefaultPoPrice is decimal defPo)
                                {
                                    <span class="pos-manage-share__option-help">
                                        <MoneyDisplay Amount="@defPo" CurrencyCode="PHP" />
                                    </span>
                                }
                            </span>
                        </label>
                        <label class="pos-manage-share__price-option">
                            <input type="radio" name="detail-price" checked="@_detail.UseOverride" @onchange="() => _detail.UseOverride = true" />
                            <span><strong>@L["ConnectedBuyers_CustomBuyerPrice"]</strong></span>
                        </label>
                        @if (_detail.UseOverride)
                        {
                            <CurrencyInput Label="@L["ConnectedBuyers_BuyerPrice"]"
                                           Value="@_detail.BuyerSpecificPoPrice"
                                           ValueChanged="v => _detail.BuyerSpecificPoPrice = v"
                                           CurrencyCode="PHP"
                                           Disabled="@(_busy || !CanManage)" />
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_detailError))
                {
                    <p class="pos-manage-share__banner" role="alert">@_detailError</p>
                }
            </div>
            <div class="pos-denom-sheet__bar pos-manage-share__sheet-bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="CloseDetail">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@(_busy || !CanManage)" @onclick="SaveDetailAsync">
                    <span class="pos-action-tile__label">
                        @(_detail.NeedsEstablishDefaultPo && _detail.IsShared
                            ? L["ConnectedBuyers_ConfirmShareWithDefaultPo"]
                            : L["Common_Save"])
                    </span>
                </button>
            </div>
        </div>
    </div>
}

@if (_missingPoSheet is { Count: > 0 })
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_MissingDefaultPoTitle", _missingPoSheet.Count]">
        <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit">
            <header class="pos-denom-sheet__header pos-manage-share__sheet-header">
                <div>
                    <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_MissingDefaultPoTitle", _missingPoSheet.Count]</h2>
                    <p class="pos-denom-sheet__hint">@L["ConnectedBuyers_EstablishDefaultPoHelp"]</p>
                </div>
            </header>
            <div class="pos-denom-sheet__list pos-denom-sheet__list--fit">
                @foreach (var item in _missingPoSheet)
                {
                    <div class="pos-manage-share__preview-row" role="listitem">
                        <div class="pos-manage-share__preview-meta">
                            <strong>@item.Name</strong>
                            <span class="pos-muted">@L["ConnectedBuyers_RetailReference", item.SellingPrice]</span>
                        </div>
                        <CurrencyInput Label="@L["Catalog_ConnectedBuyers_DefaultPoPrice"]"
                                       Value="@item.EstablishDefaultPoPrice"
                                       ValueChanged="v => item.EstablishDefaultPoPrice = v"
                                       CurrencyCode="PHP"
                                       Disabled="@_busy" />
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_missingPoError))
                {
                    <p class="pos-manage-share__banner" role="alert">@_missingPoError</p>
                }
            </div>
            <div class="pos-denom-sheet__bar pos-manage-share__sheet-bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="CloseMissingPoSheet">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="ConfirmMissingPoShareAsync">
                    <span class="pos-action-tile__label">
                        @(_missingPoForPricing
                            ? L["ConnectedBuyers_ConfirmDefaultPoAndContinue"]
                            : L["ConnectedBuyers_ConfirmShareWithDefaultPo"])
                    </span>
                </button>
            </div>
        </div>
    </div>
}
</div>

<style>
    .pos-manage-share { width: 100%; padding-bottom: 0.5rem; }
    .pos-manage-share--has-selection { padding-bottom: 7.25rem; }

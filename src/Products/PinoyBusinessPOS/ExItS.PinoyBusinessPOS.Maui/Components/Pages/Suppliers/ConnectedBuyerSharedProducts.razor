@page "/suppliers/connected/buyers/{RelationshipId:guid}/shared-products"
@using ExItS.PinoyBusinessPOS.Application.ConnectedSuppliers
@using ExItS.PinoyBusinessPOS.Maui.Services
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject BuyerShareDraftState Draft
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/suppliers/connected/buyers/{RelationshipId:D}")" />

<div class="pos-manage-share @(_selectedCount > 0 || _selectAllMatching ? "pos-manage-share--has-selection" : null)">
<Page>
    <header class="pos-manage-share__header">
        <h1 class="pos-manage-share__title">@L["ConnectedBuyers_ManageProductsTitle"]</h1>
        @if (!_loading && string.IsNullOrWhiteSpace(_error))
        {
            <p class="pos-manage-share__summary pos-muted">
                @L["ConnectedBuyers_ShareSummary", _sharedCount, _eligibleCount]
            </p>
        }
    </header>

    @if (_loading && _items.Count == 0)
    {
        <Spinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _items.Count == 0)
    {
        <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                    Message="@_error"
                    RetryLabel="@L["Common_Retry"]"
                    OnRetry="() => ReloadAsync(resetPage: true)" />
    }
    else
    {
        <div class="pos-manage-share__search" role="search">
            <span class="pos-manage-share__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
            <input class="pos-manage-share__search-input"
                   type="search"
                   value="@_query"
                   placeholder="@L["ConnectedBuyers_SearchProducts"]"
                   disabled="@_busy"
                   @oninput="OnSearchInput" />
            @if (!string.IsNullOrWhiteSpace(_query))
            {
                <button type="button" class="pos-manage-share__search-clear" @onclick="ClearSearch">@L["Common_Clear"]</button>
            }
        </div>

        <div class="pos-manage-share__filters" role="tablist" aria-label="@L["ConnectedBuyers_ManageProductsTitle"]">
            @foreach (var filter in ShareFilters)
            {
                <button type="button"
                        class="pos-category-chip @(_shareFilter == filter.Value ? "pos-category-chip--selected" : null)"
                        role="tab"
                        aria-selected="@(_shareFilter == filter.Value)"
                        disabled="@_busy"
                        @onclick="() => SetShareFilterAsync(filter.Value)">
                    @filter.Label
                </button>
            }
        </div>

        <div class="pos-manage-share__category-row">
            <button type="button"
                    class="pos-manage-share__category-btn"
                    disabled="@_busy"
                    @onclick="() => _categorySheetOpen = true">
                @CategoryButtonLabel
            </button>
        </div>

        @if (_selectAllMatching)
        {
            <p class="pos-manage-share__select-banner" role="status">
                @L["ConnectedBuyers_AllMatchingSelected", _matchingCount]
                <button type="button" class="pos-link-button" disabled="@_busy" @onclick="ClearSelection">@L["ConnectedBuyers_ClearSelection"]</button>
            </p>
        }
        else if (_matchingCount > _items.Count && _pageSelected.Count == _items.Count && _items.Count > 0)
        {
            <p class="pos-manage-share__select-banner" role="status">
                @L["ConnectedBuyers_PageSelectedCount", _pageSelected.Count]
                <button type="button" class="pos-link-button" disabled="@_busy" @onclick="SelectAllMatching">
                    @L["ConnectedBuyers_SelectAllMatching", _matchingCount]
                </button>
            </p>
        }

        @if (_items.Count == 0)
        {
            <EmptyState IconName="products"
                        Title="@L["ConnectedBuyers_NoProductsFound"]"
                        Message="@L["ConnectedBuyers_NoProductsMatchFilters"]" />
        }
        else
        {
            <div class="pos-manage-share__list" role="list">
                <label class="pos-manage-share__select-all">
                    <input type="checkbox"
                           checked="@PageAllSelected"
                           disabled="@(_busy || !CanManage)"
                           @onchange="OnTogglePageSelect" />
                    <span>@L["ConnectedBuyers_SelectVisible", _items.Count]</span>
                </label>
                @foreach (var product in _items)
                {
                    var selected = _selectAllMatching || _pageSelected.Contains(product.SupplierProductId);
                    <article class="pos-manage-share__row @(selected ? "pos-manage-share__row--selected" : null)" role="listitem">
                        <label class="pos-manage-share__check">
                            <input type="checkbox"
                                   checked="@selected"
                                   disabled="@(_busy || !CanManage || _selectAllMatching)"
                                   @onchange="args => ToggleOne(product.SupplierProductId, args)" />
                        </label>
                        <button type="button"
                                class="pos-manage-share__body"
                                disabled="@_busy"
                                @onclick="() => OpenDetail(product)">
                            <span class="pos-manage-share__name">@product.Name</span>
                            <span class="pos-manage-share__meta pos-muted">
                                @if (!string.IsNullOrWhiteSpace(product.Category))
                                {
                                    @product.Category
                                }
                                else
                                {
                                    @L["ConnectedBuyers_FilterUncategorized"]
                                }
                                @if (!string.IsNullOrWhiteSpace(product.Sku))
                                {
                                    <text> · @product.Sku</text>
                                }
                            </span>
                            <span class="pos-manage-share__prices pos-muted">
                                @L["ConnectedBuyers_DefaultPoShort"]
                                <MoneyDisplay Amount="@(product.DefaultPoPrice ?? 0m)" CurrencyCode="PHP" />
                                <text> · </text>
                                @if (product.BuyerSpecificPoPrice is decimal buyerPrice)
                                {
                                    @L["ConnectedBuyers_BuyerPriceShort"]
                                    <MoneyDisplay Amount="@buyerPrice" CurrencyCode="PHP" />
                                }
                                else
                                {
                                    @L["ConnectedBuyers_UsesDefaultPrice"]
                                }
                            </span>
                            <span class="pos-manage-share__state @(product.IsShared ? "pos-manage-share__state--shared" : null)">
                                @(product.IsShared ? L["ConnectedBuyers_FilterShared"] : L["ConnectedBuyers_FilterNotShared"])
                            </span>
                        </button>
                    </article>
                }
            </div>

            @if (_hasMore)
            {
                <div class="pos-manage-share__more">
                    <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="LoadMoreAsync">
                        <span class="pos-action-tile__label">@L["Common_LoadMore"]</span>
                    </button>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_banner))
        {
            <p class="pos-manage-share__banner" role="status">@_banner</p>
        }
    }
</Page>

@if (CanManage && (_selectedCount > 0 || _selectAllMatching))
{
    <div class="pos-manage-share__sticky" role="region" aria-label="@L["ConnectedBuyers_BulkActions"]">
        <div class="pos-manage-share__sticky-meta">
            @(_selectAllMatching
                ? L["ConnectedBuyers_AllMatchingSelected", _matchingCount]
                : L["ConnectedBuyers_SelectedCount", _selectedCount])
        </div>
        <div class="pos-manage-share__sticky-actions">
            <button type="button" class="pos-manage-share__action" disabled="@_busy" @onclick="() => BulkShareAsync(true)">@L["ConnectedBuyers_BulkShare"]</button>
            <button type="button" class="pos-manage-share__action pos-manage-share__action--danger" disabled="@_busy" @onclick="() => BulkShareAsync(false)">@L["ConnectedBuyers_BulkUnshare"]</button>
            <button type="button" class="pos-manage-share__action" disabled="@_busy" @onclick="OpenPriceSheet">@L["ConnectedBuyers_BulkPrice"]</button>
            <button type="button" class="pos-manage-share__action" disabled="@_busy" @onclick="ClearSelection">@L["ConnectedBuyers_ClearSelection"]</button>
        </div>
    </div>
}

@if (_categorySheetOpen)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_FilterCategory"]">
        <div class="pos-denom-sheet__panel">
            <header class="pos-denom-sheet__header">
                <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_FilterCategory"]</h2>
            </header>
            <div class="pos-denom-sheet__list">
                <button type="button" class="pos-denom-sheet__item @(_categoryFilter == "all" ? "pos-denom-sheet__item--active" : null)"
                        @onclick="SelectAllCategoriesAsync">
                    <span>@L["ConnectedBuyers_FilterAllCategories"]</span>
                    <span class="pos-muted">@_eligibleCount</span>
                </button>
                @foreach (var facet in _categories)
                {
                    var value = string.IsNullOrWhiteSpace(facet.CategoryName) ? "__uncategorized__" : facet.CategoryName!;
                    var label = string.IsNullOrWhiteSpace(facet.CategoryName) ? L["ConnectedBuyers_FilterUncategorized"].Value : facet.CategoryName!;
                    <button type="button" class="pos-denom-sheet__item @(_categoryFilter == value ? "pos-denom-sheet__item--active" : null)"
                            @onclick="() => SetCategoryAsync(value)">
                        <span>@label</span>
                        <span class="pos-muted">@facet.Count</span>
                    </button>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" @onclick="() => _categorySheetOpen = false">
                    <span class="pos-action-tile__label">@L["Common_Close"]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_priceSheetOpen)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_BulkPrice"]">
        <div class="pos-denom-sheet__panel">
            <header class="pos-denom-sheet__header">
                <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_BulkPrice"]</h2>
                <p class="pos-denom-sheet__hint">@L["ConnectedBuyers_PriceRuleHelp"]</p>
            </header>
            <div class="pos-denom-sheet__list">
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="price-mode" checked="@(_priceMode == "UseDefault")" @onchange="SetUseDefaultMode" />
                    @L["ConnectedBuyers_UseDefaultPoPrice"]
                </label>
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="price-mode" checked="@(_priceMode == "DiscountPercent")" @onchange="SetDiscountMode" />
                    @L["ConnectedBuyers_DiscountByPercent"]
                </label>
                @if (_priceMode == "DiscountPercent")
                {
                    <input class="pos-manage-share__price-input" type="number" min="0" max="100" step="0.01" @bind="_percentText" />
                }
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="price-mode" checked="@(_priceMode == "AdjustAmount")" @onchange="SetAdjustMode" />
                    @L["ConnectedBuyers_AdjustByAmount"]
                </label>
                @if (_priceMode == "AdjustAmount")
                {
                    <input class="pos-manage-share__price-input" type="number" step="0.01" @bind="_amountText" />
                }
                @if (!string.IsNullOrWhiteSpace(_priceError))
                {
                    <p class="pos-manage-share__banner">@_priceError</p>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="() => _priceSheetOpen = false">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="PreviewPriceAsync">
                    <span class="pos-action-tile__label">@L["ConnectedBuyers_PricePreview"]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_preview is not null)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedBuyers_PricePreview"]">
        <div class="pos-denom-sheet__panel">
            <header class="pos-denom-sheet__header">
                <h2 class="pos-denom-sheet__title">@L["ConnectedBuyers_PricePreview"]</h2>
                <p class="pos-denom-sheet__hint">@L["ConnectedBuyers_PricePreviewCount", _preview.AffectedCount]</p>
            </header>
            <div class="pos-denom-sheet__list">
                @foreach (var item in _preview.Items)
                {
                    <div class="pos-manage-share__preview-row">
                        <strong>@item.Name</strong>
                        <span class="pos-muted">
                            <MoneyDisplay Amount="@item.DefaultPoPrice" CurrencyCode="PHP" />
                            →
                            <MoneyDisplay Amount="@item.ProposedEffectivePrice" CurrencyCode="PHP" />
                        </span>
                    </div>
                }
                @if (_preview.Truncated)
                {
                    <p class="pos-muted">@L["ConnectedBuyers_PricePreviewTruncated"]</p>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="() => _preview = null">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="ApplyPriceAsync">
                    <span class="pos-action-tile__label">@L["ConnectedBuyers_ApplyToCount", _preview.AffectedCount]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_detail is not null)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@_detail.Name">
        <div class="pos-denom-sheet__panel">
            <header class="pos-denom-sheet__header">
                <h2 class="pos-denom-sheet__title">@_detail.Name</h2>
                <p class="pos-denom-sheet__hint">@L["ConnectedBuyers_DefaultPoShort"] · <MoneyDisplay Amount="@(_detail.DefaultPoPrice ?? 0m)" CurrencyCode="PHP" /></p>
            </header>
            <div class="pos-denom-sheet__list">
                <label class="pos-manage-share__price-option">
                    <input type="checkbox" checked="@_detail.IsShared" disabled="@(_busy || !CanManage)" @onchange="args => _detail.IsShared = Checked(args)" />
                    @L["ConnectedBuyers_FilterShared"]
                </label>
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="detail-price" checked="@(!_detail.UseOverride)" @onchange="() => _detail.UseOverride = false" />
                    @L["ConnectedBuyers_UseDefaultPoPrice"]
                </label>
                <label class="pos-manage-share__price-option">
                    <input type="radio" name="detail-price" checked="@_detail.UseOverride" @onchange="() => _detail.UseOverride = true" />
                    @L["ConnectedBuyers_BuyerSpecificPoPrice"]
                </label>
                @if (_detail.UseOverride)
                {
                    <CurrencyInput Label="@L["ConnectedBuyers_BuyerSpecificPoPrice"]"
                                   Value="@_detail.BuyerSpecificPoPrice"
                                   ValueChanged="v => _detail.BuyerSpecificPoPrice = v"
                                   CurrencyCode="PHP"
                                   Disabled="@(_busy || !CanManage)" />
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="() => _detail = null">
                    <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                </button>
                <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@(_busy || !CanManage)" @onclick="SaveDetailAsync">
                    <span class="pos-action-tile__label">@L["Common_Save"]</span>
                </button>
            </div>
        </div>
    </div>
}
</div>

<style>
    .pos-manage-share { width: 100%; padding-bottom: 0.5rem; }
    .pos-manage-share--has-selection { padding-bottom: 5.5rem; }
    .pos-manage-share__header { margin-bottom: 0.55rem; }
    .pos-manage-share__title { margin: 0; font-size: 1.2rem; font-weight: 700; line-height: 1.2; color: var(--exits-text, #15201a); }
    .pos-manage-share__summary { margin: 0.25rem 0 0; font-size: 0.8125rem; }
    .pos-manage-share__search {
        display: flex; align-items: center; gap: 0.4rem;
        margin: 0 0 0.55rem; padding: 0.35rem 0.55rem;
        border: 1px solid var(--exits-border, #c9d4cd); border-radius: 0.5rem;
        background: var(--exits-surface, #fff);
    }
    .pos-manage-share__search-input {
        flex: 1 1 auto; border: 0; outline: none; background: transparent;
        font: inherit; font-size: 0.9rem; min-width: 0;
    }
    .pos-manage-share__search-clear { appearance: none; border: 0; background: transparent; font: inherit; font-size: 0.75rem; font-weight: 650; color: var(--exits-primary, #1b7a3d); }
    .pos-manage-share__filters {
        display: flex; flex-wrap: nowrap; gap: 0.4rem; margin: 0 0 0.45rem;
        overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin;
    }
    .pos-manage-share__category-row { margin: 0 0 0.55rem; }
    .pos-manage-share__category-btn {
        appearance: none; width: 100%; min-height: 2.4rem; padding: 0.4rem 0.7rem;
        border: 1px solid var(--exits-border, #c9d4cd); border-radius: 0.5rem;
        background: var(--exits-bg, #f3f6f4); font: inherit; font-size: 0.875rem; font-weight: 650;
        text-align: left; color: var(--exits-text, #15201a);
    }
    .pos-manage-share__select-banner {
        display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center;
        margin: 0 0 0.55rem; padding: 0.45rem 0.55rem; border-radius: 0.45rem;
        background: var(--exits-bg, #f3f6f4); font-size: 0.8125rem;
    }
    .pos-link-button { appearance: none; border: 0; background: transparent; color: var(--exits-primary, #1b7a3d); font: inherit; font-weight: 700; padding: 0; }
    .pos-manage-share__list {
        border: 1px solid var(--exits-border, #c9d4cd); border-radius: 0.5rem;
        overflow: hidden; background: var(--exits-surface, #fff);
    }
    .pos-manage-share__select-all {
        display: flex; align-items: center; gap: 0.45rem; margin: 0; padding: 0.5rem 0.65rem;
        border-bottom: 1px solid var(--pos-border-subtle, #d7e0da); font-size: 0.8125rem; font-weight: 650;
    }
    .pos-manage-share__row {
        display: flex; align-items: flex-start; gap: 0.45rem; padding: 0.55rem 0.65rem;
    }
    .pos-manage-share__row + .pos-manage-share__row { border-top: 1px solid var(--pos-border-subtle, #d7e0da); }
    .pos-manage-share__row--selected { background: rgba(27, 122, 61, 0.06); }
    .pos-manage-share__check { margin: 0.15rem 0 0; }
    .pos-manage-share__body {
        appearance: none; border: 0; background: transparent; text-align: left;
        display: flex; flex-direction: column; gap: 0.12rem; flex: 1 1 auto; min-width: 0;
        padding: 0; font: inherit; color: inherit; cursor: pointer;
    }
    .pos-manage-share__name { font-size: 0.95rem; font-weight: 650; line-height: 1.25; color: var(--exits-text, #15201a); }
    .pos-manage-share__meta, .pos-manage-share__prices { font-size: 0.75rem; line-height: 1.3; }
    .pos-manage-share__state { font-size: 0.75rem; font-weight: 700; color: var(--exits-text-muted, #5b6b62); }
    .pos-manage-share__state--shared { color: var(--exits-primary, #1b7a3d); }
    .pos-manage-share__more { margin-top: 0.65rem; }
    .pos-manage-share__banner { margin: 0.55rem 0 0; font-size: 0.8125rem; color: var(--exits-text, #15201a); }
    .pos-manage-share__sticky {
        position: fixed; left: 0; right: 0; bottom: calc(var(--pos-bottom-nav-height, 3.5rem) + env(safe-area-inset-bottom, 0px));
        z-index: 40; padding: 0.55rem 0.75rem 0.65rem;
        border-top: 1px solid var(--exits-border, #c9d4cd); background: var(--exits-surface, #fff);
        box-shadow: 0 -4px 16px rgba(21, 32, 26, 0.08);
    }
    .pos-manage-share__sticky-meta { font-size: 0.8125rem; font-weight: 700; margin-bottom: 0.4rem; }
    .pos-manage-share__sticky-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .pos-manage-share__action {
        appearance: none; min-height: 2.25rem; padding: 0.3rem 0.65rem;
        border: 1px solid var(--exits-border, #c9d4cd); border-radius: 999px;
        background: var(--exits-bg, #f3f6f4); font: inherit; font-size: 0.8125rem; font-weight: 700;
    }
    .pos-manage-share__action--danger { color: #8a1f1f; border-color: #e0b4b4; }
    .pos-manage-share__price-option { display: flex; align-items: center; gap: 0.45rem; margin: 0.35rem 0; font-size: 0.875rem; font-weight: 600; }
    .pos-manage-share__price-input {
        width: 100%; min-height: 2.4rem; margin: 0.25rem 0 0.45rem; padding: 0.35rem 0.55rem;
        border: 1px solid var(--exits-border, #c9d4cd); border-radius: 0.45rem; font: inherit;
    }
    .pos-manage-share__preview-row {
        display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.45rem 0;
        border-bottom: 1px solid var(--pos-border-subtle, #d7e0da); font-size: 0.875rem;
    }
    .pos-denom-sheet__item { display: flex; justify-content: space-between; gap: 0.75rem; width: 100%; }
</style>

@code {
    [Parameter] public Guid RelationshipId { get; set; }
    [SupplyParameterFromQuery(Name = "fromAccept")] public string? FromAccept { get; set; }

    private readonly List<ShareProductRow> _items = [];
    private readonly HashSet<Guid> _pageSelected = [];
    private IReadOnlyList<BuyerProductShareCategoryFacetDto> _categories = [];
    private bool _loading = true;
    private bool _busy;
    private bool _hasMore;
    private bool _selectAllMatching;
    private bool _categorySheetOpen;
    private bool _priceSheetOpen;
    private string? _error;
    private string? _banner;
    private string? _priceError;
    private string _query = "";
    private string _shareFilter = "all";
    private string _categoryFilter = "all";
    private string _priceMode = "UseDefault";
    private string _percentText = "5";
    private string _amountText = "-5";
    private int _page = 1;
    private int _matchingCount;
    private int _eligibleCount;
    private int _sharedCount;
    private CancellationTokenSource? _searchCts;
    private BulkBuyerPricingPreviewDto? _preview;
    private DetailEdit? _detail;
    private BulkBuyerPricingRequest? _pendingPriceRequest;

    private bool CanManage => Capabilities.IsAllowed(UtangCapability.ManageSuppliers);
    private bool PageAllSelected => _items.Count > 0 && _items.All(x => _pageSelected.Contains(x.SupplierProductId));
    private int _selectedCount => _pageSelected.Count;

    private IReadOnlyList<(string Value, string Label)> ShareFilters =>
    [
        ("all", L["ConnectedBuyers_FilterAll"]),
        ("shared", L["ConnectedBuyers_FilterShared"]),
        ("not-shared", L["ConnectedBuyers_FilterNotShared"]),
        ("custom-price", L["ConnectedBuyers_FilterCustomPrice"])
    ];

    private string CategoryButtonLabel =>
        _categoryFilter switch
        {
            "all" => L["ConnectedBuyers_FilterAllCategories"],
            "__uncategorized__" => L["ConnectedBuyers_FilterUncategorized"],
            _ => _categoryFilter
        };

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewSuppliers))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        if (string.Equals(FromAccept, "1", StringComparison.Ordinal) || string.Equals(FromAccept, "true", StringComparison.OrdinalIgnoreCase))
        {
            if (Draft.TryTake(RelationshipId, out _, out var selectAll))
            {
                _selectAllMatching = selectAll || true;
            }
            else
            {
                _selectAllMatching = true;
            }
        }

        await ReloadAsync(resetPage: true);
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(280, token);
            await ReloadAsync(resetPage: true);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private Task ClearSearch()
    {
        _query = "";
        return ReloadAsync(resetPage: true);
    }

    private Task SetShareFilterAsync(string value)
    {
        _shareFilter = value;
        ClearSelection();
        return ReloadAsync(resetPage: true);
    }

    private Task SelectAllCategoriesAsync() => SetCategoryAsync("all");

    private Task SetCategoryAsync(string value)
    {
        _categoryFilter = value;
        _categorySheetOpen = false;
        ClearSelection();
        return ReloadAsync(resetPage: true);
    }

    private async Task ReloadAsync(bool resetPage)
    {
        if (resetPage)
        {
            _page = 1;
            _items.Clear();
            if (!_selectAllMatching)
            {
                _pageSelected.Clear();
            }
        }

        _loading = _items.Count == 0;
        _error = null;
        if (!await Connectivity.IsConnectedAsync())
        {
            _error = L["Suppliers_OfflineMessage"];
            _loading = false;
            return;
        }

        var category = _categoryFilter is "all" ? null : _categoryFilter;
        var shareFilter = _shareFilter is "all" ? null : _shareFilter;
        var result = await ConnectedSuppliers.QueryBuyerProductSharesAsync(
            RelationshipId, _query, category, shareFilter, _page, 25);
        _loading = false;
        if (!result.IsSuccess || result.Data is null)
        {
            _error = result.Error?.Detail ?? L["ConnectedBuyers_SharingLoadFailed"];
            return;
        }

        var data = result.Data;
        _matchingCount = data.MatchingCount;
        _eligibleCount = data.EligibleCount;
        _sharedCount = data.SharedCount;
        _categories = data.Categories;
        _hasMore = data.Items.Count + ((_page - 1) * data.PageSize) < data.MatchingCount;
        if (resetPage)
        {
            _items.Clear();
        }

        foreach (var dto in data.Items)
        {
            _items.Add(new ShareProductRow(dto));
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_busy || !_hasMore) return;
        _busy = true;
        try
        {
            _page += 1;
            await ReloadAsync(resetPage: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnTogglePageSelect(ChangeEventArgs args)
    {
        if (_selectAllMatching) return;
        if (Checked(args))
        {
            foreach (var item in _items)
            {
                _pageSelected.Add(item.SupplierProductId);
            }
        }
        else
        {
            foreach (var item in _items)
            {
                _pageSelected.Remove(item.SupplierProductId);
            }
        }
    }

    private void ToggleOne(Guid productId, ChangeEventArgs args)
    {
        if (_selectAllMatching) return;
        if (Checked(args)) _pageSelected.Add(productId);
        else _pageSelected.Remove(productId);
    }

    private void SelectAllMatching()
    {
        _selectAllMatching = true;
        _pageSelected.Clear();
    }

    private void ClearSelection()
    {
        _selectAllMatching = false;
        _pageSelected.Clear();
    }

    private async Task BulkShareAsync(bool share)
    {
        if (_busy || !CanManage) return;
        if (!await Connectivity.IsConnectedAsync())
        {
            _banner = L["Suppliers_OfflineMessage"];
            return;
        }

        _busy = true;
        _banner = null;
        try
        {
            var request = BuildMutationRequest(share ? "Share" : "Unshare");
            var result = await ConnectedSuppliers.BulkMutateBuyerProductSharesAsync(RelationshipId, request);
            if (!result.IsSuccess)
            {
                _banner = result.Error?.Detail ?? L["ConnectedBuyers_SaveSharingFailed"];
                return;
            }

            _banner = share
                ? L["ConnectedBuyers_BulkShareSucceeded", result.Data?.AffectedCount ?? 0]
                : L["ConnectedBuyers_BulkUnshareSucceeded", result.Data?.AffectedCount ?? 0];
            ClearSelection();
            await ReloadAsync(resetPage: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private BulkBuyerProductShareMutationRequest BuildMutationRequest(string operation) =>
        _selectAllMatching
            ? new(operation, SelectAllMatching: true, Query: _query, Category: CategoryOrNull(), ShareFilter: ShareFilterOrNull())
            : new(operation, ProductIds: _pageSelected.ToList());

    private BulkBuyerPricingRequest BuildPricingRequest()
    {
        decimal? percent = null;
        decimal? amount = null;
        if (_priceMode == "DiscountPercent" && decimal.TryParse(_percentText, out var p)) percent = p;
        if (_priceMode == "AdjustAmount" && decimal.TryParse(_amountText, out var a)) amount = a;

        return _selectAllMatching
            ? new(_priceMode, SelectAllMatching: true, Query: _query, Category: CategoryOrNull(), ShareFilter: ShareFilterOrNull(), Percent: percent, Amount: amount)
            : new(_priceMode, ProductIds: _pageSelected.ToList(), Percent: percent, Amount: amount);
    }

    private string? CategoryOrNull() => _categoryFilter is "all" ? null : _categoryFilter;
    private string? ShareFilterOrNull() => _shareFilter is "all" ? null : _shareFilter;

    private void SetUseDefaultMode() => _priceMode = "UseDefault";
    private void SetDiscountMode() => _priceMode = "DiscountPercent";
    private void SetAdjustMode() => _priceMode = "AdjustAmount";

    private void OpenPriceSheet()
    {
        _priceError = null;
        _priceSheetOpen = true;
        _preview = null;
    }

    private async Task PreviewPriceAsync()
    {
        if (_busy || !CanManage) return;
        if (!await Connectivity.IsConnectedAsync())
        {
            _priceError = L["Suppliers_OfflineMessage"];
            return;
        }

        _busy = true;
        _priceError = null;
        try
        {
            var request = BuildPricingRequest();
            var result = await ConnectedSuppliers.PreviewBuyerProductPricingAsync(RelationshipId, request);
            if (!result.IsSuccess || result.Data is null)
            {
                _priceError = result.Error?.Detail ?? L["ConnectedBuyers_SaveSharingFailed"];
                return;
            }

            _pendingPriceRequest = request;
            _preview = result.Data;
            _priceSheetOpen = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyPriceAsync()
    {
        if (_busy || !CanManage || _pendingPriceRequest is null) return;
        if (!await Connectivity.IsConnectedAsync())
        {
            _banner = L["Suppliers_OfflineMessage"];
            return;
        }

        _busy = true;
        try
        {
            var result = await ConnectedSuppliers.ApplyBuyerProductPricingAsync(RelationshipId, _pendingPriceRequest);
            if (!result.IsSuccess)
            {
                _banner = result.Error?.Detail ?? L["ConnectedBuyers_SaveSharingFailed"];
                return;
            }

            _banner = L["ConnectedBuyers_BulkPriceSucceeded", result.Data?.AffectedCount ?? 0];
            _preview = null;
            _pendingPriceRequest = null;
            ClearSelection();
            await ReloadAsync(resetPage: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenDetail(ShareProductRow product) =>
        _detail = new DetailEdit(product);

    private async Task SaveDetailAsync()
    {
        if (_detail is null || _busy || !CanManage) return;
        if (!await Connectivity.IsConnectedAsync())
        {
            _banner = L["Suppliers_OfflineMessage"];
            return;
        }

        _busy = true;
        try
        {
            var price = _detail.UseOverride ? _detail.BuyerSpecificPoPrice : null;
            var result = await ConnectedSuppliers.SetBuyerProductSharesAsync(
                RelationshipId,
                new SetBuyerProductSharesRequest([
                    new SetBuyerProductShareItem(_detail.SupplierProductId, _detail.IsShared, price)
                ]));
            if (!result.IsSuccess)
            {
                _banner = result.Error?.Detail ?? L["ConnectedBuyers_SaveSharingFailed"];
                return;
            }

            _detail = null;
            await ReloadAsync(resetPage: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool Checked(ChangeEventArgs args) =>
        args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private sealed class ShareProductRow
    {
        public ShareProductRow(ConnectedBuyerProductShareDto dto)
        {
            SupplierProductId = dto.SupplierProductId;
            Name = string.IsNullOrWhiteSpace(dto.NameSnapshot) ? dto.SupplierProductId.ToString("D") : dto.NameSnapshot;
            Sku = dto.SkuSnapshot;
            Category = string.IsNullOrWhiteSpace(dto.CategoryNameSnapshot) ? null : dto.CategoryNameSnapshot.Trim();
            DefaultPoPrice = dto.DefaultPoPrice;
            BuyerSpecificPoPrice = dto.BuyerSpecificPoPrice;
            IsShared = dto.IsShared;
        }

        public Guid SupplierProductId { get; }
        public string Name { get; }
        public string? Sku { get; }
        public string? Category { get; }
        public decimal? DefaultPoPrice { get; }
        public decimal? BuyerSpecificPoPrice { get; }
        public bool IsShared { get; }
    }

    private sealed class DetailEdit
    {
        public DetailEdit(ShareProductRow row)
        {
            SupplierProductId = row.SupplierProductId;
            Name = row.Name;
            DefaultPoPrice = row.DefaultPoPrice;
            IsShared = row.IsShared;
            BuyerSpecificPoPrice = row.BuyerSpecificPoPrice;
            UseOverride = row.BuyerSpecificPoPrice is not null;
        }

        public Guid SupplierProductId { get; }
        public string Name { get; }
        public decimal? DefaultPoPrice { get; }
        public bool IsShared { get; set; }
        public bool UseOverride { get; set; }
        public decimal? BuyerSpecificPoPrice { get; set; }
    }
}

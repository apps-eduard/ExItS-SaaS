@page "/suppliers"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSupplierClient Suppliers
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageSuppliers);
<div class="pos-suppliers">
    <Page>
        <header class="pos-suppliers__header">
            <h1 class="pos-suppliers__title">@L["Suppliers_Title"]</h1>
            <p class="pos-suppliers__subtitle">@L["Suppliers_Subtitle"]</p>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Suppliers_OfflineTitle"]" Message="@L["Suppliers_OfflineMessage"]" />
        }
        else if (!canManage)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
        }

        @if (!_isOffline && _incomingPendingCount > 0)
        {
            <Alert Tone="AlertTone.Info"
                   Title="@L["ConnectedSuppliers_IncomingCompact", _incomingPendingCount]" />
            <div class="pos-action-grid pos-action-grid--single pos-suppliers__actions" role="group">
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        @onclick="GoIncomingRequests">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                    <span class="pos-action-tile__label">@L["ConnectedSuppliers_ReviewIncoming"]</span>
                </button>
            </div>
        }

        <div class="pos-action-grid pos-action-grid--two pos-suppliers__actions" role="group" aria-label="@L["Suppliers_Title"]">
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(!canManage || _isOffline)"
                    @onclick="GoNew">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span class="pos-action-tile__label">@L["Suppliers_Add"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(!canManage || _isOffline)"
                    @onclick="GoConnect">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                <span class="pos-action-tile__label">@L["ConnectedSuppliers_RequestConnection"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile @(_incomingPendingCount > 0 ? "pos-action-tile--primary" : null)"
                    disabled="@(_loading || _isOffline)"
                    @onclick="GoIncomingRequests">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                <span class="pos-action-tile__label">
                    @L["ConnectedSuppliers_IncomingRequests"]
                    @if (_incomingPendingCount > 0)
                    {
                        <text> · @_incomingPendingCount</text>
                    }
                </span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(_loading || _isOffline)"
                    @onclick="GoConnectedBuyers">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                <span class="pos-action-tile__label">@L["ConnectedBuyers_Title"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(_loading || _isOffline)"
                    @onclick="ReloadAsync">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-action-tile__label">@L["Suppliers_Refresh"]</span>
            </button>
        </div>

        <div class="pos-suppliers__toolbar">
            <div class="pos-suppliers__search">
                <span class="pos-suppliers__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                <input class="pos-suppliers__search-input"
                       type="search"
                       value="@_search"
                       placeholder="@L["Suppliers_SearchPlaceholder"]"
                       disabled="@(_loading || _isOffline)"
                       @oninput="OnSearchInputAsync" />
            </div>
            <button type="button"
                    class="pos-suppliers__filter-toggle @(_filtersOpen ? "pos-suppliers__filter-toggle--open" : null)"
                    aria-expanded="@_filtersOpen"
                    aria-controls="suppliers-filters"
                    title="@L["Suppliers_FiltersTitle"]"
                    @onclick="ToggleFilters">
                <span class="pos-suppliers__filter-icon" aria-hidden="true">@IconGlyphs.Get("menu")</span>
                <span class="pos-suppliers__filter-label">@L["Suppliers_FiltersTitle"]</span>
            </button>
        </div>

        @if (_filtersOpen)
        {
            <section class="pos-suppliers__panel" id="suppliers-filters" aria-labelledby="suppliers-filters-heading">
                <h2 id="suppliers-filters-heading" class="pos-suppliers__section-title">@L["Suppliers_FiltersTitle"]</h2>
                <div class="pos-suppliers__filters">
                    <Select Label="@L["Suppliers_Filter_Status"]"
                            Value="@_statusFilter"
                            ValueChanged="OnStatusFilterChanged"
                            Options="@SupplierUiOptions.StatusFilters(L)"
                            Disabled="@(_loading || _isOffline)" />
                </div>
            </section>
        }

        <section class="pos-suppliers__panel" aria-labelledby="suppliers-list-heading">
            <h2 id="suppliers-list-heading" class="pos-suppliers__section-title">@L["Suppliers_ListSection"]</h2>
            @if (_loading)
            {
                <div class="pos-suppliers__loading"><Spinner /><span>@L["Suppliers_Loading"]</span></div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Suppliers_Title"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="customers"
                            Title="@L["Suppliers_EmptyTitle"]"
                            Message="@L["Suppliers_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-suppliers__list" role="list" aria-label="@L["Suppliers_Title"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-suppliers__row"
                           role="listitem"
                           href="@($"/suppliers/{item.SupplierId:D}")">
                            <div class="pos-suppliers__row-main">
                                <div class="pos-suppliers__row-top">
                                    <span class="pos-suppliers__row-name">@item.Name</span>
                                    <div class="pos-suppliers__row-side">
                                        <Badge Tone="@(item.Status == SupplierUiOptions.ActiveStatus ? BadgeTone.Success : BadgeTone.Neutral)">
                                            @SupplierUiOptions.StatusLabel(L, item.Status)
                                        </Badge>
                                    </div>
                                </div>
                                <span class="pos-suppliers__row-meta">
                                    @L[string.Equals(item.ConnectionType, "ConnectedOrganization", StringComparison.OrdinalIgnoreCase)
                                        ? "ConnectedSuppliers_ConnectedViaExits"
                                        : "ConnectedSuppliers_ExternalSupplier"]
                                    @if (item.ConnectedRelationshipId is Guid relationshipId
                                         && _relationshipStatuses.TryGetValue(relationshipId, out var relationshipStatus))
                                    {
                                        <text> · @RelationshipStatusLabel(relationshipStatus)</text>
                                    }
                                </span>
                                @if (item.ConnectedRelationshipId is Guid pendingRelId
                                    && _relationshipStatuses.TryGetValue(pendingRelId, out var pendingStatus)
                                    && string.Equals(pendingStatus, "Pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="pos-suppliers__row-meta">@L["ConnectedSuppliers_WaitingForApproval"]</span>
                                }
                                else if (item.ConnectedRelationshipId is Guid declinedRelId
                                    && _relationshipStatuses.TryGetValue(declinedRelId, out var declinedStatus)
                                    && string.Equals(declinedStatus, "Declined", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="pos-suppliers__row-meta">@L["ConnectedSuppliers_RequestDeclinedHelp"]</span>
                                }
                                <span class="pos-suppliers__row-meta">
                                    @item.SupplierCode
                                    @if (!string.IsNullOrWhiteSpace(item.ContactPerson))
                                    {
                                        <text> · @item.ContactPerson</text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.MobileNumber))
                                    {
                                        <text> · @item.MobileNumber</text>
                                    }
                                </span>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>

        @if (!_loading && _totalCount > 0)
        {
            <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private bool _filtersOpen;
    private string? _search;
    private string? _statusFilter = SupplierUiOptions.ActiveStatus;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosSupplierDto> _items = Array.Empty<PosSupplierDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;
    private Dictionary<Guid, string> _relationshipStatuses = [];
    private int _incomingPendingCount;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewSuppliers))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private void ToggleFilters() => _filtersOpen = !_filtersOpen;

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _search = e.Value?.ToString();
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
            // Newer keystroke superseded this search.
        }
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosSupplierDto>();
            _totalCount = 0;
            _errorTitle = L["Suppliers_OfflineTitle"];
            _errorMessage = L["Suppliers_OfflineMessage"];
            _loading = false;
            return;
        }

        ResolveSearch(_search, out var supplierCode, out var name);
        var result = await Suppliers.ListAsync(
            supplierCode,
            name,
            status: string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
            page: _page,
            pageSize: _pageSize);

        if (result.IsSuccess && result.Data is not null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
            var relationships = await ConnectedSuppliers.ListRelationshipsAsync();
            if (relationships.IsSuccess && relationships.Data is not null)
            {
                _relationshipStatuses = relationships.Data.ToDictionary(x => x.RelationshipId, x => x.Status);
            }

            var incoming = await ConnectedSuppliers.ListRelationshipsAsync("supplier");
            _incomingPendingCount = incoming.IsSuccess && incoming.Data is not null
                ? incoming.Data.Count(x => string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                : 0;
        }
        else
        {
            _items = Array.Empty<PosSupplierDto>();
            _totalCount = 0;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private static void ResolveSearch(string? search, out string? supplierCode, out string? name)
    {
        supplierCode = null;
        name = null;
        if (string.IsNullOrWhiteSpace(search))
        {
            return;
        }

        var trimmed = search.Trim();
        if (trimmed.StartsWith("SUP", StringComparison.OrdinalIgnoreCase))
        {
            supplierCode = trimmed;
            return;
        }

        name = trimmed;
    }

    private void GoNew() => Nav.NavigateTo("/suppliers/new");
    private void GoConnect() => Nav.NavigateTo("/suppliers/connected/request");
    private void GoIncomingRequests() => Nav.NavigateTo("/suppliers/connected/requests");
    private void GoConnectedBuyers() => Nav.NavigateTo("/suppliers/connected/buyers");
    private string RelationshipStatusLabel(string status) => status switch
    {
        "Active" => L["ConnectedSuppliers_Status_Connected"],
        "Pending" => L["ConnectedSuppliers_Status_Pending"],
        "Declined" => L["ConnectedSuppliers_Status_Declined"],
        "Disconnected" => L["ConnectedSuppliers_Status_Disconnected"],
        _ => status
    };
}

@page "/suppliers/connected/buyers/{RelationshipId:guid}/share-products"
@using ExItS.PinoyBusinessPOS.Application.ConnectedSuppliers
@using ExItS.PinoyBusinessPOS.Maui.Services
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IUtangCapabilityEvaluator Capabilities
@inject IConnectivityService Connectivity
@inject BuyerShareDraftState Draft
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/suppliers/connected/buyers/{RelationshipId:D}")" />

<div class="pos-share-accept">
<Page>
    @if (_loading)
    {
        <Spinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                    Message="@_error"
                    RetryLabel="@L["Common_Retry"]"
                    OnRetry="LoadAsync" />
    }
    else
    {
        <section class="pos-share-accept__card" aria-labelledby="share-accept-title">
            <h1 id="share-accept-title" class="pos-share-accept__title">@L["ConnectedBuyers_ConnectionAcceptedTitle"]</h1>
            <p class="pos-share-accept__body">@L["ConnectedBuyers_ConnectionAcceptedBody", BuyerLabel]</p>
            <p class="pos-share-accept__count pos-muted">
                @L["ConnectedBuyers_EligibleAvailableCount", _eligibleCount]
            </p>

            <label class="pos-share-accept__all">
                <input type="checkbox"
                       checked="@_shareAll"
                       disabled="@(_saving || _eligibleCount == 0)"
                       @onchange="args => _shareAll = Checked(args)" />
                <span>@L["ConnectedBuyers_ShareAllAvailable", _eligibleCount]</span>
            </label>
        </section>

        <div class="pos-action-grid pos-action-grid--single" role="group">
            <button type="button"
                    class="pos-action-tile"
                    disabled="@_saving"
                    @onclick="ReviewProducts">
                <span class="pos-action-tile__label">@L["ConnectedBuyers_ReviewProducts"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(_saving || !_shareAll || _eligibleCount == 0)"
                    @onclick="ConfirmShareAllAsync">
                <span class="pos-action-tile__label">@L["ConnectedBuyers_ConfirmAndShare"]</span>
            </button>
            <button type="button" class="pos-action-tile" disabled="@_saving" @onclick="NotNow">
                <span class="pos-action-tile__label">@L["ConnectedBuyers_NotNow"]</span>
            </button>
        </div>
    }
</Page>
</div>

<style>
    .pos-share-accept { width: 100%; }
    .pos-share-accept__card {
        margin: 0 0 0.85rem; padding: 0.9rem 0.85rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-share-accept__title {
        margin: 0; font-size: 1.2rem; font-weight: 700; line-height: 1.25;
        color: var(--exits-text, #15201a);
    }
    .pos-share-accept__body {
        margin: 0.45rem 0 0; font-size: 0.9rem; line-height: 1.4;
        color: var(--exits-text, #15201a);
    }
    .pos-share-accept__count { margin: 0.45rem 0 0; font-size: 0.8125rem; }
    .pos-share-accept__all {
        display: flex; align-items: flex-start; gap: 0.5rem;
        margin: 0.75rem 0 0; font-size: 0.9rem; font-weight: 650;
        color: var(--exits-text, #15201a);
    }
    .pos-share-accept__all input { margin-top: 0.15rem; }
</style>

@code {
    [Parameter] public Guid RelationshipId { get; set; }
    [SupplyParameterFromQuery(Name = "buyer")] public string? BuyerNameQuery { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _shareAll = true;
    private string? _error;
    private int _eligibleCount;

    private string BuyerLabel =>
        string.IsNullOrWhiteSpace(BuyerNameQuery) ? L["ConnectedBuyers_UnknownBusiness"].Value : BuyerNameQuery!;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ManageSuppliers))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        if (!await Connectivity.IsConnectedAsync())
        {
            _error = L["Suppliers_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await ConnectedSuppliers.QueryBuyerProductSharesAsync(
            RelationshipId, page: 1, pageSize: 1);
        _loading = false;
        if (!result.IsSuccess || result.Data is null)
        {
            _eligibleCount = 0;
            _error = result.Error?.Detail ?? L["ConnectedBuyers_SharingLoadFailed"];
            return;
        }

        _eligibleCount = result.Data.EligibleCount;
        _shareAll = _eligibleCount > 0;
        Draft.BeginAcceptDraft(RelationshipId, []);
    }

    private async Task ConfirmShareAllAsync()
    {
        if (_saving || !_shareAll || _eligibleCount == 0) return;
        _saving = true;
        _error = null;
        try
        {
            if (!await Connectivity.IsConnectedAsync())
            {
                _error = L["Suppliers_OfflineMessage"];
                return;
            }

            var result = await ConnectedSuppliers.BulkMutateBuyerProductSharesAsync(
                RelationshipId,
                new BulkBuyerProductShareMutationRequest("Share", SelectAllMatching: true));
            if (!result.IsSuccess)
            {
                _error = result.Error?.Detail ?? L["ConnectedBuyers_SaveSharingFailed"];
                return;
            }

            Draft.Clear();
            Nav.NavigateTo($"/suppliers/connected/buyers/{RelationshipId:D}", replace: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ReviewProducts()
    {
        Draft.BeginAcceptDraft(RelationshipId, []);
        Nav.NavigateTo($"/suppliers/connected/buyers/{RelationshipId:D}/shared-products?fromAccept=1");
    }

    private void NotNow()
    {
        Draft.Clear();
        Nav.NavigateTo($"/suppliers/connected/buyers/{RelationshipId:D}", replace: true);
    }

    private static bool Checked(ChangeEventArgs args) =>
        args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
}

@page "/suppliers/{SupplierId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSupplierClient Suppliers
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/suppliers" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Suppliers_Loading"]</span></Page>
}
else if (_supplier is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Suppliers_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Suppliers_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
    var supplier = _supplier;
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageSuppliers);
    var isActive = supplier.Status == SupplierUiOptions.ActiveStatus;
    var isConnected = string.Equals(supplier.ConnectionType, "ConnectedOrganization", StringComparison.OrdinalIgnoreCase);
    var contactFacts = BuildContactFacts(supplier);
    var addressFacts = BuildAddressFacts(supplier);
    var hasNotes = !string.IsNullOrWhiteSpace(supplier.Notes);
    var hasExtra = contactFacts.Count > 0 || addressFacts.Count > 0 || hasNotes;
<div class="pos-supplier-detail">
<Page>
    <header class="pos-supplier-detail__header">
        <h1 class="pos-supplier-detail__title">@supplier.Name</h1>
        <p class="pos-supplier-detail__subtitle">@L["Suppliers_DetailSubtitle"]</p>
        <p class="pos-supplier-detail__code">@supplier.SupplierCode</p>
        <div class="pos-supplier-detail__status-row">
            <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">@SupplierUiOptions.StatusLabel(L, supplier.Status)</Badge>
            <Badge Tone="@(isConnected ? BadgeTone.Success : BadgeTone.Neutral)">
                @L[isConnected ? "ConnectedSuppliers_ConnectedViaExits" : "ConnectedSuppliers_ExternalSupplier"]
            </Badge>
            @if (_relationship is not null)
            {
                <Badge Tone="@(_relationship.Status == "Active" ? BadgeTone.Success : BadgeTone.Neutral)">
                    @RelationshipStatusLabel(_relationship.Status)
                </Badge>
            }
        </div>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Suppliers_OfflineTitle"]" Message="@L["Suppliers_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Suppliers_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Suppliers_ErrorTitle"])" Message="@_errorMessage" />
    }

    <div class="pos-action-grid pos-action-grid--two pos-supplier-detail__actions" role="group" aria-label="@L["Suppliers_DetailsSection"]">
        <button type="button"
                class="pos-action-tile pos-action-tile--primary"
                disabled="@(!canManage || _isOffline)"
                @onclick="GoEdit">
            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("edit")</span>
            <span class="pos-action-tile__label">@L["Suppliers_Edit"]</span>
        </button>
        @if (isActive)
        {
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(!canManage || _isOffline)"
                    @onclick="() => _confirmDeactivate = true">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                <span class="pos-action-tile__label">@L["Suppliers_Deactivate"]</span>
            </button>
        }
        else
        {
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(!canManage || _isOffline)"
                    @onclick="() => _confirmReactivate = true">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                <span class="pos-action-tile__label">@L["Suppliers_Reactivate"]</span>
            </button>
        }
    </div>

    @if (isConnected
         && supplier.ConnectedRelationshipId is Guid relationshipId
         && string.Equals(_relationship?.Status, "Active", StringComparison.OrdinalIgnoreCase))
    {
        <div class="pos-action-grid pos-action-grid--two pos-supplier-detail__actions" role="group" aria-label="@L["ConnectedSuppliers_BrowseProducts"]">
            <button type="button" class="pos-action-tile pos-action-tile--primary"
                    disabled="@(_isOffline)" @onclick="() => GoConnectedCatalog(relationshipId)">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                <span class="pos-action-tile__label">@L["ConnectedSuppliers_BrowseProducts"]</span>
            </button>
            <button type="button" class="pos-action-tile" @onclick="() => GoLinkedProducts(relationshipId)">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("list")</span>
                <span class="pos-action-tile__label">@L["ConnectedSuppliers_LinkedProducts"]</span>
            </button>
            <button type="button" class="pos-action-tile" disabled="@(_isOffline)" @onclick="GoPurchaseOrders">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                <span class="pos-action-tile__label">@L["ConnectedSuppliers_PurchaseOrders"]</span>
            </button>
        </div>
    }
    else if (isConnected && string.Equals(_relationship?.Status, "Pending", StringComparison.OrdinalIgnoreCase))
    {
        <Alert Tone="AlertTone.Info"
               Title="@L["ConnectedSuppliers_Status_Pending"]"
               Message="@L["ConnectedSuppliers_WaitingForApproval"]" />
    }
    else if (isConnected && string.Equals(_relationship?.Status, "Declined", StringComparison.OrdinalIgnoreCase))
    {
        <Alert Tone="AlertTone.Warning"
               Title="@L["ConnectedSuppliers_Status_Declined"]"
               Message="@L["ConnectedSuppliers_RequestDeclinedHelp"]" />
    }

    <section class="pos-supplier-detail__panel" aria-labelledby="supplier-detail-heading">
        <h2 id="supplier-detail-heading" class="pos-supplier-detail__section-title">@L["Suppliers_DetailsSection"]</h2>
        @if (!hasExtra)
        {
            <EmptyState IconName="customers"
                        Title="@L["Suppliers_DetailsEmptyTitle"]"
                        Message="@L["Suppliers_DetailsEmptyMessage"]" />
        }
        else
        {
            @if (contactFacts.Count > 0)
            {
                <h3 class="pos-supplier-detail__group-title">@L["Suppliers_ContactSection"]</h3>
                <dl class="pos-supplier-detail__facts">
                    @foreach (var fact in contactFacts)
                    {
                        <div class="pos-supplier-detail__fact">
                            <dt>@fact.Label</dt>
                            <dd>@fact.Value</dd>
                        </div>
                    }
                </dl>
            }

            @if (addressFacts.Count > 0)
            {
                <h3 class="pos-supplier-detail__group-title">@L["Suppliers_AddressSection"]</h3>
                <dl class="pos-supplier-detail__facts">
                    @foreach (var fact in addressFacts)
                    {
                        <div class="pos-supplier-detail__fact">
                            <dt>@fact.Label</dt>
                            <dd>@fact.Value</dd>
                        </div>
                    }
                </dl>
            }

            @if (hasNotes)
            {
                <h3 class="pos-supplier-detail__group-title">@L["Suppliers_Field_Notes"]</h3>
                <dl class="pos-supplier-detail__facts">
                    <div class="pos-supplier-detail__fact">
                        <dt>@L["Suppliers_Field_Notes"]</dt>
                        <dd>@supplier.Notes</dd>
                    </div>
                </dl>
            }
        }
    </section>

    <ConfirmDialog Visible="@_confirmDeactivate"
                   VisibleChanged="v => _confirmDeactivate = v"
                   Title="@L["Suppliers_DeactivateTitle"]"
                   Message="@L["Suppliers_DeactivateMessage"]"
                   Danger="true"
                   ConfirmLabel="@L["Suppliers_Deactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="DeactivateAsync" />

    <ConfirmDialog Visible="@_confirmReactivate"
                   VisibleChanged="v => _confirmReactivate = v"
                   Title="@L["Suppliers_ReactivateTitle"]"
                   Message="@L["Suppliers_ReactivateMessage"]"
                   ConfirmLabel="@L["Suppliers_Reactivate"]"
                   IsLoading="@_acting"
                   OnConfirm="ReactivateAsync" />
</Page>
</div>
}

@code {
    [Parameter] public Guid SupplierId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _acting;
    private bool _isOffline;
    private bool _confirmDeactivate;
    private bool _confirmReactivate;
    private PosSupplierDto? _supplier;
    private ConnectedSupplierRelationshipDto? _relationship;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    private sealed record FactRow(string Label, string Value);

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewSuppliers))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private List<FactRow> BuildContactFacts(PosSupplierDto supplier)
    {
        var rows = new List<FactRow>();
        AddFact(rows, L["Suppliers_Field_ContactPerson"], supplier.ContactPerson);
        AddFact(rows, L["Suppliers_Field_Mobile"], supplier.MobileNumber);
        AddFact(rows, L["Suppliers_Field_Telephone"], supplier.TelephoneNumber);
        AddFact(rows, L["Suppliers_Field_Email"], supplier.Email);
        AddFact(rows, L["Suppliers_Field_TaxNumber"], supplier.TaxOrRegistrationNumber);
        return rows;
    }

    private List<FactRow> BuildAddressFacts(PosSupplierDto supplier)
    {
        var rows = new List<FactRow>();
        AddFact(rows, L["Suppliers_Field_AddressLine1"], supplier.AddressLine1);
        AddFact(rows, L["Suppliers_Field_AddressLine2"], supplier.AddressLine2);
        AddFact(rows, L["Suppliers_Field_City"], supplier.CityMunicipality);
        AddFact(rows, L["Suppliers_Field_Province"], supplier.Province);
        AddFact(rows, L["Suppliers_Field_PostalCode"], supplier.PostalCode);
        return rows;
    }

    private static void AddFact(List<FactRow> rows, string label, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        rows.Add(new FactRow(label, value.Trim()));
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _supplier = null;
            _errorTitle = L["Suppliers_OfflineTitle"];
            _errorMessage = L["Suppliers_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Suppliers.GetAsync(SupplierId);
        if (result.IsSuccess && result.Data is not null)
        {
            _supplier = result.Data;
            if (_supplier.ConnectedRelationshipId is Guid relationshipId)
            {
                var relationships = await ConnectedSuppliers.ListRelationshipsAsync();
                _relationship = relationships.Data?.FirstOrDefault(x => x.RelationshipId == relationshipId);
            }
        }
        else
        {
            _supplier = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task DeactivateAsync()
    {
        _acting = true;
        var result = await Suppliers.DeactivateAsync(SupplierId);
        _acting = false;
        _confirmDeactivate = false;
        ApplyMutation(result, L["Suppliers_DeactivatedSuccess"]);
    }

    private async Task ReactivateAsync()
    {
        _acting = true;
        var result = await Suppliers.ActivateAsync(SupplierId);
        _acting = false;
        _confirmReactivate = false;
        ApplyMutation(result, L["Suppliers_ReactivatedSuccess"]);
    }

    private void ApplyMutation(ApiResult<PosSupplierDto> result, string successMessage)
    {
        if (result.IsSuccess && result.Data is not null)
        {
            _supplier = result.Data;
            _banner = successMessage;
            _errorTitle = null;
            _errorMessage = null;
            return;
        }

        _banner = null;
        _errorTitle = L["Suppliers_ErrorTitle"];
        var mapped = SupplierErrorPresenter.Describe(result.Error?.ErrorCode, L);
        _errorMessage = mapped.Form
            ?? result.Error?.Detail
            ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private void GoEdit() => Nav.NavigateTo($"/suppliers/{SupplierId:D}/edit");
    private void GoConnectedCatalog(Guid relationshipId) =>
        Nav.NavigateTo($"/suppliers/{SupplierId:D}/connected-catalog?relationshipId={relationshipId:D}");
    private void GoLinkedProducts(Guid relationshipId) =>
        Nav.NavigateTo($"/suppliers/{SupplierId:D}/linked-products?relationshipId={relationshipId:D}");
    private void GoPurchaseOrders() => Nav.NavigateTo("/purchasing/orders");
    private string RelationshipStatusLabel(string status) => status switch
    {
        "Active" => L["ConnectedSuppliers_Status_Connected"],
        "Pending" => L["ConnectedSuppliers_Status_Pending"],
        "Declined" => L["ConnectedSuppliers_Status_Declined"],
        "Disconnected" => L["ConnectedSuppliers_Status_Disconnected"],
        _ => status
    };
}

@page "/suppliers/{SupplierId:guid}/linked-products"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Maui.Services
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSupplierClient Suppliers
@inject ILinkedSupplierProductStore LocalProducts
@inject ILinkedSupplierProductSyncService SyncService
@inject IConnectivityService Connectivity
@inject IUtangCapabilityEvaluator Capabilities
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/suppliers/{SupplierId:D}")" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-linked-products">
    <Page>
        <header class="pos-linked-products__header">
            <h1 class="pos-linked-products__title">@L["ConnectedSuppliers_LinkedProducts"]</h1>
            <p class="pos-linked-products__subtitle">@L["ConnectedSuppliers_LinkedProductsHelp"]</p>
        </header>

        @if (_relationshipId == Guid.Empty)
        {
            <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                        Message="@L["ConnectedSuppliers_RelationshipMissing"]"
                        RetryLabel="@L["Common_Retry"]"
                        OnRetry="InitializeAsync" />
        }
        else
        {
            @if (_offline)
            {
                <Alert Tone="AlertTone.Warning"
                       Title="@L["ConnectedSuppliers_OnlineRequired"]"
                       Message="@L["ConnectedSuppliers_LinkedOfflineHelp"]" />
            }

            <div class="pos-linked-products__search" role="search">
                <label class="pos-linked-products__search-label" for="linked-products-search">
                    @L["ConnectedSuppliers_SearchLinkedPlaceholder"]
                </label>
                <SearchBar Value="@_query"
                           ValueChanged="OnSearchInput"
                           OnSearch="OnSearchSubmitAsync"
                           InputId="linked-products-search"
                           Placeholder="@L["ConnectedSuppliers_SearchLinkedPlaceholder"]"
                           AriaLabel="@L["ConnectedSuppliers_SearchLinkedPlaceholder"]"
                           ClearLabel="@L["Catalog_Global_ClearSearch"]"
                           Autocomplete="off"
                           Disabled="@(_loading || _syncing)"
                           OnClear="ClearSearchAsync" />

                @if (!_offline)
                {
                    <button type="button"
                            class="pos-action-tile pos-action-tile--primary pos-linked-products__sync-btn"
                            disabled="@(_loading || _syncing)"
                            @onclick="SyncAsync">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                        <span class="pos-action-tile__label">
                            @(_syncing ? L["Common_Loading"] : L["ConnectedSuppliers_SyncLinked"])
                        </span>
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                            Message="@_error"
                            RetryLabel="@L["Common_Retry"]"
                            OnRetry="RetryAsync" />
            }
            else if (_loading)
            {
                <Spinner />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="products"
                            Title="@(HasQuery ? L["ConnectedSuppliers_LinkedNoMatchTitle"] : L["ConnectedSuppliers_LinkedEmptyTitle"])"
                            Message="@(HasQuery ? L["ConnectedSuppliers_LinkedNoMatchMessage"] : L["ConnectedSuppliers_LinkedEmptyMessage"])" />
                <div class="pos-action-grid pos-action-grid--single">
                    <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="GoBrowseCatalog">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                        <span class="pos-action-tile__label">@L["ConnectedSuppliers_BrowseProducts"]</span>
                    </button>
                </div>
            }
            else
            {
                <p class="pos-linked-products__count pos-muted" role="status">
                    @string.Format(L["ConnectedSuppliers_LinkedResultCount"].Value, _items.Count)
                </p>

                <div class="pos-linked-products__list" role="list">
                    @foreach (var item in _items)
                    {
                        <article role="listitem" class="pos-linked-products__row">
                            <div class="pos-linked-products__row-body">
                                <span class="pos-linked-products__name">@item.ProductName</span>
                                <span class="pos-linked-products__meta pos-muted">
                                    @(item.SupplierSku ?? L["ConnectedSuppliers_NoSku"])
                                    · @item.UnitOfMeasure
                                    @if (!string.IsNullOrWhiteSpace(item.PackageLabel))
                                    {
                                        <text> · @item.PackageLabel</text>
                                    }
                                </span>
                                <MoneyDisplay Amount="@item.LastKnownOrderPrice" CurrencyCode="PHP" />
                                <span class="pos-linked-products__updated pos-muted">
                                    @string.Format(
                                        L["ConnectedSuppliers_LastUpdated"].Value,
                                        item.SupplierUpdatedAtUtc.ToLocalTime().ToString("g"))
                                </span>
                                @if (!item.IsOrderable)
                                {
                                    <span class="pos-linked-products__badge">@L["ConnectedSuppliers_NotOrderable"]</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </Page>
</div>
}

<style>
    .pos-linked-products { width: 100%; }
    .pos-linked-products__header { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-linked-products__title {
        margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.25;
        color: var(--exits-text, #15201a);
    }
    .pos-linked-products__subtitle {
        margin: 0.35rem 0 0; font-size: 0.875rem; line-height: 1.4;
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-linked-products__search {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: var(--exits-space-3, 0.75rem);
    }
    .pos-linked-products__search-label {
        display: block; margin: 0;
        font-size: 0.8125rem; font-weight: 650; color: var(--exits-text, #15201a);
    }
    .pos-linked-products__sync-btn.pos-action-tile {
        width: 100%;
        justify-content: center;
    }
    .pos-linked-products__count {
        margin: 0 0 0.5rem; font-size: 0.8125rem;
    }
    .pos-linked-products__list {
        display: flex; flex-direction: column; gap: 0.5rem;
    }
    .pos-linked-products__row {
        display: flex; flex-direction: column; gap: 0.55rem;
        padding: 0.75rem 0.8rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-linked-products__row-body {
        display: flex; flex-direction: column; gap: 0.2rem;
    }
    .pos-linked-products__name {
        font-size: 0.9875rem; font-weight: 650; color: var(--exits-text, #15201a);
    }
    .pos-linked-products__meta,
    .pos-linked-products__updated {
        font-size: 0.8125rem; line-height: 1.35;
    }
    .pos-linked-products__badge {
        display: inline-flex; align-self: flex-start;
        margin-top: 0.25rem; padding: 0.12rem 0.45rem;
        border-radius: 999px; font-size: 0.6875rem; font-weight: 650;
        border: 1px solid var(--exits-border, #c9d4cd);
        background: var(--exits-bg, #f3f6f4);
        color: var(--exits-text-muted, #5b6b62);
    }
</style>

@code {
    [Parameter] public Guid SupplierId { get; set; }
    [SupplyParameterFromQuery(Name = "relationshipId")] public Guid RelationshipId { get; set; }

    private bool _ready;
    private bool _offline;
    private bool _loading;
    private bool _syncing;
    private Guid _relationshipId;
    private string? _query;
    private string? _error;
    private IReadOnlyList<LocalLinkedSupplierProduct> _items = [];

    private bool HasQuery => !string.IsNullOrWhiteSpace(_query);

    protected override async Task OnInitializedAsync() => await InitializeAsync();

    private async Task InitializeAsync()
    {
        _ready = false;
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _offline = !await Connectivity.IsConnectedAsync();
        _relationshipId = RelationshipId;
        if (_relationshipId == Guid.Empty)
        {
            await ResolveRelationshipIdAsync();
        }

        if (_relationshipId != Guid.Empty)
        {
            if (!_offline)
            {
                await SyncAsync();
            }
            else
            {
                await LoadLocalAsync();
            }
        }

        _ready = true;
    }

    private async Task ResolveRelationshipIdAsync()
    {
        if (_offline)
        {
            return;
        }

        var supplier = await Suppliers.GetAsync(SupplierId);
        if (supplier.IsSuccess && supplier.Data?.ConnectedRelationshipId is Guid id && id != Guid.Empty)
        {
            _relationshipId = id;
        }
    }

    private async Task OnSearchInput(string? value)
    {
        _query = value;
        await LoadLocalAsync(showSpinner: false);
    }

    private Task OnSearchSubmitAsync() => LoadLocalAsync(showSpinner: false);

    private async Task ClearSearchAsync()
    {
        _query = null;
        await LoadLocalAsync(showSpinner: false);
    }

    private async Task RetryAsync()
    {
        if (_offline || _relationshipId == Guid.Empty)
        {
            await LoadLocalAsync();
            return;
        }

        await SyncAsync();
    }

    private async Task LoadLocalAsync(bool showSpinner = true)
    {
        if (showSpinner)
        {
            _loading = true;
        }

        _error = null;
        try
        {
            _items = _relationshipId == Guid.Empty
                ? []
                : await LocalProducts.SearchLocalAsync(
                    _relationshipId,
                    string.IsNullOrWhiteSpace(_query) ? null : _query.Trim(),
                    100);
        }
        finally
        {
            if (showSpinner)
            {
                _loading = false;
            }
        }
    }

    private async Task SyncAsync()
    {
        if (_relationshipId == Guid.Empty)
        {
            return;
        }

        if (!await Connectivity.IsConnectedAsync())
        {
            _offline = true;
            await LoadLocalAsync();
            return;
        }

        _offline = false;
        _syncing = true;
        _error = null;
        try
        {
            var result = await SyncService.SyncAsync(_relationshipId);
            if (!result.Succeeded)
            {
                _error = L["ConnectedSuppliers_SyncFailed"];
            }

            await LoadLocalAsync(showSpinner: false);
        }
        finally
        {
            _syncing = false;
        }
    }

    private void GoBrowseCatalog()
    {
        var query = _relationshipId == Guid.Empty
            ? string.Empty
            : $"?relationshipId={_relationshipId:D}";
        Nav.NavigateTo($"/suppliers/{SupplierId:D}/connected-catalog{query}");
    }
}

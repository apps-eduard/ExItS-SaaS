@page "/suppliers/{SupplierId:guid}/connected-catalog"
@using System.Globalization
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Catalog
@using ExItS.PinoyBusinessPOS.Application.Common
@using ExItS.PinoyBusinessPOS.Application.ConnectedSuppliers
@using ExItS.PinoyBusinessPOS.Domain.Catalog
@using ExItS.PinoyBusinessPOS.Maui.Services
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IPosSupplierClient Suppliers
@inject IPosCatalogClient Catalog
@inject ILinkedSupplierProductSyncService LinkedSync
@inject IConnectivityService Connectivity
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@BackHref" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-connected-catalog @(_sheetOpen ? "pos-connected-catalog--sheet-open" : null)">
    <Page>
        <header class="pos-connected-catalog__header">
            <h1 class="pos-connected-catalog__title">@L["ConnectedSuppliers_SetupTitle"]</h1>
            <p class="pos-connected-catalog__subtitle">@SetupSubtitle</p>
        </header>

        @if (_offline)
        {
            <Alert Tone="AlertTone.Warning"
                   Title="@L["ConnectedSuppliers_OnlineRequired"]"
                   Message="@L["ConnectedSuppliers_CatalogOnlineOnly"]" />
            <div class="pos-action-grid pos-action-grid--single">
                <button type="button" class="pos-action-tile" @onclick="GoLinkedProducts">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("list")</span>
                    <span class="pos-action-tile__label">@L["ConnectedSuppliers_OpenLinkedProducts"]</span>
                </button>
            </div>
        }
        else if (_relationshipId == Guid.Empty)
        {
            <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                        Message="@L["ConnectedSuppliers_RelationshipMissing"]"
                        RetryLabel="@L["Common_Retry"]"
                        OnRetry="InitializeAsync" />
        }
        else
        {
            <div class="pos-connected-catalog__search" role="search">
                <label class="visually-hidden" for="connected-catalog-search">
                    @L["ConnectedSuppliers_SearchPlaceholder"]
                </label>
                <div class="pos-connected-catalog__search-field">
                    <span class="pos-connected-catalog__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                    <input id="connected-catalog-search"
                           class="pos-connected-catalog__search-input"
                           type="search"
                           value="@_query"
                           placeholder="@L["ConnectedSuppliers_SearchPlaceholder"]"
                           disabled="@_loading"
                           autocomplete="off"
                           enterkeyhint="search"
                           @oninput="OnSearchInput"
                           @onkeydown="OnSearchKeyDown" />
                    @if (HasQuery)
                    {
                        <button type="button"
                                class="pos-connected-catalog__clear"
                                disabled="@_loading"
                                aria-label="@L["Catalog_Global_ClearSearch"]"
                                @onclick="ClearSearchAsync">
                            ×
                        </button>
                    }
                </div>
                <p class="pos-connected-catalog__hint pos-muted">@L["ConnectedSuppliers_SetupHint"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_banner))
            {
                <p class="pos-connected-catalog__banner" role="status">@_banner</p>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                            Message="@_error"
                            RetryLabel="@L["Common_Retry"]"
                            OnRetry="RefreshReadinessAsync" />
            }
            else if (_loading && !_loaded)
            {
                <Spinner />
            }
            else if (_loaded && _items.Count == 0)
            {
                <EmptyState IconName="products"
                            Title="@L["ConnectedSuppliers_CatalogEmptyTitle"]"
                            Message="@L["ConnectedSuppliers_CatalogEmptyMessage"]" />
                <div class="pos-action-grid pos-action-grid--single">
                    <button type="button" class="pos-action-tile" @onclick="GoLinkedProducts">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("list")</span>
                        <span class="pos-action-tile__label">@L["ConnectedSuppliers_OpenLinkedProducts"]</span>
                    </button>
                </div>
            }
            else
            {
                <div class="pos-connected-catalog__chips" role="toolbar" aria-label="@L["ConnectedSuppliers_SetupTitle"]">
                    <button type="button"
                            class='@ChipClass("all")'
                            aria-pressed="@(_filter == "all")"
                            disabled="@_loading"
                            @onclick='() => SetFilter("all")'>
                        @string.Format(L["ConnectedSuppliers_FilterAll"].Value, _readyCount + _newCount + _reviewCount + _conflictCount)
                    </button>
                    <button type="button"
                            class='@ChipClass("ready")'
                            aria-pressed="@(_filter == "ready")"
                            disabled="@_loading"
                            @onclick='() => SetFilter("ready")'>
                        @string.Format(L["ConnectedSuppliers_FilterReady"].Value, _readyCount)
                    </button>
                    <button type="button"
                            class='@ChipClass("new")'
                            aria-pressed="@(_filter == "new")"
                            disabled="@_loading"
                            @onclick='() => SetFilter("new")'>
                        @string.Format(L["ConnectedSuppliers_FilterNew"].Value, _newCount)
                    </button>
                    <button type="button"
                            class='@ChipClass("review")'
                            aria-pressed="@(_filter == "review")"
                            disabled="@_loading"
                            @onclick='() => SetFilter("review")'>
                        @string.Format(L["ConnectedSuppliers_FilterReview"].Value, _reviewCount)
                    </button>
                    @if (_conflictCount > 0)
                    {
                        <button type="button"
                                class='@ChipClass("conflict")'
                                aria-pressed="@IsAttentionFilter"
                                disabled="@_loading"
                                @onclick='() => SetFilter("conflict")'>
                            @string.Format(L["ConnectedSuppliers_FilterAttention"].Value, _conflictCount)
                        </button>
                    }
                </div>

                @if (FilteredItems.Count == 0)
                {
                    <EmptyState IconName="products"
                                Title="@(HasQuery ? L["ConnectedSuppliers_NoMatchTitle"] : L["ConnectedSuppliers_CatalogEmptyTitle"])"
                                Message="@(HasQuery ? L["ConnectedSuppliers_NoMatchMessage"] : L["ConnectedSuppliers_CatalogEmptyMessage"])" />
                }
                else
                {
                    <p class="pos-connected-catalog__count pos-muted" role="status">
                        @string.Format(L["ConnectedSuppliers_CatalogResultCount"].Value, FilteredItems.Count)
                    </p>

                    <div class="pos-connected-catalog__list" role="list">
                        @foreach (var item in FilteredItems)
                        {
                            var bucket = StatusBucket(item.Status);
                            <article role="listitem" class="pos-connected-catalog__row">
                                <div class="pos-connected-catalog__row-body">
                                    <span class="pos-connected-catalog__name">@item.SupplierName</span>
                                    <span class="pos-connected-catalog__meta pos-muted">
                                        @(item.SupplierSku ?? L["ConnectedSuppliers_NoSku"])
                                        · @item.UnitOfMeasureCode
                                    </span>
                                    <div class="pos-connected-catalog__price">
                                        <span class="pos-connected-catalog__price-label">@L["ConnectedSuppliers_PoPriceLabel"]</span>
                                        <MoneyDisplay Amount="@item.PoPrice" CurrencyCode="PHP" />
                                    </div>

                                    @if (bucket == "ready")
                                    {
                                        <div class="pos-connected-catalog__linked" role="status">
                                            <span class="pos-connected-catalog__badge">✓ @L["ConnectedSuppliers_StatusReady"]</span>
                                            @if (!string.IsNullOrWhiteSpace(item.CandidateBuyerProductName)
                                                 || item.LinkedBuyerProductId is not null)
                                            {
                                                <span class="pos-muted">@L["ConnectedSuppliers_MatchedToYourProduct"]</span>
                                                @if (!string.IsNullOrWhiteSpace(item.CandidateBuyerProductName))
                                                {
                                                    <span>@item.CandidateBuyerProductName</span>
                                                }
                                            }
                                        </div>
                                    }
                                    else if (bucket == "new")
                                    {
                                        <div class="pos-connected-catalog__linked" role="status">
                                            <span class="pos-connected-catalog__badge pos-connected-catalog__badge--new">
                                                @L["ConnectedSuppliers_StatusNew"]
                                            </span>
                                            <span>@L["ConnectedSuppliers_NotInYourProducts"]</span>
                                        </div>
                                    }
                                    else if (bucket == "review")
                                    {
                                        <div class="pos-connected-catalog__linked" role="status">
                                            <span class="pos-connected-catalog__badge pos-connected-catalog__badge--review">
                                                @L["ConnectedSuppliers_StatusReview"]
                                            </span>
                                            <span class="pos-connected-catalog__section-title">
                                                @L["ConnectedSuppliers_PossibleProductInCatalog"]
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(item.CandidateBuyerProductName))
                                            {
                                                <strong>@item.CandidateBuyerProductName</strong>
                                            }
                                            <div class="pos-connected-catalog__evidence" aria-label="@L["ConnectedSuppliers_StatusReview"]">
                                                <span>@Mark(item.SkuMatched) @L["ConnectedSuppliers_EvidenceSku"]</span>
                                                <span>@Mark(item.UnitCompatible) @L["ConnectedSuppliers_EvidenceUnit"]</span>
                                                <span>@(item.NameMatched ? "✓" : "~") @L["ConnectedSuppliers_EvidenceName"]</span>
                                                <span>@(item.BarcodeMatched ? "✓" : "–") @L["ConnectedSuppliers_EvidenceBarcode"]</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pos-connected-catalog__linked" role="status">
                                            <span class="pos-connected-catalog__badge pos-connected-catalog__badge--attention">
                                                @L["ConnectedSuppliers_NeedsAttention"]
                                            </span>
                                            <span>@L["ConnectedSuppliers_ConflictMultipleMatch"]</span>
                                        </div>
                                    }
                                </div>

                                @if (bucket == "ready")
                                {
                                    @if (item.LinkedBuyerProductId is Guid buyerId)
                                    {
                                        <button type="button"
                                                class="pos-action-tile pos-connected-catalog__link-btn"
                                                @onclick="() => ViewLinkedProduct(buyerId)">
                                            <span class="pos-action-tile__label">@L["ConnectedSuppliers_ViewLinkedProduct"]</span>
                                        </button>
                                    }
                                }
                                else if (bucket == "new")
                                {
                                    @if (CanManageCatalog)
                                    {
                                        <button type="button"
                                                class="pos-action-tile pos-action-tile--primary pos-connected-catalog__link-btn"
                                                disabled="@(_busy || _loading)"
                                                @onclick="() => QuickAddNewAsync(item)">
                                            <span class="pos-action-tile__label">@L["ConnectedSuppliers_AddToMyProducts"]</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <p class="pos-muted">@L["ConnectedSuppliers_CatalogPermissionRequired"]</p>
                                    }
                                }
                                else if (bucket == "review")
                                {
                                    <div class="pos-connected-catalog__row-actions">
                                        @if (item.CandidateBuyerProductId is Guid candidateId)
                                        {
                                            <button type="button"
                                                    class="pos-action-tile pos-action-tile--primary"
                                                    disabled="@(_busy || _loading)"
                                                    @onclick="() => ConfirmLinkExistingAsync(item, candidateId)">
                                                <span class="pos-action-tile__label">@L["ConnectedSuppliers_SameProduct"]</span>
                                            </button>
                                        }
                                        @if (CanManageCatalog)
                                        {
                                            <button type="button"
                                                    class="pos-action-tile"
                                                    disabled="@(_busy || _loading)"
                                                    @onclick="() => BeginAddAsNew(item)">
                                                <span class="pos-action-tile__label">@L["ConnectedSuppliers_AddAsNew"]</span>
                                            </button>
                                        }
                                    </div>
                                    <details class="pos-connected-catalog__more">
                                        <summary>@L["ConnectedSuppliers_MoreOptions"]</summary>
                                        <button type="button"
                                                class="pos-action-tile"
                                                disabled="@(_busy || _loading)"
                                                @onclick="() => BeginChooseAnother(item)">
                                            <span class="pos-action-tile__label">@L["ConnectedSuppliers_ChooseAnotherProduct"]</span>
                                        </button>
                                    </details>
                                }
                                else
                                {
                                    <button type="button"
                                            class="pos-action-tile pos-action-tile--primary pos-connected-catalog__link-btn"
                                            disabled="@(_busy || _loading)"
                                            @onclick="() => BeginConflictReview(item)">
                                        <span class="pos-action-tile__label">@L["ConnectedSuppliers_ReviewConflict"]</span>
                                    </button>
                                }
                            </article>
                        }
                    </div>
                }
            }
        }
    </Page>

    @if (_pendingItem is not null && _flowMode is "choose" or "conflict")
    {
        <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@ChooseSheetTitle">
            <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit">
                <header class="pos-denom-sheet__header">
                    <div>
                        <h2 class="pos-denom-sheet__title">@ChooseSheetTitle</h2>
                        <p class="pos-connected-catalog__sheet-product">@_pendingItem.SupplierName</p>
                        <p class="pos-muted pos-connected-catalog__sheet-meta">
                            @L["ConnectedSuppliers_SupplierSkuLabel"]: @(_pendingItem.SupplierSku ?? L["ConnectedSuppliers_NoSku"])
                            · @_pendingItem.UnitOfMeasureCode
                        </p>
                        @if (_flowMode == "conflict")
                        {
                            <p class="pos-connected-catalog__banner" role="status">@L["ConnectedSuppliers_ConflictMultipleMatch"]</p>
                            @if (!string.IsNullOrWhiteSpace(_pendingItem.MatchDetails))
                            {
                                <p class="pos-muted">@_pendingItem.MatchDetails</p>
                            }
                        }
                    </div>
                </header>
                <div class="pos-denom-sheet__list pos-denom-sheet__list--fit">
                    @if (!_showBuyerCatalog)
                    {
                        <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="RevealBuyerCatalog">
                            <span class="pos-action-tile__label">@L["ConnectedSuppliers_ChooseAnotherProduct"]</span>
                        </button>
                        @if (CanManageCatalog)
                        {
                            <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="() => BeginAddAsNew(_pendingItem)">
                                <span class="pos-action-tile__label">@L["ConnectedSuppliers_AddAsNew"]</span>
                            </button>
                        }
                    }
                    else
                    {
                        <p class="pos-connected-catalog__section-title">@L["ConnectedSuppliers_PossibleMatches"]</p>
                        <label class="pos-connected-catalog__field">
                            <span class="visually-hidden">@L["ConnectedSuppliers_SearchPlaceholder"]</span>
                            <input class="pos-connected-catalog__input"
                                   type="search"
                                   value="@_chooseQuery"
                                   placeholder="@L["ConnectedSuppliers_SearchPlaceholder"]"
                                   disabled="@_busy"
                                   @oninput="OnChooseSearchInput" />
                        </label>
                        @foreach (var match in FilteredBuyerChoices)
                        {
                            <label class="pos-connected-catalog__radio">
                                <input type="radio"
                                       name="buyer-match"
                                       checked="@(_selectedBuyerProductId == match.ProductId)"
                                       @onchange="() => SelectBuyerCandidate(match.ProductId)" />
                                <span>
                                    <strong>@match.Name</strong>
                                    <span class="pos-muted">@(match.Sku ?? L["ConnectedSuppliers_NoSku"]) · @match.UnitOfMeasure</span>
                                </span>
                            </label>
                        }
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@(_busy || _selectedBuyerProductId is null)"
                                @onclick="() => ConfirmLinkExistingAsync(_pendingItem, _selectedBuyerProductId!.Value)">
                            <span class="pos-action-tile__label">@L["ConnectedSuppliers_LinkSelectedProduct"]</span>
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_linkError))
                    {
                        <p class="pos-connected-catalog__banner" role="alert">@_linkError</p>
                    }
                </div>
                <div class="pos-denom-sheet__bar">
                    <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="CancelFlow">
                        <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_pendingItem is not null && _flowMode == "create")
    {
        <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-label="@L["ConnectedSuppliers_CreateProductTitle"]">
            <div class="pos-denom-sheet__panel pos-denom-sheet__panel--fit">
                <header class="pos-denom-sheet__header">
                    <div>
                        <h2 class="pos-denom-sheet__title">@L["ConnectedSuppliers_CreateProductTitle"]</h2>
                        <p class="pos-muted">@L["ConnectedSuppliers_FromSupplier"]</p>
                        <p class="pos-connected-catalog__sheet-product">@_pendingItem.SupplierName</p>
                        <p class="pos-muted pos-connected-catalog__sheet-meta">
                            @(_pendingItem.SupplierSku ?? L["ConnectedSuppliers_NoSku"]) · @_pendingItem.UnitOfMeasureCode
                        </p>
                        <div class="pos-connected-catalog__price">
                            <span class="pos-connected-catalog__price-label">@L["ConnectedSuppliers_PoPriceLabel"]</span>
                            <MoneyDisplay Amount="@_pendingItem.PoPrice" CurrencyCode="PHP" />
                        </div>
                    </div>
                </header>
                <div class="pos-denom-sheet__list pos-denom-sheet__list--fit">
                    <label class="pos-connected-catalog__field">
                        <span>@L["Catalog_Field_Name"]</span>
                        <input class="pos-connected-catalog__input" @bind="_createName" disabled="@_busy" />
                    </label>
                    <label class="pos-connected-catalog__field">
                        <span>@L["ConnectedSuppliers_YourSku"]</span>
                        <input class="pos-connected-catalog__input" @bind="_createSku" disabled="@_busy" />
                    </label>
                    <label class="pos-connected-catalog__field">
                        <span>@L["Catalog_Field_Category"]</span>
                        <select class="pos-connected-catalog__input" @bind="_createCategoryId" disabled="@_busy">
                            <option value="">@L["ConnectedBuyers_FilterUncategorized"]</option>
                            @foreach (var cat in _categories)
                            {
                                <option value="@cat.CategoryId.ToString("D")">@cat.Name</option>
                            }
                        </select>
                    </label>
                    <label class="pos-connected-catalog__field">
                        <span>@L["Catalog_Field_Unit"]</span>
                        <select class="pos-connected-catalog__input" @bind="_createUnit" disabled="@_busy">
                            @foreach (var uomCode in UnitOfMeasures.Codes)
                            {
                                <option value="@uomCode">@uomCode</option>
                            }
                        </select>
                    </label>
                    <label class="pos-connected-catalog__field">
                        <span>@L["ConnectedSuppliers_SellingPriceLabel"]</span>
                        <span class="pos-connected-catalog__money-input">
                            <span aria-hidden="true">PHP</span>
                            <input class="pos-connected-catalog__input" type="number" min="0.01" step="0.01" inputmode="decimal" @bind="_createSellingPriceText" disabled="@_busy" />
                        </span>
                    </label>
                    <p class="pos-muted pos-connected-catalog__hint">@L["ConnectedSuppliers_SellingPriceHelp"]</p>
                    @if (!string.IsNullOrWhiteSpace(_linkError))
                    {
                        <p class="pos-connected-catalog__banner" role="alert">@_linkError</p>
                    }
                </div>
                <div class="pos-denom-sheet__bar pos-connected-catalog__sheet-bar">
                    <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="CancelFlow">
                        <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                    </button>
                    <button type="button" class="pos-action-tile pos-action-tile--primary" disabled="@_busy" @onclick="ConfirmCreateAndLinkAsync">
                        <span class="pos-action-tile__label">@(_busy ? L["Common_Loading"] : L["ConnectedSuppliers_CreateAndLink"])</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>
}

<style>
    .visually-hidden {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
</style>

@code {
    [Parameter] public Guid SupplierId { get; set; }
    [SupplyParameterFromQuery(Name = "relationshipId")] public Guid RelationshipId { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? FilterQuery { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private bool _ready;
    private bool _offline;
    private bool _loading;
    private bool _busy;
    private bool _loaded;
    private Guid _relationshipId;
    private string _filter = "all";
    private string? _query;
    private string? _chooseQuery;
    private string? _error;
    private string? _banner;
    private string? _linkError;
    private string? _supplierDisplayName;
    private string? _flowMode;
    private string _createName = "";
    private string _createSku = "";
    private string _createUnit = nameof(UnitOfMeasure.Piece);
    private string _createSellingPriceText = "";
    private string _createCategoryId = "";
    private Guid? _selectedBuyerProductId;
    private bool _showBuyerCatalog;
    private CatalogProductReadinessItemDto? _pendingItem;
    private IReadOnlyList<CatalogProductReadinessItemDto> _items = [];
    private int _readyCount;
    private int _newCount;
    private int _reviewCount;
    private int _conflictCount;
    private List<PosCatalogProductDto> _buyerProducts = [];
    private List<PosProductCategoryDto> _categories = [];

    private bool HasQuery => !string.IsNullOrWhiteSpace(_query);
    private bool CanManageCatalog => Capabilities.IsAllowed(UtangCapability.ManageCatalog);
    private bool _sheetOpen => _pendingItem is not null;
    private bool IsAttentionFilter => _filter is "conflict" or "attention";
    private string SetupSubtitle =>
        string.IsNullOrWhiteSpace(_supplierDisplayName)
            ? L["ConnectedSuppliers_SetupSubtitle"]
            : string.Format(L["ConnectedSuppliers_SetupSubtitleNamed"].Value, _supplierDisplayName);

    private string BackHref
    {
        get
        {
            if (TrySafeReturnUrl(out var safe))
            {
                return safe;
            }

            return $"/suppliers/{SupplierId:D}";
        }
    }

    private string ChooseSheetTitle =>
        _flowMode == "conflict"
            ? L["ConnectedSuppliers_ReviewConflictTitle"]
            : L["ConnectedSuppliers_ChooseAnotherProduct"];

    private IReadOnlyList<CatalogProductReadinessItemDto> FilteredItems
    {
        get
        {
            IEnumerable<CatalogProductReadinessItemDto> q = _items;
            q = _filter switch
            {
                "ready" => q.Where(x => StatusBucket(x.Status) == "ready"),
                "new" => q.Where(x => StatusBucket(x.Status) == "new"),
                "review" => q.Where(x => StatusBucket(x.Status) == "review"),
                "conflict" or "attention" => q.Where(x => StatusBucket(x.Status) == "conflict"),
                _ => q
            };

            if (HasQuery)
            {
                var term = _query!.Trim();
                q = q.Where(x =>
                    x.SupplierName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (!string.IsNullOrWhiteSpace(x.SupplierSku)
                        && x.SupplierSku.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            return q.OrderBy(x => x.SupplierName, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private IReadOnlyList<BuyerProductMatchCandidateDto> FilteredBuyerChoices
    {
        get
        {
            var active = _buyerProducts
                .Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .Select(x => new BuyerProductMatchCandidateDto(
                    x.ProductId, x.Name, x.Sku, x.UnitOfMeasure, x.SellingPrice, "Catalog"));

            if (string.IsNullOrWhiteSpace(_chooseQuery))
            {
                return active.Take(40).ToList();
            }

            var term = _chooseQuery.Trim();
            return active
                .Where(x =>
                    x.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (!string.IsNullOrWhiteSpace(x.Sku)
                        && x.Sku.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .Take(40)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await InitializeAsync();

    private async Task InitializeAsync()
    {
        _ready = false;
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _offline = !await Connectivity.IsConnectedAsync();
        _relationshipId = RelationshipId;
        _filter = NormalizeFilter(FilterQuery);
        if (_relationshipId == Guid.Empty)
        {
            await ResolveRelationshipIdAsync();
        }

        if (!_offline && _relationshipId != Guid.Empty)
        {
            await LoadBuyerCatalogAsync();
            await LoadCategoriesAsync();
            await RefreshReadinessAsync(autoLinkFirst: true);
        }

        _ready = true;
    }

    private async Task ResolveRelationshipIdAsync()
    {
        if (_offline) return;
        var supplier = await Suppliers.GetAsync(SupplierId);
        if (supplier.IsSuccess && supplier.Data is not null)
        {
            _supplierDisplayName = supplier.Data.Name;
            if (supplier.Data.ConnectedRelationshipId is Guid id && id != Guid.Empty)
            {
                _relationshipId = id;
            }
        }
    }

    private async Task LoadBuyerCatalogAsync()
    {
        var products = await Catalog.ListProductsAsync(pageSize: 200);
        if (products.IsSuccess && products.Data is not null)
        {
            _buyerProducts = products.Data.Items
                .Where(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        var cats = await Catalog.ListCategoriesAsync(status: "Active", pageSize: 100);
        if (cats.IsSuccess && cats.Data is not null)
        {
            _categories = cats.Data.Items.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearSearchAsync()
    {
        _query = null;
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSearchKeyDown(KeyboardEventArgs args) => Task.CompletedTask;

    private void OnChooseSearchInput(ChangeEventArgs args) =>
        _chooseQuery = args.Value?.ToString();

    private void SetFilter(string filter) => _filter = NormalizeFilter(filter);

    private string ChipClass(string filter) =>
        _filter == filter || (filter == "conflict" && _filter == "attention")
            ? "pos-connected-catalog__chip pos-connected-catalog__chip--selected"
            : "pos-connected-catalog__chip";

    private async Task RefreshReadinessAsync() => await RefreshReadinessAsync(autoLinkFirst: true);

    private async Task RefreshReadinessAsync(bool autoLinkFirst)
    {
        if (_relationshipId == Guid.Empty)
        {
            _error = L["ConnectedSuppliers_RelationshipMissing"];
            _loaded = true;
            _items = [];
            return;
        }

        if (!await Connectivity.IsConnectedAsync())
        {
            _offline = true;
            _error = null;
            _items = [];
            _loaded = true;
            return;
        }

        _offline = false;
        _loading = true;
        _error = null;
        try
        {
            if (autoLinkFirst)
            {
                var auto = await ConnectedSuppliers.AutoLinkExactMatchesAsync(_relationshipId);
                if (auto.IsSuccess && auto.Data is not null && auto.Data.LinkedNow > 0)
                {
                    _banner = string.Format(L["ConnectedSuppliers_AutoLinkedBanner"].Value, auto.Data.LinkedNow);
                    await LinkedSync.SyncAsync(_relationshipId);
                }
            }

            var readiness = await ConnectedSuppliers.ClassifyCatalogReadinessAsync(_relationshipId);
            if (!readiness.IsSuccess || readiness.Data is null)
            {
                var described = ApiLocalizer.Describe(readiness.Status, readiness.Error);
                _error = described.Message;
                _items = [];
                return;
            }

            _items = readiness.Data.Items;
            _readyCount = readiness.Data.Ready;
            _newCount = readiness.Data.New;
            _reviewCount = readiness.Data.Review;
            _conflictCount = readiness.Data.Conflict;
        }
        finally
        {
            _loading = false;
            _loaded = true;
        }
    }

    private async Task AfterLinkSucceededAsync(string banner)
    {
        _banner = banner;
        CancelFlow();
        await LinkedSync.SyncAsync(_relationshipId);
        await LoadBuyerCatalogAsync();
        await RefreshReadinessAsync(autoLinkFirst: false);
    }

    private async Task QuickAddNewAsync(CatalogProductReadinessItemDto item)
    {
        if (!CanManageCatalog) return;
        _busy = true;
        _linkError = null;
        try
        {
            var sellingPrice = item.PoPrice > 0m ? item.PoPrice : 0m;
            if (sellingPrice <= 0m)
            {
                BeginAddAsNew(item);
                return;
            }

            var result = await ConnectedSuppliers.CreateBuyerProductAndLinkAsync(
                _relationshipId,
                new CreateBuyerProductAndLinkRequest(
                    item.ExposureId,
                    item.SupplierName,
                    item.UnitOfMeasureCode,
                    sellingPrice,
                    string.IsNullOrWhiteSpace(item.SupplierSku) ? null : item.SupplierSku.Trim()));
            if (!result.IsSuccess || result.Data is null)
            {
                BeginAddAsNew(item);
                _linkError = result.Error?.Detail ?? L["ConnectedSuppliers_LinkFailed"];
                return;
            }

            var supplierLabel = _supplierDisplayName ?? L["ConnectedSuppliers_SetupTitle"].Value;
            var banner = result.Data.CreatedNewProduct
                ? string.Format(L["ConnectedSuppliers_CreateLinkSucceeded"].Value, result.Data.BuyerProductName, supplierLabel)
                : string.Format(L["ConnectedSuppliers_LinkExistingSucceeded"].Value, result.Data.BuyerProductName);
            await AfterLinkSucceededAsync(banner);
        }
        finally
        {
            _busy = false;
        }
    }

    private void BeginAddAsNew(CatalogProductReadinessItemDto item)
    {
        if (!CanManageCatalog) return;
        _pendingItem = item;
        _flowMode = "create";
        _showBuyerCatalog = false;
        _linkError = null;
        _createName = item.SupplierName;
        _createUnit = item.UnitOfMeasureCode;
        _createSellingPriceText = item.PoPrice > 0m
            ? item.PoPrice.ToString("0.##", CultureInfo.InvariantCulture)
            : "";
        _createCategoryId = "";
        _createSku = SuggestBuyerSku(item.SupplierSku) ?? "";
    }

    private void BeginChooseAnother(CatalogProductReadinessItemDto item)
    {
        _pendingItem = item;
        _flowMode = "choose";
        _showBuyerCatalog = false;
        _selectedBuyerProductId = null;
        _chooseQuery = null;
        _linkError = null;
    }

    private void BeginConflictReview(CatalogProductReadinessItemDto item)
    {
        _pendingItem = item;
        _flowMode = "conflict";
        _showBuyerCatalog = false;
        _selectedBuyerProductId = null;
        _chooseQuery = null;
        _linkError = null;
    }

    private void RevealBuyerCatalog() => _showBuyerCatalog = true;

    private void SelectBuyerCandidate(Guid productId) => _selectedBuyerProductId = productId;

    private string? SuggestBuyerSku(string? supplierSku)
    {
        if (string.IsNullOrWhiteSpace(supplierSku)) return null;
        var conflict = _buyerProducts.Any(x =>
            string.Equals(x.Sku, supplierSku, StringComparison.OrdinalIgnoreCase));
        return conflict ? null : supplierSku.Trim();
    }

    private void CancelFlow()
    {
        _pendingItem = null;
        _flowMode = null;
        _linkError = null;
        _selectedBuyerProductId = null;
        _showBuyerCatalog = false;
        _chooseQuery = null;
    }

    private async Task ConfirmLinkExistingAsync(CatalogProductReadinessItemDto item, Guid buyerProductId)
    {
        if (_relationshipId == Guid.Empty) return;
        _busy = true;
        _linkError = null;
        try
        {
            var result = await ConnectedSuppliers.LinkProductAsync(
                _relationshipId,
                new LinkProductRequest(buyerProductId, item.ExposureId));
            if (!result.IsSuccess)
            {
                _linkError = result.Error?.Detail ?? L["ConnectedSuppliers_LinkFailed"];
                return;
            }

            await AfterLinkSucceededAsync(
                string.Format(L["ConnectedSuppliers_LinkExistingSucceeded"].Value, item.SupplierName));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmCreateAndLinkAsync()
    {
        if (_pendingItem is null || _relationshipId == Guid.Empty || !CanManageCatalog) return;
        if (!decimal.TryParse(_createSellingPriceText, NumberStyles.Number, CultureInfo.InvariantCulture, out var sellingPrice)
            || sellingPrice <= 0m)
        {
            _linkError = L["ConnectedSuppliers_BuyerProductRequired"];
            return;
        }

        _busy = true;
        _linkError = null;
        try
        {
            Guid? categoryId = Guid.TryParse(_createCategoryId, out var cid) ? cid : null;
            var result = await ConnectedSuppliers.CreateBuyerProductAndLinkAsync(
                _relationshipId,
                new CreateBuyerProductAndLinkRequest(
                    _pendingItem.ExposureId,
                    _createName,
                    _createUnit,
                    sellingPrice,
                    string.IsNullOrWhiteSpace(_createSku) ? null : _createSku.Trim(),
                    CategoryId: categoryId));
            if (!result.IsSuccess || result.Data is null)
            {
                _linkError = result.Error?.Detail ?? L["ConnectedSuppliers_LinkFailed"];
                return;
            }

            var supplierLabel = _supplierDisplayName ?? L["ConnectedSuppliers_SetupTitle"].Value;
            var banner = result.Data.CreatedNewProduct
                ? string.Format(L["ConnectedSuppliers_CreateLinkSucceeded"].Value, result.Data.BuyerProductName, supplierLabel)
                : string.Format(L["ConnectedSuppliers_LinkExistingSucceeded"].Value, result.Data.BuyerProductName);
            await AfterLinkSucceededAsync(banner);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ViewLinkedProduct(Guid buyerProductId) =>
        Nav.NavigateTo($"/catalog/products/{buyerProductId:D}");

    private void GoLinkedProducts()
    {
        var query = _relationshipId == Guid.Empty
            ? string.Empty
            : $"?relationshipId={_relationshipId:D}";
        Nav.NavigateTo($"/suppliers/{SupplierId:D}/linked-products{query}");
    }

    private bool TrySafeReturnUrl(out string url)
    {
        url = string.Empty;
        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return false;
        }

        string decoded;
        try
        {
            decoded = Uri.UnescapeDataString(ReturnUrl.Trim());
        }
        catch (UriFormatException)
        {
            return false;
        }

        if (!decoded.StartsWith("/", StringComparison.Ordinal)
            || decoded.StartsWith("//", StringComparison.Ordinal)
            || decoded.Contains("://", StringComparison.Ordinal))
        {
            return false;
        }

        if (!(decoded.StartsWith("/purchasing", StringComparison.OrdinalIgnoreCase)
              || decoded.StartsWith("/suppliers", StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        url = decoded;
        return true;
    }

    private static string StatusBucket(string status) =>
        status switch
        {
            "Ready" or "AlreadyLinked" => "ready",
            "New" => "new",
            "Review" => "review",
            "Conflict" => "conflict",
            _ => "review"
        };

    private static string NormalizeFilter(string? filter) =>
        filter?.Trim().ToLowerInvariant() switch
        {
            "ready" => "ready",
            "new" => "new",
            "review" => "review",
            "conflict" or "attention" => "conflict",
            _ => "all"
        };

    private static string Mark(bool matched) => matched ? "✓" : "–";
}

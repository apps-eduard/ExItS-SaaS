@page "/suppliers/{SupplierId:guid}/connected-catalog"
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Common
@using ExItS.PinoyBusinessPOS.Application.ConnectedSuppliers
@using ExItS.PinoyBusinessPOS.Maui.Services
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosConnectedSupplierClient ConnectedSuppliers
@inject IPosSupplierClient Suppliers
@inject IPosCatalogClient Catalog
@inject IConnectivityService Connectivity
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="@($"/suppliers/{SupplierId:D}")" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-connected-catalog">
    <Page>
        <header class="pos-connected-catalog__header">
            <h1 class="pos-connected-catalog__title">@L["ConnectedSuppliers_BrowseProducts"]</h1>
            <p class="pos-connected-catalog__subtitle">@L["ConnectedSuppliers_ServerSearchHelp"]</p>
        </header>

        @if (_offline)
        {
            <Alert Tone="AlertTone.Warning"
                   Title="@L["ConnectedSuppliers_OnlineRequired"]"
                   Message="@L["ConnectedSuppliers_CatalogOnlineOnly"]" />
            <div class="pos-action-grid pos-action-grid--single">
                <button type="button" class="pos-action-tile" @onclick="GoLinkedProducts">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("list")</span>
                    <span class="pos-action-tile__label">@L["ConnectedSuppliers_OpenLinkedProducts"]</span>
                </button>
            </div>
        }
        else if (_relationshipId == Guid.Empty)
        {
            <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                        Message="@L["ConnectedSuppliers_RelationshipMissing"]"
                        RetryLabel="@L["Common_Retry"]"
                        OnRetry="InitializeAsync" />
        }
        else
        {
            <div class="pos-connected-catalog__search" role="search">
                <label class="pos-connected-catalog__search-label" for="connected-catalog-search">
                    @L["ConnectedSuppliers_SearchPlaceholder"]
                </label>
                <div class="pos-connected-catalog__search-row">
                    <div class="pos-connected-catalog__search-field">
                        <span class="pos-connected-catalog__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                        <input id="connected-catalog-search"
                               class="pos-connected-catalog__search-input"
                               type="search"
                               value="@_query"
                               placeholder="@L["ConnectedSuppliers_SearchPlaceholder"]"
                               disabled="@_loading"
                               autocomplete="off"
                               @oninput="OnSearchInput"
                               @onkeydown="OnSearchKeyDown" />
                    </div>
                    <button type="button"
                            class="pos-action-tile pos-action-tile--primary pos-connected-catalog__search-btn"
                            disabled="@_loading"
                            @onclick="SearchAsync">
                        <span class="pos-action-tile__label">
                            @(_loading ? L["Common_Loading"] : L["ConnectedSuppliers_Search"])
                        </span>
                    </button>
                </div>
                <p class="pos-connected-catalog__hint pos-muted">@L["ConnectedSuppliers_BrowseHint"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <ErrorState Title="@L["ConnectedSuppliers_Error"]"
                            Message="@_error"
                            RetryLabel="@L["Common_Retry"]"
                            OnRetry="SearchAsync" />
            }
            else if (_loading && !_searched)
            {
                <Spinner />
            }
            else if (_searched && _items.Count == 0)
            {
                <EmptyState IconName="products"
                            Title="@(HasQuery ? L["ConnectedSuppliers_NoMatchTitle"] : L["ConnectedSuppliers_CatalogEmptyTitle"])"
                            Message="@(HasQuery ? L["ConnectedSuppliers_NoMatchMessage"] : L["ConnectedSuppliers_CatalogEmptyMessage"])" />
                <div class="pos-action-grid pos-action-grid--single">
                    <button type="button" class="pos-action-tile" @onclick="GoLinkedProducts">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("list")</span>
                        <span class="pos-action-tile__label">@L["ConnectedSuppliers_OpenLinkedProducts"]</span>
                    </button>
                </div>
            }
            else
            {
                @if (_searched)
                {
                    <p class="pos-connected-catalog__count pos-muted" role="status">
                        @string.Format(L["ConnectedSuppliers_CatalogResultCount"].Value, _items.Count)
                    </p>
                }

                <div class="pos-connected-catalog__list" role="list">
                    @foreach (var item in _items)
                    {
                        var linked = _linkedSupplierProductIds.Contains(item.ProductId);
                        <article role="listitem" class="pos-connected-catalog__row">
                            <div class="pos-connected-catalog__row-body">
                                <span class="pos-connected-catalog__name">@item.NameSnapshot</span>
                                <span class="pos-connected-catalog__meta pos-muted">
                                    @(item.SkuSnapshot ?? L["ConnectedSuppliers_NoSku"])
                                    · @item.UnitOfMeasureCode
                                    @if (!string.IsNullOrWhiteSpace(item.CategoryNameSnapshot))
                                    {
                                        <text> · @item.CategoryNameSnapshot</text>
                                    }
                                </span>
                                <MoneyDisplay Amount="@item.SupplierOrderPrice" CurrencyCode="PHP" />
                                @if (linked)
                                {
                                    <span class="pos-connected-catalog__badge">@L["ConnectedSuppliers_AlreadyLinked"]</span>
                                }
                                else if (!item.IsOrderable)
                                {
                                    <span class="pos-connected-catalog__badge pos-connected-catalog__badge--muted">
                                        @L["ConnectedSuppliers_NotOrderable"]
                                    </span>
                                }
                            </div>
                            @if (!linked && item.IsOrderable)
                            {
                                <button type="button"
                                        class="pos-action-tile pos-action-tile--primary pos-connected-catalog__link-btn"
                                        disabled="@(_linking || _loading)"
                                        @onclick="() => BeginLinkProduct(item)">
                                    <span class="pos-action-tile__label">@L["ConnectedSuppliers_LinkAndUse"]</span>
                                </button>
                            }
                        </article>
                    }
                </div>
            }

            @if (_pendingExposure is not null)
            {
                <section class="pos-connected-catalog__link-panel" aria-labelledby="link-product-heading">
                    <h2 id="link-product-heading" class="pos-connected-catalog__link-title">
                        @string.Format(L["ConnectedSuppliers_LinkProductTitle"].Value, _pendingExposure.NameSnapshot)
                    </h2>
                    <p class="pos-muted">@L["ConnectedSuppliers_LinkProductHelp"]</p>
                    <Select Label="@L["ConnectedSuppliers_BuyerProduct"]"
                            Value="@_buyerProductForLink"
                            ValueChanged="v => _buyerProductForLink = v"
                            Options="@BuyerCatalogChoices"
                            Disabled="@_linking" />
                    @if (!string.IsNullOrWhiteSpace(_linkError))
                    {
                        <Alert Tone="AlertTone.Danger" Title="@L["ConnectedSuppliers_Error"]" Message="@_linkError" />
                    }
                    <div class="pos-action-grid pos-action-grid--two">
                        <button type="button" class="pos-action-tile" disabled="@_linking" @onclick="CancelLinkProduct">
                            <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                        </button>
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@(_linking || string.IsNullOrWhiteSpace(_buyerProductForLink))"
                                @onclick="ConfirmLinkProductAsync">
                            <span class="pos-action-tile__label">
                                @(_linking ? L["Common_Loading"] : L["ConnectedSuppliers_LinkAndUse"])
                            </span>
                        </button>
                    </div>
                </section>
            }
        }
    </Page>
</div>
}

<style>
    .pos-connected-catalog { width: 100%; }
    .pos-connected-catalog__header { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-connected-catalog__title {
        margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.25;
        color: var(--exits-text, #15201a);
    }
    .pos-connected-catalog__subtitle {
        margin: 0.35rem 0 0; font-size: 0.875rem; line-height: 1.4;
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-connected-catalog__search { margin-bottom: var(--exits-space-3, 0.75rem); }
    .pos-connected-catalog__search-label {
        display: block; margin: 0 0 0.35rem;
        font-size: 0.8125rem; font-weight: 650; color: var(--exits-text, #15201a);
    }
    .pos-connected-catalog__search-row {
        display: flex; align-items: stretch; gap: 0.5rem;
    }
    .pos-connected-catalog__search-field {
        flex: 1 1 auto; min-width: 0;
        display: flex; align-items: center; gap: 0.45rem;
        min-height: 2.75rem;
        padding: 0 0.75rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-connected-catalog__search-icon {
        display: inline-flex; flex-shrink: 0;
        width: 1.1rem; height: 1.1rem;
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-connected-catalog__search-icon :deep(svg) {
        width: 100%; height: 100%;
    }
    .pos-connected-catalog__search-input {
        flex: 1 1 auto; min-width: 0;
        border: 0; outline: none; background: transparent;
        color: var(--exits-text, #15201a);
        font-size: 1rem; padding: 0.55rem 0;
    }
    .pos-connected-catalog__search-btn {
        flex: 0 0 auto; min-width: 5.5rem;
    }
    .pos-connected-catalog__hint {
        margin: 0.45rem 0 0; font-size: 0.75rem; line-height: 1.4;
    }
    .pos-connected-catalog__count {
        margin: 0 0 0.5rem; font-size: 0.8125rem;
    }
    .pos-connected-catalog__list {
        display: flex; flex-direction: column; gap: 0.5rem;
    }
    .pos-connected-catalog__row {
        display: flex; flex-direction: column; gap: 0.55rem;
        padding: 0.75rem 0.8rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-connected-catalog__row-body {
        display: flex; flex-direction: column; gap: 0.2rem;
    }
    .pos-connected-catalog__name {
        font-size: 0.9875rem; font-weight: 650; color: var(--exits-text, #15201a);
    }
    .pos-connected-catalog__meta {
        font-size: 0.8125rem; line-height: 1.35;
    }
    .pos-connected-catalog__badge {
        display: inline-flex; align-self: flex-start;
        margin-top: 0.25rem; padding: 0.12rem 0.45rem;
        border-radius: 999px; font-size: 0.6875rem; font-weight: 650;
        border: 1px solid #9cc9b0; background: #e8f5ee; color: #145a3a;
    }
    .pos-connected-catalog__badge--muted {
        border-color: var(--exits-border, #c9d4cd);
        background: var(--exits-bg, #f3f6f4);
        color: var(--exits-text-muted, #5b6b62);
    }
    .pos-connected-catalog__link-btn { width: 100%; min-height: 2.5rem; }
    .pos-connected-catalog__link-panel {
        margin-top: var(--exits-space-3, 0.75rem);
        padding: 0.85rem 0.9rem;
        border: 1px solid var(--exits-border, #c9d4cd);
        border-radius: var(--exits-radius-md, 0.5rem);
        background: var(--exits-surface, #fff);
    }
    .pos-connected-catalog__link-title {
        margin: 0 0 0.35rem; font-size: 1rem; font-weight: 700;
    }
</style>

@code {
    [Parameter] public Guid SupplierId { get; set; }
    [SupplyParameterFromQuery(Name = "relationshipId")] public Guid RelationshipId { get; set; }

    private bool _ready;
    private bool _offline;
    private bool _loading;
    private bool _linking;
    private bool _searched;
    private Guid _relationshipId;
    private string? _query;
    private string? _error;
    private string? _linkError;
    private string? _buyerProductForLink;
    private SupplierProductExposureDto? _pendingExposure;
    private IReadOnlyList<SupplierProductExposureDto> _items = [];
    private HashSet<Guid> _linkedSupplierProductIds = [];
    private List<PosCatalogProductDto> _buyerProducts = [];

    private bool HasQuery => !string.IsNullOrWhiteSpace(_query);

    private IReadOnlyList<SelectOption> BuyerCatalogChoices =>
        _buyerProducts
            .Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase))
            .Select(x => new SelectOption(x.ProductId.ToString("D"), x.Name))
            .ToList();

    protected override async Task OnInitializedAsync() => await InitializeAsync();

    private async Task InitializeAsync()
    {
        _ready = false;
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewPurchasing))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _offline = !await Connectivity.IsConnectedAsync();
        _relationshipId = RelationshipId;
        if (_relationshipId == Guid.Empty)
        {
            await ResolveRelationshipIdAsync();
        }

        if (!_offline && _relationshipId != Guid.Empty)
        {
            await LoadBuyerCatalogAsync();
            await SearchAsync();
        }

        _ready = true;
    }

    private async Task ResolveRelationshipIdAsync()
    {
        if (_offline)
        {
            return;
        }

        var supplier = await Suppliers.GetAsync(SupplierId);
        if (supplier.IsSuccess && supplier.Data?.ConnectedRelationshipId is Guid id && id != Guid.Empty)
        {
            _relationshipId = id;
        }
    }

    private async Task LoadBuyerCatalogAsync()
    {
        var products = await Catalog.ListProductsAsync(pageSize: 200);
        if (products.IsSuccess && products.Data is not null)
        {
            _buyerProducts = products.Data.Items
                .Where(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private void OnSearchInput(ChangeEventArgs args) =>
        _query = args.Value?.ToString();

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (_relationshipId == Guid.Empty)
        {
            _error = L["ConnectedSuppliers_RelationshipMissing"];
            _searched = true;
            _items = [];
            return;
        }

        if (!await Connectivity.IsConnectedAsync())
        {
            _offline = true;
            _error = null;
            _items = [];
            _searched = true;
            return;
        }

        _offline = false;
        _loading = true;
        _error = null;
        try
        {
            var catalog = await ConnectedSuppliers.SearchCatalogAsync(
                _relationshipId,
                string.IsNullOrWhiteSpace(_query) ? null : _query.Trim(),
                page: 1,
                pageSize: 25);

            if (!catalog.IsSuccess || catalog.Data is null)
            {
                var described = ApiLocalizer.Describe(catalog.Status, catalog.Error);
                _error = described.Message;
                _items = [];
                _linkedSupplierProductIds = [];
                return;
            }

            _items = catalog.Data.Items
                .OrderBy(x => x.NameSnapshot, StringComparer.OrdinalIgnoreCase)
                .ToList();

            var links = await ConnectedSuppliers.ListLinksAsync(_relationshipId);
            _linkedSupplierProductIds = links.IsSuccess && links.Data is not null
                ? links.Data.Where(x => x.IsActive).Select(x => x.SupplierProductId).ToHashSet()
                : [];
        }
        finally
        {
            _loading = false;
            _searched = true;
        }
    }

    private void BeginLinkProduct(SupplierProductExposureDto exposure)
    {
        _pendingExposure = exposure;
        _linkError = null;
        _buyerProductForLink = _buyerProducts.FirstOrDefault(x =>
            (!string.IsNullOrWhiteSpace(exposure.SkuSnapshot)
             && string.Equals(x.Sku, exposure.SkuSnapshot, StringComparison.OrdinalIgnoreCase))
            || string.Equals(x.Name, exposure.NameSnapshot, StringComparison.OrdinalIgnoreCase))
            ?.ProductId.ToString("D");
    }

    private void CancelLinkProduct()
    {
        _pendingExposure = null;
        _buyerProductForLink = null;
        _linkError = null;
    }

    private async Task ConfirmLinkProductAsync()
    {
        if (_pendingExposure is null
            || _relationshipId == Guid.Empty
            || !Guid.TryParse(_buyerProductForLink, out var buyerProductId))
        {
            _linkError = L["ConnectedSuppliers_BuyerProductRequired"];
            return;
        }

        _linking = true;
        _linkError = null;
        try
        {
            var result = await ConnectedSuppliers.LinkProductAsync(
                _relationshipId,
                new LinkProductRequest(buyerProductId, _pendingExposure.ExposureId));
            if (!result.IsSuccess)
            {
                _linkError = result.Error?.Detail ?? L["ConnectedSuppliers_LinkFailed"];
                return;
            }

            CancelLinkProduct();
            await SearchAsync();
        }
        finally
        {
            _linking = false;
        }
    }

    private void GoLinkedProducts()
    {
        var query = _relationshipId == Guid.Empty
            ? string.Empty
            : $"?relationshipId={_relationshipId:D}";
        Nav.NavigateTo($"/suppliers/{SupplierId:D}/linked-products{query}");
    }
}

@page "/suppliers/new"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosSupplierClient Suppliers
@inject ICurrentUserContext CurrentUser
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/suppliers" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageSuppliers);
<div class="pos-supplier-create">
<Page>
    <header class="pos-supplier-create__header">
        <h1 class="pos-supplier-create__title">@L["Suppliers_CreateTitle"]</h1>
        <p class="pos-supplier-create__subtitle">@L["Suppliers_CreateSubtitle"]</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Suppliers_OfflineTitle"]" Message="@L["Suppliers_OfflineMessage"]" />
    }
    else if (!canManage)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Suppliers_ErrorTitle"]" Message="@_formError" />
    }

    <section class="pos-supplier-create__panel" aria-labelledby="supplier-create-heading">
        <h2 id="supplier-create-heading" class="pos-supplier-create__section-title">@L["Suppliers_DetailsSection"]</h2>
        <SupplierForm Name="@_name"
                      NameChanged="v => _name = v"
                      ContactPerson="@_contactPerson"
                      ContactPersonChanged="v => _contactPerson = v"
                      MobileNumber="@_mobileNumber"
                      MobileNumberChanged="v => _mobileNumber = v"
                      TelephoneNumber="@_telephoneNumber"
                      TelephoneNumberChanged="v => _telephoneNumber = v"
                      Email="@_email"
                      EmailChanged="v => _email = v"
                      AddressLine1="@_addressLine1"
                      AddressLine1Changed="v => _addressLine1 = v"
                      AddressLine2="@_addressLine2"
                      AddressLine2Changed="v => _addressLine2 = v"
                      CityMunicipality="@_cityMunicipality"
                      CityMunicipalityChanged="v => _cityMunicipality = v"
                      Province="@_province"
                      ProvinceChanged="v => _province = v"
                      PostalCode="@_postalCode"
                      PostalCodeChanged="v => _postalCode = v"
                      TaxOrRegistrationNumber="@_taxOrRegistrationNumber"
                      TaxOrRegistrationNumberChanged="v => _taxOrRegistrationNumber = v"
                      Notes="@_notes"
                      NotesChanged="v => _notes = v"
                      NameError="@_nameError"
                      EmailError="@_emailError"
                      MobileError="@_mobileError"
                      TaxNumberError="@_taxNumberError"
                      IsSaving="@_saving"
                      Disabled="@(!canManage || _isOffline)"
                      FormClass="pos-supplier-create__form"
                      SaveLabel="@L["Suppliers_Create"]"
                      OnSave="SaveAsync"
                      OnCancel="GoBack" />
    </section>
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _saving;
    private bool _isOffline;
    private string? _name;
    private string? _contactPerson;
    private string? _mobileNumber;
    private string? _telephoneNumber;
    private string? _email;
    private string? _addressLine1;
    private string? _addressLine2;
    private string? _cityMunicipality;
    private string? _province;
    private string? _postalCode;
    private string? _taxOrRegistrationNumber;
    private string? _notes;
    private string? _nameError;
    private string? _emailError;
    private string? _mobileError;
    private string? _taxNumberError;
    private string? _formError;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell || CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewSuppliers))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        _isOffline = !await Connectivity.IsConnectedAsync();
    }

    private async Task SaveAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageSuppliers))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        if (_isOffline)
        {
            _formError = L["Suppliers_OfflineMessage"];
            return;
        }

        _nameError = null;
        _emailError = null;
        _mobileError = null;
        _taxNumberError = null;
        _formError = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _nameError = L["Suppliers_NameRequired"];
            return;
        }

        _saving = true;
        var result = await Suppliers.CreateAsync(new CreateSupplierRequest(
            _name.Trim(),
            NullIfWhiteSpace(_contactPerson),
            NullIfWhiteSpace(_mobileNumber),
            NullIfWhiteSpace(_telephoneNumber),
            NullIfWhiteSpace(_email),
            NullIfWhiteSpace(_addressLine1),
            NullIfWhiteSpace(_addressLine2),
            NullIfWhiteSpace(_cityMunicipality),
            NullIfWhiteSpace(_province),
            NullIfWhiteSpace(_postalCode),
            NullIfWhiteSpace(_taxOrRegistrationNumber),
            NullIfWhiteSpace(_notes)));
        _saving = false;

        if (result.IsSuccess && result.Data is not null)
        {
            Nav.NavigateTo($"/suppliers/{result.Data.SupplierId:D}", replace: true);
            return;
        }

        var mapped = SupplierErrorPresenter.Describe(result.Error?.ErrorCode, L);
        _nameError = mapped.Name;
        _emailError = mapped.Email;
        _mobileError = mapped.Mobile;
        _taxNumberError = mapped.TaxNumber;
        _formError = mapped.Form
            ?? result.Error?.Detail
            ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
    }

    private static string? NullIfWhiteSpace(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void GoBack() => Nav.NavigateTo("/suppliers");
}

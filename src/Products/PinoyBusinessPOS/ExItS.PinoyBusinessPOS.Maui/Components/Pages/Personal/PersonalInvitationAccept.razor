@page "/personal/invitations/accept"
@layout Layout.AuthShell
@inject IPlatformAccessClient Platform
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-invitation-accept">
<StoreHeaderBack Href="/signin" />
<Page>
    <header class="pos-personal-invitation-accept__header">
        <h1 class="pos-personal-invitation-accept__title">@L["StaffInvite_AcceptTitle"]</h1>
        <p class="pos-personal-invitation-accept__subtitle">@L["StaffInvite_AcceptSubtitle"]</p>
    </header>

    @if (!_ready)
    {
        <Spinner />
    }
    else if (_done)
    {
        <InlineMessage Tone="InlineMessageTone.Success">@L["StaffInvite_ReadyTitle"]</InlineMessage>
        <p class="pos-muted">@L["StaffInvite_OrganizationLabel"]: @_organizationName</p>
        <p class="pos-muted">@L["StaffInvite_ContactEmailLabel"]: @_contactEmail</p>
        <p class="pos-value-md">@L["StaffInvite_StaffLoginLabel"]: @_staffLogin</p>
        <FormActions>
            <Button Variant="ButtonVariant.Primary" OnClick="GoSignIn">@L["SignIn_Submit"]</Button>
        </FormActions>
    }
    else
    {
        <FormValidationSummary Messages="_errors" />
        <FormGroup Title="@L["Personal_InvitationTokenLabel"]">
            <TextInput Label="@L["Personal_InvitationTokenLabel"]" Hint="@L["Personal_InvitationTokenHint"]" @bind-Value="_token" Disabled="_busy" />
            <TextInput Label="@L["StaffInvite_PasswordLabel"]" Hint="@L["StaffInvite_PasswordHint"]" @bind-Value="_password" Disabled="_busy" Type="@("password")" />
        </FormGroup>
        <FormActions>
            <Button IsLoading="_busy" Disabled="_busy || string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_password)" OnClick="AcceptAsync">@L["StaffInvite_AcceptAction"]</Button>
        </FormActions>
    }
</Page>
</div>

@code {
    private bool _ready;
    private bool _busy;
    private bool _done;
    private string _token = string.Empty;
    private string _password = string.Empty;
    private string? _staffLogin;
    private string? _contactEmail;
    private string? _organizationName;
    private List<string> _errors = [];

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eq = part.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(part[..eq]);
            if (!string.Equals(key, "token", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            _token = Uri.UnescapeDataString(part[(eq + 1)..]);
            break;
        }

        _ready = true;
    }

    private async Task AcceptAsync()
    {
        _errors = [];
        if (string.IsNullOrWhiteSpace(_token))
        {
            _errors.Add(L["Personal_InvitationTokenRequired"]);
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            _errors.Add(L["StaffInvite_PasswordRequired"]);
            return;
        }

        _busy = true;
        try
        {
            var result = IsAuthenticatedPersonal
                ? await Platform.AcceptOrganizationInvitationAsPersonalAsync(_token.Trim(), _password)
                : await Platform.AcceptOrganizationInvitationAsync(_token.Trim(), _password);
            if (!result.IsSuccess || result.Data is null)
            {
                _errors.Add(result.Error?.Detail ?? L["Personal_AcceptInvitationFailed"]);
                return;
            }

            _staffLogin = result.Data.StaffLogin;
            _contactEmail = result.Data.ContactEmail;
            _organizationName = result.Data.OrganizationDisplayName;
            _done = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");

    private bool IsAuthenticatedPersonal =>
        CurrentUser.IsAuthenticated
        && string.Equals(CurrentUser.Session?.AccountClass, "Personal", StringComparison.OrdinalIgnoreCase);
}

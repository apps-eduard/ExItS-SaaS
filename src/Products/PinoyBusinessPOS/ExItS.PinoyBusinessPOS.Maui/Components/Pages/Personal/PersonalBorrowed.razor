@page "/personal/utang/borrowed"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject ILocalPersonalUtangStore LocalStore
@inject IPersonalOfflineSyncService PersonalSync
@inject IConnectivityService Connectivity
@inject OfflineAwareNavigation OfflineNav
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-utang">
    <Page>
        <header class="pos-personal-utang__header">
            <h1 class="pos-personal-utang__title">@L["Personal_BorrowedTitle"]</h1>
            <p class="pos-personal-utang__subtitle">@L["Personal_BorrowedSubtitle"]</p>
        </header>

        @if (_loading)
        {
            <Spinner />
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
        }
        else if (_loadFailed)
        {
            <ErrorState Title="@L["Personal_BorrowedErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
        }
        else
        {
            @if (_pendingSync > 0)
            {
                <Alert Tone="AlertTone.Info"
                       Title="@L["Offline_SavedPendingSync"]"
                       Message="@string.Format(L["SyncStatus_PendingItems"].Value, _pendingSync)" />
            }

            @if (_items.Count == 0)
            {
                <EmptyState Title="@L["Personal_BorrowedEmptyTitle"]" Message="@L["Personal_BorrowedEmptyMessage"]" />
            }
            else
            {
                <div class="pos-personal-list" role="list">
                    @foreach (var item in _items)
                    {
                        <button type="button"
                                class="pos-personal-row"
                                role="listitem"
                                @onclick="() => GoDetail(item.Id)">
                            <span class="pos-personal-row__body">
                                <span class="pos-personal-row__title">@ContactName(item.ContactId)</span>
                                <span class="pos-personal-row__meta">
                                    @item.UpdatedAtUtc.LocalDateTime.ToString("g")
                                    @if (IsPending(item.SyncStatus))
                                    {
                                        <span class="pos-personal-row__chip">@L["SyncStatus_PendingCountLabel"]</span>
                                    }
                                </span>
                            </span>
                            <span class="pos-personal-row__amount">@item.Outstanding.ToString("N2") <span class="pos-personal-row__currency">@item.Currency</span></span>
                            <span class="pos-personal-row__chevron" aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            }

            @if (_items.Count > 0)
            {
                <div class="pos-personal-create-toggle">
                    <button type="button"
                            class="pos-action-tile @(_showCreate ? null : "pos-action-tile--primary")"
                            disabled="@_busy"
                            @onclick="ToggleCreate">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get(_showCreate ? "close" : "plus")</span>
                        <span class="pos-action-tile__label">@(_showCreate ? L["Common_Cancel"] : L["Personal_BorrowedCreate"])</span>
                    </button>
                </div>
            }

            @if (_showCreate)
            {
                <Section Title="@L["Personal_BorrowedCreateTitle"]">
                    <div class="pos-settings__panel">
                        <InlineMessage Tone="InlineMessageTone.Info">@L["Personal_LentAddPersonHint"]</InlineMessage>
                        <div class="pos-action-grid pos-action-grid--single pos-personal-utang__actions" role="group">
                            <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="GoResolveExItsId">
                                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                                <span class="pos-action-tile__label">@L["Personal_AddByExItsId"]</span>
                            </button>
                        </div>
                        <FormValidationSummary Messages="_errors" />
                        <Stack Gap="2">
                            <Select Label="@L["Personal_ContactLabel"]" Value="@_contactId" ValueChanged="OnContactChanged" Options="_contactOptions" Disabled="_busy" />
                            <TextInput Label="@L["Personal_InitialAmount"]" @bind-Value="_amount" Disabled="_busy" />
                            <TextInput Label="@L["Personal_NotesLabel"]" @bind-Value="_notes" Disabled="_busy" />
                        </Stack>
                        <div class="pos-action-grid pos-action-grid--single pos-personal-utang__actions" role="group">
                            <button type="button"
                                    class="pos-action-tile pos-action-tile--primary"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_contactId))"
                                    @onclick="CreateAsync">
                                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                                <span class="pos-action-tile__label">@L["Personal_BorrowedCreate"]</span>
                            </button>
                        </div>
                    </div>
                </Section>
            }
        }
    </Page>
</div>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private bool _loadFailed;
    private bool _busy;
    private bool _showCreate;
    private string? _error;
    private string? _contactId;
    private string? _amount;
    private string? _notes;
    private List<string> _errors = [];
    private IReadOnlyList<LocalPersonalRelationship> _items = [];
    private IReadOnlyList<SelectOption> _contactOptions = [];
    private Dictionary<Guid, string> _contactNames = new();
    private Guid? _userId;
    private int _pendingSync;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eq = part.IndexOf('=');
            if (eq <= 0) continue;
            if (string.Equals(Uri.UnescapeDataString(part[..eq]), "contactId", StringComparison.OrdinalIgnoreCase)
                && Guid.TryParse(Uri.UnescapeDataString(part[(eq + 1)..]), out var cid))
            {
                _contactId = cid.ToString("D");
            }
        }

        await LoadAsync();
    }

    private bool _remoteStarted;

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            var personal = await Auth.EnsurePersonalAccountProfileAsync();
            if (!personal.Succeeded)
            {
                _loadFailed = true;
                _error = L[personal.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            _userId = CurrentUser.Session?.UserId;
            await LocalStore.EnsurePersonalContextAsync();
            var contacts = await LocalStore.ListContactsAsync();
            _contactNames = contacts.ToDictionary(c => c.Id, c => c.DisplayName);
            _contactOptions = contacts.Select(c => new SelectOption(c.Id.ToString("D"), c.DisplayName)).ToArray();
            _items = await LocalStore.ListRelationshipsAsync(LocalPersonalDirection.Borrowed);
            _pendingSync = await PersonalSync.GetPendingCountAsync();
            _showCreate = _items.Count == 0 || !string.IsNullOrWhiteSpace(_contactId);
        }
        catch
        {
            _loadFailed = true;
            _error = L["Personal_BorrowedLoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _remoteStarted || !_authenticated || _loadFailed)
        {
            return;
        }

        _remoteStarted = true;
        if (!await Connectivity.IsConnectedAsync())
        {
            return;
        }

        try
        {
            await HydrateBorrowedFromServerAsync();
            var contacts = await LocalStore.ListContactsAsync();
            _contactNames = contacts.ToDictionary(c => c.Id, c => c.DisplayName);
            _contactOptions = contacts.Select(c => new SelectOption(c.Id.ToString("D"), c.DisplayName)).ToArray();
            _items = await LocalStore.ListRelationshipsAsync(LocalPersonalDirection.Borrowed);
            _pendingSync = await PersonalSync.GetPendingCountAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Local list already shown.
        }
    }

    private string ContactName(Guid contactId) =>
        _contactNames.TryGetValue(contactId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : L["Personal_UnknownContact"];

    private static bool IsPending(string? syncStatus) =>
        string.Equals(syncStatus, LocalPersonalSyncStatus.Pending, StringComparison.OrdinalIgnoreCase);

    private void ToggleCreate() => _showCreate = !_showCreate;

    private async Task HydrateBorrowedFromServerAsync()
    {
        if (_userId is null)
        {
            return;
        }

        var result = await Platform.GetPersonalUtangBorrowedAsync();
        if (!result.IsSuccess || result.Data is null)
        {
            return;
        }

        foreach (var item in result.Data)
        {
            var contactId = item.CreditorContactId ?? item.DebtorContactId ?? Guid.Empty;
            await LocalStore.UpsertServerRelationshipAsync(new LocalPersonalRelationship(
                item.Id,
                _userId.Value,
                contactId,
                LocalPersonalDirection.Borrowed,
                item.CurrentBalance,
                item.CurrencyCode,
                LocalPersonalSyncStatus.Synced,
                item.Id,
                item.Version,
                item.UpdatedAtUtc,
                null));
        }
    }

    private Task OnContactChanged(string? value)
    {
        _contactId = value;
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        _errors = [];
        if (!Guid.TryParse(_contactId, out var contactId) || _userId is null)
        {
            _errors.Add(L["Personal_ContactRequired"]);
            return;
        }

        decimal? amount = null;
        if (!string.IsNullOrWhiteSpace(_amount))
        {
            if (!decimal.TryParse(_amount, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed) || parsed <= 0)
            {
                _errors.Add(L["Personal_AmountInvalid"]);
                return;
            }

            amount = parsed;
        }

        _busy = true;
        try
        {
            var relationshipId = Guid.NewGuid();
            var operationId = Guid.NewGuid();
            await LocalStore.PersistRelationshipAndEnqueueAsync(new LocalPersonalRelationshipCreateCommand(
                relationshipId,
                operationId,
                operationId.ToString("N"),
                contactId,
                LocalPersonalDirection.Borrowed,
                amount ?? 0m,
                "PHP",
                string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));

            if (await Connectivity.IsConnectedAsync())
            {
                await PersonalSync.TrySyncPendingAsync();
            }

            Nav.NavigateTo($"/personal/utang/relationships/{relationshipId:D}");
        }
        catch
        {
            _errors.Add(L["Personal_BorrowedCreateFailed"]);
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoDetail(Guid id) => Nav.NavigateTo($"/personal/utang/relationships/{id:D}");
    private void GoResolveExItsId() =>
        _ = OfflineNav.NavigateAsync("/personal/resolve-user?purpose=utang-people&return=/personal/utang/people");
    private void GoSignIn() => Nav.NavigateTo("/signin");
}

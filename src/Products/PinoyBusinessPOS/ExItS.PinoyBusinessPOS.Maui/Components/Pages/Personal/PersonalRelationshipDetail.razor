@page "/personal/utang/relationships/{RelationshipId:guid}"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject ILocalPersonalUtangStore LocalStore
@inject IPersonalOfflineSyncService PersonalSync
@inject IConnectivityService Connectivity
@inject OnlineRequiredGuard OnlineRequired
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-relationship">
<StoreHeaderBack Handler="GoBackListAsync" />
<Page>
    <header class="pos-personal-relationship__header">
        <h1 class="pos-personal-relationship__title">@L["Personal_RelationshipTitle"]</h1>
        <p class="pos-personal-relationship__subtitle">@L["Personal_RelationshipSubtitle"]</p>
    </header>

    @if (_loading)
    {
        <Spinner />
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_loadFailed || _relationship is null)
    {
        <ErrorState Title="@L["Personal_RelationshipErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    }
    else
    {
        @if (_pendingSync > 0)
        {
            <Alert Tone="AlertTone.Info"
                   Title="@L["Offline_SavedPendingSync"]"
                   Message="@string.Format(L["SyncStatus_PendingItems"].Value, _pendingSync)" />
        }

        <Section Title="@L["Personal_BalanceSection"]">
            <div class="pos-personal-balance">
                <span class="pos-personal-balance__amount">@_relationship.Outstanding.ToString("N2")</span>
                <span class="pos-personal-balance__currency">@_relationship.Currency</span>
                <span class="pos-personal-balance__meta">
                    @PerspectiveLabel(_relationship.Direction)
                    @if (string.Equals(_relationship.SyncStatus, LocalPersonalSyncStatus.Pending, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="pos-personal-row__chip">@L["SyncStatus_PendingCountLabel"]</span>
                    }
                </span>
            </div>
        </Section>

        <Section Title="@L["Personal_RecordEntryTitle"]">
            <div class="pos-settings__panel">
                <FormValidationSummary Messages="_errors" />
                <Stack Gap="2">
                    <Select Label="@L["Personal_EntryType"]" Value="@_entryType" ValueChanged="OnEntryTypeChanged" Options="_entryOptions" Disabled="_busy" />
                    <TextInput Label="@L["Personal_InitialAmount"]" @bind-Value="_amount" Disabled="_busy" />
                    <TextInput Label="@L["Personal_NotesLabel"]" @bind-Value="_notes" Disabled="_busy" />
                </Stack>
                <div class="pos-personal-utang__actions">
                    <Button IsLoading="_busy" Disabled="_busy" OnClick="RecordAsync">@L["Personal_RecordEntry"]</Button>
                </div>
                <button type="button" class="pos-personal-link-action" disabled="@_busy" @onclick="InviteAsync">
                    @L["Personal_Nav_UtangInvitations"]
                </button>
            </div>
        </Section>

        <Section Title="@L["Personal_HistorySection"]">
            @if (_history.Count == 0)
            {
                <EmptyState Title="@L["Personal_HistoryEmptyTitle"]" Message="@L["Personal_HistoryEmptyMessage"]" />
            }
            else
            {
                <div class="pos-personal-list" role="list">
                    @foreach (var e in _history)
                    {
                        <div class="pos-personal-row pos-personal-row--static" role="listitem">
                            <span class="pos-personal-row__body">
                                <span class="pos-personal-row__title">@EntryTypeLabel(e.EntryType)</span>
                                <span class="pos-personal-row__meta">
                                    @e.OccurredAtUtc.LocalDateTime.ToString("g")
                                    @if (!string.IsNullOrWhiteSpace(e.Note))
                                    {
                                        <text> · @e.Note</text>
                                    }
                                    @if (string.Equals(e.SyncStatus, LocalPersonalSyncStatus.Pending, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="pos-personal-row__chip">@L["SyncStatus_PendingCountLabel"]</span>
                                    }
                                </span>
                            </span>
                            <span class="pos-personal-row__amount">@e.Amount.ToString("N2")</span>
                        </div>
                    }
                </div>
            }
        </Section>
    }
</Page>
</div>

@code {
    [Parameter] public Guid RelationshipId { get; set; }

    private bool _loading = true;
    private bool _authenticated;
    private bool _loadFailed;
    private bool _busy;
    private string? _error;
    private string _entryType = "Payment";
    private string? _amount;
    private string? _notes;
    private List<string> _errors = [];
    private LocalPersonalRelationship? _relationship;
    private IReadOnlyList<LocalPersonalEntry> _history = [];
    private int _pendingSync;

    private IReadOnlyList<SelectOption> _entryOptions =>
    [
        new("Payment", L["Personal_Entry_Payment"]),
        new("Loan", L["Personal_Entry_Loan"]),
        new("Adjustment", L["Personal_Entry_Adjustment"]),
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            var personal = await Auth.EnsurePersonalAccountProfileAsync();
            if (!personal.Succeeded)
            {
                _loadFailed = true;
                _error = L[personal.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            await LocalStore.EnsurePersonalContextAsync();
            if (await Connectivity.IsConnectedAsync())
            {
                await PersonalSync.TrySyncPendingAsync();
            }

            _relationship = await LocalStore.GetRelationshipAsync(RelationshipId);
            if (_relationship is null && await Connectivity.IsConnectedAsync())
            {
                var rel = await Platform.GetPersonalDebtRelationshipAsync(RelationshipId);
                if (rel.IsSuccess && rel.Data is not null && CurrentUser.Session is not null)
                {
                    var contactId = rel.Data.DebtorContactId ?? rel.Data.CreditorContactId ?? Guid.Empty;
                    var direction = string.Equals(rel.Data.Perspective, "Borrowed", StringComparison.OrdinalIgnoreCase)
                        ? LocalPersonalDirection.Borrowed
                        : LocalPersonalDirection.Lent;
                    await LocalStore.UpsertServerRelationshipAsync(new LocalPersonalRelationship(
                        rel.Data.Id,
                        CurrentUser.Session.UserId,
                        contactId,
                        direction,
                        rel.Data.CurrentBalance,
                        rel.Data.CurrencyCode,
                        LocalPersonalSyncStatus.Synced,
                        rel.Data.Id,
                        rel.Data.Version,
                        rel.Data.UpdatedAtUtc,
                        null));
                    _relationship = await LocalStore.GetRelationshipAsync(RelationshipId);
                }
            }

            if (_relationship is null)
            {
                _loadFailed = true;
                _error = L["Personal_RelationshipLoadFailed"];
                return;
            }

            _history = await LocalStore.ListEntriesAsync(RelationshipId);
            _pendingSync = await PersonalSync.GetPendingCountAsync();
        }
        catch
        {
            _loadFailed = true;
            _error = L["Personal_RelationshipLoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnEntryTypeChanged(string? value)
    {
        _entryType = string.IsNullOrWhiteSpace(value) ? "Payment" : value;
        return Task.CompletedTask;
    }

    private async Task RecordAsync()
    {
        _errors = [];
        if (!decimal.TryParse(_amount, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) || amount <= 0)
        {
            _errors.Add(L["Personal_AmountInvalid"]);
            return;
        }

        _busy = true;
        try
        {
            var entryId = Guid.NewGuid();
            var operationId = Guid.NewGuid();
            await LocalStore.PersistEntryAndEnqueueAsync(new LocalPersonalEntryRecordCommand(
                entryId,
                operationId,
                operationId.ToString("N"),
                RelationshipId,
                _entryType,
                amount,
                string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));

            if (await Connectivity.IsConnectedAsync())
            {
                await PersonalSync.TrySyncPendingAsync();
            }

            _amount = _notes = null;
            await LoadAsync();
        }
        catch
        {
            _errors.Add(L["Personal_RecordEntryFailed"]);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task InviteAsync()
    {
        if (!await OnlineRequired.EnsureOnlineForActionAsync(PosOfflineActionKeys.PersonalInvite))
        {
            return;
        }

        Nav.NavigateTo("/personal/utang/invitations");
    }

    private Task GoBackListAsync()
    {
        GoBackList();
        return Task.CompletedTask;
    }

    private void GoBackList()
    {
        var path = string.Equals(_relationship?.Direction, LocalPersonalDirection.Borrowed, StringComparison.OrdinalIgnoreCase)
            ? "/personal/utang/borrowed"
            : "/personal/utang/lent";
        Nav.NavigateTo(path);
    }

    private string PerspectiveLabel(string perspective) =>
        string.Equals(perspective, LocalPersonalDirection.Lent, StringComparison.OrdinalIgnoreCase)
            || string.Equals(perspective, "Lent", StringComparison.OrdinalIgnoreCase)
            ? L["Personal_Stat_Lent"]
            : string.Equals(perspective, LocalPersonalDirection.Borrowed, StringComparison.OrdinalIgnoreCase)
                || string.Equals(perspective, "Borrowed", StringComparison.OrdinalIgnoreCase)
                ? L["Personal_Stat_Borrowed"]
                : perspective;

    private string EntryTypeLabel(string entryType) => entryType switch
    {
        "Payment" => L["Personal_Entry_Payment"],
        "Loan" => L["Personal_Entry_Loan"],
        "Adjustment" => L["Personal_Entry_Adjustment"],
        _ => entryType
    };

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/personal/more"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject OfflineAwareNavigation OfflineNav
@inject IStringLocalizer<PosResources> L
@inject IConnectivityService Connectivity

<div class="pos-settings pos-personal-more">
    <Page>
        <header class="pos-personal-more__header">
            <h1 class="pos-personal-more__title">@L["Nav_More"]</h1>
            <p class="pos-personal-more__subtitle">@L["Personal_MoreSubtitle"]</p>
        </header>

        @if (_loading)
        {
            <Spinner />
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
        }
        else
        {
            <Section Title="@L["Personal_MoreAccountSection"]">
                <div class="pos-settings__panel">
                    <button type="button" class="pos-settings__nav" @onclick="GoMyQr">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                        <span class="pos-settings__nav-label">@L["Personal_MyQrLink"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-settings__nav" @onclick="GoLinkedMerchants">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("receipt")</span>
                        <span class="pos-settings__nav-label">@L["Personal_Nav_LinkedMerchants"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-settings__nav" @onclick="GoRewards">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                        <span class="pos-settings__nav-label">@L["Personal_Nav_Rewards"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-settings__nav" @onclick="GoCustomerLinkRequests">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                        <span class="pos-settings__nav-label">@L["Personal_Nav_CustomerLinkRequests"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-settings__nav" @onclick="GoNotifications">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                        <span class="pos-settings__nav-label">
                            @L["Personal_Nav_Notifications"]
                            @if (_unreadNotifications > 0)
                            {
                                <span class="pos-muted"> (@_unreadNotifications)</span>
                            }
                        </span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-settings__nav" @onclick="GoUtangInvitations">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                        <span class="pos-settings__nav-label">@L["Personal_Nav_UtangInvitations"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-settings__nav" @onclick="GoProfile">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                        <span class="pos-settings__nav-label">@L["Personal_ProfileLink"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                    <button type="button" class="pos-settings__nav" @onclick="GoSettings">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                        <span class="pos-settings__nav-label">@L["Personal_SettingsLink"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                </div>
            </Section>

            <Section Title="@L["Personal_ExplorePosSection"]">
                <InlineMessage Tone="InlineMessageTone.Info">@L["Personal_ExplorePosHint"]</InlineMessage>
                <div class="pos-action-grid pos-action-grid--single pos-personal-more__explore" role="group">
                    <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="GoExplorePos">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                        <span class="pos-action-tile__label">@L["Personal_ExplorePos"]</span>
                    </button>
                </div>
            </Section>
        }
    </Page>
</div>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private int _unreadNotifications;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            _authenticated = restore.Succeeded;
        }
        else
        {
            _authenticated = true;
        }

        if (_authenticated)
        {
            await Auth.EnsurePersonalAccountProfileAsync();
            if (await Connectivity.IsConnectedAsync())
            {
                var notifications = await Platform.GetPersonalNotificationsAsync();
                if (notifications.IsSuccess && notifications.Data is not null)
                {
                    _unreadNotifications = notifications.Data.Count(n => !n.IsRead);
                }
            }
        }

        _loading = false;
    }

    private Task GoMyQr() => OfflineNav.NavigateAsync("/personal/my-qr");
    private Task GoLinkedMerchants() => OfflineNav.NavigateAsync("/personal/linked-merchants");
    private Task GoRewards() => OfflineNav.NavigateAsync("/personal/rewards");
    private Task GoCustomerLinkRequests() => OfflineNav.NavigateAsync("/personal/customer-link-requests");
    private Task GoNotifications() => OfflineNav.NavigateAsync("/personal/notifications");
    private Task GoUtangInvitations() => OfflineNav.NavigateAsync("/personal/utang/invitations");
    private Task GoProfile() => OfflineNav.NavigateAsync("/personal/profile");
    private Task GoSettings() => OfflineNav.NavigateAsync("/personal/settings");
    private Task GoExplorePos() => OfflineNav.NavigateAsync("/personal/explore-pos");
    private void GoSignIn() => Nav.NavigateTo("/signin");
}

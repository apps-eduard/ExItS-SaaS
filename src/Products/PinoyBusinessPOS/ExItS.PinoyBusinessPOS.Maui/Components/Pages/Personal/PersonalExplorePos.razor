@page "/personal/explore-pos"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject OnlineRequiredGuard OnlineRequired
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-explore">
<StoreHeaderBack Href="/personal/more" />
<Page>
    <header class="pos-personal-explore__header">
        <h1 class="pos-personal-explore__title">@L["Personal_ExplorePosTitle"]</h1>
        <p class="pos-personal-explore__subtitle">@L["Personal_ExplorePosSubtitle"]</p>
    </header>

    @if (_loading)
    {
        <Spinner />
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_loadFailed)
    {
        <ErrorState Title="@L["Personal_ExplorePosErrorTitle"]" Message="@(_error ?? L["Personal_ExplorePosLoadFailed"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    }
    else if (_plans.Count == 0)
    {
        <EmptyState Title="@L["Personal_ExplorePosEmptyTitle"]" Message="@L["Personal_ExplorePosEmptyMessage"]" />
    }
    else
    {
        <p class="pos-personal-explore__hint">@L["Personal_ExplorePosSelectHint"]</p>

        <div class="pos-explore-plans" role="list">
            @foreach (var plan in _plans.OrderBy(p => p.SortOrder))
            {
                var trialAvailable = plan.TrialAllowed && plan.DefaultTrialDays > 0;
                <article class="pos-explore-plan" role="listitem">
                    <header class="pos-explore-plan__header">
                        <h2 class="pos-explore-plan__name">@plan.DisplayName</h2>
                        @if (trialAvailable)
                        {
                            <span class="pos-explore-plan__badge">@string.Format(L["Personal_ExplorePosTrialDays"].Value, plan.DefaultTrialDays)</span>
                        }
                        else
                        {
                            <span class="pos-explore-plan__badge pos-explore-plan__badge--muted">@L["Personal_ExplorePosNoTrial"]</span>
                        }
                    </header>

                    <div class="pos-explore-plan__pricing">
                        <p class="pos-explore-plan__price">
                            <span class="pos-explore-plan__amount">@plan.MonthlyPrice.ToString("N0")</span>
                            <span class="pos-explore-plan__currency">@plan.CurrencyCode</span>
                            <span class="pos-explore-plan__period">/ @L["Personal_Billing_Month"]</span>
                        </p>
                        <p class="pos-explore-plan__annual">
                            @plan.AnnualPrice.ToString("N0") @plan.CurrencyCode / @L["Personal_Billing_Year"]
                        </p>
                    </div>

                    <ul class="pos-explore-plan__features">
                        @foreach (var line in FeatureLines(plan))
                        {
                            <li class="pos-explore-plan__feature">
                                <span class="pos-explore-plan__check" aria-hidden="true">@IconGlyphs.Get("check")</span>
                                <span>@line</span>
                            </li>
                        }
                    </ul>

                    <div class="pos-explore-plan__actions">
                        @if (trialAvailable)
                        {
                            <Button OnClick="() => SelectPlan(plan, startAsTrial: true, payNow: false)">
                                @L["Personal_ExplorePosStartTrial"]
                            </Button>
                            <Button Variant="ButtonVariant.Secondary"
                                    OnClick="() => SelectPlan(plan, startAsTrial: false, payNow: true)">
                                @L["Personal_ExplorePosSubscribe"]
                            </Button>
                        }
                        else
                        {
                            <Button OnClick="() => SelectPlan(plan, startAsTrial: false, payNow: true)">
                                @L["Personal_ExplorePosSubscribe"]
                            </Button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</Page>
</div>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private bool _loadFailed;
    private string? _error;
    private IReadOnlyList<CommercialPlanDto> _plans = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            await Auth.EnsurePersonalAccountProfileAsync();
            if (!await OnlineRequired.EnsureOnlineForRouteAsync("/personal/explore-pos"))
            {
                _loadFailed = true;
                _error = L["OnlineRequired_Message"];
                return;
            }

            var result = await Platform.GetCommercialPlansAsync(PosProductCodes.PinoyBusinessPos);
            if (!result.IsSuccess || result.Data is null)
            {
                _loadFailed = true;
                _error = result.Error?.Detail ?? L["Personal_ExplorePosLoadFailed"];
                return;
            }

            _plans = result.Data
                .Where(p => string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<string> FeatureLines(CommercialPlanDto plan)
    {
        yield return string.Format(L["Personal_ExplorePosFeatureBranches"].Value, plan.MaxBranches);
        yield return string.Format(L["Personal_ExplorePosFeatureStaff"].Value, plan.MaxActiveStaff);
        yield return string.Format(L["Personal_ExplorePosFeatureDevices"].Value, plan.MaxActivePosDevices);
        yield return string.Format(L["Personal_ExplorePosFeatureBusinessTypes"].Value, plan.MaxActiveBusinessTypes);
        if (plan.CustomerCreditEnabled)
        {
            yield return L["Personal_ExplorePosFeatureCredit"];
        }

        if (plan.AdvancedReportsEnabled)
        {
            yield return L["Personal_ExplorePosFeatureReports"];
        }

        if (plan.ExportEnabled)
        {
            yield return L["Personal_ExplorePosFeatureExport"];
        }

        if (!string.IsNullOrWhiteSpace(plan.Description))
        {
            yield return plan.Description!;
        }
    }

    private void SelectPlan(CommercialPlanDto plan, bool startAsTrial, bool payNow)
    {
        var planKey = Uri.EscapeDataString(plan.PlanKey ?? plan.Code);
        var billing = "Monthly";
        Nav.NavigateTo(
            $"/start-business?planKey={planKey}&trial={(startAsTrial ? "1" : "0")}&payNow={(payNow ? "1" : "0")}&billing={billing}");
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/personal/utang/people"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject ILocalPersonalUtangStore LocalStore
@inject IPersonalOfflineSyncService PersonalSync
@inject IConnectivityService Connectivity
@inject OfflineAwareNavigation OfflineNav
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-people">
    <Page>
        <header class="pos-personal-people__header">
            <h1 class="pos-personal-people__title">@L["Personal_PeopleTitle"]</h1>
            <p class="pos-personal-people__subtitle">@L["Personal_PeopleSubtitle"]</p>
        </header>

        @if (_loading)
        {
            <Spinner />
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
        }
        else if (_loadFailed)
        {
            <ErrorState Title="@L["Personal_PeopleErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
        }
        else
        {
            @if (_pendingSync > 0)
            {
                <Alert Tone="AlertTone.Info"
                       Title="@L["Offline_SavedPendingSync"]"
                       Message="@string.Format(L["SyncStatus_PendingItems"].Value, _pendingSync)" />
            }

            @if (_contacts.Count == 0)
            {
                <EmptyState Title="@L["Personal_PeopleEmptyTitle"]" Message="@L["Personal_PeopleEmptyMessage"]" />
            }
            else
            {
                <div class="pos-personal-list" role="list">
                    @foreach (var c in _contacts)
                    {
                        <button type="button"
                                class="pos-personal-row"
                                role="listitem"
                                @onclick="() => GoDetail(c.Id)">
                            <span class="pos-personal-row__body">
                                <span class="pos-personal-row__title">@c.DisplayName</span>
                                <span class="pos-personal-row__meta">
                                    @(string.IsNullOrWhiteSpace(c.Phone) ? "—" : c.Phone)
                                    @if (string.Equals(c.SyncStatus, LocalPersonalSyncStatus.Pending, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="pos-personal-row__chip">@L["SyncStatus_PendingCountLabel"]</span>
                                    }
                                </span>
                            </span>
                            <span class="pos-personal-row__chevron" aria-hidden="true">›</span>
                        </button>
                    }
                </div>
            }

            @* Toggle only when a contact list exists; empty state already opens the form. *@
            @if (_contacts.Count > 0)
            {
                <div class="pos-personal-create-toggle">
                    <button type="button"
                            class="pos-action-tile @(_showCreate ? null : "pos-action-tile--primary")"
                            disabled="@_busy"
                            @onclick="ToggleCreate">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get(_showCreate ? "close" : "plus")</span>
                        <span class="pos-action-tile__label">@(_showCreate ? L["Common_Cancel"] : L["Personal_PeopleCreate"])</span>
                    </button>
                </div>
            }

            @if (_showCreate)
            {
                <Section Title="@L["Personal_PeopleAddByIdTitle"]">
                    <div class="pos-settings__panel">
                        <InlineMessage Tone="InlineMessageTone.Info">@L["Personal_PeopleAddByIdHint"]</InlineMessage>
                        <div class="pos-action-grid pos-action-grid--single pos-personal-people__actions" role="group">
                            <button type="button" class="pos-action-tile" disabled="@_busy" @onclick="GoResolveExItsId">
                                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                                <span class="pos-action-tile__label">@L["Personal_AddByExItsId"]</span>
                            </button>
                        </div>
                    </div>
                </Section>

                <Section Title="@L["Personal_PeopleCreateTitle"]">
                    <div class="pos-settings__panel">
                        <FormValidationSummary Messages="_errors" />
                        <Stack Gap="2">
                            <TextInput Label="@L["Register_DisplayName"]" @bind-Value="_name" Disabled="_busy" />
                            <TextInput Label="@L["Register_Email"]" @bind-Value="_email" Disabled="_busy" />
                            <TextInput Label="@L["Personal_PhoneLabel"]" @bind-Value="_phone" Disabled="_busy" />
                        </Stack>
                        <div class="pos-action-grid pos-action-grid--single pos-personal-people__actions" role="group">
                            <button type="button"
                                    class="pos-action-tile pos-action-tile--primary"
                                    disabled="@_busy"
                                    @onclick="CreateAsync">
                                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                                <span class="pos-action-tile__label">@L["Personal_PeopleCreate"]</span>
                            </button>
                        </div>
                    </div>
                </Section>
            }
        }
    </Page>
</div>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private bool _loadFailed;
    private bool _busy;
    private bool _showCreate;
    private string? _error;
    private string? _name;
    private string? _email;
    private string? _phone;
    private List<string> _errors = [];
    private IReadOnlyList<LocalPersonalContact> _contacts = [];
    private int _pendingSync;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            var personal = await Auth.EnsurePersonalAccountProfileAsync();
            if (!personal.Succeeded)
            {
                _loadFailed = true;
                _error = L[personal.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            await LocalStore.EnsurePersonalContextAsync();

            if (await Connectivity.IsConnectedAsync())
            {
                await TryHydrateFromServerAsync();
                await PersonalSync.TrySyncPendingAsync();
            }

            _contacts = await LocalStore.ListContactsAsync();
            _pendingSync = await PersonalSync.GetPendingCountAsync();
            _showCreate = _contacts.Count == 0;
        }
        catch
        {
            _loadFailed = true;
            _error = L["Personal_PeopleLoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleCreate() => _showCreate = !_showCreate;

    private async Task TryHydrateFromServerAsync()
    {
        var result = await Platform.GetPersonalContactsAsync();
        if (!result.IsSuccess || result.Data is null || CurrentUser.Session is null)
        {
            return;
        }

        var userId = CurrentUser.Session.UserId;
        foreach (var c in result.Data)
        {
            // COALESCE in Upsert keeps local Notes (email) when server Email is null.
            await LocalStore.UpsertServerContactAsync(new LocalPersonalContact(
                c.Id,
                userId,
                c.DisplayName,
                c.Phone,
                c.Email,
                LocalPersonalSyncStatus.Synced,
                c.Id,
                c.CreatedAtUtc,
                null));
        }
    }

    private async Task CreateAsync()
    {
        _errors = [];
        if (string.IsNullOrWhiteSpace(_name))
        {
            _errors.Add(L["Personal_PeopleNameRequired"]);
            return;
        }

        _busy = true;
        try
        {
            var contactId = Guid.NewGuid();
            var operationId = Guid.NewGuid();
            var notes = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim();
            await LocalStore.PersistContactAndEnqueueAsync(new LocalPersonalContactUpsertCommand(
                contactId,
                operationId,
                operationId.ToString("N"),
                _name.Trim(),
                string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
                notes));

            _name = _email = _phone = null;
            if (await Connectivity.IsConnectedAsync())
            {
                await PersonalSync.TrySyncPendingAsync();
            }

            await LoadAsync();
        }
        catch (InvalidOperationException ex) when (ex.Message == LocalPersonalStoreErrors.EmailConflict)
        {
            _errors.Add(L["Personal_PeopleEmailConflict"]);
        }
        catch
        {
            _errors.Add(L["Personal_PeopleCreateFailed"]);
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoDetail(Guid id) => Nav.NavigateTo($"/personal/utang/people/{id:D}");
    private void GoResolveExItsId() =>
        _ = OfflineNav.NavigateAsync("/personal/resolve-user?purpose=utang-people&return=/personal/utang/people");
    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/personal/my-qr"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L
@inject ApiStatusLocalizer ApiLocalizer
@inject IJSRuntime Js
@inject IDocumentHandoffService Handoff

<div class="pos-my-qr">
    <Page>
        <PageHeader Title="@L["Personal_MyQrTitle"]" Subtitle="@L["Personal_MyQrSubtitle"]" />

        <div class="pos-action-grid pos-action-grid--single pos-my-qr__nav" role="group">
            <button type="button" class="pos-action-tile" @onclick="GoBack">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("back")</span>
                <span class="pos-action-tile__label">@BackLabel</span>
            </button>
        </div>

        @if (_loading)
        {
            <Stack Align="StackAlign.Center" Gap="2">
                <Spinner />
                <span class="pos-muted">@L["Personal_MyQrLoading"]</span>
            </Stack>
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]"
                        Message="@L["Auth_SessionExpired"]"
                        RetryLabel="@L["SignIn_Submit"]"
                        OnRetry="GoSignIn" />
        }
        else if (_identityFailure)
        {
            <ErrorState Title="@_errorTitle"
                        Message="@_error"
                        RetryLabel="@L["Common_Retry"]"
                        OnRetry="LoadAsync" />
        }
        else if (_identity is not null && _renderFailure)
        {
            <Section Title="@_identity.DisplayName">
                <div class="pos-my-qr__id">@_identity.PublicUserId</div>
                <ErrorState Title="@L["Personal_MyQrRenderErrorTitle"]"
                            Message="@L["Personal_MyQrRenderFailed"]"
                            RetryLabel="@L["Personal_RefreshQrVisual"]"
                            OnRetry="RefreshVisual" />
            </Section>
        }
        else if (_identity is not null)
        {
            <Section Title="@_identity.DisplayName">
                <div class="pos-qr-panel pos-my-qr__panel">
                    <img class="pos-qr-image" src="@_qrDataUrl" alt="@L["Personal_MyQrTitle"]" width="220" height="220" />
                    <div class="pos-my-qr__id">@_identity.PublicUserId</div>
                    <span class="pos-muted">@L["Personal_MyQrHint"]</span>
                </div>

                <div class="pos-action-grid pos-action-grid--three pos-my-qr__actions" role="group" aria-label="@L["Personal_MyQrTitle"]">
                    <button type="button" class="pos-action-tile" @onclick="CopyIdAsync">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                        <span class="pos-action-tile__label">@L["Personal_CopyExItsId"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="ShareIdAsync">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("lent")</span>
                        <span class="pos-action-tile__label">@L["Personal_ShareExItsId"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="RefreshVisual">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                        <span class="pos-action-tile__label">@L["Personal_RefreshQrVisual"]</span>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_copyMessage))
                {
                    <Alert Tone="AlertTone.Info" Message="@_copyMessage" />
                }
            </Section>
        }
    </Page>
</div>

@code {
    [SupplyParameterFromQuery(Name = "return")]
    public string? ReturnPath { get; set; }

    private bool _loading = true;
    private bool _authenticated;
    private bool _identityFailure;
    private bool _renderFailure;
    private string _errorTitle = string.Empty;
    private string? _error;
    private string? _copyMessage;
    private string _qrDataUrl = string.Empty;
    private PublicIdentityDto? _identity;

    private string BackLabel =>
        IsOrgReturn
            ? L["Common_Back"]
            : L["Personal_BackMore"];

    private bool IsOrgReturn =>
        !string.IsNullOrWhiteSpace(ReturnPath)
        && ReturnPath.StartsWith("/org", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _identityFailure = false;
        _renderFailure = false;
        _error = null;
        _errorTitle = L["Personal_MyQrErrorTitle"];
        _copyMessage = null;
        _identity = null;
        _qrDataUrl = string.Empty;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            if (!await EnsurePlatformSessionAsync())
            {
                _authenticated = false;
                return;
            }

            // Public identity uses PlatformSession — do not switch away from org context first.
            var result = await Platform.GetMyPublicIdentityAsync();
            if ((!result.IsSuccess || result.Data is null)
                && result.Status == ApiCallStatus.Unauthorized)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (restore.Succeeded && await EnsurePlatformSessionAsync())
                {
                    result = await Platform.GetMyPublicIdentityAsync();
                }
            }

            if (!result.IsSuccess || result.Data is null)
            {
                // Optional personal-profile bind, then one more attempt.
                if (result.Status is ApiCallStatus.Unauthorized or ApiCallStatus.Forbidden)
                {
                    var personal = await Auth.EnsurePersonalAccountProfileAsync();
                    if (personal.Succeeded)
                    {
                        result = await Platform.GetMyPublicIdentityAsync();
                    }
                }
            }

            if (!result.IsSuccess || result.Data is null)
            {
                ApplyIdentityFailure(result);
                return;
            }

            if (!IsSafeIdentity(result.Data))
            {
                _identityFailure = true;
                _errorTitle = L["Personal_MyQrErrorTitle"];
                _error = L["Personal_MyQrUnsafePayload"];
                return;
            }

            _identity = result.Data;
            RefreshVisual();
        }
        catch
        {
            _identityFailure = true;
            _errorTitle = L["Personal_MyQrErrorTitle"];
            _error = L["Personal_MyQrNetworkFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<bool> EnsurePlatformSessionAsync()
    {
        if (!string.IsNullOrWhiteSpace(CurrentUser.Session?.PlatformSessionToken)
            || !string.IsNullOrWhiteSpace(CurrentUser.Session?.AccessToken))
        {
            return true;
        }

        var restore = await Auth.RestoreSessionAsync();
        return restore.Succeeded
               && (!string.IsNullOrWhiteSpace(CurrentUser.Session?.PlatformSessionToken)
                   || !string.IsNullOrWhiteSpace(CurrentUser.Session?.AccessToken));
    }

    private void ApplyIdentityFailure(ApiResult<PublicIdentityDto> result)
    {
        _identityFailure = true;
        var described = ApiLocalizer.Describe(result.Status, result.Error);
        (_errorTitle, _error) = result.Status switch
        {
            ApiCallStatus.Unauthorized => (L["Auth_SessionExpiredTitle"].Value, L["Auth_SessionExpired"].Value),
            ApiCallStatus.Forbidden => (L["Access_DeniedTitle"].Value, described.Message),
            ApiCallStatus.NotFound => (L["Personal_MyQrErrorTitle"].Value, L["Personal_MyQrMissingIdentity"].Value),
            ApiCallStatus.Offline or ApiCallStatus.Timeout or ApiCallStatus.Unavailable =>
                (L["Personal_MyQrErrorTitle"].Value, L["Personal_MyQrNetworkFailed"].Value),
            _ => (L["Personal_MyQrErrorTitle"].Value, result.Error?.Detail ?? L["Personal_MyQrLoadFailed"].Value)
        };
    }

    private static bool IsSafeIdentity(PublicIdentityDto identity)
    {
        if (string.IsNullOrWhiteSpace(identity.PublicUserId)
            || string.IsNullOrWhiteSpace(identity.QrPayload))
        {
            return false;
        }

        var expected = "exits://user/v1/" + identity.PublicUserId.Trim();
        return string.Equals(identity.QrPayload.Trim(), expected, StringComparison.Ordinal)
               && !identity.QrPayload.Contains('@', StringComparison.Ordinal)
               && !identity.QrPayload.Contains("Bearer", StringComparison.OrdinalIgnoreCase);
    }

    private void RefreshVisual()
    {
        _renderFailure = false;
        _copyMessage = null;
        if (_identity is null)
        {
            return;
        }

        if (!LocalQrCodeRenderer.TryToPngDataUrl(_identity.QrPayload, out var dataUrl))
        {
            _renderFailure = true;
            _qrDataUrl = string.Empty;
            return;
        }

        _qrDataUrl = dataUrl;
    }

    private async Task CopyIdAsync()
    {
        if (_identity is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _identity.PublicUserId);
            _copyMessage = L["Personal_CopyExItsIdDone"];
        }
        catch
        {
            _copyMessage = _identity.PublicUserId;
        }
    }

    private async Task ShareIdAsync()
    {
        if (_identity is null)
        {
            return;
        }

        try
        {
            var result = await Handoff.ShareTextAsync(
                L["Personal_MyQrTitle"],
                $"{_identity.DisplayName}\n{_identity.PublicUserId}\n{_identity.QrPayload}");
            _copyMessage = result.Initiated
                ? L["Personal_ShareExItsIdDone"]
                : L["Personal_ShareExItsIdUnavailable"];
        }
        catch
        {
            _copyMessage = L["Personal_ShareExItsIdUnavailable"];
        }
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnPath) && ReturnPath.StartsWith("/", StringComparison.Ordinal))
        {
            Nav.NavigateTo(ReturnPath!);
            return;
        }

        Nav.NavigateTo("/personal/more");
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

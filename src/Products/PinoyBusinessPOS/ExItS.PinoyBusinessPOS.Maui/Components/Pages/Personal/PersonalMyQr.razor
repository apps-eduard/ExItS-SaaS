@page "/personal/my-qr"
@layout Layout.PersonalShell
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L
@inject ApiStatusLocalizer ApiLocalizer
@inject IJSRuntime Js
@inject IDocumentHandoffService Handoff

<Page>
    <PageHeader Title="@L["Personal_MyQrTitle"]" Subtitle="@L["Personal_MyQrSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoMore">@L["Personal_BackMore"]</Button>
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <InlineMessage Tone="InlineMessageTone.Info">@L["Personal_MyQrLoading"]</InlineMessage>
        <Spinner />
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_identityFailure)
    {
        <ErrorState Title="@_errorTitle" Message="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    }
    else if (_identity is not null && _renderFailure)
    {
        <Section Title="@_identity.DisplayName">
            <div class="pos-value-md">@_identity.PublicUserId</div>
            <ErrorState Title="@L["Personal_MyQrRenderErrorTitle"]" Message="@L["Personal_MyQrRenderFailed"]" RetryLabel="@L["Personal_RefreshQrVisual"]" OnRetry="RefreshVisual" />
        </Section>
    }
    else if (_identity is not null)
    {
        <Section Title="@_identity.DisplayName">
            <div class="pos-qr-panel">
                <img class="pos-qr-image" src="@_qrDataUrl" alt="@L["Personal_MyQrTitle"]" width="220" height="220" />
                <div class="pos-value-md">@_identity.PublicUserId</div>
                <span class="pos-muted">@L["Personal_MyQrHint"]</span>
            </div>
            <FormActions>
                <Button Variant="ButtonVariant.Secondary" OnClick="CopyIdAsync">@L["Personal_CopyExItsId"]</Button>
                <Button Variant="ButtonVariant.Ghost" OnClick="ShareIdAsync">@L["Personal_ShareExItsId"]</Button>
                <Button Variant="ButtonVariant.Ghost" OnClick="RefreshVisual">@L["Personal_RefreshQrVisual"]</Button>
            </FormActions>
            @if (!string.IsNullOrEmpty(_copyMessage))
            {
                <InlineMessage Tone="InlineMessageTone.Info">@_copyMessage</InlineMessage>
            }
        </Section>
    }
</Page>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private bool _identityFailure;
    private bool _renderFailure;
    private string _errorTitle = string.Empty;
    private string? _error;
    private string? _copyMessage;
    private string _qrDataUrl = string.Empty;
    private PublicIdentityDto? _identity;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _identityFailure = false;
        _renderFailure = false;
        _error = null;
        _errorTitle = L["Personal_MyQrErrorTitle"];
        _copyMessage = null;
        _identity = null;
        _qrDataUrl = string.Empty;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            if (string.IsNullOrWhiteSpace(CurrentUser.Session?.PlatformSessionToken)
                && string.IsNullOrWhiteSpace(CurrentUser.Session?.AccessToken))
            {
                _authenticated = false;
                return;
            }

            await Auth.EnsurePersonalAccountProfileAsync();
            var result = await Platform.GetMyPublicIdentityAsync();
            if (!result.IsSuccess || result.Data is null)
            {
                ApplyIdentityFailure(result);
                return;
            }

            if (!IsSafeIdentity(result.Data))
            {
                _identityFailure = true;
                _errorTitle = L["Personal_MyQrErrorTitle"];
                _error = L["Personal_MyQrUnsafePayload"];
                return;
            }

            _identity = result.Data;
            RefreshVisual();
        }
        catch
        {
            _identityFailure = true;
            _errorTitle = L["Personal_MyQrErrorTitle"];
            _error = L["Personal_MyQrNetworkFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyIdentityFailure(ApiResult<PublicIdentityDto> result)
    {
        _identityFailure = true;
        var described = ApiLocalizer.Describe(result.Status, result.Error);
        (_errorTitle, _error) = result.Status switch
        {
            ApiCallStatus.Unauthorized => (L["Auth_SessionExpiredTitle"].Value, L["Auth_SessionExpired"].Value),
            ApiCallStatus.Forbidden => (L["Access_DeniedTitle"].Value, described.Message),
            ApiCallStatus.NotFound => (L["Personal_MyQrErrorTitle"].Value, L["Personal_MyQrMissingIdentity"].Value),
            ApiCallStatus.Offline or ApiCallStatus.Timeout or ApiCallStatus.Unavailable =>
                (L["Personal_MyQrErrorTitle"].Value, L["Personal_MyQrNetworkFailed"].Value),
            _ => (L["Personal_MyQrErrorTitle"].Value, result.Error?.Detail ?? L["Personal_MyQrLoadFailed"].Value)
        };
    }

    private static bool IsSafeIdentity(PublicIdentityDto identity)
    {
        if (string.IsNullOrWhiteSpace(identity.PublicUserId)
            || string.IsNullOrWhiteSpace(identity.QrPayload))
        {
            return false;
        }

        // Payload must be the versioned public reference only.
        var expected = "exits://user/v1/" + identity.PublicUserId.Trim();
        return string.Equals(identity.QrPayload.Trim(), expected, StringComparison.Ordinal)
               && !identity.QrPayload.Contains('@', StringComparison.Ordinal)
               && !identity.QrPayload.Contains("Bearer", StringComparison.OrdinalIgnoreCase);
    }

    private void RefreshVisual()
    {
        _renderFailure = false;
        _copyMessage = null;
        if (_identity is null)
        {
            return;
        }

        if (!LocalQrCodeRenderer.TryToPngDataUrl(_identity.QrPayload, out var dataUrl))
        {
            _renderFailure = true;
            _qrDataUrl = string.Empty;
            return;
        }

        _qrDataUrl = dataUrl;
    }

    private async Task CopyIdAsync()
    {
        if (_identity is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _identity.PublicUserId);
            _copyMessage = L["Personal_CopyExItsIdDone"];
        }
        catch
        {
            _copyMessage = _identity.PublicUserId;
        }
    }

    private async Task ShareIdAsync()
    {
        if (_identity is null)
        {
            return;
        }

        try
        {
            var result = await Handoff.ShareTextAsync(
                L["Personal_MyQrTitle"],
                $"{_identity.DisplayName}\n{_identity.PublicUserId}\n{_identity.QrPayload}");
            _copyMessage = result.Initiated
                ? L["Personal_ShareExItsIdDone"]
                : L["Personal_ShareExItsIdUnavailable"];
        }
        catch
        {
            _copyMessage = L["Personal_ShareExItsIdUnavailable"];
        }
    }

    private void GoMore() => Nav.NavigateTo("/personal/more");
    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/personal/linked-merchants/{OrganizationId:guid}/shop"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.CustomerOrdering
@implements IDisposable
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPosCustomerOrderClient Orders
@inject PersonalMerchantCart Cart
@inject OnlineRequiredGuard OnlineRequired
@inject OfflineAwareNavigation OfflineNav
@inject NavigationManager Nav
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-shop">
    <StoreHeaderBack Href="/personal/linked-merchants" />
    <Page>
        <header class="pos-personal-shop__header">
            <h1 class="pos-personal-shop__title">@(_storefront?.OrganizationDisplayName ?? L["Personal_ShopTitle"])</h1>
            <p class="pos-personal-shop__subtitle">@L["Personal_ShopSubtitle"]</p>
        </header>

        @if (_loading)
        {
            <div class="pos-personal-shop__loading"><Spinner /><span>@L["Common_Loading"]</span></div>
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <ErrorState Title="@L["Personal_ShopErrorTitle"]" Message="@_error" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
        }
        else if (_storefront is null)
        {
            <EmptyState Title="@L["Personal_ShopUnavailableTitle"]" Message="@L["Personal_ShopUnavailableMessage"]" />
        }
        else
        {
            <div class="pos-personal-shop__search">
                <input class="pos-personal-shop__search-input"
                       type="search"
                       value="@_search"
                       placeholder="@L["Personal_ShopSearchPlaceholder"]"
                       aria-label="@L["Personal_ShopSearchPlaceholder"]"
                       @oninput="OnSearchInput" />
            </div>

            @if (_storefront.Categories.Count > 0)
            {
                <div class="pos-personal-shop__chips" role="list">
                    <button type="button"
                            class="pos-personal-shop__chip @(_categoryId is null ? "pos-personal-shop__chip--active" : null)"
                            @onclick="() => SelectCategoryAsync(null)">@L["Personal_ShopAllCategories"]</button>
                    @foreach (var category in _storefront.Categories)
                    {
                        <button type="button"
                                class="pos-personal-shop__chip @(_categoryId == category.CategoryId ? "pos-personal-shop__chip--active" : null)"
                                @onclick="() => SelectCategoryAsync(category.CategoryId)">@category.Name</button>
                    }
                </div>
            }

            @if (_storefront.Products.Count == 0)
            {
                <EmptyState Title="@L["Personal_ShopEmptyTitle"]" Message="@L["Personal_ShopEmptyMessage"]" />
            }
            else
            {
                <div class="pos-personal-shop__products pos-purchasing-create__product-list" role="list">
                    @foreach (var product in _storefront.Products)
                    {
                        var qty = Cart.GetQuantity(product.ProductId);
                        var added = qty > 0m;
                        <div class="@($"pos-purchasing-create__hit pos-purchasing-create__hit--ready{(added ? " pos-purchasing-create__hit--added" : string.Empty)}")"
                             role="listitem">
                            <div class="pos-purchasing-create__hit-main">
                                <span class="pos-purchasing-create__hit-name">@product.Name</span>
                                <span class="pos-purchasing-create__hit-meta pos-muted">
                                    @product.UnitOfMeasure
                                    <text> · </text>
                                    <MoneyDisplay Amount="@product.UnitPrice" CurrencyCode="PHP" />
                                    @if (!product.IsAvailable)
                                    {
                                        <text> · </text>@L["Personal_ShopUnavailable"]
                                    }
                                </span>
                                @if (added)
                                {
                                    <span class="pos-purchasing-create__hit-added">
                                        ✓ @L["Purchasing_AddedQty", FormatQty(qty)]
                                    </span>
                                }
                            </div>
                            <div class="pos-purchasing-create__qty" role="group" aria-label="@L["Personal_ShopQtyLabel", product.Name]">
                                @if (added)
                                {
                                    <button type="button"
                                            class="pos-purchasing-create__hit-add"
                                            title="@L["Purchasing_DecreaseQtyNamed", product.Name]"
                                            aria-label="@L["Purchasing_DecreaseQtyNamed", product.Name]"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => Decrement(product.ProductId)">
                                        <span aria-hidden="true">−</span>
                                    </button>
                                }
                                <button type="button"
                                        class="pos-purchasing-create__hit-add"
                                        disabled="@(!product.IsAvailable)"
                                        title="@L["Purchasing_IncreaseQtyNamed", product.Name]"
                                        aria-label="@L["Purchasing_IncreaseQtyNamed", product.Name]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Increment(product)">
                                    <span aria-hidden="true">+</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </Page>

    @if (Cart.LineCount > 0)
    {
        <div class="pos-personal-shop__cart-bar">
            <div class="pos-personal-shop__cart-summary">
                <strong>@L["Personal_ShopCartItems", Cart.ItemCount.ToString("0.##")]</strong>
                <span><MoneyDisplay Amount="@Cart.MerchandiseSubtotal" CurrencyCode="PHP" /></span>
            </div>
            <Button Variant="ButtonVariant.Primary" OnClick="GoReviewAsync">@L["Personal_ShopReview"]</Button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid OrganizationId { get; set; }

    private bool _loading = true;
    private bool _authenticated;
    private string? _error;
    private string _search = string.Empty;
    private Guid? _categoryId;
    private CustomerStorefrontDto? _storefront;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnParametersSetAsync()
    {
        Cart.EnsureMerchant(OrganizationId, null);
        Cart.Changed += OnCartChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Cart.Changed -= OnCartChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (!await EnsureSessionAsync())
            {
                return;
            }

            if (!await Connectivity.IsConnectedAsync())
            {
                _error = L["Personal_ShopOffline"];
                _storefront = null;
                return;
            }

            if (!await OnlineRequired.EnsureOnlineForRouteAsync($"/personal/linked-merchants/{OrganizationId:D}/shop"))
            {
                _error = L["Personal_ShopOffline"];
                return;
            }

            var result = await Orders.GetStorefrontAsync(
                OrganizationId,
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _categoryId,
                page: 1,
                pageSize: 40);
            if (!result.IsSuccess || result.Data is null)
            {
                _storefront = null;
                _error = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            _storefront = result.Data;
            Cart.EnsureMerchant(OrganizationId, result.Data.OrganizationDisplayName);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectCategoryAsync(Guid? categoryId)
    {
        _categoryId = categoryId;
        await LoadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await LoadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void Increment(CustomerStorefrontProductDto product) => Cart.Increment(product);
    private void Decrement(Guid productId) => Cart.Decrement(productId);

    private static string FormatQty(decimal qty) =>
        qty.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private Task GoReviewAsync() =>
        OfflineNav.NavigateAsync($"/personal/linked-merchants/{OrganizationId:D}/shop/review");

    private async Task<bool> EnsureSessionAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            _authenticated = restore.Succeeded;
        }
        else
        {
            _authenticated = true;
        }

        if (!_authenticated)
        {
            return false;
        }

        var personal = await Auth.EnsurePersonalAccountProfileAsync();
        if (!personal.Succeeded)
        {
            _error = L[personal.SafeMessageKey ?? "Access_Denied"];
            return false;
        }

        return true;
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

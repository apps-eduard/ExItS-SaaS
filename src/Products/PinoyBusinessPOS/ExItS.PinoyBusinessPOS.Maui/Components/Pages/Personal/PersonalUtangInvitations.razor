@page "/personal/utang/invitations"
@layout Layout.PersonalShell
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/personal/more" />
<Page>
    <PageHeader Title="@L["Personal_UtangInvitationsTitle"]" Subtitle="@L["Personal_UtangInvitationsSubtitle"]" />

    @if (_loading)
    {
        <Spinner />
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_loadFailed)
    {
        <ErrorState Title="@L["Personal_UtangInvitationsErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    }
    else
    {
        @if (_invitations.Count == 0)
        {
            <EmptyState Title="@L["Personal_NoUtangInvitationsTitle"]" Message="@L["Personal_NoUtangInvitationsMessage"]" />
        }
        else
        {
            <Stack Gap="3">
                @foreach (var invite in _invitations)
                {
                    <div class="pos-personal-org">
                        <Stack Gap="1">
                            <span class="pos-value-md">@(invite.InviteTargetEmailMasked ?? invite.Id.ToString("D")[..8])</span>
                            <span class="pos-muted">@invite.Status · @invite.ExpiresAtUtc.LocalDateTime.ToString("g")</span>
                        </Stack>
                    </div>
                }
            </Stack>
        }

        <Section Title="@L["Personal_UtangInvitationTokenSection"]">
            <FormValidationSummary Messages="_errors" />
            <FormGroup>
                <TextInput Label="@L["Personal_InvitationTokenLabel"]" @bind-Value="_token" Disabled="_busy" />
            </FormGroup>
            <FormActions>
                <Button IsLoading="_busy" Disabled="_busy || string.IsNullOrWhiteSpace(_token)" OnClick="AcceptAsync">@L["Personal_AcceptInvitation"]</Button>
                <Button Variant="ButtonVariant.Secondary" IsLoading="_busy" Disabled="_busy || string.IsNullOrWhiteSpace(_token)" OnClick="DeclineAsync">@L["Personal_DeclineInvitation"]</Button>
            </FormActions>
        </Section>
    }
</Page>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private bool _loadFailed;
    private bool _busy;
    private string? _error;
    private string? _token;
    private List<string> _errors = [];
    private IReadOnlyList<PersonalUtangInvitationDto> _invitations = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            var personal = await Auth.EnsurePersonalAccountProfileAsync();
            if (!personal.Succeeded)
            {
                _loadFailed = true;
                _error = L[personal.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            var result = await Platform.GetPersonalUtangInvitationsAsync();
            if (!result.IsSuccess || result.Data is null)
            {
                _loadFailed = true;
                _error = result.Error?.Detail ?? L["Personal_UtangInvitationsLoadFailed"];
                return;
            }

            _invitations = result.Data;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AcceptAsync()
    {
        _errors = [];
        if (string.IsNullOrWhiteSpace(_token))
        {
            _errors.Add(L["Personal_InvitationTokenRequired"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.AcceptPersonalUtangInvitationAsync(_token.Trim());
            if (!result.IsSuccess)
            {
                _errors.Add(result.Error?.Detail ?? L["Personal_AcceptInvitationFailed"]);
                return;
            }

            _token = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeclineAsync()
    {
        _errors = [];
        if (string.IsNullOrWhiteSpace(_token))
        {
            _errors.Add(L["Personal_InvitationTokenRequired"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.DeclinePersonalUtangInvitationAsync(_token.Trim());
            if (!result.IsSuccess)
            {
                _errors.Add(result.Error?.Detail ?? L["Personal_DeclineInvitationFailed"]);
                return;
            }

            _token = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/personal/settings"
@layout Layout.PersonalShell
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject ThemeController ThemeCtl
@inject DensityController DensityCtl
@inject CultureController CultureCtl
@inject IAppInfoService AppInfo
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject ApiStatusLocalizer ApiLocalizer
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-settings pos-personal-settings">
    <StoreHeaderBack Href="/personal/more" />
    <Page>
        <header class="pos-personal-settings__header">
            <h1 class="pos-personal-settings__title">@L["Personal_SettingsTitle"]</h1>
            <p class="pos-personal-settings__subtitle">@L["Personal_SettingsSubtitle"]</p>
        </header>

        @if (!_ready)
        {
            <Stack Align="StackAlign.Center" Gap="2">
                <Spinner />
            </Stack>
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]"
                        Message="@L["Auth_SessionExpired"]"
                        RetryLabel="@L["SignIn_Submit"]"
                        OnRetry="GoSignIn" />
        }
        else
        {
            <Section Title="@L["Settings_SessionSectionTitle"]">
                <div class="pos-settings__panel">
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["AccessConfirm_UserLabel"]</span>
                        <span class="pos-settings__kv-value">@(CurrentUser.Session?.DisplayName)</span>
                    </div>
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Personal_AccountClass"]</span>
                        <span class="pos-settings__kv-value">@(CurrentUser.Session?.AccountClass ?? L["Personal_AccountClassDefault"])</span>
                    </div>
                    <button type="button" class="pos-settings__nav" @onclick="GoOrganizationSelect">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                        <span class="pos-settings__nav-label">@L["Settings_SwitchOrganization"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                </div>
            </Section>

            <AccountContextSwitcher />

            @if (_preferenceError is not null)
            {
                <Alert Tone="AlertTone.Danger" Message="@_preferenceError" />
            }

            <Section Title="@L["Offline_PinSetupTitle"]">
                <div class="pos-settings__panel">
                    <button type="button" class="pos-settings__nav pos-settings__nav--block" @onclick="GoOfflinePin">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("lock")</span>
                        <span class="pos-settings__nav-body">
                            <span class="pos-settings__nav-label">@(_hasOfflinePin ? L["Offline_PinChangeAction"] : L["Offline_PinEnrollAction"])</span>
                            <span class="pos-settings__nav-meta">@(_hasOfflinePin ? L["Offline_PinChangeHint"] : L["Offline_PinSetupHint"])</span>
                        </span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                </div>
            </Section>

            <Section Title="@L["Settings_AppearanceSectionTitle"]">
                <div class="pos-settings__panel">
                    <Stack Gap="2">
                        <Select Label="@L["Settings_ThemeLabel"]"
                                Value="@ThemeCtl.Current.ToString()"
                                ValueChanged="OnThemeChangedAsync"
                                Options="ThemeOptions" />
                        <Select Label="@L["Settings_DensityLabel"]"
                                Value="@DensityCtl.Current.ToString()"
                                ValueChanged="OnDensityChangedAsync"
                                Options="DensityOptions" />
                        <Select Label="@L["Settings_LanguageLabel"]"
                                Value="@CultureCtl.Current"
                                ValueChanged="OnCultureChangedAsync"
                                Options="CultureOptions" />
                    </Stack>
                </div>
            </Section>

            <Section Title="@L["Support_SectionTitle"]">
                <div class="pos-settings__panel">
                    <button type="button" class="pos-settings__nav pos-settings__nav--block" @onclick="GoSupportDiagnostics">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
                        <span class="pos-settings__nav-body">
                            <span class="pos-settings__nav-label">@L["Support_DiagnosticsLink"]</span>
                            <span class="pos-settings__nav-meta">@L["Support_DiagnosticsLinkHint"]</span>
                        </span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                </div>
            </Section>

            <Section Title="@L["Settings_AboutSectionTitle"]">
                <div class="pos-settings__panel">
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Settings_AppVersionLabel"]</span>
                        <span class="pos-settings__kv-value">@AppInfo.Version</span>
                    </div>
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Home_EnvironmentLabel"]</span>
                        <span class="pos-settings__kv-value">@EnvironmentLabel</span>
                    </div>
                </div>
            </Section>
        }
    </Page>
</div>

@code {
    private bool _ready;
    private bool _authenticated;
    private bool _hasOfflinePin;
    private string? _preferenceError;

    private IReadOnlyList<SelectOption> ThemeOptions =>
    [
        new(nameof(ThemePreference.System), L["Settings_Theme_System"]),
        new(nameof(ThemePreference.Light), L["Settings_Theme_Light"]),
        new(nameof(ThemePreference.Dark), L["Settings_Theme_Dark"]),
    ];

    private IReadOnlyList<SelectOption> DensityOptions =>
    [
        new(nameof(DensityMode.Compact), L["Settings_Density_Compact"]),
        new(nameof(DensityMode.Comfortable), L["Settings_Density_Comfortable"]),
    ];

    private IReadOnlyList<SelectOption> CultureOptions =>
    [
        new(MauiCulturePreferenceStore.English, L["Settings_Language_English"]),
        new(MauiCulturePreferenceStore.Filipino, L["Settings_Language_Filipino"]),
    ];

    private string EnvironmentLabel =>
        string.Equals(AppInfo.EnvironmentName, "Development", StringComparison.OrdinalIgnoreCase)
            ? L["Env_Development"]
            : string.Equals(AppInfo.EnvironmentName, "Testing", StringComparison.OrdinalIgnoreCase)
                ? L["Env_Testing"]
                : L["Env_Production"];

    protected override async Task OnInitializedAsync()
    {
        ThemeCtl.Changed += OnChangedAsync;
        DensityCtl.Changed += OnChangedAsync;
        CultureCtl.Changed += OnChangedAsync;

        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            _authenticated = restore.Succeeded;
        }
        else
        {
            _authenticated = true;
        }

        if (_authenticated)
        {
            _hasOfflinePin = await Auth.HasOfflinePinConfiguredAsync();
        }

        _ready = true;
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
    private void GoOrganizationSelect() => Nav.NavigateTo("/organization-select");
    private void GoSupportDiagnostics() => Nav.NavigateTo("/personal/settings/support/diagnostics");

    private void GoOfflinePin()
    {
        var mode = _hasOfflinePin ? "change" : "enroll";
        Nav.NavigateTo($"/offline-pin-setup?mode={mode}&return=/personal/settings");
    }

    private async Task OnThemeChangedAsync(string? value)
    {
        _preferenceError = null;
        if (Enum.TryParse<ThemePreference>(value, out var preference))
        {
            if (!await ThemeCtl.SetThemeAsync(preference))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task OnDensityChangedAsync(string? value)
    {
        _preferenceError = null;
        if (Enum.TryParse<DensityMode>(value, out var density))
        {
            if (!await DensityCtl.SetDensityAsync(density))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task OnCultureChangedAsync(string? value)
    {
        _preferenceError = null;
        if (!string.IsNullOrEmpty(value))
        {
            if (!await CultureCtl.SetCultureAsync(value))
            {
                _preferenceError = ApiLocalizer.PreferenceSaveFailed;
            }
        }
    }

    private async Task OnChangedAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeCtl.Changed -= OnChangedAsync;
        DensityCtl.Changed -= OnChangedAsync;
        CultureCtl.Changed -= OnChangedAsync;
    }
}

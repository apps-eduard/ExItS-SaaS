@page "/personal/resolve-user"
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IQrCodeScanService QrScan
@inject ApiStatusLocalizer ApiLocalizer
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-resolve">
    <StoreHeaderBack Handler="GoBackAsync" />
    <Page>
        <PageHeader Title="@L["Personal_ResolveUserTitle"]" Subtitle="@L["Personal_ResolveUserSubtitle"]" />

        @if (_loadingSession)
        {
            <Stack Align="StackAlign.Center" Gap="2">
                <Spinner />
            </Stack>
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]"
                        Message="@L["Auth_SessionExpired"]"
                        RetryLabel="@L["SignIn_Submit"]"
                        OnRetry="GoSignIn" />
        }
        else if (_resolved is null)
        {
            <Alert Tone="AlertTone.Info"
                   Title="@L["Personal_ResolveUserManualHint"]"
                   Message="@L["Personal_ScanQrHint"]" />

            <FormValidationSummary Messages="_errors" />

            <FormGroup>
                <TextInput Label="@L["Personal_ExItsIdLabel"]"
                           Hint="@L["Personal_ExItsIdHint"]"
                           @bind-Value="_input"
                           Disabled="_busy" />
            </FormGroup>

            <div class="pos-action-grid pos-action-grid--three pos-resolve-actions"
                 role="group"
                 aria-label="@L["Personal_ResolveUserTitle"]">
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@_busy"
                        @onclick="ScanQrAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                    <span class="pos-action-tile__label">@L["Personal_ScanQr"]</span>
                </button>
                <button type="button"
                        class="pos-action-tile"
                        disabled="@_busy"
                        @onclick="PickQrImageAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("image")</span>
                    <span class="pos-action-tile__label">@L["Personal_PickQrImage"]</span>
                </button>
                <button type="button"
                        class="pos-action-tile pos-action-tile--primary"
                        disabled="@_busy"
                        @onclick="ResolveAsync">
                    <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                    <span class="pos-action-tile__label">@L["Personal_ResolveLookup"]</span>
                </button>
            </div>

            @if (_busy)
            {
                <div class="pos-resolve__busy" role="status" aria-live="polite">
                    <Spinner />
                    <span class="pos-muted">@L["Common_Loading"]</span>
                </div>
            }
        }
        else
        {
            <Section Title="@L["Personal_ResolveConfirmTitle"]">
                <div class="pos-resolve__identity" role="group" aria-label="@L["Personal_ResolveConfirmTitle"]">
                    <span class="pos-resolve__identity-name">@_resolved.DisplayName</span>
                    <span class="pos-resolve__identity-id">@_resolved.PublicUserId</span>
                    @if (!string.IsNullOrWhiteSpace(_resolved.MaskedEmail))
                    {
                        <span class="pos-muted">@_resolved.MaskedEmail</span>
                    }
                </div>

                @if (_resolved.IsSelf)
                {
                    <Alert Tone="AlertTone.Warning" Message="@L["Personal_ResolveSelf"]" />
                }

                <Alert Tone="AlertTone.Info" Message="@L["Personal_ResolveConfirmHint"]" />

                <FormValidationSummary Messages="_errors" />

                <div class="pos-action-grid pos-action-grid--two pos-resolve-actions" role="group">
                    <button type="button"
                            class="pos-action-tile"
                            disabled="@_busy"
                            @onclick="ClearResolved">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                        <span class="pos-action-tile__label">@L["Common_Cancel"]</span>
                    </button>
                    <button type="button"
                            class="pos-action-tile pos-action-tile--primary"
                            disabled="@(_resolved.IsSelf || _busy)"
                            @onclick="ConfirmAsync">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                        <span class="pos-action-tile__label">@L["Personal_ResolveConfirm"]</span>
                    </button>
                </div>

                @if (_busy)
                {
                    <div class="pos-resolve__busy" role="status" aria-live="polite">
                        <Spinner />
                        <span class="pos-muted">@L["Common_Loading"]</span>
                    </div>
                }
            </Section>
        }
    </Page>
</div>

@code {
    [SupplyParameterFromQuery(Name = "purpose")]
    public string? Purpose { get; set; }

    [SupplyParameterFromQuery(Name = "return")]
    public string? ReturnPath { get; set; }

    [SupplyParameterFromQuery(Name = "scan")]
    public string? AutoScan { get; set; }

    private bool _loadingSession = true;
    private bool _authenticated;
    private bool _busy;
    private bool _autoScanStarted;
    private string? _input;
    private List<string> _errors = [];
    private ResolvedPublicUserDto? _resolved;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            _authenticated = restore.Succeeded;
        }
        else
        {
            _authenticated = true;
        }

        _loadingSession = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _autoScanStarted || !_authenticated || _resolved is not null)
        {
            return;
        }

        if (!string.Equals(AutoScan, "1", StringComparison.Ordinal)
            && !string.Equals(AutoScan, "true", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _autoScanStarted = true;
        await ScanQrAsync();
    }

    private async Task ScanQrAsync()
    {
        await ApplyScanResultAsync(await QrScan.CaptureAsync());
    }

    private async Task PickQrImageAsync()
    {
        await ApplyScanResultAsync(await QrScan.PickFromGalleryAsync());
    }

    private async Task ApplyScanResultAsync(QrScanResult scan)
    {
        _errors = [];
        if (!scan.Succeeded)
        {
            if (!string.IsNullOrWhiteSpace(scan.ErrorKey)
                && !string.Equals(scan.ErrorKey, "Personal_ScanCancelled", StringComparison.Ordinal))
            {
                _errors.Add(L[scan.ErrorKey]);
            }

            return;
        }

        _input = scan.Payload;
        await ResolveAsync();
    }

    private async Task ResolveAsync()
    {
        _errors = [];
        if (string.IsNullOrWhiteSpace(_input))
        {
            _errors.Add(L["Personal_ExItsIdRequired"]);
            return;
        }

        if (!await EnsurePlatformSessionAsync())
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.ResolvePublicUserIdAsync(new ResolvePublicUserIdRequest(
                _input.Trim(),
                Purpose ?? "manual"));

            // Empty 401 bodies were previously shown as "No active user matched" — retry once after restore.
            if ((!result.IsSuccess || result.Data is null)
                && result.Status == ApiCallStatus.Unauthorized)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (restore.Succeeded && !string.IsNullOrWhiteSpace(CurrentUser.Session?.PlatformSessionToken))
                {
                    result = await Platform.ResolvePublicUserIdAsync(new ResolvePublicUserIdRequest(
                        _input.Trim(),
                        Purpose ?? "manual"));
                }
            }

            if (!result.IsSuccess || result.Data is null)
            {
                _errors.Add(DescribeResolveFailure(result));
                return;
            }

            _resolved = result.Data;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> EnsurePlatformSessionAsync()
    {
        if (!string.IsNullOrWhiteSpace(CurrentUser.Session?.PlatformSessionToken))
        {
            return true;
        }

        var restore = await Auth.RestoreSessionAsync();
        if (restore.Succeeded && !string.IsNullOrWhiteSpace(CurrentUser.Session?.PlatformSessionToken))
        {
            return true;
        }

        _errors.Add(L["Personal_ResolveSessionRequired"]);
        return false;
    }

    private string DescribeResolveFailure(ApiResult<ResolvedPublicUserDto> result)
    {
        if (result.Status == ApiCallStatus.NotFound)
        {
            return string.IsNullOrWhiteSpace(result.Error?.Detail)
                ? L["Personal_ResolveNotFound"]
                : result.Error.Detail!;
        }

        if (result.Status is ApiCallStatus.Unauthorized or ApiCallStatus.Forbidden)
        {
            return L["Personal_ResolveSessionRequired"];
        }

        if (!string.IsNullOrWhiteSpace(result.Error?.Detail))
        {
            return result.Error.Detail!;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        return described.Message;
    }

    private async Task ConfirmAsync()
    {
        if (_resolved is null || _resolved.IsSelf)
        {
            return;
        }

        _errors = [];
        _busy = true;
        try
        {
            var purpose = (Purpose ?? "manual").Trim().ToLowerInvariant();
            if (purpose is "utang-people" or "utang" or "people")
            {
                var created = await Platform.CreatePersonalContactAsync(new CreatePersonalContactRequest(
                    DisplayName: _resolved.DisplayName,
                    Phone: null,
                    Email: null));
                if (!created.IsSuccess)
                {
                    _errors.Add(created.Error?.Detail ?? L["Personal_PeopleCreateFailed"]);
                    return;
                }

                Nav.NavigateTo("/personal/utang/people", replace: true);
                return;
            }

            // Customer / staff / sale: return identity refs only — caller confirms final create/invite.
            var ret = string.IsNullOrWhiteSpace(ReturnPath) ? "/personal/more" : ReturnPath!;
            var sep = ret.Contains('?', StringComparison.Ordinal) ? "&" : "?";
            Nav.NavigateTo(
                $"{ret}{sep}publicUserId={Uri.EscapeDataString(_resolved.PublicUserId)}&displayName={Uri.EscapeDataString(_resolved.DisplayName)}&userId={_resolved.UserIdentityId:D}",
                replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearResolved() => _resolved = null;

    private Task GoBackAsync()
    {
        GoBack();
        return Task.CompletedTask;
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnPath))
        {
            Nav.NavigateTo(ReturnPath!);
            return;
        }

        Nav.NavigateTo("/personal/more");
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

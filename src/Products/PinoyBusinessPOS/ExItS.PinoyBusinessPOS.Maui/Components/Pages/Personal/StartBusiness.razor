@page "/start-business"
@layout Layout.AuthShell
@using ExItS.PinoyBusinessPOS.Application.Commercial
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IOnboardingPreferenceStore Prefs
@inject OnlineRequiredGuard OnlineRequired
@inject NavigationGate Gate
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-start-business">
<StoreHeaderBack Href="/personal/explore-pos" />
<Page>
    <header class="pos-personal-start-business__header">
        <h1 class="pos-personal-start-business__title">@L["StartBusiness_Title"]</h1>
        <p class="pos-personal-start-business__subtitle">@L["StartBusiness_Subtitle"]</p>
    </header>

    @if (!_ready)
    {
        <Spinner />
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (string.IsNullOrWhiteSpace(_planKey))
    {
        <InlineMessage Tone="InlineMessageTone.Warning">@L["StartBusiness_PlanRequired"]</InlineMessage>
        <FormActions>
            <Button Variant="ButtonVariant.Primary" OnClick="GoExplore">@L["Personal_ExplorePos"]</Button>
        </FormActions>
    }
    else
    {
        <FormValidationSummary Messages="_errors" />

        <section class="pos-start-business-form" aria-labelledby="start-business-type-heading">
            <h2 class="pos-start-business-form__title" id="start-business-type-heading">@L["StartBusiness_PrimaryTypeTitle"]</h2>
            <p class="pos-start-business-form__hint pos-muted">@L["StartBusiness_PrimaryTypeHint"]</p>

            @if (_businessTypesLoading)
            {
                <Spinner />
            }
            else if (_businessTypes.Count == 0)
            {
                <InlineMessage Tone="InlineMessageTone.Warning">@L["StartBusiness_BusinessTypesLoadFailed"]</InlineMessage>
            }
            else
            {
                <div class="pos-bt-cards" role="listbox" aria-label="@L["StartBusiness_PrimaryTypeTitle"]">
                    @foreach (var type in _businessTypes.OrderBy(t => t.SortOrder).ThenBy(t => t.Name))
                    {
                        var selected = string.Equals(_primaryBusinessTypeId, type.Id.ToString("D"), StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="pos-bt-card @(selected ? "pos-bt-card--selected" : null)"
                                role="option"
                                aria-selected="@selected"
                                disabled="@_busy"
                                @onclick="() => SelectBusinessType(type.Id)">
                            <span class="pos-bt-card__name">@type.Name</span>
                            @if (!string.IsNullOrWhiteSpace(type.Description))
                            {
                                <span class="pos-bt-card__desc pos-muted">@type.Description</span>
                            }
                        </button>
                    }
                </div>
            }
        </section>

        <section class="pos-start-business-form" aria-labelledby="start-business-form-heading">
            <h2 class="pos-start-business-form__title" id="start-business-form-heading">@L["StartBusiness_FormTitle"]</h2>
            <Stack Gap="3">
                <TextInput Label="@L["StartBusiness_DisplayName"]"
                           Value="@_displayName"
                           ValueChanged="OnDisplayNameChanged"
                           Placeholder="@L["StartBusiness_DisplayNamePlaceholder"]"
                           Disabled="_busy"
                           Required="true" />
                <TextInput Label="@L["StartBusiness_Slug"]"
                           Value="@_slug"
                           ValueChanged="OnSlugChanged"
                           Hint="@L["StartBusiness_SlugHint"]"
                           Placeholder="@L["StartBusiness_SlugPlaceholder"]"
                           Disabled="_busy"
                           Required="true" />
            </Stack>
        </section>

        <section class="pos-start-business-form" aria-labelledby="start-business-contact-heading">
            <h2 class="pos-start-business-form__title" id="start-business-contact-heading">@L["StartBusiness_ContactTitle"]</h2>
            <p class="pos-start-business-form__hint pos-muted">@L["StartBusiness_ContactHelper"]</p>
            <Stack Gap="3">
                <Checkbox Value="_useMyContactDetails"
                          ValueChanged="OnUseMyContactDetailsChanged"
                          Disabled="_busy">@L["StartBusiness_UseMyContactDetails"]</Checkbox>
                <TextInput Label="@L["StartBusiness_ContactEmail"]"
                           Value="@_contactEmail"
                           ValueChanged="OnContactEmailChanged"
                           Disabled="_busy" />
                <TextInput Label="@L["StartBusiness_ContactPhone"]"
                           Value="@_contactPhone"
                           ValueChanged="OnContactPhoneChanged"
                           Disabled="_busy" />
                <TextInput Label="@L["StartBusiness_AddressLine1"]"
                           Value="@_addressLine1"
                           ValueChanged="OnAddressLine1Changed"
                           Disabled="_busy" />
                <TextInput Label="@L["StartBusiness_City"]"
                           Value="@_city"
                           ValueChanged="OnCityChanged"
                           Disabled="_busy" />
                <TextInput Label="@L["StartBusiness_Region"]"
                           Value="@_region"
                           ValueChanged="OnRegionChanged"
                           Disabled="_busy" />
                <TextInput Label="@L["StartBusiness_PostalCode"]"
                           Value="@_postalCode"
                           ValueChanged="OnPostalCodeChanged"
                           Disabled="_busy" />
                <TextInput Label="@L["StartBusiness_Country"]"
                           Value="@_countryCode"
                           ValueChanged="OnCountryCodeChanged"
                           Disabled="_busy" />
            </Stack>
        </section>

        <section class="pos-start-business-plan" aria-labelledby="start-business-plan-heading">
            <div class="pos-start-business-plan__top">
                <div>
                    <p class="pos-start-business-plan__eyebrow" id="start-business-plan-heading">@L["StartBusiness_SelectedPlan"]</p>
                    <h2 class="pos-start-business-plan__name">@PlanDisplayName</h2>
                    <p class="pos-start-business-plan__mode">
                        @(_startAsTrial ? L["StartBusiness_ModeTrial"] : L["StartBusiness_ModeSubscribe"])
                        · @BillingCycleLabel
                    </p>
                </div>
                <button type="button" class="pos-start-business-plan__change" disabled="@_busy" @onclick="GoExplore">
                    @L["StartBusiness_ChangePlan"]
                </button>
            </div>

            @if (_planLoading)
            {
                <p class="pos-start-business-plan__loading">@L["StartBusiness_LoadingPlan"]</p>
            }
            else if (_plan is not null)
            {
                <div class="pos-start-business-plan__price-block">
                    @if (_startAsTrial)
                    {
                        <p class="pos-start-business-plan__trial">
                            @string.Format(L["StartBusiness_TrialDays"].Value, _plan.DefaultTrialDays)
                        </p>
                        <p class="pos-start-business-plan__price-caption">@L["StartBusiness_Then"]</p>
                    }
                    <p class="pos-start-business-plan__price">
                        <span class="pos-start-business-plan__amount">@SelectedPrice.ToString("N0")</span>
                        <span class="pos-start-business-plan__currency">@_plan.CurrencyCode</span>
                        <span class="pos-start-business-plan__period">/ @BillingPeriodLabel</span>
                    </p>
                    <ul class="pos-start-business-plan__limits pos-muted">
                        <li>@string.Format(L["Personal_ExplorePosFeatureBranches"].Value, _plan.MaxBranches)</li>
                        <li>@string.Format(L["Personal_ExplorePosFeatureStaff"].Value, _plan.MaxActiveStaff)</li>
                        <li>@string.Format(L["Personal_ExplorePosFeatureDevices"].Value, _plan.MaxActivePosDevices)</li>
                        <li>@string.Format(L["Personal_ExplorePosFeatureBusinessTypes"].Value, _plan.MaxActiveBusinessTypes)</li>
                    </ul>
                </div>
            }

            <div class="pos-start-business-plan__billing">
                <Select Label="@L["StartBusiness_BillingCycle"]"
                        Value="@_billingCycle"
                        ValueChanged="OnBillingChanged"
                        Options="_billingOptions"
                        Disabled="_busy" />
            </div>
        </section>

        <InlineMessage Tone="InlineMessageTone.Info">@L["StartBusiness_ConfirmHint"]</InlineMessage>
        <div class="pos-start-business-actions">
            <Button IsLoading="_busy" Disabled="_busy" OnClick="SubmitAsync">@L["StartBusiness_ConfirmSubmit"]</Button>
        </div>
    }
</Page>
</div>

@code {
    private bool _ready;
    private bool _authenticated;
    private bool _busy;
    private bool _planLoading;
    private bool _slugTouched;
    private string? _displayName;
    private string? _slug;
    private string? _primaryBusinessTypeId;
    private string _planKey = string.Empty;
    private string _billingCycle = "Monthly";
    private bool _startAsTrial = true;
    private bool _payNow;
    private bool _useMyContactDetails = true;
    private string? _personalEmail;
    private string? _personalPhone;
    private string? _contactEmail;
    private string? _contactPhone;
    private string? _addressLine1;
    private string? _city;
    private string? _region;
    private string? _postalCode;
    private string? _countryCode;
    private CommercialPlanDto? _plan;
    private IReadOnlyList<BusinessTypeDto> _businessTypes = [];
    private List<string> _errors = [];
    private bool _businessTypesLoading;

    private IReadOnlyList<SelectOption> _billingOptions =>
    [
        new("Monthly", L["Personal_Billing_Month"]),
        new("Annual", L["Personal_Billing_Year"]),
    ];

    private string PlanDisplayName =>
        !string.IsNullOrWhiteSpace(_plan?.DisplayName) ? _plan!.DisplayName
        : !string.IsNullOrWhiteSpace(_planKey) ? _planKey
        : L["StartBusiness_SelectedPlan"];

    private string BillingCycleLabel =>
        string.Equals(_billingCycle, "Annual", StringComparison.Ordinal)
            ? L["Personal_Billing_Year"]
            : L["Personal_Billing_Month"];

    private string BillingPeriodLabel => BillingCycleLabel;

    private decimal SelectedPrice =>
        _plan is null
            ? 0m
            : string.Equals(_billingCycle, "Annual", StringComparison.Ordinal)
                ? _plan.AnnualPrice
                : _plan.MonthlyPrice;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            _authenticated = restore.Succeeded;
        }
        else
        {
            _authenticated = true;
        }

        if (_authenticated
            && !await OnlineRequired.EnsureOnlineForActionAsync(PosOfflineActionKeys.PersonalStartBusiness))
        {
            _authenticated = false;
        }

        ParseQuery();
        if (_authenticated && !string.IsNullOrWhiteSpace(_planKey))
        {
            await LoadSelectedPlanAsync();
            await LoadBusinessTypesAsync();
            await LoadPersonalContactPrefillAsync();
        }

        _ready = true;
    }

    private void ParseQuery()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eq = part.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(part[..eq]);
            var value = Uri.UnescapeDataString(part[(eq + 1)..]);
            if (string.Equals(key, "planKey", StringComparison.OrdinalIgnoreCase))
            {
                _planKey = value;
            }
            else if (string.Equals(key, "trial", StringComparison.OrdinalIgnoreCase))
            {
                _startAsTrial = value is "1" or "true" or "True";
            }
            else if (string.Equals(key, "payNow", StringComparison.OrdinalIgnoreCase))
            {
                _payNow = value is "1" or "true" or "True";
            }
            else if (string.Equals(key, "billing", StringComparison.OrdinalIgnoreCase)
                     && (value is "Monthly" or "Annual"))
            {
                _billingCycle = value;
            }
        }
    }

    private async Task LoadSelectedPlanAsync()
    {
        _planLoading = true;
        try
        {
            var result = await Platform.GetCommercialPlansAsync(PosProductCodes.PinoyBusinessPos);
            if (!result.IsSuccess || result.Data is null)
            {
                return;
            }

            _plan = result.Data.FirstOrDefault(p =>
                string.Equals(p.PlanKey, _planKey, StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Code, _planKey, StringComparison.OrdinalIgnoreCase));
        }
        finally
        {
            _planLoading = false;
        }
    }

    private async Task LoadBusinessTypesAsync()
    {
        _businessTypesLoading = true;
        try
        {
            // Personal onboarding list — not org-entitlement filtered (no org yet).
            var result = await Platform.GetOnboardingBusinessTypesAsync();
            if (result.IsSuccess && result.Data is not null)
            {
                // Do not auto-select General Retail / Other; merchant must choose.
                _businessTypes = result.Data
                    .Where(t => string.Equals(t.Status, "Active", StringComparison.OrdinalIgnoreCase))
                    .OrderBy(t => t.SortOrder)
                    .ThenBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
                    .ToArray();
            }
        }
        finally
        {
            _businessTypesLoading = false;
        }
    }

    private Task OnDisplayNameChanged(string? value)
    {
        _displayName = value;
        if (!_slugTouched)
        {
            _slug = OrganizationSlug.SuggestFromDisplayName(value);
        }

        return Task.CompletedTask;
    }

    private Task OnSlugChanged(string? value)
    {
        _slug = value;
        _slugTouched = true;
        return Task.CompletedTask;
    }

    private Task OnBillingChanged(string? value)
    {
        if (value is "Monthly" or "Annual")
        {
            _billingCycle = value;
        }

        return Task.CompletedTask;
    }

    private void SelectBusinessType(Guid id) => _primaryBusinessTypeId = id.ToString("D");

    private async Task LoadPersonalContactPrefillAsync()
    {
        var result = await Platform.GetPersonalProfileAsync();
        if (!result.IsSuccess || result.Data is null)
        {
            return;
        }

        _personalEmail = result.Data.Email;
        _personalPhone = result.Data.Phone;
        if (_useMyContactDetails)
        {
            ApplyPersonalContactPrefill();
        }
    }

    private void ApplyPersonalContactPrefill()
    {
        _contactEmail = _personalEmail;
        _contactPhone = _personalPhone;
    }

    private Task OnUseMyContactDetailsChanged(bool value)
    {
        _useMyContactDetails = value;
        if (value)
        {
            ApplyPersonalContactPrefill();
        }

        return Task.CompletedTask;
    }

    private Task OnContactEmailChanged(string? value)
    {
        _contactEmail = value;
        return Task.CompletedTask;
    }

    private Task OnContactPhoneChanged(string? value)
    {
        _contactPhone = value;
        return Task.CompletedTask;
    }

    private Task OnAddressLine1Changed(string? value)
    {
        _addressLine1 = value;
        return Task.CompletedTask;
    }

    private Task OnCityChanged(string? value)
    {
        _city = value;
        return Task.CompletedTask;
    }

    private Task OnRegionChanged(string? value)
    {
        _region = value;
        return Task.CompletedTask;
    }

    private Task OnPostalCodeChanged(string? value)
    {
        _postalCode = value;
        return Task.CompletedTask;
    }

    private Task OnCountryCodeChanged(string? value)
    {
        _countryCode = value;
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        _errors = [];
        if (!_slugTouched && string.IsNullOrWhiteSpace(_slug) && !string.IsNullOrWhiteSpace(_displayName))
        {
            _slug = OrganizationSlug.SuggestFromDisplayName(_displayName);
        }

        if (string.IsNullOrWhiteSpace(_displayName) || string.IsNullOrWhiteSpace(_slug))
        {
            _errors.Add(L["StartBusiness_ValidationRequired"]);
            return;
        }

        if (!OrganizationSlug.IsValidFormat(_slug))
        {
            _errors.Add(L["StartBusiness_SlugInvalid"]);
            return;
        }

        if (string.IsNullOrWhiteSpace(_planKey))
        {
            _errors.Add(L["StartBusiness_PlanRequired"]);
            return;
        }

        if (!Guid.TryParse(_primaryBusinessTypeId, out var primaryBusinessTypeId)
            || primaryBusinessTypeId == Guid.Empty)
        {
            _errors.Add(L["StartBusiness_PrimaryTypeRequired"]);
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentUser.Session?.PlatformSessionToken))
        {
            _errors.Add(L["StartBusiness_SessionRequired"]);
            return;
        }

        _busy = true;
        try
        {
            await Auth.EnsurePersonalAccountProfileAsync();
            var created = await Platform.StartBusinessAsync(new StartBusinessRequest(
                DisplayName: _displayName.Trim(),
                Slug: _slug.Trim().ToLowerInvariant(),
                PrimaryBusinessTypeId: primaryBusinessTypeId,
                ProductCode: PosProductCodes.PinoyBusinessPos,
                PlanKey: _planKey.Trim(),
                BillingCycle: _billingCycle,
                StartAsTrial: _startAsTrial,
                PayNow: _payNow,
                ActivatePosEntitlement: true,
                ActivateProductAccess: true,
                AssignPosOwnerRole: true,
                UseMyContactDetails: _useMyContactDetails,
                ContactEmail: NullIfWhiteSpace(_contactEmail),
                ContactPhone: NullIfWhiteSpace(_contactPhone),
                AddressLine1: NullIfWhiteSpace(_addressLine1),
                City: NullIfWhiteSpace(_city),
                Region: NullIfWhiteSpace(_region),
                PostalCode: NullIfWhiteSpace(_postalCode),
                CountryCode: NullIfWhiteSpace(_countryCode)));

            if (!created.IsSuccess || created.Data is null)
            {
                _errors.Add(created.Error?.Detail ?? L["StartBusiness_Failed"]);
                return;
            }

            var continued = await Auth.ContinueAfterStartBusinessAsync(created.Data);
            if (!continued.Succeeded)
            {
                _errors.Add(L[continued.SafeMessageKey ?? "StartBusiness_Failed"]);
                return;
            }

            await Prefs.SetOnboardingCompletedAsync(true);
            await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.Complete));
            // Growth/Pro: optional additional BT activation before device registration.
            var offerAdditionalTypes = (_plan?.MaxActiveBusinessTypes ?? 1) > 1;
            await Prefs.SetBusinessTypeActivationPromptPendingAsync(
                created.Data.OrganizationId,
                pending: offerAdditionalTypes);
            // One-time skippable template suggest after PIN + sell-critical setup (NavigationGate).
            await Prefs.SetBusinessTemplatePromptPendingAsync(created.Data.OrganizationId, pending: true);
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoExplore() => Nav.NavigateTo("/personal/explore-pos");
    private void GoSignIn() => Nav.NavigateTo("/signin");

    private static string? NullIfWhiteSpace(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}

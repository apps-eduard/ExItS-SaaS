@page "/personal"
@layout Layout.AuthShell
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["Personal_HomeTitle"]" Subtitle="@L["Personal_HomeSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Ghost" OnClick="GoSettings">@L["Settings_Title"]</Button>
            <Button Variant="ButtonVariant.Ghost" OnClick="LogoutAsync">@L["Auth_Logout"]</Button>
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <Spinner />
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_loadFailed)
    {
        <ErrorState Title="@L["Personal_LoadErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    }
    else
    {
        <Section Title="@L["Personal_DashboardSection"]">
            @if (_dashboard is null)
            {
                <InlineMessage Tone="InlineMessageTone.Warning">@L["Personal_DashboardUnavailable"]</InlineMessage>
            }
            else
            {
                <div class="pos-status-grid">
                    <div>
                        <span class="pos-muted">@L["Personal_Stat_People"]</span>
                        <div class="pos-value-md">@_dashboard.ContactCount</div>
                    </div>
                    <div>
                        <span class="pos-muted">@L["Personal_Stat_ActiveRelationships"]</span>
                        <div class="pos-value-md">@_dashboard.ActiveRelationshipCount</div>
                    </div>
                    <div>
                        <span class="pos-muted">@L["Personal_Stat_Lent"]</span>
                        <div class="pos-value-md">@_dashboard.TotalLentBalance.ToString("N2")</div>
                    </div>
                    <div>
                        <span class="pos-muted">@L["Personal_Stat_Borrowed"]</span>
                        <div class="pos-value-md">@_dashboard.TotalBorrowedBalance.ToString("N2")</div>
                    </div>
                </div>
            }
        </Section>

        <Section Title="@L["Personal_UtangNavSection"]">
            <Stack Gap="2">
                <Button Variant="ButtonVariant.Secondary" OnClick="GoPeople">@L["Personal_Nav_People"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoLent">@L["Personal_Nav_Lent"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoBorrowed">@L["Personal_Nav_Borrowed"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoUtangInvitations">@L["Personal_Nav_UtangInvitations"]</Button>
                <Button Variant="ButtonVariant.Ghost" Disabled="true">@L["Personal_Nav_PaymentsSoon"]</Button>
                <Button Variant="ButtonVariant.Ghost" Disabled="true">@L["Personal_Nav_RemindersSoon"]</Button>
                <Button Variant="ButtonVariant.Ghost" Disabled="true">@L["Personal_Nav_HistorySoon"]</Button>
            </Stack>
        </Section>

        <Section Title="@L["Personal_ProfileSection"]">
            <Stack Gap="1">
                <span class="pos-value-md">@_displayName</span>
                <span class="pos-muted">@_email</span>
                <span class="pos-muted">@_accountClass</span>
            </Stack>
            <FormActions>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoProfile">@L["Personal_ProfileLink"]</Button>
                <Button Variant="ButtonVariant.Ghost" OnClick="GoSettings">@L["Personal_SettingsLink"]</Button>
            </FormActions>
        </Section>

        <Section Title="@L["Personal_ExplorePosSection"]">
            <InlineMessage Tone="InlineMessageTone.Info">@L["Personal_ExplorePosHint"]</InlineMessage>
            <FormActions>
                <Button Variant="ButtonVariant.Primary" OnClick="GoExplorePos">@L["Personal_ExplorePos"]</Button>
            </FormActions>
        </Section>

        @if (!string.IsNullOrEmpty(_error))
        {
            <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
        }
    }
</Page>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private bool _loadFailed;
    private string? _displayName;
    private string? _email;
    private string? _accountClass;
    private string? _error;
    private PersonalDashboardDto? _dashboard;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _loadFailed = false;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (!restore.Succeeded)
                {
                    _authenticated = false;
                    return;
                }
            }

            _authenticated = CurrentUser.IsAuthenticated;
            if (!_authenticated || CurrentUser.Session is null)
            {
                return;
            }

            var personal = await Auth.EnsurePersonalAccountProfileAsync();
            if (!personal.Succeeded)
            {
                _loadFailed = true;
                _error = L[personal.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            var session = CurrentUser.Session!;
            _displayName = session.DisplayName;
            _email = session.Email;
            _accountClass = session.AccountClass ?? L["Personal_AccountClassDefault"];

            var dash = await Platform.GetPersonalDashboardAsync();
            _dashboard = dash.IsSuccess ? dash.Data : null;
        }
        catch
        {
            _loadFailed = true;
            _error = L["Personal_LoadErrorMessage"];
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoExplorePos() => Nav.NavigateTo("/personal/explore-pos");
    private void GoProfile() => Nav.NavigateTo("/personal/profile");
    private void GoSettings() => Nav.NavigateTo("/personal/settings");
    private void GoPeople() => Nav.NavigateTo("/personal/utang/people");
    private void GoLent() => Nav.NavigateTo("/personal/utang/lent");
    private void GoBorrowed() => Nav.NavigateTo("/personal/utang/borrowed");
    private void GoUtangInvitations() => Nav.NavigateTo("/personal/utang/invitations");
    private void GoSignIn() => Nav.NavigateTo("/signin");

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/signin", replace: true);
    }
}

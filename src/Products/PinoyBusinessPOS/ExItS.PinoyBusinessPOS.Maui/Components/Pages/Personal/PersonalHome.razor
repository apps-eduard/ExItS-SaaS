@page "/personal"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject ILocalPersonalUtangStore LocalStore
@inject IPersonalOfflineSyncService PersonalSync
@inject IConnectivityService Connectivity
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-home">
    <Page>
        <header class="pos-personal-home__header">
            <h1 class="pos-personal-home__title">@L["Personal_HomeTitle"]</h1>
            <p class="pos-personal-home__subtitle">@L["Personal_HomeSubtitle"]</p>
        </header>

        @if (_loading)
        {
            <Spinner />
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
        }
        else if (_loadFailed)
        {
            <ErrorState Title="@L["Personal_LoadErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
        }
        else
        {
            @if (_pendingSync > 0)
            {
                <Alert Tone="AlertTone.Info"
                       Title="@L["Offline_SavedPendingSync"]"
                       Message="@string.Format(L["SyncStatus_PendingItems"].Value, _pendingSync)" />
            }

            <Section Title="@L["Personal_DashboardSection"]">
                @if (_aggregates is null && _dashboard is null)
                {
                    <InlineMessage Tone="InlineMessageTone.Warning">@L["Personal_DashboardUnavailable"]</InlineMessage>
                }
                else
                {
                    <div class="pos-personal-stats" role="list">
                        <button type="button" class="pos-personal-stat pos-personal-stat--link" role="listitem" @onclick="GoPeople">
                            <span class="pos-personal-stat__label">@L["Personal_Stat_People"]</span>
                            <span class="pos-personal-stat__value">@(_aggregates?.ContactCount ?? _dashboard!.ContactCount)</span>
                        </button>
                        <div class="pos-personal-stat" role="listitem">
                            <span class="pos-personal-stat__label">@L["Personal_Stat_ActiveRelationships"]</span>
                            <span class="pos-personal-stat__value">@(_aggregates?.ActiveRelationshipCount ?? _dashboard!.ActiveRelationshipCount)</span>
                        </div>
                        <button type="button" class="pos-personal-stat pos-personal-stat--link" role="listitem" @onclick="GoLent">
                            <span class="pos-personal-stat__label">@L["Personal_Stat_Lent"]</span>
                            <span class="pos-personal-stat__value">@((_aggregates?.TotalLentBalance ?? _dashboard!.TotalLentBalance).ToString("N2"))</span>
                        </button>
                        <button type="button" class="pos-personal-stat pos-personal-stat--link" role="listitem" @onclick="GoBorrowed">
                            <span class="pos-personal-stat__label">@L["Personal_Stat_Borrowed"]</span>
                            <span class="pos-personal-stat__value">@((_aggregates?.TotalBorrowedBalance ?? _dashboard!.TotalBorrowedBalance).ToString("N2"))</span>
                        </button>
                    </div>
                }
            </Section>

            <Section Title="@L["Personal_RecentActivitySection"]">
                @if (_recent.Count == 0)
                {
                    <EmptyState Title="@L["Personal_RecentActivityEmptyTitle"]" Message="@L["Personal_RecentActivityEmptyMessage"]" />
                }
                else
                {
                    <div class="pos-personal-list" role="list">
                        @foreach (var item in _recent)
                        {
                            <button type="button"
                                    class="pos-personal-row"
                                    role="listitem"
                                    @onclick="() => GoRelationship(item.Id)">
                                <span class="pos-personal-row__body">
                                    <span class="pos-personal-row__title">@ContactName(item.ContactId)</span>
                                    <span class="pos-personal-row__meta">
                                        @PerspectiveLabel(item.Direction)
                                        · @item.Outstanding.ToString("N2") @item.Currency
                                        · @item.UpdatedAtUtc.LocalDateTime.ToString("g")
                                    </span>
                                </span>
                                <span class="pos-personal-row__amount">@item.Outstanding.ToString("N2")</span>
                                <span class="pos-personal-row__chevron" aria-hidden="true">›</span>
                            </button>
                        }
                    </div>
                }
            </Section>

            @if (!string.IsNullOrEmpty(_error))
            {
                <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
            }
        }
    </Page>
</div>

@code {
    private bool _loading = true;
    private bool _authenticated;
    private bool _loadFailed;
    private string? _error;
    private PersonalDashboardDto? _dashboard;
    private LocalPersonalAggregates? _aggregates;
    private IReadOnlyList<LocalPersonalRelationship> _recent = [];
    private Dictionary<Guid, string> _contactNames = new();
    private int _pendingSync;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private bool _remoteStarted;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _loadFailed = false;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (!restore.Succeeded)
                {
                    _authenticated = false;
                    return;
                }
            }

            _authenticated = CurrentUser.IsAuthenticated;
            if (!_authenticated || CurrentUser.Session is null)
            {
                return;
            }

            var personal = await Auth.EnsurePersonalAccountProfileAsync();
            if (!personal.Succeeded)
            {
                _loadFailed = true;
                _error = L[personal.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            // Defense: deep-link/sign-in shortcuts to /personal must still enroll offline PIN.
            if (!await Auth.HasOfflinePinConfiguredAsync())
            {
                var offer = await Auth.EvaluateOfflineColdStartOfferAsync();
                if (offer.Grant is not null
                    || string.Equals(offer.DenialReasonCode, "offline_pin_not_configured", StringComparison.Ordinal))
                {
                    Nav.NavigateTo("/offline-pin-setup", replace: true);
                    return;
                }
            }

            await LocalStore.EnsurePersonalContextAsync();
            var contacts = await LocalStore.ListContactsAsync();
            _contactNames = contacts.ToDictionary(c => c.Id, c => c.DisplayName);
            _aggregates = await LocalStore.GetAggregatesAsync();
            var lent = await LocalStore.ListRelationshipsAsync(LocalPersonalDirection.Lent);
            var borrowed = await LocalStore.ListRelationshipsAsync(LocalPersonalDirection.Borrowed);
            _recent = lent.Concat(borrowed)
                .OrderByDescending(x => x.UpdatedAtUtc)
                .Take(8)
                .ToArray();
            _pendingSync = await PersonalSync.GetPendingCountAsync();
        }
        catch
        {
            _loadFailed = true;
            _error = L["Personal_LoadErrorMessage"];
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _remoteStarted || !_authenticated || _loadFailed)
        {
            return;
        }

        _remoteStarted = true;
        if (!await Connectivity.IsConnectedAsync())
        {
            return;
        }

        try
        {
            var dash = await Platform.GetPersonalDashboardAsync();
            _dashboard = dash.IsSuccess ? dash.Data : null;
            _aggregates = await LocalStore.GetAggregatesAsync();
            _pendingSync = await PersonalSync.GetPendingCountAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Local data already shown; reconnect auto-sync covers outbox.
        }
    }

    private string ContactName(Guid contactId) =>
        _contactNames.TryGetValue(contactId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : L["Personal_UnknownContact"];

    private string PerspectiveLabel(string perspective) =>
        string.Equals(perspective, LocalPersonalDirection.Lent, StringComparison.OrdinalIgnoreCase)
            || string.Equals(perspective, "Lent", StringComparison.OrdinalIgnoreCase)
            ? L["Personal_Stat_Lent"]
            : string.Equals(perspective, LocalPersonalDirection.Borrowed, StringComparison.OrdinalIgnoreCase)
                || string.Equals(perspective, "Borrowed", StringComparison.OrdinalIgnoreCase)
                ? L["Personal_Stat_Borrowed"]
                : perspective;

    private void GoRelationship(Guid id) => Nav.NavigateTo($"/personal/utang/relationships/{id:D}");
    private void GoPeople() => Nav.NavigateTo("/personal/utang/people");
    private void GoLent() => Nav.NavigateTo("/personal/utang/lent");
    private void GoBorrowed() => Nav.NavigateTo("/personal/utang/borrowed");
    private void GoSignIn() => Nav.NavigateTo("/signin");
}

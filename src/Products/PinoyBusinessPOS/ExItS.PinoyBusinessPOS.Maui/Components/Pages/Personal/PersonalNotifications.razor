@page "/personal/notifications"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Common
@using ExItS.PinoyBusinessPOS.Maui.Services
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IConnectivityService Connectivity
@inject NavigationManager Nav
@inject ShellNotificationUnreadState UnreadState
@inject ApiStatusLocalizer StatusLocalizer
@inject PostSignInReturnRoute ReturnRoute
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-invitations">
<StoreHeaderBack Href="/personal/more" />
<Page>
    <header class="pos-personal-invitations__header">
        <h1 class="pos-personal-invitations__title">@L["Personal_NotificationsTitle"]</h1>
        <p class="pos-personal-invitations__subtitle">@L["Personal_NotificationsSubtitle"]</p>
    </header>

    @if (_loading)
    {
        <Spinner />
    }
    else if (_state == PlatformScreenState.Offline)
    {
        <ErrorState Title="@L["Platform_OfflineTitle"]"
                    Message="@L["Personal_NotificationsOfflineMessage"]"
                    RetryLabel="@L["Common_Retry"]"
                    OnRetry="LoadAsync" />
    }
    else if (_state == PlatformScreenState.SessionExpired)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]"
                    Message="@L["Auth_SessionExpired"]"
                    RetryLabel="@L["Auth_SignInAgain"]"
                    OnRetry="GoSignIn" />
    }
    else if (_state == PlatformScreenState.ServiceUnavailable)
    {
        <ErrorState Title="@L["Platform_ServiceUnavailableTitle"]"
                    Message="@L["Platform_ServiceUnavailableMessage"]"
                    RetryLabel="@L["Common_Retry"]"
                    OnRetry="LoadAsync" />
    }
    else if (_state == PlatformScreenState.Failed)
    {
        <ErrorState Title="@L["Personal_NotificationsErrorTitle"]"
                    Message="@(_error ?? L["Personal_NotificationsLoadFailed"])"
                    RetryLabel="@L["Common_Retry"]"
                    OnRetry="LoadAsync" />
    }
    else if (_notifications.Count == 0)
    {
        <EmptyState Title="@L["Personal_NotificationsEmptyTitle"]" Message="@L["Personal_NotificationsEmptyMessage"]" />
    }
    else
    {
        <div class="pos-personal-list" role="list">
            @foreach (var item in _notifications)
            {
                <button type="button"
                        class="pos-personal-row"
                        role="listitem"
                        disabled="@_busy"
                        @onclick="() => OpenAsync(item)">
                    <span class="pos-personal-row__body">
                        <span class="pos-personal-row__title">
                            @item.Title
                            @if (!item.IsRead)
                            {
                                <span class="pos-muted"> · @L["Personal_NotificationsUnread"]</span>
                            }
                        </span>
                        <span class="pos-personal-row__meta">
                            @item.Preview
                            · @item.CreatedAtUtc.LocalDateTime.ToString("g")
                        </span>
                    </span>
                    <span class="pos-personal-row__chevron" aria-hidden="true">›</span>
                </button>
            }
        </div>
    }
</Page>
</div>

@code {
    private enum PlatformScreenState
    {
        Loaded,
        Offline,
        SessionExpired,
        ServiceUnavailable,
        Failed
    }

    private bool _loading = true;
    private bool _busy;
    private PlatformScreenState _state = PlatformScreenState.Loaded;
    private string? _error;
    private IReadOnlyList<PersonalInAppNotificationDto> _notifications = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _state = PlatformScreenState.Loaded;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                if (!restore.Succeeded)
                {
                    if (restore.FailureReason is AuthFailureReason.Offline)
                    {
                        _state = PlatformScreenState.Offline;
                        return;
                    }

                    _state = PlatformScreenState.SessionExpired;
                    return;
                }
            }

            if (!await Connectivity.IsConnectedAsync())
            {
                _state = PlatformScreenState.Offline;
                return;
            }

            var personal = await Auth.EnsurePersonalAccountProfileAsync();
            if (!personal.Succeeded)
            {
                if (personal.FailureReason is AuthFailureReason.Offline)
                {
                    _state = PlatformScreenState.Offline;
                    return;
                }

                if (personal.FailureReason is AuthFailureReason.SessionExpired
                    or AuthFailureReason.RefreshFailed)
                {
                    _state = PlatformScreenState.SessionExpired;
                    return;
                }

                _state = PlatformScreenState.Failed;
                _error = L[personal.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            var result = await Platform.GetPersonalNotificationsAsync();
            if (result.IsSuccess && result.Data is not null)
            {
                _notifications = result.Data;
                _state = PlatformScreenState.Loaded;
                return;
            }

            _state = result.Status switch
            {
                ApiCallStatus.Offline => PlatformScreenState.Offline,
                ApiCallStatus.Unauthorized => PlatformScreenState.SessionExpired,
                ApiCallStatus.Unavailable or ApiCallStatus.Timeout => PlatformScreenState.ServiceUnavailable,
                _ => PlatformScreenState.Failed
            };

            if (_state == PlatformScreenState.Failed)
            {
                var described = StatusLocalizer.Describe(result.Status, result.Error);
                _error = described.Message;
                if (LooksLikeRawAuthenticationRequired(_error))
                {
                    _state = PlatformScreenState.SessionExpired;
                    _error = null;
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool LooksLikeRawAuthenticationRequired(string? message) =>
        !string.IsNullOrWhiteSpace(message)
        && message.Contains("Authentication is required", StringComparison.OrdinalIgnoreCase);

    private async Task OpenAsync(PersonalInAppNotificationDto item)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            if (!item.IsRead)
            {
                await Platform.MarkPersonalNotificationReadAsync(item.Id);
                UnreadState.NotifyChanged();
            }

            if (string.Equals(item.RelatedType, "CustomerLinkRequest", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/personal/customer-link-requests");
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoSignIn()
    {
        ReturnRoute.Capture("/personal/notifications");
        Nav.NavigateTo("/signin");
    }
}

@page "/personal/profile"
@layout Layout.PersonalShell
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["Personal_ProfileTitle"]" Subtitle="@L["Personal_ProfileSubtitle"]">
        <Actions>
            <Button Variant="ButtonVariant.Secondary" OnClick="GoMore">@L["Personal_BackMore"]</Button>
        </Actions>
    </PageHeader>

    @if (!_ready)
    {
        <Spinner />
    }
    else if (!_authenticated)
    {
        <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
    }
    else if (_loadFailed)
    {
        <ErrorState Title="@L["Personal_ProfileErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
    }
    else
    {
        <Section Title="@L["Personal_ProfileSection"]">
            <Stack Gap="2">
                <div><span class="pos-muted">@L["Register_DisplayName"]</span><div class="pos-value-md">@(_profile?.DisplayName ?? CurrentUser.Session?.DisplayName)</div></div>
                <div><span class="pos-muted">@L["SignIn_UsernameLabel"]</span><div class="pos-value-md">@(_profile?.Username ?? CurrentUser.Session?.Username)</div></div>
                <div><span class="pos-muted">@L["Register_Email"]</span><div class="pos-value-md">@(_profile?.Email ?? CurrentUser.Session?.Email)</div></div>
                @if (!string.IsNullOrWhiteSpace(_profile?.PublicUserId))
                {
                    <div><span class="pos-muted">@L["Personal_ExItsIdLabel"]</span><div class="pos-value-md">@_profile.PublicUserId</div></div>
                }
                <div><span class="pos-muted">@L["Personal_AccountClass"]</span><div class="pos-value-md">@(_profile?.AccountClass ?? CurrentUser.Session?.AccountClass ?? "—")</div></div>
                <div><span class="pos-muted">@L["Personal_StatusLabel"]</span><div class="pos-value-md">@(_profile?.Status ?? "—")</div></div>
            </Stack>
            <FormActions>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoMyQr">@L["Personal_MyQrLink"]</Button>
            </FormActions>
        </Section>
    }
</Page>

@code {
    private bool _ready;
    private bool _authenticated;
    private bool _loadFailed;
    private string? _error;
    private PersonalProfileDto? _profile;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _ready = false;
        _loadFailed = false;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            await Auth.EnsurePersonalAccountProfileAsync();
            var result = await Platform.GetPersonalProfileAsync();
            if (result.IsSuccess)
            {
                _profile = result.Data;
            }
            else
            {
                // Session fallback is still useful; do not hard-fail the page.
                _error = result.Error?.Detail;
            }
        }
        finally
        {
            _ready = true;
        }
    }

    private void GoMore() => Nav.NavigateTo("/personal/more");
    private void GoMyQr() => Nav.NavigateTo("/personal/my-qr");
    private void GoSignIn() => Nav.NavigateTo("/signin");
}

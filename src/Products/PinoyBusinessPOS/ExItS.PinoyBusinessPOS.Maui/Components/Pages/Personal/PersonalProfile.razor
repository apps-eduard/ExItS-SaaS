@page "/personal/profile"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-settings pos-personal-profile">
    <StoreHeaderBack Href="/personal/more" />
    <Page>
        <header class="pos-personal-profile__header">
            <h1 class="pos-personal-profile__title">@L["Personal_ProfileTitle"]</h1>
            <p class="pos-personal-profile__subtitle">@L["Personal_ProfileSubtitle"]</p>
        </header>

        @if (!_ready)
        {
            <Spinner />
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
        }
        else if (_loadFailed)
        {
            <ErrorState Title="@L["Personal_ProfileErrorTitle"]" Message="@(_error ?? L["Personal_LoadErrorMessage"])" RetryLabel="@L["Common_Retry"]" OnRetry="LoadAsync" />
        }
        else
        {
            <Section Title="@L["Personal_ProfileSection"]">
                <div class="pos-settings__panel">
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Register_DisplayName"]</span>
                        <span class="pos-settings__kv-value">@(_profile?.DisplayName ?? CurrentUser.Session?.DisplayName)</span>
                    </div>
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["SignIn_UsernameLabel"]</span>
                        <span class="pos-settings__kv-value">@(_profile?.Username ?? CurrentUser.Session?.Username)</span>
                    </div>
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Register_Email"]</span>
                        <span class="pos-settings__kv-value">@(_profile?.Email ?? CurrentUser.Session?.Email)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_profile?.PublicUserId))
                    {
                        <div class="pos-settings__kv">
                            <span class="pos-settings__kv-label">@L["Personal_ExItsIdLabel"]</span>
                            <span class="pos-settings__kv-value">@_profile.PublicUserId</span>
                        </div>
                    }
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Personal_AccountClass"]</span>
                        <span class="pos-settings__kv-value">@(_profile?.AccountClass ?? CurrentUser.Session?.AccountClass ?? "—")</span>
                    </div>
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Personal_StatusLabel"]</span>
                        <span class="pos-settings__kv-value">@(_profile?.Status ?? "—")</span>
                    </div>
                    <button type="button" class="pos-settings__nav" @onclick="GoMyQr">
                        <span class="pos-settings__nav-icon" aria-hidden="true">@IconGlyphs.Get("qr")</span>
                        <span class="pos-settings__nav-label">@L["Personal_MyQrLink"]</span>
                        <span class="pos-settings__chevron" aria-hidden="true">›</span>
                    </button>
                </div>
            </Section>
            @if (!string.IsNullOrEmpty(_error))
            {
                <InlineMessage Tone="InlineMessageTone.Info">@_error</InlineMessage>
            }
        }
    </Page>
</div>

@code {
    private bool _ready;
    private bool _authenticated;
    private bool _loadFailed;
    private string? _error;
    private PersonalProfileDto? _profile;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _ready = false;
        _loadFailed = false;
        _error = null;
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                var restore = await Auth.RestoreSessionAsync();
                _authenticated = restore.Succeeded;
            }
            else
            {
                _authenticated = true;
            }

            if (!_authenticated)
            {
                return;
            }

            await Auth.EnsurePersonalAccountProfileAsync();
            var result = await Platform.GetPersonalProfileAsync();
            if (result.IsSuccess)
            {
                _profile = result.Data;
            }
            else
            {
                _error = result.Error?.Detail;
            }
        }
        finally
        {
            _ready = true;
        }
    }

    private void GoMyQr() => Nav.NavigateTo("/personal/my-qr");
    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/personal/linked-merchants/{OrganizationId:guid}/shop/review"
@layout Layout.PersonalShell
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.CustomerOrdering
@using ExItS.PinoyBusinessPOS.Domain.CustomerOrdering
@implements IDisposable
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IPosCustomerOrderClient Orders
@inject PersonalMerchantCart Cart
@inject OnlineRequiredGuard OnlineRequired
@inject OfflineAwareNavigation OfflineNav
@inject NavigationManager Nav
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<div class="pos-personal-shop-review">
    <StoreHeaderBack Href="@($"/personal/linked-merchants/{OrganizationId:D}/shop")" />
    <Page>
        <header class="pos-personal-shop-review__header">
            <h1>@L["Personal_ShopReviewTitle"]</h1>
            <p class="pos-muted">@(_organizationName ?? L["Personal_ShopTitle"])</p>
        </header>

        @if (_loading)
        {
            <div class="pos-personal-shop__loading"><Spinner /><span>@L["Common_Loading"]</span></div>
        }
        else if (!_authenticated)
        {
            <ErrorState Title="@L["Auth_SessionExpiredTitle"]" Message="@L["Auth_SessionExpired"]" RetryLabel="@L["SignIn_Submit"]" OnRetry="GoSignIn" />
        }
        else if (Cart.LineCount == 0)
        {
            <EmptyState Title="@L["Personal_ShopCartEmptyTitle"]" Message="@L["Personal_ShopCartEmptyMessage"]" />
            <Button Variant="ButtonVariant.Secondary" OnClick="GoShopAsync">@L["Personal_ShopBackToShop"]</Button>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <Alert Tone="AlertTone.Danger" Title="@L["Personal_ShopPlaceErrorTitle"]" Message="@_error" />
            }

            <div class="pos-sell-payment">
                <section class="pos-sell-payment__summary" aria-label="@L["Personal_ShopCartSection"]">
                    @foreach (var line in Cart.Lines)
                    {
                        <div class="pos-sell-payment__line">
                            <span class="pos-sell-payment__line-name">@line.Name</span>
                            <span class="pos-sell-payment__line-qty pos-tabular">@FormatQty(line.Quantity) @line.UnitOfMeasure</span>
                            <span class="pos-sell-payment__line-total"><MoneyDisplay Amount="@line.LineTotal" CurrencyCode="PHP" /></span>
                        </div>
                    }
                    @if (_fulfillment == PersonalMerchantCheckoutUi.Delivery && _quote?.Available == true)
                    {
                        <div class="pos-sell-payment__line">
                            <span class="pos-sell-payment__line-name">@L["Personal_ShopDeliveryFee"]</span>
                            <span class="pos-sell-payment__line-qty"></span>
                            <span class="pos-sell-payment__line-total"><MoneyDisplay Amount="@_quote.DeliveryFee" CurrencyCode="PHP" /></span>
                        </div>
                    }
                    <div class="pos-sell-payment__total">
                        <span>@L["Sales_Field_Total"]</span>
                        <MoneyDisplay Amount="@PayableTotal" CurrencyCode="PHP" Emphasized="true" />
                    </div>
                </section>
            </div>

            <section class="pos-personal-shop-review__section" aria-label="@L["Personal_ShopFulfillment"]">
                <h2>@L["Personal_ShopFulfillment"]</h2>
                @if (_selection.ShowFulfillmentToggle)
                {
                    <div class="pos-personal-shop-review__fulfillment" role="group" aria-label="@L["Personal_ShopFulfillment"]">
                        <button type="button"
                                class="@FulfillmentModeClass(PersonalMerchantCheckoutUi.Pickup)"
                                @onclick="@(() => SelectFulfillment(PersonalMerchantCheckoutUi.Pickup))">@L["Orders_Pickup"]</button>
                        <button type="button"
                                class="@FulfillmentModeClass(PersonalMerchantCheckoutUi.Delivery)"
                                @onclick="@(() => SelectFulfillment(PersonalMerchantCheckoutUi.Delivery))">@L["Orders_Delivery"]</button>
                    </div>
                }
                else
                {
                    <div class="pos-personal-shop-review__readonly">
                        <strong>@FulfillmentLabel(_fulfillment)</strong>
                    </div>
                }

                @if (!_selection.CanPlace)
                {
                    <Alert Tone="AlertTone.Warning"
                           Title="@L["Personal_ShopFulfillmentUnavailableTitle"]"
                           Message="@L["Personal_ShopFulfillmentUnavailable"]" />
                }
                else if (_selection.ShowBranchSelector)
                {
                    <label class="pos-personal-shop-review__field">
                        <span>@L["Personal_ShopBranch"]</span>
                        <select value="@_branchIdText" @onchange="OnBranchChanged">
                            @foreach (var branch in EligibleBranches)
                            {
                                <option value="@branch.BranchId.ToString("D")">@branch.Name</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <div class="pos-personal-shop-review__readonly">
                        <span>@L["Personal_ShopBranch"]</span>
                        <strong>@(_selection.BranchName ?? EligibleBranches.FirstOrDefault()?.Name)</strong>
                    </div>
                }
            </section>

            @if (_fulfillment == PersonalMerchantCheckoutUi.Delivery && _selection.CanPlace)
            {
                <section class="pos-personal-shop-review__section">
                    <h2>@L["Personal_ShopDeliveryDetails"]</h2>
                    <label class="pos-personal-shop-review__field">
                        <span>@L["Personal_ShopRecipientName"]</span>
                        <input @bind="_recipientName" />
                    </label>
                    <label class="pos-personal-shop-review__field">
                        <span>@L["Personal_ShopRecipientPhone"]</span>
                        <input @bind="_recipientPhone" />
                    </label>
                    <label class="pos-personal-shop-review__field">
                        <span>@L["Personal_ShopAddress1"]</span>
                        <input @bind="_address1" />
                    </label>
                    <label class="pos-personal-shop-review__field">
                        <span>@L["Personal_ShopAddress2"]</span>
                        <input @bind="_address2" />
                    </label>
                    <label class="pos-personal-shop-review__field">
                        <span>@L["Personal_ShopCity"]</span>
                        <input @bind="_city" />
                    </label>
                    <label class="pos-personal-shop-review__field">
                        <span>@L["Personal_ShopDeliveryNotes"]</span>
                        <input @bind="_deliveryNotes" />
                    </label>
                    <div class="pos-personal-shop-review__coords">
                        <label class="pos-personal-shop-review__field">
                            <span>@L["Personal_ShopLatitude"]</span>
                            <input type="number" step="0.000001" @bind="_latitude" />
                        </label>
                        <label class="pos-personal-shop-review__field">
                            <span>@L["Personal_ShopLongitude"]</span>
                            <input type="number" step="0.000001" @bind="_longitude" />
                        </label>
                    </div>
                    @if (_quote is not null)
                    {
                        <p class="pos-muted">
                            @if (_quote.Available)
                            {
                                <span>@L["Personal_ShopDeliveryFee"]: </span>
                                <MoneyDisplay Amount="@_quote.DeliveryFee" CurrencyCode="PHP" />
                            }
                            else
                            {
                                @(_quote.UnavailableReason ?? L["Personal_ShopDeliveryUnavailable"])
                            }
                        </p>
                    }
                    <Button Variant="ButtonVariant.Secondary" IsLoading="_quoting" Disabled="_quoting" OnClick="QuoteAsync">@L["Personal_ShopQuoteDelivery"]</Button>
                </section>
            }

            <div class="pos-sell-payment__methods">
                <div class="pos-sell-payment-method">
                    <button type="button"
                            class="pos-sell-payment-method__toggle"
                            aria-expanded="@_paymentMethodExpanded"
                            @onclick="() => _paymentMethodExpanded = !_paymentMethodExpanded">
                        <span>@L["Sales_Field_PaymentMethod"] · @PaymentMethodLabel(_paymentMethod)</span>
                        <span aria-hidden="true">@(_paymentMethodExpanded ? "−" : "+")</span>
                    </button>
                    @if (_paymentMethodExpanded)
                    {
                        <div class="pos-payment-method-grid pos-payment-method-grid--checkout">
                            @foreach (var methodCode in PersonalMerchantCheckoutUi.PaymentMethodCodes)
                            {
                                var selected = string.Equals(_paymentMethod, methodCode, StringComparison.Ordinal);
                                <button type="button"
                                        class="@($"pos-payment-method-tile{(selected ? " pos-payment-method-tile--selected" : string.Empty)}")"
                                        aria-pressed="@selected"
                                        @onclick="() => _paymentMethod = methodCode">
                                    @PaymentMethodLabel(methodCode)
                                </button>
                            }
                        </div>
                        @if (string.Equals(_paymentMethod, nameof(CustomerOrderPaymentMethod.ManualGCash), StringComparison.Ordinal))
                        {
                            <p class="pos-muted">@L["Personal_ShopPayment_GCashHelp"]</p>
                        }
                        @if (string.Equals(_paymentMethod, nameof(CustomerOrderPaymentMethod.Utang), StringComparison.Ordinal))
                        {
                            <p class="pos-muted">@L["Personal_ShopPayment_UtangHelp"]</p>
                        }
                    }
                </div>
            </div>

            <div class="pos-personal-shop-review__actions">
                <Button Variant="ButtonVariant.Primary" IsLoading="_placing" Disabled="_placing || !CanSubmit" OnClick="PlaceAsync">@L["Personal_ShopPlaceOrder"]</Button>
            </div>
        }
    </Page>
</div>

@code {
    [Parameter] public Guid OrganizationId { get; set; }

    private bool _loading = true;
    private bool _authenticated;
    private bool _placing;
    private bool _quoting;
    private bool _paymentMethodExpanded;
    private string? _error;
    private string? _organizationName;
    private bool _canDelivery;
    private string _fulfillment = PersonalMerchantCheckoutUi.Pickup;
    private string _branchIdText = string.Empty;
    private string _paymentMethod = nameof(CustomerOrderPaymentMethod.Cash);
    private IReadOnlyList<CustomerStorefrontBranchDto> _branches = [];
    private QuoteCustomerOrderDeliveryDto? _quote;
    private PersonalMerchantFulfillmentSelection _selection =
        new(PersonalMerchantCheckoutUi.Pickup, null, null, false, false, false);

    private string _recipientName = string.Empty;
    private string? _recipientPhone;
    private string _address1 = string.Empty;
    private string? _address2;
    private string? _city;
    private string? _deliveryNotes;
    private decimal _latitude = 14.5995m;
    private decimal _longitude = 120.9842m;

    private IReadOnlyList<CustomerStorefrontBranchDto> EligibleBranches =>
        PersonalMerchantCheckoutUi.EligibleBranches(_branches, _canDelivery, _fulfillment);

    private decimal PayableTotal =>
        _fulfillment == PersonalMerchantCheckoutUi.Delivery && _quote?.Available == true
            ? Cart.MerchandiseSubtotal + _quote.DeliveryFee
            : Cart.MerchandiseSubtotal;

    private bool CanSubmit =>
        _selection.CanPlace
        && Guid.TryParse(_branchIdText, out _)
        && (_fulfillment != PersonalMerchantCheckoutUi.Delivery
            || (!string.IsNullOrWhiteSpace(_recipientName)
                && !string.IsNullOrWhiteSpace(_address1)
                && _quote?.Available == true));

    protected override async Task OnParametersSetAsync()
    {
        Cart.EnsureMerchant(OrganizationId, Cart.OrganizationDisplayName);
        Cart.Changed += OnCartChanged;
        await LoadAsync();
    }

    public void Dispose() => Cart.Changed -= OnCartChanged;

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (!await EnsureSessionAsync())
            {
                return;
            }

            if (!await Connectivity.IsConnectedAsync()
                || !await OnlineRequired.EnsureOnlineForRouteAsync($"/personal/linked-merchants/{OrganizationId:D}/shop/review"))
            {
                _error = L["Personal_ShopOffline"];
                return;
            }

            var result = await Orders.GetStorefrontAsync(OrganizationId, page: 1, pageSize: 1);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            _organizationName = result.Data.OrganizationDisplayName;
            _canDelivery = result.Data.CanCustomerDelivery;
            _branches = result.Data.Branches;
            Cart.EnsureMerchant(OrganizationId, _organizationName);
            ApplySelection(PersonalMerchantCheckoutUi.DefaultFulfillment(_branches, _canDelivery), currentBranchId: null);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectFulfillment(string fulfillment)
    {
        Guid? keep = Guid.TryParse(_branchIdText, out var id) ? id : null;
        ApplySelection(fulfillment, keep);
        _quote = null;
    }

    private void OnBranchChanged(ChangeEventArgs e)
    {
        _branchIdText = e.Value?.ToString() ?? string.Empty;
        Guid? keep = Guid.TryParse(_branchIdText, out var id) ? id : null;
        ApplySelection(_fulfillment, keep);
        _quote = null;
    }

    private void ApplySelection(string requestedFulfillment, Guid? currentBranchId)
    {
        _selection = PersonalMerchantCheckoutUi.Resolve(_branches, _canDelivery, requestedFulfillment, currentBranchId);
        _fulfillment = _selection.FulfillmentType;
        _branchIdText = _selection.BranchId?.ToString("D") ?? string.Empty;
    }

    private string FulfillmentModeClass(string mode) =>
        _fulfillment == mode
            ? "pos-personal-shop-review__mode pos-personal-shop-review__mode--active"
            : "pos-personal-shop-review__mode";

    private string FulfillmentLabel(string type) =>
        string.Equals(type, PersonalMerchantCheckoutUi.Delivery, StringComparison.Ordinal)
            ? L["Orders_Delivery"]
            : L["Orders_Pickup"];

    private string PaymentMethodLabel(string methodCode) =>
        string.Equals(methodCode, nameof(CustomerOrderPaymentMethod.ManualGCash), StringComparison.Ordinal)
            ? L["Personal_ShopPayment_GCash"]
            : string.Equals(methodCode, nameof(CustomerOrderPaymentMethod.Utang), StringComparison.Ordinal)
                ? L["Personal_ShopPayment_Utang"]
                : L["Personal_ShopPayment_Cash"];

    private async Task QuoteAsync()
    {
        if (!Guid.TryParse(_branchIdText, out var branchId))
        {
            return;
        }

        _quoting = true;
        _error = null;
        try
        {
            var result = await Orders.QuoteDeliveryAsCustomerAsync(
                OrganizationId,
                new QuoteCustomerOrderDeliveryRequest(branchId, Cart.MerchandiseSubtotal, _latitude, _longitude));
            if (!result.IsSuccess || result.Data is null)
            {
                _quote = null;
                _error = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            _quote = result.Data;
        }
        finally
        {
            _quoting = false;
        }
    }

    private async Task PlaceAsync()
    {
        if (!CanSubmit || !Guid.TryParse(_branchIdText, out var branchId))
        {
            return;
        }

        if (!await Connectivity.IsConnectedAsync())
        {
            _error = L["Personal_ShopOffline"];
            return;
        }

        _placing = true;
        _error = null;
        try
        {
            var actorId = CurrentUser.Session?.UserId ?? Guid.Empty;
            var displayName = CurrentUser.Session?.DisplayName ?? "Customer";
            var clientOrderId = Guid.NewGuid();
            PlaceCustomerOrderDeliveryRequest? delivery = null;
            if (_fulfillment == PersonalMerchantCheckoutUi.Delivery)
            {
                delivery = new PlaceCustomerOrderDeliveryRequest(
                    _recipientName.Trim(),
                    string.IsNullOrWhiteSpace(_recipientPhone) ? null : _recipientPhone.Trim(),
                    _address1.Trim(),
                    string.IsNullOrWhiteSpace(_address2) ? null : _address2.Trim(),
                    string.IsNullOrWhiteSpace(_city) ? null : _city.Trim(),
                    string.IsNullOrWhiteSpace(_deliveryNotes) ? null : _deliveryNotes.Trim(),
                    _latitude,
                    _longitude);
            }

            var request = new PlaceCustomerOrderRequest(
                _fulfillment,
                branchId,
                "Personal",
                displayName,
                actorId,
                null,
                null,
                Cart.Lines.Select(l => new PlaceCustomerOrderLineRequest(l.ProductId, l.Quantity, 0m)).ToList(),
                delivery,
                clientOrderId,
                clientOrderId.ToString("D"),
                _paymentMethod);

            var result = await Orders.PlaceAsCustomerAsync(OrganizationId, request);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = result.Error?.Detail ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
                return;
            }

            Cart.ClearLinesOnly();
            Nav.NavigateTo($"/personal/orders/{result.Data.OrderId:D}");
        }
        finally
        {
            _placing = false;
        }
    }

    private Task GoShopAsync() =>
        OfflineNav.NavigateAsync($"/personal/linked-merchants/{OrganizationId:D}/shop");

    private async Task<bool> EnsureSessionAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            var restore = await Auth.RestoreSessionAsync();
            _authenticated = restore.Succeeded;
        }
        else
        {
            _authenticated = true;
        }

        if (!_authenticated)
        {
            return false;
        }

        var personal = await Auth.EnsurePersonalAccountProfileAsync();
        if (!personal.Succeeded)
        {
            _error = L[personal.SafeMessageKey ?? "Access_Denied"];
            return false;
        }

        return true;
    }

    private void GoSignIn() => Nav.NavigateTo("/signin");

    private static string FormatQty(decimal qty) =>
        qty.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}

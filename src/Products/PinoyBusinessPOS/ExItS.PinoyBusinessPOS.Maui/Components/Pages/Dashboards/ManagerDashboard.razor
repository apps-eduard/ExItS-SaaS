@page "/manager"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject RoleHomeResolver RoleHome
@inject SellingModeService SellingMode
@inject ICurrentUserContext CurrentUser
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_authorized)
{
    <Page>
        <ErrorState Title="@L["Access_DeniedTitle"]" Message="@L["Manager_DeniedMessage"]" />
    </Page>
}
else
{
    <div class="pos-dash">
        <Page>
            <PageHeader Title="@L["Manager_Title"]" Subtitle="@L["Manager_Subtitle"]" />

            <Section Title="@L["Manager_QuickActionsSection"]">
                <div class="pos-action-grid" role="group" aria-label="@L["Manager_QuickActionsSection"]">
                    <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="StartSelling">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Owner_StartSelling"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoSales">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Nav_Sales"]</span>
                    </button>
                </div>
                <p class="pos-dash__hint pos-muted">@L["Manager_StartSellingHint"]</p>
            </Section>

            <Section Title="@L["Manager_OperationsSection"]">
                <div class="pos-action-grid" role="group" aria-label="@L["Manager_OperationsSection"]">
                    <button type="button" class="pos-action-tile" @onclick="GoCatalog">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                        <span class="pos-action-tile__label">@L["Nav_Products"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoInventory">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                        <span class="pos-action-tile__label">@L["Nav_Inventory"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoRegisters">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Nav_Registers"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoShifts">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                        <span class="pos-action-tile__label">@L["Nav_Shifts"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoSales">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Nav_Sales"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoReports">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
                        <span class="pos-action-tile__label">@L["Nav_Reports"]</span>
                    </button>
                </div>
            </Section>
        </Page>
    </div>
}

@code {
    private bool _ready;
    private bool _authorized;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        if (string.Equals(SellingMode.PreferredHomeRoute, RoleHomeResolver.ManagerHome, StringComparison.Ordinal))
        {
            _authorized = true;
        }
        else
        {
            if (!Gate.CanEnterProtectedShell)
            {
                Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
                return;
            }

            var home = await RoleHome.ResolvePosHomeAsync();
            _authorized = home == RoleHomeResolver.ManagerHome;
            if (!_authorized)
            {
                Nav.NavigateTo(home, replace: true);
                return;
            }
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _ready = true;
    }

    private void StartSelling()
    {
        SellingMode.Enter(RoleHomeResolver.ManagerHome);
        Nav.NavigateTo("/sales/new");
    }

    private void GoCatalog() => Nav.NavigateTo("/catalog");
    private void GoInventory() => Nav.NavigateTo("/inventory");
    private void GoRegisters() => Nav.NavigateTo("/registers");
    private void GoShifts() => Nav.NavigateTo("/shifts");
    private void GoSales() => Nav.NavigateTo("/sales");
    private void GoReports() => Nav.NavigateTo("/reports");
}

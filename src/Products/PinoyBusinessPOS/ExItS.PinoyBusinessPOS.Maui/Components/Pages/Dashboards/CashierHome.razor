@page "/cashier"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject RoleHomeResolver RoleHome
@inject SellingModeService SellingMode
@inject IPosCashierShiftClient Shifts
@inject IPosRegisterClient Registers
@inject ICurrentUserContext CurrentUser
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_authorized)
{
    <Page>
        <ErrorState Title="@L["Access_DeniedTitle"]" Message="@L["Cashier_DeniedMessage"]" />
    </Page>
}
else
{
    <div class="pos-dash pos-cashier">
        <Page>
            <header class="pos-dash__header">
                <h1 class="pos-dash__title">@L["Cashier_Title"]</h1>
            </header>

            @if (_isOffline)
            {
                <Alert Tone="AlertTone.Warning" Title="@L["Shifts_OfflineTitle"]" Message="@L["Shifts_OfflineMessage"]" />
            }

            <Section Title="@L["Cashier_RegisterSection"]">
                <div class="pos-settings__panel">
                    <div class="pos-settings__kv">
                        <span class="pos-settings__kv-label">@L["Cashier_CurrentRegister"]</span>
                        <span class="pos-settings__kv-value">@(_registerLabel ?? L["Cashier_NoRegister"])</span>
                    </div>
                </div>
            </Section>

            <Section Title="@L["Cashier_ShiftSection"]">
                @if (_openShift is null)
                {
                    <EmptyState Title="@L["Cashier_NoShiftTitle"]" Message="@L["Cashier_NoShiftMessage"]" />
                    <div class="pos-action-grid pos-action-grid--single pos-cashier__actions" role="group" aria-label="@L["Cashier_ShiftSection"]">
                        <button type="button"
                                class="pos-action-tile pos-action-tile--primary"
                                disabled="@_isOffline"
                                @onclick="GoOpenShift">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                            <span class="pos-action-tile__label">@L["Shifts_Open"]</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="pos-settings__panel pos-cashier__shift-panel">
                        <div class="pos-settings__kv">
                            <span class="pos-settings__kv-label">@L["Cashier_ShiftSection"]</span>
                            <span class="pos-settings__kv-value pos-cashier__shift-status">@_openShift.Status</span>
                        </div>
                        <div class="pos-settings__kv">
                            <span class="pos-settings__kv-label">@L["Cashier_ShiftIdLabel"]</span>
                            <span class="pos-settings__kv-value">@_openShift.ShiftId.ToString("D")[..8]</span>
                        </div>
                    </div>

                    <div class="pos-action-grid pos-action-grid--three pos-cashier__actions" role="group" aria-label="@L["Cashier_ShiftSection"]">
                        <button type="button" class="pos-action-tile" @onclick="GoContinueShift">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                            <span class="pos-action-tile__label">@L["Cashier_ContinueShift"]</span>
                        </button>
                        <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="GoNewSale">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                            <span class="pos-action-tile__label">@L["Cashier_NewSale"]</span>
                        </button>
                        <button type="button" class="pos-action-tile" @onclick="GoCloseShift">
                            <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                            <span class="pos-action-tile__label">@L["Cashier_CloseShift"]</span>
                        </button>
                    </div>
                }
            </Section>

            <Section Title="@L["Cashier_HistorySection"]">
                <div class="pos-action-grid pos-action-grid--single pos-cashier__actions" role="group" aria-label="@L["Cashier_HistorySection"]">
                    <button type="button" class="pos-action-tile" @onclick="GoSales">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Cashier_OwnSales"]</span>
                    </button>
                </div>
            </Section>
        </Page>
    </div>
}

@code {
    private bool _ready;
    private bool _authorized;
    private bool _isOffline;
    private string? _registerLabel;
    private PosCashierShiftDto? _openShift;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        // Organization Owner membership alone never authorizes a POS dashboard.
        if (!CurrentUser.HasPosAccess)
        {
            Nav.NavigateTo(RoleHomeResolver.OrgEssentials, replace: true);
            return;
        }

        if (string.Equals(SellingMode.PreferredHomeRoute, RoleHomeResolver.CashierHome, StringComparison.Ordinal))
        {
            _authorized = true;
        }
        else
        {
            if (!Gate.CanEnterProtectedShell)
            {
                Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
                return;
            }

            var home = await RoleHome.ResolvePosHomeAsync();
            _authorized = home == RoleHomeResolver.CashierHome;
            if (!_authorized)
            {
                Nav.NavigateTo(home, replace: true);
                return;
            }
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (!_isOffline)
        {
            var current = await Shifts.GetCurrentAsync();
            if (current.IsSuccess && current.Data is not null
                && string.Equals(current.Data.Status, "Open", StringComparison.OrdinalIgnoreCase))
            {
                _openShift = current.Data;
            }

            if (_openShift is not null)
            {
                _registerLabel = _openShift.RegisterName
                    ?? (_openShift.RegisterId is Guid registerId
                        ? (await Registers.GetAsync(registerId)).Data?.Name
                        : null);
            }
            else
            {
                var regs = await Registers.ListAsync(status: "Active", page: 1, pageSize: 5);
                if (regs.IsSuccess && regs.Data?.Items.Count > 0)
                {
                    _registerLabel = regs.Data.Items[0].Name;
                }
            }
        }

        _ready = true;
    }

    private void GoOpenShift() => Nav.NavigateTo("/shifts/open");
    private void GoContinueShift() => Nav.NavigateTo(_openShift is null ? "/shifts" : $"/shifts/{_openShift.ShiftId:D}");
    private void GoCloseShift() => Nav.NavigateTo(_openShift is null ? "/shifts" : $"/shifts/{_openShift.ShiftId:D}");
    private void GoNewSale() => Nav.NavigateTo("/sales/new");
    private void GoSales() => Nav.NavigateTo("/sales");
}

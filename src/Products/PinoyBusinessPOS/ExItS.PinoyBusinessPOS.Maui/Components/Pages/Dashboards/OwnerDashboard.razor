@page "/owner"
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject RoleHomeResolver RoleHome
@inject SellingModeService SellingMode
@inject IPosOperationalSetupClient Setup
@inject IUtangCapabilityEvaluator Capabilities
@inject ICurrentUserContext CurrentUser
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_authorized)
{
    <Page>
        <ErrorState Title="@L["Access_DeniedTitle"]" Message="@L["Owner_DeniedMessage"]" />
    </Page>
}
else
{
    <Page>
        <PageHeader Title="@L["Owner_Title"]" Subtitle="@CurrentUser.Session?.OrganizationDisplayName">
            <Actions>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoOrg">@L["Org_SummaryTitle"]</Button>
            </Actions>
        </PageHeader>

        <Section Title="@L["Owner_SetupSection"]">
            <Stack Gap="2">
                <span class="pos-muted">@(_setupCompleted ? L["Owner_SetupComplete"] : L["Owner_SetupIncomplete"])</span>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoSetup">@L["Nav_Setup"]</Button>
            </Stack>
        </Section>

        <Section Title="@L["Owner_SellingSection"]">
            <Button Variant="ButtonVariant.Primary" OnClick="StartSelling">@L["Owner_StartSelling"]</Button>
            <InlineMessage Tone="InlineMessageTone.Info">@L["Owner_StartSellingHint"]</InlineMessage>
        </Section>

        <Section Title="@L["Owner_OperationsSection"]">
            <Stack Gap="2">
                <Button Variant="ButtonVariant.Secondary" OnClick="GoCatalog">@L["Nav_Products"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoCategories">@L["Catalog_Categories"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoInventory">@L["Nav_Inventory"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoPermissions">@L["Nav_Permissions"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoStaff">@L["Org_StaffLink"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoRegisters">@L["Nav_Registers"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoShifts">@L["Nav_Shifts"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoSales">@L["Nav_Sales"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoReports">@L["Nav_Reports"]</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="GoSettings">@L["Nav_Settings"]</Button>
            </Stack>
        </Section>
    </Page>
}

@code {
    private bool _ready;
    private bool _authorized;
    private bool _setupCompleted;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        // Owner working-as from org select — trust preferred home even if effective-role API lags.
        if (string.Equals(SellingMode.PreferredHomeRoute, RoleHomeResolver.OwnerHome, StringComparison.Ordinal))
        {
            _authorized = true;
        }
        else
        {
            if (!Gate.CanEnterProtectedShell)
            {
                Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
                return;
            }

            var home = await RoleHome.ResolvePosHomeAsync();
            _authorized = home == RoleHomeResolver.OwnerHome;
            if (!_authorized)
            {
                Nav.NavigateTo(home, replace: true);
                return;
            }
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup))
        {
            var setup = await Setup.GetAsync();
            _setupCompleted = setup.IsSuccess && setup.Data?.IsCompleted == true;
        }

        _ready = true;
    }

    private void StartSelling()
    {
        SellingMode.Enter(RoleHomeResolver.OwnerHome);
        Nav.NavigateTo("/sales/new");
    }

    private void GoSetup() => Nav.NavigateTo("/setup");
    private void GoOrg() => Nav.NavigateTo("/org");
    private void GoCatalog() => Nav.NavigateTo("/catalog");
    private void GoCategories() => Nav.NavigateTo("/catalog/categories");
    private void GoInventory() => Nav.NavigateTo("/inventory");
    private void GoPermissions() => Nav.NavigateTo("/permissions");
    private void GoStaff() => Nav.NavigateTo("/org/staff");
    private void GoRegisters() => Nav.NavigateTo("/registers");
    private void GoShifts() => Nav.NavigateTo("/shifts");
    private void GoSales() => Nav.NavigateTo("/sales");
    private void GoReports() => Nav.NavigateTo("/reports");
    private void GoSettings() => Nav.NavigateTo("/settings");
}

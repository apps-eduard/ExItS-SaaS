@page "/owner"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject RoleHomeResolver RoleHome
@inject SellingModeService SellingMode
@inject IPosOperationalSetupClient Setup
@inject IUtangCapabilityEvaluator Capabilities
@inject ICurrentUserContext CurrentUser
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (!_authorized)
{
    <Page>
        <ErrorState Title="@L["Access_DeniedTitle"]" Message="@L["Owner_DeniedMessage"]" />
    </Page>
}
else
{
    <div class="pos-dash">
        <Page>
            <header class="pos-dash__header">
                <h1 class="pos-dash__title">@L["Owner_Title"]</h1>
                <p class="pos-dash__subtitle">@L["Owner_Subtitle"]</p>
            </header>

            <Section Title="@L["Owner_QuickActionsSection"]">
                <div class="pos-action-grid" role="group" aria-label="@L["Owner_QuickActionsSection"]">
                    <button type="button" class="pos-action-tile pos-action-tile--primary" @onclick="StartSelling">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Owner_StartSelling"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoOrg">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                        <span class="pos-action-tile__label">@L["Org_SummaryTitle"]</span>
                    </button>
                </div>
                <p class="pos-dash__hint pos-muted">@L["Owner_StartSellingHint"]</p>
            </Section>

            <Section Title="@L["Owner_SetupSection"]">
                <div class="pos-action-grid pos-action-grid--single" role="group" aria-label="@L["Owner_SetupSection"]">
                    <button type="button" class="pos-action-tile" @onclick="GoSetup">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                        <span class="pos-action-tile__label">@L["Nav_Setup"]</span>
                    </button>
                </div>
                <p class="pos-dash__status @(_setupCompleted ? "pos-dash__status--ok" : "pos-dash__status--warn")">
                    <span class="pos-dash__status-label">@L["Owner_SetupStatusLabel"]</span>
                    <span>@(_setupCompleted ? L["Owner_SetupStatusComplete"] : L["Owner_SetupStatusIncomplete"])</span>
                </p>
            </Section>

            <Section Title="@L["Owner_OperationsSection"]">
                <div class="pos-action-grid" role="group" aria-label="@L["Owner_OperationsSection"]">
                    <button type="button" class="pos-action-tile" @onclick="GoCatalog">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("products")</span>
                        <span class="pos-action-tile__label">@L["Nav_Products"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoCategories">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("menu")</span>
                        <span class="pos-action-tile__label">@L["Catalog_Categories"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoInventory">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("inbox")</span>
                        <span class="pos-action-tile__label">@L["Nav_Inventory"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoStaff">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                        <span class="pos-action-tile__label">@L["Org_StaffLink"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoRegisters">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Nav_Registers"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoShifts">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                        <span class="pos-action-tile__label">@L["Nav_Shifts"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoSales">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                        <span class="pos-action-tile__label">@L["Nav_Sales"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoPermissions">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("check")</span>
                        <span class="pos-action-tile__label">@L["Nav_Permissions"]</span>
                    </button>
                </div>
            </Section>

            <Section Title="@L["Owner_InsightsSection"]">
                <div class="pos-action-grid" role="group" aria-label="@L["Owner_InsightsSection"]">
                    <button type="button" class="pos-action-tile" @onclick="GoReports">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("info")</span>
                        <span class="pos-action-tile__label">@L["Nav_Reports"]</span>
                    </button>
                    <button type="button" class="pos-action-tile" @onclick="GoSettings">
                        <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                        <span class="pos-action-tile__label">@L["Nav_Settings"]</span>
                    </button>
                </div>
            </Section>
        </Page>
    </div>
}

@code {
    private bool _ready;
    private bool _authorized;
    private bool _setupCompleted;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            Nav.NavigateTo(RoleHomeResolver.PersonalHome, replace: true);
            return;
        }

        // Organization Owner membership alone never authorizes a POS dashboard.
        if (!CurrentUser.HasPosAccess)
        {
            Nav.NavigateTo(RoleHomeResolver.OrgEssentials, replace: true);
            return;
        }

        // Owner working-as from org select — trust preferred home even if effective-role API lags.
        if (string.Equals(SellingMode.PreferredHomeRoute, RoleHomeResolver.OwnerHome, StringComparison.Ordinal))
        {
            _authorized = true;
        }
        else
        {
            if (!Gate.CanEnterProtectedShell)
            {
                Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
                return;
            }

            var home = await RoleHome.ResolvePosHomeAsync();
            _authorized = home == RoleHomeResolver.OwnerHome;
            if (!_authorized)
            {
                Nav.NavigateTo(home, replace: true);
                return;
            }
        }

        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (Capabilities.IsAllowed(UtangCapability.ManageOperationalSetup))
        {
            var setup = await Setup.GetAsync();
            _setupCompleted = setup.IsSuccess && setup.Data?.IsCompleted == true;
        }

        _ready = true;
    }

    private void StartSelling()
    {
        SellingMode.Enter(RoleHomeResolver.OwnerHome);
        Nav.NavigateTo("/sales/new");
    }

    private void GoSetup() => Nav.NavigateTo("/setup");
    private void GoOrg() => Nav.NavigateTo("/org");
    private void GoCatalog() => Nav.NavigateTo("/catalog");
    private void GoCategories() => Nav.NavigateTo("/catalog/categories");
    private void GoInventory() => Nav.NavigateTo("/inventory");
    private void GoPermissions() => Nav.NavigateTo("/permissions");
    private void GoStaff() => Nav.NavigateTo("/org/staff");
    private void GoRegisters() => Nav.NavigateTo("/registers");
    private void GoShifts() => Nav.NavigateTo("/shifts");
    private void GoSales() => Nav.NavigateTo("/sales");
    private void GoReports() => Nav.NavigateTo("/reports");
    private void GoSettings() => Nav.NavigateTo("/settings");
}

@page "/expenses/categories"
@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosExpenseClient Expenses
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/expenses" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageExpenses);
    var canView = Capabilities.IsAllowed(UtangCapability.ViewExpenses);
    var onlineActionsEnabled = !_isOffline && !_loading;
    var showEmptyAdd = canManage && !_isOffline && string.IsNullOrWhiteSpace(_search);
<div class="pos-expense-categories">
<Page>
    <header class="pos-expense-categories__header">
        <div class="pos-expense-categories__heading">
            <h1 class="pos-expense-categories__title">@L["Expenses_CategoriesTitle"]</h1>
            <p class="pos-expense-categories__subtitle">@L["Expenses_CategoriesSubtitle"]</p>
        </div>
        @if (canManage)
        {
            <button type="button"
                    class="pos-expense-categories__add"
                    disabled="@(_isOffline || _saving || _formOpen)"
                    @onclick="BeginCreate">
                <span class="pos-expense-categories__add-icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span>@L["Expenses_Category"]</span>
            </button>
        }
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Expenses_OfflineTitle"]" Message="@L["Expenses_OfflineMessage"]" />
    }
    else if (!canManage)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Access_RestrictedTitle"]" Message="@L["Access_RestrictedMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Expenses_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_formError))
    {
        <Alert Tone="AlertTone.Danger" Title="@L["Expenses_ErrorTitle"]" Message="@_formError" />
    }

    @if (_formOpen)
    {
        <section class="pos-expense-categories__panel" aria-labelledby="expense-category-form-heading">
            <h2 id="expense-category-form-heading" class="pos-expense-categories__section-title">@(_editingId is null ? L["Expenses_Category_AddTitle"] : L["Expenses_Category_EditTitle"])</h2>
            <div class="pos-expense-categories__form">
                <TextInput Label="@L["Expenses_CategoryName"]"
                           Value="@_name"
                           ValueChanged="v => _name = v"
                           Required="true"
                           IsInvalid="@(!string.IsNullOrEmpty(_nameError))"
                           ErrorText="@_nameError"
                           Disabled="@(!canManage || _isOffline || _saving)" />
            </div>
            <FormActions class="pos-customer-create__footer">
                <Button Variant="ButtonVariant.Secondary" Disabled="@_saving" OnClick="CancelForm">@L["Expenses_Cancel"]</Button>
                <Button Variant="ButtonVariant.Primary"
                        Disabled="@(!canManage || _isOffline)"
                        IsLoading="@_saving"
                        OnClick="SaveAsync">@(_editingId is null ? L["Expenses_Category_Add"] : L["Expenses_Save"])</Button>
            </FormActions>
        </section>
    }

    <div class="pos-expense-categories__toolbar" role="search">
        <div class="pos-expense-categories__search">
            <span class="pos-expense-categories__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
            <input class="pos-expense-categories__search-input"
                   type="search"
                   value="@_search"
                   placeholder="@L["Expenses_Category_SearchPlaceholder"]"
                   aria-label="@L["Expenses_Category_SearchPlaceholder"]"
                   disabled="@(!canView || (_loading && string.IsNullOrWhiteSpace(_search)))"
                   @oninput="OnSearchInputAsync" />
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button type="button"
                        class="pos-expense-categories__search-clear"
                        aria-label="@L["Expenses_Category_ClearSearch"]"
                        disabled="@_isOffline"
                        @onclick="ClearSearchAsync">
                    <span aria-hidden="true">@IconGlyphs.Get("close")</span>
                </button>
            }
        </div>
        <label class="pos-expense-categories__status">
            <span class="visually-hidden">@L["Expenses_Filter_Status"]</span>
            <select class="pos-expense-categories__status-select"
                    value="@(_statusFilter ?? string.Empty)"
                    disabled="@(_isOffline || !canView)"
                    @onchange="OnStatusSelectChanged">
                @foreach (var option in ExpensesUiOptions.CategoryStatusFilters(L))
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
        </label>
        <button type="button"
                class="pos-expense-categories__refresh"
                title="@L["Expenses_Refresh"]"
                aria-label="@L["Expenses_Refresh"]"
                disabled="@(!onlineActionsEnabled || !canView)"
                @onclick="ReloadWithLoadingAsync">
            @if (_loading)
            {
                <Spinner Size="SpinnerSize.Sm" />
            }
            else
            {
                <span aria-hidden="true">@IconGlyphs.Get("refresh")</span>
            }
        </button>
    </div>

    <section class="pos-expense-categories__list-section"
             aria-labelledby="expense-categories-list-heading"
             aria-busy="@_loading">
        <h2 id="expense-categories-list-heading" class="visually-hidden">@L["Expenses_CategoriesTitle"]</h2>

        @if (_loading && _items.Count == 0 && string.IsNullOrEmpty(_errorTitle))
        {
            <div class="pos-expense-categories__loading" role="status" aria-live="polite">
                <Spinner />
                <span>@L["Expenses_Loading"]</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorTitle))
        {
            <ErrorState Title="@_errorTitle"
                        Message="@(_errorMessage ?? L["Expenses_Category_EmptyMessage"])"
                        RetryLabel="@L["Api_Retry"]"
                        OnRetry="ReloadWithLoadingAsync" />
        }
        else if (_items.Count == 0)
        {
            <EmptyState IconName="inbox"
                        Title="@(HasListQuery ? L["Expenses_Category_NoMatchTitle"] : L["Expenses_Category_EmptyTitle"])"
                        Message="@(HasListQuery ? L["Expenses_Category_NoMatchMessage"] : L["Expenses_Category_EmptyMessage"])">
                <Actions>
                    @if (showEmptyAdd)
                    {
                        <Button Variant="ButtonVariant.Primary"
                                Size="ButtonSize.Sm"
                                Disabled="@(_saving || _formOpen)"
                                OnClick="BeginCreate">
                            @L["Expenses_Category_Add"]
                        </Button>
                    }
                </Actions>
            </EmptyState>
        }
        else
        {
            @if (_menuCategoryId is not null)
            {
                <NavigationLock OnBeforeInternalNavigation="OnMenuBackNavigation" />
                <div class="pos-expense-categories__menu-backdrop"
                     role="presentation"
                     aria-hidden="true"
                     @onclick="CloseMenu"
                     @onkeydown="OnMenuKeyDown"></div>
            }
            <div class="pos-expense-categories__list" role="list" aria-label="@L["Expenses_CategoriesTitle"]">
                @foreach (var item in _items)
                {
                    var isActive = item.Status == ExpensesUiOptions.ActiveCategoryStatus;
                    var menuOpen = _menuCategoryId == item.CategoryId;
                    var rowBusy = _busyCategoryId == item.CategoryId;
                    <article class="pos-expense-categories__row" role="listitem">
                        <div class="pos-expense-categories__row-body">
                            <div class="pos-expense-categories__row-top">
                                <span class="pos-expense-categories__row-name">@item.Name</span>
                                <Badge Tone="@(isActive ? BadgeTone.Success : BadgeTone.Neutral)">
                                    @ExpensesUiOptions.CategoryStatusLabel(L, item.Status)
                                </Badge>
                            </div>
                        </div>
                        @if (canManage)
                        {
                            <div class="pos-expense-categories__menu @(menuOpen ? "pos-expense-categories__menu--open" : null)"
                                 @onclick:stopPropagation="true">
                                <button type="button"
                                        class="pos-expense-categories__menu-trigger"
                                        aria-label="@L["Expenses_Category_MoreActions"]"
                                        aria-haspopup="menu"
                                        aria-expanded="@menuOpen"
                                        disabled="@(_isOffline || _saving || rowBusy)"
                                        @onclick="() => ToggleMenu(item.CategoryId)">
                                    @if (rowBusy)
                                    {
                                        <Spinner Size="SpinnerSize.Sm" />
                                    }
                                    else
                                    {
                                        <span aria-hidden="true">@IconGlyphs.Get("more")</span>
                                    }
                                </button>
                                @if (menuOpen)
                                {
                                    <div class="pos-expense-categories__menu-panel" role="menu">
                                        <button type="button"
                                                class="pos-expense-categories__menu-item"
                                                role="menuitem"
                                                disabled="@(_isOffline || _saving || rowBusy)"
                                                @onclick="() => BeginRename(item)">
                                            @L["Expenses_Category_Rename"]
                                        </button>
                                        <button type="button"
                                                class="pos-expense-categories__menu-item @(isActive ? "pos-expense-categories__menu-item--danger" : null)"
                                                role="menuitem"
                                                disabled="@(_isOffline || _saving || rowBusy)"
                                                @onclick="() => ToggleStatusFromMenuAsync(item)">
                                            @(isActive ? L["Expenses_Category_Deactivate"] : L["Expenses_Category_Reactivate"])
                                        </button>
                                        <button type="button"
                                                class="pos-expense-categories__menu-item pos-expense-categories__menu-item--cancel"
                                                role="menuitem"
                                                @onclick="CloseMenu">
                                            @L["Expenses_Cancel"]
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    @if (!_loading && _totalCount > 0)
    {
        <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
    }
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _saving;
    private bool _isOffline;
    private bool _formOpen;
    private string? _search;
    private string? _statusFilter = ExpensesUiOptions.ActiveCategoryStatus;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosExpenseCategoryDto> _items = Array.Empty<PosExpenseCategoryDto>();
    private Guid? _editingId;
    private DateTimeOffset? _editingUpdatedAtUtc;
    private Guid? _menuCategoryId;
    private Guid? _busyCategoryId;
    private string? _name;
    private string? _nameError;
    private string? _formError;
    private string? _banner;
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private bool HasListQuery => !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewExpenses))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await ReloadWithLoadingAsync();
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private Task ReloadWithLoadingAsync() => ReloadAsync(showLoading: true);

    private async Task OnSearchInputAsync(ChangeEventArgs args)
    {
        _search = args.Value?.ToString();
        _page = 1;
        _menuCategoryId = null;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync(showLoading: true);
        }
        catch (OperationCanceledException)
        {
            // superseded by newer keystrokes
        }
    }

    private async Task ClearSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return;
        }

        _search = null;
        _page = 1;
        _menuCategoryId = null;
        await ReloadAsync(showLoading: true);
    }

    private async Task OnStatusSelectChanged(ChangeEventArgs args)
    {
        var next = args.Value?.ToString() ?? string.Empty;
        if (string.Equals(next, _statusFilter ?? string.Empty, StringComparison.Ordinal))
        {
            return;
        }

        _statusFilter = next;
        _page = 1;
        _menuCategoryId = null;
        await ReloadAsync(showLoading: true);
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        _menuCategoryId = null;
        await ReloadAsync(showLoading: true);
    }

    private async Task ReloadAsync(bool showLoading = true)
    {
        // Do not await InvokeAsync(StateHasChanged) here — on MAUI Blazor that deadlocks
        // when Reload runs from OnInitializedAsync (Refresh stays Loading forever).
        if (showLoading)
        {
            _loading = true;
            _errorTitle = null;
            _errorMessage = null;
            StateHasChanged();
        }

        try
        {
            _isOffline = !await Connectivity.IsConnectedAsync();
            if (_isOffline)
            {
                if (showLoading)
                {
                    _items = Array.Empty<PosExpenseCategoryDto>();
                    _totalCount = 0;
                }

                _errorTitle = L["Expenses_OfflineTitle"];
                _errorMessage = L["Expenses_OfflineMessage"];
                return;
            }

            var result = await Expenses.ListCategoriesAsync(
                string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                _search,
                _page,
                _pageSize);

            if (result.IsSuccess && result.Data is not null)
            {
                _items = result.Data.Items;
                _totalCount = result.Data.TotalCount;
                _errorTitle = null;
                _errorMessage = null;
            }
            else if (showLoading || _items.Count == 0)
            {
                _items = Array.Empty<PosExpenseCategoryDto>();
                _totalCount = 0;
                var described = ApiLocalizer.Describe(result.Status, result.Error);
                _errorTitle = described.Title;
                _errorMessage = result.Error?.Detail ?? described.Message;
            }
        }
        catch (Exception ex)
        {
            if (showLoading || _items.Count == 0)
            {
                _items = Array.Empty<PosExpenseCategoryDto>();
                _totalCount = 0;
                _errorTitle = L["Expenses_ErrorTitle"];
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void BeginCreate()
    {
        _formOpen = true;
        _editingId = null;
        _editingUpdatedAtUtc = null;
        _name = null;
        _nameError = null;
        _formError = null;
        _banner = null;
        _menuCategoryId = null;
    }

    private void BeginRename(PosExpenseCategoryDto category)
    {
        _menuCategoryId = null;
        _formOpen = true;
        _editingId = category.CategoryId;
        _editingUpdatedAtUtc = category.UpdatedAtUtc;
        _name = category.Name;
        _nameError = null;
        _formError = null;
        _banner = null;
    }

    private void CancelForm()
    {
        _formOpen = false;
        _editingId = null;
        _editingUpdatedAtUtc = null;
        _name = null;
        _nameError = null;
    }

    private void ToggleMenu(Guid categoryId)
    {
        _menuCategoryId = _menuCategoryId == categoryId ? null : categoryId;
    }

    private void CloseMenu() => _menuCategoryId = null;

    private Task OnMenuBackNavigation(LocationChangingContext context)
    {
        if (_menuCategoryId is null)
        {
            return Task.CompletedTask;
        }

        context.PreventNavigation();
        CloseMenu();
        return Task.CompletedTask;
    }

    private void OnMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" or "Esc")
        {
            CloseMenu();
        }
    }

    private async Task ToggleStatusFromMenuAsync(PosExpenseCategoryDto category)
    {
        CloseMenu();
        await ToggleStatusAsync(category);
    }

    private async Task SaveAsync()
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageExpenses))
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _nameError = null;
        _formError = null;
        _banner = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _nameError = L["Expenses_Category_NameRequired"];
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            var editingId = _editingId;
            var result = editingId is { } id
                ? await Expenses.UpdateCategoryAsync(id, new UpdatePosExpenseCategoryRequest(_name.Trim(), _editingUpdatedAtUtc))
                : await Expenses.CreateCategoryAsync(new CreatePosExpenseCategoryRequest(_name.Trim()));

            if (result.IsSuccess && result.Data is not null)
            {
                _banner = editingId is null
                    ? L["Expenses_Category_CreatedSuccess"]
                    : L["Expenses_Category_UpdatedSuccess"];
                CancelForm();
                UpsertLocalCategory(result.Data);
                _saving = false;
                StateHasChanged();
                await ReloadAsync(showLoading: false);
                return;
            }

            _formError = result.Error?.Detail
                ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void UpsertLocalCategory(PosExpenseCategoryDto category)
    {
        var list = _items.ToList();
        var index = list.FindIndex(c => c.CategoryId == category.CategoryId);
        var matchesFilter = string.IsNullOrWhiteSpace(_statusFilter)
            || string.Equals(_statusFilter, category.Status, StringComparison.OrdinalIgnoreCase);

        if (index >= 0)
        {
            if (matchesFilter)
            {
                list[index] = category;
            }
            else
            {
                list.RemoveAt(index);
                _totalCount = Math.Max(0, _totalCount - 1);
            }
        }
        else if (matchesFilter)
        {
            list.Insert(0, category);
            _totalCount += 1;
        }

        _items = list;
        _errorTitle = null;
        _errorMessage = null;
    }

    private async Task ToggleStatusAsync(PosExpenseCategoryDto category)
    {
        if (!Capabilities.IsAllowed(UtangCapability.ManageExpenses) || _isOffline)
        {
            _formError = L["Access_RestrictedMessage"];
            return;
        }

        _formError = null;
        _banner = null;
        _busyCategoryId = category.CategoryId;
        StateHasChanged();

        try
        {
            var result = category.Status == ExpensesUiOptions.ActiveCategoryStatus
                ? await Expenses.DeactivateCategoryAsync(category.CategoryId)
                : await Expenses.ReactivateCategoryAsync(category.CategoryId);

            if (result.IsSuccess)
            {
                _banner = category.Status == ExpensesUiOptions.ActiveCategoryStatus
                    ? L["Expenses_Category_DeactivatedSuccess"]
                    : L["Expenses_Category_ReactivatedSuccess"];
                if (result.Data is not null)
                {
                    UpsertLocalCategory(result.Data);
                }

                await ReloadAsync(showLoading: false);
                return;
            }

            _formError = result.Error?.Detail
                ?? ApiLocalizer.Describe(result.Status, result.Error).Message;
        }
        finally
        {
            _busyCategoryId = null;
        }
    }
}

@page "/expenses"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosExpenseClient Expenses
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
    var canManage = Capabilities.IsAllowed(UtangCapability.ManageExpenses);
<div class="pos-expenses">
    <Page>
        <header class="pos-expenses__header">
            <h1 class="pos-expenses__title">@L["Expenses_Title"]</h1>
            <p class="pos-expenses__subtitle">@L["Expenses_Subtitle"]</p>
        </header>

        @if (_isOffline)
        {
            <Alert Tone="AlertTone.Warning" Title="@L["Expenses_OfflineTitle"]" Message="@L["Expenses_OfflineMessage"]" />
        }

        <div class="pos-action-grid pos-action-grid--three pos-expenses__actions" role="group" aria-label="@L["Expenses_Title"]">
            <button type="button"
                    class="pos-action-tile pos-action-tile--primary"
                    disabled="@(!canManage || _isOffline)"
                    @onclick="GoNew">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("plus")</span>
                <span class="pos-action-tile__label">@L["Expenses_New"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    @onclick="GoCategories">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("menu")</span>
                <span class="pos-action-tile__label">@L["Expenses_OpenCategories"]</span>
            </button>
            <button type="button"
                    class="pos-action-tile"
                    @onclick="GoSummary">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                <span class="pos-action-tile__label">@L["Expenses_OpenSummary"]</span>
            </button>
        </div>

        <div class="pos-expenses__toolbar">
            <div class="pos-expenses__search">
                <span class="pos-expenses__search-icon" aria-hidden="true">@IconGlyphs.Get("search")</span>
                <input class="pos-expenses__search-input"
                       type="search"
                       value="@_expenseNumber"
                       placeholder="@L["Expenses_SearchPlaceholder"]"
                       disabled="@(_loading || _isOffline)"
                       @oninput="OnSearchInputAsync" />
            </div>
            <button type="button"
                    class="pos-expenses__toolbar-btn"
                    disabled="@(_loading || _isOffline)"
                    title="@L["Expenses_Refresh"]"
                    @onclick="ReloadAsync">
                <span class="pos-expenses__toolbar-icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span class="pos-expenses__toolbar-label">@L["Expenses_Refresh"]</span>
            </button>
            <button type="button"
                    class="pos-expenses__toolbar-btn @(_filtersOpen ? "pos-expenses__toolbar-btn--open" : null)"
                    aria-expanded="@_filtersOpen"
                    aria-controls="expenses-filters"
                    title="@L["Expenses_FiltersTitle"]"
                    @onclick="ToggleFilters">
                <span class="pos-expenses__toolbar-icon" aria-hidden="true">@IconGlyphs.Get("menu")</span>
                <span class="pos-expenses__toolbar-label">@L["Expenses_FiltersTitle"]</span>
            </button>
        </div>

        @if (_filtersOpen)
        {
            <section class="pos-expenses__panel" id="expenses-filters" aria-labelledby="expenses-filters-heading">
                <h2 id="expenses-filters-heading" class="pos-expenses__section-title">@L["Expenses_FiltersTitle"]</h2>
                <div class="pos-expenses__form">
                    <Select Label="@L["Expenses_Filter_Status"]"
                            Value="@_statusFilter"
                            ValueChanged="OnStatusFilterChanged"
                            Options="@ExpensesUiOptions.StatusFilters(L)"
                            Disabled="@(_loading || _isOffline)" />
                    <Select Label="@L["Expenses_Filter_Payment"]"
                            Value="@_paymentFilter"
                            ValueChanged="OnPaymentFilterChanged"
                            Options="@ExpensesUiOptions.PaymentMethodFilters(L)"
                            Disabled="@(_loading || _isOffline)" />
                    <DateInput Label="@L["Expenses_Filter_FromDate"]"
                               Value="@_fromDate"
                               ValueChanged="OnFromDateChanged"
                               Disabled="@(_loading || _isOffline)" />
                    <DateInput Label="@L["Expenses_Filter_ToDate"]"
                               Value="@_toDate"
                               ValueChanged="OnToDateChanged"
                               Disabled="@(_loading || _isOffline)" />
                </div>
            </section>
        }

        <section class="pos-expenses__panel" aria-labelledby="expenses-list-heading">
            <h2 id="expenses-list-heading" class="pos-expenses__section-title">@L["Expenses_ListSection"]</h2>
            @if (_loading)
            {
                <div class="pos-expenses__loading"><Spinner /><span>@L["Expenses_Loading"]</span></div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <ErrorState Title="@(_errorTitle ?? L["Expenses_Title"])"
                            Message="@_errorMessage"
                            RetryLabel="@L["Api_Retry"]"
                            OnRetry="ReloadAsync" />
            }
            else if (_items.Count == 0)
            {
                <EmptyState IconName="inbox"
                            Title="@L["Expenses_EmptyTitle"]"
                            Message="@L["Expenses_EmptyMessage"]" />
            }
            else
            {
                <div class="pos-expenses__list" role="list" aria-label="@L["Expenses_Title"]">
                    @foreach (var item in _items)
                    {
                        <a class="pos-expenses__row @(item.Status == PosExpenseOptions.VoidedStatus ? "pos-expenses__row--voided" : null)"
                           role="listitem"
                           href="@($"/expenses/{item.ExpenseId:D}")">
                            <div class="pos-expenses__row-main">
                                <div class="pos-expenses__row-top">
                                    <span class="pos-expenses__row-name">@item.ExpenseNumber</span>
                                    <Badge Tone="@(item.Status == PosExpenseOptions.RecordedStatus ? BadgeTone.Success : BadgeTone.Neutral)">
                                        @ExpensesUiOptions.StatusLabel(L, item.Status)
                                    </Badge>
                                </div>
                                <span class="pos-expenses__row-meta">
                                    @item.ExpenseDate.ToString("d")
                                    · @(string.IsNullOrWhiteSpace(item.CategoryName) ? "—" : item.CategoryName)
                                    · @ExpensesUiOptions.PaymentMethodLabel(L, item.PaymentMethod)
                                </span>
                            </div>
                            <span class="pos-expenses__row-amount">
                                <MoneyDisplay Amount="@item.Amount" CurrencyCode="PHP" />
                            </span>
                        </a>
                    }
                </div>
            }
        </section>

        @if (!_loading && _totalCount > 0)
        {
            <Pagination Page="@_page" PageSize="@_pageSize" TotalCount="@_totalCount" PageChanged="OnPageChanged" />
        }
    </Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private bool _filtersOpen;
    private string? _expenseNumber;
    private string? _statusFilter;
    private string? _paymentFilter;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private IReadOnlyList<PosExpenseDto> _items = Array.Empty<PosExpenseDto>();
    private string? _errorTitle;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewExpenses))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private void ToggleFilters() => _filtersOpen = !_filtersOpen;

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _expenseNumber = e.Value?.ToString();
        _page = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
            // Newer keystroke superseded this search.
        }
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPaymentFilterChanged(string? value)
    {
        _paymentFilter = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnFromDateChanged(DateOnly? value)
    {
        _fromDate = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnToDateChanged(DateOnly? value)
    {
        _toDate = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _items = Array.Empty<PosExpenseDto>();
            _totalCount = 0;
            _errorTitle = L["Expenses_OfflineTitle"];
            _errorMessage = L["Expenses_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Expenses.ListExpensesAsync(
            string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
            string.IsNullOrWhiteSpace(_paymentFilter) ? null : _paymentFilter,
            categoryId: null,
            _fromDate,
            _toDate,
            _expenseNumber,
            _page,
            _pageSize);

        if (result.IsSuccess && result.Data is not null)
        {
            _items = result.Data.Items;
            _totalCount = result.Data.TotalCount;
        }
        else
        {
            _items = Array.Empty<PosExpenseDto>();
            _totalCount = 0;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private void GoNew() => Nav.NavigateTo("/expenses/new");
    private void GoCategories() => Nav.NavigateTo("/expenses/categories");
    private void GoSummary() => Nav.NavigateTo("/expenses/summary");
}

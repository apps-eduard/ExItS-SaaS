@page "/expenses/{ExpenseId:guid}"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosExpenseClient Expenses
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/expenses" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else if (_loading)
{
    <Page><Spinner /><span>@L["Expenses_Loading"]</span></Page>
}
else if (_expense is null)
{
    <Page>
        <ErrorState Title="@(_errorTitle ?? L["Expenses_NotFoundTitle"])"
                    Message="@(_errorMessage ?? L["Expenses_NotFoundMessage"])"
                    RetryLabel="@L["Api_Retry"]"
                    OnRetry="LoadAsync" />
    </Page>
}
else
{
    var expense = _expense;
    var isRecorded = expense.Status == PosExpenseOptions.RecordedStatus;
    var canVoid = Capabilities.IsAllowed(UtangCapability.ManageExpenses)
        && isRecorded
        && !_isOffline;
<div class="pos-expense-detail">
<Page>
    <header class="pos-expense-detail__header">
        <h1 class="pos-expense-detail__title">@expense.ExpenseNumber</h1>
        <p class="pos-expense-detail__subtitle">@L["Expenses_DetailTitle"]</p>
        <div class="pos-expense-detail__status-row">
            <Badge Tone="@(isRecorded ? BadgeTone.Success : BadgeTone.Neutral)">@ExpensesUiOptions.StatusLabel(L, expense.Status)</Badge>
        </div>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Expenses_OfflineTitle"]" Message="@L["Expenses_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_banner))
    {
        <Alert Tone="AlertTone.Success" Title="@L["Expenses_SuccessTitle"]" Message="@_banner" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Expenses_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-expense-detail__panel" aria-labelledby="expense-detail-heading">
        <h2 id="expense-detail-heading" class="pos-expense-detail__section-title">@L["Expenses_DetailSection"]</h2>
        <div class="pos-expense-detail__amount">
            <span class="pos-expense-detail__amount-label">@L["Expenses_Amount"]</span>
            <div class="pos-expense-detail__amount-value">
                <MoneyDisplay Amount="@expense.Amount" CurrencyCode="PHP" Emphasized="true" />
            </div>
        </div>
        <dl class="pos-expense-detail__facts">
            <div class="pos-expense-detail__fact">
                <dt>@L["Expenses_ExpenseDate"]</dt>
                <dd>@expense.ExpenseDate.ToString("d")</dd>
            </div>
            <div class="pos-expense-detail__fact">
                <dt>@L["Expenses_Category"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(expense.CategoryName) ? L["Customers_NoValue"] : expense.CategoryName)</dd>
            </div>
            <div class="pos-expense-detail__fact">
                <dt>@L["Expenses_Payment"]</dt>
                <dd>@ExpensesUiOptions.PaymentMethodLabel(L, expense.PaymentMethod)</dd>
            </div>
            <div class="pos-expense-detail__fact">
                <dt>@L["Expenses_Description"]</dt>
                <dd class="pos-wrap">@expense.Description</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(expense.Payee))
            {
                <div class="pos-expense-detail__fact">
                    <dt>@L["Expenses_Payee"]</dt>
                    <dd class="pos-wrap">@expense.Payee</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(expense.GCashReference))
            {
                <div class="pos-expense-detail__fact">
                    <dt>@L["Expenses_GCashReference"]</dt>
                    <dd class="pos-wrap">@expense.GCashReference</dd>
                </div>
                <p class="pos-expense-detail__note">@L["Expenses_GCash_ManualWarning"]</p>
            }
            <div class="pos-expense-detail__fact">
                <dt>@L["Expenses_RecordedAt"]</dt>
                <dd>@expense.RecordedAtUtc.ToLocalTime().ToString("g")</dd>
            </div>
            @if (!isRecorded)
            {
                <div class="pos-expense-detail__fact">
                    <dt>@L["Expenses_VoidReason"]</dt>
                    <dd class="pos-wrap">@expense.VoidReason</dd>
                </div>
                <div class="pos-expense-detail__fact">
                    <dt>@L["Expenses_VoidedAt"]</dt>
                    <dd>@(expense.VoidedAtUtc?.ToLocalTime().ToString("g") ?? L["Customers_NoValue"])</dd>
                </div>
            }
        </dl>
    </section>

    @if (isRecorded)
    {
        <div class="pos-action-grid pos-action-grid--single pos-expense-detail__actions" role="group">
            <button type="button"
                    class="pos-action-tile"
                    disabled="@(!canVoid)"
                    @onclick="() => _confirmVoid = true">
                <span class="pos-action-tile__icon" aria-hidden="true">@IconGlyphs.Get("warning")</span>
                <span class="pos-action-tile__label">@L["Expenses_Void"]</span>
            </button>
        </div>
    }

    <ConfirmDialog Visible="@_confirmVoid"
                   VisibleChanged="v => _confirmVoid = v"
                   Title="@L["Expenses_VoidTitle"]"
                   Message="@L["Expenses_VoidMessage"]"
                   Danger="true"
                   ShowReason="true"
                   Reason="@_voidReason"
                   ReasonChanged="v => _voidReason = v"
                   ReasonLabel="@L["Expenses_VoidReason"]"
                   ConfirmLabel="@L["Expenses_Void"]"
                   IsLoading="@_acting"
                   OnConfirm="VoidAsync" />
</Page>
</div>
}

@code {
    [Parameter] public Guid ExpenseId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private bool _acting;
    private bool _confirmVoid;
    private bool _isOffline;
    private PosExpenseDto? _expense;
    private string? _voidReason;
    private string? _errorTitle;
    private string? _errorMessage;
    private string? _banner;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewExpenses))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _expense = null;
            _errorTitle = L["Expenses_OfflineTitle"];
            _errorMessage = L["Expenses_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Expenses.GetExpenseAsync(ExpenseId);
        if (result.IsSuccess && result.Data is not null)
        {
            _expense = result.Data;
        }
        else
        {
            _expense = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }

    private async Task VoidAsync()
    {
        if (string.IsNullOrWhiteSpace(_voidReason))
        {
            return;
        }

        _acting = true;
        _errorTitle = null;
        _errorMessage = null;
        var result = await Expenses.VoidExpenseAsync(ExpenseId, new VoidExpenseRequest(_voidReason!));
        _acting = false;
        _confirmVoid = false;

        if (result.IsSuccess && result.Data is not null)
        {
            _expense = result.Data;
            _voidReason = null;
            _banner = L["Expenses_VoidedSuccess"];
            return;
        }

        var described = ApiLocalizer.Describe(result.Status, result.Error);
        _errorTitle = described.Title;
        _errorMessage = result.Error?.Detail ?? described.Message;
    }
}

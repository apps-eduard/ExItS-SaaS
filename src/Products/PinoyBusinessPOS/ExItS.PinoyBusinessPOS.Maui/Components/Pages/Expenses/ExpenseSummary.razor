@page "/expenses/summary"
@using ExItS.DesignSystem.Components.Internal
@inject NavigationManager Nav
@inject NavigationGate Gate
@inject IPosExpenseClient Expenses
@inject IUtangCapabilityEvaluator Capabilities
@inject ApiStatusLocalizer ApiLocalizer
@inject IConnectivityService Connectivity
@inject IStringLocalizer<PosResources> L

<StoreHeaderBack Href="/expenses" />

@if (!_ready)
{
    <Page><Spinner /></Page>
}
else
{
<div class="pos-expense-summary">
<Page>
    <header class="pos-expense-summary__header">
        <div class="pos-expense-summary__title-row">
            <h1 class="pos-expense-summary__title">@L["Expenses_SummaryTitle"]</h1>
            <button type="button"
                    class="pos-expense-summary__refresh"
                    disabled="@_loading"
                    @onclick="ReloadAsync">
                <span class="pos-expense-summary__refresh-icon" aria-hidden="true">@IconGlyphs.Get("refresh")</span>
                <span>@L["Expenses_Refresh"]</span>
            </button>
        </div>
        <p class="pos-expense-summary__subtitle">@L["Expenses_SummarySubtitle"]</p>
    </header>

    @if (_isOffline)
    {
        <Alert Tone="AlertTone.Warning" Title="@L["Expenses_OfflineTitle"]" Message="@L["Expenses_OfflineMessage"]" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <Alert Tone="AlertTone.Danger" Title="@(_errorTitle ?? L["Expenses_ErrorTitle"])" Message="@_errorMessage" />
    }

    <section class="pos-expense-summary__panel" aria-labelledby="expense-summary-filters-heading">
        <h2 id="expense-summary-filters-heading" class="pos-expense-summary__section-title">@L["Expenses_FiltersTitle"]</h2>
        <div class="pos-expense-summary__form">
            <DateInput Label="@L["Expenses_Filter_FromDate"]"
                       Value="@_fromDate"
                       ValueChanged="OnFromDateChanged" />
            <DateInput Label="@L["Expenses_Filter_ToDate"]"
                       Value="@_toDate"
                       ValueChanged="OnToDateChanged" />
        </div>
    </section>

    @if (_summary is not null)
    {
        <section class="pos-expense-summary__panel" aria-labelledby="expense-summary-totals-heading">
            <h2 id="expense-summary-totals-heading" class="pos-expense-summary__section-title">@L["Expenses_SummaryTotals"]</h2>
            <div class="pos-expense-summary__balance">
                <span class="pos-expense-summary__balance-label">@L["Expenses_NetTotal"]</span>
                <div class="pos-expense-summary__balance-value">
                    <MoneyDisplay Amount="@_summary.NetTotal" CurrencyCode="PHP" Emphasized="true" />
                </div>
            </div>
            <div class="pos-expense-summary__stats" role="list">
                <div class="pos-expense-summary__stat" role="listitem">
                    <span class="pos-expense-summary__stat-label">@L["Expenses_GrossTotal"]</span>
                    <span class="pos-expense-summary__stat-value"><MoneyDisplay Amount="@_summary.GrossTotal" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-expense-summary__stat" role="listitem">
                    <span class="pos-expense-summary__stat-label">@L["Expenses_VoidedTotal"]</span>
                    <span class="pos-expense-summary__stat-value"><MoneyDisplay Amount="@_summary.VoidedTotal" CurrencyCode="PHP" /></span>
                </div>
                <div class="pos-expense-summary__stat" role="listitem">
                    <span class="pos-expense-summary__stat-label">@L["Expenses_RecordedCount"]</span>
                    <span class="pos-expense-summary__stat-value">@_summary.RecordedCount</span>
                </div>
                <div class="pos-expense-summary__stat" role="listitem">
                    <span class="pos-expense-summary__stat-label">@L["Expenses_VoidedCount"]</span>
                    <span class="pos-expense-summary__stat-value">@_summary.VoidedCount</span>
                </div>
            </div>
        </section>

        <section class="pos-expense-summary__panel" aria-labelledby="expense-summary-category-heading">
            <h2 id="expense-summary-category-heading" class="pos-expense-summary__section-title">@L["Expenses_SummaryByCategory"]</h2>
            @if (_summary.ByCategory.Count == 0)
            {
                <EmptyState IconName="inbox" Title="@L["Expenses_SummaryEmptyTitle"]" Message="@L["Expenses_SummaryEmptyMessage"]" />
            }
            else
            {
                <div class="pos-expense-summary__list" role="list">
                    @foreach (var row in _summary.ByCategory)
                    {
                        <article class="pos-expense-summary__entry" role="listitem">
                            <div class="pos-expense-summary__entry-top">
                                <span class="pos-expense-summary__entry-name">@(string.IsNullOrWhiteSpace(row.CategoryName) ? L["Customers_NoValue"] : row.CategoryName)</span>
                                <span class="pos-expense-summary__entry-amount"><MoneyDisplay Amount="@row.TotalAmount" CurrencyCode="PHP" /></span>
                            </div>
                            <p class="pos-expense-summary__entry-meta">@row.Count</p>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="pos-expense-summary__panel" aria-labelledby="expense-summary-payment-heading">
            <h2 id="expense-summary-payment-heading" class="pos-expense-summary__section-title">@L["Expenses_SummaryByPayment"]</h2>
            @if (_summary.ByPaymentMethod.Count == 0)
            {
                <EmptyState IconName="inbox" Title="@L["Expenses_SummaryEmptyTitle"]" Message="@L["Expenses_SummaryEmptyMessage"]" />
            }
            else
            {
                <div class="pos-expense-summary__list" role="list">
                    @foreach (var row in _summary.ByPaymentMethod)
                    {
                        <article class="pos-expense-summary__entry" role="listitem">
                            <div class="pos-expense-summary__entry-top">
                                <span class="pos-expense-summary__entry-name">@ExpensesUiOptions.PaymentMethodLabel(L, row.PaymentMethod)</span>
                                <span class="pos-expense-summary__entry-amount"><MoneyDisplay Amount="@row.TotalAmount" CurrencyCode="PHP" /></span>
                            </div>
                            <p class="pos-expense-summary__entry-meta">@row.Count</p>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else if (_loading)
    {
        <div class="pos-expense-summary__loading"><Spinner /><span>@L["Expenses_Loading"]</span></div>
    }
</Page>
</div>
}

@code {
    private bool _ready;
    private bool _loading;
    private bool _isOffline;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private PosExpenseSummaryDto? _summary;
    private string? _errorTitle;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!Gate.CanEnterProtectedShell)
        {
            Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
            return;
        }

        if (!Capabilities.IsAllowed(UtangCapability.ViewExpenses))
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _ready = true;
        await ReloadAsync();
    }

    private async Task OnFromDateChanged(DateOnly? value)
    {
        _fromDate = value;
        await ReloadAsync();
    }

    private async Task OnToDateChanged(DateOnly? value)
    {
        _toDate = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorTitle = null;
        _errorMessage = null;
        StateHasChanged();

        _isOffline = !await Connectivity.IsConnectedAsync();
        if (_isOffline)
        {
            _summary = null;
            _errorTitle = L["Expenses_OfflineTitle"];
            _errorMessage = L["Expenses_OfflineMessage"];
            _loading = false;
            return;
        }

        var result = await Expenses.GetSummaryAsync(_fromDate, _toDate);
        if (result.IsSuccess && result.Data is not null)
        {
            _summary = result.Data;
        }
        else
        {
            _summary = null;
            var described = ApiLocalizer.Describe(result.Status, result.Error);
            _errorTitle = described.Title;
            _errorMessage = result.Error?.Detail ?? described.Message;
        }

        _loading = false;
    }
}

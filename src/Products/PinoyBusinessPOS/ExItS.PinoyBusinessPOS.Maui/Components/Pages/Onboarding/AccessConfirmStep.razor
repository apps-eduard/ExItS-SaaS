@page "/onboarding/access-confirm"
@layout Layout.AuthShell
@inject ICurrentUserContext CurrentUser
@inject IOnboardingPreferenceStore Prefs
@inject IAuthenticationService Auth
@inject NavigationGate Gate
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<div class="pos-onboarding">
<Page>
    <header class="pos-onboarding__header">
        <h1 class="pos-onboarding__title">@L["AccessConfirm_Title"]</h1>
        <p class="pos-onboarding__subtitle">@L["AccessConfirm_Subtitle"]</p>
    </header>

    @if (CurrentUser.Session is null || !CurrentUser.HasPosAccess)
    {
        <ErrorState Title="@L["Access_DeniedTitle"]" Message="@L["Access_Denied"]" RetryLabel="@L["OrgSelect_Title"]" OnRetry="GoOrgSelect" />
    }
    else
    {
        <Card Elevated="true">
            <Stack Gap="2">
                <span class="pos-muted">@L["AccessConfirm_UserLabel"]</span>
                <span class="pos-value-md">@CurrentUser.Session.DisplayName</span>
                <span class="pos-muted">@L["AccessConfirm_OrgLabel"]</span>
                <span class="pos-value-md">@CurrentUser.Session.OrganizationDisplayName</span>
                <Badge Tone="BadgeTone.Success">@L["AccessConfirm_Allowed"]</Badge>
            </Stack>
        </Card>
        <Alert Tone="AlertTone.Info" Title="@L["AccessConfirm_RoleBoundaryTitle"]" Message="@L["AccessConfirm_RoleBoundaryMessage"]" />
        <FormActions>
            <Button OnClick="EnterAsync">@L["AccessConfirm_Enter"]</Button>
        </FormActions>
    }
</Page>
</div>

@code {
    private void GoOrgSelect() => Nav.NavigateTo("/organization-select");

    private async Task EnterAsync()
    {
        await Prefs.SetOnboardingCompletedAsync(true);
        await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.Complete));
        Nav.NavigateTo(await Gate.ResolveStartRouteAsync(), replace: true);
    }
}

@page "/onboarding/density"
@layout Layout.AuthShell
@inject IOnboardingPreferenceStore Prefs
@inject NavigationManager Nav

@* Preference wizard removed — Compact is the default; density remains in Settings. *@

@code {
    protected override async Task OnInitializedAsync()
    {
        await Prefs.SetOnboardingStepAsync(nameof(OnboardingStep.SignIn));
        Nav.NavigateTo("/signin", replace: true);
    }
}

@page "/reconnect"
@inject IStringLocalizer<PosResources> L
@inject NavigationGate Gate
@inject IAuthenticationService Auth
@inject IPosSyncStatusService SyncStatus
@inject NavigationManager Nav
@inject IProtectedShellAccessPolicy AccessPolicy
@inject ICustomerCreditOfflineSyncService Sync

<div class="pos-reconnect">
<Page>
    <header class="pos-reconnect__header">
        <h1 class="pos-reconnect__title">@L["SyncStatus_ReconnectTitle"]</h1>
        <p class="pos-reconnect__subtitle">@L["SyncStatus_ReconnectMessage"]</p>
    </header>
    <Alert Tone="AlertTone.Warning" Title="@L["SyncStatus_Reconnect"]" Message="@L["SyncStatus_ReconnectMessage"]" />
    @if (_canOfflinePin)
    {
        <InlineMessage Tone="InlineMessageTone.Info">@L["Offline_PinAvailableHint"]</InlineMessage>
    }
    <FormActions>
        <Button OnClick="RetryAsync" Disabled="_busy">@L["Common_Retry"]</Button>
        @if (_canOfflinePin)
        {
            <Button Variant="ButtonVariant.Secondary" Disabled="_busy" OnClick="GoOfflinePin">
                @L["Offline_PinUnlock"]
            </Button>
        }
        <Button Variant="ButtonVariant.Ghost" OnClick="SignOutAsync" Disabled="_busy">@L["Auth_Logout"]</Button>
    </FormActions>
</Page>
</div>

@code {
    private bool _busy;
    private bool _canOfflinePin;

    protected override async Task OnInitializedAsync()
    {
        await AccessPolicy.InitializeAsync();
        var offer = await Auth.EvaluateOfflineColdStartOfferAsync();
        _canOfflinePin = offer.CanOfferPinUnlock;
        SyncStatus.SetReconnectRequired(!_canOfflinePin);
        SyncStatus.Refresh();
    }

    private void GoOfflinePin() => Nav.NavigateTo("/offline-pin", replace: true);

    private async Task RetryAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await AccessPolicy.InitializeAsync();
            var route = await Gate.ResolveStartRouteAsync();
            if (!string.Equals(route, "/reconnect", StringComparison.Ordinal))
            {
                await Sync.ReconcileOnReconnectAsync();
                SyncStatus.SetReconnectRequired(false);
                Nav.NavigateTo(route);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();
        SyncStatus.SetReconnectRequired(false);
        Nav.NavigateTo("/signin");
    }
}

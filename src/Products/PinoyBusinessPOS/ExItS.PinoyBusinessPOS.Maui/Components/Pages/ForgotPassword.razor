@page "/forgot-password"
@layout Layout.AuthShell
@using ExItS.DesignSystem.Components.Primitives
@using ExItS.PinoyBusinessPOS.Application.Options
@using Microsoft.Extensions.Options
@inject IPlatformAccessClient Platform
@inject NavigationManager Nav
@inject IOptions<LocalValidationClientOptions> LocalValidationOptions
@inject IStringLocalizer<PosResources> L

<AuthExperience Title="@L["ForgotPassword_Title"]" Lede="@L["ForgotPassword_Subtitle"]">
    <FormValidationSummary Messages="_errors" />
    <LocalValidationMailpitHint />
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <InlineMessage Tone="InlineMessageTone.Info">@_message</InlineMessage>
        <LocalValidationMailpitHint />
        @if (!string.IsNullOrWhiteSpace(_debugToken))
        {
            <div class="pos-signin__submit">
                <Button Variant="ButtonVariant.Primary" OnClick="GoReset">@L["Activate_Continue"]</Button>
            </div>
        }
        else if (LocalValidationOptions.Value.Enabled)
        {
            <div class="pos-signin__submit">
                <Button Variant="ButtonVariant.Secondary" OnClick="GoReset">Continue to reset</Button>
            </div>
        }
    }

    <div class="pos-signin__form">
        <TextInput Label="@L["SignIn_UsernameLabel"]"
                   @bind-Value="_usernameOrEmail"
                   Disabled="_busy"
                   autocomplete="username" />
        <div class="pos-signin__submit">
            <Button IsLoading="_busy" Disabled="_busy" OnClick="SubmitAsync">
                @L["ForgotPassword_Submit"]
            </Button>
        </div>
        <p class="pos-signin__create">
            <button type="button" class="pos-signin__link" disabled="@_busy" @onclick="GoSignIn">
                @L["ForgotPassword_Back"]
            </button>
        </p>
    </div>
</AuthExperience>

@code {
    private string? _usernameOrEmail;
    private string? _message;
    private string? _debugToken;
    private bool _busy;
    private List<string> _errors = [];

    private async Task SubmitAsync()
    {
        _errors = [];
        _message = null;
        _debugToken = null;
        if (string.IsNullOrWhiteSpace(_usernameOrEmail))
        {
            _errors.Add(L["ForgotPassword_Required"]);
            return;
        }

        _busy = true;
        try
        {
            var result = await Platform.ForgotPasswordAsync(
                new ForgotPasswordRequest(_usernameOrEmail.Trim()));
            if (!result.IsSuccess)
            {
                var detail = result.Error?.Detail ?? result.Error?.Title;
                _errors.Add(string.IsNullOrWhiteSpace(detail) ? L["ForgotPassword_Failed"] : detail);
                return;
            }

            _message = string.IsNullOrWhiteSpace(result.Data?.Message)
                ? L["ForgotPassword_Success"].Value
                : result.Data.Message;
            _debugToken = result.Data?.DebugToken;

            // Local Validation: offer in-app reset when debug token is present; otherwise stay here
            // with Mailpit + Blazor :8190 guidance (never React :8095).
            if (LocalValidationOptions.Value.Enabled && string.IsNullOrWhiteSpace(_debugToken))
            {
                _message = $"{_message} Open MAUI Mailpit, then use Blazor Admin :8190 (or paste the token on Reset password).";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoReset() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(_debugToken)
            ? "/reset-password"
            : $"/reset-password?token={Uri.EscapeDataString(_debugToken)}");

    private void GoSignIn() => Nav.NavigateTo("/signin");
}

@page "/not-found"
@layout ExItS.PinoyBusinessPOS.Maui.Components.Layout.PosShell
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

<Page>
    <PageHeader Title="@L["NotFound_Title"]" Subtitle="@L["NotFound_Message"]" />
    <Button Variant="ButtonVariant.Secondary" OnClick="GoHome">@L["NotFound_BackToHome"]</Button>
</Page>

@code {
    private void GoHome() => Nav.NavigateTo("/home");
}

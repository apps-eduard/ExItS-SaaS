@implements IDisposable
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<PosResources> L

@if (ShowOrganization)
{
    <div class="pos-topbar__brand" title="@OrgDisplayName">
        <Avatar Name="@OrgDisplayName"
                ImageUrl="@_organizationLogoUrl"
                Size="AvatarSize.Sm"
                Shape="AvatarShape.SoftSquare"
                AriaLabel="@OrgAriaLabel" />
        <div class="pos-topbar__titles">
            <span class="pos-topbar__title">@OrgDisplayName</span>
        </div>
    </div>
}

@code {
    /// <summary>
    /// When set, use this organization instead of the session's active organization
    /// (e.g. preview on organization-select before bind).
    /// </summary>
    [Parameter] public Guid? OrganizationIdOverride { get; set; }

    [Parameter] public string? OrganizationNameOverride { get; set; }

    private Guid? _logoOrgId;
    private string? _organizationLogoUrl;
    private bool _logoResolved;
    private CancellationTokenSource? _logoCts;

    private AuthSession? Session => CurrentUser.Session;

    private bool ShowOrganization =>
        EffectiveOrganizationId is not null
        || !string.IsNullOrWhiteSpace(OrganizationNameOverride)
        || !string.IsNullOrWhiteSpace(Session?.OrganizationDisplayName);

    private Guid? EffectiveOrganizationId =>
        OrganizationIdOverride ?? Session?.OrganizationId;

    private string OrgDisplayName
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(OrganizationNameOverride))
            {
                return OrganizationNameOverride.Trim();
            }

            var orgName = Session?.OrganizationDisplayName;
            if (!string.IsNullOrWhiteSpace(orgName))
            {
                return orgName.Trim();
            }

            return L["Shell_OrganizationFallback"].Value;
        }
    }

    private string OrgAriaLabel =>
        string.Format(L["Shell_OrganizationAria"].Value, OrgDisplayName);

    protected override void OnInitialized()
    {
        CurrentUser.Changed += OnSessionChangedAsync;
        _ = RefreshOrganizationLogoAsync();
    }

    protected override void OnParametersSet()
    {
        _ = RefreshOrganizationLogoAsync();
    }

    private Task OnSessionChangedAsync()
    {
        _ = RefreshOrganizationLogoAsync();
        return InvokeAsync(StateHasChanged);
    }

    private async Task RefreshOrganizationLogoAsync()
    {
        var orgId = EffectiveOrganizationId;
        if (orgId is null)
        {
            ClearLogoState();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_logoOrgId == orgId && _logoResolved)
        {
            return;
        }

        if (_logoOrgId != orgId)
        {
            _organizationLogoUrl = null;
            _logoResolved = false;
            _logoOrgId = orgId;
        }

        _logoCts?.Cancel();
        _logoCts?.Dispose();
        _logoCts = new CancellationTokenSource();
        var ct = _logoCts.Token;

        try
        {
            var result = await Platform.GetOrganizationAsync(orgId.Value, ct);
            if (ct.IsCancellationRequested || EffectiveOrganizationId != orgId)
            {
                return;
            }

            if (result.IsSuccess && result.Data is not null)
            {
                var logo = result.Data.Branding?.LogoUrl;
                _organizationLogoUrl = string.IsNullOrWhiteSpace(logo) ? null : logo.Trim();
            }
            else
            {
                _organizationLogoUrl = null;
            }

            _logoResolved = true;
        }
        catch (OperationCanceledException)
        {
            // superseded
        }
        catch
        {
            _organizationLogoUrl = null;
            _logoResolved = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ClearLogoState()
    {
        _logoOrgId = null;
        _organizationLogoUrl = null;
        _logoResolved = false;
        _logoCts?.Cancel();
        _logoCts?.Dispose();
        _logoCts = null;
    }

    public void Dispose()
    {
        CurrentUser.Changed -= OnSessionChangedAsync;
        ClearLogoState();
    }
}

@implements IDisposable
@inject ICurrentUserContext CurrentUser
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<PosResources> L

@if (ShowOrganization)
{
    <button type="button"
            class="pos-topbar__brand pos-topbar__brand--switch"
            title="@OrgDisplayName"
            aria-label="@BranchAriaLabel"
            @onclick="OpenBranchSheetAsync">
        <Avatar Name="@OrgDisplayName"
                ImageUrl="@_organizationLogoUrl"
                Size="AvatarSize.Sm"
                Shape="AvatarShape.SoftSquare"
                AriaLabel="@OrgAriaLabel" />
        <div class="pos-topbar__titles">
            <span class="pos-topbar__title">@OrgDisplayName</span>
            @if (!string.IsNullOrWhiteSpace(BranchDisplayName))
            {
                <span class="pos-topbar__subtitle pos-topbar__subtitle--visible">@BranchDisplayName ▼</span>
            }
        </div>
    </button>
    <ShellBranchSwitcher @ref="_switcher" OnChanged="OnBranchChangedAsync" />
}

@code {
    /// <summary>
    /// When set, use this organization instead of the session's active organization
    /// (e.g. preview on organization-select before bind).
    /// </summary>
    [Parameter] public Guid? OrganizationIdOverride { get; set; }

    [Parameter] public string? OrganizationNameOverride { get; set; }

    private Guid? _logoOrgId;
    private string? _organizationLogoUrl;
    private bool _logoResolved;
    private bool _logoInFlight;
    private CancellationTokenSource? _logoCts;
    private ShellBranchSwitcher? _switcher;
    private string? _branchName;
    private Guid? _namedBranchId;

    private AuthSession? Session => CurrentUser.Session;

    private bool ShowOrganization =>
        EffectiveOrganizationId is not null
        || !string.IsNullOrWhiteSpace(OrganizationNameOverride)
        || !string.IsNullOrWhiteSpace(Session?.OrganizationDisplayName);

    private Guid? EffectiveOrganizationId =>
        OrganizationIdOverride ?? Session?.OrganizationId;

    private string OrgDisplayName
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(OrganizationNameOverride))
            {
                return OrganizationNameOverride.Trim();
            }

            var orgName = Session?.OrganizationDisplayName;
            if (!string.IsNullOrWhiteSpace(orgName))
            {
                return orgName.Trim();
            }

            return L["Shell_OrganizationFallback"].Value;
        }
    }

    private string OrgAriaLabel =>
        string.Format(L["Shell_OrganizationAria"].Value, OrgDisplayName);

    private Guid? SelectedBranchId => AuthSessionBranchContext.GetSelectedBranchId(Session);

    private string BranchDisplayName
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_branchName) && _namedBranchId == SelectedBranchId)
            {
                return _branchName;
            }

            return SelectedBranchId is null ? string.Empty : L["BranchContext_Fallback"].Value;
        }
    }

    private string BranchAriaLabel =>
        string.IsNullOrWhiteSpace(BranchDisplayName)
            ? OrgAriaLabel
            : string.Format(L["BranchContext_HeaderAria"].Value, OrgDisplayName, BranchDisplayName);

    protected override void OnInitialized()
    {
        CurrentUser.Changed += OnSessionChangedAsync;
        _ = RefreshOrganizationLogoAsync();
        _ = RefreshBranchNameAsync();
    }

    protected override void OnParametersSet()
    {
        _ = RefreshOrganizationLogoAsync();
        _ = RefreshBranchNameAsync();
    }

    private Task OnSessionChangedAsync()
    {
        _ = RefreshOrganizationLogoAsync();
        _ = RefreshBranchNameAsync();
        return InvokeAsync(StateHasChanged);
    }

    private async Task OpenBranchSheetAsync()
    {
        if (_switcher is not null)
        {
            await _switcher.OpenAsync();
        }
    }

    private Task OnBranchChangedAsync()
    {
        _namedBranchId = null;
        _branchName = null;
        return RefreshBranchNameAsync();
    }

    private async Task RefreshBranchNameAsync()
    {
        var orgId = EffectiveOrganizationId;
        var branchId = SelectedBranchId;
        if (orgId is null || branchId is null)
        {
            _branchName = null;
            _namedBranchId = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_namedBranchId == branchId && !string.IsNullOrWhiteSpace(_branchName))
        {
            return;
        }

        try
        {
            var result = await Platform.GetBranchesAsync(orgId.Value);
            if (EffectiveOrganizationId != orgId || SelectedBranchId != branchId)
            {
                return;
            }

            var match = result.IsSuccess
                ? result.Data?.FirstOrDefault(b => b.Id == branchId)
                : null;
            _namedBranchId = branchId;
            _branchName = match is null
                ? L["BranchContext_Fallback"].Value
                : match.Name;
        }
        catch
        {
            _namedBranchId = branchId;
            _branchName = L["BranchContext_Fallback"].Value;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshOrganizationLogoAsync()
    {
        var orgId = EffectiveOrganizationId;
        if (orgId is null)
        {
            ClearLogoState();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_logoOrgId == orgId && (_logoResolved || _logoInFlight))
        {
            return;
        }

        if (_logoOrgId != orgId)
        {
            _logoCts?.Cancel();
            _logoCts?.Dispose();
            _organizationLogoUrl = null;
            _logoResolved = false;
            _logoOrgId = orgId;
        }

        _logoCts?.Dispose();
        _logoCts = new CancellationTokenSource();
        var captured = _logoCts;
        var ct = captured.Token;
        _logoInFlight = true;

        try
        {
            var result = await Platform.GetOrganizationAsync(orgId.Value, ct);
            if (ct.IsCancellationRequested || EffectiveOrganizationId != orgId)
            {
                return;
            }

            if (result.IsSuccess && result.Data is not null)
            {
                var logo = result.Data.Branding?.LogoUrl;
                _organizationLogoUrl = string.IsNullOrWhiteSpace(logo) ? null : logo.Trim();
            }
            else
            {
                _organizationLogoUrl = null;
            }

            _logoResolved = true;
        }
        catch (OperationCanceledException)
        {
            // superseded
        }
        catch
        {
            _organizationLogoUrl = null;
            _logoResolved = true;
        }
        finally
        {
            if (ReferenceEquals(_logoCts, captured))
            {
                _logoInFlight = false;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ClearLogoState()
    {
        _logoOrgId = null;
        _organizationLogoUrl = null;
        _logoResolved = false;
        _logoInFlight = false;
        _logoCts?.Cancel();
        _logoCts?.Dispose();
        _logoCts = null;
    }

    public void Dispose()
    {
        CurrentUser.Changed -= OnSessionChangedAsync;
        ClearLogoState();
    }
}

@using ExItS.DesignSystem.Components.Internal

@if (Visible)
{
    <div class="pos-denom-sheet" role="dialog" aria-modal="true" aria-labelledby="pos-denom-sheet-title" @onclick="DismissAsync">
        <div class="pos-denom-sheet__panel" @onclick:stopPropagation="true">
            <header class="pos-denom-sheet__header">
                <div>
                    <h2 id="pos-denom-sheet-title" class="pos-denom-sheet__title">@L["Shifts_DenominationTitle"]</h2>
                    <p class="pos-denom-sheet__hint">@L["Shifts_DenominationHint"]</p>
                </div>
                <IconButton AriaLabel="@L["Shifts_DenominationClose"]" IconName="close" OnClick="DismissAsync" />
            </header>
            <div class="pos-denom-sheet__list">
                @foreach (var row in _rows)
                {
                    var hasQty = row.Quantity > 0;
                    <div class="pos-denom-sheet__item @(hasQty ? "pos-denom-sheet__item--active" : null)">
                        <div class="pos-denom-sheet__item-top">
                            <span class="pos-denom-sheet__value">@FormatDenomination(row.Value)</span>
                            <span class="pos-denom-sheet__line @(hasQty ? null : "pos-denom-sheet__line--empty")">@FormatMoney(row.LineTotal)</span>
                        </div>
                        <div class="pos-denom-sheet__stepper">
                            <button type="button"
                                    class="pos-denom-sheet__step"
                                    disabled="@(row.Quantity <= 0)"
                                    aria-label="@string.Format(L["Shifts_DenominationDecrease"].Value, FormatDenomination(row.Value))"
                                    @onclick="() => Adjust(row.Value, -1)">−</button>
                            <input class="pos-denom-sheet__qty"
                                   type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   autocomplete="off"
                                   value="@row.Quantity"
                                   aria-label="@string.Format(L["Shifts_DenominationQtyLabel"].Value, FormatDenomination(row.Value))"
                                   @oninput="e => OnQuantityChanged(row.Value, e.Value)" />
                            <span class="pos-denom-sheet__pcs">@L["Shifts_DenominationPcs"]</span>
                            <button type="button"
                                    class="pos-denom-sheet__step"
                                    disabled="@(row.Quantity >= MaxQuantity)"
                                    aria-label="@string.Format(L["Shifts_DenominationIncrease"].Value, FormatDenomination(row.Value))"
                                    @onclick="() => Adjust(row.Value, 1)">+</button>
                        </div>
                    </div>
                }
            </div>
            <div class="pos-denom-sheet__bar">
                <div class="pos-denom-sheet__total">
                    <span>@L["Shifts_DenominationCalculatedTotal"]</span>
                    <strong>@FormatMoney(CalculatedTotal)</strong>
                </div>
                <div class="pos-denom-sheet__actions">
                    <Button Variant="ButtonVariant.Secondary"
                            Disabled="@(!HasCount)"
                            OnClick="Reset">@L["Shifts_DenominationReset"]</Button>
                    <Button Variant="ButtonVariant.Primary" OnClick="UseTotalAsync">@L["Shifts_DenominationUseTotal"]</Button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int MaxQuantity = 9999;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public IReadOnlyList<OrganizationCashDenominationDto> Denominations { get; set; } = [];
    [Parameter] public EventCallback<(decimal Total, IReadOnlyList<CashCountDenominationLineDto> Lines)> OnUseTotal { get; set; }
    [Inject] private IStringLocalizer<PosResources> L { get; set; } = default!;

    private List<Row> _rows = [];

    private decimal CalculatedTotal => _rows.Sum(r => r.LineTotal);
    private bool HasCount => _rows.Any(r => r.Quantity > 0);

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            return;
        }

        var enabled = Denominations
            .Where(d => d.IsEnabled)
            .OrderByDescending(d => d.Value)
            .ToList();
        if (_rows.Count == enabled.Count
            && _rows.Zip(enabled, (row, denom) => row.Value == denom.Value).All(x => x))
        {
            return;
        }

        _rows = enabled
            .Select(d => new Row(d.Value, 0))
            .ToList();
    }

    private void Adjust(decimal value, int delta)
    {
        var index = _rows.FindIndex(r => r.Value == value);
        if (index < 0)
        {
            return;
        }

        SetQuantity(index, _rows[index].Quantity + delta);
    }

    private void OnQuantityChanged(decimal value, object? raw)
    {
        var index = _rows.FindIndex(r => r.Value == value);
        if (index < 0)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(raw?.ToString()))
        {
            SetQuantity(index, 0);
            return;
        }

        if (!int.TryParse(raw.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed))
        {
            return;
        }

        SetQuantity(index, parsed);
    }

    private void SetQuantity(int index, int quantity)
    {
        var next = Math.Clamp(quantity, 0, MaxQuantity);
        if (_rows[index].Quantity == next)
        {
            return;
        }

        _rows[index] = new Row(_rows[index].Value, next);
        _rows = _rows.ToList();
    }

    private void Reset()
    {
        _rows = _rows.Select(r => new Row(r.Value, 0)).ToList();
    }

    private async Task UseTotalAsync()
    {
        var lines = _rows
            .Select(r => new CashCountDenominationLineDto(r.Value, r.Quantity, r.LineTotal))
            .ToList();
        await OnUseTotal.InvokeAsync((CalculatedTotal, lines));
        await SetVisibleAsync(false);
    }

    /// <summary>
    /// Closing with a counted total applies it (same as Use total). Empty dismiss cancels.
    /// </summary>
    private Task DismissAsync() => HasCount ? UseTotalAsync() : SetVisibleAsync(false);

    private async Task SetVisibleAsync(bool visible)
    {
        Visible = visible;
        await VisibleChanged.InvokeAsync(visible);
    }

    private static string FormatDenomination(decimal amount) =>
        amount == decimal.Truncate(amount)
            ? amount.ToString("N0", CultureInfo.GetCultureInfo("en-PH"))
            : amount.ToString("N2", CultureInfo.GetCultureInfo("en-PH"));

    private static string FormatMoney(decimal amount) =>
        string.Create(CultureInfo.GetCultureInfo("en-PH"), $"PHP {amount:N2}");

    private sealed record Row(decimal Value, int Quantity)
    {
        public decimal LineTotal => decimal.Round(Value * Quantity, 2, MidpointRounding.AwayFromZero);
    }
}

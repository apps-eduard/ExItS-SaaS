@namespace ExItS.PinoyBusinessPOS.Maui.Components.Shared
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IProductAccessResolver Access
@inject IPlatformAccessClient Platform
@inject SellingModeService SellingMode
@inject NavigationManager Nav
@inject IStringLocalizer<PosResources> L

@if (_ready && _authenticated && (_canUsePersonal || _organizations.Count > 0))
{
    <Section Title="@L["Context_SwitcherTitle"]">
        <p class="pos-more__hint pos-muted">@(_canUsePersonal ? L["Context_SwitcherHint"] : L["Context_SwitcherHintStaff"])</p>
        <div class="pos-context-list" role="list">
            @if (_canUsePersonal)
            {
                <button type="button"
                        class="pos-context-row @(IsPersonalActive ? "pos-context-row--active" : null)"
                        disabled="@_busy"
                        role="listitem"
                        @onclick="SwitchPersonalAsync">
                    <span class="pos-context-row__title">@L["Context_Personal"]</span>
                    <span class="pos-context-row__meta">
                        @if (IsPersonalActive)
                        {
                            @L["Context_Active"]
                        }
                    </span>
                </button>
            }
            @foreach (var org in _organizations)
            {
                var active = CurrentUser.Session?.OrganizationId == org.OrganizationId;
                <button type="button"
                        class="pos-context-row @(active ? "pos-context-row--active" : null)"
                        disabled="@_busy"
                        role="listitem"
                        @onclick="() => SwitchOrgAsync(org.OrganizationId)">
                    <span class="pos-context-row__title">@org.DisplayName</span>
                    <span class="pos-context-row__meta">
                        @RoleLabel(org.MembershipRole)
                        @if (active)
                        {
                            <span> · @L["Context_Active"]</span>
                        }
                    </span>
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <InlineMessage Tone="InlineMessageTone.Danger">@_error</InlineMessage>
        }
    </Section>
}

@code {
    private bool _ready;
    private bool _authenticated;
    private bool _busy;
    private bool _canUsePersonal;
    private string? _error;
    private IReadOnlyList<EligibleOrganization> _organizations = [];

    private bool IsPersonalActive => CurrentUser.Session?.OrganizationId is null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _authenticated = CurrentUser.IsAuthenticated;
        if (!_authenticated || CurrentUser.Session is null)
        {
            _ready = true;
            return;
        }

        _organizations = await Access.ListEligibleOrganizationsAsync(CurrentUser.Session.UserId);
        if (_organizations.Count == 0 && !string.IsNullOrWhiteSpace(CurrentUser.Session.PlatformSessionToken))
        {
            var memberships = await Platform.GetUserMembershipsAsync(CurrentUser.Session.UserId);
            if (memberships.IsSuccess && memberships.Data is not null)
            {
                var list = new List<EligibleOrganization>();
                foreach (var m in memberships.Data.Items.Where(x =>
                             string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase)))
                {
                    var org = await Platform.GetOrganizationAsync(m.OrganizationId);
                    list.Add(new EligibleOrganization(
                        m.OrganizationId,
                        org.Data?.DisplayName ?? m.OrganizationId.ToString("D"),
                        m.Id,
                        m.Status,
                        AccessAllowed: false,
                        AccessReasonCode: "pending",
                        MembershipRole: m.Role));
                }

                _organizations = list;
            }
        }

        // Personal context is for owners / personal-only accounts — not staff-only memberships.
        _canUsePersonal = _organizations.Count == 0
            || OrganizationMembershipRoles.HasOrganizationOwner(_organizations);
        _ready = true;
    }

    private string RoleLabel(string? role)
    {
        if (string.IsNullOrWhiteSpace(role))
        {
            return L["Context_RoleMember"];
        }

        if (OrganizationMembershipRoles.IsOwnerRole(role))
        {
            return string.Equals(role, OrganizationMembershipRoles.Administrator, StringComparison.OrdinalIgnoreCase)
                ? L["Context_RoleAdministrator"]
                : L["Context_RoleOwner"];
        }

        if (string.Equals(role, OrganizationMembershipRoles.Member, StringComparison.OrdinalIgnoreCase))
        {
            return L["Context_RoleMember"];
        }

        if (string.Equals(role, "StoreManager", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase))
        {
            return L["OrgSelect_EnterManager"];
        }

        if (string.Equals(role, "Cashier", StringComparison.OrdinalIgnoreCase))
        {
            return L["OrgSelect_EnterCashier"];
        }

        // Never surface raw Platform membership role codes in the UI.
        if (role.StartsWith("Organization", StringComparison.OrdinalIgnoreCase))
        {
            return role["Organization".Length..];
        }

        return role;
    }

    private async Task SwitchPersonalAsync()
    {
        if (IsPersonalActive)
        {
            Nav.NavigateTo("/personal");
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            SellingMode.Clear();
            var result = await Auth.SwitchToPersonalAsync();
            if (!result.Succeeded)
            {
                _error = L[result.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            Nav.NavigateTo("/personal", replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SwitchOrgAsync(Guid organizationId)
    {
        if (CurrentUser.Session?.OrganizationId == organizationId)
        {
            Nav.NavigateTo(CurrentUser.HasPosAccess ? "/" : "/org");
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var membership = _organizations.FirstOrDefault(o => o.OrganizationId == organizationId);
            if (OrganizationMembershipRoles.IsOwnerRole(membership?.MembershipRole))
            {
                SellingMode.EnterWorkingAs(RoleHomeResolver.OwnerHome);
            }
            else
            {
                SellingMode.Clear();
            }

            var result = await Auth.SelectOrganizationAsync(organizationId);
            if (!result.Succeeded)
            {
                SellingMode.Clear();
                _error = L[result.SafeMessageKey ?? "Access_Denied"];
                return;
            }

            Nav.NavigateTo(CurrentUser.HasPosAccess ? "/" : "/org", replace: true);
        }
        finally
        {
            _busy = false;
        }
    }
}

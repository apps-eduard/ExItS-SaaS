@implements IDisposable
@using ExItS.DesignSystem.Components.Internal
@using ExItS.PinoyBusinessPOS.Application.Commercial
@inject IAuthenticationService Auth
@inject ICurrentUserContext CurrentUser
@inject IOfflineOperationQueue OfflineQueue
@inject IUtangCapabilityEvaluator Capabilities
@inject SellingModeService SellingMode
@inject NavigationManager Nav
@inject OfflineAwareNavigation OfflineNav
@inject OnlineRequiredGuard OnlineRequired
@inject IStringLocalizer<PosResources> L

<div class="pos-topbar__overflow" @onclick:stopPropagation="true">
    <IconButton IconName="menu"
                AriaLabel="@L["Shell_AccountMenuAria"]"
                OnClick="ToggleAsync" />
    @if (_open)
    {
        <div class="pos-topbar__overflow-menu" role="menu">
            @if (ExtraItems is not null)
            {
                @ExtraItems
            }
            @if (ShowSettings)
            {
                <button type="button" class="pos-topbar__overflow-item" role="menuitem" @onclick="GoSettingsAsync">
                    <span class="pos-topbar__overflow-icon" aria-hidden="true">@IconGlyphs.Get("settings")</span>
                    <span>@L["Nav_Settings"]</span>
                </button>
            }
            @if (ShowDashboardItem)
            {
                <button type="button" class="pos-topbar__overflow-item" role="menuitem" @onclick="GoDashboardAsync">
                    <span class="pos-topbar__overflow-icon" aria-hidden="true">@IconGlyphs.Get("sales")</span>
                    <span>@L["Nav_Dashboard"]</span>
                </button>
            }
            @if (ShowOrganizationSwitcherItem)
            {
                <button type="button" class="pos-topbar__overflow-item" role="menuitem" @onclick="GoSwitchOrgAsync">
                    <span class="pos-topbar__overflow-icon" aria-hidden="true">@IconGlyphs.Get("customers")</span>
                    <span>@OrganizationSwitcherLabel</span>
                </button>
            }
            @if (ShowPersonalHome)
            {
                <button type="button" class="pos-topbar__overflow-item" role="menuitem" @onclick="GoPersonalAsync">
                    <span class="pos-topbar__overflow-icon" aria-hidden="true">@IconGlyphs.Get("home")</span>
                    <span>@L["Personal_HomeTitle"]</span>
                </button>
            }
            @if (ShowLock)
            {
                <button type="button" class="pos-topbar__overflow-item" role="menuitem" @onclick="LockAsync">
                    <span class="pos-topbar__overflow-icon" aria-hidden="true">@IconGlyphs.Get("lock")</span>
                    <span>@L["Auth_Lock"]</span>
                </button>
            }
            @if (ShowSignOut)
            {
                <button type="button" class="pos-topbar__overflow-item pos-topbar__overflow-item--danger" role="menuitem" @onclick="OpenLogoutAsync">
                    <span class="pos-topbar__overflow-icon" aria-hidden="true">@IconGlyphs.Get("close")</span>
                    <span>@L["Auth_Logout"]</span>
                </button>
            }
        </div>
    }
</div>

<ConfirmDialog @bind-Visible="_logoutOpen"
               Title="@L["Auth_LogoutConfirmTitle"]"
               Message="@_logoutMessage"
               Danger="true"
               IsLoading="_logoutBusy"
               OnConfirm="LogoutAsync"
               OnCancel="() => _logoutOpen = false" />

@code {
    /// <summary>Optional leading menu rows (e.g. sync status) rendered above standard actions.</summary>
    [Parameter] public RenderFragment? ExtraItems { get; set; }

    [Parameter] public bool ShowSettings { get; set; } = true;
    [Parameter] public bool ShowSwitchOrganization { get; set; } = true;
    [Parameter] public bool ShowPersonalHome { get; set; }
    [Parameter] public bool ShowSignOut { get; set; } = true;
    [Parameter] public EventCallback OnOpened { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _open;
    private bool _logoutOpen;
    private bool _logoutBusy;
    private bool _lockBusy;
    private bool _canLock;
    private string _logoutMessage = string.Empty;

    private bool IsPersonalSession => CurrentUser.Session?.OrganizationId is null;

    private bool IsOnOrganizationSelect
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            return path.StartsWith("/organization-select", StringComparison.OrdinalIgnoreCase);
        }
    }

    /// <summary>
    /// Hide while already choosing an organization — the page itself is that flow.
    /// </summary>
    private bool ShowOrganizationSwitcherItem =>
        ShowSwitchOrganization && !IsOnOrganizationSelect;

    private bool ShowDashboardItem =>
        !IsPersonalSession
        && CurrentUser.HasPosAccess
        && Capabilities.IsAllowed(UtangCapability.ViewDashboard);

    /// <summary>
    /// Lock keeps the offline operate grant and returns to PIN unlock. Sign out clears grant trust.
    /// Only for active POS operate sessions — Org essentials (membership without POS) must not show Lock.
    /// </summary>
    private bool ShowLock =>
        ShowSignOut
        && !IsPersonalSession
        && CurrentUser.HasPosAccess
        && _canLock
        && CurrentUser.IsAuthenticated;

    private string OrganizationSwitcherLabel =>
        IsPersonalSession ? L["OrgSelect_Title"] : L["Shell_ChangeOrganization"];

    public bool IsOpen => _open;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var offer = await Auth.EvaluateOfflineColdStartOfferAsync();
            _canLock = offer.CanOfferPinUnlock
                       || await Auth.HasOfflinePinConfiguredAsync();
        }
        catch
        {
            _canLock = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = CloseAsync();

    private async Task ToggleAsync()
    {
        if (_open)
        {
            await CloseAsync();
            return;
        }

        // Close the sync popover first so only one top-bar overlay is visible.
        if (OnOpened.HasDelegate)
        {
            await OnOpened.InvokeAsync();
        }

        _open = true;
    }

    public async Task CloseAsync()
    {
        if (!_open)
        {
            return;
        }

        _open = false;
        if (OnClosed.HasDelegate)
        {
            await OnClosed.InvokeAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task GoSettingsAsync()
    {
        await CloseAsync();
        Nav.NavigateTo(IsPersonalSession ? "/personal/settings" : "/settings");
    }

    private async Task GoDashboardAsync()
    {
        await CloseAsync();
        await OfflineNav.NavigateAsync("/dashboard");
    }

    private async Task GoSwitchOrgAsync()
    {
        await CloseAsync();
        var orgName = CurrentUser.Session?.OrganizationDisplayName;
        if (!await OnlineRequired.EnsureOnlineForActionAsync(
                PosOfflineActionKeys.SwitchOrganization,
                orgName))
        {
            return;
        }

        SellingMode.Clear();
        Nav.NavigateTo("/organization-select");
    }

    private async Task GoPersonalAsync()
    {
        await CloseAsync();
        var orgName = CurrentUser.Session?.OrganizationDisplayName;
        if (!await OnlineRequired.EnsureOnlineForActionAsync(
                PosOfflineActionKeys.SwitchToPersonal,
                orgName))
        {
            return;
        }

        SellingMode.Clear();
        var result = await Auth.SwitchToPersonalAsync();
        if (result.Succeeded)
        {
            Nav.NavigateTo("/personal", replace: true);
        }
    }

    private async Task OpenLogoutAsync()
    {
        await CloseAsync();
        _logoutMessage = L["Auth_LogoutConfirmMessage"];
        try
        {
            if (await OfflineQueue.HasUnsyncedWorkAsync())
            {
                _logoutMessage = $"{L["Auth_LogoutConfirmMessage"]} {L["Offline_LogoutUnsyncedWarning"]}";
            }
        }
        catch
        {
            // Keep default logout message when queue is unavailable.
        }

        _logoutOpen = true;
    }

    private async Task LockAsync()
    {
        if (_lockBusy)
        {
            return;
        }

        _lockBusy = true;
        try
        {
            await CloseAsync();
            SellingMode.Clear();
            await Auth.LockAsync();
            Nav.NavigateTo("/offline-pin", replace: true);
        }
        finally
        {
            _lockBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        _logoutBusy = true;
        try
        {
            SellingMode.Clear();
            await Auth.LogoutAsync();
            _logoutOpen = false;
            Nav.NavigateTo("/signin", replace: true);
        }
        finally
        {
            _logoutBusy = false;
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

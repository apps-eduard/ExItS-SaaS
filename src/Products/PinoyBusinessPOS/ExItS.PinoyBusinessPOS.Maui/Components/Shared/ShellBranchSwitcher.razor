@implements IDisposable
@inject ICurrentUserContext CurrentUser
@inject IAuthenticationService Auth
@inject IPlatformAccessClient Platform
@inject IStringLocalizer<PosResources> L

@if (_open)
{
    <div class="pos-branch-sheet__backdrop" @onclick="CloseAsync">
        <div class="pos-branch-sheet"
             role="dialog"
             aria-modal="true"
             aria-labelledby="pos-branch-sheet-title"
             @onclick:stopPropagation="true">
            <div class="pos-branch-sheet__handle" aria-hidden="true"></div>
            <h2 id="pos-branch-sheet-title" class="pos-branch-sheet__title">@L["BranchContext_SwitchTitle"]</h2>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="pos-branch-sheet__error" role="alert">@_error</p>
            }
            else if (_loading)
            {
                <p class="pos-branch-sheet__hint pos-muted">@L["Common_Loading"]</p>
            }
            else if (_branches.Count == 0)
            {
                <p class="pos-branch-sheet__hint pos-muted">@L["BranchContext_Empty"]</p>
            }
            else
            {
                <ul class="pos-branch-sheet__list">
                    @foreach (var branch in _branches)
                    {
                        var selected = SelectedId == branch.Id;
                        var active = string.Equals(branch.Status, "Active", StringComparison.OrdinalIgnoreCase);
                        <li>
                            <button type="button"
                                    class="pos-branch-sheet__row @(selected ? "pos-branch-sheet__row--selected" : null)"
                                    disabled="@(_busy || !active)"
                                    @onclick="() => SelectAsync(branch)">
                                <span class="pos-branch-sheet__check" aria-hidden="true">@(selected ? "✓" : "")</span>
                                <span class="pos-branch-sheet__name">@branch.Name</span>
                                @if (!active)
                                {
                                    <span class="pos-branch-sheet__status">@L["BranchContext_Unavailable"]</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _open;
    private bool _loading;
    private bool _busy;
    private string? _error;
    private IReadOnlyList<OrganizationBranchDto> _branches = [];

    private Guid? SelectedId => AuthSessionBranchContext.GetSelectedBranchId(CurrentUser.Session);

    public async Task OpenAsync()
    {
        if (CurrentUser.Session?.OrganizationId is null)
        {
            return;
        }

        _open = true;
        _error = null;
        _loading = true;
        await InvokeAsync(StateHasChanged);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (CurrentUser.Session?.OrganizationId is not Guid orgId)
        {
            _loading = false;
            return;
        }

        try
        {
            var result = await Platform.GetBranchesAsync(orgId);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = L["Branches_LoadFailed"];
                _branches = [];
            }
            else
            {
                _branches = result.Data
                    .OrderByDescending(b => b.IsPrimary)
                    .ThenBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
        }
        catch
        {
            _error = L["Branches_LoadFailed"];
            _branches = [];
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectAsync(OrganizationBranchDto branch)
    {
        if (_busy || !string.Equals(branch.Status, "Active", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (SelectedId == branch.Id)
        {
            await CloseAsync();
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.SelectBranchAsync(branch.Id);
            if (!result.Succeeded)
            {
                _error = L[result.SafeMessageKey ?? "BranchContext_Denied"];
                return;
            }

            await CloseAsync();
            if (OnChanged.HasDelegate)
            {
                await OnChanged.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task CloseAsync()
    {
        _open = false;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _open = false;
    }
}

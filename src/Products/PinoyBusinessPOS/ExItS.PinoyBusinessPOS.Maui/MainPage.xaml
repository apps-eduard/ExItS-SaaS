<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ExItS.PinoyBusinessPOS.Maui"
             xmlns:components="clr-namespace:ExItS.PinoyBusinessPOS.Maui.Components"
             x:Class="ExItS.PinoyBusinessPOS.Maui.MainPage"
             SafeAreaEdges="Container">

    <!--
      .NET 10 Android defaults ContentPage SafeAreaEdges to None (edge-to-edge).
      Container applies system-bar / cutout / navigation-bar insets once at the host
      so Blazor shells must not add a second top status-bar spacer.
    -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

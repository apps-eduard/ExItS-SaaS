<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- usesCleartextTraffic supplements network_security_config for DEBUG emulator validation
         against Local Validation HTTP APIs (10.0.2.2 / localhost via adb reverse). Production
         release remains gated on MAUI-HTTPS / HTTPS-only network_security_config. -->
    <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/network_security_config"></application>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
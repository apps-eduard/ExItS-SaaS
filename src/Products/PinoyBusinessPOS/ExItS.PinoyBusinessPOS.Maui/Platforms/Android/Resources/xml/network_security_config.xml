<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG Local Validation network security (P5-WP01; reviewed P9-WP01).

  Cleartext HTTP only for:
  - Android emulator host-loopback (10.0.2.2)
  - localhost / 127.0.0.1 (emulator or adb reverse)
  - Tailscale/LAN Local Validation PublicHost (physical-device Debug profile)

  Release builds replace this file with network_security_config.Release.xml (HTTPS-only).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Local Validation PublicHost (Start-LocalValidation -PublicHost / PhysicalDevice profile). -->
        <domain includeSubdomains="false">100.120.79.81</domain>
    </domain-config>
</network-security-config>
